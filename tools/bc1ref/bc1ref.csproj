<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bc1ref</AssemblyName>
    <RootNamespace>Bc1Ref</RootNamespace>
    <!-- Standalone on purpose: this tool must NOT reference WorldBuilder or
         DatReaderWriter.Extensions. Its entire value is being an INDEPENDENT
         reimplementation against the BCnEncoder.Net public API — a cross-check
         that shares code with the thing it checks is a tautology. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned to the versions DatReaderWriter.Extensions.csproj uses: an
         encoder-version drift would show up as a false byte-identity FAIL. -->
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <PackageReference Include="BCnEncoder.Net.ImageSharp" Version="1.1.2" />
  </ItemGroup>
</Project>
