{
  "$schema": "./schemas/plugin-manifest.json",
  "id": "inventory",
  "name": "Inventory",
  "author": "holtburger",
  "version": "0.1.0",
  "description": "Right-side inventory window (gmInventoryUI 0x21000023)",
  "icon": "🎒",
  "iconHidden": true,
  "entry": "./inventory.js",
  "environments": ["browser"],
  "slots": ["panel"],
  "hotkeys": [
    { "id": "toggle", "default": "F4", "label": "Toggle Inventory" }
  ],
  "clientApi": "^1.0",
  "capabilities": ["GetPlayerInventory", "MoveItem", "DropItem", "WieldFromPack", "UnwieldToPack", "UseObject", "GetObjectAppraisal"]
}
