	IF:	Expr {wobjectgetselection[]!=0&&wobjectgetobjectclass[wobjectgetselection[]]==5&&wobjectgetid[wobjectgetselection[]]!=$target&&(dicthaskey[$mobs,setvar[mob,wobjectgetname[wobjectgetselection[]]]]||dictadditem[$mobs,$mob,dictcreate[AP,$AP,Hit,0,Miss,0]]==0)&&dictgetitem[dictgetitem[$mobs,$mob],AP]!=$AP}
