STATE: {evacuate} ~~ {
	IF:	Expr {stopwatchelapsedseconds[$watcher]>300}
		DO:	DoAll
				DoExpr {setvar[evacCalled,1]}
				CallState {watcher} {evacuate}
	IF:	Not BlockE 8A020000
		DO:	DoAll
				DoExpr {actiontryuseitem[wobjectfindininventorybyname[Facility Hub Portal Gem]]}
				SetWatchdog 5 31 {evacuate}
				Chat {/vt opt set enablenav false}
	IF:	BlockE 8A020000
		DO:	DoAll
				Chat {/vt opt set enablenav true}
				Return
~~ }
STATE: {goHunt} ~~ {
	IF:	Expr {stopwatchelapsedseconds[$watcher]>300}
		DO:	CallState {watcher} {goHunt}
	IF:	BlockE 87630000
		DO:	DoAll
				Chat {/vt nav load Neftet}
				CallState {toggleOn} {Default}
	IF:	Not BlockE 87630000
		DO:	DoAll
				Chat {/vt nav load NeftetRecall}
				Chat {/vt opt set enablecombat true}
				Chat {/vt opt set enablebuffing true}
~~ }
STATE: {goSell} ~~ {
	IF:	Expr {stopwatchelapsedseconds[$watcher]>300}
		DO:	CallState {watcher} {goSell}
	IF:	Not BlockE 2B120000
		DO:	DoAll
				Chat {/vt nav load candeth}
				DoExpr {clearvar[selltimer]}
				CallState {toggleOff} {goSell}
	IF:	All
			NavEmpty
			Not MainSlotsLE 7
			Not BuPercentGE 130
			ItemCountGE 150 {Prismatic Taper}
		DO:	SetState {Default}
~~ }
STATE: {neftetKT} ~~ {
	IF:	Expr {stopwatchelapsedseconds[$watcher]>300}
		DO:	CallState {watcher} {neftetKT}
	IF:	Not Expr {isrefreshingquests[]||$refreshed}
		DO:	DoAll
				Chat {/ub myquests}
				DoExpr {setvar[refreshed,1]}
				CallState {toggleOff} {neftetKT}
	IF:	All
			Expr {$refreshed}
			Not Expr {isrefreshingquests[]}
		DO:	DoAll
				DoExpr {setvar[NPCs,listcreate[]]}
				DoExpr {listadd[iif[getqueststatus[DesertAreaCollectionBracersWait_0511]>0&&getitemcountininventorybyname[Engraved A'nekshay Bracers]>14,$NPCs,listcreate[]],`neftet\T'ing Setsuko`]}
				DoExpr {listadd[iif[getqueststatus[desertareacollectionpayotewait_0511]>0&&getitemcountininventorybyname[Prickly Pear]>14,$NPCs,listcreate[]],`neftet\Hammah al Rundik`]}
				DoExpr {listadd[iif[(getquestktprogress[desertcactuskillcount]/getquestktrequired[desertcactuskillcount]==1)||(getqueststatus[desertcactuskilltask]==1&&getquestktrequired[desertcactuskillcount]==0),$NPCs,listcreate[]],`neftet\Sir Unell bin Rakke`]}
				DoExpr {listadd[iif[(getquestktprogress[killtaskdesertareaarmoredillo_0511]/getquestktrequired[killtaskdesertareaarmoredillo_0511]==1)||(getqueststatus[killtaskdesertareaarmoredillowait_0511]==1&&getquestktrequired[killtaskdesertareaarmoredillo_0511]==0),$NPCs,listcreate[]],`neftet\Dame Tularin`]}
				DoExpr {listadd[iif[(getquestktprogress[killtaskdesertareagolem_0511]/getquestktrequired[killtaskdesertareagolem_0511]==1)||(getqueststatus[killtaskdesertareagolemwait_0511]==1&&getquestktrequired[killtaskdesertareagolem_0511]==0),$NPCs,listcreate[]],`neftet\Sir Ibreh bin Kassim`]}
				DoExpr {listadd[iif[(getquestktprogress[killtaskdesertareamumiyah_0511]/getquestktrequired[killtaskdesertareamumiyah_0511]==1)||(getqueststatus[killtaskdesertareamumiyahwait_0511]==1&&getquestktrequired[ killtaskdesertareamumiyah_0511]==0),$NPCs,listcreate[]],`neftet\Sir Adarl`]}
				DoExpr {listadd[iif[(getquestktprogress[killtaskdesertareareedshark_0511]/getquestktrequired[killtaskdesertareareedshark_0511]==1)||(getqueststatus[killtaskdesertareareedsharkwait_0511]==1&&getquestktrequired[killtaskdesertareareedshark_0511]==0),$NPCs,listcreate[]],`neftet\Sir Hassim bin Tamarek`]}
	IF:	All
