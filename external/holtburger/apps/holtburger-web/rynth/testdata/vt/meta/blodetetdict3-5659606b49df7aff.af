~~ }
STATE: {neftetKTtour} ~~ {
	IF:	Expr {stopwatchelapsedseconds[$watcher]>300}
		DO:	CallState {watcher} {neftetKTtour}
	IF:	Expr {getitemcountininventorybynamerx[Collecting]>0}
		DO:	DoAll
				Chat {/mt useip Collecting}
				SetState {neftetKTtour}
	IF:	Expr {getitemcountininventorybynamerx[Hunting]>0}
		DO:	DoAll
				Chat {/mt useip Hunting}
				SetState {neftetKTtour}
	IF:	Expr {listcount[$NPCs]>0}
		DO:	ChatExpr {`/vt nav load `+listpop[$NPCs]}
	IF:	All
			NavEmpty
			Expr {listcount[$NPCs]>0}
		DO:	SetState {neftetKTtour}
	IF:	NavEmpty
		DO:	DoAll
				DoExpr {setvar[refreshed,0]}
				CallState {evacuate} {Default}
~~ }
STATE: {toggleOff} ~~ {
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set enablecombat false}
				Chat {/vt opt set enablebuffing false}
				Return
~~ }
STATE: {toggleOn} ~~ {
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set enablecombat true}
				Chat {/vt opt set enablebuffing true}
				Chat {/vt opt set enablenav true}
				Chat {/vt opt set enablelooting true}
				Return
~~ }
STATE: {watcher} ~~ {
	IF:	Expr {testvar[loc]==0}
		DO:	DoAll
				DoExpr {setvar[loc,getplayercoordinates[]]}
				DoExpr {setvar[watcherErrors,-1]}
	IF:	Always
		DO:	DoAll
				DoExpr {setvar[watcher,stopwatchcreate[]];stopwatchstart[$watcher]}
				DoExpr {setvar[lastloc,$loc]}
				DoExpr {setvar[loc,getplayercoordinates[]]}
				DoExpr {setvar[watcherErrors,iif[coordinatedistancewithz[$lastloc,$loc]<5,$watcherErrors+1,0]]}
	IF:	Expr {$watcherErrors>1}
		DO:	Chat {/mt exit}
	IF:	Expr {$evacCalled}
		DO:	DoAll
				DoExpr {clearvar[evacCalled]}
				CallState {evacuate} {Default}
	IF:	Always
		DO:	Return
~~ }
