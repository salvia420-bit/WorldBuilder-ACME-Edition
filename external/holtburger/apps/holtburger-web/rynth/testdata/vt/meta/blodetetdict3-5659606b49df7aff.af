				ChatExpr {iif[$lastAP!=setvar[AP,dictgetitem[dictgetitem[$mobs,$mob],AP]],`/vt setattackbar `+$AP,``]}
				SetState {Default}
	IF:	Any
			ChatCapture {^You (split (?<mob>.*?) apart|cleave (?<mob>.*?) in twain|run (?<mob>.*?) through|beat (?<mob>.*?) to a lifeless pulp|flatten (?<mob>.*?)\'s body with the force of your assault|bring (?<mob>.*?) to a fiery end|slay (?<mob>.*?) viciously enough to impart death several times over|reduce (?<mob>.*?) to a sizzling, oozing mass|obliterate (?<mob>.*?)|smite (?<mob>.*?) mightily|knock (?<mob>.*?) into next Morningthaw)!$} {}
			ChatCapture {^(?<mob>.*?) (is torn to ribbons by your assault|is fatally punctured|is shattered by your assault|is reduced to cinders|is incinerated by your assault|suffers a frozen fate|is liquified by your attack|is utterly destroyed by your attack|catches your attack, with dire consequences|\'s perforated corpse falls before you|\'s death is preceded by a sharp, stabbing pain|\'s seared corpse smolders before you|\'s last strength dissolves before you)!$} {}
			ChatCapture {^Your (killing blow nearly turns (?<mob>.*?) inside-out|attack stops (?<mob>.*?) cold|assault sends (?<mob>.*?) to an icy death|Your lightning coruscates over (?<mob>.*?)\'s mortal remains)!$} {}
			ChatCapture {^The thunder of crushing (?<mob>.*?) is followed by the deafening silence of death!$} {}
			ChatCapture {^Blistered by lightning, (?<mob>.*?) falls!$} {}
			ChatCapture {^Electricity tears (?<mob>.*?) apart!$} {}
			ChatCapture {^The deadly force of your attack is so strong that (?<mob>.*?)\'s ancestors feel it!$} {}
			ChatCapture {^(Recklessness! |Critical hit!  )?You (hit|mangle|slash|cut|scratch|gore|impale|stab|nick|crush|smash|bash|graze|incinerate|burn|scorch|singe|freeze|frost|chill|numb|dissolve|corrode|sear|blister|blast|jolt|shock|spark) (?<mob>.*?) for} {}
		DO:	DoAll
				DoExpr {setvar[mob,$capturegroup_mob]}
				DoExpr {dictadditem[dictgetitem[$mobs,$mob],Hit, dictgetitem[dictgetitem[$mobs,$mob],Hit]+1]}
				DoExpr {setvar[hitrate,dictgetitem[dictgetitem[$mobs,$mob],Hit]/(dictgetitem[dictgetitem[$mobs,$mob],Hit]+dictgetitem[dictgetitem[$mobs,$mob],Miss]])}
				DoExpr {setvar[lastAP,dictgetitem[dictgetitem[$mobs,$mob],AP]]}
				DoExpr {dictadditem[dictgetitem[$mobs,$mob],AP,iif[dictgetitem[dictgetitem[$mobs,$mob],AP]/($hitrate+.02)>.9,.9,round[100*dictgetitem[dictgetitem[$mobs,$mob],AP]/($hitrate+.02)]/100]]}
				ChatExpr {iif[$lastAP!=setvar[AP,dictgetitem[dictgetitem[$mobs,$mob],AP]],`/vt setattackbar `+$AP,``]}
				SetState {Default}
	IF:	Expr {stopwatchelapsedseconds[$watcher]>300}
		DO:	CallState {watcher} {Default}
	IF:	All
