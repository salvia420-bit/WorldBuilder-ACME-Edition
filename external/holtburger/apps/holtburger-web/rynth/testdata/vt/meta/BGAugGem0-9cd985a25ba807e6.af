				SetState {NavTo}
	IF:	All
			Expr {$ToNPC==1}
			Expr {$NoBobo==1}
			NavEmpty
			Expr {$ToMP==0}
			Not CellE 016C01BC
		DO:	DoAll
				DoExpr {setvar[ToMP,1]}
				EmbedNav nav6 {[mp]}
	IF:	All
			Expr {$ToMP==1}
			CellE 016C01BC
		DO:	DoAll
