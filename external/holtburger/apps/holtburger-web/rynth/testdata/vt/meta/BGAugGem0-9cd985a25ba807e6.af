	IF:	All
			Expr {$ToNPC==1}
			Expr {$NoBobo==0}
			Not CellE F6820033
			NavEmpty
		DO:	DoAll
				EmbedNav nav8 {ToBobo}
				SetState {NavTo}
	IF:	All
			Expr {$ToNPC==1}
			Expr {$NoBobo==0}
			Expr {$AtBobo!=1}
			CellE F6820033
		DO:	DoAll
				DoExpr {setvar[AtBobo,1]}
				EmbedNav nav9 {[none]}
