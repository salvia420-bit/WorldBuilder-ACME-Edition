STATE: {TurnInJaw} ~~ {
	IF:	All
			Expr {$HaveJaw==1}
			NavEmpty
		DO:	DoExpr {actiontrygiveitem[wobjectfindininventorybyname[Insatiable Eater Jaw],wobjectfindnearestbynameandobjectclass[37,`Fiun Rehlyun`]]}
	IF:	Any
			ChatMatch {One who obtains such as this is truly worthy of that which we would teach. The highest peak of the deadliest isle contains that which you seek.}
			ChatMatch {You're flagged for Augmentation Gem Dungeon already.}
		DO:	DoAll
				DoExpr {clearvar[HaveJaw]}
				DoExpr {setvar[ToBot,1]}
				DoExpr {setvar[Flagged,1]}
				SetState {NavTo}
	IF:	All
			SecsInStateGE 10
			CellE 38F7000B
		DO:	DoAll
				DoExpr {actiontrygiveitem[wobjectfindininventorybyname[Insatiable Eater Jaw],wobjectfindnearestbynameandobjectclass[37,`Fiun Rehlyun`]]}
	IF:	SecsInStateGE 60
		DO:	SetState {TurnInJaw}
~~ }
STATE: {Use Bot} ~~ {
	IF:	All
			Expr {$UsePortal==0}
			Expr {$GetJaw==1}
			Expr {getobjectinternaltype[wobjectfindnearestbynameandobjectclass[24,$PortalBot]]==7&&coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[wobjectfindnearestbynameandobjectclass[24,$PortalBot]]]<=10}
		DO:	DoExpr {chatbox[`/t `+getvar[PortalBot]+\, Primary]}
	IF:	All
			Expr {$UsePortal==0}
			Expr {$GetAug==1&&$Flagged==1}
			Expr {getobjectinternaltype[wobjectfindnearestbynameandobjectclass[24,$PortalBot]]==7&&coordinatedistancewithz[getplayercoordinates[], wobjectgetphysicscoordinates[wobjectfindnearestbynameandobjectclass[24,$PortalBot]]]<=10}
		DO:	DoExpr {chatbox[`/t `+getvar[PortalBot]+\, Secondary]}
	IF:	All
			Any
				ChatCapture {^\<Tell:IIDString:[^:]+:(?<name>[^\>]*)[^\<]+\<\\Tell\> says, \"I am summoning a portal} {2}
				ChatCapture {^\<Tell:IIDString:[^:]+:(?<name>[^\>]*)[^\<]+\<\\Tell\> tells you, \"I am summoning a portal} {3}
			Expr {$capturegroup_name==$PortalBot}
			Expr {$UsePortal==0}
		DO:	DoAll
				EmbedNav nav16 {[none]}
				DoExpr {setvar[UsePortal,1]}
				DoExpr {stopwatchstart[setvar[PortalTimer, stopwatchcreate[]]]}
	IF:	All
			Expr {$UsePortal==1}
			SecsInStateGE 3
		DO:	DoAll
				DoExpr {actiontryuseitem[wobjectfindnearestbynameandobjectclass[14,Gateway]]}
				SetState {Use Bot}
	IF:	All
			IntoPortal
		DO:	DoAll
				DoExpr {chatbox[`/t `+getvar[PortalBot]+\, Cancel]}
				DoExpr {chatbox[`/t `+getvar[PortalBot]+\, Remove]}
				DoExpr {clearvar[UsePortal]}
				DoExpr {clearvar[capturegroup_0]}
				DoExpr {clearvar[capturecolor]}
				DoExpr {clearvar[capturegroup_name]}
				SetState {NavTo}
				DoExpr {clearvar[PortalTimer]}
	IF:	Any
			SecsInStateGE 28
			Expr {$PortalTimer!=0&&stopwatchelapsedseconds[$PortalTimer]>=24}
		DO:	DoAll
				DoExpr {clearvar[UsePortal]}
				SetState {Use Bot}
				DoExpr {clearvar[PortalTimer]}
~~ }

