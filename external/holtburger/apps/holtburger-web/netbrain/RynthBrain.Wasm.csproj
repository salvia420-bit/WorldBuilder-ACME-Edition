<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmSingleFileBundle>false</WasmSingleFileBundle>
    <!-- The slices are culture-free (ordinal string ops, invariant JSON); dropping
         ICU removes ~2.6 MB from the bundle. replay_fixtures.mjs is the gate that
         proves the invariant-globalization build still matches native C# outputs. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Single source of truth: the slice sources live with their fixtures/parity
         harnesses in docs/rynth-integration/netwasm-spike/. This project only
         consolidates them into one servable AppBundle. -->
    <Compile Include="../../../docs/rynth-integration/netwasm-spike/CombatScoring/TargetScoring.cs" />
    <Compile Include="../../../docs/rynth-integration/netwasm-spike/BuffScoring/BuffScheduling.cs" />
    <Compile Include="../../../docs/rynth-integration/netwasm-spike/LootScoring/LootScoring.cs" />
  </ItemGroup>
</Project>
