<?xml version="1.0" encoding="UTF-8"?>
<!--
  HBV1 — holtburger vehicles wire spec, protocol version 7 (v1 2026-11-01 .. v7 2026-11). "HBV1" is the
  protocol's name and tag, not its version.

  THE single definition of the vehicle messages (DESIGN.md §5, §5.1 rule 1). Written in the style of Chorizite's
  protocol.xml (external/chorizite/Chorizite.ACProtocol/Chorizite.ACProtocol/protocol.xml) so a Chorizite plugin can
  generate its readers / writers from it later. Implementations, all checked against the same byte fixtures
  (vehicle-wire-fixtures.json, produced from THIS file by gen_fixtures.py):
    - ACE (C#):   ~/ace-server/Source/ACE.Server/Vehicles/VehicleWire.cs        (test: ACE.Server.Tests/Vehicles)
    - Rust:       crates/holtburger-protocol/src/messages/vehicle/              (test: vehicle::tests)
    - Python:     gen_fixtures.py (interprets this file; the fixture generator)

  Framing (standard AC, unchanged): client -> server messages are game actions inside 0xF7B1
  (u32 sequence, u32 action opcode, payload); server -> client messages are game events inside 0xF7B0
  (u32 target guid, u32 event sequence, u32 event opcode, payload). Opcodes 0x0900-0x091F in both tables
  (unused by ACE, Chorizite and holtburger as of 2026-11-01). All values little-endian.

  Every payload starts with VehicleHeader: the 4-byte tag "HBV1" and the protocol version. A receiver drops a
  payload whose tag is not "HBV1". Versions only ever APPEND fields at the end of a message: a <field> / <vector>
  marked since="N" is on the wire only when the payload's Version >= N; a reader given an older payload uses the
  element's default (default="..." when given, else 0 / empty). A receiver that sees a HIGHER version than its
  own parses the fields it knows and ignores the trailing bytes. Writers always emit their own (current)
  version, schema/@version. Session gating (DESIGN §5): S2C vehicle events go only to sessions whose
  ClientCapabilities granted the matching bit; C2S pilot actions from a session without the pilot bit are
  ignored.

  Versions:
    v1 (2026-11-01)  the base messages.
    v2 (2026-11-02)  weapons: the Missile / Bomb buttons, weapon kinds Missile / Bomb, event kinds BombRelease /
                     Explosion / Rearmed, and the VehiclePartRole enum. Appended fields (since="2"):
                       Vehicle_Profile  PartRoleCount, PartRoles (VehiclePartRole per part), WeaponExtCount,
                                        WeaponExt (VehicleWeaponExt per weapon)
                       Vehicle_State    MissileMask, BombMask, Reserved2
                       Vehicle_Fire     MountCount (default 1), Reserved2, Speed
                       Vehicle_Event    Aux, Velocity
                     C2S messages gain no fields (a v2 action differs from v1 only in the header version).
    v3 (2026-11-15)  ground transports & radar: VehicleLocomotion Ground, VehicleMode Driving,
                     VehicleButtons Handbrake / Horn / Headlights, VehicleEventKind Horn .. RadarAlert (12..18),
                     VehiclePartRole WheelFL .. Windscreen (5..12), IffStanding enum, RadarContactWire type,
                     C2S Vehicle_Cargo (0x0909), S2C Vehicle_RadarContacts (0x090A).
                     Appended fields (since="3"):
                       Vehicle_Profile  Wheelbase, TrackWidth, WheelRadius, MaxSteerRad, ReverseMax,
                                        ClimbLimitCos, FordDepthMax, CargoWcid
                       Vehicle_State    SteerAngle, GroundFlags, SurfaceFamily, WheelSpinQ16
  v4 additions (2026-11): DeployableKind, PalletSize, DeployableWeaponKind, GroundContactKind enums,
                      GroundContactWire type, S2C Vehicle_DeployableState (0x090B),
                      Vehicle_DeployableFire (0x090C), Vehicle_GroundContacts (0x090D).
                      Appended fields (since="4"):
                        Vehicle_Cargo    Slot, Reserved0, Reserved1, CargoWcid
                        Vehicle_State    CargoMask, PalletSize0, PalletSize1, Reserved3, CargoSlot0Wcid, CargoSlot1Wcid

  v5 additions (2026-11): DeployableKind (10..12) for IsoContainer20/40/40HC, ContainerSlotWire type,
                      C2S Vehicle_ContainerAction (0x090E), S2C Vehicle_ContainerState (0x090E).

  v6 additions (2026-11): TrailerActionKind enum, VehicleEventKind (19..21), DeployableKind (13..14),
                      C2S Vehicle_TrailerAction (0x090F), S2C Vehicle_TrailerState (0x090F).
                      Appended fields (since="6"):
                        Vehicle_Profile  FifthWheelOffsetY, FifthWheelOffsetZ, LiveryId, VehicleClass, Reserved4
                        Vehicle_State    HitchedTrailerGuid, TrailerHeading, TrailerPitch, TrailerFlags, Reserved4, Reserved5

  v7 additions (2026-11): SideliftPhase, PalletJackActionKind enums; DeployableKind (15..16);
                      TrailerActionKind (6..14); VehicleEventKind (22..25); OnlineFlags 0x10=Stowed;
                      C2S Vehicle_PalletJackAction (0x0910), S2C Vehicle_PalletJackState (0x0910).
                      Appended fields (since="7"):
                        Vehicle_TrailerState  SideliftPhase, SideliftSide, SideliftFlags, Reserved7,
                                              SideliftProgress, OutriggerProgress, CraneSpanY,
                                              StowedPalletJackGuid, TransferContainerGuid

  Units: metres, seconds, radians. Positions are AC cell + landblock-local coordinates. Angles: heading is a
  COMPASS angle (0 = north/+y, pi/2 = east/+x, clockwise); pitch is nose-up positive; bank is right-wing-down
  positive. Stick values are signed bytes scaled by 1/127 (-128 clamps to -1). Throttle is u8 scaled by 1/255.
-->
<schema text="holtburger vehicles (HBV1) — additive, capability-gated vehicle messages" version="7">
  <enums>
    <enum name="VehicleCapability" parent="uint" mask="true" text="ClientCapabilities.Flags / CapabilitiesAck.Granted">
      <value value="0x00000001" name="Observe" text="receive VehicleProfile / VehicleSeat / VehicleState / VehicleFire / VehicleEvent" />
      <value value="0x00000002" name="Pilot" text="may send VehicleBoard / VehicleInput / VehicleExit" />
      <value value="0x00000004" name="DatPatch" text="has the vehicle DAT patch (tier 1): may be sent custom Setup DIDs" />
    </enum>
    <enum name="VehicleLocomotion" parent="uint">
      <value value="1" name="Air" />
      <value value="2" name="Ground" />
    </enum>
    <enum name="VehicleMode" parent="byte" text="VehicleState.Mode">
      <value value="0" name="Parked" />
      <value value="1" name="Takeoff" />
      <value value="2" name="Flight" />
      <value value="3" name="Landing" />
      <value value="4" name="Crashed" />
      <value value="5" name="Derelict" text="no pilot after a bail-out: autopilot glide and descent" />
      <value value="6" name="Driving" />
    </enum>
    <enum name="VehicleStateFlags" parent="byte" mask="true">
      <value value="0x01" name="PilotCopy" text="sent to the pilot: AckInputSeq is valid" />
      <value value="0x02" name="InputSubstituted" text="the server repeated the last input for this step (the pilot's was late)" />
      <value value="0x04" name="BackPressure" text="the server lowered VCap (preload behind)" />
    </enum>
    <enum name="VehicleButtons" parent="byte" mask="true" text="VehicleInputFrame.Buttons">
      <value value="0x01" name="Boost" />
      <value value="0x02" name="Fire" />
      <value value="0x04" name="Land" text="held in Flight: slow to LandingSpeed, then Landing" />
      <value value="0x08" name="Missile" text="fire a lightning-bolt rail; held: the next rail every 0.3 s" />
      <value value="0x10" name="Bomb" text="rising edge: release the next bomb" />
      <value value="0x20" name="Handbrake" />
      <value value="0x40" name="Horn" />
      <value value="0x80" name="Headlights" />
    </enum>
    <enum name="VehicleSeatRole" parent="uint">
      <value value="0" name="Pilot" />
      <value value="1" name="Gunner" />
    </enum>
    <enum name="VehicleSeatState" parent="uint">
      <value value="0" name="Empty" text="the seat emptied (exit, bail, logout)" />
      <value value="1" name="Occupied" />
      <value value="2" name="Refused" text="a VehicleBoard was refused; Reason says why" />
    </enum>
    <enum name="VehicleRefusal" parent="uint">
      <value value="0" name="None" />
      <value value="1" name="TooFar" />
      <value value="2" name="SeatTaken" />
      <value value="3" name="NotParked" />
      <value value="4" name="Indoors" />
      <value value="5" name="InCombatMode" />
      <value value="6" name="NoCapability" />
      <value value="7" name="Busy" text="teleporting, dead, already seated, ..." />
      <value value="8" name="Disabled" text="the server's vehicles_enabled property is off" />
    </enum>
    <enum name="VehicleExitMode" parent="uint">
      <value value="0" name="Exit" text="parked / on the ground only" />
      <value value="1" name="Bail" text="any altitude at or above the floor: freefall + parachute" />
      <value value="2" name="Chute" text="while falling after a bail-out: open the parachute now (else it opens at 150 m above the ground)" />
    </enum>
    <enum name="VehicleWeaponKind" parent="uint">
      <value value="1" name="RepeatingCrossbow" />
      <value value="2" name="Missile" text="a war-magic projectile spell launched from a rail; WeaponExt.SpellId" />
      <value value="3" name="Bomb" text="free-fall bomb; Damage = blast damage at the centre, Range = blast radius, Magazine = 1" />
    </enum>
    <enum name="VehicleEventKind" parent="uint">
      <value value="1" name="Takeoff" />
      <value value="2" name="Landed" />
      <value value="3" name="Crashed" text="Subject = pilot (0 if none); Cell/Pos = impact point" />
      <value value="4" name="Despawn" />
      <value value="5" name="Bail" text="Subject = the player who bailed; Cell/Pos = where" />
      <value value="6" name="Chute" text="Subject = the falling player; the parachute opened" />
      <value value="7" name="Touchdown" text="Subject = the player; back on foot; Value = vertical speed at contact" />
      <value value="8" name="Hit" text="Subject = the creature hit by a bolt; Value = damage" />
      <value value="9" name="BombRelease" text="Subject = the pilot; Cell/Position = release point; Value = mass in lb; v2: Aux = the station's weapon index, Velocity = the bomb's initial velocity" />
      <value value="10" name="Explosion" text="Subject = the pilot; Cell/Position = the impact point; Value = mass in lb; Aux = the station's weapon index" />
      <value value="11" name="Rearmed" text="Subject = the pilot; the vehicle's guns, rails and bomb stations are full again" />
      <value value="12" name="Horn" />
      <value value="13" name="Headlights" />
      <value value="14" name="Scrape" />
      <value value="15" name="CargoDeployed" />
      <value value="16" name="CargoPacked" />
      <value value="17" name="RamHit" />
      <value value="18" name="RadarAlert" />
      <value value="19" name="TrailerHitched" />
      <value value="20" name="TrailerUnhitched" />
      <value value="21" name="TwistlockToggled" />
      <value value="22" name="SideliftStarted" />
      <value value="23" name="SideliftComplete" />
      <value value="24" name="SideliftRefused" />
      <value value="25" name="PalletJackEvent" />
    </enum>
    <enum name="VehiclePartRole" parent="uint" text="Vehicle_Profile.PartRoles: the role in the low 16 bits; Ordnance carries a weapon index in bits 16-23">
      <value value="0" name="Static" />
      <value value="1" name="Propeller" text="spins about the vehicle's forward (y) axis through the part's Offset" />
      <value value="2" name="Gear" text="drawn only while Parked / Takeoff / Landing" />
      <value value="3" name="Canopy" text="hidden in the cockpit view" />
      <value value="4" name="Ordnance" text="drawn while its weapon is loaded; the weapon index is in bits 16-23: role = 4 | (weaponIndex &lt;&lt; 16)" />
      <value value="5" name="WheelFL" />
      <value value="6" name="WheelFR" />
      <value value="7" name="WheelRL" />
      <value value="8" name="WheelRR" />
      <value value="9" name="SteeringWheel" />
      <value value="10" name="Tailgate" />
      <value value="11" name="Cargo" />
      <value value="12" name="Windscreen" />
    </enum>
    <enum name="IffStanding" parent="byte" text="Radar contact IFF classification">
      <value value="0" name="Unknown" />
      <value value="1" name="Friendly" />
      <value value="2" name="Neutral" />
      <value value="3" name="Hostile" />
    </enum>
    <enum name="DeployableKind" parent="uint">
      <value value="0" name="None" />
      <value value="1" name="RadarStation" text="AN/TPS-1 Mobile Air-Search Radar (WCID 4000002)" />
      <value value="2" name="FluxPod" text="Wireless power distribution hub ±75m (WCID 4000010)" />
      <value value="3" name="SolarPanels" text="Sun-tracking photovoltaic array (WCID 4000011)" />
      <value value="4" name="PowerGenerator" text="Arcane Platinum Scarab turbine generator 45 kW (WCID 4000012)" />
      <value value="5" name="BatteryUnit" text="600 kJ capacitor bank with 5-bar display (WCID 4000013)" />
      <value value="6" name="MissileTurret" text="Autonomous SAM air defense turret 4 missiles (WCID 4000014)" />
      <value value="7" name="GroundRadar" text="600m 30 RPM surface surveillance radar (WCID 4000015)" />
      <value value="8" name="MortarTurret" text="Ground mortar lobber 50/50 lead 2 bounces (WCID 4000016)" />
      <value value="9" name="HeavyLaserTurret" text="Direct-energy hitscan red laser 850m LOS 120 kJ (WCID 4000017)" />
      <value value="10" name="IsoContainer20" text="ISO 20ft Standard 1CC/22G1 intermodal container (WCID 4000020)" />
      <value value="11" name="IsoContainer40" text="ISO 40ft Standard 1AA/42G1 intermodal container (WCID 4000021)" />
      <value value="12" name="IsoContainer40HC" text="ISO 40ft High Cube 1AAA/45G1 intermodal container (WCID 4000022)" />
      <value value="13" name="TrailerChassis20" text="20ft skeletal ISO container chassis trailer (WCID 4000030)" />
      <value value="14" name="TrailerChassis40" text="40ft gooseneck ISO container chassis trailer (WCID 4000031)" />
      <value value="15" name="TrailerSidelifter40" text="ISO 3874 40ft gooseneck self-loading sidelifter semi-trailer (WCID 4000032)" />
      <value value="16" name="PalletJack" text="ISO 3691-5 walk-behind pedestrian low-lift pallet jack (WCID 4000035)" />
    </enum>
    <enum name="PalletSize" parent="byte">
      <value value="0" name="None" />
      <value value="1" name="Half" text="Half = 0.6096m x 1.0160m [24x40 in] (1 cargo slot)" />
      <value value="2" name="Full" text="Full = 1.2192m x 1.0160m [48x40 in] (2 cargo slots)" />
    </enum>
    <enum name="DeployableWeaponKind" parent="uint">
      <value value="0" name="None" />
      <value value="1" name="SAM" text="Surface-to-air homing missile" />
      <value value="2" name="Mortar" text="Lobbed compressed-air mortar shell" />
      <value value="3" name="Laser" text="Hitscan red laser beam" />
    </enum>
    <enum name="GroundContactKind" parent="byte">
      <value value="0" name="Unknown" />
      <value value="1" name="Player" />
      <value value="2" name="Vehicle" />
      <value value="3" name="Monster" />
    </enum>
    <enum name="TrailerActionKind" parent="byte">
      <value value="0" name="None" />
      <value value="1" name="Hitch" />
      <value value="2" name="Unhitch" />
      <value value="3" name="ToggleTwistlock" />
      <value value="4" name="MountContainer" />
      <value value="5" name="UnmountContainer" />
      <value value="6" name="DeployOutriggers" />
      <value value="7" name="RetractOutriggers" />
      <value value="8" name="SideliftOffload" />
      <value value="9" name="SideliftLoad" />
      <value value="10" name="StowPalletJack" />
      <value value="11" name="DeployPalletJack" />
      <value value="12" name="CancelSidelift" />
      <value value="13" name="AutoOffload" />
      <value value="14" name="AutoLoad" />
    </enum>
    <enum name="SideliftPhase" parent="byte">
      <value value="0" name="Idle" />
      <value value="1" name="OutriggersDeploying" />
      <value value="2" name="OutriggersPlanted" />
      <value value="3" name="CranesPositioning" />
      <value value="4" name="CranesLatched" />
      <value value="5" name="Hoisting" />
      <value value="6" name="Swinging" />
      <value value="7" name="Lowering" />
      <value value="8" name="Releasing" />
      <value value="9" name="CranesStowing" />
      <value value="10" name="OutriggersRetracting" />
    </enum>
    <enum name="PalletJackActionKind" parent="byte">
      <value value="1" name="Grab" />
      <value value="2" name="Release" />
      <value value="3" name="UpdatePose" />
      <value value="4" name="RaiseForks" />
      <value value="5" name="LowerForks" />
      <value value="6" name="PickGroundDeployable" />
      <value value="7" name="DropToGround" />
      <value value="8" name="PickContainerSlot" />
      <value value="9" name="LoadContainerSlot" />
      <value value="10" name="ToggleDeployableStow" />
    </enum>
  </enums>
  <types>
    <type name="sbyte" primitive="sbyte" />
    <type name="short" primitive="short" />
    <type name="VehicleHeader" text="Starts every HBV1 payload">
      <field type="uint" name="Tag" text="0x31564248 = the bytes 'H' 'B' 'V' '1'" />
      <field type="ushort" name="Version" text="the writer's protocol version: 7 (1..6 from older writers)" />
      <field type="ushort" name="Reserved" text="0" />
    </type>
    <type name="VehicleSeatDef">
      <field type="VehicleSeatRole" name="Role" />
      <field type="uint" name="Motion" text="retail MotionCommand the occupant shows to everyone (Sitting = 0x41000013)" />
      <field type="Vector3" name="Offset" text="seat position in the vehicle frame (x right, y forward, z up)" />
    </type>
    <type name="VehicleWeaponDef">
      <field type="VehicleWeaponKind" name="Kind" />
      <field type="float" name="RoundsPerSecond" />
      <field type="float" name="Spread" text="half-angle of the cone, radians" />
      <field type="float" name="Range" />
      <field type="float" name="Damage" text="per round" />
      <field type="uint" name="Magazine" />
      <field type="Vector3" name="Muzzle" text="muzzle position in the vehicle frame" />
    </type>
    <type name="VehicleWeaponExt" text="v2: per-weapon extras, parallel to Vehicle_Profile.Weapons (20 bytes)">
      <field type="float" name="MuzzleVelocity" text="m/s relative to the vehicle: the quarrel / bolt launch speed" />
      <field type="float" name="Convergence" text="m: guns aim at the boresight point this far ahead; 0 = parallel" />
      <field type="float" name="MassKg" text="bombs" />
      <field type="float" name="DragTerminal" text="m/s: a bomb's terminal velocity" />
      <field type="uint" name="SpellId" text="missiles: the war spell launched" />
    </type>
    <type name="VehiclePartDef" text="The vehicle's looks as data (DESIGN §5.1 rule 2): one retail Setup (0x02xxxxxx) or GfxObj (0x01xxxxxx) placed in the vehicle frame">
      <field type="uint" name="Did" />
      <field type="Vector3" name="Offset" />
      <field type="Quaternion" name="Rotation" text="W, X, Y, Z" />
      <field type="float" name="Scale" />
    </type>
    <type name="VehicleInputFrame" text="One 30 Hz step of pilot input (12 bytes)">
      <field type="uint" name="Seq" text="the client's step index; the server consumes one per step in order" />
      <field type="byte" name="Throttle" text="0..255 -> 0..1" />
      <field type="sbyte" name="Pitch" text="-127..127 -> -1..1, nose up positive" />
      <field type="sbyte" name="Roll" text="right positive" />
      <field type="sbyte" name="Yaw" text="right positive (rudder)" />
      <field type="VehicleButtons" name="Buttons" />
      <field type="byte" name="Reserved0" />
      <field type="byte" name="Reserved1" />
      <field type="byte" name="Reserved2" />
    </type>
    <type name="RadarContactWire" text="18 bytes packed radar contact record">
      <field type="ObjectId" name="VehicleGuid" />
      <field type="float" name="DxM" />
      <field type="float" name="DyM" />
      <field type="ushort" name="AltAglM" />
      <field type="byte" name="HeadingU8" />
      <field type="byte" name="Standing" />
      <field type="byte" name="SpeedMpsU8" />
      <field type="byte" name="Flags" />
    </type>
    <type name="GroundContactWire" text="24 bytes packed surface radar contact record">
      <field type="ObjectId" name="TargetGuid" />
      <field type="float" name="DxM" />
      <field type="float" name="DyM" />
      <field type="float" name="DzM" />
      <field type="GroundContactKind" name="Kind" />
      <field type="IffStanding" name="Standing" />
      <field type="byte" name="HeadingU8" />
      <field type="byte" name="SpeedMpsU8" />
      <field type="byte" name="Flags" />
      <field type="byte" name="Reserved0" />
      <field type="byte" name="Reserved1" />
      <field type="byte" name="Reserved2" />
    </type>
    <type name="ContainerSlotWire" text="8 bytes packed container cargo slot manifest record">
      <field type="byte" name="SlotIndex" />
      <field type="PalletSize" name="PalletSize" />
      <field type="byte" name="SubSlot" />
      <field type="byte" name="Reserved" />
      <field type="ObjectId" name="CargoWcid" />
    </type>
  </types>
  <gameactions>
    <type name="Vehicle_ClientCapabilities" queue="Weenie" type="0x0900" text="A capable client announces itself after entering the world (once per login)">
      <field type="VehicleHeader" name="Header" />
      <field type="VehicleCapability" name="Flags" />
    </type>
    <type name="Vehicle_Board" queue="Weenie" type="0x0902" text="Take a seat (pilot bit required)">
      <field type="VehicleHeader" name="Header" />
      <field type="ObjectId" name="Vehicle" />
      <field type="uint" name="Seat" />
    </type>
    <type name="Vehicle_Exit" queue="Weenie" type="0x0903" text="Leave the seat: exit (parked) or bail (in the air)">
      <field type="VehicleHeader" name="Header" />
      <field type="ObjectId" name="Vehicle" />
      <field type="VehicleExitMode" name="Mode" />
    </type>
    <type name="Vehicle_Input" queue="Weenie" type="0x0905" text="30 Hz while seated; newest frame first, then up to 2 previous frames (redundancy)">
      <field type="VehicleHeader" name="Header" />
      <field type="ObjectId" name="Vehicle" />
      <field type="uint" name="Count" text="1..3" />
