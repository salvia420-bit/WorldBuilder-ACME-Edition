    <type name="Vehicle_Cargo" queue="Weenie" type="0x0909" text="Client request for vehicle cargo deployment or re-packing (1=Deploy, 2=Pack)">
      <field type="VehicleHeader" name="Header" />
      <field type="ObjectId" name="Vehicle" />
      <field type="byte" name="Action" text="1=Deploy, 2=Pack" />
      <field type="ObjectId" name="Target" text="Target cargo world object ID (0 on deploy)" />
      <field type="byte" name="Slot" since="4" default="0" text="Cargo slot index: 0=Left/Full bed, 1=Right half-pallet" />
      <field type="byte" name="Reserved0" since="4" default="0" />
      <field type="ushort" name="Reserved1" since="4" default="0" />
      <field type="ObjectId" name="CargoWcid" since="4" default="0" text="Target deployable WCID" />
    </type>
    <type name="Vehicle_ContainerAction" queue="Weenie" type="0x090E" text="Client container action request (1=OpenDoors, 2=CloseDoors, 3=Load, 4=Pack, 5=Unpack, 6=UnpackAll)">
      <field type="VehicleHeader" name="Header" />
      <field type="ObjectId" name="Container" />
      <field type="byte" name="Action" />
      <field type="byte" name="SlotIndex" />
      <field type="byte" name="SubSlot" />
      <field type="byte" name="Reserved" />
      <field type="ObjectId" name="CargoWcid" />
    </type>
    <type name="Vehicle_TrailerAction" queue="Weenie" type="0x090F" text="Client trailer hitch/unhitch/twistlock/mount/unmount/sidelift action">
      <field type="VehicleHeader" name="Header" />
      <field type="ObjectId" name="TrailerGuid" />
      <field type="ObjectId" name="VehicleGuid" />
      <field type="ObjectId" name="ContainerGuid" />
