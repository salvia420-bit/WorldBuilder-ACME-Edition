+        [TestMethod]
+        public void Tier5_R2HIGH01_TryMintBullion_OverburdenedOnlinePlayer_PreservesFullWarehouseStock()
+        {
+            uint monarchId = AllocTestGuid();
+            var holtburg = TownRegistry.GetById(1u);
+            var actor = CreateInventoryPlayer(monarchId, holtburg.AnchorLandblock, (float)holtburg.WorldX, (float)holtburg.WorldY, (float)holtburg.WorldZ, monarchId: monarchId, isMonarch: true, itemsCapacity: 10);
+            AttachNetworkedMockSession(actor, VehicleWire.CapObserve);
+
+            // Give actor 10 free inventory slots, but set EncumbranceVal > GetEncumbranceCapacity() * 3
+            actor.Biota.PropertiesAttribute[PropertyAttribute.Strength] = new PropertiesAttribute { InitLevel = 10 };
+            int maxCarry = actor.GetEncumbranceCapacity() * 3;
+            actor.EncumbranceVal = maxCarry + 50_000;
+            Assert.IsTrue(actor.GetFreeInventorySlots() >= 10, "Actor must have 10 free slots");
+            Assert.IsFalse(actor.HasEnoughBurdenToAddToInventory(0), "Actor must fail burden check");
+
+            TownEconomyManager.SetTownOwner(1u, monarchId, "CONTROLLED");
+            TownEconomyManager.SeedWarehouseStock(1u, "pyreal_bar", 100);
+
+            var mintPos = Vehicle.ToPosition(holtburg.WorldX, holtburg.WorldY, holtburg.WorldZ, Quaternion.Identity);
+            var fluxPod = (FluxPodDeployable)DeployableManager.SpawnDeployable(FluxPodDeployable.FluxPodWeenieClassId, mintPos, actor);
+            var genset = (IndustrialGensetDeployable)DeployableManager.SpawnDeployable(IndustrialGensetDeployable.WcidIndustrialGenset150kW, mintPos, actor);
+            genset.AddFuelSeconds(600.0);
+            genset.IsActive = true;
+            var mint = (TownMintDeployable)DeployableManager.SpawnDeployable(TownMintDeployable.TownMintWeenieClassId, mintPos, actor);
+            mint.AffiliatedTownId = 1u;
+            mint.OnlineFlags |= DeployableOnlineFlags.Powered;
+            mint.Grid = fluxPod.Grid;
+
+            bool ok = IndustryManager.TryMintBullion(mint, actor, 1u, IndustryManager.PyrealBarWcid, 1, depositToTreasury: false, out long minted, out string err);
+            Assert.IsFalse(ok, "[R2-HIGH-01] Overburdened online player TryMintBullion MUST fail");
+            Assert.AreEqual(0L, minted);
+            Assert.IsFalse(string.IsNullOrWhiteSpace(err));
+            Assert.AreEqual(100, TownEconomyManager.GetWarehouseStockQty(1u, "pyreal_bar"),
+                "[R2-HIGH-01] Failed TryMintBullion MUST NOT wipe out remaining 99 warehouse pyreal_bar units");
+
+            // Also verify RefundWarehouseStock restores additively without clearing InactivityElapsedSec or overwriting existing stock
+            var state = TownEconomyManager.GetTownState(1u);
+            lock (state.SyncRoot) { state.InactivityElapsedSec = 1234.5; }
+            Assert.IsTrue(TownEconomyManager.TryConsumeWarehouseStock(1u, "pyreal_bar", 3, out var slices, out var consErr), consErr);
+            Assert.AreEqual(97, TownEconomyManager.GetWarehouseStockQty(1u, "pyreal_bar"));
+            foreach (var s in slices)
+                TownEconomyManager.RefundWarehouseStock(1u, "pyreal_bar", s.Qty, s.GradeBps, s.PoweredReefer, s.FreshnessPct);
+            Assert.AreEqual(100, TownEconomyManager.GetWarehouseStockQty(1u, "pyreal_bar"),
+                "[R2-HIGH-01] RefundWarehouseStock must additively restore consumed slices");
+            lock (state.SyncRoot)
+            {
+                Assert.AreEqual(1234.5, state.InactivityElapsedSec, 0.001,
+                    "[R2-HIGH-01] RefundWarehouseStock must not clear InactivityElapsedSec");
+            }
+        }
