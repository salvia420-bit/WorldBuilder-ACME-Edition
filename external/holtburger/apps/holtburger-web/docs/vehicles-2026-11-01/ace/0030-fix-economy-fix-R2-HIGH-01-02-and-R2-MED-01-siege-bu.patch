+
+            var beacon = (ForwardSiegeBeaconDeployable)DeployableManager.SpawnDeployable(
+                ForwardSiegeBeaconDeployable.ForwardSiegeBeaconWeenieClassId, beaconPos, attacker);
+            beacon.TargetTownId = 1u;
+
+            uint farOrigin = SiegeManager.PackOriginLandblockId(new LandblockId(0xB2B40001u));
+
+            // 1. Item whose stack consumption fails (StackSize=3 > MaxStackSize=1 causes AdjustStack(-1) to return false)
