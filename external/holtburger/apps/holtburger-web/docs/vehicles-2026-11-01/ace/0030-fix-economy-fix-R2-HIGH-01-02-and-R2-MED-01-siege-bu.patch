+            Assert.IsTrue(attacker.TryAddToInventory(badStack, out _, burdenCheck: false));
+
+            bool badOk = beacon.TryAcceptInventoryItem(badStack, attacker, 100.0, out var badMsg);
+            Assert.IsFalse(badOk, "[R2-MED-01] TryAcceptInventoryItem MUST fail when inventory consumption returns false");
+            Assert.IsFalse(string.IsNullOrWhiteSpace(badMsg));
+            Assert.AreEqual(0.0, SiegeManager.GetSiegeState(1u).SupplyMeterSec, 0.001,
+                "[R2-MED-01] Failed consumption MUST NOT credit SupplyMeterSec");
+            Assert.AreEqual(3, badStack.StackSize);
+            Assert.AreEqual(farOrigin, (uint)(badStack.GetProperty(PropertyInt.OriginLandblockId) ?? 0));
