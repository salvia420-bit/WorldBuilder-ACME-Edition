diff --git a/Source/ACE.Server/Vehicles/AirDefense/AirDefenseManager.cs b/Source/ACE.Server/Vehicles/AirDefense/AirDefenseManager.cs
new file mode 100644
index 00000000..01b76f57
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/AirDefense/AirDefenseManager.cs
@@ -0,0 +1,216 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Numerics;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.AirDefense
+{
+    public static class AirDefenseManager
+    {
+        public const float MaxDetectionRangeM = 32187.0f; // 20 statute miles
+        public const float MaxCeilingAglM = 1550.0f;      // 1,550 m AGL
+        public const float MinFloorAglM = 8.0f;           // 8 m AGL
+        public const double SweepIntervalSeconds = 1.0;   // 1 Hz
+
+        private static readonly ConcurrentDictionary<uint, RadarStation> stations = new ConcurrentDictionary<uint, RadarStation>();
+
+        public static IReadOnlyCollection<RadarStation> Stations => (IReadOnlyCollection<RadarStation>)stations.Values;
+
+        public static void RegisterStation(RadarStation station)
+        {
+            if (station != null)
+            {
+                stations[station.Guid.Full] = station;
+                if (station.Sensor != null)
+                    AirDefenseRegistry.RegisterSensor(station.Sensor);
+            }
+        }
+
+        public static void UnregisterStation(uint stationGuid)
+        {
+            if (stations.TryRemove(stationGuid, out var station))
+            {
+                if (station?.Sensor != null)
+                    AirDefenseRegistry.UnregisterSensor(station.Sensor.SensorGuid);
+            }
+            else
+            {
+                AirDefenseRegistry.UnregisterSensor(stationGuid);
+            }
+        }
+
+        public static void ClearStations()
+        {
+            stations.Clear();
+            AirDefenseRegistry.Clear();
+        }
+
+        public static bool IsTargetDetected(
+            Vector3 radarPos,
+            Vehicle target,
+            out float rangeM,
+            out float aglM,
+            out float bearingRad,
+            Func<float, float, float> terrainLookup = null)
+        {
+            rangeM = 0f;
+            aglM = 0f;
+            bearingRad = 0f;
+
+            if (target == null || target.IsDestroyed)
+                return false;
+
+            // 1. Locomotion filter: airborne aircraft only (Locomotion == 1)
+            if (target.Profile == null || target.Profile.Locomotion != VehicleLocomotion.Air)
+                return false;
+
+            // 2. Horizontal range gate (<= 32,187m)
+            var dx = (float)(target.State.X - radarPos.X);
+            var dy = (float)(target.State.Y - radarPos.Y);
+            rangeM = MathF.Sqrt(dx * dx + dy * dy);
+            if (rangeM > MaxDetectionRangeM)
+                return false;
+
+            // 3. Altitude AGL gate (8m <= AGL <= 1,550m)
+            var groundZ = terrainLookup != null
+                ? terrainLookup((float)target.State.X, (float)target.State.Y)
+                : (float)VehicleTerrain.Ground(target.State.X, target.State.Y);
+
+            if (float.IsNaN(groundZ))
+                return false;
+
+            aglM = (float)(target.State.Z - groundZ);
+            if (aglM < MinFloorAglM || aglM > MaxCeilingAglM)
+                return false;
+
+            // 4. Relative bearing calculation normalized to [0, 2*PI)
+            bearingRad = MathF.Atan2(dx, dy);
+            if (bearingRad < 0.0f)
+                bearingRad += 2.0f * MathF.PI;
+
+            // 5. 3D Terrain Line-of-Sight with planetary curvature drop
+            if (!VehicleTerrain.RadarLosClear(
+                radarPos.X, radarPos.Y, radarPos.Z,
+                target.State.X, target.State.Y, target.State.Z,
+                mastHeight: RadarStation.MastHeightM,
+                targetBeaconHeight: RadarStation.TargetBeaconHeightM,
+                stepM: VehicleTerrain.DefaultRaymarchStepM,
+                terrainLookup: terrainLookup))
+            {
+                return false;
+            }
+
+            return true;
+        }
+
+        /// <summary>
+        /// Pure evaluation method for standalone testing without full Vehicle world object instantiation.
+        /// </summary>
+        public static bool IsTargetDetectedPure(
+            Vector3 radarPos,
+            Vector3 targetPos,
+            float altitudeAgl,
+            uint locomotion,
+            Func<float, float, float> terrainLookup = null)
+        {
+            if (locomotion != VehicleLocomotion.Air)
+                return false;
+
+            var dx = targetPos.X - radarPos.X;
+            var dy = targetPos.Y - radarPos.Y;
+            var dist = MathF.Sqrt(dx * dx + dy * dy);
+            if (dist > MaxDetectionRangeM)
+                return false;
+
+            if (altitudeAgl < MinFloorAglM || altitudeAgl > MaxCeilingAglM)
+                return false;
+
+            if (!VehicleTerrain.RadarLosClear(
+                radarPos.X, radarPos.Y, radarPos.Z,
+                targetPos.X, targetPos.Y, targetPos.Z,
+                mastHeight: RadarStation.MastHeightM,
+                targetBeaconHeight: RadarStation.TargetBeaconHeightM,
+                terrainLookup: terrainLookup))
+            {
+                return false;
+            }
+
+            return true;
+        }
+
+        public static void Tick(double elapsedSeconds)
+        {
+            foreach (var station in stations.Values)
+            {
+                if (station.IsDestroyed || !station.IsActive)
+                {
+                    if (station.IsDestroyed)
+                        UnregisterStation(station.Guid.Full);
+                    continue;
+                }
+
+                station.SweepTimer += elapsedSeconds;
+                if (station.SweepTimer >= SweepIntervalSeconds)
+                {
+                    station.SweepTimer -= SweepIntervalSeconds;
+                    if (station.SweepTimer > SweepIntervalSeconds)
+                        station.SweepTimer = 0.0;
+
+                    PerformSweep(station);
+                }
+            }
+        }
+
+        public static IReadOnlyList<AirTrack> PerformSweep(
+            RadarStation station,
+            IEnumerable<Vehicle> candidates = null,
+            Func<float, float, float> terrainLookup = null,
+            DateTime? nowUtc = null)
+        {
+            if (station == null)
+                return Array.Empty<AirTrack>();
+
+            station.UpdateSensorPosition();
+            var pool = candidates ?? VehicleManager.All;
+            var detectedCandidates = new List<AirTrackCandidate>();
+            var radarPos = station.Position;
+
+            foreach (var v in pool)
+            {
+                if (!IsTargetDetected(radarPos, v, out var rangeM, out var aglM, out var bearingRad, terrainLookup))
+                    continue;
+
+                var standing = RadarIff.ResolveStanding(v, station);
+                var pilotGuid = v.Pilot;
+                var pilotPlayer = pilotGuid != 0 ? PlayerManager.GetOnlinePlayer(pilotGuid) : null;
+                uint? pilotMonarchId = pilotPlayer?.MonarchId ?? pilotPlayer?.Allegiance?.MonarchId;
+
+                var targetPos = new Vector3((float)v.State.X, (float)v.State.Y, (float)v.State.Z);
+                var targetVel = v.WorldVelocity();
+
+                detectedCandidates.Add(new AirTrackCandidate
+                {
+                    VehicleGuid = v.Guid.Full,
+                    PilotGuid = pilotGuid,
+                    PilotMonarchId = pilotMonarchId,
+                    Standing = standing,
+                    WorldPos = targetPos,
+                    WorldVel = targetVel,
+                    RangeM = rangeM,
+                    BearingRad = bearingRad,
+                    AltitudeAglM = aglM,
+                });
+            }
+
+            var scanTime = nowUtc ?? DateTime.UtcNow;
+            station.LastScanUtc = scanTime;
+            station.Sensor.ProcessSweep(detectedCandidates, scanTime);
+
+            var activeTracks = station.Sensor.GetActiveTracks();
+            station.BroadcastContacts(activeTracks);
+            return activeTracks;
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/AirDefense/AirDefenseSensor.cs b/Source/ACE.Server/Vehicles/AirDefense/AirDefenseSensor.cs
new file mode 100644
index 00000000..7190743e
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/AirDefense/AirDefenseSensor.cs
@@ -0,0 +1,323 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+
+namespace ACE.Server.Vehicles.AirDefense
+{
+    /// <summary>
+    /// Feature 35: Live radar contact track record.
+    /// </summary>
+    public struct AirTrack
+    {
+        public uint RadarGuid;
+        public uint VehicleGuid;
+        public uint PilotGuid;
+        public uint? PilotMonarchId;
+        public IffStanding Standing;
+        public Vector3 WorldPos;
+        public Vector3 WorldVel;
+        public float RangeM;
+        public float BearingRad;
+        public float AltitudeAglM;
+        public int ConsecutiveHits;
+        public DateTime LastSeenUtc;
+
+        public RadarContactWire ToWire(Vector3 radarPosition)
+        {
+            float dx = WorldPos.X - radarPosition.X;
+            float dy = WorldPos.Y - radarPosition.Y;
+            ushort altAgl = (ushort)Math.Clamp(Math.Round(AltitudeAglM), 0, 65535);
+
+            float speed = WorldVel.Length();
+            byte speedU8 = (byte)Math.Clamp(Math.Round(speed), 0, 255);
+
+            float heading = (float)Math.Atan2(WorldVel.X, WorldVel.Y);
+            if (heading < 0) heading += (float)(2.0 * Math.PI);
+            byte headingU8 = (byte)Math.Clamp(Math.Round((heading / (2.0 * Math.PI)) * 255.0), 0, 255);
+
+            return new RadarContactWire
+            {
+                VehicleGuid = VehicleGuid,
+                DxM = dx,
+                DyM = dy,
+                AltAglM = altAgl,
+                HeadingU8 = headingU8,
+                Standing = (byte)Standing,
+                SpeedMpsU8 = speedU8,
+                Flags = 0
+            };
+        }
+    }
+
+    /// <summary>
+    /// Transient contact detection candidate from a 1 Hz radar scan.
+    /// </summary>
+    public struct AirTrackCandidate
+    {
+        public uint VehicleGuid;
+        public uint PilotGuid;
+        public uint? PilotMonarchId;
+        public IffStanding Standing;
+        public Vector3 WorldPos;
+        public Vector3 WorldVel;
+        public float RangeM;
+        public float BearingRad;
+        public float AltitudeAglM;
+    }
+
+    /// <summary>
+    /// Turret Sensor Bus interface for querying active tracks and receiving track events.
+    /// </summary>
+    public interface IAirDefenseSensor
+    {
+        uint SensorGuid { get; }
+        Vector3 SensorPosition { get; set; }
+        float MaxRangeM { get; }
+        float MaxCeilingM { get; }
+        int ActiveTrackCount { get; }
+
+        IReadOnlyList<AirTrack> GetActiveTracks();
+        IReadOnlyList<AirTrack> GetHostileTracks();
+        IReadOnlyList<AirTrack> GetTracksByStanding(IffStanding standing);
+        bool TryGetTrack(uint vehicleGuid, out AirTrack track);
+        AirTrack? GetNearestHostile(Vector3 fromPosition);
+
+        void ProcessSweep(IReadOnlyList<AirTrackCandidate> candidates, DateTime nowUtc);
+        VehicleRadarContactsMsg CreateRadarContactsMsg(uint parentVehicleGuid);
+
+        event Action<IAirDefenseSensor, AirTrack> TrackAcquired;
+        event Action<IAirDefenseSensor, AirTrack> TrackUpdated;
+        event Action<IAirDefenseSensor, uint> TrackLost;
+    }
+
+    /// <summary>
+    /// Autonomous air defense sensor implementation managing live AirTracks and wire telemetry.
+    /// </summary>
+    public class AirDefenseSensor : IAirDefenseSensor
+    {
+        private readonly Dictionary<uint, AirTrack> tracks = new Dictionary<uint, AirTrack>();
+        private readonly object lockObj = new object();
+
+        public uint SensorGuid { get; set; }
+        public Vector3 SensorPosition { get; set; }
+        public float MaxRangeM { get; set; } = 32187.0f;
+        public float MaxCeilingM { get; set; } = 1550.0f;
+        public TimeSpan TrackTimeout { get; set; } = TimeSpan.FromSeconds(3.0);
+
+        public int ActiveTrackCount
+        {
+            get { lock (lockObj) return tracks.Count; }
+        }
+
+        public event Action<IAirDefenseSensor, AirTrack> TrackAcquired;
+        public event Action<IAirDefenseSensor, AirTrack> TrackUpdated;
+        public event Action<IAirDefenseSensor, uint> TrackLost;
+
+        public AirDefenseSensor(uint sensorGuid, Vector3 sensorPosition, float maxRange = 32187.0f, float maxCeiling = 1550.0f)
+        {
+            SensorGuid = sensorGuid;
+            SensorPosition = sensorPosition;
+            MaxRangeM = maxRange;
+            MaxCeilingM = maxCeiling;
+        }
+
+        public void ProcessSweep(IReadOnlyList<AirTrackCandidate> candidates, DateTime nowUtc)
+        {
+            var detectedGuids = new HashSet<uint>();
+            var acquired = new List<AirTrack>();
+            var updated = new List<AirTrack>();
+            var lost = new List<uint>();
+
+            lock (lockObj)
+            {
+                if (candidates != null)
+                {
+                    foreach (var c in candidates)
+                    {
+                        detectedGuids.Add(c.VehicleGuid);
+                        if (tracks.TryGetValue(c.VehicleGuid, out var existing))
+                        {
+                            var track = new AirTrack
+                            {
+                                RadarGuid = SensorGuid,
+                                VehicleGuid = c.VehicleGuid,
+                                PilotGuid = c.PilotGuid,
+                                PilotMonarchId = c.PilotMonarchId,
+                                Standing = c.Standing,
+                                WorldPos = c.WorldPos,
+                                WorldVel = c.WorldVel,
+                                RangeM = c.RangeM,
+                                BearingRad = c.BearingRad,
+                                AltitudeAglM = c.AltitudeAglM,
+                                ConsecutiveHits = existing.ConsecutiveHits + 1,
+                                LastSeenUtc = nowUtc,
+                            };
+                            tracks[c.VehicleGuid] = track;
+                            updated.Add(track);
+                        }
+                        else
+                        {
+                            var track = new AirTrack
+                            {
+                                RadarGuid = SensorGuid,
+                                VehicleGuid = c.VehicleGuid,
+                                PilotGuid = c.PilotGuid,
+                                PilotMonarchId = c.PilotMonarchId,
+                                Standing = c.Standing,
+                                WorldPos = c.WorldPos,
+                                WorldVel = c.WorldVel,
+                                RangeM = c.RangeM,
+                                BearingRad = c.BearingRad,
+                                AltitudeAglM = c.AltitudeAglM,
+                                ConsecutiveHits = 1,
+                                LastSeenUtc = nowUtc,
+                            };
+                            tracks[c.VehicleGuid] = track;
+                            acquired.Add(track);
+                        }
+                    }
+                }
+
+                // Check for lost tracks exceeding timeout
+                var deadGuids = new List<uint>();
+                foreach (var (guid, track) in tracks)
+                {
+                    if (!detectedGuids.Contains(guid) && (nowUtc - track.LastSeenUtc) >= TrackTimeout)
+                    {
+                        deadGuids.Add(guid);
+                    }
+                }
+                foreach (var deadGuid in deadGuids)
+                {
+                    tracks.Remove(deadGuid);
+                    lost.Add(deadGuid);
+                }
+            }
+
+            // Fire events outside lock
+            foreach (var t in acquired) TrackAcquired?.Invoke(this, t);
+            foreach (var t in updated) TrackUpdated?.Invoke(this, t);
+            foreach (var g in lost) TrackLost?.Invoke(this, g);
+        }
+
+        public IReadOnlyList<AirTrack> GetActiveTracks()
+        {
+            lock (lockObj) return tracks.Values.ToList();
+        }
+
+        public IReadOnlyList<AirTrack> GetHostileTracks()
+        {
+            lock (lockObj) return tracks.Values.Where(t => t.Standing == IffStanding.Hostile).ToList();
+        }
+
+        public IReadOnlyList<AirTrack> GetTracksByStanding(IffStanding standing)
+        {
+            lock (lockObj) return tracks.Values.Where(t => t.Standing == standing).ToList();
+        }
+
+        public bool TryGetTrack(uint vehicleGuid, out AirTrack track)
+        {
+            lock (lockObj) return tracks.TryGetValue(vehicleGuid, out track);
+        }
+
+        public AirTrack? GetNearestHostile(Vector3 fromPosition)
+        {
+            lock (lockObj)
+            {
+                AirTrack? best = null;
+                float bestDistSq = float.MaxValue;
+                foreach (var t in tracks.Values)
+                {
+                    if (t.Standing != IffStanding.Hostile) continue;
+                    float dx = t.WorldPos.X - fromPosition.X;
+                    float dy = t.WorldPos.Y - fromPosition.Y;
+                    float dz = t.WorldPos.Z - fromPosition.Z;
+                    float distSq = dx * dx + dy * dy + dz * dz;
+                    if (distSq < bestDistSq)
+                    {
+                        bestDistSq = distSq;
+                        best = t;
+                    }
+                }
+                return best;
+            }
+        }
+
+        public VehicleRadarContactsMsg CreateRadarContactsMsg(uint parentVehicleGuid)
+        {
+            var msg = new VehicleRadarContactsMsg
+            {
+                RadarGuid = SensorGuid,
+                ParentVehicle = parentVehicleGuid,
+                RadarX = SensorPosition.X,
+                RadarY = SensorPosition.Y,
+                RadarZ = SensorPosition.Z,
+                RangeM = MaxRangeM,
+                CeilingM = MaxCeilingM,
+            };
+
+            lock (lockObj)
+            {
+                foreach (var track in tracks.Values)
+                {
+                    msg.Contacts.Add(track.ToWire(SensorPosition));
+                }
+            }
+
+            return msg;
+        }
+    }
+
+    /// <summary>
+    /// Centralized registry for air defense sensors.
+    /// Allows future SAM turrets to query active airspace tracks.
+    /// </summary>
+    public static class AirDefenseRegistry
+    {
+        private static readonly ConcurrentDictionary<uint, IAirDefenseSensor> sensors = new ConcurrentDictionary<uint, IAirDefenseSensor>();
+
+        public static void RegisterSensor(IAirDefenseSensor sensor)
+        {
+            if (sensor != null)
+                sensors[sensor.SensorGuid] = sensor;
+        }
+
+        public static void UnregisterSensor(uint sensorGuid)
+        {
+            sensors.TryRemove(sensorGuid, out _);
+        }
+
+        public static IAirDefenseSensor GetSensor(uint sensorGuid) =>
+            sensors.TryGetValue(sensorGuid, out var s) ? s : null;
+
+        public static IEnumerable<IAirDefenseSensor> GetAllSensors() => sensors.Values;
+
+        public static void Clear() => sensors.Clear();
+
+        public static AirTrack? FindNearestHostile(Vector3 fromPos, float maxRange = float.MaxValue)
+        {
+            AirTrack? bestTrack = null;
+            float bestDistSq = maxRange * maxRange;
+
+            foreach (var sensor in sensors.Values)
+            {
+                var hostile = sensor.GetNearestHostile(fromPos);
+                if (hostile.HasValue)
+                {
+                    float dx = hostile.Value.WorldPos.X - fromPos.X;
+                    float dy = hostile.Value.WorldPos.Y - fromPos.Y;
+                    float dz = hostile.Value.WorldPos.Z - fromPos.Z;
+                    float distSq = dx * dx + dy * dy + dz * dz;
+                    if (distSq < bestDistSq)
+                    {
+                        bestDistSq = distSq;
+                        bestTrack = hostile;
+                    }
+                }
+            }
+            return bestTrack;
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/AirDefense/RadarIff.cs b/Source/ACE.Server/Vehicles/AirDefense/RadarIff.cs
new file mode 100644
index 00000000..a590c2f0
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/AirDefense/RadarIff.cs
@@ -0,0 +1,154 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.AirDefense
+{
+    /// <summary>
+    /// Configurable IFF policy for monarchies and radar stations.
+    /// Maps monarch IDs and guild/monarch names to IFF standings.
+    /// </summary>
+    public class GuildRadarPolicy
+    {
+        public Dictionary<uint, IffStanding> PolicyByMonarchId { get; } = new Dictionary<uint, IffStanding>();
+        public Dictionary<string, IffStanding> PolicyByMonarchName { get; } = new Dictionary<string, IffStanding>(StringComparer.OrdinalIgnoreCase);
+
+        /// <summary>Default standing for foreign / unlisted contacts (defaults to Hostile).</summary>
+        public IffStanding DefaultStanding { get; set; } = IffStanding.Hostile;
+
+        public void SetStanding(uint monarchId, IffStanding standing) => PolicyByMonarchId[monarchId] = standing;
+        public void SetStanding(string monarchName, IffStanding standing) => PolicyByMonarchName[monarchName] = standing;
+        public bool RemoveStanding(uint monarchId) => PolicyByMonarchId.Remove(monarchId);
+        public bool RemoveStanding(string monarchName) => PolicyByMonarchName.Remove(monarchName);
+
+        public void Clear()
+        {
+            PolicyByMonarchId.Clear();
+            PolicyByMonarchName.Clear();
+            DefaultStanding = IffStanding.Hostile;
+        }
+
+        public IffStanding GetStanding(uint monarchId) =>
+            PolicyByMonarchId.TryGetValue(monarchId, out var s) ? s : DefaultStanding;
+
+        public IffStanding GetStanding(string monarchName) =>
+            (!string.IsNullOrWhiteSpace(monarchName) && PolicyByMonarchName.TryGetValue(monarchName, out var s)) ? s : DefaultStanding;
+    }
+
+    /// <summary>
+    /// Feature 34: Monarch & Guild IFF Resolution Engine.
+    /// </summary>
+    public static class RadarIff
+    {
+        private static readonly ConcurrentDictionary<uint, GuildRadarPolicy> monarchPolicies = new ConcurrentDictionary<uint, GuildRadarPolicy>();
+
+        public static GuildRadarPolicy GetOrCreateMonarchPolicy(uint monarchId) =>
+            monarchPolicies.GetOrAdd(monarchId, _ => new GuildRadarPolicy());
+
+        public static void SetMonarchPolicy(uint monarchId, GuildRadarPolicy policy) =>
+            monarchPolicies[monarchId] = policy;
+
+        public static void ResetPolicies() => monarchPolicies.Clear();
+
+        /// <summary>
+        /// Resolves IFF standing for a target vehicle relative to a deployed radar station.
+        /// </summary>
+        public static IffStanding ResolveStanding(Vehicle target, RadarStation station)
+        {
+            if (target == null || station == null)
+                return IffStanding.Hostile;
+
+            var policy = station.Policy;
+            var pilotGuid = target.Pilot;
+            if (pilotGuid == 0)
+                return policy?.DefaultStanding ?? IffStanding.Hostile;
+
+            if (pilotGuid == station.DeployerPlayerGuid)
+                return IffStanding.Friendly;
+
+            var targetPlayer = PlayerManager.GetOnlinePlayer(pilotGuid);
+            uint? targetMonarchId = targetPlayer?.MonarchId ?? targetPlayer?.Allegiance?.MonarchId;
+            string targetMonarchName = targetPlayer?.Allegiance?.Monarch?.Player?.Name ?? targetPlayer?.Allegiance?.AllegianceName;
+            uint? targetFellowshipId = targetPlayer?.Fellowship != null ? (uint?)targetPlayer.Fellowship.GetHashCode() : null;
+
+            return ResolveStanding(
+                pilotGuid,
+                targetMonarchId,
+                targetMonarchName,
+                targetFellowshipId,
+                station.DeployerPlayerGuid,
+                station.DeployerMonarchId != 0 ? station.DeployerMonarchId : null,
+                station.DeployerFellowshipId != 0 ? station.DeployerFellowshipId : null,
+                policy);
+        }
+
+        /// <summary>
+        /// Resolves IFF standing between a target pilot and the radar deployer.
+        /// </summary>
+        public static IffStanding ResolveStanding(Player targetPilot, Player deployer, GuildRadarPolicy policy = null)
+        {
+            var targetPilotGuid = targetPilot?.Guid.Full ?? 0;
+            var targetMonarchId = targetPilot?.MonarchId ?? targetPilot?.Allegiance?.MonarchId;
+            var targetMonarchName = targetPilot?.Allegiance?.Monarch?.Player?.Name ?? targetPilot?.Allegiance?.AllegianceName;
+            var targetFellowshipId = targetPilot?.Fellowship != null ? (uint?)targetPilot.Fellowship.GetHashCode() : null;
+
+            var deployerGuid = deployer?.Guid.Full ?? 0;
+            var deployerMonarchId = deployer?.MonarchId ?? deployer?.Allegiance?.MonarchId;
+            var deployerFellowshipId = deployer?.Fellowship != null ? (uint?)deployer.Fellowship.GetHashCode() : null;
+
+            // Direct fellowship reference comparison if both players online
+            if (targetPilot?.Fellowship != null && deployer?.Fellowship != null && targetPilot.Fellowship == deployer.Fellowship)
+                return IffStanding.Friendly;
+
+            return ResolveStanding(
+                targetPilotGuid, targetMonarchId, targetMonarchName, targetFellowshipId,
+                deployerGuid, deployerMonarchId, deployerFellowshipId,
+                policy);
+        }
+
+        /// <summary>
+        /// Overload accepting raw values for pure unit testing and mock entities.
+        /// </summary>
+        public static IffStanding ResolveStanding(
+            uint targetPilotGuid,
+            uint? targetMonarchId,
+            string targetMonarchName,
+            uint? targetFellowshipId,
+            uint deployerGuid,
+            uint? deployerMonarchId,
+            uint? deployerFellowshipId,
+            GuildRadarPolicy policy = null)
+        {
+            // 0. Unpiloted vehicle -> DefaultStanding (Hostile)
+            if (targetPilotGuid == 0)
+                return policy?.DefaultStanding ?? IffStanding.Hostile;
+
+            // 1. Deployer self -> Friendly
+            if (targetPilotGuid == deployerGuid)
+                return IffStanding.Friendly;
+
+            // 2. Same monarch -> Friendly
+            if (targetMonarchId.HasValue && deployerMonarchId.HasValue &&
+                targetMonarchId.Value != 0 && targetMonarchId.Value == deployerMonarchId.Value)
+                return IffStanding.Friendly;
+
+            // 3. Same fellowship -> Friendly
+            if (targetFellowshipId.HasValue && deployerFellowshipId.HasValue &&
+                targetFellowshipId.Value != 0 && targetFellowshipId.Value == deployerFellowshipId.Value)
+                return IffStanding.Friendly;
+
+            // 4. Policy lookup by MonarchId
+            if (policy != null && targetMonarchId.HasValue && policy.PolicyByMonarchId.TryGetValue(targetMonarchId.Value, out var standingById))
+                return standingById;
+
+            // 5. Policy lookup by MonarchName (case-insensitive)
+            if (policy != null && !string.IsNullOrWhiteSpace(targetMonarchName) && policy.PolicyByMonarchName.TryGetValue(targetMonarchName, out var standingByName))
+                return standingByName;
+
+            // 6. Default standing (Hostile)
+            return policy?.DefaultStanding ?? IffStanding.Hostile;
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/AirDefense/RadarStation.cs b/Source/ACE.Server/Vehicles/AirDefense/RadarStation.cs
