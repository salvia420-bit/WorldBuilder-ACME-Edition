+        #region Feature 33: Earth Sagitta & Terrain Line-of-Sight Tests
+
+        [TestMethod]
+        public void SagittaFormula_MidpointAt16kmMatchesTheory()
+        {
+            // At 16,000m of a 32,000m chord, sagitta drop is (16000 * 16000) / (2 * 6,371,000) = 20.091037m
+            float drop = VehicleTerrain.ComputeEarthSagittaDrop(16000f, 32000f);
+            Assert.AreEqual(20.091f, drop, 0.05f, "Midpoint sagitta drop at 16 km of 32 km must match 20.091 m");
+        }
+
+        [TestMethod]
+        public void SagittaFormula_BoundaryAndZeroCases()
+        {
+            Assert.AreEqual(0.0f, VehicleTerrain.ComputeEarthSagittaDrop(0f, 32000f), "Sagitta at start s=0 must be 0");
+            Assert.AreEqual(0.0f, VehicleTerrain.ComputeEarthSagittaDrop(32000f, 32000f), "Sagitta at end s=d must be 0");
+            Assert.AreEqual(0.0f, VehicleTerrain.ComputeEarthSagittaDrop(-100f, 32000f), "Sagitta for negative s must be 0");
+            Assert.AreEqual(0.0f, VehicleTerrain.ComputeEarthSagittaDrop(35000f, 32000f), "Sagitta for s > d must be 0");
+            Assert.AreEqual(0.0f, VehicleTerrain.ComputeEarthSagittaDrop(100f, 0f), "Sagitta for d <= 0 must be 0");
+            Assert.AreEqual(0.0f, VehicleTerrain.ComputeEarthSagittaDrop(100f, -500f), "Sagitta for negative d must be 0");
+
+            // Symmetry check: s vs (d - s)
+            float dropA = VehicleTerrain.ComputeEarthSagittaDrop(8000f, 32000f);
+            float dropB = VehicleTerrain.ComputeEarthSagittaDrop(24000f, 32000f);
+            Assert.AreEqual(dropA, dropB, 0.0001f, "Sagitta drop must be symmetric about chord midpoint");
+        }
+
+        [TestMethod]
+        public void TerrainLOS_FlatTerrainClear()
+        {
+            // Radar at (0, 0, 0), mast = 3.1m. Target at (0, 10000, 100), beacon = 1.2m. Flat terrain at 0m.
+            bool clear = VehicleTerrain.RadarLosClear(
+                0, 0, 0,
+                0, 10000, 100,
+                mastHeight: 3.1f,
+                targetBeaconHeight: 1.2f,
+                stepM: 250f,
+                terrainLookup: (x, y) => 0.0f);
+
+            Assert.IsTrue(clear, "Sightline over flat terrain at 100m target elevation should be clear");
+        }
+
+        [TestMethod]
+        public void TerrainLOS_MountainRidgeOcclusion()
+        {
+            // Radar at (0, 0, 10), mast = 3.1m -> ray starts at 13.1m.
+            // Target at (0, 10000, 125), beacon = 1.2m -> ray ends at 126.2m.
+            // Midpoint chord elevation without sagitta: ~69.65m.
+            // Ridge at 5,000m (midpoint) rises to 250m.
+            bool clear = VehicleTerrain.RadarLosClear(
+                0, 0, 10,
+                0, 10000, 125,
+                mastHeight: 3.1f,
+                targetBeaconHeight: 1.2f,
+                stepM: 250f,
+                terrainLookup: (x, y) => (y >= 4900 && y <= 5100) ? 250.0f : 0.0f);
+
+            Assert.IsFalse(clear, "250m mountain ridge should occlude ~70m sightline");
+        }
+
+        [TestMethod]
+        public void TerrainLOS_MountainRidgeClearing()
+        {
+            // Target climbs to 850m elevation. Ridge at 400m at 8,000m of 16,000m chord.
+            bool clear = VehicleTerrain.RadarLosClear(
+                0, 0, 10,
+                0, 16000, 850,
+                mastHeight: 3.1f,
+                targetBeaconHeight: 1.2f,
+                stepM: 250f,
+                terrainLookup: (x, y) => (y >= 7800 && y <= 8200) ? 400.0f : 0.0f);
+
+            Assert.IsTrue(clear, "Target at 850m altitude should clear 400m ridge");
+        }
+
+        [TestMethod]
+        public void TerrainLOS_CurvatureMasksLowTargetOverFlatHorizon()
+        {
+            // Radar at 0m elevation (mast = 3.1m).
+            // Low target at 32,000m at 15m elevation (beacon = 1.2m -> 16.2m).
+            // At midpoint s = 16,000m: chordZ = 3.1 + 0.5 * (16.2 - 3.1) = 9.65m.
+            // Sagitta drop = 20.091m.
+            // rayZ = 9.65 - 20.091 = -10.441m.
+            // Flat terrain is at 0.0m. Since terrain (0.0m) > rayZ (-10.44m), ray is occluded by Earth curvature horizon.
+            bool clear = VehicleTerrain.RadarLosClear(
+                0, 0, 0,
+                0, 32000, 15,
+                mastHeight: 3.1f,
+                targetBeaconHeight: 1.2f,
+                stepM: 250f,
+                terrainLookup: (x, y) => 0.0f);
+
+            Assert.IsFalse(clear, "Low target at 32km at 15m AGL should be masked by planetary curvature horizon drop");
+        }
+
+        [TestMethod]
+        public void TerrainLOS_ZeroDistanceDirectlyOverhead()
+        {
+            // Zero horizontal distance: target directly overhead
+            bool clear = VehicleTerrain.RadarLosClear(
+                100, 200, 0,
+                100, 200, 500,
+                mastHeight: 3.1f,
+                targetBeaconHeight: 1.2f,
+                stepM: 250f,
+                terrainLookup: (x, y) => 0.0f);
+
+            Assert.IsTrue(clear, "Target directly overhead with zero horizontal distance should not throw or divide by zero");
+        }
