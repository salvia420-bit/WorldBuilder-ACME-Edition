+        #region Feature 32: Autonomous Air Target Detection Tests
+
+        [TestMethod]
+        public void Detection_LocomotionFilter_ExcludesGroundVehicles()
+        {
+            var radarPos = new Vector3(1000f, 2000f, 100f);
+            var groundJeep = CreateTestJeep(0x70000001, 1000.0, 3000.0, 150.0);
+            var airPlane = CreateTestAircraft(0x70000002, 1000.0, 3000.0, 150.0);
+
+            // Ground vehicle rejected
+            bool groundDetected = AirDefenseManager.IsTargetDetected(
+                radarPos, groundJeep, out _, out _, out _, (x, y) => 100f);
+            Assert.IsFalse(groundDetected, "Ground vehicle (Locomotion == 2) must be excluded from air radar detection");
+
+            // Air vehicle accepted
+            bool airDetected = AirDefenseManager.IsTargetDetected(
+                radarPos, airPlane, out var rangeM, out var aglM, out var bearingRad, (x, y) => 100f);
+            Assert.IsTrue(airDetected, "Airborne vehicle (Locomotion == 1) within range and ceiling must be detected");
+            Assert.AreEqual(1000f, rangeM, 1.0f);
+            Assert.AreEqual(50f, aglM, 1.0f);
+        }
+
+        [TestMethod]
+        public void Detection_RangeGateBoundaries()
+        {
+            var radarPos = new Vector3(0f, 0f, 100f);
+
+            // Inside 32,187m
+            bool inside = AirDefenseManager.IsTargetDetectedPure(
+                radarPos, new Vector3(0f, 32187.0f, 500f), altitudeAgl: 100f, locomotion: VehicleLocomotion.Air, (x, y) => 0f);
+            Assert.IsTrue(inside, "Target exactly at 32,187.0 m should be detected");
+
+            // Outside 32,187m
+            bool outside = AirDefenseManager.IsTargetDetectedPure(
+                radarPos, new Vector3(0f, 32187.5f, 500f), altitudeAgl: 100f, locomotion: VehicleLocomotion.Air, (x, y) => 0f);
+            Assert.IsFalse(outside, "Target at 32,187.5 m should be excluded by range gate");
+        }
+
+        [TestMethod]
+        public void Detection_AltitudeAglGateBoundaries()
+        {
+            var radarPos = new Vector3(0f, 0f, 100f);
+            var targetPos = new Vector3(0f, 5000f, 100f);
+
+            // Floor boundary: 8.0m detected, 7.9m excluded
+            bool atFloor = AirDefenseManager.IsTargetDetectedPure(radarPos, targetPos, 8.0f, VehicleLocomotion.Air, (x, y) => 0f);
+            Assert.IsTrue(atFloor, "Target at 8.0m AGL floor boundary should be detected");
+
+            bool belowFloor = AirDefenseManager.IsTargetDetectedPure(radarPos, targetPos, 7.9f, VehicleLocomotion.Air, (x, y) => 0f);
+            Assert.IsFalse(belowFloor, "Target at 7.9m AGL below floor boundary should be excluded");
+
+            // Ceiling boundary: 1,550.0m detected, 1,550.5m excluded
+            bool atCeiling = AirDefenseManager.IsTargetDetectedPure(radarPos, targetPos, 1550.0f, VehicleLocomotion.Air, (x, y) => 0f);
+            Assert.IsTrue(atCeiling, "Target at 1,550.0m AGL ceiling boundary should be detected");
+
+            bool aboveCeiling = AirDefenseManager.IsTargetDetectedPure(radarPos, targetPos, 1550.5f, VehicleLocomotion.Air, (x, y) => 0f);
+            Assert.IsFalse(aboveCeiling, "Target at 1,550.5m AGL above ceiling boundary should be excluded");
+        }
+
+        [TestMethod]
+        public void Detection_BearingCalculation_NormalizesToCircle()
+        {
+            var radarPos = new Vector3(0f, 0f, 100f);
+
+            // North (+Y): dx=0, dy>0 -> bearing = 0 rad
+            var planeNorth = CreateTestAircraft(0x70000003, 0.0, 1000.0, 200.0);
+            AirDefenseManager.IsTargetDetected(radarPos, planeNorth, out _, out _, out var bearingNorth, (x, y) => 100f);
+            Assert.AreEqual(0.0f, bearingNorth, 0.01f, "Due North bearing should be 0 radians");
+
+            // East (+X): dx>0, dy=0 -> bearing = PI/2 rad (~1.5708)
+            var planeEast = CreateTestAircraft(0x70000004, 1000.0, 0.0, 200.0);
+            AirDefenseManager.IsTargetDetected(radarPos, planeEast, out _, out _, out var bearingEast, (x, y) => 100f);
+            Assert.AreEqual(MathF.PI / 2.0f, bearingEast, 0.01f, "Due East bearing should be PI/2 radians");
+
+            // South (-Y): dx=0, dy<0 -> bearing = PI rad (~3.1416)
+            var planeSouth = CreateTestAircraft(0x70000005, 0.0, -1000.0, 200.0);
+            AirDefenseManager.IsTargetDetected(radarPos, planeSouth, out _, out _, out var bearingSouth, (x, y) => 100f);
+            Assert.AreEqual(MathF.PI, bearingSouth, 0.01f, "Due South bearing should be PI radians");
+
+            // West (-X): dx<0, dy=0 -> bearing = 3*PI/2 rad (~4.7124)
+            var planeWest = CreateTestAircraft(0x70000006, -1000.0, 0.0, 200.0);
+            AirDefenseManager.IsTargetDetected(radarPos, planeWest, out _, out _, out var bearingWest, (x, y) => 100f);
+            Assert.AreEqual(3.0f * MathF.PI / 2.0f, bearingWest, 0.01f, "Due West bearing should be 3*PI/2 radians");
+        }
+
