+            };
+        }
+
+        public static TerrainSample Sample(double worldX, double worldY, double worldZ = 0.0) =>
+            Sample(worldX, worldY, worldZ, 0.0, 0.0);
+
         /// <summary>The flight model's ground function: double in, double out (NaN = unknown).</summary>
         public static double Ground(double x, double y) => HeightAt((float)x, (float)y);
+
+        public const float EarthRadiusM = 6371000.0f;
+        public const float DefaultRadarMastHeightM = 3.1f;
+        public const float DefaultTargetBeaconHeightM = 1.2f;
+        public const float DefaultRaymarchStepM = 250.0f;
+
+        /// <summary>
+        /// Earth curvature sagitta drop along a chord of length D at distance s:
+        /// z = s * (D - s) / (2 * R) where R = 6,371,000 meters.
+        /// </summary>
+        public static float ComputeEarthSagittaDrop(float s, float d, float earthRadius = EarthRadiusM)
+        {
+            if (d <= 0.0f || s <= 0.0f || s >= d)
+                return 0.0f;
+            return (s * (d - s)) / (2.0f * earthRadius);
+        }
+
+        /// <summary>
+        /// 3D terrain heightmap raymarching along chord from radar to aircraft accounting for
+        /// planetary curvature sagitta drop. If terrain elevation > chord elevation - z_drop
+        /// at any sample step along the line, line-of-sight is occluded.
+        /// </summary>
+        public static bool RadarLosClear(
+            double rx, double ry, double rz,
+            double tx, double ty, double tz,
+            float mastHeight = DefaultRadarMastHeightM,
+            float targetBeaconHeight = DefaultTargetBeaconHeightM,
+            float stepM = DefaultRaymarchStepM,
+            Func<float, float, float> terrainLookup = null)
+        {
+            var dx = tx - rx;
+            var dy = ty - ry;
+            var d = Math.Sqrt(dx * dx + dy * dy);
+            if (d < 1e-4) return true; // Zero-distance target directly overhead
+
+            var z0 = rz + mastHeight;
+            var z1 = tz + targetBeaconHeight;
+
+            var steps = (int)Math.Ceiling(d / stepM);
+            if (steps <= 1) return true;
+
+            for (var i = 1; i < steps; i++)
+            {
+                var frac = (double)i / steps;
+                var s = frac * d;
+                var sx = rx + dx * frac;
+                var sy = ry + dy * frac;
+
+                var sagitta = ComputeEarthSagittaDrop((float)s, (float)d);
+                var chordZ = z0 + frac * (z1 - z0);
+                var rayZ = chordZ - sagitta;
+
+                var terrainZ = terrainLookup != null
+                    ? terrainLookup((float)sx, (float)sy)
+                    : HeightAt((float)sx, (float)sy);
+
+                if (!float.IsNaN(terrainZ) && terrainZ > rayZ)
+                    return false; // Occluded by terrain
+            }
+            return true;
+        }
+
+        public static bool RadarLosClear(
+            Vector3 radarPos,
+            Vector3 targetPos,
+            float mastHeight = DefaultRadarMastHeightM,
+            float targetBeaconHeight = DefaultTargetBeaconHeightM,
+            float stepM = DefaultRaymarchStepM,
+            Func<float, float, float> terrainLookup = null)
+        {
+            return RadarLosClear(
+                radarPos.X, radarPos.Y, radarPos.Z,
+                targetPos.X, targetPos.Y, targetPos.Z,
+                mastHeight, targetBeaconHeight, stepM, terrainLookup);
+        }
     }
