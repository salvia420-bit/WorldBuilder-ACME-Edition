+            return new TerrainSample
+            {
+                Z = finalZ,
+                Nx = finalNx,
+                Ny = finalNy,
+                Nz = finalNz,
+                Surface = surf,
+                WaterDepth = waterDepth,
+                IsBridge = isBridge,
+                HasObstacle = obs.Collided,
