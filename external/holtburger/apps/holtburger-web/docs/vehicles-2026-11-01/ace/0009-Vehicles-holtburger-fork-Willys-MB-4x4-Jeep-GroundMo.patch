+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Enum.Properties;
+using ACE.Entity.Models;
+using ACE.Server.Entity;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.AirDefense
+{
+    public class RadarStation : WorldObject
+    {
+        public const uint RadarWeenieClassId = 4_000_002;
+        public const float MastHeightM = 3.1f;
+        public const float TargetBeaconHeightM = 1.2f;
+        public const float MaxRangeM = 32187.0f; // 20 statute miles
+        public const float MaxCeilingAglM = 1550.0f;
+        public const float MinFloorAglM = 8.0f;
+        public const float EarthRadiusM = 6371000.0f;
+
+        public uint ParentVehicleGuid { get; }
+        public uint DeployerPlayerGuid { get; }
+        public uint DeployerMonarchId { get; }
+        public uint DeployerFellowshipId { get; }
+        public string DeployerMonarchName { get; }
+
+        public bool IsActive { get; set; } = true;
+        public DateTime DeployedUtc { get; } = DateTime.UtcNow;
+        public DateTime LastScanUtc { get; set; } = DateTime.MinValue;
+        public double SweepTimer { get; set; } = 0.0;
+
+        public IAirDefenseSensor Sensor { get; set; }
+        public GuildRadarPolicy Policy { get; set; }
+
+        public Vector3 Position => Location != null
+            ? new Vector3((float)Location.Pos.X, (float)Location.Pos.Y, (float)Location.Pos.Z)
+            : Vector3.Zero;
+
+        public RadarStation(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle, Player deployer)
+            : base(weenie, guid)
+        {
+            ParentVehicleGuid = parentVehicle?.Guid.Full ?? 0;
+            DeployerPlayerGuid = deployer?.Guid.Full ?? 0;
+            DeployerMonarchId = deployer?.MonarchId ?? deployer?.Allegiance?.MonarchId ?? deployer?.Guid.Full ?? 0;
+            DeployerFellowshipId = deployer?.Fellowship != null ? (uint)deployer.Fellowship.GetHashCode() : 0;
+            DeployerMonarchName = deployer?.Allegiance?.Monarch?.Player?.Name ?? deployer?.Allegiance?.AllegianceName ?? deployer?.Name ?? string.Empty;
+            Sensor = new AirDefenseSensor(guid.Full, Vector3.Zero, MaxRangeM, MaxCeilingAglM);
+        }
+
+        public void UpdateSensorPosition()
+        {
+            if (Sensor != null)
+                Sensor.SensorPosition = Position;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle, Player deployer)
+        {
+            return new Weenie
+            {
+                WeenieClassId = RadarWeenieClassId,
+                ClassName = "hbradar_station",
+                WeenieType = WeenieType.Generic,
+                PropertiesBool = new Dictionary<PropertyBool, bool>
+                {
+                    [PropertyBool.Stuck] = true,
+                    [PropertyBool.Attackable] = false,
+                    [PropertyBool.Ethereal] = true,
+                    [PropertyBool.IgnoreCollisions] = true,
+                    [PropertyBool.ReportCollisions] = false,
+                    [PropertyBool.GravityStatus] = false,
+                },
+                PropertiesDID = new Dictionary<PropertyDataId, uint>
+                {
+                    [PropertyDataId.Setup] = 0x02000216,
+                    [PropertyDataId.Icon] = 0x06003711,
+                },
+                PropertiesFloat = new Dictionary<PropertyFloat, double>
+                {
+                    [PropertyFloat.DefaultScale] = 1.0,
+                    [PropertyFloat.UseRadius] = 4.0,
+                    [PropertyFloat.TimeToRot] = -1.0,
+                },
+                PropertiesInt = new Dictionary<PropertyInt, int>
+                {
+                    [PropertyInt.ItemType] = (int)ItemType.Misc,
+                    [PropertyInt.ItemUseable] = (int)Usable.Remote,
+                    [PropertyInt.ShowableOnRadar] = (int)ACE.Entity.Enum.RadarBehavior.ShowAlways,
+                    [PropertyInt.RadarBlipColor] = (int)ACE.Entity.Enum.RadarColor.Green,
+                    [PropertyInt.Value] = 0,
+                    [PropertyInt.EncumbranceVal] = 0,
+                },
+                PropertiesString = new Dictionary<PropertyString, string>
+                {
+                    [PropertyString.Name] = "AN/TPS-1 Mobile Air-Search Radar",
+                    [PropertyString.Use] = "Autonomous mobile air-search radar station. Pack from vehicle rear.",
+                },
+            };
+        }
+
+        public void BroadcastContacts(IReadOnlyList<AirTrack> tracks)
+        {
+            if (Sensor == null || Location == null) return;
+            var msg = Sensor.CreateRadarContactsMsg(ParentVehicleGuid);
+            var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+            VehicleManager.BroadcastNear(Location, MaxRangeM, deployer, () => msg);
+        }
+
+        public new void Destroy(bool raiseNotifyOfDestructionEvent = true, bool fromLandblockUnload = false)
+        {
+            AirDefenseManager.UnregisterStation(Guid.Full);
+            base.Destroy(raiseNotifyOfDestructionEvent, fromLandblockUnload);
+        }
+    }
+}
