+        [TestMethod]
+        public void TurretSensorBus_Acquire_Update_ConsecutiveHits()
+        {
+            var sensor = new AirDefenseSensor(0x50000001, new Vector3(0f, 0f, 0f));
+            var acquiredList = new List<AirTrack>();
+            var updatedList = new List<AirTrack>();
+
+            sensor.TrackAcquired += (s, t) => acquiredList.Add(t);
+            sensor.TrackUpdated += (s, t) => updatedList.Add(t);
+
+            var time0 = DateTime.UtcNow;
+            var candidate = new AirTrackCandidate
+            {
+                VehicleGuid = 0x70000020,
+                PilotGuid = 0x10000002,
+                Standing = IffStanding.Hostile,
+                WorldPos = new Vector3(100f, 200f, 50f),
+                WorldVel = new Vector3(10f, 0f, 0f),
+                AltitudeAglM = 50f,
+                RangeM = 223.6f,
+                BearingRad = 0.46f,
+            };
+
+            // 1st sweep: Acquired
+            sensor.ProcessSweep(new[] { candidate }, time0);
+            Assert.AreEqual(1, sensor.ActiveTrackCount);
+            Assert.AreEqual(1, acquiredList.Count);
+            Assert.AreEqual(0, updatedList.Count);
+            Assert.IsTrue(sensor.TryGetTrack(0x70000020, out var t1));
+            Assert.AreEqual(1, t1.ConsecutiveHits);
+
+            // 2nd sweep: Updated
+            var time1 = time0.AddSeconds(1.0);
+            sensor.ProcessSweep(new[] { candidate }, time1);
+            Assert.AreEqual(1, sensor.ActiveTrackCount);
+            Assert.AreEqual(1, acquiredList.Count);
+            Assert.AreEqual(1, updatedList.Count);
+            Assert.IsTrue(sensor.TryGetTrack(0x70000020, out var t2));
+            Assert.AreEqual(2, t2.ConsecutiveHits);
+        }
