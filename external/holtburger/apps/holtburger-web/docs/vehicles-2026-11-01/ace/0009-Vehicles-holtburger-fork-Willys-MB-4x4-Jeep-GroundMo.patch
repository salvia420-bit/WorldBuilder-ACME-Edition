+        [TestMethod]
+        public void HandleCargo_RefusesInvalidActionOrDuplicateToggle()
+        {
+            VehicleManager.EnabledOverride = true;
+            var v = CreateTestJeep(0x70000014, 1000.0, 2000.0, 100.0);
+            VehicleManager.RegisterForTesting(v);
+
+            try
+            {
+                var player = CreateTestPlayer(0x10000007, 1000.0, 1997.0, 100.75);
+                VehicleManager.ClearSeatedForTesting(player);
+
+                // When CargoLoaded is true, packing again should fail
+                v.CargoLoaded = true;
+                var duplicatePack = VehicleManager.HandleCargo(player, new VehicleCargo { Vehicle = v.Guid.Full, Action = 2 });
+                Assert.IsFalse(duplicatePack, "Cannot pack when cargo is already loaded");
+                Assert.IsTrue(v.CargoLoaded);
+
+                // Invalid action (e.g. 0 or 3) should fail
+                var invalidAction = VehicleManager.HandleCargo(player, new VehicleCargo { Vehicle = v.Guid.Full, Action = 99 });
+                Assert.IsFalse(invalidAction, "Invalid cargo action must fail");
+                Assert.IsTrue(v.CargoLoaded);
+
+                // Deploy cargo
+                var deployOk = VehicleManager.HandleCargo(player, new VehicleCargo { Vehicle = v.Guid.Full, Action = 1 });
+                Assert.IsTrue(deployOk);
+                Assert.IsFalse(v.CargoLoaded);
+
+                // When CargoLoaded is false, deploying again should fail
+                var duplicateDeploy = VehicleManager.HandleCargo(player, new VehicleCargo { Vehicle = v.Guid.Full, Action = 1 });
+                Assert.IsFalse(duplicateDeploy, "Cannot deploy when cargo is already unloaded");
+                Assert.IsFalse(v.CargoLoaded);
+            }
+            finally
+            {
+                VehicleManager.UnregisterForTesting(v.Guid.Full);
+            }
+        }
+
+        [TestMethod]
+        public void ProbeExitPosition_OnBridgeDeck_PlacesPlayerOnDeckNotSeabed()
+        {
+            VehicleManager.EnabledOverride = true;
+            var v = CreateTestJeep(0x70000015, 1000.0, 2000.0, 25.0);
+            VehicleManager.RegisterForTesting(v);
+
+            try
+            {
+                VehicleColliderCache.BridgeSupportOverride = (x, y, z) => new BridgeSupport
+                {
+                    Found = true,
+                    DeckZ = 25.0,
+                    Nx = 0,
+                    Ny = 0,
+                    Nz = 1.0
+                };
+
+                var pos = VehicleManager.ProbeExitPosition(v, 0);
+                Assert.AreEqual(25.05f, pos.Pos.Z, 0.05f, "Exiting player must land on elevated bridge deck at 25.05m");
+            }
+            finally
+            {
+                VehicleColliderCache.BridgeSupportOverride = null;
+                VehicleManager.UnregisterForTesting(v.Guid.Full);
+            }
+        }
+
+        [TestMethod]
+        public void Unseat_WithNullNetworkSession_DoesNotThrowNullReferenceException()
+        {
+            VehicleManager.EnabledOverride = true;
+            var v = CreateTestJeep(0x70000016, 1000.0, 2000.0, 100.0);
+            VehicleManager.RegisterForTesting(v);
+
+            try
+            {
+                var player = CreateTestPlayer(0x10000008, 1000.0, 2000.0, 100.0);
+                // Note: player.Session is null on CreateTestPlayer
+                VehicleManager.SetSeatedForTesting(player, v, 0);
+                Assert.IsTrue(VehicleManager.IsSeated(player));
+
+                // Should not throw NullReferenceException even with player.Session == null
+                VehicleManager.Unseat(v, player, placeOnGround: false);
+                Assert.IsFalse(VehicleManager.IsSeated(player), "Player must be safely unseated");
+                Assert.AreEqual(0u, v.SeatOccupants[0], "Seat 0 must be vacated");
+            }
+            finally
+            {
+                VehicleManager.UnregisterForTesting(v.Guid.Full);
+            }
+        }
+    }
