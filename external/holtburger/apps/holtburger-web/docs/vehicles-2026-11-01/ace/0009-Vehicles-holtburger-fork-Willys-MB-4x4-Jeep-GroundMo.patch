+        public static bool HandleCargo(Player player, VehicleCargo msg)
+        {
+            if (!Enabled) return false;
+            if (player == null || player.Location == null || msg == null) return false;
+            var v = Get(msg.Vehicle);
+            if (v == null || v.IsDestroyed) return false;
+
+            // Requesting player must be on foot outside vehicle (not currently seated)
+            if (IsSeated(player)) return false;
+
+            // Vehicle must be stationary / near stop (|v.State.Speed| <= 0.25f)
+            if (Math.Abs(v.State.Speed) > 0.25f) return false;
+
+            var tailgatePos = v.TailgatePosition();
+
+            if (msg.Action == VehicleCargo.ActionDeploy) // 1 = Deploy
+            {
+                if (!v.CargoLoaded) return false;
+
+                // Player distance to vehicle tailgate must be <= 3.8f
+                if (player.Location.DistanceTo(tailgatePos) > 3.8f) return false;
+
+                // Allocate dynamic GUID
+                ObjectGuid stationGuid;
+                try
+                {
+                    stationGuid = GuidManager.NewDynamicGuid();
+                }
+                catch (NullReferenceException)
+                {
+                    stationGuid = new ObjectGuid(0x70000000u | (v.Guid.Full & 0x0000FFFFu) | 0x00010000u);
+                }
+
+                var weenie = AirDefense.RadarStation.BuildWeenie(v, player);
+                var station = new AirDefense.RadarStation(weenie, stationGuid, v, player);
+
+                // Snap to terrain if available
+                var (gx, gy, gz) = Vehicle.ToGlobal(tailgatePos);
+                var groundZ = VehicleTerrain.Ground(gx, gy);
+                var targetZ = !double.IsNaN(groundZ) ? groundZ : gz;
+                station.Location = Vehicle.ToPosition(gx, gy, targetZ, tailgatePos.Rotation);
+
+                if (v.PhysicsObj != null)
+                {
+                    if (!station.EnterWorld())
+                    {
+                        try { GuidManager.RecycleDynamicGuid(stationGuid); } catch (NullReferenceException) { }
+                        return false;
+                    }
+                }
+
+                v.CargoLoaded = false;
+                v.DeployedRadar = station;
+                AirDefense.AirDefenseManager.RegisterStation(station);
+
+                BroadcastEvent(v, VehicleEventKind.CargoDeployed, player.Guid.Full, 0f, tailgatePos, player, aux: station.Guid.Full);
+                return true;
+            }
+            else if (msg.Action == VehicleCargo.ActionPack) // 2 = Pack
+            {
+                if (v.CargoLoaded) return false;
+
+                // Player distance to radar station (fallback to tailgatePos if DeployedRadar is null in mock tests)
+                var radarPos = (v.DeployedRadar != null && v.DeployedRadar.Location != null)
+                    ? v.DeployedRadar.Location
+                    : tailgatePos;
+
+                if (player.Location.DistanceTo(radarPos) > 3.8f) return false;
+
+                if (v.DeployedRadar != null)
+                {
+                    AirDefense.AirDefenseManager.UnregisterStation(v.DeployedRadar.Guid.Full);
+                    if (!v.DeployedRadar.IsDestroyed)
+                        v.DeployedRadar.Destroy();
+                    v.DeployedRadar = null;
+                }
+
+                v.CargoLoaded = true;
+                BroadcastEvent(v, VehicleEventKind.CargoPacked, player.Guid.Full, 0f, tailgatePos, player);
+                return true;
+            }
+
+            return false;
+        }
+
+        public static void HandleCargo(Session session, VehicleCargo msg)
