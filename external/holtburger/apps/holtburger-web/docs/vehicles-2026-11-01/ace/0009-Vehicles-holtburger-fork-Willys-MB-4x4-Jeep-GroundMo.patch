+        [TestMethod]
+        public void TurretSensorBus_PrunesLostTracksAfterTimeout()
+        {
+            var sensor = new AirDefenseSensor(0x50000001, new Vector3(0f, 0f, 0f))
+            {
+                TrackTimeout = TimeSpan.FromSeconds(3.0)
+            };
+            var lostList = new List<uint>();
+            sensor.TrackLost += (s, guid) => lostList.Add(guid);
+
+            var time0 = DateTime.UtcNow;
+            var candidate = new AirTrackCandidate
+            {
+                VehicleGuid = 0x70000030,
+                Standing = IffStanding.Hostile,
+                WorldPos = new Vector3(500f, 500f, 100f),
+            };
+
+            // Initial detection
+            sensor.ProcessSweep(new[] { candidate }, time0);
+            Assert.AreEqual(1, sensor.ActiveTrackCount);
+
+            // Sweep after 1.5s (no detection, but within 3s timeout) -> NOT pruned
+            sensor.ProcessSweep(Array.Empty<AirTrackCandidate>(), time0.AddSeconds(1.5));
+            Assert.AreEqual(1, sensor.ActiveTrackCount, "Track should remain within 3.0s timeout");
+            Assert.AreEqual(0, lostList.Count);
+
+            // Sweep after 3.1s (exceeds 3.0s timeout) -> Pruned
+            sensor.ProcessSweep(Array.Empty<AirTrackCandidate>(), time0.AddSeconds(3.1));
+            Assert.AreEqual(0, sensor.ActiveTrackCount, "Track must be pruned after 3.0s timeout");
+            Assert.AreEqual(1, lostList.Count);
+            Assert.AreEqual(0x70000030u, lostList[0]);
+        }
