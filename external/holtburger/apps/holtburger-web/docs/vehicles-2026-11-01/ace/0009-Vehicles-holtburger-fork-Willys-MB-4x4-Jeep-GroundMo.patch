+                if (sw == 0) return MathF.Min(qx, qy) - edge;
+                if (se == 0) return MathF.Min(px, qy) - edge;
+                if (nw == 0) return MathF.Min(qx, py) - edge;
+                return MathF.Min(px, py) - edge;
+            }
+            if (n == 2)
+            {
+                if (sw != 0 && se != 0) return py - edge;
+                if (nw != 0 && ne != 0) return qy - edge;
+                if (sw != 0 && nw != 0) return px - edge;
+                if (se != 0 && ne != 0) return qx - edge;
