+using System;
+using System.IO;
+using System.Text.Json;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using ACE.Server.Vehicles;
+
+namespace ACE.Server.Tests.Vehicles
+{
+    [TestClass]
+    public class GroundModelParityTests
+    {
+        static JsonElement root;
+
+        [ClassInitialize]
+        public static void Init(TestContext _)
+        {
+            var path = Path.Combine(AppContext.BaseDirectory, "Vehicles", "ground-golden.json");
+            if (!File.Exists(path))
+                path = "/home/wbterminal/ace-server/Source/ACE.Server.Tests/Vehicles/ground-golden.json";
+            if (!File.Exists(path))
+                path = "/home/wbterminal/WorldBuilder-ACME-Edition/external/holtburger/apps/holtburger-web/docs/vehicles-2026-11-01/ground/ground-golden.json";
+
+            root = JsonDocument.Parse(File.ReadAllText(path)).RootElement;
+        }
+
+        static double D(JsonElement o, string k) => o.GetProperty(k).GetDouble();
+
+        static GroundParams Params()
+        {
+            var p = root.GetProperty("params");
+            return new GroundParams
+            {
+                Wheelbase = D(p, "wheelbase"),
+                TrackWidth = D(p, "trackWidth"),
+                WheelRadius = D(p, "wheelRadius"),
+                MaxSteerRad = D(p, "maxSteerRad"),
+                MinSteerRad = D(p, "minSteerRad"),
+                SteerSlewRateLow = D(p, "steerSlewRateLow"),
+                SteerSlewRateHigh = D(p, "steerSlewRateHigh"),
+                SteerSpeedLow = D(p, "steerSpeedLow"),
+                SteerSpeedHigh = D(p, "steerSpeedHigh"),
+                TurnRadiusMin = D(p, "turnRadiusMin"),
+                VMaxRoad = D(p, "vMaxRoad"),
+                VReverseMax = D(p, "vReverseMax"),
+                LaunchAccel = D(p, "launchAccel"),
+                NormalBrake = D(p, "normalBrake"),
+                HandbrakeDecel = D(p, "handbrakeDecel"),
+                LowRangeTorqueMul = D(p, "lowRangeTorqueMul"),
+                LowRangeSpeedCap = D(p, "lowRangeSpeedCap"),
+                ClimbLimitCos = D(p, "climbLimitCos"),
+                FloorZ = D(p, "floorZ"),
+                FordDepthMax = D(p, "fordDepthMax"),
+                CoastLinear = D(p, "coastLinear"),
+                CoastQuad = D(p, "coastQuad"),
+                TreeGlanceThreshold = D(p, "treeGlanceThreshold"),
+                TreeGlanceScrub = D(p, "treeGlanceScrub"),
+                TreeYawNudge = D(p, "treeYawNudge"),
+            };
+        }
+
+        static GroundState State(JsonElement s) => new GroundState
+        {
+            X = D(s, "x"), Y = D(s, "y"), Z = D(s, "z"),
+            Heading = D(s, "heading"), Pitch = D(s, "pitch"),
+            Bank = s.TryGetProperty("roll", out var r) ? r.GetDouble() : (s.TryGetProperty("bank", out var b) ? b.GetDouble() : 0.0),
+            Speed = D(s, "speed"), SteerAngle = D(s, "steerAngle"),
+            Mode = s.GetProperty("mode").GetInt32(),
+            SurfaceFamily = s.TryGetProperty("surfaceFamily", out var sf) ? (byte)sf.GetInt32() : (byte)0,
+            GroundFlags = s.TryGetProperty("groundFlags", out var gf) ? (byte)gf.GetInt32() : (byte)0,
+        };
+
+        static GroundOracle GetOracle(string seqName) => seqName switch
+        {
+            "road-sprint" => (x, y, z) => new TerrainSample
+            {
+                Z = 40.0, Nx = 0, Ny = 0, Nz = 1, Surface = GroundModel.Surfaces[0], WaterDepth = 0, IsBridge = false
+            },
+            "low-speed-turn" => (x, y, z) => new TerrainSample
+            {
+                Z = 40.0, Nx = 0, Ny = 0, Nz = 1, Surface = GroundModel.Surfaces[0], WaterDepth = 0, IsBridge = false
+            },
+            "hill-climb" => (x, y, z) =>
+            {
+                const double Y0 = 3190.25;
+                const double slopeRad = 35.0 * Math.PI / 180.0;
+                return new TerrainSample
+                {
+                    Z = 40.0 + (y - Y0) * Math.Tan(slopeRad),
+                    Nx = 0,
+                    Ny = -Math.Sin(slopeRad),
+                    Nz = Math.Cos(slopeRad),
+                    Surface = GroundModel.Surfaces[2], // Grass
+                    WaterDepth = 0,
+                    IsBridge = false
+                };
+            },
+            "water-ford" => (x, y, z) => new TerrainSample
+            {
+                Z = 39.5, Nx = 0, Ny = 0, Nz = 1, Surface = GroundModel.Surfaces[7], WaterDepth = 0.5, IsBridge = false
+            },
+            "cliff-deflection" => (x, y, z) => new TerrainSample
+            {
+                Z = 40.0,
+                Nx = -0.6123724,
+                Ny = -0.6123724,
+                Nz = 0.5,
+                Surface = GroundModel.Surfaces[8], // Rock
+                WaterDepth = 0,
+                IsBridge = false
+            },
+            _ => throw new ArgumentException($"Unknown sequence: {seqName}")
+        };
