+            var nw = r01 != 0 ? 1 : 0;
+            var ne = r11 != 0 ? 1 : 0;
+            var n = sw + se + nw + ne;
+            if (n == 0) return float.PositiveInfinity;
+            if (n == 4) return -VertM;
+
+            var px = fx * VertM;
+            var py = fy * VertM;
+            var qx = VertM - px;
+            var qy = VertM - py;
+            var edge = EdgeHalfWidthM;
+
+            if (n == 3)
