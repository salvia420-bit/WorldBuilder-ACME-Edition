@@ -0,0 +1,366 @@
+using System;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>Ground vehicle state in AC world metres (X, Y, Z up; Heading compass rad [0, 2π)).</summary>
+    public struct GroundState
+    {
+        public double X, Y, Z;
+        public double Heading;
+        public double Pitch;
+        public double Bank;
+        public double Roll { get => Bank; set => Bank = value; }
+        public double Speed;
+        public double SteerAngle;
+        public int Mode;
+        public byte SurfaceFamily;
+        public byte GroundFlags;
+        public short WheelSpinQ16;
+
+        public static GroundState FromFlightState(in FlightState s) => new GroundState
+        {
+            X = s.X, Y = s.Y, Z = s.Z, Heading = s.Heading, Pitch = s.Pitch, Bank = s.Bank, Speed = s.Speed, Mode = s.Mode,
+        };
+
+        public FlightState ToFlightState() => new FlightState
+        {
+            X = X, Y = Y, Z = Z, Heading = Heading, Pitch = Pitch, Bank = Bank, Speed = Speed, Mode = Mode,
+        };
+    }
+
+    /// <summary>One step of ground driver input, dequantized identically to the client predictor.</summary>
+    public struct GroundInput
+    {
+        public double Throttle; // [-1.0, +1.0]
+        public double Steer;    // [-1.0, +1.0]
+        public bool Boost;      // 4WD low-range (0x01)
+        public bool Handbrake;  // mechanical handbrake (0x20)
+        public bool Horn;       // sparton horn (0x40)
+        public bool Headlights; // headlights (0x80)
+
+        public static GroundInput FromFrame(in VehicleInputFrame f)
+        {
+            double thr;
+            if (f.Throttle == 0 && f.Pitch != 0)
+                thr = VehicleInputFrame.Stick(f.Pitch);
+            else
+                thr = f.Throttle / 255.0;
+
+            var st = VehicleInputFrame.Stick(f.Yaw != 0 ? f.Yaw : f.Roll);
+
+            return new GroundInput
+            {
+                Throttle = thr,
+                Steer = st,
+                Boost = (f.Buttons & VehicleInputFrame.ButtonLowRange) != 0,
+                Handbrake = (f.Buttons & VehicleInputFrame.ButtonHandbrake) != 0,
+                Horn = (f.Buttons & VehicleInputFrame.ButtonHorn) != 0,
+                Headlights = (f.Buttons & VehicleInputFrame.ButtonHeadlights) != 0,
+            };
+        }
+    }
+
+    public struct SurfaceFamily
+    {
+        public byte Id;
+        public string Name;
+        public double VMax;
+        public double Mu;
+        public double MuLat;
+    }
+
+    public struct TerrainSample
+    {
+        public double Z;
+        public double Nx, Ny, Nz;
+        public SurfaceFamily Surface;
+        public double WaterDepth;
+        public bool IsBridge;
+        public bool HasObstacle;
+        public double ObstacleNx, ObstacleNy;
+        public double ObstacleNudgeSign;
+    }
+
+    public delegate TerrainSample GroundOracle(double x, double y, double z);
+
+    public sealed class GroundParams
+    {
+        public double Wheelbase;
+        public double TrackWidth;
+        public double WheelRadius;
+        public double MaxSteerRad;
+        public double MinSteerRad;
+        public double SteerSlewRateLow;
+        public double SteerSlewRateHigh;
+        public double SteerSpeedLow;
+        public double SteerSpeedHigh;
+        public double TurnRadiusMin;
+        public double VMaxRoad;
+        public double VReverseMax;
+        public double LaunchAccel;
+        public double NormalBrake;
+        public double HandbrakeDecel;
+        public double LowRangeTorqueMul;
+        public double LowRangeSpeedCap;
+        public double ClimbLimitCos;
+        public double FloorZ;
+        public double FordDepthMax;
+        public double CoastLinear;
+        public double CoastQuad;
+        public double TreeGlanceThreshold;
+        public double TreeGlanceScrub;
+        public double TreeYawNudge;
+
+        public static GroundParams FromProfile(VehicleProfile p) => new GroundParams
+        {
+            Wheelbase = p.Wheelbase > 0 ? p.Wheelbase : 2.04,
+            TrackWidth = p.TrackWidth > 0 ? p.TrackWidth : 1.48,
+            WheelRadius = p.WheelRadius > 0 ? p.WheelRadius : 0.38,
+            MaxSteerRad = p.MaxSteerRad > 0 ? p.MaxSteerRad : 40.0 * Math.PI / 180.0,
+            MinSteerRad = 12.0 * Math.PI / 180.0,
+            SteerSlewRateLow = p.YawRate > 0 ? p.YawRate : 5.2,
+            SteerSlewRateHigh = 2.6,
+            SteerSpeedLow = 12.0,
+            SteerSpeedHigh = 29.0,
+            TurnRadiusMin = 2.431,
+            VMaxRoad = p.VMax > 0 ? p.VMax : 29.0,
+            VReverseMax = p.ReverseMax < 0 ? p.ReverseMax : -10.0,
+            LaunchAccel = p.Accel > 0 ? p.Accel : 11.2,
+            NormalBrake = p.Decel > 0 ? p.Decel : 14.0,
+            HandbrakeDecel = 22.0,
+            LowRangeTorqueMul = 1.85,
+            LowRangeSpeedCap = 15.0,
+            ClimbLimitCos = p.ClimbLimitCos > 0 ? p.ClimbLimitCos : 0.71934,
+            FloorZ = 0.66417415,
+            FordDepthMax = p.FordDepthMax > 0 ? p.FordDepthMax : 0.8,
+            CoastLinear = 1.8,
+            CoastQuad = 0.04,
+            TreeGlanceThreshold = 0.65,
+            TreeGlanceScrub = 0.25,
+            TreeYawNudge = 0.05,
+        };
+    }
+
+    public static class GroundModel
+    {
+        public const int SimHz = 30;
+        public const double Dt = 1.0 / SimHz;
+        const double TwoPi = 2.0 * Math.PI;
+
+        public static readonly SurfaceFamily[] Surfaces = new[]
+        {
+            new SurfaceFamily { Id = 0, Name = "Road", VMax = 29.0, Mu = 1.00, MuLat = 1.30 },
+            new SurfaceFamily { Id = 1, Name = "Dirt", VMax = 24.4, Mu = 0.88, MuLat = 1.05 },
+            new SurfaceFamily { Id = 2, Name = "Grass", VMax = 23.5, Mu = 0.82, MuLat = 0.95 },
+            new SurfaceFamily { Id = 3, Name = "Forest", VMax = 21.5, Mu = 0.75, MuLat = 0.90 },
+            new SurfaceFamily { Id = 4, Name = "SnowIce", VMax = 19.1, Mu = 0.55, MuLat = 0.50 },
+            new SurfaceFamily { Id = 5, Name = "Sand", VMax = 18.6, Mu = 0.60, MuLat = 0.70 },
+            new SurfaceFamily { Id = 6, Name = "Swamp", VMax = 15.4, Mu = 0.50, MuLat = 0.65 },
+            new SurfaceFamily { Id = 7, Name = "ShallowFord", VMax = 12.5, Mu = 0.45, MuLat = 0.60 },
+            new SurfaceFamily { Id = 8, Name = "Rock", VMax = 22.0, Mu = 0.80, MuLat = 1.10 },
+            new SurfaceFamily { Id = 9, Name = "Obsidian", VMax = 20.0, Mu = 0.70, MuLat = 0.85 },
+            new SurfaceFamily { Id = 10, Name = "AshVolcano", VMax = 17.5, Mu = 0.55, MuLat = 0.65 },
+        };
+
+        public static double WrapHeading(double h) => h - TwoPi * Math.Floor(h / TwoPi);
+
+        public static void Step(ref GroundState s, in GroundInput u, GroundParams p, GroundOracle oracle, double dt = Dt)
+        {
+            // 1. Steering slew & speed clamp
+            var vAbs = Math.Abs(s.Speed);
+            double steerLock, slewRate;
+            if (vAbs <= p.SteerSpeedLow)
+            {
+                steerLock = p.MaxSteerRad;
+                slewRate = p.SteerSlewRateLow;
+            }
+            else if (vAbs < p.SteerSpeedHigh)
+            {
+                var alpha = (vAbs - p.SteerSpeedLow) / (p.SteerSpeedHigh - p.SteerSpeedLow);
+                steerLock = (1.0 - alpha) * p.MaxSteerRad + alpha * p.MinSteerRad;
+                slewRate = (1.0 - alpha) * p.SteerSlewRateLow + alpha * p.SteerSlewRateHigh;
+            }
+            else
+            {
+                steerLock = p.MinSteerRad;
+                slewRate = p.SteerSlewRateHigh;
+            }
+
+            var targetSteer = Math.Clamp(u.Steer, -1.0, 1.0) * steerLock;
+            var maxSteerDelta = slewRate * dt;
+            var steerDiff = targetSteer - s.SteerAngle;
+            s.SteerAngle += Math.Clamp(steerDiff, -maxSteerDelta, maxSteerDelta);
+
+            // 2. Terrain query
+            var terr = oracle != null ? oracle(s.X, s.Y, s.Z) : new TerrainSample
+            {
+                Z = 0.0, Nx = 0, Ny = 0, Nz = 1, Surface = Surfaces[0], WaterDepth = 0, IsBridge = false
+            };
+            var surf = terr.Surface.VMax > 0 ? terr.Surface : Surfaces[0];
+            var nx = terr.Nx; var ny = terr.Ny; var nz = terr.Nz;
+            var groundZ = terr.Z;
+            var waterDepth = terr.WaterDepth;
+            var isBridge = terr.IsBridge;
+
+            // 3. Slope gradient along heading
+            var sinH = Math.Sin(s.Heading);
+            var cosH = Math.Cos(s.Heading);
+            var slopeDot = (nx * sinH + ny * cosH);
+            var isCliff = nz < p.FloorZ;
+            var gParallel = 0.0;
+            if (!isCliff && nz > 0.1)
+            {
+                gParallel = 9.8 * slopeDot / nz;
+            }
+
+            // 4. Longitudinal Drive / Brake / Coast
+            var spd = s.Speed;
+            if (u.Handbrake)
+            {
+                var b = p.HandbrakeDecel * surf.Mu;
+                if (Math.Abs(spd) <= 0.05 || Math.Abs(spd) <= b * dt)
+                    spd = 0.0;
+                else
+                    spd -= Math.Sign(spd) * b * dt;
+            }
+            else if (u.Throttle > 0.0)
+            {
+                var vTarget = Math.Pow(u.Throttle, 1.0 / 1.8) * surf.VMax;
+                if (spd < vTarget)
+                {
+                    var taper = Math.Sqrt(Math.Max(0.0, u.Throttle - Math.Pow(Math.Max(0.0, spd) / surf.VMax, 1.8)));
+                    var aDrive = p.LaunchAccel * surf.Mu * taper;
+                    if (u.Boost && spd <= p.LowRangeSpeedCap)
+                        aDrive *= p.LowRangeTorqueMul;
+                    spd += (aDrive + gParallel) * dt;
+                    if (spd > vTarget && gParallel <= 0.0) spd = vTarget;
+                }
+                else
+                {
+                    var drag = (p.CoastLinear + p.CoastQuad * Math.Abs(spd)) * dt;
+                    spd = Math.Max(vTarget, spd - drag + gParallel * dt);
+                }
+                if (spd > surf.VMax * 1.15) spd = surf.VMax * 1.15;
+            }
+            else if (u.Throttle < 0.0)
+            {
+                if (spd > 0.0)
+                {
+                    var b = p.NormalBrake * surf.Mu * Math.Abs(u.Throttle) + p.CoastLinear;
+                    spd = Math.Max(0.0, spd - b * dt);
+                }
+                else
+                {
+                    var taper = Math.Sqrt(Math.Max(0.0, 1.0 - Math.Pow(Math.Abs(spd) / Math.Abs(p.VReverseMax), 1.8)));
+                    var aRev = p.LaunchAccel * surf.Mu * taper * Math.Abs(u.Throttle);
+                    if (u.Boost && Math.Abs(spd) <= p.LowRangeSpeedCap)
+                        aRev *= p.LowRangeTorqueMul;
+                    spd = Math.Max(p.VReverseMax, spd - (aRev - gParallel) * dt);
+                }
+            }
+            else
+            {
+                if (Math.Abs(spd) > 0.0)
+                {
+                    var drag = (p.CoastLinear + p.CoastQuad * Math.Abs(spd)) * dt;
+                    if (Math.Abs(spd) <= drag)
+                        spd = 0.0;
+                    else
+                    {
+                        spd -= Math.Sign(spd) * drag;
+                        spd += gParallel * dt;
+                        if (spd > surf.VMax * 1.15) spd = surf.VMax * 1.15;
+                        if (spd < p.VReverseMax) spd = p.VReverseMax;
+                    }
+                }
+            }
+
+            // Water halt check: deep water or ocean surf halts forward motion while permitting reverse
+            if (!isBridge && (waterDepth > p.FordDepthMax || (groundZ <= -0.5 && s.Z <= 0.0)))
+            {
+                if (spd > 0.0) spd = 0.0;
+            }
+            s.Speed = spd;
+
+            // 5. Yaw integration (bicycle model)
+            var muLat = surf.MuLat > 0 ? surf.MuLat : 1.0;
+            var yawRate = (s.Speed * Math.Tan(s.SteerAngle) / p.Wheelbase) * muLat;
+            s.Heading = WrapHeading(s.Heading + yawRate * dt);
+
+            // 6. Velocity vector & collision
+            var vx = Math.Sin(s.Heading) * s.Speed;
+            var vy = Math.Cos(s.Heading) * s.Speed;
+
+            // Cliff deflection
+            if (nz < p.FloorZ)
+            {
+                var len2D = Math.Sqrt(nx * nx + ny * ny);
+                if (len2D > 1e-6)
+                {
+                    var normX = nx / len2D;
+                    var normY = ny / len2D;
+                    var dot = vx * normX + vy * normY;
+                    if (dot < 0.0)
+                    {
+                        vx -= dot * normX;
+                        vy -= dot * normY;
+                        s.Speed = Math.Sqrt(vx * vx + vy * vy) * (s.Speed < 0.0 ? -1.0 : 1.0);
+                    }
+                }
+            }
+
+            // Tree obstacle deflection
+            if (terr.HasObstacle)
+            {
+                var onx = terr.ObstacleNx;
+                var ony = terr.ObstacleNy;
+                var dotN = vx * onx + vy * ony;
+                if (dotN <= 0.0) // Only deflect or stop when moving towards or tangentially to obstacle
+                {
+                    var align = Math.Abs(sinH * onx + cosH * ony);
+                    if (align < p.TreeGlanceThreshold)
+                    {
+                        vx -= dotN * onx;
+                        vy -= dotN * ony;
+                        s.Speed *= (1.0 - p.TreeGlanceScrub);
+                        var cross = sinH * ony - cosH * onx;
+                        var nudgeSign = terr.ObstacleNudgeSign != 0 ? terr.ObstacleNudgeSign : (cross >= 0 ? -1.0 : 1.0);
+                        s.Heading = WrapHeading(s.Heading + nudgeSign * p.TreeYawNudge);
+                    }
+                    else
+                    {
+                        s.Speed = 0.0;
+                        vx = 0.0;
+                        vy = 0.0;
+                    }
+                }
+            }
+
+            s.X += vx * dt;
+            s.Y += vy * dt;
+            s.Z = groundZ;
+            s.Pitch = Math.Asin(Math.Clamp(-slopeDot, -1.0, 1.0));
+            s.Roll = 0.0;
+
+            // 7. State flags & mode
+            s.SurfaceFamily = surf.Id;
+            s.GroundFlags = 0x01; // onGround
+            if (u.Handbrake) s.GroundFlags |= 0x02;
+            if (u.Boost) s.GroundFlags |= 0x04;
+            if (surf.Id == 4) s.GroundFlags |= 0x08; // slipping
+
+            if (Math.Abs(s.Speed) < 0.001 && u.Throttle == 0.0)
+                s.Mode = VehicleMode.Parked;
+            else
+                s.Mode = VehicleMode.Driving;
+
+            var spinRps = p.WheelRadius > 0 ? (s.Speed / p.WheelRadius) : 0.0;
+            s.WheelSpinQ16 = (short)Math.Clamp(Math.Round(spinRps * 16.0), short.MinValue, short.MaxValue);
+        }
+
+        public static (double vx, double vy, double vz) Velocity(in GroundState s)
+        {
+            return (s.Speed * Math.Sin(s.Heading), s.Speed * Math.Cos(s.Heading), 0.0);
+        }
+    }
+}
