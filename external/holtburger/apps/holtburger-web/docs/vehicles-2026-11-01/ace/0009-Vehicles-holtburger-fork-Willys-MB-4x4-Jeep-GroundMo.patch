+        #region Feature 35: Turret Sensor Bus & S2C Contacts Tests
+
+        [TestMethod]
+        public void WirePacking_AirTrackToWire_Matches18ByteLayout()
+        {
+            var radarPos = new Vector3(1000f, 2000f, 100f);
+            var track = new AirTrack
+            {
+                RadarGuid = 0x50000001,
+                VehicleGuid = 0x70000010,
+                PilotGuid = 0x10000002,
+                Standing = IffStanding.Hostile,
+                WorldPos = new Vector3(1500f, 2800f, 350f),
+                WorldVel = new Vector3(20f, 0f, 0f), // East heading
+                AltitudeAglM = 250f,
+                RangeM = 943.398f,
+                BearingRad = 0.558f,
+                ConsecutiveHits = 5,
+                LastSeenUtc = DateTime.UtcNow
+            };
+
+            var wire = track.ToWire(radarPos);
+
+            Assert.AreEqual(0x70000010u, wire.VehicleGuid);
