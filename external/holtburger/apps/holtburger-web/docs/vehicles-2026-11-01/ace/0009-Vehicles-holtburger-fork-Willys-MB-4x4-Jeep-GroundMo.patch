+                finalNx = bridge.Nx;
+                finalNy = bridge.Ny;
+                finalNz = bridge.Nz;
+                waterDepth = 0.0;
+            }
+
+            var obs = VehicleColliderCache.GetTreeObstacle(worldX, worldY, speed, heading);
