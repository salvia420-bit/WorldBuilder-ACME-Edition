+                var tailgatePos = v.TailgatePosition();
+                Assert.IsNotNull(tailgatePos);
+
+                var deployMsg = new VehicleCargo { Vehicle = v.Guid.Full, Action = 1 };
+                var packMsg = new VehicleCargo { Vehicle = v.Guid.Full, Action = 2 };
+
+                // 1. Player at distance ~3.5 m (within 3.8m limit)
+                var playerNear = CreateTestPlayer(0x10000004, 1000.0, 1998.45 - 3.5, 100.75);
+                VehicleManager.ClearSeatedForTesting(playerNear);
+                Assert.IsTrue(playerNear.Location.DistanceTo(tailgatePos) <= 3.8f);
+
+                v.CargoLoaded = true;
+                var okNear = VehicleManager.HandleCargo(playerNear, deployMsg);
+                Assert.IsTrue(okNear, "Deploy must succeed when player is within 3.8m of tailgate");
+                Assert.IsFalse(v.CargoLoaded);
+
+                var okPackNear = VehicleManager.HandleCargo(playerNear, packMsg);
+                Assert.IsTrue(okPackNear, "Pack must succeed when player is within 3.8m of tailgate");
+                Assert.IsTrue(v.CargoLoaded);
+
+                // 2. Player at distance 4.0 m (exceeding 3.8m limit)
+                var playerFar = CreateTestPlayer(0x10000005, 1000.0, 1998.45 - 4.0, 100.75);
+                VehicleManager.ClearSeatedForTesting(playerFar);
+                Assert.IsTrue(playerFar.Location.DistanceTo(tailgatePos) > 3.8f);
+
+                var okFar = VehicleManager.HandleCargo(playerFar, deployMsg);
+                Assert.IsFalse(okFar, "Deploy must be refused when player is > 3.8m from tailgate");
+                Assert.IsTrue(v.CargoLoaded);
+
+                // 3. Player at front of vehicle (Y = 2004.0, > 5m from tailgate)
+                var playerFront = CreateTestPlayer(0x10000006, 1000.0, 2004.0, 100.75);
+                VehicleManager.ClearSeatedForTesting(playerFront);
+                Assert.IsTrue(playerFront.Location.DistanceTo(tailgatePos) > 3.8f);
+
+                var okFront = VehicleManager.HandleCargo(playerFront, deployMsg);
+                Assert.IsFalse(okFront, "Deploy must be refused when player is at front of vehicle");
+                Assert.IsTrue(v.CargoLoaded);
+            }
+            finally
+            {
+                VehicleManager.UnregisterForTesting(v.Guid.Full);
+            }
+        }
