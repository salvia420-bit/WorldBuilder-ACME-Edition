+        [TestMethod]
+        public void GroundTrajectoriesWithin1mmAcrossAllSequences()
+        {
+            var p = Params();
+            var dt = D(root, "dt");
+            Assert.AreEqual(GroundModel.Dt, dt, 1e-12, "step length");
+            var worst = 0.0;
+
+            foreach (var seq in root.GetProperty("sequences").EnumerateArray())
+            {
+                var name = seq.GetProperty("name").GetString();
+                var s = State(seq.GetProperty("initial"));
+                var oracle = GetOracle(name);
+                var checkpoints = seq.GetProperty("checkpoints");
+                var ci = 0;
+                var step = 0;
+
+                foreach (var fr in seq.GetProperty("frames").EnumerateArray())
+                {
+                    var frame = new VehicleInputFrame
+                    {
+                        Throttle = (byte)fr[0].GetInt32(),
+                        Pitch = (sbyte)fr[1].GetInt32(),
+                        Roll = (sbyte)fr[2].GetInt32(),
+                        Yaw = (sbyte)fr[3].GetInt32(),
+                        Buttons = (byte)fr[4].GetInt32(),
+                    };
+                    var u = GroundInput.FromFrame(frame);
+                    GroundModel.Step(ref s, in u, p, oracle, dt);
+                    step++;
+
+                    if (ci < checkpoints.GetArrayLength() && checkpoints[ci].GetProperty("step").GetInt32() == step)
+                    {
+                        var want = State(checkpoints[ci].GetProperty("state"));
+                        var dist = Math.Sqrt((s.X - want.X) * (s.X - want.X) + (s.Y - want.Y) * (s.Y - want.Y) + (s.Z - want.Z) * (s.Z - want.Z));
+                        worst = Math.Max(worst, dist);
+
+                        Assert.IsTrue(dist < 0.001, $"{name} step {step}: position off by {dist:F6} m (limit 0.001 m)");
+                        Assert.AreEqual(want.Mode, s.Mode, $"{name} step {step}: mode");
+                        Assert.AreEqual(want.Speed, s.Speed, 1e-4, $"{name} step {step}: speed");
+                        Assert.AreEqual(0.0, Math.IEEERemainder(s.Heading - want.Heading, 2 * Math.PI), 1e-4, $"{name} step {step}: heading");
+                        Assert.AreEqual(want.Pitch, s.Pitch, 1e-4, $"{name} step {step}: pitch");
+                        Assert.AreEqual(want.SteerAngle, s.SteerAngle, 1e-4, $"{name} step {step}: steerAngle");
+                        Assert.AreEqual(want.SurfaceFamily, s.SurfaceFamily, $"{name} step {step}: surfaceFamily");
+                        Assert.AreEqual(want.GroundFlags, s.GroundFlags, $"{name} step {step}: groundFlags");
+                        ci++;
+                    }
+                }
+                Assert.AreEqual(checkpoints.GetArrayLength(), ci, $"{name}: every checkpoint compared");
+            }
+            Console.WriteLine($"worst ground checkpoint distance C# vs JS: {worst:E3} m");
+        }
