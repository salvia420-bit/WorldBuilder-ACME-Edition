+            var lbY = (int)MathF.Floor(wy / LbM);
+            if (lbX < 0 || lbX >= 256 || lbY < 0 || lbY >= 256)
+                return default;
+
+            var lbg = GetGrid(lbX, lbY);
+            if (lbg?.Heights == null)
+                return default;
+
+            var localX = wx - (float)lbX * LbM;
+            var localY = wy - (float)lbY * LbM;
+            var cellX = Math.Clamp(localX / VertM, 0.0f, 8.0f);
+            var cellY = Math.Clamp(localY / VertM, 0.0f, 8.0f);
