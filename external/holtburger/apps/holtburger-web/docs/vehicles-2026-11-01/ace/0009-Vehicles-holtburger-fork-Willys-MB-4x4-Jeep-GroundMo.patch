+            var cy0 = (int)MathF.Floor(cellY);
+            var cx1 = Math.Min(cx0 + 1, 8);
+            var cy1 = Math.Min(cy0 + 1, 8);
+            var fx = cellX - (float)cx0;
+            var fy = cellY - (float)cy0;
+            var z00 = lbg.Heights[cx0 * 9 + cy0];
+            var z10 = lbg.Heights[cx1 * 9 + cy0];
+            var z01 = lbg.Heights[cx0 * 9 + cy1];
+            var z11 = lbg.Heights[cx1 * 9 + cy1];
+            var gx = (uint)lbX * 8u + (uint)cx0;
+            var gy = (uint)lbY * 8u + (uint)cy0;
+            var swNeCut = CellSwToNeCut(gx, gy);
+
+            var h = TriangleHeightInCell(z00, z10, z01, z11, fx, fy, swNeCut);
+            var (nx, ny, nz) = TriangleNormalInCell(z00, z10, z01, z11, fx, fy, swNeCut);
+
+            int r00 = 0, r10 = 0, r01 = 0, r11 = 0;
+            int nearTerrainCode = 1;
+            if (lbg.Terrain != null && lbg.Terrain.Length >= 81)
+            {
+                var t00 = lbg.Terrain[cx0 * 9 + cy0];
+                var t10 = lbg.Terrain[cx1 * 9 + cy0];
+                var t01 = lbg.Terrain[cx0 * 9 + cy1];
+                var t11 = lbg.Terrain[cx1 * 9 + cy1];
