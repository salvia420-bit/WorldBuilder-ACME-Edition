diff --git a/Source/ACE.Server/Vehicles/VehicleColliderCache.cs b/Source/ACE.Server/Vehicles/VehicleColliderCache.cs
new file mode 100644
index 00000000..faa3464a
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleColliderCache.cs
@@ -0,0 +1,271 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using ACE.DatLoader.FileTypes;
+using ACE.Entity;
+using ACE.Server.Managers;
+using ACE.Server.Physics;
+using ACE.Server.Physics.Animation;
+using ACE.Server.Physics.BSP;
+using ACE.Server.Physics.Common;
+using ACE.Server.Physics.Entity;
+
+namespace ACE.Server.Vehicles
+{
+    public struct BridgeSupport
+    {
+        public bool Found;
+        public double DeckZ;
+        public double Nx, Ny, Nz;
+    }
+
+    public struct TreeObstacle
+    {
+        public bool Collided;
+        public double Nx, Ny;
+        public double NudgeSign;
+    }
+
+    /// <summary>
+    /// Static collision queries for vehicles: walkable bridge deck queries bypassing deep water halt,
+    /// and scenery tree trunk deflection.
+    /// </summary>
+    public static class VehicleColliderCache
+    {
+        const float LbM = 192.0f;
+        const float FloorZ = 0.66417415f;
+        const float DefaultChassisRadius = 0.84f;
+
+        public static Func<float, float, float, BridgeSupport> BridgeSupportOverride;
+
+        public static BridgeSupport GetBridgeSupport(float worldX, float worldY, float worldZ)
+        {
+            if (BridgeSupportOverride != null)
+                return BridgeSupportOverride(worldX, worldY, worldZ);
+
+            var lbX = (int)MathF.Floor(worldX / LbM);
+            var lbY = (int)MathF.Floor(worldY / LbM);
+            if (lbX < 0 || lbX >= 256 || lbY < 0 || lbY >= 256)
+                return default;
+
+            // Search current and adjacent landblocks within 100m cutoff
+            var minDiff = double.MaxValue;
+            BridgeSupport best = default;
+
+            var minLbX = Math.Max(0, (int)MathF.Floor((worldX - 100.0f) / LbM));
+            var maxLbX = Math.Min(255, (int)MathF.Floor((worldX + 100.0f) / LbM));
+            var minLbY = Math.Max(0, (int)MathF.Floor((worldY - 100.0f) / LbM));
+            var maxLbY = Math.Min(255, (int)MathF.Floor((worldY + 100.0f) / LbM));
+
+            for (var cx = minLbX; cx <= maxLbX; cx++)
+            {
+                for (var cy = minLbY; cy <= maxLbY; cy++)
+                {
+                    var lbId = new LandblockId((byte)cx, (byte)cy);
+                    var lb = LandblockManager.GetLandblock(lbId, false);
+                    var plb = lb?.PhysicsLandblock;
+                    if (plb?.Buildings == null) continue;
+
+                    foreach (var bld in plb.Buildings)
+                    {
+                        if (bld?.PartArray == null || bld.PartArray.Parts.Count == 0) continue;
+
+                        // World position of the building origin
+                        var bldWorldX = (float)bld.Position.LandblockX * LbM + bld.Position.Frame.Origin.X;
+                        var bldWorldY = (float)bld.Position.LandblockY * LbM + bld.Position.Frame.Origin.Y;
+                        var bldWorldZ = bld.Position.Frame.Origin.Z;
+
+                        var dx = worldX - bldWorldX;
+                        var dy = worldY - bldWorldY;
+                        if (dx * dx + dy * dy > 10000.0f) continue; // 100m cutoff
+
+                        var root = bld.PartArray.Parts[0].GfxObj?.PhysicsBSP?.RootNode;
+                        if (root == null) continue;
+
+                        // Transform world query point into building local model coordinate frame
+                        var dWorld = new Vector3(dx, dy, worldZ - bldWorldZ);
+                        var localPos = bld.Position.Frame.GlobalToLocalVec(dWorld);
+
+                        var bldWorldOrigin = new Vector3(bldWorldX, bldWorldY, bldWorldZ);
+                        var supp = ProbeBspWalkable(root, localPos, worldZ, bldWorldOrigin, bld.Position.Frame);
+                        if (supp.Found)
+                        {
+                            var diff = Math.Abs(supp.DeckZ - worldZ);
+                            if (diff < minDiff)
+                            {
+                                minDiff = diff;
+                                best = supp;
+                            }
+                        }
+                    }
+                }
+            }
+
+            return best;
+        }
+
+        static BridgeSupport ProbeBspWalkable(ACE.Server.Physics.BSP.BSPNode node, Vector3 localPos, float worldZ, Vector3 bldWorldOrigin, AFrame bldFrame)
+        {
+            if (node == null) return default;
+
+            BridgeSupport best = default;
+            var minDiff = double.MaxValue;
+
+            if (node.Polygons != null)
+            {
+                foreach (var poly in node.Polygons)
+                {
+                    if (poly.Vertices == null || poly.Vertices.Count < 3) continue;
+
+                    // World surface normal check (must be walkable: normal.Z >= FloorZ)
+                    var worldNormal = bldFrame.LocalToGlobalVec(poly.Plane.Normal);
+                    if (worldNormal.Z < FloorZ) continue;
+                    if (Math.Abs(poly.Plane.Normal.Z) < 1e-6f) continue;
+
+                    // 1. Authentic 2D Point-in-Polygon containment check in local plane
+                    if (!IsPointInPolygon2D(localPos.X, localPos.Y, poly.Vertices))
+                        continue;
+
+                    // 2. Local plane height: Nz * pz = -d - (Nx * px + Ny * py)
+                    var pzLocal = (-poly.Plane.D - (poly.Plane.Normal.X * localPos.X + poly.Plane.Normal.Y * localPos.Y)) / poly.Plane.Normal.Z;
+
+                    // 3. Transform deck contact point back to world space
+                    var deckLocal = new Vector3(localPos.X, localPos.Y, pzLocal);
+                    var deckWorld = bldWorldOrigin + bldFrame.LocalToGlobalVec(deckLocal);
+
+                    // 4. Proximity check in world altitude
+                    var diff = Math.Abs(deckWorld.Z - worldZ);
+                    if (diff <= 3.5f && diff < minDiff)
+                    {
+                        minDiff = diff;
+                        best = new BridgeSupport
+                        {
+                            Found = true,
+                            DeckZ = deckWorld.Z,
+                            Nx = worldNormal.X,
+                            Ny = worldNormal.Y,
+                            Nz = worldNormal.Z
+                        };
+                    }
+                }
+            }
+
+            if (node.PosNode != null)
+            {
+                var s = ProbeBspWalkable(node.PosNode, localPos, worldZ, bldWorldOrigin, bldFrame);
+                if (s.Found && Math.Abs(s.DeckZ - worldZ) < minDiff)
+                {
+                    minDiff = Math.Abs(s.DeckZ - worldZ);
+                    best = s;
+                }
+            }
+            if (node.NegNode != null)
+            {
+                var s = ProbeBspWalkable(node.NegNode, localPos, worldZ, bldWorldOrigin, bldFrame);
+                if (s.Found && Math.Abs(s.DeckZ - worldZ) < minDiff)
+                {
+                    best = s;
+                }
+            }
+
+            return best;
+        }
+
+        /// <summary>
+        /// Exact 2D point-in-polygon containment test using horizontal ray casting (Jordan Curve Theorem).
+        /// Handles arbitrary vertex count and any winding direction (CW or CCW) with initial AABB culling.
+        /// </summary>
+        public static bool IsPointInPolygon2D(float px, float py, List<Vertex> vertices)
+        {
+            if (vertices == null || vertices.Count < 3)
+                return false;
+
+            // Bounding box early cull
+            float minX = float.MaxValue, maxX = float.MinValue;
+            float minY = float.MaxValue, maxY = float.MinValue;
+            for (int k = 0; k < vertices.Count; k++)
+            {
+                var vo = vertices[k].Origin;
+                if (vo.X < minX) minX = vo.X;
+                if (vo.X > maxX) maxX = vo.X;
+                if (vo.Y < minY) minY = vo.Y;
+                if (vo.Y > maxY) maxY = vo.Y;
+            }
+            if (px < minX - 0.05f || px > maxX + 0.05f || py < minY - 0.05f || py > maxY + 0.05f)
+                return false;
+
+            bool inside = false;
+            int count = vertices.Count;
+            for (int i = 0, j = count - 1; i < count; j = i++)
+            {
+                var xi = vertices[i].Origin.X;
+                var yi = vertices[i].Origin.Y;
+                var xj = vertices[j].Origin.X;
+                var yj = vertices[j].Origin.Y;
+
+                bool intersect = ((yi > py) != (yj > py)) &&
+                                 (px < (xj - xi) * (py - yi) / (yj - yi) + xi);
+                if (intersect)
+                    inside = !inside;
+            }
+
+            return inside;
+        }
+
+        public static TreeObstacle GetTreeObstacle(double worldX, double worldY, double speed, double heading, double chassisRadius = DefaultChassisRadius)
+        {
+            var lbX = (uint)Math.Floor(worldX / LbM);
+            var lbY = (uint)Math.Floor(worldY / LbM);
+            if (lbX >= 256 || lbY >= 256)
+                return default;
+
+            var lbId = new LandblockId((byte)lbX, (byte)lbY);
+            var lb = LandblockManager.GetLandblock(lbId, false);
+            var plb = lb?.PhysicsLandblock;
+            if (plb?.Scenery == null)
+                return default;
+
+            var fx = Math.Sin(heading);
+            var fy = Math.Cos(heading);
+
+            foreach (var sc in plb.Scenery)
+            {
+                if (sc == null || sc.WeenieObj?.WorldObject != null) continue;
+
+                // Scenery tree origin in world coordinates
+                var treeWorldX = (double)sc.Position.LandblockX * LbM + sc.Position.Frame.Origin.X;
+                var treeWorldY = (double)sc.Position.LandblockY * LbM + sc.Position.Frame.Origin.Y;
+
+                var dx = worldX - treeWorldX;
+                var dy = worldY - treeWorldY;
+                var distSq = dx * dx + dy * dy;
+
+                var trunkRadius = (double)sc.GetPhysicsRadius();
+                if (trunkRadius <= 0.05) trunkRadius = sc.GetRadius();
+                if (trunkRadius <= 0.05) trunkRadius = 0.4;
+                var hitDist = trunkRadius + chassisRadius;
+
+                if (distSq < hitDist * hitDist && distSq > 1e-6)
+                {
+                    var dist = Math.Sqrt(distSq);
+                    var nx = dx / dist;
+                    var ny = dy / dist;
+
+                    // 2D cross product to determine glance nudge sign away from tree center
+                    var cross = fx * ny - fy * nx;
+                    var nudgeSign = cross >= 0 ? -1.0 : 1.0;
+
+                    return new TreeObstacle
+                    {
+                        Collided = true,
+                        Nx = nx,
+                        Ny = ny,
+                        NudgeSign = nudgeSign
+                    };
+                }
+            }
+
+            return default;
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/VehicleImpact.cs b/Source/ACE.Server/Vehicles/VehicleImpact.cs
new file mode 100644
index 00000000..be6319a5
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleImpact.cs
@@ -0,0 +1,268 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using ACE.Common;
+using ACE.Entity.Enum;
+using ACE.Entity.Enum.Properties;
+using ACE.Server.Entity;
+using ACE.Server.Managers;
+using ACE.Server.Network.GameEvent.Events;
+using ACE.Server.Network.GameMessages.Messages;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles
+{
+    public static class VehicleImpact
+    {
+        public const float SpeedThreshold = 5.0f;
+        public const float CooldownSeconds = 0.75f;
+        public const uint CooldownSteps = 23;
+        public const float BumperOffset = 1.7f;
+        public const float BumperHalfWidth = 0.84f;
+        public const float BumperRadius = 0.84f;
+
+        public static List<Creature> TestCandidates = null;
+
+        private static readonly List<Creature> knownBuffer = new List<Creature>();
+        private static readonly List<Creature> candidateBuffer = new List<Creature>();
+        private static Vehicle candidatesFor;
+        private static long candidatesTick = -1;
+
+        public static float CalculateDamage(float speed)
+        {
+            var s = Math.Abs(speed);
+            return 18.0f + 0.42f * s * s;
+        }
+
+        public static Vector3 CalculateKnockback(Vector3 forward, float speed)
+        {
+            var s = Math.Abs(speed);
+            var travelDir = speed >= 0 ? forward : -forward;
+            var clampedMag = Math.Clamp(0.65f * s, 6.0f, 18.0f);
+            return travelDir * clampedMag + new Vector3(0f, 0f, 3.5f);
+        }
+
+        public static bool IsImmune(Vehicle v, uint creatureGuid)
+        {
+            if (v.RamCooldowns.TryGetValue(creatureGuid, out var cd))
+            {
+                if (v.SimStep < cd.DueStep && (DateTime.UtcNow - cd.HitUtc).TotalSeconds < CooldownSeconds)
+                    return true;
+            }
+            return false;
+        }
+
+        public static void RecordHit(Vehicle v, uint creatureGuid)
+        {
+            v.RamCooldowns[creatureGuid] = new Vehicle.RamCooldown
+            {
+                HitUtc = DateTime.UtcNow,
+                DueStep = v.SimStep + CooldownSteps
+            };
+
+            if (v.RamCooldowns.Count > 64)
+                PruneCooldowns(v);
+        }
+
+        private static void PruneCooldowns(Vehicle v)
+        {
+            var now = DateTime.UtcNow;
+            var toRemove = new List<uint>();
+            foreach (var (guid, cd) in v.RamCooldowns)
+            {
+                if (v.SimStep >= cd.DueStep || (now - cd.HitUtc).TotalSeconds >= CooldownSeconds)
+                    toRemove.Add(guid);
+            }
+            foreach (var guid in toRemove)
+                v.RamCooldowns.Remove(guid);
+        }
+
+        public static bool IsEligibleTarget(Creature c, Player driver)
+        {
+            if (c == null || c.IsDestroyed || c.PhysicsObj == null || c.Location == null)
+                return false;
+
+            if (c.Vitals == null || !c.Vitals.ContainsKey(PropertyAttribute2nd.MaxHealth) || c.IsDead)
+                return false;
+
+            if (c.Location.Indoors)
+                return false;
+
+            if (c is Player victim)
+            {
+                if (!VehicleManager.GunPlayersThisTick || victim == driver || VehicleManager.IsSeated(victim) || VehicleBailout.IsFalling(victim))
+                    return false;
+            }
+            else
+            {
+                if (!c.Attackable || c.IsNPC || c is Vendor)
+                    return false;
+            }
+
+            if (c.Teleporting)
+                return false;
+
+            if (driver != null && !driver.CanDamage(c))
+                return false;
+
+            return true;
+        }
+
+        public static List<Creature> GetCandidates(Vehicle v, Player driver, float reach = 6.0f)
+        {
+            if (TestCandidates != null)
+                return TestCandidates;
+
+            if (candidatesFor == v && candidatesTick == VehicleManager.TickNumber)
+                return candidateBuffer;
+
+            candidatesFor = v;
+            candidatesTick = VehicleManager.TickNumber;
+            candidateBuffer.Clear();
+
+            if (driver?.PhysicsObj?.ObjMaint != null)
+            {
+                driver.PhysicsObj.ObjMaint.CopyKnownCreaturesTo(knownBuffer);
+            }
+
+            if (knownBuffer.Count == 0)
+            {
+                var x = v.State.X;
+                var y = v.State.Y;
+                var continent = y >= Vehicle.DericostYOffset ? 1 : 0;
+                var localY = continent == 1 ? y - Vehicle.DericostYOffset : y;
+                var x0 = (int)Math.Floor((x - reach) / 192.0);
+                var x1 = (int)Math.Floor((x + reach) / 192.0);
+                var y0 = (int)Math.Floor((localY - reach) / 192.0);
+                var y1 = (int)Math.Floor((localY + reach) / 192.0);
+
+                for (var lx = x0; lx <= x1; lx++)
+                {
+                    for (var ly = y0; ly <= y1; ly++)
+                    {
+                        var lb = LandblockManager.GetLoadedLandblock(continent, lx, ly);
+                        if (lb == null) continue;
+                        foreach (var wo in lb.GetAllWorldObjectsForDiagnostics())
+                        {
+                            if (wo is Creature c)
+                                knownBuffer.Add(c);
+                        }
+                    }
+                }
+            }
+
+            foreach (var c in knownBuffer)
+            {
+                if (IsEligibleTarget(c, driver))
+                    candidateBuffer.Add(c);
+            }
+            knownBuffer.Clear();
+            return candidateBuffer;
+        }
+
+        public static void Step(Vehicle v, Player driver)
+        {
+            if (v == null || driver == null) return;
+            var speed = (float)v.State.Speed;
+            if (Math.Abs(speed) < SpeedThreshold) return;
+
+            var heading = v.State.Heading;
+            var sinH = (float)Math.Sin(heading);
+            var cosH = (float)Math.Cos(heading);
+
+            var fwd = new Vector3(sinH, cosH, 0f);
+            var right = new Vector3(cosH, -sinH, 0f);
+
+            var vPos = new Vector3((float)v.State.X, (float)v.State.Y, (float)v.State.Z);
+            var forwardOffset = speed >= 0 ? BumperOffset : -BumperOffset;
+            var bumperCenter = vPos + fwd * forwardOffset;
+
+            var segA = bumperCenter - right * BumperHalfWidth;
+            var segB = bumperCenter + right * BumperHalfWidth;
+            var segAB = segB - segA;
+            var segLenSq = Math.Max(0.001f, segAB.LengthSquared());
+
+            var candidates = GetCandidates(v, driver, reach: 6.0f);
+            foreach (var target in candidates)
+            {
+                if (!IsEligibleTarget(target, driver)) continue;
+
+                if (IsImmune(v, target.Guid.Full))
+                    continue;
+
+                var (cx, cy, cz) = Vehicle.ToGlobal(target.Location);
+                var cPos = new Vector3((float)cx, (float)cy, (float)cz);
+                var hTarget = Math.Max(0.5f, target.PhysicsObj.GetHeight());
+
+                // Vertical overlap
+                if (cz > vPos.Z + 1.8f || (cz + hTarget) < vPos.Z - 0.5f)
+                    continue;
+
+                // Horizontal distance to segment AB
+                var ap = new Vector2(cPos.X - segA.X, cPos.Y - segA.Y);
+                var ab2 = new Vector2(segAB.X, segAB.Y);
+                var t = Math.Clamp(Vector2.Dot(ap, ab2) / segLenSq, 0f, 1f);
+                var closestPoint = new Vector2(segA.X, segA.Y) + ab2 * t;
+                var distSq = Vector2.DistanceSquared(new Vector2(cPos.X, cPos.Y), closestPoint);
+
+                // Capsule hull reach: total lateral reach from vehicle centerline is strictly
+                // BumperHalfWidth (0.84m) + BumperRadius (0.84m) = 1.68m
+                var hitDist = BumperRadius;
+                if (distSq > hitDist * hitDist)
+                    continue;
+
+                // Collision confirmed
+                RecordHit(v, target.Guid.Full);
+                ApplyImpact(v, driver, target, speed, fwd, bumperCenter);
+            }
+        }
+
+        private static void ApplyImpact(Vehicle v, Player driver, Creature target, float speed, Vector3 fwd, Vector3 bumperCenter)
+        {
+            var damage = CalculateDamage(speed);
+            var kb = CalculateKnockback(fwd, speed);
+
+            // Apply velocity knockback to physics object and broadcast
+            target.PhysicsObj?.set_velocity(kb, true);
+            if (target.Sequences != null)
+                target.SendUpdatePosition();
+
+            // Deal bludgeon damage attributed to driver
+            uint dealt = 0;
+            if (target is Player victim)
+            {
+                var taken = victim.TakeDamage(driver, DamageType.Bludgeon, damage, BodyPart.Chest, false);
+                dealt = (uint)Math.Max(0, taken);
+            }
+            else
+            {
+                dealt = target.TakeDamage(driver, DamageType.Bludgeon, damage, false);
+            }
+
+            // Broadcast wire event 17 (RamHit)
+            var impactPos = Vehicle.ToPosition(bumperCenter.X, bumperCenter.Y, bumperCenter.Z, Quaternion.Identity);
+            VehicleManager.BroadcastEvent(
+                v,
+                VehicleEventKind.RamHit,
+                target.Guid.Full,
+                Math.Abs(speed),
+                at: impactPos,
+                alsoTo: driver,
+                aux: (uint)Math.Round(damage),
+                velocity: kb);
+
+            if (target.IsAlive)
+            {
+                if (dealt > 0)
+                {
+                    driver.Session?.Network.EnqueueSend(new GameEventAttackerNotification(
+                        driver.Session, target.Name, DamageType.Bludgeon,
+                        (float)dealt / Math.Max(1u, target.Health.MaxValue), dealt, false, AttackConditions.None));
+                    target.EnqueueBroadcast(new GameMessageSound(target.Guid, Sound.HitFlesh1, 0.5f));
+                    target.EmoteManager?.OnDamage(driver);
+                }
+                driver.OnAttackMonster(target);
+            }
+        }
+    }
+}
