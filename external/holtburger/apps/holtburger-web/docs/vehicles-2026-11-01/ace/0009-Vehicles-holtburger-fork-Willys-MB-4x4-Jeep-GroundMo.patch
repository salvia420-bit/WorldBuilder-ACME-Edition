+            {
+                isLeft ? new Vector3(-1.8f, seatY, 0.0f) : new Vector3(1.8f, seatY, 0.0f),  // ownDoorSide
+                isLeft ? new Vector3(1.8f, seatY, 0.0f) : new Vector3(-1.8f, seatY, 0.0f),  // oppositeDoorSide
+                new Vector3(0.0f, -2.4f, 0.0f),                                              // rearTailgate
+                new Vector3(0.0f, 0.0f, 0.0f),                                               // center fallback
+            };
+
+            foreach (var cand in candidates)
+            {
+                var (wx, wy, _) = v.LocalToWorld(cand);
