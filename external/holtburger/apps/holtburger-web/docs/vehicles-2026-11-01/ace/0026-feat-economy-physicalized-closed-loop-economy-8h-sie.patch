+        public static bool TryWithdrawFromTownTill(uint townId, long amount, string reason, out string error)
+        {
+            if (amount <= 0)
+            {
+                error = null;
+                return true;
+            }
+
+            var state = GetTownState(townId);
+            if (state == null)
+            {
+                error = "Town treasury not found.";
+                return false;
+            }
+
+            TownControl snap;
+            lock (state.SyncRoot)
+            {
+                if (state.Control.State is "CONTESTED_HOLD" or "STARVING")
+                {
+                    error = "Town treasury is frozen in siege escrow.";
+                    return false;
+                }
+                var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+                if (spendable <= 0 || spendable < amount)
+                {
+                    error = "Town treasury till cannot cover this payout.";
+                    return false;
+                }
+
+                state.Control.TreasuryPyreals -= amount;
+                state.Control.UpdatedUtc = DateTime.UtcNow;
+                snap = CloneControl(state.Control);
+            }
+            PersistTownControl(snap);
+            error = null;
+            return true;
+        }
