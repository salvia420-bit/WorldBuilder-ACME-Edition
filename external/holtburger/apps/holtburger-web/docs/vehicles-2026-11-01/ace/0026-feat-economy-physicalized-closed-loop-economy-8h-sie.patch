+
+            // 3. Zero-notice 300s breach gate: at 299s no alert, no escrow freeze; at 300s -> CONTESTED_HOLD + freeze
+            SiegeManager.BeginZeroNoticeBreachForTesting(1u, 200u, 120_000L);
