+        public static LogisticsNavGraph LoadFromFile(string path)
+        {
+            if (string.IsNullOrWhiteSpace(path) || !File.Exists(path))
+                throw new FileNotFoundException("Logistics nav graph file not found.", path);
+
+            var json = File.ReadAllText(path);
+            var graph = LoadFromJson(json);
+            graph.SourcePath = path;
+            return graph;
+        }
