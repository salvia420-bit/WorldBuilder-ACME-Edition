+            SiegeManager.TickForTesting(299.0);
+            var s299 = SiegeManager.GetSiegeState(1u);
+            Assert.AreEqual("CONTROLLED", s299.State);
+            Assert.AreEqual(0L, s299.EscrowPyreals);
+            Assert.AreEqual(0, alertsFired, "Zero advance notice: no alert may fire before 300s breach gate");
+
+            SiegeManager.TickForTesting(1.0);
+            var s300 = SiegeManager.GetSiegeState(1u);
+            Assert.AreEqual("CONTESTED_HOLD", s300.State);
+            Assert.AreEqual(100_000L, s300.EscrowPyreals, "Only spendable treasury (120k - 20k reserve = 100k) freezes into escrow");
+            Assert.AreEqual(20_000L, s300.TreasuryPyreals, "20k ClearinghouseReservePyreals must remain ring-fenced in TreasuryPyreals");
+            Assert.AreEqual(20_000L, s300.ClearinghouseReservePyreals);
