+        {
+            var profile = VehicleProfile.GetByWcid(4_000_050u);
+            Assert.IsNotNull(profile);
+            Assert.AreEqual(VehicleLocomotion.Marine, profile.Locomotion);
+            Assert.AreEqual((byte)VehicleClass.ContainerShipFeeder, profile.VehicleClass);
+            Assert.AreEqual(6.2f, profile.VMax, 0.01f);
+            Assert.AreEqual(-3.2f, profile.ReverseMax, 0.01f);
+            Assert.AreEqual(0.24f, profile.YawRate, 0.001f);
+
+            var ship = VehicleManager.SpawnAutonomous(profile, 44960.0, 48500.0, 0.0, 0.0, out var err, 0x50000001u);
+            Assert.IsNotNull(ship, err);
+            Assert.AreEqual(4_000_050u, ship.WeenieClassId);
+            Assert.IsTrue(ship.IsExcludedFromBiotaPersistence);
+
+            // Step hydrodynamic MarineModel in open water (code 20)
+            var input = new MarineInput { Throttle = 1.0, TargetRudderRad = 0.25 };
+            for (int i = 0; i < 60; i++)
+                MarineModel.Step(ref ship.MarineState, in input, ship.MarineParams, (_, _) => 20, MarineModel.Dt, swellEnabled: true);
+
+            Assert.IsTrue(ship.MarineState.Speed > 0.5);
+            Assert.IsTrue(ship.MarineState.Y > 48500.0);
+            Assert.IsFalse(ship.MarineState.Grounded);
+            Assert.IsTrue(Math.Abs(ship.MarineState.Z) <= 0.35); // Buoyancy wave envelope
+
+            // Grounding guard when hitting dry land (code 1)
+            double preGroundY = ship.MarineState.Y;
+            MarineModel.Step(ref ship.MarineState, in input, ship.MarineParams, (_, _) => 1, MarineModel.Dt, swellEnabled: false);
+            Assert.IsTrue(ship.MarineState.Grounded);
+            Assert.AreEqual(preGroundY, ship.MarineState.Y, 0.01);
+
+            // Dock 22R1 Reefer into Bay 06 -> ExternalReeferPowerConnected freezes perishable at 0.0x
+            var reeferPos = Vehicle.ToPosition(ship.MarineState.X, ship.MarineState.Y, 3.95, Quaternion.Identity);
+            var reefer = DeployableManager.SpawnDeployable(4000060u, reeferPos) as IsoContainerDeployable;
+            Assert.IsNotNull(reefer);
+            var bioGland = CreatePerishableBioGland();
+            Assert.IsTrue(reefer.TryStorePerishableItem(bioGland, out _));
+
+            Assert.IsTrue(ship.DockReeferInBay06(reefer));
+            Assert.IsTrue(reefer.ExternalReeferPowerConnected);
+            Assert.IsTrue(reefer.IsPoweredReefer);
+
+            double initialFresh = PerishableDecay.GetFreshnessPercent(bioGland);
+            reefer.Tick(3_600.0);
+            Assert.AreEqual(initialFresh, PerishableDecay.GetFreshnessPercent(bioGland), 0.001, "Powered Bay 06 Reefer must freeze decay at 0.0x");
+
+            // Exhaust ship generator fuel -> Bay 06 loses power -> Reefer thaws and decays
+            ship.FuelLiters = 0.0f;
+            ship.SyncBay06ReeferPower();
+            Assert.IsFalse(reefer.ExternalReeferPowerConnected);
+            Assert.IsFalse(reefer.IsPoweredReefer);
+
+            reefer.Tick(3_600.0);
+            Assert.IsTrue(PerishableDecay.GetFreshnessPercent(bioGland) < initialFresh - 10.0, "Unpowered Reefer must resume perishable decay");
+        }
