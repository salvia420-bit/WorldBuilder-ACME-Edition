+        public static IReadOnlyList<MonarchOrder> GetOrders(uint? townId = null)
+        {
+            EnsureInitialized();
+            IEnumerable<MonarchOrder> query = monarchOrders.Values;
+            if (townId.HasValue && townId.Value != 0)
