+                var pod = DeployableManager.SpawnDeployable(4000010, portPos) as FluxPodDeployable;
+                var genset = DeployableManager.SpawnDeployable(4000086, portPos) as IndustrialGensetDeployable;
+
+                MarineTerminalDeployable rack;
+                IsoContainerDeployable reefer;
+                if (order == 0)
+                {
+                    rack = DeployableManager.SpawnDeployable(4_000_055u, portPos) as MarineTerminalDeployable;
+                    reefer = DeployableManager.SpawnDeployable(4_000_060u, reeferPos) as IsoContainerDeployable;
+                }
+                else
+                {
+                    reefer = DeployableManager.SpawnDeployable(4_000_060u, reeferPos) as IsoContainerDeployable;
+                    rack = DeployableManager.SpawnDeployable(4_000_055u, portPos) as MarineTerminalDeployable;
+                }
+
+                // Force reverse GUID registration order on pass 1 to test ConcurrentDictionary order independence
+                if (order == 1)
+                {
+                    DeployableManager.Unregister(rack.Guid.Full);
+                    DeployableManager.Unregister(reefer.Guid.Full);
+                    DeployableManager.Register(reefer);
+                    DeployableManager.Register(rack);
+                }
+
+                var gland = CreatePerishableBioGland();
+                Assert.IsTrue(reefer.TryStorePerishableItem(gland, out _));
+                Assert.IsTrue(rack.DockReefer(reefer));
+
+                // Same-tick power restore freeze
+                DeployableManager.Tick(1800.0);
+                Assert.IsTrue(rack.IsPowered);
+                Assert.IsTrue(reefer.ExternalReeferPowerConnected);
