+        public static void TickForTesting(double deltaSeconds)
+            => Tick(deltaSeconds, null);
+
+        public static void Tick(double elapsedSeconds, DateTime? utcNowOverride = null)
+        {
+            if (!double.IsFinite(elapsedSeconds) || elapsedSeconds <= 0.0)
+                return;
+
+            var now = utcNowOverride ?? DateTime.UtcNow;
+
+            foreach (var state in TownEconomyManager.GetAllTownStates())
+            {
+                uint townId;
+                string stateStr;
+                lock (state.SyncRoot)
+                {
+                    townId = state.Control.TownId;
+                    stateStr = state.Control.State;
+                }
+
+                // Evaluate live players inside 30m TownControlNode ring if node is active in world
+                uint? liveRingHolder = EvaluateLiveControlRingHolder(townId);
+                bool ringTransitioned = false;
+                if (liveRingHolder.HasValue)
+                {
+                    ringTransitioned = AdvanceRingHoldCore(townId, liveRingHolder.Value, elapsedSeconds, now);
+                    lock (state.SyncRoot)
+                        stateStr = state.Control.State;
+                }
+
+                if (stateStr is "CONTESTED_HOLD" or "STARVING")
+                {
+                    KeepSiegedLandblockActive(townId);
+                }
+
+                AdvanceTownTick(state, elapsedSeconds, now, liveRingHolder, ringTransitioned);
+            }
+        }
+
+        private static void KeepSiegedLandblockActive(uint townId)
+        {
+            var def = TownRegistry.GetById(townId);
+            if (def == null) return;
+            var lbX = (int)((def.AnchorLandblock >> 24) & 0xFF);
+            var lbY = (int)((def.AnchorLandblock >> 16) & 0xFF);
+            try
+            {
+                LandblockManager.GetLoadedLandblock(def.ContinentId, lbX, lbY)?.SetActive(true);
+            }
+            catch
+            {
+                // Safe in headless unit tests where LandblockManager is uninitialized
+            }
+        }
+
+        private static bool IsPlayerDeadSafe(Player player)
+        {
+            if (player == null) return true;
+            try
+            {
+                return player.Vitals != null
+                    && player.Vitals.ContainsKey(ACE.Entity.Enum.Properties.PropertyAttribute2nd.MaxHealth)
+                    && player.IsDead;
+            }
+            catch
+            {
+                return false;
+            }
+        }
+
+        private static uint? EvaluateLiveControlRingHolder(uint townId)
+        {
+            if (!TryGetHydratedControlNode(townId, out var node))
+                return null;
+
+            uint foundMonarch = 0;
+            bool contestedByMultiple = false;
+            try
+            {
+                foreach (var player in PlayerManager.GetAllOnline())
+                {
+                    if (player == null || player.IsLoggingOut || IsPlayerDeadSafe(player)) continue;
+                    if (!node.IsPlayerInsideControlRing(player)) continue;
+                    var monarch = TownCommands.ResolveEffectiveMonarchId(player);
+                    if (monarch == 0) continue;
+
+                    if (foundMonarch == 0)
+                        foundMonarch = monarch;
+                    else if (foundMonarch != monarch)
+                    {
+                        contestedByMultiple = true;
+                        break;
+                    }
+                }
+            }
+            catch
+            {
+                return null;
+            }
+
+            if (contestedByMultiple)
+                return 0u; // Explicitly contested -> clears uncontested breach/hold progress
+            return foundMonarch; // 0u when hydrated ring is empty; monarchId when uncontested
+        }
