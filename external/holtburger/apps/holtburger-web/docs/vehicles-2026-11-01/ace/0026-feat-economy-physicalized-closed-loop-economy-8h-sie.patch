+                {
+                    TownId = state.Control.TownId,
+                    TownName = state.Control.Name,
+                    State = state.Control.State,
+                    OwnerMonarchId = state.Control.OwnerMonarchId,
+                    AttackerMonarchId = state.Control.AttackerMonarchId,
+                    HoldElapsedSec = state.HoldElapsedSecExact,
+                    SupplyMeterSec = state.SupplyMeterSecExact,
+                    StarvingSec = state.StarvingSecExact,
+                    TreasuryPyreals = state.Control.TreasuryPyreals,
+                    EscrowPyreals = state.Control.EscrowPyreals,
+                    ClearinghouseReservePyreals = state.Control.ClearinghouseReservePyreals,
+                    AttackerSpoilsPyreals = state.LastAttackerSpoilsPyreals,
+                    DefenderEvacuatedPyreals = state.LastDefenderEvacuatedPyreals,
+                    AttackerCooldownRemainingSec = state.CooldownRemainingSec,
+                    BreachMonarchId = state.BreachMonarchId,
+                    BreachElapsedSec = state.BreachElapsedSec,
+                    DefenderHoldElapsedSec = state.DefenderHoldElapsedSec,
+                    ThreeWayCandidateMonarchId = state.ThreeWayCandidateMonarchId,
+                    ThreeWayHoldElapsedSec = state.ThreeWayHoldElapsedSec,
+                    ApronSupplySp = state.ApronSupplySp,
+                    LastDefenderSeizedSupplySp = state.LastDefenderSeizedSupplySp,
+                    ClaimElapsedSec = state.ClaimElapsedSec,
+                    ClaimMonarchId = state.ClaimMonarchId,
+                    InactivityElapsedSec = state.InactivityElapsedSec,
+                    InsolvencyGraceElapsedSec = state.InsolvencyGraceElapsedSec,
+                    TurretsBrownedOut = state.Control.State == "STARVING",
+                    AlertCount = state.AlertCount,
+                    LastAlertMessage = state.LastAlertMessage,
+                };
+            }
+        }
+    }
