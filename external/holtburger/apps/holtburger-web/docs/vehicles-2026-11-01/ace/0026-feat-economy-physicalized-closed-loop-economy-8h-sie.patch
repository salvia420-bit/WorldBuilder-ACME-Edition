+        public static bool TryRunMiningExtraction(
+            IndustrySkidDeployable skid,
+            ulong depositId,
+            double requestedTonnes,
+            out double concentrateTonnes,
+            out string error)
+        {
+            concentrateTonnes = 0.0;
+            if (skid == null || skid.IsDestroyed || skid.IsPacked || skid.IsStowed)
+            {
+                error = "Mining skid is unavailable.";
+                return false;
+            }
+            if (!skid.IsPowered)
+            {
+                error = $"{skid.Name} is browned out (requires MicroGrid power).";
+                return false;
+            }
+
+            var dep = GeologyService.GetDeposit(depositId);
+            if (dep == null)
+            {
+                error = $"Subsurface deposit {depositId} does not exist.";
+                return false;
+            }
+            if (IsPetroleumDeposit(dep.ResourceType))
+            {
+                error = $"Deposit {depositId} ({dep.ResourceType}) is a petroleum reservoir and cannot be mined with hard-rock equipment.";
+                return false;
+            }
+
+            if (!GeologyService.TryExtractTonnes(depositId, requestedTonnes, out double extracted, out error))
+                return false;
+
+            double gradeFactor = Math.Clamp(dep.GradeBps / 10000.0, 0.1, 1.0);
+            // Concentrator applies 5-10x mass reduction to concentrate
+            concentrateTonnes = skid.Kind == DeployableKind.Concentrator
+                ? Math.Max(0.1, extracted * gradeFactor * 0.15)
+                : extracted;
+
+            RecordFacilityState(skid, skid.AffiliatedTownId, depositId, "extract_ore");
+            return true;
+        }
+
+        public static bool TryRunOilExtraction(
+            PumpjackTreeDeployable pumpjack,
+            ulong depositId,
+            double requestedBarrels,
+            out double crudeBarrels,
+            out double assocGasUnits,
+            out string error)
+        {
+            crudeBarrels = 0.0;
+            assocGasUnits = 0.0;
+            if (pumpjack == null || pumpjack.IsDestroyed || pumpjack.IsPacked || pumpjack.IsStowed)
+            {
+                error = "Wellhead / Pumpjack is unavailable.";
+                return false;
+            }
+            if (!double.IsFinite(requestedBarrels) || requestedBarrels <= 0.0)
+            {
+                error = "Requested barrel count must be positive.";
+                return false;
+            }
+
+            var dep = GeologyService.GetDeposit(depositId);
+            if (dep == null)
+            {
+                error = $"Deposit {depositId} not found.";
+                return false;
+            }
+            if (!IsPetroleumDeposit(dep.ResourceType))
+            {
+                error = $"Deposit {depositId} ({dep.ResourceType}) is not a petroleum/crude-oil reservoir.";
+                return false;
+            }
+
+            bool needsLift = dep.RemainingTonnes < 300_000.0f;
+            pumpjack.ArtificialLiftRequired = needsLift;
+            if (needsLift && !pumpjack.IsPowered)
+            {
+                error = "Reservoir pressure declined: Pumpjack artificial lift (15 kW) requires MicroGrid power.";
+                return false;
+            }
+
+            double tonnes = requestedBarrels * 0.136; // ~7.35 bbl per metric tonne
+            if (!GeologyService.TryExtractTonnes(depositId, tonnes, out double extractedTonnes, out error))
+                return false;
+
+            crudeBarrels = extractedTonnes / 0.136;
+            assocGasUnits = crudeBarrels * 0.18;
+            RecordFacilityState(pumpjack, pumpjack.AffiliatedTownId, depositId, needsLift ? "pumpjack_lift" : "free_flow");
+            return true;
+        }
