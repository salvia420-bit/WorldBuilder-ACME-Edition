+                v.GroundState.Mode = convoy.Status == LogisticsConvoyStatus.EnRoute ? VehicleMode.Driving : VehicleMode.Parked;
+                v.State = v.GroundState.ToFlightState();
+                v.AutonomousGroundInput = convoy.Status == LogisticsConvoyStatus.EnRoute
+                    ? new GroundInput { Throttle = 1.0 }
