+
+            Assert.IsNotNull(derethHydrated);
+            Assert.AreNotEqual(0u, derethHydrated.NodeGuid);
+            Assert.AreNotEqual(0u, derethHydrated.DepotGuid);
+
+            Assert.IsNotNull(dericostHydrated);
+            Assert.AreNotEqual(0u, dericostHydrated.NodeGuid);
+            Assert.AreNotEqual(0u, dericostHydrated.DepotGuid);
+
+            var derethNode = DeployableManager.GetDeployable(derethHydrated.NodeGuid) as TownControlNodeDeployable;
+            var dericostNode = DeployableManager.GetDeployable(dericostHydrated.NodeGuid) as TownControlNodeDeployable;
+            Assert.AreEqual(100u, derethNode.OwnerMonarchId);
+            Assert.AreEqual(200u, dericostNode.OwnerMonarchId);
+
+            // Idempotency check: calling again reuses same GUIDs and does not duplicate
+            var derethHydrated2 = SiegeManager.EnsureTownEntitiesHydrated(1u);
+            Assert.AreEqual(derethHydrated.NodeGuid, derethHydrated2.NodeGuid);
+            Assert.AreEqual(derethHydrated.DepotGuid, derethHydrated2.DepotGuid);
+
+            // 2. Verify Dericost Landblock.BringUp() enqueues OnLandblockLoaded even with early Continent == 1 return
+            var vasmoraDef = TownRegistry.GetById(61u);
+            var lb = (Landblock)RuntimeHelpers.GetUninitializedObject(typeof(Landblock));
+            typeof(Landblock).GetField("<Id>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(lb, new LandblockId(vasmoraDef.AnchorLandblock));
+            typeof(Landblock).GetField("actionQueue", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(lb, new ActionQueue());
+            var physLb = RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Physics.Common.Landblock));
+            typeof(ACE.Server.Physics.Common.Landblock).GetField("<ServerObjects>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(physLb, new List<ACE.Server.Physics.PhysicsObj>());
+            typeof(Landblock).GetField("<PhysicsLandblock>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(lb, physLb);
+
+            // Destroy existing hydrated Vasmora entities (simulating landblock unload) and flip town owner
+            dericostNode.Destroy(false, true);
+            DeployableManager.GetDeployable(dericostHydrated.DepotGuid)?.Destroy(false, true);
+            TownEconomyManager.SetTownOwner(61u, 300u, "CONTROLLED");
+
+            // Invoke private BringUp() -> enqueues SiegeManager.OnLandblockLoaded(this)
+            var bringUp = typeof(Landblock).GetMethod("BringUp", BindingFlags.Instance | BindingFlags.NonPublic);
+            bringUp.Invoke(lb, null);
+            var aq = (ActionQueue)typeof(Landblock).GetField("actionQueue", BindingFlags.Instance | BindingFlags.NonPublic).GetValue(lb);
+            var queueProp = typeof(ActionQueue).GetProperty("Queue", BindingFlags.Instance | BindingFlags.NonPublic);
+            var concurrentQueue = (System.Collections.Concurrent.ConcurrentQueue<IAction>)queueProp.GetValue(aq);
+            Assert.AreEqual(1, concurrentQueue.Count, "Dericost Landblock.BringUp() must enqueue SiegeManager.OnLandblockLoaded before returning");
+
+            // Simulate re-hydration on reload using EnsureTownEntitiesHydrated
+            var rehydratedDericost = SiegeManager.EnsureTownEntitiesHydrated(61u);
+            var newNode = DeployableManager.GetDeployable(rehydratedDericost.NodeGuid) as TownControlNodeDeployable;
+            Assert.IsNotNull(newNode);
+            Assert.AreEqual(300u, newNode.OwnerMonarchId, "Re-hydrated node must reflect updated owner_monarch_id after landblock reload");
+        }
