+        // Caller MUST hold _crossTownClearinghouseLock and NO TownRuntimeState.SyncRoot.
+        private static long GetTotalBackedClearinghouseReserveLocked()
+        {
+            long total = 0;
+            foreach (var kvp in towns.OrderBy(k => k.Key))
+            {
+                lock (kvp.Value.SyncRoot)
+                {
+                    var backed = Math.Min(kvp.Value.Control.ClearinghouseReservePyreals, kvp.Value.Control.TreasuryPyreals);
+                    if (backed > 0)
+                        total += backed;
+                }
+            }
+            return total;
+        }
+
+        // Caller MUST hold _crossTownClearinghouseLock and NO TownRuntimeState.SyncRoot.
+        private static long GetAvailableCrossTownBackingLocked(uint excludingTownId)
+        {
+            long total = 0;
+            foreach (var kvp in towns.OrderBy(k => k.Key))
+            {
+                if (kvp.Key == excludingTownId) continue;
+                lock (kvp.Value.SyncRoot)
+                {
+                    var backed = Math.Min(kvp.Value.Control.ClearinghouseReservePyreals, kvp.Value.Control.TreasuryPyreals);
+                    if (backed > 0)
+                        total += backed;
+                }
+            }
+            return total;
+        }
+
+        // Caller MUST hold _crossTownClearinghouseLock and NO TownRuntimeState.SyncRoot.
+        // Never mints pyreals when totalReserve <= 0, and only decrements ClearinghouseReservePyreals by transferable.
+        private static void SettleFromClearinghouseReserveExcludingTownLocked(
+            uint receivingTownId,
+            long needed,
+            out long settledFromOthers,
+            out long localCleared)
+        {
+            settledFromOthers = 0;
+            localCleared = 0;
+            if (needed <= 0) return;
+
+            var remaining = needed;
+
+            foreach (var kvp in towns.OrderBy(k => k.Key))
+            {
+                if (remaining <= 0) break;
+                if (kvp.Key == receivingTownId) continue;
+
+                var issuerState = kvp.Value;
+                TownControl issuerSnap = null;
+                lock (issuerState.SyncRoot)
+                {
+                    var availReserve = Math.Min(remaining, issuerState.Control.ClearinghouseReservePyreals);
+                    if (availReserve > 0)
+                    {
+                        var transferable = Math.Min(availReserve, issuerState.Control.TreasuryPyreals);
+                        if (transferable > 0)
+                        {
+                            issuerState.Control.ClearinghouseReservePyreals -= transferable;
+                            issuerState.Control.TreasuryPyreals -= transferable;
+                            issuerState.Control.UpdatedUtc = DateTime.UtcNow;
+                            settledFromOthers += transferable;
+                            remaining -= transferable;
+                            issuerSnap = CloneControl(issuerState.Control);
+                        }
+                    }
+                }
+                if (issuerSnap != null) PersistTownControl(issuerSnap);
+            }
+
+            if (remaining > 0 && towns.TryGetValue(receivingTownId, out var selfState))
+            {
+                TownControl selfSnap = null;
+                lock (selfState.SyncRoot)
+                {
+                    var localReserve = Math.Min(remaining, selfState.Control.ClearinghouseReservePyreals);
+                    var backedLocal = Math.Min(localReserve, selfState.Control.TreasuryPyreals);
+                    if (backedLocal > 0)
+                    {
+                        // Note was issued in this same town; its backing cash is already in selfState.TreasuryPyreals
+                        selfState.Control.ClearinghouseReservePyreals -= backedLocal;
+                        selfState.Control.UpdatedUtc = DateTime.UtcNow;
+                        localCleared = backedLocal;
+                        remaining -= backedLocal;
+                        selfSnap = CloneControl(selfState.Control);
+                    }
+                }
+                if (selfSnap != null) PersistTownControl(selfSnap);
+            }
+        }
+
+        // Caller MUST hold _crossTownClearinghouseLock and NO TownRuntimeState.SyncRoot.
+        // Only subtracts actual transferable pyreals from issuerState.ClearinghouseReservePyreals.
+        private static long SettleCrossTownRedemptionExcludingTownLocked(uint redeemingTownId, long needed)
+        {
+            if (needed <= 0) return 0;
+            long reimbursed = 0;
+            var remaining = needed;
+
+            foreach (var kvp in towns.OrderBy(k => k.Key))
+            {
+                if (remaining <= 0) break;
+                if (kvp.Key == redeemingTownId) continue;
+
+                var issuerState = kvp.Value;
+                TownControl issuerSnap = null;
+                lock (issuerState.SyncRoot)
+                {
+                    var availReserve = Math.Min(remaining, issuerState.Control.ClearinghouseReservePyreals);
+                    if (availReserve > 0)
+                    {
+                        var transferable = Math.Min(availReserve, issuerState.Control.TreasuryPyreals);
+                        if (transferable > 0)
+                        {
+                            issuerState.Control.ClearinghouseReservePyreals -= transferable;
+                            issuerState.Control.TreasuryPyreals -= transferable;
+                            issuerState.Control.UpdatedUtc = DateTime.UtcNow;
+                            reimbursed += transferable;
+                            remaining -= transferable;
+                            issuerSnap = CloneControl(issuerState.Control);
+                        }
+                    }
+                }
+                if (issuerSnap != null) PersistTownControl(issuerSnap);
+            }
+
+            return reimbursed;
+        }
