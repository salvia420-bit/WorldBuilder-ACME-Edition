+            service.VendorShopCreateListStackSize = -1;
+            archmage.DefaultItemsForSale[service.Guid] = service;
+
+            var portalDat = ACE.DatLoader.DatManager.PortalDat;
+            var fileCacheField = typeof(ACE.DatLoader.DatDatabase).GetField("<FileCache>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic);
