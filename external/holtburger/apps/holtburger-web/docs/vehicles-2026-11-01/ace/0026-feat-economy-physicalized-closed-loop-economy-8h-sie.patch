+    /// <summary>
+    /// Phase D (F14/F15) Authoritative Multimodal Navigation Graph for Dual-LOD Logistics.
+    /// Loads baked logistics_nav_graph.json (101 towns, 11 Outer Ocean ports, overland roads/spurs, Outer Ocean sea lanes).
+    /// Strictly excludes Item 2 (any non-Outer-Ocean sea basin or forbidden port landblocks 0x7A63 / 0x4866).
+    /// </summary>
+    public sealed class LogisticsNavGraph
+    {
+        public const string OuterOceanBasin = "outer_ocean";
+        private const uint ForbiddenPortLbA = 0x7A63u;
+        private const uint ForbiddenPortLbB = 0x4866u;
+        private const uint ForbiddenPortFullA = 0x7A630001u;
+        private const uint ForbiddenPortFullB = 0x48660001u;
