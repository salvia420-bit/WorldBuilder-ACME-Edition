+        [TestMethod]
+        public void F6_Rehydration_DerethAndDericost_IdempotentAndReflectsOwnerFlip()
+        {
+            // Set Holtburg (Dereth, ID 1) and Vasmora (Dericost, ID 61) owners
+            TownEconomyManager.SetTownOwner(1u, 100u, "CONTROLLED");
+            TownEconomyManager.SetTownOwner(61u, 200u, "CONTROLLED");
+
+            // 1. Direct EnsureTownEntitiesHydrated for Dereth & Dericost
+            var derethHydrated = SiegeManager.EnsureTownEntitiesHydrated(1u);
