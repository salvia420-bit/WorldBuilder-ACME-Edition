+            var anchor = new Position(0xA9B40001u, 96f, 96f, 10f, 0, 0, 0, 1);
+            var pod = DeployableManager.SpawnDeployable(4000010, anchor) as FluxPodDeployable;
+            var genset = DeployableManager.SpawnDeployable(4000086, anchor) as IndustrialGensetDeployable;
+            var bess = DeployableManager.SpawnDeployable(4000087, anchor) as IndustrialBessDeployable;
+            var adu = DeployableManager.SpawnDeployable(4000081, anchor) as IndustrySkidDeployable;
+            var smelter = DeployableManager.SpawnDeployable(4000083, anchor) as IndustrySkidDeployable;
+            var crusher = DeployableManager.SpawnDeployable(4000076, anchor) as IndustrySkidDeployable;
+
+            Assert.IsNotNull(pod);
+            Assert.IsNotNull(genset);
+            Assert.IsNotNull(bess);
+            Assert.IsNotNull(adu);
+            Assert.IsNotNull(smelter);
+            Assert.IsNotNull(crusher);
+
+            // ADU (60 kW) + Smelter (75 kW) + Crusher (45 kW) = 180 kW load vs 150 kW genset (-30 kW deficit)
+            // First charge BESS with surplus when crusher is stowed/inactive
+            crusher.IsActive = false;
+            DeployableManager.Tick(10.0); // +15 kW * 10s = +150 kJ charged
+            Assert.IsTrue(adu.IsPowered);
+            Assert.IsTrue(smelter.IsPowered);
+            Assert.IsTrue(bess.CapacitorJoules > 0f);
+            Assert.IsTrue(bess.CapacitorJoules <= 18_000_000f);
+
+            // Activate crusher -> 180 kW load > 150 kW gen, drains BESS until exhausted -> brownout!
+            crusher.IsActive = true;
+            for (int i = 0; i < 10; i++)
+                DeployableManager.Tick(2.0); // 30 kW deficit * 20s = 600 kJ > 150 kJ stored -> exhausted
+
+            Assert.IsTrue(bess.CapacitorJoules < 60_000f, "BESS must be below tick deficit at brownout");
+            Assert.IsFalse(adu.IsPowered, "ADU must brown out when load exceeds 150 kW genset and BESS cannot cover deficit");
+            Assert.IsFalse(IndustryManager.TryRunMiningExtraction(crusher, 10201, 10.0, out _, out var brownErr));
+            StringAssert.Contains(brownErr, "browned out");
+        }
