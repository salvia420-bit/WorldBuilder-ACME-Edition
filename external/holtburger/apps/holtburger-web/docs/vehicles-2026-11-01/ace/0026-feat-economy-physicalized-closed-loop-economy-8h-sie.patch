+        /// <summary>
+        /// Tier-1 Atmospheric Distillation Unit (ADU 4000081, 60 kW) assay-driven fractional cuts.
+        /// Light Sweet (>35° API, <50 bps S): 5% LPG, 36% Naphtha/Avgas, 18% Kerosene, 26% ULSD, 15% Atm. Residue.
+        /// Heavy Sour (<25° API, >150 bps S): 2% LPG, 14% Naphtha/Avgas, 9% Kerosene, 20% ULSD, 55% Atm. Residue.
+        /// </summary>
+        public static AduProductSlate RunAduDistillation(double crudeBarrels, float apiGravity, int sulfurBps)
+        {
+            if (!double.IsFinite(crudeBarrels) || crudeBarrels <= 0.0)
+                throw new ArgumentOutOfRangeException(nameof(crudeBarrels));
+
+            var crudeClass = GeologyService.ClassifyCrude("crude_oil", apiGravity, sulfurBps);
+            double sweetFactor;
+            if (apiGravity > 35.0f && sulfurBps < 50)
+                sweetFactor = 1.0;
+            else if (apiGravity < 25.0f && sulfurBps > 150)
+                sweetFactor = 0.0;
+            else
+            {
+                double apiNorm = Math.Clamp((apiGravity - 21.0) / (39.5 - 21.0), 0.0, 1.0);
+                double sulfurNorm = 1.0 - Math.Clamp((sulfurBps - 30.0) / 210.0, 0.0, 1.0);
+                sweetFactor = 0.65 * apiNorm + 0.35 * sulfurNorm;
+            }
+
+            double lpgFrac = 0.02 + (0.05 - 0.02) * sweetFactor;
+            double naphthaFrac = 0.14 + (0.36 - 0.14) * sweetFactor;
+            double keroFrac = 0.09 + (0.18 - 0.09) * sweetFactor;
+            double ulsdFrac = 0.20 + (0.26 - 0.20) * sweetFactor;
+            double resFrac = 1.0 - (lpgFrac + naphthaFrac + keroFrac + ulsdFrac);
+
+            return new AduProductSlate
+            {
+                InputCrudeBarrels = crudeBarrels,
+                ApiGravity = apiGravity,
+                SulfurBps = sulfurBps,
+                CrudeClass = crudeClass,
+                LpgUnits = crudeBarrels * lpgFrac,
+                NaphthaAvgasUnits = crudeBarrels * naphthaFrac,
+                KeroseneUnits = crudeBarrels * keroFrac,
+                UlsdDieselUnits = crudeBarrels * ulsdFrac,
+                AtmResidueUnits = crudeBarrels * resFrac,
+            };
+        }
+
+        /// <summary>
+        /// Tier-2 HDT/VDU & Dewaxer (4000082, 55 kW): cracks Atmospheric Residue into Paraffin Slack Wax
+        /// (for 13 Spell Tapers), Base Oils, Elemental Sulfur (for Contact Acid Works), Extra ULSD, and Bitumen.
+        /// </summary>
+        public static HdtVduProductSlate RunHdtVduCrack(double atmResidueUnits, float apiGravity, int sulfurBps)
+        {
+            if (!double.IsFinite(atmResidueUnits) || atmResidueUnits <= 0.0)
+                throw new ArgumentOutOfRangeException(nameof(atmResidueUnits));
+
+            double sulfurRatio = Math.Clamp(sulfurBps / 1000.0, 0.005, 0.20);
+            double waxFrac = apiGravity >= 30.0f ? 0.26 : 0.16;
+            double baseOilFrac = 0.22;
+            double extraUlsdFrac = 0.28;
+            double sulfurFrac = sulfurRatio;
+            double bitumenFrac = Math.Max(0.10, 1.0 - (waxFrac + baseOilFrac + extraUlsdFrac + sulfurFrac));
+
+            double norm = waxFrac + baseOilFrac + extraUlsdFrac + sulfurFrac + bitumenFrac;
+            return new HdtVduProductSlate
+            {
+                InputResidueUnits = atmResidueUnits,
+                ParaffinSlackWaxUnits = atmResidueUnits * (waxFrac / norm),
+                BaseOilUnits = atmResidueUnits * (baseOilFrac / norm),
+                ElementalSulfurUnits = atmResidueUnits * (sulfurFrac / norm),
+                ExtraUlsdUnits = atmResidueUnits * (extraUlsdFrac / norm),
+                BitumenUnits = atmResidueUnits * (bitumenFrac / norm),
+            };
+        }
