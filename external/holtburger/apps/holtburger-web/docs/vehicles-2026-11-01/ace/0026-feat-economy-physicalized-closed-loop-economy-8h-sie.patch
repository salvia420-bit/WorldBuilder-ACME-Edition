+        private static void EnterContestedHoldLocked(
+            TownRuntimeState state,
+            uint attackerMonarchId,
+            DateTime now,
+            out string alertTitle,
+            out string alertBody)
+        {
+            TownEconomyManager.FreezeSpendableTreasuryToEscrowLocked(state);
+            state.Control.State = "CONTESTED_HOLD";
+            state.Control.AttackerMonarchId = attackerMonarchId;
+            state.Control.HoldElapsedSec = 0;
+            state.HoldElapsedSecExact = 0.0;
+            state.SupplyMeterSecExact = SupplyMeterMaxSec;
+            state.Control.SupplyMeterSec = (int)SupplyMeterMaxSec;
+            state.StarvingSecExact = 0.0;
+            state.Control.StarvingSec = 0;
+            state.BreachMonarchId = 0;
+            state.BreachElapsedSec = 0.0;
+            state.DefenderHoldElapsedSec = 0.0;
+            state.ThreeWayCandidateMonarchId = 0;
+            state.ThreeWayHoldElapsedSec = 0.0;
+            state.SupplyLowAlertSent = false;
+            state.Control.UpdatedUtc = now;
+
+            state.AlertCount++;
+            alertTitle = "siege_started";
+            alertBody = $"ZERO-NOTICE SIEGE BREACH at {state.Control.Name}! Attacker Monarch {attackerMonarchId} holds the Town Control Node. Treasury frozen in escrow ({state.Control.EscrowPyreals:N0}p).";
+            state.LastAlertMessage = alertBody;
+        }
+
+        private static void CollapseStarvingSiegeLocked(
+            TownRuntimeState state,
+            DateTime now,
+            out string alertTitle,
+            out string alertBody)
+        {
+            var failedAttacker = state.Control.AttackerMonarchId;
+            TownEconomyManager.RestoreEscrowToTreasuryLocked(state);
+            state.Control.State = "CONTROLLED";
+            state.Control.AttackerMonarchId = 0;
+            state.Control.HoldElapsedSec = 0;
+            state.Control.SupplyMeterSec = 0;
+            state.Control.StarvingSec = 0;
+            state.HoldElapsedSecExact = 0.0;
+            state.SupplyMeterSecExact = 0.0;
+            state.StarvingSecExact = 0.0;
+            state.ApronSupplySp = 0.0;
+            state.DefenderHoldElapsedSec = 0.0;
+            state.ThreeWayCandidateMonarchId = 0;
+            state.ThreeWayHoldElapsedSec = 0.0;
+            state.CooldownMonarchId = failedAttacker;
+            state.CooldownRemainingSec = StarvationCooldownSec;
+            state.Control.CooldownUntilUtc = now.AddSeconds(StarvationCooldownSec);
+            state.SupplyLowAlertSent = false;
+
+            state.AlertCount++;
+            alertTitle = "siege_collapsed";
+            alertBody = $"Siege at {state.Control.Name} collapsed due to 30m supply starvation! Monarch {failedAttacker} on 1h cooldown.";
+            state.LastAlertMessage = alertBody;
+        }
