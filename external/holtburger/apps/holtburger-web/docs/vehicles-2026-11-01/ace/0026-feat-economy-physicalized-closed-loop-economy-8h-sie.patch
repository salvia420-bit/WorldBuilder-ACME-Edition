+            // Advance 10 hours (36,000 s) in accelerated steps:
+            // Powered Reefers freeze at 100%; ambient pack item spoils & deletes!
+            for (int i = 0; i < 20; i++)
+            {
+                reefer22R1.Tick(1800.0);
