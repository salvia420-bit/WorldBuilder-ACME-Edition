+-- Phase A: Physical Closed-Loop Economy & 101-Town Control Tables (MariaDB utf8mb4_general_ci)
+
+CREATE TABLE IF NOT EXISTS `town_control` (
+  `town_id` INT UNSIGNED NOT NULL,
+  `continent` VARCHAR(16) NOT NULL,
+  `name` VARCHAR(64) NOT NULL,
+  `anchor_landblock` INT UNSIGNED NOT NULL,
+  `state` VARCHAR(32) NOT NULL DEFAULT 'UNCLAIMED_COLD',
+  `owner_monarch_id` INT UNSIGNED NOT NULL DEFAULT 0,
+  `attacker_monarch_id` INT UNSIGNED NOT NULL DEFAULT 0,
+  `hold_elapsed_sec` INT NOT NULL DEFAULT 0,
+  `supply_meter_sec` INT NOT NULL DEFAULT 0,
+  `starving_sec` INT NOT NULL DEFAULT 0,
+  `treasury_pyreals` BIGINT NOT NULL DEFAULT 0,
+  `escrow_pyreals` BIGINT NOT NULL DEFAULT 0,
+  `clearinghouse_reserve_pyreals` BIGINT NOT NULL DEFAULT 0,
+  `tariff_buy_mul` FLOAT NOT NULL DEFAULT 1.0,
+  `tariff_sell_mul` FLOAT NOT NULL DEFAULT 1.0,
+  `last_delivery_utc` DATETIME NULL DEFAULT NULL,
+  `cooldown_until_utc` DATETIME NULL DEFAULT NULL,
+  `updated_utc` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+  PRIMARY KEY (`town_id`),
+  KEY `idx_town_control_owner` (`owner_monarch_id`),
+  KEY `idx_town_control_state` (`state`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
+
+CREATE TABLE IF NOT EXISTS `town_vendor_ledger` (
+  `town_id` INT UNSIGNED NOT NULL,
+  `vendor_guid` INT UNSIGNED NOT NULL,
+  `item_wcid` INT UNSIGNED NOT NULL,
+  `stock_qty` INT NOT NULL DEFAULT 0,
+  `till_pyreals` BIGINT NOT NULL DEFAULT 0,
+  `till_cap_pyreals` BIGINT NOT NULL DEFAULT 0,
+  `unit_price_override` INT NULL DEFAULT NULL,
+  PRIMARY KEY (`town_id`, `vendor_guid`, `item_wcid`),
+  KEY `idx_tvl_vendor` (`vendor_guid`),
+  CONSTRAINT `fk_tvl_town` FOREIGN KEY (`town_id`) REFERENCES `town_control` (`town_id`) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
+
+CREATE TABLE IF NOT EXISTS `town_warehouse_stock` (
+  `town_id` INT UNSIGNED NOT NULL,
+  `commodity_id` VARCHAR(64) NOT NULL,
+  `grade_bps` INT NOT NULL DEFAULT 10000,
+  `qty` INT NOT NULL DEFAULT 0,
+  `freshness_pct` FLOAT NOT NULL DEFAULT 100.0,
+  `powered_reefer` BIT(1) NOT NULL DEFAULT b'0',
+  PRIMARY KEY (`town_id`, `commodity_id`, `grade_bps`, `powered_reefer`),
+  KEY `idx_tws_commodity` (`commodity_id`),
+  CONSTRAINT `fk_tws_town` FOREIGN KEY (`town_id`) REFERENCES `town_control` (`town_id`) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
