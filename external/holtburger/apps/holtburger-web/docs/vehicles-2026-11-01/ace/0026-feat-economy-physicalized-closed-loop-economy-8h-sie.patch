+        /// <summary>
+        /// Converts repeatable Trophy Collectors into Monarch-funded Town Procurement Desks.
+        /// Pays from spendable Town Treasury Till (preserving ClearinghouseReservePyreals) and deposits
+        /// exactly the turned-in unit count (default 1, never full stack) into town_warehouse_stock.
+        /// </summary>
+        public static bool TryHandleTrophyTurnIn(
+            WorldObject npc,
+            WorldObject itemToGive,
+            out long payoutPyreals,
+            out string feedback,
+            int turnedInCount = 1)
+            => TryHandleTrophyTurnInForPlayer(npc, itemToGive, 0u, out payoutPyreals, out feedback, turnedInCount);
+
+        public static bool TryHandleTrophyTurnInForPlayer(
+            WorldObject npc,
+            WorldObject itemToGive,
+            uint claimedByGuid,
+            out long payoutPyreals,
+            out string feedback,
+            int turnedInCount = 1)
+        {
+            EnsureInitialized();
+            payoutPyreals = 0;
+
+            if (npc == null || itemToGive == null)
+            {
+                feedback = "Invalid procurement turn-in.";
+                return false;
+            }
+
+            var townId = ResolveTownId(npc);
+            if (townId == 0)
+            {
+                feedback = $"{npc.Name} is outside any town's procurement desk and cannot mint pyreals.";
+                return false;
+            }
+
+            var state = GetTownState(townId);
+            if (state == null)
+            {
+                feedback = "Town procurement desk unavailable.";
+                return false;
+            }
+
+            var acceptedQty = Math.Clamp(turnedInCount, 1, 1);
+            TownControl ctrlSnap;
+            TownWarehouseStock whSnap;
+            MonarchOrder orderSnap = null;
+            var now = DateTime.UtcNow;
+
+            lock (state.SyncRoot)
+            {
+                if (state.Control.State is "CONTESTED_HOLD" or "STARVING")
+                {
+                    feedback = $"Town procurement desk in {state.Control.Name} is frozen while under siege.";
+                    return false;
+                }
+                if (!state.Bounties.TryGetValue(itemToGive.WeenieClassId, out var bounty) || bounty.RemainingQty <= 0)
+                {
+                    feedback = $"{npc.Name} has no active Monarch procurement bounty for {itemToGive.Name}.";
+                    return false;
+                }
+
+                var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+                if (spendable <= 0 || spendable < bounty.RewardPyreals)
+                {
+                    feedback = $"Town procurement desk in {state.Control.Name} lacks Treasury funds ({bounty.RewardPyreals:N0}p needed).";
+                    return false;
+                }
+
+                state.Control.TreasuryPyreals -= bounty.RewardPyreals;
+                state.Control.UpdatedUtc = now;
+                bounty.RemainingQty = Math.Max(0, bounty.RemainingQty - 1);
+                payoutPyreals = bounty.RewardPyreals;
+
+                if (bounty.OrderId != 0)
+                {
+                    orderSnap = new MonarchOrder
+                    {
+                        OrderId = bounty.OrderId,
+                        MonarchId = bounty.MonarchId != 0 ? bounty.MonarchId : state.Control.OwnerMonarchId,
+                        TownId = townId,
+                        OrderType = "ProcurementBounty",
+                        ItemWcid = bounty.ItemWcid,
+                        CommodityId = bounty.CommodityId,
+                        TargetQty = Math.Max(bounty.TargetQty, bounty.RemainingQty + 1),
+                        RemainingQty = bounty.RemainingQty,
+                        RewardPyreals = Math.Max(0L, bounty.RewardPyreals),
+                        ClaimedByGuid = claimedByGuid != 0 ? claimedByGuid : npc.Guid.Full,
+                        Status = bounty.RemainingQty <= 0 ? "Fulfilled" : "Open",
+                        CreatedUtc = bounty.CreatedUtc,
+                        UpdatedUtc = now,
+                    };
+                    monarchOrders[orderSnap.OrderId] = CloneMonarchOrder(orderSnap);
+                }
+
+                if (bounty.RemainingQty <= 0)
+                    state.Bounties.Remove(itemToGive.WeenieClassId);
+
+                var key = (bounty.CommodityId, 10000, false);
+                if (!state.Warehouses.TryGetValue(key, out var wh))
+                {
+                    wh = new TownWarehouseStock
+                    {
+                        TownId = townId,
+                        CommodityId = bounty.CommodityId,
+                        GradeBps = 10000,
+                        Qty = 0,
+                        FreshnessPct = 100.0f,
+                        PoweredReefer = false,
+                    };
+                    state.Warehouses[key] = wh;
+                }
+                wh.Qty += acceptedQty;
+
+                ctrlSnap = CloneControl(state.Control);
+                whSnap = CloneWarehouse(wh);
+                feedback = $"{npc.Name} accepts {itemToGive.Name} into {state.Control.Name}'s warehouse and pays {payoutPyreals:N0} pyreals from the Town Till.";
+            }
+
+            PersistTownControl(ctrlSnap);
+            PersistWarehouseStock(whSnap);
+            if (orderSnap != null)
+                PersistMonarchOrder(orderSnap);
+            return true;
+        }
