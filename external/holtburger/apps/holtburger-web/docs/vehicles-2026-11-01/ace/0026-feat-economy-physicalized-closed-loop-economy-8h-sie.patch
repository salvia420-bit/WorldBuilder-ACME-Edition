+
+        public string SampleSegmentAtDistance(double splineSM, out bool isSeaSegment)
+        {
+            isSeaSegment = false;
+            if (Waypoints == null || Waypoints.Count == 0)
+                return "";
+            if (Waypoints.Count == 1)
+            {
+                var m = Waypoints[0].Mode ?? "";
+                isSeaSegment = string.Equals(m, "sea", StringComparison.OrdinalIgnoreCase);
+                return m;
+            }
+
+            double clampedS = Math.Clamp(double.IsFinite(splineSM) ? splineSM : 0.0, 0.0, TotalLengthM);
+            for (int i = 1; i < Waypoints.Count; i++)
+            {
+                var b = Waypoints[i];
+                if (clampedS < b.CumulativeDistanceM || i == Waypoints.Count - 1)
+                {
+                    var m = b.Mode ?? "";
+                    isSeaSegment = string.Equals(m, "sea", StringComparison.OrdinalIgnoreCase);
+                    return m;
+                }
+            }
+
+            var lastMode = Waypoints[^1].Mode ?? "";
+            isSeaSegment = string.Equals(lastMode, "sea", StringComparison.OrdinalIgnoreCase);
+            return lastMode;
+        }
+
+        public double GetDistanceToNextModeBoundary(double splineSM, out bool isSeaSegment)
+            => GetDistanceToNextModeBoundary(splineSM, out isSeaSegment, out _);
+
+        public double GetDistanceToNextModeBoundary(double splineSM, out bool isSeaSegment, out bool hasUpcomingBoundary)
+        {
+            isSeaSegment = false;
+            hasUpcomingBoundary = false;
+            if (Waypoints == null || Waypoints.Count == 0)
+                return 0.0;
+            if (Waypoints.Count == 1)
+            {
+                isSeaSegment = string.Equals(Waypoints[0].Mode, "sea", StringComparison.OrdinalIgnoreCase);
+                return 0.0;
+            }
+
+            double clampedS = Math.Clamp(double.IsFinite(splineSM) ? splineSM : 0.0, 0.0, TotalLengthM);
+            int idx = Waypoints.Count - 1;
+            for (int i = 1; i < Waypoints.Count; i++)
+            {
+                if (clampedS < Waypoints[i].CumulativeDistanceM || i == Waypoints.Count - 1)
+                {
+                    idx = i;
+                    break;
+                }
+            }
+
+            isSeaSegment = string.Equals(Waypoints[idx].Mode, "sea", StringComparison.OrdinalIgnoreCase);
+            int endIdx = idx;
+            while (endIdx + 1 < Waypoints.Count &&
+                   string.Equals(Waypoints[endIdx + 1].Mode, "sea", StringComparison.OrdinalIgnoreCase) == isSeaSegment)
+            {
+                endIdx++;
+            }
+
+            hasUpcomingBoundary = endIdx + 1 < Waypoints.Count;
+            return Math.Max(0.0, Waypoints[endIdx].CumulativeDistanceM - clampedS);
+        }
