+        public static double ComputeDistanceFromOriginToTownM(uint originLandblockId, uint townId)
+        {
+            if (originLandblockId == 0)
+                return 0.0;
+
+            bool isPacked32Bit = originLandblockId > 0xFFFFu ||
+                originLandblockId == 0x00000001u ||
+                originLandblockId == 0x00008001u;
+            return ComputeDistanceFromOriginToTownM(originLandblockId, townId, isPacked32Bit);
