+        private static (int Status, object Payload) ExecuteGeologySurveyPost(JsonElement body)
+        {
+            var actor = ResolveActor(body);
+            if (actor == null)
+                return (403, new { error = "Physical online player actor required for geophysical prospecting." });
+
+            var reqMsg = new IndustryProspecting
+            {
+                ToolGuid = GetJsonUInt(body, "toolGuid"),
+                ToolKind = GetJsonUInt(body, "toolKind"),
