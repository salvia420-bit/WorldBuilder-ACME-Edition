+        public static byte ClassifyResourceKind(string resourceType, float apiGravity, int sulfurBps)
+        {
+            if (string.IsNullOrWhiteSpace(resourceType))
+                return (byte)DepositResourceKind.Unknown;
+
+            var rt = resourceType.Trim().ToLowerInvariant();
+            if (rt.Contains("oil") || rt.Contains("crude"))
+            {
+                if (apiGravity > 35.0f && sulfurBps < 50)
+                    return (byte)DepositResourceKind.LightSweetCrude;
+                if (apiGravity < 25.0f && sulfurBps > 150)
+                    return (byte)DepositResourceKind.HeavySourCrude;
+                return (byte)DepositResourceKind.IntermediateCrude;
+            }
+            if (rt.Contains("pyreal")) return (byte)DepositResourceKind.PyrealOre;
+            if (rt.Contains("iron") || rt.Contains("copper") || rt.Contains("sulfide")) return (byte)DepositResourceKind.IronCopperSulfide;
+            if (rt.Contains("coal") || rt.Contains("limestone") || rt.Contains("silica")) return (byte)DepositResourceKind.CokingCoalLimestone;
+            if (rt.Contains("silver") || rt.Contains("platinum") || rt.Contains("crystal")) return (byte)DepositResourceKind.PreciousMetals;
+            if (rt.Contains("gas") || rt.Contains("sulfur")) return (byte)DepositResourceKind.SulfurSilicaGas;
+            if (rt.Contains("kaolin") || rt.Contains("peat") || rt.Contains("brine")) return (byte)DepositResourceKind.KaolinPeatBrine;
+            if (rt.Contains("rare_earth")) return (byte)DepositResourceKind.RareEarthOre;
+            return (byte)DepositResourceKind.Unknown;
+        }
+
+        public static CrudeAssayClass ClassifyCrude(string resourceType, float apiGravity, int sulfurBps)
+        {
+            if (string.IsNullOrWhiteSpace(resourceType))
+                return CrudeAssayClass.None;
+            var rt = resourceType.ToLowerInvariant();
+            if (!rt.Contains("oil") && !rt.Contains("crude"))
+                return CrudeAssayClass.None;
+            if (apiGravity > 35.0f && sulfurBps < 50)
+                return CrudeAssayClass.LightSweet;
+            if (apiGravity < 25.0f && sulfurBps > 150)
+                return CrudeAssayClass.HeavySour;
+            return CrudeAssayClass.Intermediate;
+        }
+
+        /// <summary>Stage 1: Regional Mag-Grav Recon on 192 m landblock grid.</summary>
+        public static MagGravReconResult RunMagGravRecon(uint landblockId, byte terrainCode)
+        {
+            EnsureInitialized();
+            var basin = GetBasinForTerrain(landblockId, terrainCode);
+            var dep = FindNearestDeposit(landblockId);
+            if (dep == null)
+            {
+                return new MagGravReconResult
+                {
+                    AnomalyDetected = false,
+                    BasinId = basin.BasinId,
+                    LandblockId = landblockId,
+                    Message = $"No regional subsurface anomaly detected in {basin.Name}.",
+                };
+            }
+
+            bool isOil = dep.ResourceType.Contains("oil", StringComparison.OrdinalIgnoreCase) ||
+                         dep.ResourceType.Contains("crude", StringComparison.OrdinalIgnoreCase);
+            bool isMagnetic = dep.ResourceType.Contains("pyreal", StringComparison.OrdinalIgnoreCase) ||
+                              dep.ResourceType.Contains("iron", StringComparison.OrdinalIgnoreCase);
+
+            float mGal = isOil ? -6.4f : +8.2f;
+            float sus = isMagnetic ? 0.085f : 0.004f;
+
+            return new MagGravReconResult
+            {
+                AnomalyDetected = true,
+                BasinId = basin.BasinId,
+                LandblockId = landblockId,
+                GravityAnomalyMGal = mGal,
+                MagneticSusceptibilitySi = sus,
+                Message = $"[Mag-Grav 192m] {basin.Name}: {mGal:+0.0;-0.0} mGal, {sus:0.000} SI anomaly ({dep.ResourceType} signature).",
+            };
+        }
+
+        /// <summary>Stage 2: Shallow GPR (1-35 m). Physically attenuates in wet clay/saline marshes.</summary>
+        public static GprScanResult RunGprScan(uint landblockId, byte terrainCode)
+        {
+            EnsureInitialized();
+            var basin = GetBasinForTerrain(landblockId, terrainCode);
+            bool attenuated = IsWetMarshAttenuated(landblockId, terrainCode);
+            if (attenuated)
+            {
+                return new GprScanResult
+                {
+                    IsAttenuated = true,
+                    AnomalyDetected = false,
+                    DepositId = 0,
+                    BasinId = basin.BasinId,
+                    DepthM = 0f,
+                    ResourceType = "",
+                    ResourceKind = 0,
+                    Message = $"[GPR] EM signal attenuated by conductive wet marsh/water in {basin.Name} (terrain {terrainCode}). Deploy Vibroseis Seismic (4000071).",
+                };
+            }
+
+            var shallow = FindNearestDeposit(landblockId, shallowOnly: true);
+            if (shallow == null || shallow.RemainingTonnes <= 0f)
+            {
+                return new GprScanResult
+                {
+                    IsAttenuated = false,
+                    AnomalyDetected = false,
+                    DepositId = 0,
+                    BasinId = basin.BasinId,
+                    DepthM = 0f,
+                    ResourceType = "",
+                    ResourceKind = 0,
+                    Message = $"[GPR] No shallow (<= 35m) anomaly in {basin.Name}. Deeper traps require Vibroseis Seismic (4000071).",
+                };
+            }
+
+            return new GprScanResult
+            {
+                IsAttenuated = false,
+                AnomalyDetected = true,
+                DepositId = shallow.DepositId,
+                BasinId = shallow.BasinId,
+                DepthM = shallow.DepthM,
+                ResourceType = shallow.ResourceType,
+                ResourceKind = ClassifyResourceKind(shallow.ResourceType, shallow.ApiGravity, shallow.SulfurBps),
+                Message = $"[GPR] Shallow anomaly #{shallow.DepositId} at {shallow.DepthM:0.0}m ({shallow.ResourceType}) in {basin.Name}. Core drilling required to prove reserves.",
+            };
+        }
+
+        /// <summary>Stage 3: Active Vibroseis Seismic (100-2,500 m). Penetrates wet marshes reliably.</summary>
+        public static VibroseisScanResult RunVibroseisScan(uint landblockId, byte terrainCode)
+        {
+            EnsureInitialized();
+            var basin = GetBasinForTerrain(landblockId, terrainCode);
+            var dep = FindNearestDeposit(landblockId, shallowOnly: false);
+            if (dep == null)
+            {
+                return new VibroseisScanResult
+                {
+                    Succeeded = true,
+                    AnomalyDetected = false,
+                    BasinId = basin.BasinId,
+                    Message = $"[Vibroseis] Clean 10-120 Hz sweep in {basin.Name}; no structural trap detected.",
+                };
+            }
+
+            return new VibroseisScanResult
+            {
+                Succeeded = true,
+                AnomalyDetected = true,
+                DepositId = dep.DepositId,
+                BasinId = dep.BasinId,
+                DepthM = dep.DepthM,
+                ResourceType = dep.ResourceType,
+                ResourceKind = ClassifyResourceKind(dep.ResourceType, dep.ApiGravity, dep.SulfurBps),
+                CoredFlag = dep.CoredFlag,
+                Message = $"[Vibroseis] Structural trap #{dep.DepositId} imaged at {dep.DepthM:0.0}m ({dep.ResourceType}) in {basin.Name}. Cored={dep.CoredFlag}.",
+            };
+        }
+
+        /// <summary>Stage 4a: Diamond Core Drilling Rig sets cored_flag = true and recovers physical core sample.</summary>
+        public static bool TryDrillCore(ulong depositId, out CoreSampleData sample, out string error)
+        {
+            EnsureInitialized();
+            sample = null;
+            error = null;
+
+            if (!deposits.TryGetValue(depositId, out var dep))
+            {
+                error = $"Subsurface deposit {depositId} not found.";
+                return false;
+            }
+
+            SubsurfaceDeposit snap;
+            var gate = depositLocks.GetOrAdd(depositId, _ => new object());
+            lock (gate)
+            {
+                if (dep.RemainingTonnes <= 0f)
+                {
+                    error = $"Deposit {depositId} is depleted (remaining_tonnes = 0).";
+                    return false;
+                }
+                dep.CoredFlag = true;
+                dep.UpdatedUtc = DateTime.UtcNow;
+                snap = CloneDeposit(dep);
+            }
+
+            PersistDeposit(snap);
+            sample = new CoreSampleData
+            {
+                DepositId = snap.DepositId,
+                BasinId = snap.BasinId,
+                LandblockId = snap.LandblockId,
+                DepthM = snap.DepthM,
+                ResourceType = snap.ResourceType,
+                ResourceKind = ClassifyResourceKind(snap.ResourceType, snap.ApiGravity, snap.SulfurBps),
+                CoredFlag = true,
+            };
+            return true;
+        }
+
+        public static bool TryDrillCoreAtLandblock(uint landblockId, out CoreSampleData sample, out string error)
+        {
+            var dep = FindNearestDeposit(landblockId);
+            if (dep == null)
+            {
+                sample = null;
+                error = "No subsurface deposit located near landblock.";
+                return false;
+            }
+            return TryDrillCore(dep.DepositId, out sample, out error);
+        }
+
+        /// <summary>Stage 4b: Mobile Assay Lab proves grade, tonnage, °API gravity, and sulfur wt%.</summary>
+        public static bool RunMobileAssay(ulong depositId, out AssayReport report, out string error)
+        {
+            EnsureInitialized();
+            report = null;
+            error = null;
+
+            if (!deposits.TryGetValue(depositId, out var dep))
+            {
+                error = $"Deposit {depositId} not found.";
+                return false;
+            }
+
+            SubsurfaceDeposit snap;
+            var gate = depositLocks.GetOrAdd(depositId, _ => new object());
+            lock (gate)
+            {
+                if (!dep.CoredFlag)
+                {
+                    error = $"Deposit {depositId} has not been diamond-cored yet (cored_flag = false).";
+                    return false;
+                }
+                snap = CloneDeposit(dep);
+            }
+
+            report = new AssayReport
+            {
+                DepositId = snap.DepositId,
+                BasinId = snap.BasinId,
+                ResourceType = snap.ResourceType,
+                ResourceKind = ClassifyResourceKind(snap.ResourceType, snap.ApiGravity, snap.SulfurBps),
+                GradeBps = snap.GradeBps,
+                ApiGravity = snap.ApiGravity,
+                SulfurBps = snap.SulfurBps,
+                RemainingTonnes = snap.RemainingTonnes,
+                CrudeClass = ClassifyCrude(snap.ResourceType, snap.ApiGravity, snap.SulfurBps),
+            };
+            return true;
+        }
+
+        public static bool TryExtractFromDepositForTesting(ulong depositId, double tonnes)
+            => TryExtractTonnes(depositId, tonnes, requireCored: false, out _, out _);
+
+        public static bool TryExtractTonnes(ulong depositId, double tonnes, out double extractedTonnes, out string error)
+            => TryExtractTonnes(depositId, tonnes, requireCored: true, out extractedTonnes, out error);
+
+        public static bool TryExtractTonnes(ulong depositId, double tonnes, bool requireCored, out double extractedTonnes, out string error)
+        {
+            EnsureInitialized();
+            extractedTonnes = 0.0;
+            error = null;
+
+            if (depositId == 0 || !double.IsFinite(tonnes) || tonnes <= 0.0)
+            {
+                error = "Invalid deposit ID or extraction tonnage.";
+                return false;
+            }
+
+            if (!deposits.TryGetValue(depositId, out var dep))
+            {
+                error = $"Subsurface deposit {depositId} does not exist.";
+                return false;
+            }
+
+            SubsurfaceDeposit snap;
+            var gate = depositLocks.GetOrAdd(depositId, _ => new object());
+            lock (gate)
+            {
+                if (requireCored && !dep.CoredFlag)
+                {
+                    error = $"Deposit {depositId} must be diamond-cored before commercial extraction.";
+                    return false;
+                }
+
+                if (dep.RemainingTonnes <= 0.0f)
+                {
+                    error = $"Deposit {depositId} is depleted (remaining_tonnes <= 0).";
+                    return false;
+                }
+
+                double actual = Math.Min(tonnes, dep.RemainingTonnes);
+                dep.RemainingTonnes = (float)Math.Max(0.0, dep.RemainingTonnes - actual);
+                dep.UpdatedUtc = DateTime.UtcNow;
+                extractedTonnes = actual;
+                snap = CloneDeposit(dep);
+            }
+
+            PersistDeposit(snap);
+            return true;
+        }
+
+        public static void SetDepositForTesting(SubsurfaceDeposit custom)
+        {
+            if (custom == null || custom.DepositId == 0 || custom.DepositId > MaxSafeDepositId)
+                return;
+            EnsureInitialized();
+            custom.GradeBps = Math.Clamp(custom.GradeBps, 0, 10000);
+            custom.RemainingTonnes = Math.Max(0.0f, custom.RemainingTonnes);
+            deposits[custom.DepositId] = CloneDeposit(custom);
+        }
+
+        public static byte ResolveTerrainCodeAt(Position pos)
+        {
+            if (pos == null) return 0;
+            try
+            {
+                var (gx, gy, _) = Vehicle.ToGlobal(pos);
+                uint continent = pos.LandblockId.Continent;
+                int lbX = pos.LandblockId.LandblockX;
+                int lbY = pos.LandblockId.LandblockY;
+                var grid = VehicleTerrain.GetGrid(lbX, lbY, continent);
+                if (grid?.Terrain != null && grid.Terrain.Length >= 81)
+                {
+                    int cx = Math.Clamp((int)Math.Round(pos.PositionX / 24.0f), 0, 8);
+                    int cy = Math.Clamp((int)Math.Round(pos.PositionY / 24.0f), 0, 8);
+                    var t = grid.Terrain[cx * 9 + cy];
+                    return (byte)((t >> 2) & 0x1F);
+                }
+            }
+            catch
+            {
+                // Fallback for unit-test environments without loaded DAT files
+            }
+            return 0;
+        }
+
+        public static IndustrySurveyResultMsg HandleProspectingRequest(Player player, IndustryProspecting msg, out string error)
+        {
+            EnsureInitialized();
+            error = null;
+            if (player == null || msg == null)
+            {
+                error = "Invalid prospecting request.";
+                return null;
+            }
+            if (player.Location == null || player.Location.Indoors)
+            {
+                error = "Geophysical prospecting requires an outdoor surface position.";
+                return null;
+            }
+
+            Position targetPos;
+            if (msg.Cell != 0)
+            {
+                var targetLb = new LandblockId(msg.Cell);
+                var playerLb = player.Location.LandblockId;
+                if (targetLb.Indoors)
+                {
+                    error = "Geophysical prospecting requires an outdoor surface cell.";
+                    return null;
+                }
+                if (targetLb.Continent != playerLb.Continent ||
+                    Math.Abs(targetLb.LandblockX - playerLb.LandblockX) > 1 ||
+                    Math.Abs(targetLb.LandblockY - playerLb.LandblockY) > 1)
+                {
+                    error = "Target prospecting cell is out of range of your position.";
+                    return null;
+                }
+
+                if (msg.Position != Vector3.Zero)
+                {
+                    targetPos = new Position(
+                        msg.Cell,
+                        Math.Clamp(msg.Position.X, 0f, 191.999f),
+                        Math.Clamp(msg.Position.Y, 0f, 191.999f),
+                        msg.Position.Z,
+                        0, 0, 0, 1);
+                }
+                else if (targetLb == playerLb)
+                {
+                    targetPos = player.Location;
+                }
+                else
+                {
+                    targetPos = new Position(msg.Cell, 96f, 96f, 0f, 0, 0, 0, 1);
+                }
+            }
+            else
+            {
+                targetPos = player.Location;
+            }
+
+            uint lbId = targetPos.LandblockId.Raw;
+            byte terrainCode = ResolveTerrainCodeAt(targetPos);
+
+            DeployableKind toolKind;
+            ProspectingDeployable prospectingTool = null;
+            if (msg.ToolGuid == 0)
+            {
+                if (msg.Mode != 0)
+                {
+                    error = "A deployed, powered prospecting unit is required for GPR, Vibroseis, Core Drill, and Assay Lab.";
+                    return null;
+                }
+                if (msg.ToolKind != 0 && msg.ToolKind != (uint)DeployableKind.VibroseisSeismic)
+                {
+                    error = "Tool-free Mag-Grav recon cannot override ToolKind.";
+                    return null;
+                }
+                toolKind = DeployableKind.VibroseisSeismic;
+            }
+            else
+            {
+                var tool = DeployableManager.GetDeployable(msg.ToolGuid);
+                if (tool is not ProspectingDeployable pd || tool.IsDestroyed || tool.IsPacked || tool.IsStowed)
+                {
+                    error = "Prospecting unit is unavailable or stowed.";
+                    return null;
+                }
+                if (tool.Location == null)
+                {
+                    error = "Prospecting unit has no world location.";
+                    return null;
+                }
+                var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                var dist = Vector3.Distance(new Vector3((float)px, (float)py, (float)pz), tool.GlobalPosition);
+                if (dist > 15.0f)
+                {
+                    error = "Move within 15 m of the prospecting unit.";
+                    return null;
+                }
+                if (IndustryManager.GetPowerSpecWatts(tool.Wcid) > 0f && !tool.IsPowered)
+                {
+                    error = $"{tool.Name} requires an active powered MicroGrid.";
+                    return null;
+                }
+                if (msg.ToolKind != 0 && msg.ToolKind != (uint)tool.Kind)
+                {
+                    error = $"ToolKind mismatch: deployed unit is {tool.Kind}, not {(DeployableKind)msg.ToolKind}.";
+                    return null;
+                }
+                prospectingTool = pd;
+                toolKind = tool.Kind;
+            }
+
+            byte flags = 0;
+            ulong depositId = 0;
+            byte resourceKind = 0;
+            float depthM = 0f;
+            uint gradeBps = 0;
+            float apiGravity = 0f;
+            uint sulfurBps = 0;
+            float remainingTonnes = 0f;
+
+            // Route strictly by authoritative toolKind + protocol Mode (vehicles.protocol.xml:485-486:
+            // ToolKind: 38=GprScanner, 39=VibroseisSeismic, 40=DiamondCoreDrill, 41=MobileAssayLab;
+            // Mode: 0=MagGravRecon (Vibroseis/recon), 1=Scan, 2=Drill, 3=Assay)
+            switch (toolKind)
+            {
+                case DeployableKind.GprScanner:
+                {
+                    if (msg.Mode != 1)
+                    {
+                        error = "GPR Scanner requires Mode=1 (Scan).";
+                        return null;
+                    }
+                    var gpr = RunGprScan(lbId, terrainCode);
+                    if (gpr.IsAttenuated) flags |= 0x01;
+                    if (gpr.AnomalyDetected) flags |= 0x02;
+                    depositId = gpr.DepositId;
+                    resourceKind = gpr.ResourceKind;
+                    depthM = gpr.DepthM;
+                    break;
+                }
+                case DeployableKind.VibroseisSeismic:
+                {
+                    if (msg.Mode == 0)
+                    {
+                        var recon = RunMagGravRecon(lbId, terrainCode);
+                        if (recon.AnomalyDetected) flags |= 0x02;
+                        var dep = FindNearestDeposit(lbId);
+                        if (dep != null)
+                        {
+                            depositId = dep.DepositId;
+                            resourceKind = ClassifyResourceKind(dep.ResourceType, dep.ApiGravity, dep.SulfurBps);
+                            depthM = dep.DepthM;
+                        }
+                    }
+                    else if (msg.Mode == 1)
+                    {
+                        var seis = RunVibroseisScan(lbId, terrainCode);
+                        if (seis.AnomalyDetected) flags |= 0x02;
+                        if (seis.CoredFlag) flags |= 0x04;
+                        depositId = seis.DepositId;
+                        resourceKind = seis.ResourceKind;
+                        depthM = seis.DepthM;
+                    }
+                    else
+                    {
+                        error = "Vibroseis Seismic requires Mode=0 (Mag-Grav Recon) or Mode=1 (Scan).";
+                        return null;
+                    }
+                    break;
+                }
+                case DeployableKind.DiamondCoreDrill:
+                {
+                    if (msg.Mode != 2)
+                    {
+                        error = "Diamond Core Drill requires Mode=2 (Drill).";
+                        return null;
+                    }
+                    if (!TryDrillCoreAtLandblock(lbId, out var core, out error))
+                        return null;
+                    if (prospectingTool != null)
+                    {
+                        prospectingTool.CoreDepositId = core.DepositId;
+                        prospectingTool.CoreBasinId = core.BasinId;
+                    }
+                    flags |= 0x02 | 0x04;
+                    depositId = core.DepositId;
+                    resourceKind = core.ResourceKind;
+                    depthM = core.DepthM;
+                    break;
+                }
+                case DeployableKind.MobileAssayLab:
+                {
+                    if (msg.Mode != 3)
+                    {
+                        error = "Mobile Assay Lab requires Mode=3 (Assay).";
+                        return null;
+                    }
+                    var nearest = FindNearestDeposit(lbId);
+                    if (nearest == null || !RunMobileAssay(nearest.DepositId, out var assay, out error))
+                    {
+                        error ??= "No cored deposit available for Mobile Assay Lab.";
+                        return null;
+                    }
+                    if (prospectingTool != null)
+                        prospectingTool.CoreAssayed = true;
+                    flags |= 0x02 | 0x04;
+                    depositId = assay.DepositId;
+                    resourceKind = assay.ResourceKind;
+                    depthM = nearest.DepthM;
+                    gradeBps = (uint)assay.GradeBps;
+                    apiGravity = assay.ApiGravity;
+                    sulfurBps = (uint)assay.SulfurBps;
+                    remainingTonnes = assay.RemainingTonnes;
+                    break;
+                }
+                default:
+                    error = $"Unsupported prospecting tool kind {toolKind}.";
+                    return null;
+            }
+
+            return new IndustrySurveyResultMsg
+            {
+                DepositId = Math.Min(depositId, MaxSafeDepositId),
+                LandblockId = SiegeManager.PackOriginLandblockId(new LandblockId(lbId)),
+                ToolKind = (uint)toolKind,
+                Flags = flags,
+                TerrainCode = terrainCode,
+                ResourceKind = resourceKind,
+                Reserved = 0,
+                DepthM = depthM,
+                GradeBps = gradeBps,
+                ApiGravity = apiGravity,
+                SulfurBps = sulfurBps,
+                RemainingTonnes = remainingTonnes,
+            };
+        }
+
+        private static void PersistDeposit(SubsurfaceDeposit snapshot)
+        {
+            try
+            {
+                DatabaseManager.Shard?.EnqueueSubsurfaceDepositUpsert(snapshot);
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[GEOLOGY] Failed to enqueue SubsurfaceDeposit upsert: {ex.Message}");
+            }
+        }
+
+        private static SubsurfaceDeposit CloneDeposit(SubsurfaceDeposit d) => new()
+        {
+            DepositId = d.DepositId,
+            BasinId = d.BasinId,
+            LandblockId = d.LandblockId,
+            DepthM = d.DepthM,
+            ResourceType = d.ResourceType,
+            GradeBps = Math.Clamp(d.GradeBps, 0, 10000),
+            ApiGravity = d.ApiGravity,
+            SulfurBps = d.SulfurBps,
+            RemainingTonnes = Math.Max(0.0f, d.RemainingTonnes),
+            CoredFlag = d.CoredFlag,
+            UpdatedUtc = d.UpdatedUtc,
+        };
+    }
+}
