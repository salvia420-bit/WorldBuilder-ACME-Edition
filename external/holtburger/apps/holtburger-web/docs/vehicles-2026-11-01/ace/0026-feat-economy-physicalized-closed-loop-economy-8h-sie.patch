+        internal static void RaiseSiegeAlert(uint townId, string eventType, string message)
+            => EmitSiegeAlert(townId, eventType, message);
+
+        private static void EmitSiegeAlert(uint townId, string eventType, string message)
+        {
+            log.Info($"[SIEGE] ({eventType}) Town {townId}: {message}");
+            SiegeAlertRaised?.Invoke(townId, eventType, message);
+
+            try
+            {
+                var state = TownEconomyManager.GetTownState(townId);
+                uint ownerId = 0, attackerId = 0;
+                if (state != null)
+                {
+                    lock (state.SyncRoot)
+                    {
+                        ownerId = state.Control.OwnerMonarchId;
+                        attackerId = state.Control.AttackerMonarchId;
+                    }
+                }
+
+                foreach (var p in PlayerManager.GetAllOnline())
+                {
+                    if (p?.Session == null) continue;
+                    var pMonarch = TownCommands.ResolveEffectiveMonarchId(p);
+                    if (pMonarch != 0 && (pMonarch == ownerId || pMonarch == attackerId))
+                    {
+                        p.Session.Network?.EnqueueSend(new GameMessageSystemChat($"[SIEGE] {message}", ChatMessageType.Broadcast));
+                    }
+                }
+            }
+            catch
+            {
+                // Headless unit test safe
+            }
+        }
