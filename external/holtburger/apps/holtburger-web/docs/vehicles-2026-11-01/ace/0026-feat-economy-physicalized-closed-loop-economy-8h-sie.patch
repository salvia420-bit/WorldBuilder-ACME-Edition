+        public static bool IsTurretBrownedOut(DeployableBase turret)
+        {
+            if (turret == null || !TownEconomyManager.Enabled)
+                return false;
+
+            uint townId = turret.AffiliatedTownId;
+            if (townId == 0 && turret.Location != null)
+                townId = TownRegistry.ResolveTown(turret)?.TownId ?? 0u;
+
+            if (townId == 0)
+                return false;
+
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null)
+                return false;
+
+            lock (state.SyncRoot)
+            {
+                return state.Control.State == "STARVING";
+            }
+        }
