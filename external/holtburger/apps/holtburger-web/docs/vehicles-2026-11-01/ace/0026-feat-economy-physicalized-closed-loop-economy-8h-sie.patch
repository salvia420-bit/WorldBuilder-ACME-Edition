+        public (List<TownControl> Controls, List<TownVendorLedger> Ledgers, List<TownWarehouseStock> Warehouses) SeedAndLoadTownEconomy(IEnumerable<TownControl> seedRows)
+        {
+            using (var context = new ShardDbContext())
+            {
+                var existingIds = context.TownControl.AsNoTracking().Select(t => t.TownId).ToHashSet();
+                var added = false;
+                foreach (var seed in seedRows)
+                {
+                    if (!existingIds.Contains(seed.TownId))
+                    {
+                        context.TownControl.Add(seed);
+                        added = true;
+                    }
