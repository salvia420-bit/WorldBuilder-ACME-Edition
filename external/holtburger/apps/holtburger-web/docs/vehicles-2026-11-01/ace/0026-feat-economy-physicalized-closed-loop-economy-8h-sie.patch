+            var tempCache = new ConcurrentDictionary<uint, ACE.DatLoader.FileTypes.FileType>();
+            var mapper = new ACE.DatLoader.FileTypes.DualDidMapper();
+            mapper.ClientEnumToID[1u] = 691u; // Lead Scarab
+            mapper.ClientEnumToID[188u] = TownEconomyManager.PrismaticTaperWcid; // Prismatic Taper (20631)
+            tempCache[0x27000002u] = mapper; // Spell.SpellComponentDIDs
