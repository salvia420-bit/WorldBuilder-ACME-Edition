+                    existing.TownId = snapshot.TownId;
+                    existing.OrderType = snapshot.OrderType ?? "ProcurementBounty";
+                    existing.ItemWcid = snapshot.ItemWcid;
+                    existing.CommodityId = snapshot.CommodityId ?? "";
+                    existing.TargetQty = clampedTarget;
+                    existing.RemainingQty = clampedRemaining;
+                    existing.RewardPyreals = clampedReward;
+                    existing.ClaimedByGuid = snapshot.ClaimedByGuid;
