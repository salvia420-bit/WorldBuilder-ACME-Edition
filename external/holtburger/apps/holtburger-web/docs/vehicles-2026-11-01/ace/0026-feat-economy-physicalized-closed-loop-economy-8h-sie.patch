+        public static long GetEffectiveSellCost64(uint townId, uint vendorGuid, uint itemWcid, int? itemValue, int stackSize, ItemType? itemType, double? vendorSellPrice)
+        {
+            if (itemType == ItemType.PromissoryNote)
+                return Math.Max(1L, (long)(itemValue ?? 0));
+
+            var state = GetTownState(townId);
+            float tariffBuyMul = 1.0f;
+            int? unitOverride = null;
+
+            if (state != null)
+            {
+                lock (state.SyncRoot)
+                {
+                    tariffBuyMul = state.Control.TariffBuyMul;
+                    if (state.Ledgers.TryGetValue((vendorGuid, itemWcid), out var ledger))
+                        unitOverride = ledger.UnitPriceOverride;
+                }
+            }
+
+            if (unitOverride.HasValue && unitOverride.Value > 0)
+            {
+                var qty = Math.Max(1, stackSize);
+                return Math.Max(1L, (long)unitOverride.Value * qty);
+            }
+
+            double sellRate = vendorSellPrice ?? 1.0;
+            var effectiveRate = sellRate * tariffBuyMul;
+            var raw = Math.Ceiling(effectiveRate * (itemValue ?? 0) - 0.1);
+            return Math.Max(1L, (long)raw);
+        }
+
+        public static int GetEffectiveBuyCost(uint townId, uint vendorGuid, uint itemWcid, int? itemValue, ItemType? itemType, double? vendorBuyPrice)
+        {
+            if (itemType == ItemType.PromissoryNote)
+                return Math.Max(1, itemValue ?? 0);
+
+            var state = GetTownState(townId);
+            float tariffSellMul = 1.0f;
+
+            if (state != null)
+            {
+                lock (state.SyncRoot)
+                    tariffSellMul = state.Control.TariffSellMul;
+            }
+
+            double buyRate = vendorBuyPrice ?? 1.0;
+            if (tariffSellMul <= 0f || buyRate <= 0.0 || (itemValue ?? 0) <= 0)
+                return 0;
+
+            var effectiveRate = buyRate * tariffSellMul;
+            var raw = Math.Floor(effectiveRate * itemValue.Value + 0.1);
+            return raw <= 0.0 ? 0 : Math.Max(1, (int)Math.Min(int.MaxValue, raw));
+        }
