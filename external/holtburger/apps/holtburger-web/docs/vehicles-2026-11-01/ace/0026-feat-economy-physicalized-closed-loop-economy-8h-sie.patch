+        private static void SettleConvoyDelivery(LogisticsConvoyState convoy)
+        {
+            if (convoy.DestTownId == 0)
+                return;
+
+            if (!string.IsNullOrWhiteSpace(convoy.CommodityId) && convoy.CommodityQty > 0)
+            {
+                float freshnessPct = 100.0f;
+                bool poweredReefer = false;
+                if (convoy.AttachedContainer != null)
+                {
+                    poweredReefer = convoy.AttachedContainer.IsPoweredReefer;
+                    if (convoy.AttachedContainer.PerishableCargoItems.Count > 0)
+                    {
+                        double sum = 0.0;
+                        foreach (var item in convoy.AttachedContainer.PerishableCargoItems)
+                            sum += PerishableDecay.GetFreshnessPercent(item);
+                        freshnessPct = (float)(sum / convoy.AttachedContainer.PerishableCargoItems.Count);
+                    }
+                }
+
+                TownEconomyManager.RecordWarehouseDelivery(
+                    convoy.DestTownId,
+                    convoy.CommodityId,
+                    convoy.CommodityQty,
+                    10000,
+                    freshnessPct,
+                    poweredReefer);
+            }
+
+            SiegeManager.NotifyTownLogisticsDelivery(convoy.DestTownId);
+
+            if (SiegeManager.HasValidSupplyProvenance(convoy.OriginLandblockId, convoy.DestTownId))
+            {
+                var destState = TownEconomyManager.GetTownState(convoy.DestTownId);
+                if (destState != null)
+                {
+                    uint attackerMonarch;
+                    string controlState;
+                    lock (destState.SyncRoot)
+                    {
+                        attackerMonarch = destState.Control.AttackerMonarchId;
+                        controlState = destState.Control.State;
+                    }
+                    if (controlState is "CONTESTED_HOLD" or "STARVING" &&
+                        attackerMonarch != 0 &&
+                        attackerMonarch == convoy.OwnerMonarchId &&
+                        convoy.CommodityQty > 0)
+                    {
+                        SiegeManager.DeliverSiegeSupply(
+                            convoy.DestTownId,
+                            convoy.OriginLandblockId,
+                            Math.Max(10.0, convoy.CommodityQty * 10.0),
+                            actor: null,
+                            out _);
+                    }
+                }
+            }
+
+            ConvoyDelivered?.Invoke(convoy.ConvoyId, convoy.DestTownId, convoy.CommodityId, convoy.CommodityQty);
+        }
