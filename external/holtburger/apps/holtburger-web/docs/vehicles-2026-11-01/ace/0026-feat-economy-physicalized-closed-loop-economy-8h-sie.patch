+        [TestMethod]
+        public void Test01_ColdStartAndFiniteStockApproachVendorAndPurchaseDeduction()
+        {
+            var holtburg = TownRegistry.FindByName("Holtburg");
+            var vendor = CreateTestVendor(666, 0xA9B40101u, "Holtburg Provisioner");
+            var player = CreateTestPlayer(0xA9B40001u, coinValue: 10_000);
+            var bread = CreateTestItem(258, WeenieType.Food, ItemType.Food, value: 10, stackSize: 1, maxStack: 100, name: "Apple");
+            bread.VendorShopCreateListStackSize = -1;
+            vendor.DefaultItemsForSale[bread.Guid] = bread;
+
+            // Cold start: GameEventApproachVendor omits 0-stock items
+            Assert.AreEqual(0, ReadApproachVendorNumItems(player.Session, vendor));
+
+            // Purchase attempt fails when stock == 0
+            Assert.IsFalse(TownEconomyManager.TryExecuteVendorPurchase(vendor, new List<WorldObject> { bread }, new List<WorldObject>(), 10, out var err));
+            StringAssert.Contains(err, "out of stock");
+
+            // Seed 5 apples into town_vendor_ledger
+            TownEconomyManager.SeedVendorStock(holtburg.TownId, vendor.Guid.Full, bread.WeenieClassId, 5);
+            var (numItems, qtys) = ReadApproachVendorPayload(player.Session, vendor);
+            Assert.AreEqual(1, numItems);
+            Assert.AreEqual(5, qtys[0]); // finite stock, never -1!
+
+            // Buy 3 apples -> succeeds, 2 remaining, +30 pyreals in Holtburg treasury
+            var bought3 = CreateTestItem(258, WeenieType.Food, ItemType.Food, value: 10, stackSize: 3, maxStack: 100, name: "Apple");
+            Assert.IsTrue(TownEconomyManager.TryExecuteVendorPurchase(vendor, new List<WorldObject> { bought3 }, new List<WorldObject>(), 30, out _));
+            Assert.AreEqual(2, TownEconomyManager.GetVendorStock(holtburg.TownId, vendor.Guid.Full, bread.WeenieClassId));
+            Assert.AreEqual(30L, TownEconomyManager.GetTreasuryPyreals(holtburg.TownId));
+
+            // Attempt to buy remaining 2 + 1 (3) -> fails and leaves stock at 2
+            Assert.IsFalse(TownEconomyManager.TryExecuteVendorPurchase(vendor, new List<WorldObject> { bought3 }, new List<WorldObject>(), 30, out _));
+            Assert.AreEqual(2, TownEconomyManager.GetVendorStock(holtburg.TownId, vendor.Guid.Full, bread.WeenieClassId));
+        }
