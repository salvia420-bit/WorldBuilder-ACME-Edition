+        public static EconomyMonarchOrderStateMsg HandleMonarchOrderAction(Player player, EconomyMonarchOrder msg, out string error)
+        {
+            error = null;
+            if (player == null || msg == null)
+            {
+                error = "Invalid monarch order request.";
+                return null;
+            }
+
+            uint monarchId = TownCommands.ResolveEffectiveMonarchId(player);
+            switch (msg.Action)
+            {
+                case 0: // Query
+                {
+                    if (msg.OrderId != 0 && monarchOrders.TryGetValue(msg.OrderId, out var exact))
+                        return BuildMonarchOrderStateMsg(exact);
+                    var first = GetOrders(msg.TownId != 0 ? msg.TownId : null).FirstOrDefault();
+                    if (first != null)
+                        return BuildMonarchOrderStateMsg(first);
+                    return new EconomyMonarchOrderStateMsg
+                    {
+                        OrderId = 0,
+                        MonarchId = monarchId,
+                        TownId = msg.TownId,
+                        OrderType = msg.OrderType,
+                        Status = 0,
+                    };
+                }
+
+                case 1: // CreateBounty
+                {
+                    if (!TownCommands.CanModifyTownPolicy(player, msg.TownId))
+                    {
+                        error = "Rejected: Only the owning Allegiance Monarch may post procurement bounties.";
+                        return null;
+                    }
+                    if (msg.ItemWcid == 0 || msg.Quantity == 0 || msg.RewardPyreals == 0)
+                    {
+                        error = "Bounty requires positive ItemWcid, Quantity, and RewardPyreals.";
+                        return null;
+                    }
+                    long reward = (long)Math.Min((ulong)long.MaxValue, msg.RewardPyreals);
+                    int qty = (int)Math.Min((uint)int.MaxValue, msg.Quantity);
+                    var created = SetProcurementBountyOrder(msg.TownId, msg.ItemWcid, $"trophy_{msg.ItemWcid}", reward, qty, monarchId, msg.OrderId);
+                    if (created == null)
+                    {
+                        error = $"Town {msg.TownId} not found.";
+                        return null;
+                    }
+                    return BuildMonarchOrderStateMsg(created);
+                }
+
+                case 2: // CancelBounty
+                {
+                    if (!TownCommands.CanModifyTownPolicy(player, msg.TownId))
+                    {
+                        error = "Rejected: Only the owning Allegiance Monarch may cancel procurement bounties.";
+                        return null;
+                    }
+                    if (!CancelMonarchOrder(msg.TownId, msg.OrderId, msg.ItemWcid, out var cancelled))
+                    {
+                        error = "Matching procurement bounty not found.";
+                        return null;
+                    }
+                    return BuildMonarchOrderStateMsg(cancelled);
+                }
+
+                case 3: // SetTariff
+                {
+                    if (!TownCommands.CanModifyTownPolicy(player, msg.TownId))
+                    {
+                        error = "Rejected: Only the owning Allegiance Monarch may modify tariffs.";
+                        return null;
+                    }
+                    var (curBuy, curSell) = GetTariffs(msg.TownId);
+                    float nextBuy = (msg.Flags & 0x01) == 0 ? msg.ParamF32 : curBuy;
+                    float nextSell = (msg.Flags & 0x01) != 0 ? msg.ParamF32 : curSell;
+                    if (!float.IsFinite(nextBuy) || !float.IsFinite(nextSell))
+                    {
+                        error = "Tariff multiplier must be finite.";
+                        return null;
+                    }
+                    SetTownTariffs(msg.TownId, nextBuy, nextSell);
+                    var (actualBuy, actualSell) = GetTariffs(msg.TownId);
+                    return new EconomyMonarchOrderStateMsg
+                    {
+                        OrderId = msg.OrderId,
+                        MonarchId = monarchId,
+                        TownId = msg.TownId,
+                        OrderType = 2,
+                        Status = 1,
+                        Flags = msg.Flags,
+                        ValueF32 = (msg.Flags & 0x01) != 0 ? actualSell : actualBuy,
+                    };
+                }
+
+                case 4: // SetTillCap
+                {
+                    if (!TownCommands.CanModifyTownPolicy(player, msg.TownId))
+                    {
+                        error = "Rejected: Only the owning Allegiance Monarch may modify till caps.";
+                        return null;
+                    }
+                    long cap = (long)Math.Min((ulong)long.MaxValue, msg.RewardPyreals);
+                    SetTownTillCap(msg.TownId, cap);
+                    return new EconomyMonarchOrderStateMsg
+                    {
+                        OrderId = msg.OrderId,
+                        MonarchId = monarchId,
+                        TownId = msg.TownId,
+                        OrderType = 3,
+                        Status = 1,
+                        RewardPyreals = (ulong)GetTownTillCap(msg.TownId),
+                    };
+                }
+
+                case 5: // SetDiplomacy
+                {
+                    if (!TownCommands.IsAllegianceMonarch(player))
+                    {
+                        error = "Rejected: Only an Allegiance Monarch may modify GuildRadarPolicy IFF diplomacy.";
+                        return null;
+                    }
+                    if (msg.TargetGuid == 0)
+                    {
+                        error = "Target Monarch GUID required for diplomacy update.";
+                        return null;
+                    }
+                    IffStanding standing = msg.Quantity switch
+                    {
+                        1 => IffStanding.Friendly,
+                        2 => IffStanding.Neutral,
+                        3 => IffStanding.Hostile,
+                        _ => msg.OrderType switch
+                        {
+                            1 => IffStanding.Friendly,
+                            2 => IffStanding.Neutral,
+                            3 => IffStanding.Hostile,
+                            _ => IffStanding.Neutral,
+                        },
+                    };
+                    var policy = RadarIff.GetOrCreateMonarchPolicy(monarchId);
+                    policy.SetStanding(msg.TargetGuid, standing);
+                    SiegeManager.SyncMonarchRadarPolicies(monarchId);
+                    return new EconomyMonarchOrderStateMsg
+                    {
+                        OrderId = msg.OrderId,
+                        MonarchId = monarchId,
+                        TownId = msg.TownId,
+                        OrderType = 4,
+                        Status = 1,
+                        ClaimedByGuid = msg.TargetGuid,
+                        Quantity = (uint)standing,
+                    };
+                }
+
+                default:
+                    error = $"Unsupported EconomyMonarchOrder action {msg.Action}.";
+                    return null;
+            }
+        }
