+                Assert.AreEqual(2, qtysAfter[0]);
+            }
+            finally
+            {
+                portalDat.SpellTable.Spells.Remove(testSpellId);
+                fileCacheField?.SetValue(portalDat, origCache);
+            }
+        }
+    }
