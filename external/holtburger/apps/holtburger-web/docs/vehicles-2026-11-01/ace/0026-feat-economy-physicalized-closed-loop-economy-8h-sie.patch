+        private static void UpdateConvoyMicroLod(LogisticsConvoyState convoy)
+        {
+            if (convoy == null) return;
+
+            bool canBeMicro;
+            double minDistM;
+            LogisticsLodState lodState;
+            bool needsMaterialize;
+            bool modeMismatch = false;
+            double wx, wy;
+            lock (convoy.SyncRoot)
+            {
+                canBeMicro = convoy.Status == LogisticsConvoyStatus.EnRoute ||
+                             convoy.Status == LogisticsConvoyStatus.OutOfFuel;
+                lodState = convoy.LodState;
+                byte expectedClass = GetExpectedActiveVehicleClass(convoy);
+                if (convoy.ActiveVehicle != null && !convoy.ActiveVehicle.IsDestroyed &&
+                    convoy.ActiveVehicle.Profile.VehicleClass != expectedClass)
+                {
+                    modeMismatch = true;
+                }
+                needsMaterialize = lodState == LogisticsLodState.Macro ||
+                                   convoy.ActiveVehicle == null ||
+                                   convoy.ActiveVehicle.IsDestroyed ||
+                                   modeMismatch;
+                wx = convoy.WorldX;
+                wy = convoy.WorldY;
+                minDistM = ComputeNearestObserverDistanceM(wx, wy);
+            }
+
+            bool shouldBeMicro = canBeMicro && ShouldMaterializeMicroLod(minDistM);
+
+            if (shouldBeMicro)
+            {
+                if (modeMismatch)
+                {
+                    DetachMismatchedVehicleForSwap(convoy);
+                }
+                if (needsMaterialize)
+                {
+                    MaterializeMicroLod(convoy);
+                }
+                else
+                {
+                    KeepConvoyLandblockActive(wx, wy);
+                }
+            }
+            else if (lodState == LogisticsLodState.Micro)
+            {
+                DematerializeMicroLod(convoy);
+            }
+        }
