+        public static bool DeliverSiegeSupplyForTesting(uint townId, uint originLandblockId, double distanceM, double supplyPoints)
+        {
+            if (originLandblockId == 0 || supplyPoints <= 0.0 || !double.IsFinite(distanceM) || distanceM < MinProvenanceDistanceM)
+                return false;
+
+            var state = TownEconomyManager.GetTownState(townId);
+            var def = TownRegistry.GetById(townId);
+            if (state == null || def == null)
+                return false;
+
+            var drainPerHour = GetSupplyDrainPerHour(def.Tier);
+            double addedSec = (supplyPoints / drainPerHour) * 3600.0;
+
+            lock (state.SyncRoot)
+            {
+                if (state.Control.State is "CONTESTED_HOLD" or "STARVING")
+                {
+                    state.SupplyMeterSecExact = Math.Min(SupplyMeterMaxSec, state.SupplyMeterSecExact + addedSec);
+                    state.Control.SupplyMeterSec = (int)Math.Ceiling(state.SupplyMeterSecExact);
+                    state.ApronSupplySp += supplyPoints;
+                    state.StarvingSecExact = 0.0;
+                    state.Control.StarvingSec = 0;
+                    if (state.SupplyMeterSecExact > 900.0)
+                        state.SupplyLowAlertSent = false;
+                    if (state.Control.State == "STARVING" && state.SupplyMeterSecExact > 0.0)
+                        state.Control.State = "CONTESTED_HOLD";
+                }
+                state.Control.LastDeliveryUtc = DateTime.UtcNow;
+            }
+            return true;
+        }
+
+        public static void SetSupplyMeterForTesting(uint townId, double seconds)
+        {
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null) return;
+
+            lock (state.SyncRoot)
+            {
+                var clamped = Math.Clamp(seconds, 0.0, SupplyMeterMaxSec);
+                state.SupplyMeterSecExact = clamped;
+                state.Control.SupplyMeterSec = (int)Math.Ceiling(clamped);
+                if (clamped > 900.0)
+                    state.SupplyLowAlertSent = false;
+                if (clamped <= 0.0 && state.Control.State == "CONTESTED_HOLD")
+                {
+                    state.Control.State = "STARVING";
+                    state.StarvingSecExact = 0.0;
+                    state.Control.StarvingSec = 0;
+                }
+                else if (clamped > 0.0 && state.Control.State == "STARVING")
+                {
+                    state.Control.State = "CONTESTED_HOLD";
+                    state.StarvingSecExact = 0.0;
+                    state.Control.StarvingSec = 0;
+                }
+            }
+        }
+
+        public static void TriggerThreeWayResetForTesting(uint townId, uint newAttackerMonarchId)
+        {
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null) return;
+
+            lock (state.SyncRoot)
+            {
+                if (state.Control.State is not ("CONTESTED_HOLD" or "STARVING"))
+                    return;
+
+                ApplyThreeWayResetLocked(state, newAttackerMonarchId, DateTime.UtcNow);
+            }
+        }
+
+        public static void AdvanceInsolvencyForTesting(uint townId, double elapsedSeconds)
+        {
+            if (!double.IsFinite(elapsedSeconds) || elapsedSeconds <= 0.0)
+                return;
+
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null) return;
+
+            var now = DateTime.UtcNow;
+            lock (state.SyncRoot)
+            {
+                if (state.Control.State == "UNCLAIMED_COLD" && state.Control.OwnerMonarchId == 0 && state.InactivityElapsedSec == 0.0)
+                {
+                    state.Control.State = "CONTROLLED";
+                    state.Control.OwnerMonarchId = 100u;
+                    state.Control.TreasuryPyreals = 0;
+                }
+
+                if (state.Control.State == "CONTROLLED")
+                {
+                    var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+                    if (spendable > 0)
+                        return;
+
+                    state.InactivityElapsedSec += elapsedSeconds;
+                    if (state.InactivityElapsedSec >= InsolvencyThresholdSec)
+                    {
+                        state.Control.State = "INSOLVENT_RECEIVERSHIP";
+                        state.InsolventSinceUtc = now;
+                        state.InsolvencyGraceElapsedSec = state.InactivityElapsedSec - InsolvencyThresholdSec;
+                        if (state.InsolvencyGraceElapsedSec >= InsolvencyGraceSec)
+                            RevertToUnclaimedColdLocked(state, now);
+                    }
+                }
+                else if (state.Control.State == "INSOLVENT_RECEIVERSHIP")
+                {
+                    state.InsolvencyGraceElapsedSec += elapsedSeconds;
+                    if (state.InsolvencyGraceElapsedSec >= InsolvencyGraceSec)
+                        RevertToUnclaimedColdLocked(state, now);
+                }
+            }
+        }
+
+        public static SiegeStateSnapshot GetSiegeState(uint townId)
+        {
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null) return null;
+
+            lock (state.SyncRoot)
