+        public static LogisticsNavGraph LoadFromJson(string json)
+        {
+            if (string.IsNullOrWhiteSpace(json))
+                throw new ArgumentException("Nav graph JSON is empty.", nameof(json));
+
+            using var doc = JsonDocument.Parse(json);
+            var root = doc.RootElement;
+            var g = new LogisticsNavGraph
+            {
+                Schema = GetString(root, "schema"),
+                Version = GetInt(root, "version", 1),
+                DericostYOffset = GetDouble(root, "dericostYOffset", Vehicle.DericostYOffset),
+            };
+
+            if (root.TryGetProperty("basins", out var basinsEl) && basinsEl.ValueKind == JsonValueKind.Object)
+            {
+                foreach (var prop in basinsEl.EnumerateObject())
+                {
+                    if (!string.Equals(prop.Name, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                        throw new InvalidOperationException($"Forbidden or unsupported sea basin '{prop.Name}' in nav graph.");
+                    g._basins.Add(prop.Name);
+                }
+            }
+
+            var towns = new List<NavTown>(101);
+            if (root.TryGetProperty("towns", out var townsEl) && townsEl.ValueKind == JsonValueKind.Array)
+            {
+                foreach (var el in townsEl.EnumerateArray())
+                {
+                    uint townId = GetUInt(el, "townId");
+                    if (townId == 0) townId = GetUInt(el, "id");
+                    var lbHex = GetString(el, "anchorLandblock");
+                    uint lbId = GetUInt(el, "anchorLandblockId");
+                    if (lbId == 0 && !string.IsNullOrEmpty(lbHex))
+                        lbId = ParseHexUInt(lbHex);
+
+                    var t = new NavTown
+                    {
+                        TownId = townId,
+                        Name = GetString(el, "name"),
+                        Continent = GetString(el, "continent"),
+                        ContinentId = (byte)GetInt(el, "continentId"),
+                        Tier = GetInt(el, "tier", 1),
+                        Province = GetString(el, "province"),
+                        AnchorLandblockHex = lbHex,
+                        AnchorLandblockId = lbId,
+                        X = GetDouble(el, "x"),
+                        Y = GetDouble(el, "y"),
+                        Z = GetDouble(el, "z"),
+                        BaseVendorCount = GetInt(el, "baseVendorCount"),
+                        NodeId = GetString(el, "nodeId"),
+                        NearestRoadNodeId = GetString(el, "nearestRoadNodeId"),
+                        RoadAttachDistM = GetDouble(el, "roadAttachDistM"),
+                        Reachability = GetString(el, "reachability"),
+                    };
+                    towns.Add(t);
+                    if (t.TownId != 0)
+                        g._townsById[t.TownId] = t;
+                }
+            }
+            g.Towns = towns;
+
+            var ports = new List<NavPort>(11);
+            if (root.TryGetProperty("ports", out var portsEl) && portsEl.ValueKind == JsonValueKind.Array)
+            {
+                foreach (var el in portsEl.EnumerateArray())
+                {
+                    uint portId = GetUInt(el, "portId");
+                    if (portId == 0) portId = GetUInt(el, "id");
+                    var lbHex = GetString(el, "lb");
+                    uint lbId = GetUInt(el, "landblockId");
+                    if (lbId == 0 && !string.IsNullOrEmpty(lbHex))
+                        lbId = ParseHexUInt(lbHex);
+                    string basin = GetString(el, "basin");
+
+                    if (IsForbiddenPortOrBasin(basin, lbId))
+                        throw new InvalidOperationException($"Forbidden Item 2 port or non-Outer-Ocean basin detected: basin='{basin}', lb=0x{lbId:X}.");
+
+                    int terrainCode = GetInt(el, "terrainCode", 20);
+                    if ((terrainCode & 0x1F) != 20)
+                        throw new InvalidOperationException($"Port '{GetString(el, "name")}' terrainCode {terrainCode} does not match deep-water mask 20.");
+
+                    var p = new NavPort
+                    {
+                        PortId = portId,
+                        Id = GetString(el, "id"),
+                        Name = GetString(el, "name"),
+                        Basin = string.IsNullOrEmpty(basin) ? OuterOceanBasin : basin,
+                        Continent = GetString(el, "continent"),
+                        ContinentId = (byte)GetInt(el, "continentId"),
+                        LandblockHex = lbHex,
+                        LandblockId = lbId,
+                        X = GetDouble(el, "x"),
+                        Y = GetDouble(el, "y"),
+                        Z = GetDouble(el, "z"),
+                        SeaX = GetDouble(el, "seaX"),
+                        SeaY = GetDouble(el, "seaY"),
+                        BerthDistM = GetDouble(el, "berthDistM"),
+                        TerrainCode = terrainCode,
+                        NodeId = GetString(el, "nodeId"),
+                        NearestRoadNodeId = GetString(el, "nearestRoadNodeId"),
+                    };
+                    ports.Add(p);
+                    if (p.PortId != 0)
+                        g._portsById[p.PortId] = p;
+                    if (p.LandblockId != 0)
+                        g._portsByLandblock[p.LandblockId] = p;
+                }
+            }
+            if (ports.Count != 11)
+                throw new InvalidOperationException($"Expected strictly 11 Outer Ocean ports, got {ports.Count}.");
+            g.Ports = ports;
+
+            var nodes = new List<NavNode>(12050);
+            if (root.TryGetProperty("nodes", out var nodesEl) && nodesEl.ValueKind == JsonValueKind.Array)
+            {
+                foreach (var el in nodesEl.EnumerateArray())
+                {
+                    var basin = GetString(el, "basin");
+                    if (!string.IsNullOrEmpty(basin) && !string.Equals(basin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                        throw new InvalidOperationException($"Forbidden basin '{basin}' on node '{GetString(el, "id")}'.");
+
+                    var n = new NavNode
+                    {
+                        Id = GetString(el, "id"),
+                        Kind = GetString(el, "kind"),
+                        ContinentId = (byte)GetInt(el, "continentId"),
+                        X = GetDouble(el, "x"),
+                        Y = GetDouble(el, "y"),
+                        Z = GetDouble(el, "z"),
+                        TerrainCode = GetInt(el, "terrainCode", -1),
+                        IsRoad = GetBool(el, "isRoad"),
+                        IsPort = GetBool(el, "isPort"),
+                        IsTown = GetBool(el, "isTown"),
+                        TownId = GetUInt(el, "townId"),
+                        Name = GetString(el, "name"),
+                        Basin = basin,
+                    };
+                    if (!string.IsNullOrEmpty(n.Id))
+                    {
+                        nodes.Add(n);
+                        g._nodesById[n.Id] = n;
+                    }
+                }
+            }
+            g.Nodes = nodes;
+
+            var edges = new List<NavEdge>(13800);
+            if (root.TryGetProperty("edges", out var edgesEl) && edgesEl.ValueKind == JsonValueKind.Array)
+            {
+                foreach (var el in edgesEl.EnumerateArray())
+                {
+                    var mode = GetString(el, "mode");
+                    var basin = GetString(el, "basin");
+                    if (string.Equals(mode, "sea", StringComparison.OrdinalIgnoreCase) &&
+                        !string.IsNullOrEmpty(basin) &&
+                        !string.Equals(basin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                    {
+                        throw new InvalidOperationException($"Forbidden sea edge basin '{basin}' on edge '{GetString(el, "id")}'.");
+                    }
+
+                    double lengthM = GetDouble(el, "lengthM");
+                    if (lengthM <= 0.0) lengthM = GetDouble(el, "distanceM");
+
+                    var e = new NavEdge
+                    {
+                        Id = GetString(el, "id"),
+                        From = GetString(el, "from"),
+                        To = GetString(el, "to"),
+                        Mode = mode,
+                        LengthM = lengthM,
+                        DistanceM = GetDouble(el, "distanceM", lengthM),
+                        GradeDeg = GetDouble(el, "gradeDeg"),
+                        MaxSlopeDeg = GetDouble(el, "maxSlopeDeg"),
+                        Is4wdLow = GetBool(el, "is4wdLow"),
+                        IsBridge = GetBool(el, "isBridge"),
+                        IsFord = GetBool(el, "isFord"),
+                        ContinentId = (byte)GetInt(el, "continentId"),
+                        Basin = basin,
+                    };
+                    edges.Add(e);
+                    if (!string.IsNullOrEmpty(e.From) && !string.IsNullOrEmpty(e.To))
+                    {
+                        if (!g._adjacency.TryGetValue(e.From, out var fromList))
+                            g._adjacency[e.From] = fromList = new List<(string, NavEdge)>();
+                        fromList.Add((e.To, e));
+
+                        if (!g._adjacency.TryGetValue(e.To, out var toList))
+                            g._adjacency[e.To] = toList = new List<(string, NavEdge)>();
+                        toList.Add((e.From, e));
+                    }
+                }
+            }
+            g.Edges = edges;
+
+            var seaLanes = new List<NavSeaLane>(16);
+            if (root.TryGetProperty("seaLanes", out var lanesEl) && lanesEl.ValueKind == JsonValueKind.Array)
+            {
+                foreach (var el in lanesEl.EnumerateArray())
+                {
+                    var basin = GetString(el, "basin");
+                    uint fromLb = ParseHexUInt(GetString(el, "fromLb"));
+                    uint toLb = ParseHexUInt(GetString(el, "toLb"));
+                    if (IsForbiddenPortOrBasin(basin, fromLb) || IsForbiddenPortOrBasin(basin, toLb))
+                        throw new InvalidOperationException($"Forbidden Item 2 sea lane '{GetString(el, "id")}' detected.");
+
+                    var wps = new List<(double, double, double)>();
+                    if (el.TryGetProperty("waypoints", out var wpEl) && wpEl.ValueKind == JsonValueKind.Array)
+                    {
+                        foreach (var pt in wpEl.EnumerateArray())
+                        {
+                            if (pt.ValueKind == JsonValueKind.Array && pt.GetArrayLength() >= 2)
+                            {
+                                double x = pt[0].GetDouble();
+                                double y = pt[1].GetDouble();
+                                double z = pt.GetArrayLength() >= 3 ? pt[2].GetDouble() : 0.0;
+                                wps.Add((x, y, z));
+                            }
+                        }
+                    }
+
+                    double lengthM = GetDouble(el, "lengthM");
+                    if (lengthM <= 0.0) lengthM = GetDouble(el, "distanceM");
+
+                    seaLanes.Add(new NavSeaLane
+                    {
+                        Id = GetString(el, "id"),
+                        From = GetString(el, "from"),
+                        To = GetString(el, "to"),
+                        FromName = GetString(el, "fromName"),
+                        ToName = GetString(el, "toName"),
+                        FromLandblockId = fromLb,
+                        ToLandblockId = toLb,
+                        Basin = string.IsNullOrEmpty(basin) ? OuterOceanBasin : basin,
+                        Mode = GetString(el, "mode", "sea"),
+                        LengthM = lengthM,
+                        Waypoints = wps,
+                    });
+                }
+            }
+            g.SeaLanes = seaLanes;
+
+            var routes = new List<NavPrecomputedRoute>(4);
+            if (root.TryGetProperty("routes", out var routesEl) && routesEl.ValueKind == JsonValueKind.Array)
+            {
+                foreach (var el in routesEl.EnumerateArray())
+                {
+                    var basin = GetString(el, "basin");
+                    uint fromLb = ParseHexUInt(GetString(el, "fromLb"));
+                    uint toLb = ParseHexUInt(GetString(el, "toLb"));
+                    if (IsForbiddenPortOrBasin(basin, fromLb) || IsForbiddenPortOrBasin(basin, toLb))
+                        throw new InvalidOperationException($"Forbidden Item 2 precomputed route detected.");
+
+                    var nodeIds = new List<string>();
+                    if (el.TryGetProperty("nodeIds", out var nidEl) && nidEl.ValueKind == JsonValueKind.Array)
+                    {
+                        foreach (var nid in nidEl.EnumerateArray())
+                        {
+                            if (nid.ValueKind == JsonValueKind.String)
+                                nodeIds.Add(nid.GetString() ?? "");
+                        }
+                    }
+
+                    routes.Add(new NavPrecomputedRoute
+                    {
+                        FromId = GetString(el, "fromId"),
+                        ToId = GetString(el, "toId"),
+                        FromName = GetString(el, "fromName"),
+                        ToName = GetString(el, "toName"),
+                        Mode = GetString(el, "mode"),
+                        Basin = basin,
+                        TotalLengthM = GetDouble(el, "totalLengthM"),
+                        NodeIds = nodeIds,
+                    });
+                }
+            }
+            g.Routes = routes;
+
+            if (g.HasInnerSeaLane())
+                throw new InvalidOperationException("Item 2 Inner Sea lane validation failed.");
+
+            return g;
+        }
+
+        private static bool IsForbiddenPortOrBasin(string basin, uint lbId)
+        {
+            if (!string.IsNullOrEmpty(basin) && !string.Equals(basin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                return true;
+            uint lb16 = lbId > 0xFFFFu ? (lbId >> 16) : lbId;
+            return lb16 == ForbiddenPortLbA || lb16 == ForbiddenPortLbB ||
+                   lbId == ForbiddenPortFullA || lbId == ForbiddenPortFullB;
+        }
+
+        public bool HasInnerSeaLane()
+        {
+            foreach (var b in _basins)
+            {
+                if (!string.Equals(b, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                    return true;
+            }
+            foreach (var p in Ports)
+            {
+                if (IsForbiddenPortOrBasin(p.Basin, p.LandblockId))
+                    return true;
+            }
+            foreach (var lane in SeaLanes)
+            {
+                if (IsForbiddenPortOrBasin(lane.Basin, lane.FromLandblockId) ||
+                    IsForbiddenPortOrBasin(lane.Basin, lane.ToLandblockId))
+                    return true;
+            }
+            foreach (var r in Routes)
+            {
+                if (!string.IsNullOrEmpty(r.Basin) && !string.Equals(r.Basin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                    return true;
+            }
+            return false;
+        }
+
+        public NavTown GetTown(uint townId) => _townsById.TryGetValue(townId, out var t) ? t : null;
+        public NavPort GetPort(uint portId) => _portsById.TryGetValue(portId, out var p) ? p : null;
+        public NavPort GetPortByLandblock(uint landblockId)
+        {
+            if (IsForbiddenPortOrBasin(OuterOceanBasin, landblockId))
+                return null;
+            if (_portsByLandblock.TryGetValue(landblockId, out var p))
+                return p;
+            uint lb16 = landblockId > 0xFFFFu ? (landblockId >> 16) : landblockId;
+            return _portsByLandblock.TryGetValue(lb16, out var p16) ? p16 : null;
+        }
+        public NavNode GetNode(string nodeId) => !string.IsNullOrEmpty(nodeId) && _nodesById.TryGetValue(nodeId, out var n) ? n : null;
+
+        public IReadOnlyList<(string NeighborId, NavEdge Edge)> GetAdjacentEdges(string nodeId)
+            => !string.IsNullOrEmpty(nodeId) && _adjacency.TryGetValue(nodeId, out var list)
+                ? list
+                : Array.Empty<(string, NavEdge)>();
+
+        public static bool IsSupportedVehicleClass(byte vehicleClass)
+            => vehicleClass == 0 ||
+               vehicleClass == (byte)VehicleClass.LightGround ||
+               vehicleClass == (byte)VehicleClass.HeavyTractor ||
+               vehicleClass == (byte)VehicleClass.ContainerShipFeeder;
+
+        public NavPort FindNearestPortToTown(uint townId)
+        {
+            var town = GetTown(townId);
+            if (town == null || Ports.Count == 0)
+                return null;
+
+            NavPort bestSameContinent = null;
+            double bestSameDistSq = double.MaxValue;
+            NavPort bestAny = null;
+            double bestAnyDistSq = double.MaxValue;
+
+            for (int i = 0; i < Ports.Count; i++)
+            {
+                var p = Ports[i];
+                if (IsForbiddenPortOrBasin(p.Basin, p.LandblockId))
+                    continue;
+                double dx = p.X - town.X;
+                double dy = p.Y - town.Y;
+                double dSq = dx * dx + dy * dy;
+                if (p.ContinentId == town.ContinentId && dSq < bestSameDistSq)
+                {
+                    bestSameDistSq = dSq;
+                    bestSameContinent = p;
+                }
+                if (dSq < bestAnyDistSq)
+                {
+                    bestAnyDistSq = dSq;
+                    bestAny = p;
+                }
+            }
+
+            return bestSameContinent ?? bestAny;
+        }
+
+        public NavTown FindNearestTownToPort(uint portId)
+        {
+            var port = GetPort(portId);
+            if (port == null || Towns.Count == 0)
+                return null;
+
+            NavTown bestSameContinent = null;
+            double bestSameDistSq = double.MaxValue;
+            NavTown bestAny = null;
+            double bestAnyDistSq = double.MaxValue;
+
+            for (int i = 0; i < Towns.Count; i++)
+            {
+                var t = Towns[i];
+                double dx = t.X - port.X;
+                double dy = t.Y - port.Y;
+                double dSq = dx * dx + dy * dy;
+                if (t.ContinentId == port.ContinentId && dSq < bestSameDistSq)
+                {
+                    bestSameDistSq = dSq;
+                    bestSameContinent = t;
+                }
+                if (dSq < bestAnyDistSq)
+                {
+                    bestAnyDistSq = dSq;
+                    bestAny = t;
+                }
+            }
+
+            return bestSameContinent ?? bestAny;
+        }
+
+        public bool TryFindRoute(
+            uint originTownId,
+            uint destTownId,
+            out LogisticsRoute route,
+            bool allowSea = true,
+            bool allowFourWdLow = true,
+            string requiredBasin = OuterOceanBasin)
+        {
+            return TryFindRouteInternal(
+                originTownId,
+                destTownId,
+                allowRoad: true,
+                allowSpur: true,
+                allowSea: allowSea,
+                allowFourWdLow: allowFourWdLow,
+                out route,
+                requiredBasin: requiredBasin);
+        }
+
+        public bool TryFindRoute(
+            uint originTownId,
+            uint destTownId,
+            byte vehicleClass,
+            bool allowFourWdLow,
+            out LogisticsRoute route,
+            string requiredBasin = OuterOceanBasin)
+        {
+            route = null;
+            if (!IsSupportedVehicleClass(vehicleClass))
+                return false;
+
+            if (originTownId == 0 || destTownId == 0 || originTownId == destTownId)
+                return false;
+
+            if (!string.Equals(requiredBasin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                return false;
+
+            if (vehicleClass == (byte)VehicleClass.ContainerShipFeeder)
+            {
+                var originPort = FindNearestPortToTown(originTownId);
+                var destPort = FindNearestPortToTown(destTownId);
+                if (originPort == null || destPort == null || originPort.PortId == destPort.PortId)
+                    return false;
+
+                if (!TryFindSeaRoute(originPort.PortId, destPort.PortId, out var seaRoute, requiredBasin))
+                    return false;
+
+                route = new LogisticsRoute
+                {
+                    OriginNodeId = seaRoute.OriginNodeId,
+                    DestNodeId = seaRoute.DestNodeId,
+                    OriginTownId = originTownId,
+                    DestTownId = destTownId,
+                    OriginPortId = originPort.PortId,
+                    DestPortId = destPort.PortId,
+                    UsesSea = true,
+                    Uses4wdLow = false,
+                    TotalLengthM = seaRoute.TotalLengthM,
+                    Waypoints = seaRoute.Waypoints,
+                };
+                return true;
+            }
+
+            if (vehicleClass == 0)
+            {
+                var originTown = GetTown(originTownId);
+                var destTown = GetTown(destTownId);
+                if (originTown != null && destTown != null && originTown.ContinentId == destTown.ContinentId)
+                {
+                    if (TryFindRouteInternal(
+                        originTownId,
+                        destTownId,
+                        allowRoad: true,
+                        allowSpur: true,
+                        allowSea: false,
+                        allowFourWdLow: allowFourWdLow,
+                        out route,
+                        requiredBasin: requiredBasin))
+                    {
+                        return true;
+                    }
+                }
+            }
+
+            bool allowSea = vehicleClass == 0;
+            return TryFindRouteInternal(
+                originTownId,
+                destTownId,
+                allowRoad: true,
+                allowSpur: true,
+                allowSea: allowSea,
+                allowFourWdLow: allowFourWdLow,
+                out route,
+                requiredBasin: requiredBasin);
+        }
+
+        private bool TryFindRouteInternal(
+            uint originTownId,
+            uint destTownId,
+            bool allowRoad,
+            bool allowSpur,
+            bool allowSea,
+            bool allowFourWdLow,
+            out LogisticsRoute route,
+            string requiredBasin = OuterOceanBasin)
+        {
+            route = null;
+            if (originTownId == 0 || destTownId == 0 || originTownId == destTownId)
+                return false;
+
+            if (!string.Equals(requiredBasin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                return false;
+
+            var origin = GetTown(originTownId);
+            var dest = GetTown(destTownId);
+            if (origin == null || dest == null || string.IsNullOrEmpty(origin.NodeId) || string.IsNullOrEmpty(dest.NodeId))
+                return false;
+
+            if (!TryFindNodeRoute(origin.NodeId, dest.NodeId, allowRoad: allowRoad, allowSpur: allowSpur, allowSea: allowSea, allowFourWdLow: allowFourWdLow, out var found, requiredBasin))
+                return false;
+
+            if (found.TotalLengthM <= 0.0)
+                return false;
+
+            route = new LogisticsRoute
+            {
+                OriginNodeId = found.OriginNodeId,
+                DestNodeId = found.DestNodeId,
+                OriginTownId = originTownId,
+                DestTownId = destTownId,
+                UsesSea = found.UsesSea,
+                Uses4wdLow = found.Uses4wdLow,
+                TotalLengthM = found.TotalLengthM,
+                Waypoints = found.Waypoints,
+            };
+            return true;
+        }
+
+        public bool TryFindOverlandRoute(uint originTownId, uint destTownId, bool allowFourWdLow, out LogisticsRoute route)
+            => TryFindRoute(originTownId, destTownId, out route, allowSea: false, allowFourWdLow: allowFourWdLow, requiredBasin: OuterOceanBasin);
+
+        public bool TryFindSeaRoute(uint originPortId, uint destPortId, out LogisticsRoute route, string requiredBasin = OuterOceanBasin)
+        {
+            route = null;
+            if (originPortId == 0 || destPortId == 0 || originPortId == destPortId)
+                return false;
+
+            if (!string.Equals(requiredBasin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                return false;
+
+            var p1 = GetPort(originPortId);
+            var p2 = GetPort(destPortId);
+            if (p1 == null || p2 == null || p1.PortId == p2.PortId || IsForbiddenPortOrBasin(p1.Basin, p1.LandblockId) || IsForbiddenPortOrBasin(p2.Basin, p2.LandblockId))
+                return false;
+
+            if (!TryFindNodeRoute(p1.NodeId, p2.NodeId, allowRoad: false, allowSpur: false, allowSea: true, allowFourWdLow: false, out var found, requiredBasin))
+                return false;
+
+            if (found.TotalLengthM <= 0.0)
+                return false;
+
+            route = new LogisticsRoute
+            {
+                OriginNodeId = found.OriginNodeId,
+                DestNodeId = found.DestNodeId,
+                OriginTownId = found.OriginTownId,
+                DestTownId = found.DestTownId,
+                OriginPortId = p1.PortId,
+                DestPortId = p2.PortId,
+                UsesSea = found.UsesSea,
+                Uses4wdLow = found.Uses4wdLow,
+                TotalLengthM = found.TotalLengthM,
+                Waypoints = found.Waypoints,
+            };
+            return true;
+        }
+
+        public bool TryFindSeaRouteByLandblock(uint originPortLandblockId, uint destPortLandblockId, out LogisticsRoute route, string requiredBasin = OuterOceanBasin)
+        {
+            route = null;
+            if (!string.Equals(requiredBasin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                return false;
+            if (IsForbiddenPortOrBasin(OuterOceanBasin, originPortLandblockId) || IsForbiddenPortOrBasin(OuterOceanBasin, destPortLandblockId))
+                return false;
+
+            var p1 = GetPortByLandblock(originPortLandblockId);
+            var p2 = GetPortByLandblock(destPortLandblockId);
+            if (p1 == null || p2 == null || p1.PortId == p2.PortId)
+                return false;
+
+            return TryFindSeaRoute(p1.PortId, p2.PortId, out route, requiredBasin);
+        }
+
+        public bool TryFindNodeRoute(
+            string fromNodeId,
+            string toNodeId,
+            bool allowRoad,
+            bool allowSpur,
+            bool allowSea,
+            bool allowFourWdLow,
+            out LogisticsRoute route,
+            string requiredBasin = OuterOceanBasin)
+        {
+            route = null;
+            if (!string.Equals(requiredBasin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase))
+                return false;
+
+            if (string.IsNullOrEmpty(fromNodeId) || string.IsNullOrEmpty(toNodeId) ||
+                !_nodesById.TryGetValue(fromNodeId, out var startNode) ||
+                !_nodesById.TryGetValue(toNodeId, out var goalNode))
+            {
+                return false;
+            }
+
+            if (string.Equals(fromNodeId, toNodeId, StringComparison.OrdinalIgnoreCase))
+            {
+                route = new LogisticsRoute
+                {
+                    OriginNodeId = fromNodeId,
+                    DestNodeId = toNodeId,
+                    TotalLengthM = 0.0,
+                    Waypoints = new[]
+                    {
+                        new LogisticsRouteWaypoint
+                        {
+                            NodeId = startNode.Id,
+                            Mode = startNode.Kind,
+                            X = startNode.X,
+                            Y = startNode.Y,
+                            Z = startNode.Z,
+                            CumulativeDistanceM = 0.0,
+                        }
+                    },
+                };
+                return true;
+            }
+
+            var dist = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase) { [fromNodeId] = 0.0 };
+            var prev = new Dictionary<string, (string PrevNodeId, NavEdge Edge)>(StringComparer.OrdinalIgnoreCase);
+            var pq = new PriorityQueue<string, double>();
+            pq.Enqueue(fromNodeId, HeuristicDist(startNode, goalNode));
+
+            bool found = false;
+            while (pq.Count > 0)
+            {
+                var u = pq.Dequeue();
+                if (string.Equals(u, toNodeId, StringComparison.OrdinalIgnoreCase))
+                {
+                    found = true;
+                    break;
+                }
+
+                double du = dist[u];
+                if (!_adjacency.TryGetValue(u, out var neighbors))
+                    continue;
+
+                foreach (var (v, edge) in neighbors)
+                {
+                    if (!IsEdgeAllowed(edge, allowRoad, allowSpur, allowSea, allowFourWdLow))
+                        continue;
+
+                    double w = edge.LengthM > 0.0 ? edge.LengthM : edge.DistanceM;
+                    if (w <= 0.0) w = 1.0;
+
+                    double nd = du + w;
+                    if (!dist.TryGetValue(v, out var existingDist) || nd < existingDist)
+                    {
+                        dist[v] = nd;
+                        prev[v] = (u, edge);
+                        var vn = _nodesById[v];
+                        pq.Enqueue(v, nd + HeuristicDist(vn, goalNode));
+                    }
+                }
+            }
+
+            if (!found)
+                return false;
+
+            var chain = new List<(string NodeId, NavEdge IncomingEdge)>();
+            var cur = toNodeId;
+            while (!string.Equals(cur, fromNodeId, StringComparison.OrdinalIgnoreCase))
+            {
+                var (pNode, pEdge) = prev[cur];
+                chain.Add((cur, pEdge));
+                cur = pNode;
+            }
+            chain.Add((fromNodeId, null));
+            chain.Reverse();
+
+            var waypoints = new List<LogisticsRouteWaypoint>(chain.Count);
+            double cumDist = 0.0;
+            bool usesSea = false;
+            bool uses4wd = false;
+
+            for (int i = 0; i < chain.Count; i++)
+            {
+                var (nid, incEdge) = chain[i];
+                var node = _nodesById[nid];
+                string segMode = node.Kind;
+                if (incEdge != null)
+                {
+                    double len = incEdge.LengthM > 0.0 ? incEdge.LengthM : incEdge.DistanceM;
+                    if (len <= 0.0 && i > 0)
+                    {
+                        var prevWp = waypoints[i - 1];
+                        len = Math.Sqrt(Math.Pow(node.X - prevWp.X, 2) + Math.Pow(node.Y - prevWp.Y, 2));
+                    }
+                    cumDist += Math.Max(0.0, len);
+                    segMode = incEdge.Mode;
+                    if (string.Equals(incEdge.Mode, "sea", StringComparison.OrdinalIgnoreCase))
+                        usesSea = true;
+                    if (incEdge.Is4wdLow)
+                        uses4wd = true;
+                }
+
+                waypoints.Add(new LogisticsRouteWaypoint
+                {
+                    NodeId = node.Id,
+                    Mode = segMode,
+                    X = node.X,
+                    Y = node.Y,
+                    Z = node.Z,
+                    CumulativeDistanceM = cumDist,
+                });
+            }
+
+            route = new LogisticsRoute
+            {
+                OriginNodeId = fromNodeId,
+                DestNodeId = toNodeId,
+                UsesSea = usesSea,
+                Uses4wdLow = uses4wd,
+                TotalLengthM = cumDist,
+                Waypoints = waypoints,
+            };
+            return true;
+        }
+
+        private static bool IsEdgeAllowed(NavEdge e, bool allowRoad, bool allowSpur, bool allowSea, bool allowFourWdLow)
+        {
+            if (e == null) return false;
+            if (e.Is4wdLow && !allowFourWdLow) return false;
+
+            return e.Mode.ToLowerInvariant() switch
+            {
+                "road" => allowRoad,
+                "spur" => allowSpur,
+                "sea" => allowSea && (string.IsNullOrEmpty(e.Basin) || string.Equals(e.Basin, OuterOceanBasin, StringComparison.OrdinalIgnoreCase)),
+                _ => false,
+            };
+        }
+
+        private static double HeuristicDist(NavNode a, NavNode b)
+        {
+            double dx = a.X - b.X;
+            double dy = a.Y - b.Y;
+            return Math.Sqrt(dx * dx + dy * dy);
+        }
+
+        public static bool IsSeaSegmentAtDistance(LogisticsRoute route, double splineSM)
+        {
+            if (route == null || !route.UsesSea)
+                return false;
+            route.SampleSegmentAtDistance(splineSM, out bool isSea);
+            return isSea;
+        }
+
+        public static LogisticsPoseSample SamplePoseAtDistance(LogisticsRoute route, double splineSM)
+        {
+            if (route == null || route.Waypoints.Count == 0)
+                return default;
+
+            var wps = route.Waypoints;
+            if (wps.Count == 1 || splineSM <= 0.0)
+            {
+                double h0 = wps.Count > 1 ? ComputeHeadingRad(wps[0].X, wps[0].Y, wps[1].X, wps[1].Y) : 0.0;
+                return new LogisticsPoseSample
+                {
+                    X = wps[0].X,
+                    Y = wps[0].Y,
+                    Z = wps[0].Z,
+                    HeadingRad = h0,
+                    Mode = wps.Count > 1 ? wps[1].Mode : wps[0].Mode,
+                    LandblockId = PackLandblockIdFromGlobal(wps[0].X, wps[0].Y),
+                };
+            }
+
+            double clampedS = Math.Clamp(double.IsFinite(splineSM) ? splineSM : 0.0, 0.0, route.TotalLengthM);
+            for (int i = 1; i < wps.Count; i++)
+            {
+                var a = wps[i - 1];
+                var b = wps[i];
+                if (clampedS < b.CumulativeDistanceM || i == wps.Count - 1)
+                {
+                    double segLen = b.CumulativeDistanceM - a.CumulativeDistanceM;
+                    double t = segLen > 1e-6 ? Math.Clamp((clampedS - a.CumulativeDistanceM) / segLen, 0.0, 1.0) : 1.0;
+                    double x = a.X + (b.X - a.X) * t;
+                    double y = a.Y + (b.Y - a.Y) * t;
+                    double z = a.Z + (b.Z - a.Z) * t;
+                    double heading = ComputeHeadingRad(a.X, a.Y, b.X, b.Y);
+                    return new LogisticsPoseSample
+                    {
+                        X = x,
+                        Y = y,
+                        Z = z,
+                        HeadingRad = heading,
+                        Mode = b.Mode,
+                        LandblockId = PackLandblockIdFromGlobal(x, y),
+                    };
+                }
+            }
+
+            var last = wps[^1];
+            var prev = wps[^2];
+            return new LogisticsPoseSample
+            {
+                X = last.X,
+                Y = last.Y,
+                Z = last.Z,
+                HeadingRad = ComputeHeadingRad(prev.X, prev.Y, last.X, last.Y),
+                Mode = last.Mode,
+                LandblockId = PackLandblockIdFromGlobal(last.X, last.Y),
+            };
+        }
+
+        public static double ComputeHeadingRad(double x0, double y0, double x1, double y1)
+        {
+            double dx = x1 - x0;
+            double dy = y1 - y0;
+            if (dx * dx + dy * dy < 1e-12)
+                return 0.0;
+            return FlightModel.WrapHeading(Math.Atan2(dx, dy));
+        }
+
+        public static uint PackLandblockIdFromGlobal(double gx, double gy)
+        {
+            bool isDericost = gy >= Vehicle.DericostYOffset;
+            double localY = isDericost ? gy - Vehicle.DericostYOffset : gy;
+            int lbX = Math.Clamp((int)Math.Floor(gx / 192.0), 0, 254);
+            int lbY = Math.Clamp((int)Math.Floor(localY / 192.0), 0, 254);
+            return ((uint)lbX << 24) | ((uint)lbY << 16) | (isDericost ? 0x8000u : 0u) | 0x0001u;
+        }
+
+        public static uint NormalizePackedLandblockId(uint rawLbId, byte continentId)
+        {
+            if (rawLbId == 0)
+                return 0u;
+
+            if (rawLbId <= 0xFFFFu)
+            {
+                uint lbX = (rawLbId >> 8) & 0xFFu;
+                uint lbY = rawLbId & 0xFFu;
+                return (lbX << 24) | (lbY << 16) | (continentId == 1 ? 0x8000u : 0u) | 0x0001u;
+            }
+
+            bool isDericost = (rawLbId & 0x8000u) != 0 || continentId == 1;
+            return (rawLbId & 0xFFFF0000u) | (isDericost ? 0x8000u : 0u) | 0x0001u;
+        }
+
+        public static double ComputeOriginToDestDistanceM(uint originLandblockId, uint destTownId)
+            => SiegeManager.ComputeDistanceFromOriginToTownM(originLandblockId, destTownId);
+
+        public static bool IsProvenanceValidForTown(uint originLandblockId, uint destTownId)
+            => SiegeManager.HasValidSupplyProvenance(originLandblockId, destTownId);
+
+        private static string GetString(JsonElement el, string prop, string fallback = "")
+            => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.String ? (v.GetString() ?? fallback) : fallback;
+
+        private static int GetInt(JsonElement el, string prop, int fallback = 0)
+            => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetInt32(out var r) ? r : fallback;
+
+        private static uint GetUInt(JsonElement el, string prop, uint fallback = 0)
+            => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetUInt32(out var r) ? r : fallback;
+
+        private static double GetDouble(JsonElement el, string prop, double fallback = 0.0)
+            => el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.Number && v.TryGetDouble(out var r) ? r : fallback;
+
+        private static bool GetBool(JsonElement el, string prop, bool fallback = false)
+        {
+            if (!el.TryGetProperty(prop, out var v)) return fallback;
+            return v.ValueKind switch
+            {
+                JsonValueKind.True => true,
+                JsonValueKind.False => false,
+                _ => fallback,
+            };
+        }
+
+        private static uint ParseHexUInt(string hex)
+        {
+            if (string.IsNullOrWhiteSpace(hex)) return 0;
+            var s = hex.Trim();
+            if (s.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                s = s[2..];
+            return uint.TryParse(s, System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, out var val) ? val : 0;
+        }
+    }
+}
