+        internal static void SettleSiegeFlipTreasury(
+            uint townId,
+            uint newOwnerMonarchId,
+            uint oldOwnerMonarchId,
+            out long attackerSpoils,
+            out long defenderEvacuated)
+        {
+            attackerSpoils = 0;
+            defenderEvacuated = 0;
+            var state = GetTownState(townId);
+            if (state == null) return;
+
+            TownControl capturedSnap;
+            TownControl evacTownSnap = null;
+
+            lock (_crossTownClearinghouseLock)
+            {
+                lock (state.SyncRoot)
+                {
+                    var escrow = Math.Max(0L, state.Control.EscrowPyreals);
+                    attackerSpoils = escrow / 2L;
+                    defenderEvacuated = escrow - attackerSpoils;
+
+                    state.Control.EscrowPyreals = 0;
+                    state.Control.TreasuryPyreals += attackerSpoils;
+                    state.Control.OwnerMonarchId = newOwnerMonarchId;
+                    state.Control.AttackerMonarchId = 0;
+                    state.Control.State = "CONTROLLED";
+                    state.Control.HoldElapsedSec = 0;
+                    state.Control.SupplyMeterSec = 0;
+                    state.Control.StarvingSec = 0;
+                    state.HoldElapsedSecExact = 0.0;
+                    state.SupplyMeterSecExact = 0.0;
+                    state.StarvingSecExact = 0.0;
+                    state.DefenderHoldElapsedSec = 0.0;
+                    state.ThreeWayCandidateMonarchId = 0;
+                    state.ThreeWayHoldElapsedSec = 0.0;
+                    state.BreachMonarchId = 0;
+                    state.BreachElapsedSec = 0.0;
+                    state.ApronSupplySp = 0.0;
+                    state.InactivityElapsedSec = 0.0;
+                    state.InsolvencyGraceElapsedSec = 0.0;
+                    state.InsolventSinceUtc = null;
+                    state.LastAttackerSpoilsPyreals = attackerSpoils;
+                    state.LastDefenderEvacuatedPyreals = defenderEvacuated;
+                    state.Control.UpdatedUtc = DateTime.UtcNow;
+                    capturedSnap = CloneControl(state.Control);
+                }
+
+                if (defenderEvacuated > 0 && oldOwnerMonarchId != 0)
+                {
+                    TownRuntimeState capitalTarget = null;
+                    int bestVendorScore = -1;
+
+                    foreach (var def in TownRegistry.AllTowns)
+                    {
+                        if (def.TownId == townId) continue;
+                        if (!towns.TryGetValue(def.TownId, out var cand)) continue;
+                        lock (cand.SyncRoot)
+                        {
+                            if (cand.Control.OwnerMonarchId == oldOwnerMonarchId && def.BaseVendorCount > bestVendorScore)
+                            {
+                                bestVendorScore = def.BaseVendorCount;
+                                capitalTarget = cand;
+                            }
+                        }
+                    }
+
+                    if (capitalTarget != null)
+                    {
+                        lock (capitalTarget.SyncRoot)
+                        {
+                            if (capitalTarget.Control.State is "CONTESTED_HOLD" or "STARVING")
+                                capitalTarget.Control.EscrowPyreals += defenderEvacuated;
+                            else
+                                capitalTarget.Control.TreasuryPyreals += defenderEvacuated;
+                            capitalTarget.Control.UpdatedUtc = DateTime.UtcNow;
+                            evacTownSnap = CloneControl(capitalTarget.Control);
+                        }
+                    }
+                    else
+                    {
+                        var evacAmount = defenderEvacuated;
+                        evacuatedTreasuryByMonarch.AddOrUpdate(oldOwnerMonarchId, evacAmount, (_, prev) => prev + evacAmount);
+                    }
+                }
+            }
+
+            PersistTownControl(capturedSnap);
+            if (evacTownSnap != null)
+                PersistTownControl(evacTownSnap);
+        }
+
+        public static void RecordWarehouseDelivery(uint townId, string commodityId, int qty, int gradeBps = 10000, float freshnessPct = 100.0f, bool poweredReefer = false)
+        {
+            if (string.IsNullOrWhiteSpace(commodityId) || qty <= 0) return;
+            var state = GetTownState(townId);
+            if (state == null) return;
+
+            TownWarehouseStock whSnap;
+            TownControl ctrlSnap;
+            lock (state.SyncRoot)
+            {
+                var key = (commodityId, gradeBps, poweredReefer);
+                if (!state.Warehouses.TryGetValue(key, out var wh))
+                {
+                    wh = new TownWarehouseStock
+                    {
+                        TownId = townId,
+                        CommodityId = commodityId,
+                        GradeBps = gradeBps,
+                        Qty = 0,
+                        FreshnessPct = freshnessPct,
+                        PoweredReefer = poweredReefer,
+                    };
+                    state.Warehouses[key] = wh;
+                }
+                wh.Qty += qty;
+                wh.FreshnessPct = freshnessPct;
+                state.Control.LastDeliveryUtc = DateTime.UtcNow;
+                state.InactivityElapsedSec = 0.0;
+                if (state.Control.State == "INSOLVENT_RECEIVERSHIP")
+                {
+                    state.Control.State = "CONTROLLED";
+                    state.InsolventSinceUtc = null;
+                    state.InsolvencyGraceElapsedSec = 0.0;
+                }
+                state.Control.UpdatedUtc = DateTime.UtcNow;
