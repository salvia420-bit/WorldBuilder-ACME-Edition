+        [TestMethod]
+        public void F15_StepConvoyMacro_SubNanometerModeBoundary_TransitionsSpeedAndFuel()
+        {
+            var nav = LogisticsNavGraph.LoadDefault();
+            Assert.IsTrue(nav.TryFindRoute(1u, 61u, 0, true, out var route));
+            Assert.IsTrue(route.UsesSea);
+
+            double seaStartS = route.Waypoints.First(w => string.Equals(w.Mode, "sea", StringComparison.OrdinalIgnoreCase)).CumulativeDistanceM;
+            // Waypoint immediately preceding the first "sea" waypoint holds the exact boundary distance
+            int firstSeaIdx = -1;
+            int lastSeaIdx = -1;
+            for (int i = 0; i < route.Waypoints.Count; i++)
+            {
+                if (string.Equals(route.Waypoints[i].Mode, "sea", StringComparison.OrdinalIgnoreCase))
+                {
+                    if (firstSeaIdx < 0) firstSeaIdx = i;
+                    lastSeaIdx = i;
+                }
+            }
+            Assert.IsTrue(firstSeaIdx > 0 && lastSeaIdx > firstSeaIdx && lastSeaIdx < route.Waypoints.Count - 1);
+            seaStartS = route.Waypoints[firstSeaIdx - 1].CumulativeDistanceM;
+            double seaEndS = route.Waypoints[lastSeaIdx].CumulativeDistanceM;
+
+            // 1. Place convoy at seaStartS - 5e-10 with dt = 1.0 -> must transition onto sea leg (<= 6.25 m, not 22.0 m)
+            var c1 = LogisticsEngine.DispatchConvoy(0x50000001u, 1u, 61u, 0, out var e1, initialFuelLiters: 5000.0, explicitConvoyId: 2401u);
+            Assert.IsNotNull(c1, e1);
+            c1.SplineSM = seaStartS - 5e-10;
+            double start1 = c1.SplineSM;
+            double fuelBefore1 = c1.FuelLiters;
+            LogisticsEngine.StepMacroConvoyForTesting(2401u, 1.0);
+            double adv1 = c1.SplineSM - start1;
+            double burn1 = fuelBefore1 - c1.FuelLiters;
+            Assert.IsTrue(adv1 >= 6.19 && adv1 <= 6.25, $"Expected sea-speed step (~6.2 m) at seaStartS-5e-10, got {adv1:0.000000} m");
+            Assert.IsTrue(LogisticsNavGraph.IsSeaSegmentAtDistance(c1.Route, c1.SplineSM));
+            Assert.AreEqual(6.2 * LogisticsEngine.FeederShipFuelBurnLitersPerM, burn1, 0.002);
+
+            // 2. Compare seaStartS - 5e-10 with dt = 3600.0 against clean seaStartS + 1e-6 (must burn real sea fuel, not 22 m/s whole way)
+            var c2 = LogisticsEngine.DispatchConvoy(0x50000001u, 1u, 61u, 0, out var e2, initialFuelLiters: 5000.0, explicitConvoyId: 2402u);
+            Assert.IsNotNull(c2, e2);
+            c2.SplineSM = seaStartS - 5e-10;
+            LogisticsEngine.StepMacroConvoyForTesting(2402u, 3600.0);
+            double burn2 = 5000.0 - c2.FuelLiters;
+
+            var cRef = LogisticsEngine.DispatchConvoy(0x50000001u, 1u, 61u, 0, out var eRef, initialFuelLiters: 5000.0, explicitConvoyId: 2403u);
+            Assert.IsNotNull(cRef, eRef);
+            cRef.SplineSM = seaStartS + 1e-6;
+            LogisticsEngine.StepMacroConvoyForTesting(2403u, 3600.0);
+            double burnRef = 5000.0 - cRef.FuelLiters;
+
+            Assert.AreEqual(cRef.SplineSM, c2.SplineSM, 1.0);
+            Assert.AreEqual(burnRef, burn2, 0.05);
+            Assert.IsTrue(burn2 > 250.0, $"Expected real sea fuel burn (>250 L), got {burn2:0.00} L");
+
+            // 3. Place convoy at seaEndS - 5e-10 with dt = 1.0 -> must transition onto Dericost land leg (22.0 m/s, 0.0004 L/m)
+            var c3 = LogisticsEngine.DispatchConvoy(0x50000001u, 1u, 61u, 0, out var e3, initialFuelLiters: 5000.0, explicitConvoyId: 2404u);
+            Assert.IsNotNull(c3, e3);
+            c3.SplineSM = seaEndS - 5e-10;
+            double start3 = c3.SplineSM;
+            double fuelBefore3 = c3.FuelLiters;
+            LogisticsEngine.StepMacroConvoyForTesting(2404u, 1.0);
+            double adv3 = c3.SplineSM - start3;
+            double burn3 = fuelBefore3 - c3.FuelLiters;
+            Assert.AreEqual(22.0, adv3, 0.05, $"Expected land-speed step (~22.0 m) at seaEndS-5e-10, got {adv3:0.000000} m");
+            Assert.IsFalse(LogisticsNavGraph.IsSeaSegmentAtDistance(c3.Route, c3.SplineSM));
+            Assert.AreEqual(22.0 * LogisticsEngine.TractorFuelBurnLitersPerM, burn3, 0.001);
+        }
