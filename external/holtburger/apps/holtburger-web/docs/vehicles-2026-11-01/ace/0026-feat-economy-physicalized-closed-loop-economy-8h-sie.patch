+            using (var context = new ShardDbContext())
+            {
+                var clampedGrade = Math.Clamp(snapshot.GradeBps, 0, 10000);
+                var clampedTonnes = float.IsFinite(snapshot.RemainingTonnes) ? Math.Max(0.0f, snapshot.RemainingTonnes) : 0.0f;
