+
+        public static double ComputeDistanceFromOriginToTownM(uint originLandblockId, uint townId, bool isPacked32Bit)
+        {
+            if (originLandblockId == 0)
+                return 0.0;
+
+            var def = TownRegistry.GetById(townId);
+            if (def == null)
+                return 0.0;
+
+            uint lbX, lbY;
+            bool isDericost;
+            if (isPacked32Bit)
+            {
+                lbX = (originLandblockId >> 24) & 0xFFu;
+                lbY = (originLandblockId >> 16) & 0xFFu;
+                isDericost = (originLandblockId & 0x8000u) != 0;
+            }
+            else
+            {
+                lbX = (originLandblockId >> 8) & 0xFFu;
+                lbY = originLandblockId & 0xFFu;
+                isDericost = def.ContinentId == 1;
+            }
+
+            double ox = lbX * 192.0 + 96.0;
+            double oy = (isDericost ? Vehicle.DericostYOffset : 0.0) + lbY * 192.0 + 96.0;
+            double dx = ox - def.WorldX;
+            double dy = oy - def.WorldY;
+            return Math.Sqrt(dx * dx + dy * dy);
+        }
+
+        public static double ComputeDistanceFromOriginToTownM(uint originLandblockId, uint townId, int originContinentId)
+        {
+            if (originLandblockId == 0)
+                return 0.0;
+
+            var def = TownRegistry.GetById(townId);
+            if (def == null)
+                return 0.0;
+
+            bool isDericost = originContinentId == 1;
+            uint lbX, lbY;
+            if (originLandblockId == 0x00000001u || (originLandblockId == 0x00008001u && isDericost))
+            {
+                lbX = 0u;
+                lbY = 0u;
+            }
+            else if (originLandblockId <= 0xFFFFu)
+            {
+                lbX = (originLandblockId >> 8) & 0xFFu;
+                lbY = originLandblockId & 0xFFu;
+            }
+            else
+            {
+                lbX = (originLandblockId >> 24) & 0xFFu;
+                lbY = (originLandblockId >> 16) & 0xFFu;
+                isDericost = (originLandblockId & 0x8000u) != 0 || isDericost;
+            }
+
+            double ox = lbX * 192.0 + 96.0;
+            double oy = (isDericost ? Vehicle.DericostYOffset : 0.0) + lbY * 192.0 + 96.0;
+            double dx = ox - def.WorldX;
+            double dy = oy - def.WorldY;
+            return Math.Sqrt(dx * dx + dy * dy);
+        }
