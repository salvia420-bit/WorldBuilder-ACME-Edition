+        private static bool HandleBounty(Player player, string[] args, out string message)
+        {
+            if (args.Length < 4)
+            {
+                message = "Usage: @town bounty <town> <itemWcid> <rewardPyreals> <maxQty> [commodityId]";
+                return false;
+            }
+
+            // Optional trailing commodityId if non-numeric
+            int numericEnd = args.Length;
+            string commodityId = null;
+            if (args.Length >= 5 && !int.TryParse(args[^1], NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
+            {
+                commodityId = args[^1];
+                numericEnd = args.Length - 1;
+            }
+
+            if (numericEnd < 4 ||
+                !uint.TryParse(args[numericEnd - 3], NumberStyles.Integer, CultureInfo.InvariantCulture, out var itemWcid) ||
+                !long.TryParse(args[numericEnd - 2], NumberStyles.Integer, CultureInfo.InvariantCulture, out var rewardPyreals) ||
+                !int.TryParse(args[numericEnd - 1], NumberStyles.Integer, CultureInfo.InvariantCulture, out var maxQty))
+            {
+                message = "Usage: @town bounty <town> <itemWcid> <rewardPyreals> <maxQty> [commodityId]";
+                return false;
+            }
+
+            var townName = string.Join(' ', args.Take(numericEnd - 3));
+            var def = ResolveTownArg(player, townName);
+            if (def == null)
+            {
+                message = $"Unknown town '{townName}'.";
+                return false;
+            }
+
+            if (!CanModifyTownPolicy(player, def.TownId))
+            {
+                message = $"Rejected: Only the owning Allegiance Monarch may configure procurement bounties in {def.Name}.";
+                return false;
+            }
+
+            var monarchId = ResolveEffectiveMonarchId(player);
+            TownEconomyManager.SetProcurementBountyOrder(def.TownId, itemWcid, commodityId ?? $"trophy_{itemWcid}", rewardPyreals, maxQty, monarchId);
