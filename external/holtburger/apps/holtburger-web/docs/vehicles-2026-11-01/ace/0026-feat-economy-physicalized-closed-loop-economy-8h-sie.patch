+        public static bool TryTransferTreasury(uint fromTownId, uint toTownId, uint monarchId, long amount, out string error)
+        {
+            EnsureInitialized();
+            if (amount <= 0)
+            {
+                error = "Transfer amount must be positive.";
+                return false;
+            }
+            if (fromTownId == 0 || toTownId == 0 || fromTownId == toTownId)
+            {
+                error = "Source and destination towns must be distinct valid towns.";
+                return false;
+            }
+
+            var fromState = GetTownState(fromTownId);
+            var toState = GetTownState(toTownId);
+            if (fromState == null || toState == null)
+            {
+                error = "Town not found.";
+                return false;
+            }
+
+            TownControl fromSnap;
+            TownControl toSnap;
+            bool transferred = false;
+
+            lock (_crossTownClearinghouseLock)
+            {
+                lock (fromState.SyncRoot)
+                {
+                    if (fromState.Control.OwnerMonarchId == 0 || fromState.Control.OwnerMonarchId != monarchId)
+                    {
+                        error = "Only the owning Monarch may transfer treasury funds out of the source town.";
+                        return false;
+                    }
+                    if (fromState.Control.State is "CONTESTED_HOLD" or "STARVING")
+                    {
+                        error = "Source town treasury is frozen in siege escrow.";
+                        return false;
+                    }
+                    var spendable = Math.Max(0L, fromState.Control.TreasuryPyreals - fromState.Control.ClearinghouseReservePyreals);
+                    if (spendable < amount)
+                    {
+                        error = $"Insufficient spendable treasury in {fromState.Control.Name} ({spendable:N0}p available after {fromState.Control.ClearinghouseReservePyreals:N0}p Clearinghouse Reserve).";
+                        return false;
+                    }
+
+                    fromState.Control.TreasuryPyreals -= amount;
+                    fromState.Control.UpdatedUtc = DateTime.UtcNow;
+                    fromSnap = CloneControl(fromState.Control);
+                }
+
+                bool destinationValid = false;
+                string destError = null;
+                toSnap = null;
+                lock (toState.SyncRoot)
+                {
+                    if (toState.Control.OwnerMonarchId == 0 || toState.Control.OwnerMonarchId != monarchId)
+                    {
+                        destError = "Destination town is not owned by the same Monarch.";
+                    }
+                    else if (toState.Control.State is "CONTESTED_HOLD" or "STARVING")
+                    {
+                        destError = "Destination town treasury is frozen in siege escrow.";
+                    }
+                    else
+                    {
+                        var now = DateTime.UtcNow;
+                        toState.Control.TreasuryPyreals += amount;
+                        RecoverInsolvencyOnSpendableInflowLocked(toState, now);
+                        toState.Control.UpdatedUtc = now;
+                        toSnap = CloneControl(toState.Control);
+                        destinationValid = true;
+                    }
+                }
+
+                if (!destinationValid)
+                {
+                    lock (fromState.SyncRoot)
+                    {
+                        if (fromState.Control.State is "CONTESTED_HOLD" or "STARVING")
+                            fromState.Control.EscrowPyreals += amount;
+                        else
+                            fromState.Control.TreasuryPyreals += amount;
+                        fromState.Control.UpdatedUtc = DateTime.UtcNow;
+                        fromSnap = CloneControl(fromState.Control);
+                    }
+                    error = destError;
+                }
+                else
+                {
+                    error = null;
+                    transferred = true;
+                }
+            }
+
+            PersistTownControl(fromSnap);
+            if (!transferred)
+                return false;
+
+            if (toSnap != null) PersistTownControl(toSnap);
+            return true;
+        }
