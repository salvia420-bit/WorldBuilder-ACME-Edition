+                _activePort = targetPort;
+                _listener = listener;
+                _cts = new CancellationTokenSource();
+                _isRunning = true;
+                var token = _cts.Token;
+                _acceptTask = Task.Run(() => AcceptLoopAsync(listener, token), token);
+                log.Info($"[AGENT_GATEWAY] Listening strictly on {Prefix} (loopback only).");
