+        public static SubsurfaceBasin GetBasinById(string basinId)
+        {
+            if (string.IsNullOrWhiteSpace(basinId)) return null;
+            for (int i = 0; i < Basins.Count; i++)
+            {
+                if (string.Equals(Basins[i].BasinId, basinId, StringComparison.OrdinalIgnoreCase))
+                    return Basins[i];
+            }
+            return null;
+        }
+
+        public static SubsurfaceBasin GetBasinForLandblock(uint landblockId)
+        {
+            byte continent = (landblockId > 0xFFFFu && (landblockId & 0x8000u) != 0) ? (byte)1 : (byte)0;
+            var (wx, wy) = UnpackGlobalCenter(landblockId, continent);
+
+            SubsurfaceBasin best = null;
+            double bestDistSq = double.MaxValue;
+            for (int i = 0; i < Basins.Count; i++)
+            {
+                var b = Basins[i];
+                if (b.ContinentId != continent) continue;
+                double dx = wx - b.WorldX;
+                double dy = wy - b.WorldY;
+                double dSq = dx * dx + dy * dy;
+                if (dSq < bestDistSq)
+                {
+                    bestDistSq = dSq;
+                    best = b;
+                }
+            }
+            return best ?? Basins[0];
+        }
+
+        public static SubsurfaceBasin GetBasinForTerrain(uint landblockId, byte terrainCode)
+        {
+            byte continent = (landblockId > 0xFFFFu && (landblockId & 0x8000u) != 0) ? (byte)1 : (byte)0;
+            var (wx, wy) = UnpackGlobalCenter(landblockId, continent);
+
+            SubsurfaceBasin bestMatchingTerrain = null;
+            double bestMatchDistSq = double.MaxValue;
+            SubsurfaceBasin nearest = null;
+            double nearestDistSq = double.MaxValue;
+
+            for (int i = 0; i < Basins.Count; i++)
+            {
+                var b = Basins[i];
+                if (b.ContinentId != continent) continue;
+
+                double dx = wx - b.WorldX;
+                double dy = wy - b.WorldY;
+                double dSq = dx * dx + dy * dy;
+
+                if (dSq < nearestDistSq)
+                {
+                    nearestDistSq = dSq;
+                    nearest = b;
+                }
+
+                if (b.TerrainCodes != null && Array.IndexOf(b.TerrainCodes, terrainCode) >= 0 && dSq < bestMatchDistSq)
+                {
+                    bestMatchDistSq = dSq;
+                    bestMatchingTerrain = b;
+                }
+            }
+
+            if (nearest != null && nearestDistSq <= (192.0 * 12.0) * (192.0 * 12.0))
+                return nearest;
+
+            return bestMatchingTerrain ?? nearest ?? Basins[0];
+        }
+
+        public static bool IsWetMarshTerrainCode(byte terrainCode)
+        {
+            if (terrainCode is 4 or 5 or 16 or 17 or 18 or 19 or 20 or 22 or 23)
+                return true;
+            if (terrainCode < VehicleTerrain.TerrainTypeToSurfaceFamily.Length)
+            {
+                var fam = VehicleTerrain.TerrainTypeToSurfaceFamily[terrainCode];
+                return fam == 6 || fam == 7; // Swamp or ShallowFord
+            }
+            return false;
+        }
+
+        public static bool IsWetMarshAttenuated(uint landblockId, byte terrainCode)
+        {
+            if (IsWetMarshTerrainCode(terrainCode))
+                return true;
+
+            var basin = GetBasinForLandblock(landblockId);
+            return basin != null && basin.IsWetMarsh;
+        }
