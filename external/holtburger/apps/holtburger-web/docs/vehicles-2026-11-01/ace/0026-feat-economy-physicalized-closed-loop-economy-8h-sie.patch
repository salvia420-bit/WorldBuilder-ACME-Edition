+        private static void ApplyThreeWayResetLocked(TownRuntimeState state, uint newAttackerMonarchId, DateTime now)
+        {
+            state.Control.AttackerMonarchId = newAttackerMonarchId;
+            state.Control.HoldElapsedSec = 0;
+            state.HoldElapsedSecExact = 0.0;
+            state.Control.StarvingSec = 0;
+            state.StarvingSecExact = 0.0;
+            state.SupplyMeterSecExact = SupplyMeterMaxSec;
+            state.Control.SupplyMeterSec = (int)SupplyMeterMaxSec;
+            state.Control.State = "CONTESTED_HOLD";
+            state.DefenderHoldElapsedSec = 0.0;
+            state.ThreeWayCandidateMonarchId = 0;
+            state.ThreeWayHoldElapsedSec = 0.0;
+            state.ApronSupplySp = 0.0;
+            state.SupplyLowAlertSent = false;
+            state.Control.UpdatedUtc = now;
+        }
