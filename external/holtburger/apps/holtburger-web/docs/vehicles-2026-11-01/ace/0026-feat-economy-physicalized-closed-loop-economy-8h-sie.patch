+        public static SubsurfaceDeposit GetDeposit(ulong depositId)
+        {
+            EnsureInitialized();
+            if (deposits.TryGetValue(depositId, out var dep))
+            {
+                var gate = depositLocks.GetOrAdd(depositId, _ => new object());
+                lock (gate)
+                    return CloneDeposit(dep);
+            }
+            return null;
+        }
+
+        public static SubsurfaceDeposit FindNearestDeposit(uint landblockId, bool shallowOnly = false)
+        {
+            EnsureInitialized();
+            var basin = GetBasinForLandblock(landblockId);
+            var candidates = deposits.Values
+                .Where(d => string.Equals(d.BasinId, basin.BasinId, StringComparison.OrdinalIgnoreCase))
+                .ToList();
+
+            if (shallowOnly)
+                candidates = candidates.Where(d => d.DepthM <= ShallowGprMaxDepthM).ToList();
+
+            if (candidates.Count == 0 && !shallowOnly)
+                candidates = deposits.Values.ToList();
+
+            if (candidates.Count == 0)
+                return null;
+
+            var (wx, wy) = UnpackGlobalCenter(landblockId, basin.ContinentId);
+            return candidates
+                .OrderBy(d =>
+                {
+                    var (dx, dy) = UnpackGlobalCenter(d.LandblockId, basin.ContinentId);
+                    return (wx - dx) * (wx - dx) + (wy - dy) * (wy - dy);
+                })
+                .FirstOrDefault();
+        }
