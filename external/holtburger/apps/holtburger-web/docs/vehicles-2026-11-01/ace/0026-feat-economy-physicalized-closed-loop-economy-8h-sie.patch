+            var targetArg = string.Join(' ', args.Take(args.Length - 1)).Trim();
+            if (string.IsNullOrWhiteSpace(targetArg))
+            {
+                message = "Target Monarch ID or name required.";
+                return false;
+            }
+
+            var monarchId = ResolveEffectiveMonarchId(player);
+            var policy = RadarIff.GetOrCreateMonarchPolicy(monarchId);
+
+            if (uint.TryParse(targetArg, NumberStyles.Integer, CultureInfo.InvariantCulture, out var targetMonarchId) && targetMonarchId != 0)
+            {
+                policy.SetStanding(targetMonarchId, standing);
+                var targetPlayer = PlayerManager.FindByGuid(targetMonarchId);
+                if (!string.IsNullOrWhiteSpace(targetPlayer?.Name))
+                    policy.SetStanding(targetPlayer.Name, standing);
+            }
+            else
+            {
+                policy.SetStanding(targetArg, standing);
+                var targetPlayer = PlayerManager.FindByName(targetArg);
+                if (targetPlayer is Player tp)
+                {
+                    var resolvedTargetMonarch = ResolveEffectiveMonarchId(tp);
+                    if (resolvedTargetMonarch != 0)
