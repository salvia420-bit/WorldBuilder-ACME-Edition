+        public bool CanPowerUnit(DeployableBase unit, float tickWindowSeconds = 1.0f)
+        {
+            if (unit == null || unit.IsDestroyed || unit.IsPacked || unit.IsStowed)
+                return false;
+            if (!IsPodActive)
+                return false;
+            if (!float.IsFinite(tickWindowSeconds) || tickWindowSeconds <= 0.0f)
+                tickWindowSeconds = 1.0f;
+
+            float additionalLoad = 0.0f;
+            if (!unit.IsActive && IsPowerConsumer(unit.Kind))
+            {
+                if (unit.Kind == DeployableKind.GroundRadar) additionalLoad = 500.0f;
+                else if (unit.Kind == DeployableKind.MissileTurret) additionalLoad = 1500.0f;
+                else if (unit.Kind == DeployableKind.MortarTurret) additionalLoad = 800.0f;
+                else if (unit.Kind == DeployableKind.HeavyLaserTurret) additionalLoad = 2000.0f;
+                else if (unit is PumpjackTreeDeployable pj) additionalLoad = pj.ArtificialLiftRequired ? 15_000.0f : 0.0f;
