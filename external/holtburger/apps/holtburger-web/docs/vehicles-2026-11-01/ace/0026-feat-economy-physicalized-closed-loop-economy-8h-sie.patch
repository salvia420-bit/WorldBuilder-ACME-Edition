+        /// <summary>
+        /// Computes finite available quantity for GameEventApproachVendor serialization.
+        /// Returns 0 for unstocked cold-start items (never -1).
+        /// </summary>
+        public static int GetAvailableVendorItemQuantity(uint townId, uint vendorGuid, WorldObject item)
+        {
+            if (item == null || townId == 0)
+                return 0;
+
+            if (item.WeenieType == WeenieType.Coin || item.WeenieClassId == PyrealWcid)
+                return 0;
+
+            var state = GetTownState(townId);
+            if (state == null)
+                return 0;
+
+            lock (state.SyncRoot)
+            {
+                if (item.ItemType == ItemType.PromissoryNote)
+                {
+                    var parchment = CountTownSupplyLocked(state, vendorGuid, ParchmentWcid, ParchmentCommodities);
+                    var ink = CountTownSupplyAnyLocked(state, vendorGuid, InkWcids, InkCommodities);
+                    return Math.Min(parchment, ink);
+                }
+
+                if (item.GetProperty(PropertyBool.VendorService) == true)
+                {
+                    var spell = TryResolveSpellSafe(item.SpellDID ?? 0);
+                    return CountServiceReagentsLocked(state, vendorGuid, spell);
+                }
+
+                var directStock = state.Ledgers.TryGetValue((vendorGuid, item.WeenieClassId), out var ledger)
+                    ? Math.Max(0, ledger.StockQty)
+                    : 0;
+
+                if (item.WeenieType == WeenieType.Scroll)
+                {
+                    var spell = TryResolveSpellSafe(item.SpellDID ?? 0);
+                    var craftable = CountScrollReagentsLocked(state, vendorGuid, spell);
+                    return Math.Max(directStock, craftable);
+                }
+
+                return directStock;
+            }
+        }
