+        public static List<(uint WeenieClassId, ItemType? ItemType, long UnitValue, int ConsumeCount)> SnapshotConsumeItems(
+            Player player,
+            IEnumerable<ACE.Server.Entity.WorldObjectInfo<int>> consumeItems)
+        {
+            var result = new List<(uint, ItemType?, long, int)>();
+            if (player == null || consumeItems == null)
+                return result;
+
+            foreach (var ci in consumeItems)
+            {
+                var wo = ci.TryGetWorldObject() ?? player.FindObject(ci.Guid.Full, Player.SearchLocations.MyInventory);
+                if (wo == null) continue;
+                var unitVal = wo.StackUnitValue ?? (wo.IsTradeNote ? GetTradeNoteDenomination(wo.WeenieClassId) : 1L);
+                result.Add((wo.WeenieClassId, wo.ItemType, unitVal, ci.Value));
+            }
+            return result;
+        }
