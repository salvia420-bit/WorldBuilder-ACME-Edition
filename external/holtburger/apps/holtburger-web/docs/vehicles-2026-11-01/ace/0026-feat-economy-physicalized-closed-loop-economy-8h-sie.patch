+        public static EconomyTownStateMsg BuildTownStateMsg(uint townId)
+        {
+            var state = GetTownState(townId);
+            if (state == null) return null;
+
+            lock (state.SyncRoot)
+            {
+                byte flags = 0;
+                if (state.Control.State is "CONTESTED_HOLD" or "STARVING") flags |= 0x01; // Escrowed
+                if (state.Control.State == "STARVING") flags |= 0x02; // TurretsBrownedOut
+                if (state.Control.State == "INSOLVENT_RECEIVERSHIP") flags |= 0x04;
+
+                return new EconomyTownStateMsg
+                {
+                    TownId = state.Control.TownId,
+                    ControlState = MapControlStateByte(state.Control.State),
+                    OwnerMonarchId = state.Control.OwnerMonarchId,
+                    AttackerMonarchId = state.Control.AttackerMonarchId,
+                    Flags = flags,
+                    Reserved = 0,
+                    AnchorLandblock = state.Control.AnchorLandblock,
+                    HoldElapsedSec = (uint)Math.Max(0, state.Control.HoldElapsedSec),
+                    SupplyMeterSec = (uint)Math.Max(0, state.Control.SupplyMeterSec),
+                    StarvingSec = (uint)Math.Max(0, state.Control.StarvingSec),
+                    TreasuryPyreals = (ulong)Math.Max(0L, state.Control.TreasuryPyreals),
+                    EscrowPyreals = (ulong)Math.Max(0L, state.Control.EscrowPyreals),
+                    TariffBuyMul = state.Control.TariffBuyMul,
+                    TariffSellMul = state.Control.TariffSellMul,
+                };
+            }
+        }
