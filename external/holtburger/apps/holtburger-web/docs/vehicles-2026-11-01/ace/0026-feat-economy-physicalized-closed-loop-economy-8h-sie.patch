+        public static void BeginZeroNoticeBreachForTesting(uint townId, uint attackerMonarchId, long treasuryPyreals)
+        {
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null) return;
+
+            lock (state.SyncRoot)
+            {
+                uint defender = state.Control.OwnerMonarchId != 0 && state.Control.OwnerMonarchId != attackerMonarchId
+                    ? state.Control.OwnerMonarchId
+                    : (attackerMonarchId == 100u ? 1u : 100u);
+
+                state.Control.OwnerMonarchId = defender;
+                state.Control.AttackerMonarchId = 0;
+                state.Control.State = "CONTROLLED";
+                state.Control.TreasuryPyreals = Math.Max(0L, treasuryPyreals);
+                state.Control.EscrowPyreals = 0;
+                state.Control.HoldElapsedSec = 0;
+                state.Control.SupplyMeterSec = 0;
+                state.Control.StarvingSec = 0;
+                state.HoldElapsedSecExact = 0.0;
+                state.SupplyMeterSecExact = 0.0;
+                state.StarvingSecExact = 0.0;
+                state.BreachMonarchId = attackerMonarchId;
+                state.BreachElapsedSec = 0.0;
+                state.CooldownMonarchId = 0;
+                state.CooldownRemainingSec = 0.0;
+                state.Control.CooldownUntilUtc = null;
+                state.DefenderHoldElapsedSec = 0.0;
+                state.ThreeWayCandidateMonarchId = 0;
+                state.ThreeWayHoldElapsedSec = 0.0;
+                state.ApronSupplySp = 0.0;
+                state.LastAttackerSpoilsPyreals = 0;
+                state.LastDefenderEvacuatedPyreals = 0;
+                state.SupplyLowAlertSent = false;
+                state.AlertCount = 0;
