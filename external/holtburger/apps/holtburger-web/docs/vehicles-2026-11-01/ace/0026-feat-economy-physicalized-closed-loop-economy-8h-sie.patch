+        [TestMethod]
+        public void F2_ResolveTown_ExemptsPureDungeonsButPreservesOverworldShopInteriorsAndApartments()
+        {
+            // Town building interior on overworld landblocks MUST resolve to town (not exempt!)
+            var holtburgShop = TownRegistry.ResolveTown(0xA9B40101u, 10f, 10f);
+            Assert.IsNotNull(holtburgShop);
+            Assert.AreEqual("Holtburg", holtburgShop.Name);
+
+            var yaraqShop = TownRegistry.ResolveTown(0x7D640102u, 20f, 20f);
+            Assert.IsNotNull(yaraqShop);
+            Assert.AreEqual("Yaraq", yaraqShop.Name);
+
+            // Pure dungeon landblocks MUST return null (exempt)
+            Assert.IsNull(TownRegistry.ResolveTown(0x00070143u, 0f, 0f)); // Town Network
+            Assert.IsNull(TownRegistry.ResolveTown(0x88040100u, 0f, 0f)); // Marketplace
+            Assert.IsNull(TownRegistry.ResolveTown(0x596B0100u, 0f, 0f)); // Gauntlet Ticket Dungeon
+            Assert.IsNull(TownRegistry.ResolveTown(0x00B70100u, 0f, 0f)); // Celestial Hand Society
+            Assert.IsNull(TownRegistry.ResolveTown(0x89F40100u, 0f, 0f)); // Indoor dungeon 0x89F4
+
+            // Dericost outdoor cell resolves to Dericost town
+            var vasmora = TownRegistry.ResolveTown(0x2CB28001u, 10f, 10f);
+            Assert.IsNotNull(vasmora);
+            Assert.AreEqual("Vasmora", vasmora.Name);
+
+            // Dericost indoor cell (0x8000 bit set + indoor cell >= 0x100) MUST still resolve to Dericost (not Dereth!)
+            Assert.IsFalse(TownRegistry.IsDungeonCell(0x2CB28100u));
+            var vasmoraIndoor = TownRegistry.ResolveTown(0x2CB28100u, 10f, 10f);
+            Assert.IsNotNull(vasmoraIndoor);
+            Assert.AreEqual("Dericost", vasmoraIndoor.Continent);
+            Assert.AreEqual("Vasmora", vasmoraIndoor.Name);
+
+            // CurrentLandblock.IsDungeon == true MUST exempt non-SlumLord WorldObjects even outside static landblock ranges
+            var dungeonLb = (ACE.Server.Entity.Landblock)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Entity.Landblock));
+            typeof(ACE.Server.Entity.Landblock).GetField("isDungeon", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(dungeonLb, (bool?)true);
+            var dungeonVendor = (GenericObject)RuntimeHelpers.GetUninitializedObject(typeof(GenericObject));
+            var dungeonBiota = new ACE.Entity.Models.Biota
+            {
+                Id = 0x71009999u,
+                WeenieClassId = 666,
+                WeenieType = WeenieType.Vendor,
+                PropertiesInt = new Dictionary<PropertyInt, int>(),
+                PropertiesFloat = new Dictionary<PropertyFloat, double>(),
+                PropertiesBool = new Dictionary<PropertyBool, bool>(),
+                PropertiesDID = new Dictionary<PropertyDataId, uint>(),
+                PropertiesString = new Dictionary<PropertyString, string>(),
+                PropertiesPosition = new Dictionary<PositionType, PropertiesPosition>(),
+            };
+            typeof(WorldObject).GetField("<Guid>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(dungeonVendor, new ObjectGuid(0x71009999u));
+            typeof(WorldObject).GetField("<Biota>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(dungeonVendor, dungeonBiota);
+            typeof(WorldObject).GetField("ephemeralPositions", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(dungeonVendor, new Dictionary<PositionType, Position>());
+            typeof(WorldObject).GetField("positionCache", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(dungeonVendor, new Dictionary<PositionType, Position>());
+            typeof(WorldObject).GetField("BiotaDatabaseLock", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.SetValue(dungeonVendor, new System.Threading.ReaderWriterLockSlim());
+            typeof(WorldObject).GetProperty("CurrentLandblock", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.SetValue(dungeonVendor, dungeonLb);
+            dungeonVendor.Location = new Position(0x65440100u, 10f, 10f, 10f, 0f, 0f, 0f, 1f);
+            Assert.IsNull(TownRegistry.ResolveTown(dungeonVendor));
+
+            // Minor hamlet between Cragstone and Holtburg falls back to nearest Dereth town via SOI
+            var minorHamlet = TownRegistry.ResolveTown(0xA9B30001u, 50f, 50f);
+            Assert.IsNotNull(minorHamlet);
+            Assert.AreEqual("Dereth", minorHamlet.Continent);
+
+            // Apartment blocks resolve for Slumlords (includeApartments: true) while exempt for non-Slumlords
+            Assert.IsNull(TownRegistry.ResolveTown(0x53600100u, 0f, 0f, includeApartments: false));
+            var sanctumTown = TownRegistry.ResolveTown(0x53600100u, 0f, 0f, includeApartments: true);
+            Assert.IsNotNull(sanctumTown);
+            Assert.AreEqual("Cragstone", sanctumTown.Name);
+
+            var atriumTown = TownRegistry.ResolveTown(0x72000100u, 0f, 0f, includeApartments: true);
+            Assert.IsNotNull(atriumTown);
