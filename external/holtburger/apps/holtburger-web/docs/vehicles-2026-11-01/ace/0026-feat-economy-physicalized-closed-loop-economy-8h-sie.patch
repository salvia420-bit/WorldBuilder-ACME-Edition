+        public static void RecordFacilityState(DeployableBase dep, uint townId = 0, ulong depositId = 0, string activeRecipeId = "")
+        {
+            if (dep == null) return;
+            uint monarchId = dep.OwnerMonarchId != 0
+                ? dep.OwnerMonarchId
+                : (dep.DeployerMonarchId != 0 ? dep.DeployerMonarchId : 1u);
+
+            float ratedWatts = Math.Abs(GetPowerSpecWatts(dep.Wcid));
+            float ratedKw = Math.Max(0.0f, ratedWatts / 1000.0f);
+            uint effectiveTownId = townId != 0
+                ? townId
+                : (dep.AffiliatedTownId != 0 ? dep.AffiliatedTownId : (dep.Location != null ? (TownRegistry.ResolveTown(dep.Location)?.TownId ?? 0u) : 0u));
+
+            var snap = new IndustryFacility
+            {
+                FacilityGuid = dep.Guid.Full,
+                Wcid = dep.Wcid,
+                OwnerMonarchId = monarchId,
+                TownId = effectiveTownId,
+                DepositId = depositId,
+                ActiveRecipeId = activeRecipeId ?? "",
+                PowerKw = ratedKw,
+                UpdatedUtc = DateTime.UtcNow,
+            };
+
+            facilities[snap.FacilityGuid] = CloneFacility(snap);
+            PersistFacility(snap);
+        }
