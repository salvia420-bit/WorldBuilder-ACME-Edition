+        private static (double wx, double wy) UnpackGlobalCenter(uint landblockId, byte? explicitContinent = null)
+        {
+            uint lbX;
+            uint lbY;
+            bool isDericost;
+
+            if (landblockId <= 0xFFFFu && landblockId != 0x0001u && landblockId != 0x8001u)
+            {
+                lbX = (landblockId >> 8) & 0xFFu;
+                lbY = landblockId & 0xFFu;
+                isDericost = explicitContinent == 1;
+            }
+            else
+            {
+                lbX = (landblockId >> 24) & 0xFFu;
+                lbY = (landblockId >> 16) & 0xFFu;
+                isDericost = explicitContinent.HasValue
+                    ? explicitContinent.Value == 1
+                    : (landblockId & 0x8000u) != 0;
+            }
+
+            double wx = lbX * 192.0 + 96.0;
+            double wy = (isDericost ? Vehicle.DericostYOffset : 0.0) + lbY * 192.0 + 96.0;
+            return (wx, wy);
+        }
