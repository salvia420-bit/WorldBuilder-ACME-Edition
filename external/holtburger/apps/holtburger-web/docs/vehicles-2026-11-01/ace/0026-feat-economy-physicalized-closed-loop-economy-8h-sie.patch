+        public static void AdvanceRingHold(uint townId, uint? uncontestedMonarchId, double elapsedSeconds, DateTime? nowOverride = null)
+            => AdvanceRingHoldCore(townId, uncontestedMonarchId, elapsedSeconds, nowOverride);
+
+        private static bool AdvanceRingHoldCore(uint townId, uint? uncontestedMonarchId, double elapsedSeconds, DateTime? nowOverride = null)
+        {
+            if (!double.IsFinite(elapsedSeconds) || elapsedSeconds <= 0.0)
+                return false;
+
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null) return false;
+
+            var now = nowOverride ?? DateTime.UtcNow;
+            TownControl snap = null;
+            TownWarehouseStock whSnap = null;
+            string alertTitle = null;
+            string alertBody = null;
+            bool stateTransitioned = false;
+
+            lock (state.SyncRoot)
+            {
+                if (!uncontestedMonarchId.HasValue || uncontestedMonarchId.Value == 0)
+                {
+                    // Contested / empty ring resets uncontested hold timers
+                    state.BreachMonarchId = 0;
+                    state.BreachElapsedSec = 0.0;
+                    state.DefenderHoldElapsedSec = 0.0;
+                    state.ThreeWayCandidateMonarchId = 0;
+                    state.ThreeWayHoldElapsedSec = 0.0;
+                    return false;
+                }
+
+                uint holder = uncontestedMonarchId.Value;
+
+                if (state.Control.State == "CONTROLLED")
+                {
+                    if (holder == state.Control.OwnerMonarchId)
+                    {
+                        state.BreachMonarchId = 0;
+                        state.BreachElapsedSec = 0.0;
+                        return false;
+                    }
+
+                    if (holder == state.CooldownMonarchId && state.CooldownRemainingSec > 0.0)
+                        return false;
+
+                    if (state.BreachMonarchId != holder)
+                    {
+                        state.BreachMonarchId = holder;
+                        state.BreachElapsedSec = 0.0;
+                    }
+
+                    state.BreachElapsedSec += elapsedSeconds;
+                    if (state.BreachElapsedSec >= BreachGateSec)
+                    {
+                        EnterContestedHoldLocked(state, holder, now, out alertTitle, out alertBody);
+                        snap = TownEconomyManager.CloneControlSnapshot(state.Control);
+                        stateTransitioned = true;
+                    }
+                }
+                else if (state.Control.State is "CONTESTED_HOLD" or "STARVING")
+                {
+                    if (holder == state.Control.OwnerMonarchId)
+                    {
+                        state.ThreeWayCandidateMonarchId = 0;
+                        state.ThreeWayHoldElapsedSec = 0.0;
+                        state.DefenderHoldElapsedSec += elapsedSeconds;
+                        if (state.DefenderHoldElapsedSec >= BreachGateSec)
+                        {
+                            // Defender breaks siege: restore escrow + seize 50% of remaining apron supplies
+                            TownEconomyManager.RestoreEscrowToTreasuryLocked(state);
+                            double seizedSp = state.ApronSupplySp * 0.5;
+                            state.LastDefenderSeizedSupplySp = seizedSp;
+                            state.ApronSupplySp = 0.0;
+
+                            int seizedQty = (int)Math.Round(seizedSp, MidpointRounding.AwayFromZero);
+                            if (seizedQty > 0)
+                            {
+                                var key = ("siege_supply", 10000, false);
+                                if (!state.Warehouses.TryGetValue(key, out var wh))
+                                {
+                                    wh = new TownWarehouseStock
+                                    {
+                                        TownId = townId,
+                                        CommodityId = "siege_supply",
+                                        GradeBps = 10000,
+                                        Qty = 0,
+                                        FreshnessPct = 100.0f,
+                                        PoweredReefer = false,
+                                    };
+                                    state.Warehouses[key] = wh;
+                                }
+                                wh.Qty += seizedQty;
+                                whSnap = TownEconomyManager.CloneWarehouseSnapshot(wh);
+                            }
+
+                            state.Control.State = "CONTROLLED";
+                            state.Control.AttackerMonarchId = 0;
+                            state.Control.HoldElapsedSec = 0;
+                            state.Control.SupplyMeterSec = 0;
+                            state.Control.StarvingSec = 0;
+                            state.HoldElapsedSecExact = 0.0;
+                            state.SupplyMeterSecExact = 0.0;
+                            state.StarvingSecExact = 0.0;
+                            state.DefenderHoldElapsedSec = 0.0;
+                            state.SupplyLowAlertSent = false;
+                            state.Control.UpdatedUtc = now;
+                            snap = TownEconomyManager.CloneControlSnapshot(state.Control);
+                            stateTransitioned = true;
+
+                            state.AlertCount++;
+                            alertTitle = "siege_broken";
+                            alertBody = $"Defender broke the siege at {state.Control.Name}, restoring escrow and seizing {seizedSp:0.0} SP (50% apron supplies).";
+                            state.LastAlertMessage = alertBody;
+                        }
+                    }
+                    else if (holder != state.Control.AttackerMonarchId)
+                    {
+                        if (holder == state.CooldownMonarchId && state.CooldownRemainingSec > 0.0)
+                            return false;
+
+                        state.DefenderHoldElapsedSec = 0.0;
+                        if (state.ThreeWayCandidateMonarchId != holder)
+                        {
+                            state.ThreeWayCandidateMonarchId = holder;
+                            state.ThreeWayHoldElapsedSec = 0.0;
+                        }
+
+                        state.ThreeWayHoldElapsedSec += elapsedSeconds;
+                        if (state.ThreeWayHoldElapsedSec >= BreachGateSec)
+                        {
+                            ApplyThreeWayResetLocked(state, holder, now);
+                            snap = TownEconomyManager.CloneControlSnapshot(state.Control);
+                            stateTransitioned = true;
+                            state.AlertCount++;
+                            alertTitle = "siege_three_way_reset";
+                            alertBody = $"3-way contention at {state.Control.Name}: Monarch {holder} took the TCN! 8h clock reset to 0.";
+                            state.LastAlertMessage = alertBody;
+                        }
+                    }
+                    else
+                    {
+                        // Current attacker holds ring: clear defender/3rd-party break timers
+                        state.DefenderHoldElapsedSec = 0.0;
+                        state.ThreeWayCandidateMonarchId = 0;
+                        state.ThreeWayHoldElapsedSec = 0.0;
+                    }
+                }
+            }
+
+            if (snap != null) TownEconomyManager.PersistControlSnapshot(snap);
+            if (whSnap != null) TownEconomyManager.PersistWarehouseSnapshot(whSnap);
+            if (!string.IsNullOrEmpty(alertBody)) EmitSiegeAlert(townId, alertTitle, alertBody);
+            return stateTransitioned;
+        }
