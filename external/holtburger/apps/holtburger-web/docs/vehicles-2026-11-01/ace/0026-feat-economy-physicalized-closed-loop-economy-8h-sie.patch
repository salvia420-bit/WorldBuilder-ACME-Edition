+            TownEconomyManager.SeedTownTill(cragstone.TownId, 10_000);
+
+            int purchaseSuccess = 0;
+            int withdrawSuccess = 0;
+
+            var tasks = new List<Task>();
+            for (int i = 0; i < 100; i++)
+            {
+                tasks.Add(Task.Run(() =>
+                {
+                    var item = CreateTestItem(itemWcid, WeenieType.MeleeWeapon, ItemType.MeleeWeapon, value: 100, name: "Axe");
+                    if (TownEconomyManager.TryExecuteVendorPurchase(vendor, new List<WorldObject> { item }, new List<WorldObject>(), 100, out _))
+                        Interlocked.Increment(ref purchaseSuccess);
+                }));
+                tasks.Add(Task.Run(() =>
+                {
+                    if (TownEconomyManager.TryWithdrawFromTownTill(cragstone.TownId, 500, "test", out _))
+                        Interlocked.Increment(ref withdrawSuccess);
+                }));
+            }
+            Task.WaitAll(tasks.ToArray());
+
+            Assert.AreEqual(50, purchaseSuccess);
+            Assert.AreEqual(0, TownEconomyManager.GetVendorStock(cragstone.TownId, vendor.Guid.Full, itemWcid));
+            // Initial 10,000 + 50*100 = 15,000 total available; exact balance invariant holds
+            Assert.AreEqual(10_000L + 50L * 100L - (withdrawSuccess * 500L), TownEconomyManager.GetTreasuryPyreals(cragstone.TownId));
+        }
