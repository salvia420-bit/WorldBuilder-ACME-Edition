+
+        public static void Tick()
+        {
+            if (!TownEconomyManager.Enabled && !VehicleManager.Enabled)
+                return;
+
+            long now = Stopwatch.GetTimestamp();
+            if (_lastTickTimestamp == 0)
+            {
+                _lastTickTimestamp = now;
+                return;
+            }
+
+            double dt = (now - _lastTickTimestamp) / (double)Stopwatch.Frequency;
+            _lastTickTimestamp = now;
+            if (!double.IsFinite(dt) || dt <= 0.0) return;
+            if (dt > 5.0) dt = 5.0;
+
+            Tick(dt);
+        }
+
+        public static void TickForTesting(double elapsedSeconds) => Tick(elapsedSeconds);
+
+        public static void Tick(double elapsedSeconds)
+        {
+            if (!double.IsFinite(elapsedSeconds) || elapsedSeconds <= 0.0)
+                return;
+
+            if (!_initialized)
+                _initialized = true;
+
+            if (_convoys.IsEmpty)
+                return;
+
+            lock (_tickLock)
+            {
+                _macroAccumulator += elapsedSeconds;
+                while (_macroAccumulator >= MacroLodStepSeconds)
+                {
+                    _macroAccumulator -= MacroLodStepSeconds;
+                    foreach (var convoy in _convoys.Values)
+                    {
+                        StepConvoyMacro(convoy, MacroLodStepSeconds, broadcastStates: true);
+                    }
+                }
+
+                // Evaluate Micro-LOD materialization / dematerialization & keep active landblocks alive
+                foreach (var convoy in _convoys.Values)
+                {
+                    UpdateConvoyMicroLod(convoy);
+                }
+            }
+        }
+
+        /// <summary>
+        /// Deterministic 1 Hz Macro-LOD test entry point required by PhaseDELogisticsGatewayE2ETests (F15).
+        /// Auto-seeds convoyId if not yet registered, steps Macro-LOD by elapsedSec, and returns updated SplineSM.
+        /// </summary>
+        public static double StepMacroConvoyForTesting(uint convoyId, double elapsedSec)
+        {
+            if (!double.IsFinite(elapsedSec) || elapsedSec <= 0.0)
+            {
+                if (_convoys.TryGetValue(convoyId, out var existing))
+                {
+                    lock (existing.SyncRoot)
+                        return existing.SplineSM;
+                }
+                return 0.0;
+            }
+
+            lock (_tickLock)
+            {
+                if (!_convoys.TryGetValue(convoyId, out var convoy))
+                {
+                    convoy = DispatchConvoy(
+                        ownerMonarchId: 1u,
+                        originTownId: 1u,
+                        destTownId: 5u,
+                        vehicleClass: (byte)ACE.Server.Vehicles.VehicleClass.HeavyTractor,
+                        error: out _,
+                        commodityId: "supply_crate",
+                        commodityQty: 10,
+                        initialFuelLiters: DefaultTractorFuelLiters,
+                        explicitConvoyId: convoyId);
+
+                    if (convoy == null)
+                        return 0.0;
+                }
+
+                StepConvoyMacro(convoy, elapsedSec, broadcastStates: false);
+                lock (convoy.SyncRoot)
+                    return convoy.SplineSM;
+            }
+        }
+
+        internal static bool ResolveConvoyRoute(
+            LogisticsNavGraph nav,
+            uint originTownId,
+            uint destTownId,
+            uint originLandblockId,
+            uint originPortId,
+            uint destPortId,
+            byte vehicleClass,
+            bool allowFourWdLow,
+            out LogisticsRoute route)
+        {
+            route = null;
+            if (nav == null)
+                return false;
+
+            if (originPortId > 0 && destPortId > 0 && originPortId != destPortId &&
+                (vehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder ||
+                 vehicleClass == 0 && (originTownId == 0 || destTownId == 0)))
+            {
+                if (nav.TryFindSeaRoute(originPortId, destPortId, out var seaRoute))
+                {
+                    route = new LogisticsRoute
+                    {
+                        OriginNodeId = seaRoute.OriginNodeId,
+                        DestNodeId = seaRoute.DestNodeId,
+                        OriginTownId = originTownId,
+                        DestTownId = destTownId,
+                        OriginPortId = seaRoute.OriginPortId,
+                        DestPortId = seaRoute.DestPortId,
+                        UsesSea = true,
+                        Uses4wdLow = false,
+                        TotalLengthM = seaRoute.TotalLengthM,
+                        Waypoints = seaRoute.Waypoints,
+                    };
+                    return true;
+                }
+            }
+
+            if (originTownId != 0 && destTownId != 0 && originTownId != destTownId &&
+                nav.TryFindRoute(originTownId, destTownId, vehicleClass, allowFourWdLow, out route))
+            {
+                return true;
+            }
+
+            if (vehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder)
+            {
+                var originPort = originPortId > 0 ? nav.GetPort(originPortId) : null;
+                originPort ??= originLandblockId != 0 ? nav.GetPortByLandblock(originLandblockId) : null;
+                originPort ??= originTownId != 0 ? nav.FindNearestPortToTown(originTownId) : null;
+                originPort ??= nav.GetPort(originTownId);
+
+                NavPort destPort = destPortId > 0 ? nav.GetPort(destPortId) : null;
+                destPort ??= destTownId != 0 ? nav.FindNearestPortToTown(destTownId) : null;
+                destPort ??= nav.GetPort(destTownId);
+
+                if (originPort != null && destPort != null && originPort.PortId != destPort.PortId &&
+                    nav.TryFindSeaRoute(originPort.PortId, destPort.PortId, out route))
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+        private static bool IsActiveSegmentSea(LogisticsConvoyState convoy)
+        {
+            if (convoy == null)
+                return false;
+            if (convoy.VehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder)
+                return true;
+            if (convoy.VehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.HeavyTractor ||
+                convoy.VehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.LightGround)
+                return false;
+            if (convoy.Route != null)
+                return LogisticsNavGraph.IsSeaSegmentAtDistance(convoy.Route, convoy.SplineSM);
+            return convoy.WorldY >= LandblockManager.OceanCorridorYMin &&
+                   convoy.WorldY < LandblockManager.OceanCorridorYMax;
+        }
+
+        private static byte GetExpectedActiveVehicleClass(LogisticsConvoyState convoy)
+            => IsActiveSegmentSea(convoy)
+                ? (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder
+                : (byte)ACE.Server.Vehicles.VehicleClass.HeavyTractor;
+
+        private static void StepConvoyMacro(LogisticsConvoyState convoy, double dt, bool broadcastStates)
+        {
+            if (convoy == null || dt <= 0.0) return;
+
+            bool arrivedNow = false;
+            bool becameOutOfFuel = false;
+            bool newlyDetectedByRadar = false;
+            uint detectMonarch = 0;
+            uint detectSensor = 0;
+            Vehicle staleModeVehicle = null;
+
+            lock (convoy.SyncRoot)
+            {
+                if (convoy.Status == LogisticsConvoyStatus.Arrived ||
+                    convoy.Status == LogisticsConvoyStatus.Aborted ||
+                    convoy.Status == LogisticsConvoyStatus.Interdicted)
+                {
+                    return;
+                }
+
+                bool isExplicitShip = convoy.VehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder;
+
+                // Ensure route exists
+                if (convoy.Route == null &&
+                    ((convoy.OriginPortId != 0 && convoy.DestPortId != 0) ||
+                     (convoy.OriginTownId != 0 && convoy.DestTownId != 0)))
+                {
+                    try
+                    {
+                        ResolveConvoyRoute(
+                            LogisticsNavGraph.LoadDefault(),
+                            convoy.OriginTownId,
+                            convoy.DestTownId,
+                            convoy.OriginLandblockId,
+                            convoy.OriginPortId,
+                            convoy.DestPortId,
+                            convoy.VehicleClass,
+                            true,
+                            out var r);
+                        convoy.Route = r;
+                    }
+                    catch { }
+                }
+
+                bool isSeaSegment = IsActiveSegmentSea(convoy);
+
+                // Stall cleanly when fuel_liters <= 0 (never teleport!)
+                if (convoy.FuelLiters <= 0.0)
+                {
+                    convoy.FuelLiters = 0.0;
+                    if (convoy.Status != LogisticsConvoyStatus.OutOfFuel)
+                    {
+                        convoy.Status = LogisticsConvoyStatus.OutOfFuel;
+                        becameOutOfFuel = true;
+                    }
+                    SyncAttachedContainerPowerAndDecayLocked(convoy, dt, isSeaSegment);
+                    if (convoy.ActiveVehicle != null)
+                    {
+                        convoy.ActiveVehicle.FuelLiters = 0.0f;
+                        convoy.ActiveVehicle.AutonomousMarineInput = default(MarineInput);
+                        convoy.ActiveVehicle.AutonomousGroundInput = new GroundInput { Handbrake = true };
+                        convoy.ActiveVehicle.SyncBay06ReeferPower();
+                    }
+                    convoy.UpdatedUtc = DateTime.UtcNow;
+                }
+                else if (convoy.Route != null)
+                {
+                    double remDt = dt;
+                    int maxSubSteps = Math.Max(8, (convoy.Route.Waypoints?.Count ?? 0) + 4);
+                    int subSteps = 0;
+                    while (remDt > 1e-9 && convoy.FuelLiters > 0.0 && convoy.SplineSM < convoy.Route.TotalLengthM - 0.01 && subSteps++ < maxSubSteps)
+                    {
+                        bool segIsSea;
+                        bool hasUpcomingBoundary = false;
+                        double distToBoundary;
+                        if (convoy.VehicleClass == 0 && convoy.Route.UsesSea)
+                        {
+                            distToBoundary = convoy.Route.GetDistanceToNextModeBoundary(convoy.SplineSM, out segIsSea, out hasUpcomingBoundary);
+                        }
+                        else
+                        {
+                            segIsSea = isExplicitShip;
+                            distToBoundary = Math.Max(0.0, convoy.Route.TotalLengthM - convoy.SplineSM);
+                        }
+
+                        if (distToBoundary <= 1e-9)
+                        {
+                            if (hasUpcomingBoundary && convoy.SplineSM < convoy.Route.TotalLengthM - 0.01)
+                            {
+                                double nextS = Math.Min(convoy.Route.TotalLengthM, convoy.SplineSM + Math.Max(distToBoundary, 2e-9));
+                                if (nextS > convoy.SplineSM)
+                                {
+                                    double prevSpeed = segIsSea ? FeederShipCruiseSpeedMps : TractorCruiseSpeedMps;
+                                    double actualSnap = nextS - convoy.SplineSM;
+                                    convoy.SplineSM = nextS;
+                                    remDt = Math.Max(0.0, remDt - (actualSnap / prevSpeed));
+                                    continue;
+                                }
+                            }
+                            distToBoundary = Math.Max(0.0, convoy.Route.TotalLengthM - convoy.SplineSM);
+                        }
+
+                        double speedMps = segIsSea ? FeederShipCruiseSpeedMps : TractorCruiseSpeedMps;
+                        double burnPerM = segIsSea ? FeederShipFuelBurnLitersPerM : TractorFuelBurnLitersPerM;
+
+                        double desiredStepM = Math.Min(distToBoundary, speedMps * remDt);
+                        double maxAffordableM = burnPerM > 0.0 ? convoy.FuelLiters / burnPerM : desiredStepM;
+                        double actualStepM = Math.Min(desiredStepM, maxAffordableM);
+
+                        if (actualStepM <= 1e-9)
+                        {
+                            if (maxAffordableM <= 1e-9)
+                                convoy.FuelLiters = 0.0;
+                            break;
+                        }
+
+                        convoy.SplineSM = Math.Max(0.0, convoy.SplineSM + actualStepM);
+                        convoy.FuelLiters = Math.Max(0.0, convoy.FuelLiters - actualStepM * burnPerM);
+                        remDt = Math.Max(0.0, remDt - (actualStepM / speedMps));
+                    }
+
+                    var pose = LogisticsNavGraph.SamplePoseAtDistance(convoy.Route, convoy.SplineSM);
+                    isSeaSegment = IsActiveSegmentSea(convoy);
+                    convoy.WorldX = pose.X;
+                    convoy.WorldY = pose.Y;
+                    convoy.WorldZ = isSeaSegment ? 0.0 : pose.Z;
+                    convoy.HeadingRad = pose.HeadingRad;
+                    if (convoy.VehicleClass == 0)
+                        convoy.VehicleKind = isSeaSegment ? "ContainerShipFeeder" : "Semi379";
+
+                    if (convoy.FuelLiters <= 1e-6 && convoy.SplineSM < convoy.Route.TotalLengthM - 0.01)
+                    {
+                        convoy.FuelLiters = 0.0;
+                        convoy.Status = LogisticsConvoyStatus.OutOfFuel;
+                        becameOutOfFuel = true;
+                    }
+                    else if (convoy.SplineSM >= convoy.Route.TotalLengthM - 0.01)
+                    {
+                        convoy.SplineSM = convoy.Route.TotalLengthM;
+                        convoy.Status = LogisticsConvoyStatus.Arrived;
+                        arrivedNow = !convoy.DeliverySettled;
+                        convoy.DeliverySettled = true;
+                    }
+
+                    SyncAttachedContainerPowerAndDecayLocked(convoy, dt, isSeaSegment);
+
+                    if (convoy.ActiveVehicle != null)
+                    {
+                        byte expectedClass = GetExpectedActiveVehicleClass(convoy);
+                        if (convoy.ActiveVehicle.Profile.VehicleClass != expectedClass)
+                        {
+                            staleModeVehicle = convoy.ActiveVehicle;
+                            convoy.ActiveVehicle = null;
+                            convoy.VehicleGuid = 0;
+                            convoy.LodState = LogisticsLodState.Macro;
+                        }
+                        else
+                        {
+                            convoy.ActiveVehicle.FuelLiters = (float)convoy.FuelLiters;
+                            SyncActiveVehiclePoseLocked(convoy);
+                            convoy.ActiveVehicle.SyncBay06ReeferPower();
+                        }
+                    }
+
+                    convoy.UpdatedUtc = DateTime.UtcNow;
+                }
+
+                // 1 Hz Radar & Patrol intersection sweep
+                if (convoy.Status == LogisticsConvoyStatus.EnRoute)
+                {
+                    if (CheckRadarIntersectionLocked(convoy, out var detMonarch, out var detSensor))
+                    {
+                        if (!convoy.RadarDetected || convoy.DetectingSensorGuid != detSensor)
+                        {
+                            convoy.RadarDetected = true;
+                            convoy.DetectingMonarchId = detMonarch;
+                            convoy.DetectingSensorGuid = detSensor;
+                            newlyDetectedByRadar = true;
+                            detectMonarch = detMonarch;
+                            detectSensor = detSensor;
+                        }
+                    }
+                    else
+                    {
+                        convoy.RadarDetected = false;
+                        convoy.DetectingMonarchId = 0;
+                        convoy.DetectingSensorGuid = 0;
+                    }
+                }
+            }
+
+            if (staleModeVehicle != null)
+            {
+                try { VehicleManager.Despawn(staleModeVehicle, "convoy-mode-switch"); } catch { }
+            }
+
+            if (newlyDetectedByRadar)
+                ConvoyRadarDetected?.Invoke(convoy.ConvoyId, detectMonarch, detectSensor);
+
+            if (arrivedNow)
+                SettleConvoyDelivery(convoy);
+
+            if (arrivedNow || becameOutOfFuel)
+                PersistConvoy(convoy);
+
+            if (broadcastStates)
