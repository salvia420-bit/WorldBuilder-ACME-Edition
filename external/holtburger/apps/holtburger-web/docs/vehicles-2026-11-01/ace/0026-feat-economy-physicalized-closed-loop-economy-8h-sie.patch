+            var result = GeologyService.HandleProspectingRequest(actor, reqMsg, out var error);
+            if (result == null)
+                return (422, new { error = error ?? "Prospecting request rejected." });
+
+            return (200, new
+            {
+                ok = true,
+                depositId = result.DepositId,
+                landblockId = result.LandblockId,
+                toolKind = result.ToolKind,
+                flags = result.Flags,
+                terrainCode = result.TerrainCode,
+                resourceKind = result.ResourceKind,
+                depthM = result.DepthM,
+                gradeBps = result.GradeBps,
+                apiGravity = result.ApiGravity,
+                sulfurBps = result.SulfurBps,
+                remainingTonnes = result.RemainingTonnes,
