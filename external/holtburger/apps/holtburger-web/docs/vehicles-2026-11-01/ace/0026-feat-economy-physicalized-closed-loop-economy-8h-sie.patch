+        public static LogisticsConvoyStateMsg HandleConvoyOrder(Player player, LogisticsConvoyOrder order, out string error)
+        {
+            error = null;
+            if (player == null || order == null)
+            {
+                error = "Invalid convoy order.";
+                return null;
+            }
+
+            uint monarchId = TownCommands.ResolveEffectiveMonarchId(player);
+            bool isDev = player.Session != null && player.Session.AccessLevel >= ACE.Entity.Enum.AccessLevel.Developer;
+            var action = (LogisticsConvoyAction)order.Action;
+
+            switch (action)
+            {
+                case LogisticsConvoyAction.Dispatch:
+                {
+                    if (!LogisticsNavGraph.IsSupportedVehicleClass(order.VehicleClass))
+                    {
+                        error = $"Unsupported vehicle class {order.VehicleClass}.";
+                        return null;
+                    }
+
+                    if (order.OriginTownId == 0 || order.DestTownId == 0)
+                    {
+                        error = "Origin and destination towns are required.";
+                        return null;
+                    }
+
+                    bool isShip = order.VehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder;
+                    bool allow4wd = (order.Flags & 0x01) != 0;
+                    bool destIsPortId = isShip && (order.Flags & 0x02) != 0;
+
+                    if (!destIsPortId && order.OriginTownId == order.DestTownId)
+                    {
+                        error = "Origin and destination towns must be different.";
+                        return null;
+                    }
+
+                    // Prevent cross-faction or duplicate ConvoyId hijack/overwrite via client 0x0915
+                    if (order.ConvoyId != 0 && _convoys.ContainsKey(order.ConvoyId))
+                    {
+                        error = $"Convoy ID {order.ConvoyId} already exists.";
+                        return null;
+                    }
+
+                    string commodity = MapCommodityId(order.CommodityId);
+                    int commodityQty = order.CommodityId != 0 ? 10 : 0;
+
+                    if (order.CommodityId != 0 && string.IsNullOrWhiteSpace(commodity))
+                    {
+                        error = $"Unknown commodity ID {order.CommodityId}.";
+                        return null;
+                    }
+
+                    LogisticsNavGraph nav;
+                    try
+                    {
+                        nav = LogisticsNavGraph.LoadDefault();
+                    }
+                    catch (Exception ex)
+                    {
+                        error = $"Navigation graph unavailable: {ex.Message}";
+                        return null;
+                    }
+
+                    double? grantedFuelLiters = null;
+                    string consumedFuelCommodity = null;
+                    int consumedFuelUnits = 0;
+                    bool consumedCommodity = false;
+                    uint? matchedOriginPortId = null;
+                    uint? explicitDestPortId = null;
+                    uint dispatchDestTownId = order.DestTownId;
+
+                    if (destIsPortId)
+                    {
+                        var explicitDestPort = nav.GetPort(order.DestTownId);
+                        if (explicitDestPort == null)
+                        {
+                            error = $"Destination port {order.DestTownId} not found.";
+                            return null;
+                        }
+                        explicitDestPortId = explicitDestPort.PortId;
+                        dispatchDestTownId = nav.FindNearestTownToPort(explicitDestPort.PortId)?.TownId ?? order.OriginTownId;
+                    }
+
+                    if (!isDev)
+                    {
+                        var originState = TownEconomyManager.GetTownState(order.OriginTownId);
+                        if (originState == null)
+                        {
+                            error = $"Origin town {order.OriginTownId} not found.";
+                            return null;
+                        }
+
+                        uint originOwner;
+                        lock (originState.SyncRoot)
+                            originOwner = originState.Control.OwnerMonarchId;
+
+                        if (originOwner == 0)
+                        {
+                            error = $"Origin town {originState.Control.Name} is unclaimed; claim the town before dispatching convoys.";
+                            return null;
+                        }
+
+                        if (!TownCommands.CanExecuteTownLogistics(player, order.OriginTownId))
+                        {
+                            error = $"You are not sworn to the Allegiance controlling town {originState.Control.Name}.";
+                            return null;
+                        }
+
+                        if (player.Location == null)
+                        {
+                            error = "Player location required.";
+                            return null;
+                        }
+
+                        var mounted = VehicleManager.VehicleOf(player);
+                        if (mounted == null && player.Location.Indoors)
+                        {
+                            error = $"Move outdoors within {(isShip ? 60 : 40)} m of {originState.Control.Name} depot to dispatch a convoy.";
+                            return null;
+                        }
+                        var (px, py, _) = VehicleManager.GetObserverGlobalPosition(player);
+
+                        var originTownNav = nav.GetTown(order.OriginTownId);
+                        var originTownDef = TownRegistry.GetById(order.OriginTownId);
+                        var originPortNav = isShip ? nav.FindNearestPortToTown(order.OriginTownId) : null;
+
+                        double minOriginDist = double.MaxValue;
+                        if (isShip)
+                        {
+                            if (originPortNav != null)
+                            {
+                                double dx = px - originPortNav.X;
+                                double dy = py - originPortNav.Y;
+                                double d = Math.Sqrt(dx * dx + dy * dy);
+                                if (d < minOriginDist) minOriginDist = d;
+                                if (d <= 60.0) matchedOriginPortId = originPortNav.PortId;
+                            }
+
+                            foreach (var port in nav.Ports)
+                            {
+                                var nearestTown = nav.FindNearestTownToPort(port.PortId);
+                                if (nearestTown != null && nearestTown.TownId == order.OriginTownId)
+                                {
+                                    double dx = px - port.X;
+                                    double dy = py - port.Y;
+                                    double d = Math.Sqrt(dx * dx + dy * dy);
+                                    if (d < minOriginDist) minOriginDist = d;
+                                    if (d <= 60.0 && !matchedOriginPortId.HasValue)
+                                        matchedOriginPortId = port.PortId;
+                                }
+                            }
+                        }
+
+                        double townX = originTownNav?.X ?? originTownDef?.WorldX ?? 0.0;
+                        double townY = originTownNav?.Y ?? originTownDef?.WorldY ?? 0.0;
+                        bool hasTownCoords = originTownNav != null || originTownDef != null;
+                        bool isCoastalTown = isShip && originPortNav != null && hasTownCoords &&
+                            Math.Sqrt(Math.Pow(townX - originPortNav.X, 2) + Math.Pow(townY - originPortNav.Y, 2)) <= 2000.0;
+
+                        if (!isShip || isCoastalTown)
+                        {
+                            if (originTownNav != null)
+                            {
+                                double dx = px - originTownNav.X;
+                                double dy = py - originTownNav.Y;
+                                minOriginDist = Math.Min(minOriginDist, Math.Sqrt(dx * dx + dy * dy));
+                            }
+                            if (originTownDef != null)
+                            {
+                                double dx = px - originTownDef.WorldX;
+                                double dy = py - originTownDef.WorldY;
+                                minOriginDist = Math.Min(minOriginDist, Math.Sqrt(dx * dx + dy * dy));
+                            }
+                            var hydrated = SiegeManager.GetHydratedEntities(order.OriginTownId);
+                            if (hydrated != null && hydrated.DepotGuid != 0 &&
+                                DeployableManager.GetDeployable(hydrated.DepotGuid) is TownDepotDeployable depot &&
+                                !depot.IsDestroyed && depot.Location != null)
+                            {
+                                var dp = depot.GlobalPosition;
+                                double dx = px - dp.X;
+                                double dy = py - dp.Y;
+                                minOriginDist = Math.Min(minOriginDist, Math.Sqrt(dx * dx + dy * dy));
+                            }
+                        }
+
+                        double maxOriginRange = isShip ? 60.0 : 40.0;
+                        if (minOriginDist > maxOriginRange)
+                        {
+                            error = $"Move within {maxOriginRange:0} m of {originState.Control.Name} depot to dispatch a convoy (currently {minOriginDist:0.0} m).";
+                            return null;
+                        }
+
+                        // Pre-validate route BEFORE consuming warehouse commodity or fuel
+                        LogisticsRoute preRoute = null;
+                        bool routeValid;
+                        if (isShip && (matchedOriginPortId.HasValue || destIsPortId))
+                        {
+                            var resolvedOriginPort = matchedOriginPortId.HasValue
+                                ? nav.GetPort(matchedOriginPortId.Value)
+                                : nav.FindNearestPortToTown(order.OriginTownId);
+                            var resolvedDestPort = destIsPortId
+                                ? nav.GetPort(explicitDestPortId.Value)
+                                : nav.FindNearestPortToTown(order.DestTownId);
+                            routeValid = resolvedOriginPort != null && resolvedDestPort != null &&
+                                         resolvedOriginPort.PortId != resolvedDestPort.PortId &&
+                                         nav.TryFindSeaRoute(resolvedOriginPort.PortId, resolvedDestPort.PortId, out preRoute);
+                        }
+                        else
+                        {
+                            routeValid = nav.TryFindRoute(order.OriginTownId, order.DestTownId, order.VehicleClass, allow4wd, out preRoute);
+                        }
+
+                        if (!routeValid || preRoute == null || preRoute.TotalLengthM <= 0.0)
+                        {
+                            error = isShip
+                                ? $"No valid Outer Ocean sea route between {order.OriginTownId} and {order.DestTownId} for ContainerShipFeeder."
+                                : $"No valid overland logistics route between town {order.OriginTownId} and town {order.DestTownId} for vehicle class {order.VehicleClass}.";
+                            return null;
+                        }
+
+                        // Closed-loop fuel deduction from origin town warehouse
+                        bool needsSeaFuel = isShip || (order.VehicleClass == 0 && preRoute.UsesSea);
+                        if (!needsSeaFuel)
+                        {
+                            int availDiesel = TownEconomyManager.GetWarehouseStockQty(order.OriginTownId, "ulsd_diesel");
+                            int wantUnits = Math.Min(3, availDiesel);
+                            if (wantUnits <= 0 || !TownEconomyManager.TryConsumeWarehouseStock(order.OriginTownId, "ulsd_diesel", wantUnits, out _))
+                            {
+                                error = $"Insufficient ulsd_diesel fuel in {originState.Control.Name} warehouse to dispatch convoy.";
+                                return null;
+                            }
+                            consumedFuelCommodity = "ulsd_diesel";
+                            consumedFuelUnits = wantUnits;
+                            grantedFuelLiters = wantUnits * UlsdLitersPerUnit;
+                        }
+                        else
+                        {
+                            string[] marineFuels = { "hfo_bunker", "marine_hfo", "ulsd_diesel" };
+                            foreach (var fc in marineFuels)
+                            {
+                                int avail = TownEconomyManager.GetWarehouseStockQty(order.OriginTownId, fc);
+                                int wantUnits = Math.Min(5, avail);
+                                if (wantUnits > 0 && TownEconomyManager.TryConsumeWarehouseStock(order.OriginTownId, fc, wantUnits, out _))
+                                {
+                                    consumedFuelCommodity = fc;
+                                    consumedFuelUnits = wantUnits;
+                                    double litersPerUnit = string.Equals(fc, "ulsd_diesel", StringComparison.OrdinalIgnoreCase)
+                                        ? UlsdLitersPerUnit
+                                        : MarineHfoLitersPerUnit;
+                                    grantedFuelLiters = wantUnits * litersPerUnit;
+                                    break;
+                                }
+                            }
+                            if (consumedFuelUnits <= 0)
+                            {
+                                error = $"Insufficient marine fuel (hfo_bunker / ulsd_diesel) in {originState.Control.Name} warehouse to dispatch ship convoy.";
+                                return null;
+                            }
+                        }
+
+                        // Closed-loop commodity deduction from origin town warehouse
+                        if (order.CommodityId != 0)
+                        {
+                            if (!TownEconomyManager.TryConsumeWarehouseStock(order.OriginTownId, commodity, commodityQty, out var stockErr))
+                            {
+                                if (consumedFuelUnits > 0 && !string.IsNullOrEmpty(consumedFuelCommodity))
+                                    TownEconomyManager.RecordWarehouseDelivery(order.OriginTownId, consumedFuelCommodity, consumedFuelUnits);
+                                error = stockErr;
+                                return null;
+                            }
+                            consumedCommodity = true;
+                        }
+                    }
+
+                    var convoy = DispatchConvoy(
+                        ownerMonarchId: monarchId,
+                        originTownId: order.OriginTownId,
+                        destTownId: dispatchDestTownId,
+                        vehicleClass: order.VehicleClass,
+                        error: out error,
+                        containerKind: order.ContainerKind,
+                        commodityId: commodity,
+                        commodityQty: commodityQty,
+                        initialFuelLiters: grantedFuelLiters,
+                        allowFourWdLow: allow4wd,
+                        explicitConvoyId: order.ConvoyId != 0 ? order.ConvoyId : null,
+                        ownerMonarchName: ResolveMonarchName(monarchId, player),
+                        explicitOriginPortId: matchedOriginPortId,
+                        rejectDuplicateExplicitConvoyId: order.ConvoyId != 0,
+                        explicitDestPortId: explicitDestPortId);
+
+                    if (convoy == null)
+                    {
+                        if (consumedCommodity)
+                            TownEconomyManager.RecordWarehouseDelivery(order.OriginTownId, commodity, commodityQty);
+                        if (consumedFuelUnits > 0 && !string.IsNullOrEmpty(consumedFuelCommodity))
+                            TownEconomyManager.RecordWarehouseDelivery(order.OriginTownId, consumedFuelCommodity, consumedFuelUnits);
+                        return null;
+                    }
+
+                    lock (convoy.SyncRoot)
+                        return convoy.ToWireMsg();
+                }
+
+                case LogisticsConvoyAction.Abort:
+                {
+                    if (!_convoys.TryGetValue(order.ConvoyId, out var convoy))
+                    {
+                        error = $"Convoy {order.ConvoyId} not found.";
+                        return null;
+                    }
+                    Vehicle toDespawn;
+                    lock (convoy.SyncRoot)
+                    {
+                        if (!isDev && convoy.OwnerMonarchId != monarchId)
+                        {
+                            error = "Only the owning Allegiance may abort this convoy.";
+                            return null;
+                        }
+                        convoy.Status = LogisticsConvoyStatus.Aborted;
+                        convoy.UpdatedUtc = DateTime.UtcNow;
+                        toDespawn = convoy.ActiveVehicle;
+                        convoy.ActiveVehicle = null;
+                        convoy.VehicleGuid = 0;
+                        convoy.LodState = LogisticsLodState.Macro;
+                    }
+                    if (toDespawn != null)
+                    {
+                        try { VehicleManager.Despawn(toDespawn, "convoy-aborted"); } catch { }
+                    }
+                    PersistConvoy(convoy);
+                    lock (convoy.SyncRoot)
+                        return convoy.ToWireMsg();
+                }
+
+                case LogisticsConvoyAction.Query:
+                {
+                    if (!_convoys.TryGetValue(order.ConvoyId, out var convoy))
+                    {
+                        error = $"Convoy {order.ConvoyId} not found.";
+                        return null;
+                    }
+                    lock (convoy.SyncRoot)
+                        return convoy.ToWireMsg();
+                }
+
+                case LogisticsConvoyAction.Interdict:
+                {
+                    bool capture = (order.Flags & 0x02) != 0;
+                    if (!TryInterdictConvoy(order.ConvoyId, player, capture, out error))
+                        return null;
+                    var interdicted = GetConvoy(order.ConvoyId);
+                    if (interdicted == null) return null;
+                    lock (interdicted.SyncRoot)
+                        return interdicted.ToWireMsg();
+                }
+
+                default:
+                    error = $"Unsupported LogisticsConvoyAction {order.Action}.";
+                    return null;
+            }
+        }
+
+        private static string MapCommodityId(uint commodityId) => commodityId switch
+        {
+            0 => "",
+            1 => "iron_ore",
+            2 => "pyreal_ore",
+            3 => "light_sweet_crude",
+            4 => "ulsd_diesel",
+            5 => "bio_gland",
+            6 => "lumber",
+            7 => "paraffin_wax",
+            8 => "supply_crate",
+            9 => "pyreal_bar",
+            10 => "steel_ingot",
+            _ => $"commodity_{commodityId}",
+        };
+
+        private static void BroadcastConvoyState(LogisticsConvoyState convoy)
+        {
+            if (convoy == null) return;
+            LogisticsConvoyStateMsg msg;
+            uint ownerMonarchId;
+            double wx, wy;
+            lock (convoy.SyncRoot)
+            {
+                msg = convoy.ToWireMsg();
+                ownerMonarchId = convoy.OwnerMonarchId;
+                wx = convoy.WorldX;
+                wy = convoy.WorldY;
+            }
+            try
+            {
+                foreach (var p in PlayerManager.GetAllOnline())
+                {
+                    if (p?.Session == null || !VehicleManager.HasCap(p.Session, VehicleWire.CapObserve))
+                        continue;
+
+                    bool isOwner = ownerMonarchId != 0 &&
+                        TownCommands.ResolveEffectiveMonarchId(p) == ownerMonarchId;
+
+                    bool near = false;
+                    if (!isOwner && p.Location != null)
+                    {
+                        var (px, py, _) = VehicleManager.GetObserverGlobalPosition(p);
+                        double dx = px - wx;
+                        double dy = py - wy;
+                        near = dx * dx + dy * dy <= MicroLodRadiusM * MicroLodRadiusM;
+                    }
+
+                    if (!isOwner && !near)
+                        continue;
+
+                    VehicleManager.SendTo(null, p.Session, msg);
+                }
+            }
+            catch { }
+        }
+
+        private static void PersistConvoy(LogisticsConvoyState convoy)
+        {
+            if (convoy == null) return;
+            try
+            {
+                LogisticsConvoy row;
+                lock (convoy.SyncRoot)
+                    row = convoy.ToDbRow();
+                DatabaseManager.Shard?.EnqueueLogisticsConvoyUpsert(row);
+            }
+            catch (Exception ex)
+            {
+                log.Debug($"[LOGISTICS] Persistence enqueue skipped: {ex.Message}");
+            }
+        }
+    }
+}
