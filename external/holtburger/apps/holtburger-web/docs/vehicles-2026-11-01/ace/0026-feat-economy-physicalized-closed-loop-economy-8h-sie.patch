+
+        private static ulong AllocateOrderId(ulong explicitOrderId = 0)
+        {
+            if (explicitOrderId != 0)
+            {
+                long cur;
+                long target = (long)Math.Min(long.MaxValue, explicitOrderId);
+                do
+                {
+                    cur = Interlocked.Read(ref _nextOrderId);
+                    if (target <= cur) break;
+                }
+                while (Interlocked.CompareExchange(ref _nextOrderId, target, cur) != cur);
+                return explicitOrderId;
+            }
+            return (ulong)Interlocked.Increment(ref _nextOrderId);
+        }
