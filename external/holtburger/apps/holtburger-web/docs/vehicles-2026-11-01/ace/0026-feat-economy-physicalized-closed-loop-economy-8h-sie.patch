+            double meatLifetime = meatInPack.GetProperty(PropertyFloat.FreshnessLifetimeSec) ?? 0.0;
+            Assert.IsTrue(glandLifetime is >= 7200.0 and <= 21600.0);
+            Assert.IsTrue(meatLifetime is >= 7200.0 and <= 21600.0);
+
+            Assert.IsTrue(reefer22R1.TryStorePerishableItem(glandInReefer, out _));
+            Assert.IsTrue(reeferExternal.TryStorePerishableItem(herbInExternalReefer, out _));
+
+            var pack = CreateTestContainer(AllocGuid(), new Position(0x80900001u, 96f, 96f, 10f, 0, 0, 0, 1));
+            pack.Inventory[meatInPack.Guid] = meatInPack;
