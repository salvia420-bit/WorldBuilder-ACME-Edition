+        public static bool TryConsumeWarehouseStock(uint townId, string commodityId, int qty, out string error)
+        {
+            error = null;
+            if (string.IsNullOrWhiteSpace(commodityId) || qty <= 0)
+            {
+                error = "Invalid commodity or quantity.";
+                return false;
+            }
+
+            var state = GetTownState(townId);
+            if (state == null)
+            {
+                error = $"Town {townId} not found.";
+                return false;
+            }
+
+            List<TownWarehouseStock> snapshots = null;
+            lock (state.SyncRoot)
+            {
+                var matching = state.Warehouses.Values
+                    .Where(w => string.Equals(w.CommodityId, commodityId, StringComparison.OrdinalIgnoreCase) && w.Qty > 0)
+                    .OrderByDescending(w => w.FreshnessPct)
+                    .ThenByDescending(w => w.GradeBps)
+                    .ToList();
+
+                int totalAvail = matching.Sum(w => w.Qty);
+                if (totalAvail < qty)
+                {
+                    error = $"Insufficient {commodityId} in town warehouse ({totalAvail} < {qty}).";
+                    return false;
+                }
+
+                int remaining = qty;
+                snapshots = new List<TownWarehouseStock>();
+                foreach (var wh in matching)
+                {
+                    if (remaining <= 0) break;
+                    int take = Math.Min(remaining, wh.Qty);
+                    wh.Qty -= take;
+                    remaining -= take;
+                    snapshots.Add(CloneWarehouse(wh));
+                }
+            }
+
+            foreach (var snap in snapshots)
+                PersistWarehouseStock(snap);
+
+            return true;
+        }
