+        public static bool IsProcurementDeskNpc(WorldObject target)
+        {
+            if (target is not Creature || target is Player || target is Vendor)
+                return false;
+
+            if (!string.IsNullOrWhiteSpace(target.Name) &&
+                target.Name.Contains("Collector", StringComparison.OrdinalIgnoreCase))
+                return true;
+
+            if (DatabaseManager.World != null && ConfigManager.Config != null)
+            {
+                try
+                {
+                    if (!string.IsNullOrWhiteSpace(target.WeenieClassName) &&
+                        target.WeenieClassName.Contains("collector", StringComparison.OrdinalIgnoreCase))
+                        return true;
+                }
+                catch { }
+            }
+
+            var giveEmotes = target.Biota?.PropertiesEmote;
+            if (giveEmotes != null)
+            {
+                foreach (var em in giveEmotes)
+                {
+                    if (em != null && em.Category == EmoteCategory.Give && IsRepeatableCoinEmote(em, out _, out _))
+                        return true;
+                }
+            }
+
+            return false;
+        }
