+        /// <summary>
+        /// Atomically validates Town Till coverage (ring-fencing ClearinghouseReservePyreals) and executes vendor buyback.
+        /// Refuses buybacks if Town Treasury Till is 0, payoutCoinAmount <= 0, or spendable till < regular payout.
+        /// </summary>
+        public static bool TryExecuteVendorSellToTown(
+            Vendor vendor,
+            Dictionary<uint, WorldObject> sellList,
+            int payoutCoinAmount,
+            out string error)
+        {
+            EnsureInitialized();
+            error = null;
+
+            if (vendor == null)
+            {
+                error = "Vendor unavailable.";
+                return false;
+            }
+
+            if (IsDisabledVendorWcid(vendor.WeenieClassId))
+            {
+                error = "This vendor is disabled in physical economy mode.";
+                return false;
+            }
+
+            var townId = ResolveTownId(vendor);
+            if (townId == 0)
+                return true; // exempt dungeon vendor
+
+            if (payoutCoinAmount <= 0)
+            {
+                error = "Vendor buyback payout is zero under current town tariffs.";
+                return false;
+            }
+
+            var state = GetTownState(townId);
+            if (state == null)
+            {
+                error = "Town economy state unavailable.";
+                return false;
+            }
+
+            long redeemedNoteFaceValue = 0;
+            long rawNotePayout = 0;
+            foreach (var item in sellList.Values)
+            {
+                if (item.ItemType == ItemType.PromissoryNote)
+                {
+                    var unitVal = item.StackUnitValue ?? GetTradeNoteDenomination(item.WeenieClassId);
+                    var face = unitVal * Math.Max(1, item.StackSize ?? 1);
+                    redeemedNoteFaceValue += face;
+                    rawNotePayout += Math.Max(1, item.Value ?? (int)Math.Min(int.MaxValue, face));
+                }
+            }
+
+            var hasNotes = redeemedNoteFaceValue > 0;
+            var notePayout = hasNotes ? Math.Min(payoutCoinAmount, rawNotePayout) : 0L;
+            var effectiveNoteFace = hasNotes ? Math.Min(notePayout, redeemedNoteFaceValue) : 0L;
+            var regularPayout = Math.Max(0L, payoutCoinAmount - notePayout);
+
+            TownControl controlSnapshot = null;
+            var ledgerSnapshots = new List<TownVendorLedger>();
+            var boughtBackStackables = new List<WorldObject>();
+
+            if (!hasNotes)
+            {
+                lock (state.SyncRoot)
+                {
+                    if (state.Control.State is "CONTESTED_HOLD" or "STARVING")
+                    {
+                        error = "Town treasury is frozen in siege escrow.";
+                        return false;
+                    }
+                    if (state.TownTillCapPyreals > 0 && payoutCoinAmount > state.TownTillCapPyreals)
+                    {
+                        error = $"Vendor buyback exceeds town till cap ({state.TownTillCapPyreals:N0}p).";
+                        return false;
+                    }
+                    var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+                    if (spendable <= 0 || spendable < payoutCoinAmount)
+                    {
+                        error = "Town treasury till cannot cover this sale.";
+                        return false;
+                    }
+
+                    state.Control.TreasuryPyreals -= payoutCoinAmount;
+                    state.Control.UpdatedUtc = DateTime.UtcNow;
+
+                    CreditSoldStackablesLocked(state, vendor, sellList, ledgerSnapshots, boughtBackStackables);
+                    controlSnapshot = CloneControl(state.Control);
+                }
+            }
+            else
+            {
+                lock (_crossTownClearinghouseLock)
+                {
+                    long crossTownNeeded = 0;
+                    long minRequiredReimbursement = 0;
+
+                    lock (state.SyncRoot)
+                    {
+                        if (regularPayout > 0 && state.Control.State is "CONTESTED_HOLD" or "STARVING")
+                        {
+                            error = "Town treasury is frozen in siege escrow.";
+                            return false;
+                        }
+                        var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+                        if (state.Control.TreasuryPyreals <= 0 || state.Control.TreasuryPyreals < payoutCoinAmount || spendable < regularPayout)
+                        {
+                            error = "Clearinghouse suspended: town treasury depleted.";
+                            return false;
+                        }
+
+                        var localReserve = Math.Min(effectiveNoteFace, Math.Min(state.Control.ClearinghouseReservePyreals, state.Control.TreasuryPyreals));
+                        crossTownNeeded = effectiveNoteFace - localReserve;
+                        var unreimbursedIfZero = Math.Max(0L, notePayout - localReserve);
+                        minRequiredReimbursement = Math.Max(0L, unreimbursedIfZero - (spendable - regularPayout));
+                    }
+
+                    long availCrossTown = 0;
+                    if (crossTownNeeded > 0 && minRequiredReimbursement > 0)
+                    {
+                        availCrossTown = GetAvailableCrossTownBackingLocked(townId);
+                        if (availCrossTown < minRequiredReimbursement)
+                        {
+                            error = "Clearinghouse suspended: town treasury depleted.";
+                            return false;
+                        }
+                    }
+
+                    long actualCrossTownNeeded = 0;
+                    lock (state.SyncRoot)
+                    {
+                        var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+                        if (state.Control.TreasuryPyreals <= 0 || state.Control.TreasuryPyreals < payoutCoinAmount || spendable < regularPayout)
+                        {
+                            error = "Clearinghouse suspended: town treasury depleted.";
+                            return false;
+                        }
+
+                        var localReserve = Math.Min(effectiveNoteFace, Math.Min(state.Control.ClearinghouseReservePyreals, state.Control.TreasuryPyreals));
+                        actualCrossTownNeeded = effectiveNoteFace - localReserve;
+                        var unreimbursedIfZero = Math.Max(0L, notePayout - localReserve);
+                        if (unreimbursedIfZero > (spendable - regularPayout) + availCrossTown)
+                        {
+                            error = "Clearinghouse suspended: town treasury depleted.";
+                            return false;
+                        }
+
+                        state.Control.TreasuryPyreals -= payoutCoinAmount;
+                        state.Control.ClearinghouseReservePyreals -= localReserve;
+                        state.Control.UpdatedUtc = DateTime.UtcNow;
+
+                        CreditSoldStackablesLocked(state, vendor, sellList, ledgerSnapshots, boughtBackStackables);
+                        controlSnapshot = CloneControl(state.Control);
+                    }
+
+                    if (actualCrossTownNeeded > 0)
+                    {
+                        var reimbursed = SettleCrossTownRedemptionExcludingTownLocked(townId, actualCrossTownNeeded);
+                        if (reimbursed > 0)
+                        {
+                            lock (state.SyncRoot)
+                            {
+                                state.Control.TreasuryPyreals += reimbursed;
+                                state.Control.UpdatedUtc = DateTime.UtcNow;
+                                controlSnapshot = CloneControl(state.Control);
+                            }
+                        }
+                    }
+                }
+            }
+
+            foreach (var sb in boughtBackStackables)
+                vendor.EnsureBoughtBackDefaultListing(sb.WeenieClassId, sb);
+
+            if (controlSnapshot != null) PersistTownControl(controlSnapshot);
+            foreach (var l in ledgerSnapshots) PersistVendorLedger(l);
+            return true;
+        }
+
+        private static void CreditSoldStackablesLocked(
+            TownRuntimeState state,
+            Vendor vendor,
+            Dictionary<uint, WorldObject> sellList,
+            List<TownVendorLedger> ledgerSnapshots,
+            List<WorldObject> boughtBackStackables)
+        {
+            foreach (var item in sellList.Values)
+            {
+                if (item.ItemType == ItemType.PromissoryNote)
+                    continue;
+
+                if (item.GetProperty(PropertyBool.DestroyOnSell) == true || item.Attuned == AttunedStatus.Attuned)
+                    continue;
+
+                // Stackables / non-unique items credit into town_vendor_ledger stock
+                if (item.MaxStackSize != null || item.MaxStructure != null)
+                {
+                    var ledger = GetOrCreateLedgerLocked(state, vendor.Guid.Full, item.WeenieClassId);
+                    ledger.StockQty += Math.Max(1, item.StackSize ?? 1);
+                    ledgerSnapshots.Add(CloneLedger(ledger));
+                    boughtBackStackables.Add(item);
+                }
+            }
+        }
+
+        /// <summary>
+        /// Routes 100% of Slumlord house purchase & maintenance pyreal/Trade-Note rent
+        /// into the controlling Town Treasury without inventing unbacked pyreals.
+        /// </summary>
+        public static long RecordSlumlordPayment(SlumLord slumlord, IReadOnlyList<(uint WeenieClassId, ItemType? ItemType, long UnitValue, int ConsumeCount)> items, string paymentKind)
+        {
+            if (slumlord == null || items == null || items.Count == 0)
+                return 0;
+
+            EnsureInitialized();
+            var townId = ResolveTownId(slumlord);
+            if (townId == 0)
+                return 0;
+
+            long coinPyreals = 0;
+            long notePyreals = 0;
+
+            foreach (var entry in items)
+            {
+                if (entry.ConsumeCount <= 0) continue;
+
+                if (entry.WeenieClassId == PyrealWcid)
+                {
+                    coinPyreals += entry.ConsumeCount;
+                }
+                else if (entry.ItemType == ItemType.PromissoryNote || IsTradeNoteWcid(entry.WeenieClassId))
+                {
+                    var unitVal = entry.UnitValue > 0 ? entry.UnitValue : GetTradeNoteDenomination(entry.WeenieClassId);
+                    notePyreals += unitVal * entry.ConsumeCount;
+                }
+            }
+
+            if (coinPyreals + notePyreals <= 0)
+                return 0;
+
+            var state = GetTownState(townId);
+            if (state == null)
+                return 0;
+
+            TownControl snap;
+            long creditedTotal;
+
+            if (notePyreals > 0)
+            {
+                lock (_crossTownClearinghouseLock)
+                {
+                    SettleFromClearinghouseReserveExcludingTownLocked(townId, notePyreals, out var crossTownSettled, out var localReserveCleared);
+                    creditedTotal = coinPyreals + crossTownSettled + localReserveCleared;
+
+                    lock (state.SyncRoot)
+                    {
+                        var now = DateTime.UtcNow;
+                        state.Control.TreasuryPyreals += coinPyreals + crossTownSettled;
+                        if (creditedTotal > 0)
+                            RecoverInsolvencyOnSpendableInflowLocked(state, now);
+                        else
+                            state.Control.LastDeliveryUtc = now;
+                        state.Control.UpdatedUtc = now;
+                        snap = CloneControl(state.Control);
+                    }
+                }
+            }
+            else
+            {
+                creditedTotal = coinPyreals;
+                lock (state.SyncRoot)
+                {
+                    var now = DateTime.UtcNow;
+                    state.Control.TreasuryPyreals += coinPyreals;
+                    if (coinPyreals > 0)
+                        RecoverInsolvencyOnSpendableInflowLocked(state, now);
+                    else
+                        state.Control.LastDeliveryUtc = now;
+                    state.Control.UpdatedUtc = now;
+                    snap = CloneControl(state.Control);
+                }
+            }
+
+            PersistTownControl(snap);
+            return creditedTotal;
+        }
