+        private static int CountMatchingInventoryUnits(Player actor, Func<WorldObject, bool> predicate)
+        {
+            int count = 0;
+            foreach (var item in actor.Inventory.Values)
+            {
+                if (predicate(item))
+                    count += Math.Max(1, item.StackSize ?? 1);
+            }
+            return count;
+        }
+
+        private static bool TryConsumeMatchingInventoryItems(Player actor, Func<WorldObject, bool> predicate, int quantity)
+        {
+            if (actor?.Inventory == null || quantity <= 0)
+                return false;
+
+            if (CountMatchingInventoryUnits(actor, predicate) < quantity)
+                return false;
+
+            int remaining = quantity;
+            var matches = actor.Inventory.Values.Where(predicate).ToList();
+            foreach (var item in matches)
+            {
+                if (remaining <= 0)
+                    break;
+
+                int stack = item.StackSize ?? 1;
+                if (actor.Session?.Network != null)
+                {
+                    int take = Math.Min(remaining, stack);
+                    if (!actor.TryConsumeFromInventoryWithNetworking(item, take))
+                        return false;
+                    remaining -= take;
+                }
+                else
+                {
+                    if (stack <= remaining)
+                    {
+                        if (!actor.TryRemoveFromInventory(item.Guid, out _))
+                            return false;
+                        try { item.Destroy(false); } catch (NullReferenceException) { }
+                        remaining -= stack;
+                    }
+                    else
+                    {
+                        item.StackSize = stack - remaining;
+                        remaining = 0;
+                    }
+                }
+            }
+            return remaining == 0;
+        }
+
+        private static void GiveCraftedStarterItem(
+            Player actor,
+            uint wcid,
+            string name,
+            int quantity,
+            WeenieType weenieType,
+            ItemType itemType,
+            int unitValue,
+            int? maxStackSize)
+        {
+            if (actor == null || quantity <= 0)
+                return;
+
+            if (maxStackSize.HasValue)
+            {
+                int remaining = quantity;
+                while (remaining > 0)
+                {
+                    int stackAmt = Math.Min(remaining, maxStackSize.Value);
+                    var wo = CreateCraftedOutputObject(wcid, name, weenieType, itemType, unitValue, maxStackSize);
+                    if (wo != null)
+                    {
+                        wo.SetStackSize(stackAmt);
+                        AddCraftedObjectToPlayer(actor, wo);
+                    }
+                    remaining -= stackAmt;
+                }
+            }
+            else
+            {
+                for (int i = 0; i < quantity; i++)
+                {
+                    var wo = CreateCraftedOutputObject(wcid, name, weenieType, itemType, unitValue, null);
+                    if (wo != null)
+                        AddCraftedObjectToPlayer(actor, wo);
+                }
+            }
+        }
+
+        private static WorldObject CreateCraftedOutputObject(
+            uint wcid,
+            string name,
+            WeenieType weenieType,
+            ItemType itemType,
+            int unitValue,
+            int? maxStackSize)
+        {
+            if (DatabaseManager.World != null)
+            {
+                try
+                {
+                    var created = WorldObjectFactory.CreateNewWorldObject(wcid);
+                    if (created != null)
+                        return created;
+                }
+                catch { }
+            }
+
+            ObjectGuid guid;
+            try
+            {
+                guid = GuidManager.NewDynamicGuid();
+            }
+            catch (NullReferenceException)
+            {
+                guid = new ObjectGuid(0x75000000u | ((uint)Random.Shared.Next(0x00010000, 0x000FFFFF)));
+            }
+
+            var weenie = new Weenie
+            {
+                WeenieClassId = wcid,
+                ClassName = $"hbhearth_{wcid}",
+                WeenieType = weenieType,
+                PropertiesInt = new Dictionary<PropertyInt, int>
+                {
+                    [PropertyInt.ItemType] = (int)itemType,
+                    [PropertyInt.Value] = unitValue,
+                },
+                PropertiesString = new Dictionary<PropertyString, string>
+                {
+                    [PropertyString.Name] = name,
+                    [PropertyString.PluralName] = name + "s",
+                },
+                PropertiesBool = new Dictionary<PropertyBool, bool>(),
+                PropertiesFloat = new Dictionary<PropertyFloat, double>(),
+                PropertiesDID = new Dictionary<PropertyDataId, uint>(),
+                PropertiesInt64 = new Dictionary<PropertyInt64, long>(),
+            };
+            if (maxStackSize.HasValue)
+            {
+                weenie.PropertiesInt[PropertyInt.MaxStackSize] = maxStackSize.Value;
+                weenie.PropertiesInt[PropertyInt.StackSize] = 1;
+                weenie.PropertiesInt[PropertyInt.StackUnitValue] = unitValue;
+                return new Stackable(weenie, guid);
+            }
+            return new GenericObject(weenie, guid);
+        }
+
+        private static void AddCraftedObjectToPlayer(Player actor, WorldObject wo)
+        {
+            if (actor.Session?.Network != null)
+            {
+                if (!actor.TryCreateInInventoryWithNetworking(wo))
+                {
+                    try { wo.Destroy(false); } catch (NullReferenceException) { }
+                }
+            }
+            else
+            {
+                if (!actor.TryAddToInventory(wo, out _, burdenCheck: false))
+                {
+                    try { wo.Destroy(false); } catch (NullReferenceException) { }
+                }
+            }
+        }
