+        private static void AdvanceTownTick(TownRuntimeState state, double dt, DateTime now, uint? liveRingHolder, bool skipStateAdvance)
+        {
+            TownControl snapToPersist = null;
+            uint? flipTownId = null;
+            uint flipNewOwner = 0;
+            uint flipOldOwner = 0;
+            bool isSiegeFlip = false;
+            string alertTitle = null;
+            string alertBody = null;
+
+            lock (state.SyncRoot)
+            {
+                if (state.CooldownRemainingSec > 0.0)
+                {
+                    state.CooldownRemainingSec = Math.Max(0.0, state.CooldownRemainingSec - dt);
+                    if (state.CooldownRemainingSec <= 0.0)
+                    {
+                        state.CooldownMonarchId = 0;
+                        state.Control.CooldownUntilUtc = null;
+                    }
+                }
+
+                if (!skipStateAdvance)
+                {
+                    switch (state.Control.State)
+                    {
+                        case "UNCLAIMED_COLD":
+                        {
+                            if (state.ClaimMonarchId != 0)
+                            {
+                                if (!liveRingHolder.HasValue || liveRingHolder.Value == state.ClaimMonarchId)
+                                {
+                                    state.ClaimElapsedSec += dt;
+                                    if (state.ClaimElapsedSec >= ClaimDurationSec)
+                                    {
+                                        state.Control.OwnerMonarchId = state.ClaimMonarchId;
+                                        state.Control.State = "CONTROLLED";
+                                        state.ClaimMonarchId = 0;
+                                        state.ClaimElapsedSec = 0.0;
+                                        state.InactivityElapsedSec = 0.0;
+                                        state.InsolvencyGraceElapsedSec = 0.0;
+                                        state.InsolventSinceUtc = null;
+                                        state.Control.LastDeliveryUtc = now;
+                                        state.Control.UpdatedUtc = now;
+                                        flipTownId = state.Control.TownId;
+                                        flipNewOwner = state.Control.OwnerMonarchId;
+                                        flipOldOwner = 0;
+                                        snapToPersist = TownEconomyManager.CloneControlSnapshot(state.Control);
+                                    }
+                                }
+                                else
+                                {
+                                    state.ClaimElapsedSec = 0.0;
+                                }
+                            }
+                            break;
+                        }
+
+                        case "CONTROLLED":
+                        {
+                            if (state.BreachMonarchId != 0)
+                            {
+                                if (!liveRingHolder.HasValue)
+                                {
+                                    state.BreachElapsedSec += dt;
+                                    if (state.BreachElapsedSec >= BreachGateSec)
+                                    {
+                                        EnterContestedHoldLocked(state, state.BreachMonarchId, now, out alertTitle, out alertBody);
+                                        snapToPersist = TownEconomyManager.CloneControlSnapshot(state.Control);
+                                    }
+                                }
+                            }
+                            else
+                            {
+                                var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+                                if (spendable <= 0 && state.Control.OwnerMonarchId != 0)
+                                {
+                                    state.InactivityElapsedSec += dt;
+                                    if (state.InactivityElapsedSec >= InsolvencyThresholdSec)
+                                    {
+                                        state.Control.State = "INSOLVENT_RECEIVERSHIP";
+                                        state.InsolventSinceUtc = now;
+                                        state.InsolvencyGraceElapsedSec = state.InactivityElapsedSec - InsolvencyThresholdSec;
+                                        state.Control.UpdatedUtc = now;
+                                        if (state.InsolvencyGraceElapsedSec >= InsolvencyGraceSec)
+                                        {
+                                            RevertToUnclaimedColdLocked(state, now);
+                                            flipTownId = state.Control.TownId;
+                                            flipNewOwner = 0;
+                                            flipOldOwner = 0;
+                                        }
+                                        snapToPersist = TownEconomyManager.CloneControlSnapshot(state.Control);
+                                    }
+                                }
+                                else
+                                {
+                                    state.InactivityElapsedSec = 0.0;
+                                }
+                            }
+                            break;
+                        }
+
+                        case "CONTESTED_HOLD":
+                        {
+                            double meter = state.SupplyMeterSecExact;
+                            if (meter > 0.0)
+                            {
+                                double suppliedDt = Math.Min(dt, meter);
+                                state.HoldElapsedSecExact += suppliedDt;
+                                state.SupplyMeterSecExact = Math.Max(0.0, meter - suppliedDt);
+                                if (state.ApronSupplySp > 0.0)
+                                {
+                                    state.ApronSupplySp = state.SupplyMeterSecExact <= 0.0
+                                        ? 0.0
+                                        : Math.Max(0.0, state.ApronSupplySp * (state.SupplyMeterSecExact / meter));
+                                }
+                                state.Control.HoldElapsedSec = (int)Math.Floor(state.HoldElapsedSecExact);
+                                state.Control.SupplyMeterSec = (int)Math.Ceiling(state.SupplyMeterSecExact);
+
+                                if (state.HoldElapsedSecExact >= HoldDurationSec)
+                                {
+                                    flipTownId = state.Control.TownId;
+                                    flipNewOwner = state.Control.AttackerMonarchId;
+                                    flipOldOwner = state.Control.OwnerMonarchId;
+
+                                    if (flipNewOwner != 0)
+                                    {
+                                        isSiegeFlip = true;
+                                        state.Control.OwnerMonarchId = flipNewOwner;
+                                        state.Control.AttackerMonarchId = 0;
+                                        state.Control.State = "CONTROLLED";
+                                        state.Control.HoldElapsedSec = 0;
+                                        state.Control.SupplyMeterSec = 0;
+                                        state.Control.StarvingSec = 0;
+                                        state.HoldElapsedSecExact = 0.0;
+                                        state.SupplyMeterSecExact = 0.0;
+                                        state.StarvingSecExact = 0.0;
+                                        state.DefenderHoldElapsedSec = 0.0;
+                                        state.ThreeWayCandidateMonarchId = 0;
+                                        state.ThreeWayHoldElapsedSec = 0.0;
+                                        state.BreachMonarchId = 0;
+                                        state.BreachElapsedSec = 0.0;
+                                        state.ApronSupplySp = 0.0;
+                                        state.InactivityElapsedSec = 0.0;
+                                        state.InsolvencyGraceElapsedSec = 0.0;
+                                        state.InsolventSinceUtc = null;
+                                    }
+                                    else
+                                    {
+                                        TownEconomyManager.RestoreEscrowToTreasuryLocked(state);
+                                        RevertToUnclaimedColdLocked(state, now);
+                                        snapToPersist = TownEconomyManager.CloneControlSnapshot(state.Control);
+                                    }
+                                }
+                                else if (state.SupplyMeterSecExact <= 0.0)
+                                {
+                                    state.Control.State = "STARVING";
+                                    state.Control.SupplyMeterSec = 0;
+                                    double leftover = dt - suppliedDt;
+                                    if (leftover > 0.0)
+                                    {
+                                        state.StarvingSecExact += leftover;
+                                        state.Control.StarvingSec = (int)Math.Floor(state.StarvingSecExact);
+                                        if (state.StarvingSecExact >= StarvationCollapseSec)
+                                        {
+                                            CollapseStarvingSiegeLocked(state, now, out alertTitle, out alertBody);
+                                        }
+                                    }
+                                    if (!state.SupplyLowAlertSent && string.IsNullOrEmpty(alertBody))
+                                    {
+                                        state.SupplyLowAlertSent = true;
+                                        state.AlertCount++;
+                                        alertTitle = "supply_low";
+                                        alertBody = $"SUPPLY LOW at {state.Control.Name}! Siege supply meter depleted (STARVING).";
+                                        state.LastAlertMessage = alertBody;
+                                    }
+                                }
+                                else if (state.SupplyMeterSecExact <= 900.0 && !state.SupplyLowAlertSent)
+                                {
+                                    state.SupplyLowAlertSent = true;
+                                    state.AlertCount++;
+                                    alertTitle = "supply_low";
+                                    alertBody = $"SUPPLY LOW at {state.Control.Name}! Supply meter dropped to {state.SupplyMeterSecExact:0}s.";
+                                    state.LastAlertMessage = alertBody;
+                                }
+                            }
+                            else
+                            {
+                                state.Control.State = "STARVING";
+                                state.Control.SupplyMeterSec = 0;
+                                state.StarvingSecExact += dt;
+                                state.Control.StarvingSec = (int)Math.Floor(state.StarvingSecExact);
+                                if (state.StarvingSecExact >= StarvationCollapseSec)
+                                {
+                                    CollapseStarvingSiegeLocked(state, now, out alertTitle, out alertBody);
+                                }
+                                else if (!state.SupplyLowAlertSent)
+                                {
+                                    state.SupplyLowAlertSent = true;
+                                    state.AlertCount++;
+                                    alertTitle = "supply_low";
+                                    alertBody = $"SUPPLY LOW at {state.Control.Name}! Siege supply meter depleted (STARVING).";
+                                    state.LastAlertMessage = alertBody;
+                                }
+                            }
+                            state.Control.UpdatedUtc = now;
+                            if (!isSiegeFlip && snapToPersist == null)
+                                snapToPersist = TownEconomyManager.CloneControlSnapshot(state.Control);
+                            break;
+                        }
+
+                        case "STARVING":
+                        {
+                            // HoldElapsedSec is PAUSED while STARVING
+                            state.StarvingSecExact += dt;
+                            state.Control.StarvingSec = (int)Math.Floor(state.StarvingSecExact);
+                            if (state.StarvingSecExact >= StarvationCollapseSec)
+                            {
+                                CollapseStarvingSiegeLocked(state, now, out alertTitle, out alertBody);
+                            }
+                            else if (!state.SupplyLowAlertSent)
+                            {
+                                state.SupplyLowAlertSent = true;
+                                state.AlertCount++;
+                                alertTitle = "supply_low";
+                                alertBody = $"SUPPLY LOW at {state.Control.Name}! Siege supply meter depleted (STARVING).";
+                                state.LastAlertMessage = alertBody;
+                            }
+                            state.Control.UpdatedUtc = now;
+                            snapToPersist = TownEconomyManager.CloneControlSnapshot(state.Control);
+                            break;
+                        }
+
+                        case "INSOLVENT_RECEIVERSHIP":
+                        {
+                            state.InsolvencyGraceElapsedSec += dt;
+                            if (state.InsolvencyGraceElapsedSec >= InsolvencyGraceSec)
+                            {
+                                RevertToUnclaimedColdLocked(state, now);
+                                flipTownId = state.Control.TownId;
+                                flipNewOwner = 0;
+                                flipOldOwner = 0;
+                                snapToPersist = TownEconomyManager.CloneControlSnapshot(state.Control);
+                            }
+                            break;
+                        }
+                    }
+                }
+            }
+
+            if (isSiegeFlip && flipTownId.HasValue && flipNewOwner != 0)
+            {
+                TownEconomyManager.SettleSiegeFlipTreasury(flipTownId.Value, flipNewOwner, flipOldOwner, out var spoils, out var evacuated);
+                SyncTownRadarIff(flipTownId.Value, flipNewOwner, flipOldOwner);
+                EmitSiegeAlert(flipTownId.Value, "town_flipped",
+                    $"Town {TownRegistry.GetById(flipTownId.Value)?.Name ?? $"#{flipTownId.Value}"} flipped to Monarch {flipNewOwner}! Spoils: {spoils:N0}p (Evacuated: {evacuated:N0}p).");
+                return;
+            }
+
+            if (flipTownId.HasValue)
+            {
+                SyncTownRadarIff(flipTownId.Value, flipNewOwner, flipOldOwner);
+            }
+
+            if (snapToPersist != null)
+                TownEconomyManager.PersistControlSnapshot(snapToPersist);
+
+            if (!string.IsNullOrEmpty(alertBody))
+                EmitSiegeAlert(state.Control.TownId, alertTitle, alertBody);
+        }
