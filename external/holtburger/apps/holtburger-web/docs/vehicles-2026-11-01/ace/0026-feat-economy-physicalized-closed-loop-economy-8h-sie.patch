+        private static void SeedInMemoryLocked()
+        {
+            foreach (var row in CreateDefaultSeedDeposits())
+            {
+                if (!deposits.ContainsKey(row.DepositId))
+                    deposits[row.DepositId] = CloneDeposit(row);
+            }
+        }
