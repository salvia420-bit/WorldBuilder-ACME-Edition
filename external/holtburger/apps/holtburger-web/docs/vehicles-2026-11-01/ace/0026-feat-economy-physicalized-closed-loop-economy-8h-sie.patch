+        public static bool TryProcessBioPerishable(
+            IndustrySkidDeployable bioProcessor,
+            WorldObject item,
+            uint targetTownId,
+            out string outputCommodity,
+            out int outputQty,
+            out string error)
+        {
+            outputCommodity = "";
+            outputQty = 0;
+
+            if (bioProcessor == null || bioProcessor.Kind != DeployableKind.BioProcessorTannery)
+            {
+                error = "Bio-Processor & Tannery (4000085) required.";
+                return false;
+            }
+            if (!bioProcessor.IsPowered)
+            {
+                error = "Bio-Processor & Tannery (18 kW) is browned out.";
+                return false;
+            }
+            if (item == null || item.IsDestroyed)
+            {
+                error = "Input perishable item is unavailable.";
+                return false;
+            }
+
+            var cat = PerishableDecay.Classify(item.WeenieClassId, item.Name, item.WeenieType);
+            if (cat == PerishableCategory.None)
+            {
+                error = "Item is not a raw biological/botanical feedstock.";
+                return false;
+            }
+
+            double freshnessPct = PerishableDecay.GetFreshnessPercent(item);
+            if (freshnessPct <= 0.0)
+            {
+                error = $"{item.Name} has spoiled (0% freshness) and cannot be processed.";
+                return false;
+            }
+
+            int stack = Math.Max(1, item.StackSize ?? 1);
+            outputQty = Math.Max(1, (int)Math.Round(stack * (0.5 + 0.5 * (freshnessPct / 100.0))));
+            outputCommodity = cat switch
+            {
+                PerishableCategory.FreshHide => "cured_leather",
+                PerishableCategory.BioGlandIchorVenom => "arcane_ink",
+                PerishableCategory.FreshHerb => "dried_herb",
+                PerishableCategory.DairyAndMeat => "preserved_rations",
+                _ => "bio_intermediate",
+            };
+
+            if (targetTownId != 0)
+                TownEconomyManager.RecordWarehouseDelivery(targetTownId, outputCommodity, outputQty, 10000, 100.0f, false);
+
+            try { item.Destroy(false); } catch (NullReferenceException) { }
+            RecordFacilityState(bioProcessor, targetTownId, 0, outputCommodity);
+            error = null;
+            return true;
+        }
