+        /// <summary>
+        /// Atomically validates and commits a player purchase from a vendor without nested town locks.
+        /// Handles finite stock deduction, 1:1 Trade Note Clearinghouse (Parchment + Ink + reserve),
+        /// Scrivener/Spell-Service physical reagent draw, and Alt-Currency 250k revenue routing.
+        /// </summary>
+        public static bool TryExecuteVendorPurchase(
+            Vendor vendor,
+            List<WorldObject> defaultItems,
+            List<WorldObject> uniqueItems,
+            uint totalPrice,
+            out string error)
+        {
+            EnsureInitialized();
+            error = null;
+
+            if (vendor == null)
+            {
+                error = "Vendor unavailable.";
+                return false;
+            }
+
+            if (IsDisabledVendorWcid(vendor.WeenieClassId))
+            {
+                error = "This vendor is disabled in physical economy mode.";
+                return false;
+            }
+
+            var seenUniqueGuids = new HashSet<uint>();
+            foreach (var item in uniqueItems)
+            {
+                if (!seenUniqueGuids.Add(item.Guid.Full))
+                {
+                    error = "Duplicate unique item in purchase request.";
+                    return false;
+                }
+            }
+
+            foreach (var item in defaultItems.Concat(uniqueItems))
+            {
+                if (item.WeenieType == WeenieType.Coin || item.WeenieClassId == PyrealWcid)
+                {
+                    error = "Pyreal coin listings are disabled in physical economy mode.";
+                    return false;
+                }
+            }
+
+            var townId = ResolveTownId(vendor);
+            if (townId == 0)
+            {
+                // Exempt indoor dungeon vendor: token & dungeon rules preserved untouched
+                return true;
+            }
+
+            var state = GetTownState(townId);
+            if (state == null)
+            {
+                error = "Town economy state unavailable.";
+                return false;
+            }
+
+            var ledgerSnapshots = new List<TownVendorLedger>();
+            var warehouseSnapshots = new List<TownWarehouseStock>();
+            TownControl controlSnapshot = null;
+
+            if (vendor.AlternateCurrency.HasValue && vendor.AlternateCurrency.Value == TradeNote250kWcid)
+            {
+                var pyrealEquiv = (long)totalPrice * 250_000L;
+
+                lock (_crossTownClearinghouseLock)
+                {
+                    if (pyrealEquiv > 0)
+                    {
+                        var totalBacked = GetTotalBackedClearinghouseReserveLocked();
+                        if (totalBacked < pyrealEquiv)
+                        {
+                            error = "Clearinghouse suspended: insufficient Trade Note (250,000) backing reserve.";
+                            return false;
+                        }
+                    }
+
+                    lock (state.SyncRoot)
+                    {
+                        if (!TryReserveAndApplyPurchaseItemsLocked(state, vendor, defaultItems, ledgerSnapshots, warehouseSnapshots, out error))
+                            return false;
+                    }
+
+                    long settledFromOthers = 0;
+                    if (pyrealEquiv > 0)
+                        SettleFromClearinghouseReserveExcludingTownLocked(townId, pyrealEquiv, out settledFromOthers, out _);
+
+                    lock (state.SyncRoot)
+                    {
+                        var now = DateTime.UtcNow;
+                        state.Control.TreasuryPyreals += settledFromOthers;
+                        if (settledFromOthers > 0)
+                            RecoverInsolvencyOnSpendableInflowLocked(state, now);
+                        else
+                            state.Control.LastDeliveryUtc = now;
+                        state.Control.UpdatedUtc = now;
+                        controlSnapshot = CloneControl(state.Control);
+                    }
+                }
+            }
+            else
+            {
+                lock (state.SyncRoot)
+                {
+                    if (!TryReserveAndApplyPurchaseItemsLocked(state, vendor, defaultItems, ledgerSnapshots, warehouseSnapshots, out error))
+                        return false;
+
+                    // Phase 3: Revenue & clearinghouse accounting
+                    if (vendor.AlternateCurrency == null)
+                    {
+                        long promissoryFaceValue = 0;
+                        foreach (var item in defaultItems)
+                        {
+                            if (item.ItemType == ItemType.PromissoryNote)
+                            {
+                                var unitVal = item.StackUnitValue ?? GetTradeNoteDenomination(item.WeenieClassId);
+                                promissoryFaceValue += unitVal * Math.Max(1, item.StackSize ?? 1);
+                            }
+                        }
+
+                        var now = DateTime.UtcNow;
+                        state.Control.TreasuryPyreals += totalPrice;
+                        if (promissoryFaceValue > 0)
+                            state.Control.ClearinghouseReservePyreals += promissoryFaceValue;
+                        if (totalPrice > promissoryFaceValue)
+                            RecoverInsolvencyOnSpendableInflowLocked(state, now);
+                        else
+                            state.Control.LastDeliveryUtc = now;
+                        state.Control.UpdatedUtc = now;
+                        controlSnapshot = CloneControl(state.Control);
+                    }
+                    // Else: non-pyreal dungeon/society tokens remain 100% untouched.
+                }
+            }
+
+            if (controlSnapshot != null) PersistTownControl(controlSnapshot);
+            foreach (var l in ledgerSnapshots) PersistVendorLedger(l);
+            foreach (var w in warehouseSnapshots) PersistWarehouseStock(w);
+
+            return true;
+        }
+
+        private static bool TryReserveAndApplyPurchaseItemsLocked(
+            TownRuntimeState state,
+            Vendor vendor,
+            List<WorldObject> defaultItems,
+            List<TownVendorLedger> ledgerSnapshots,
+            List<TownWarehouseStock> warehouseSnapshots,
+            out string error)
+        {
+            error = null;
+            var ledgerDeltas = new Dictionary<(uint vendorGuid, uint wcid), int>();
+            var warehouseDeltas = new Dictionary<(string commodityId, int gradeBps, bool poweredReefer), int>();
+
+            foreach (var item in defaultItems)
+            {
+                var qty = Math.Max(1, item.StackSize ?? 1);
+
+                if (item.ItemType == ItemType.PromissoryNote)
+                {
+                    if (!TryReserveSupplyLocked(state, vendor.Guid.Full, new[] { ParchmentWcid }, ParchmentCommodities, qty, ledgerDeltas, warehouseDeltas))
+                    {
+                        error = "Out of parchment for Trade Note issuance.";
+                        return false;
+                    }
+                    if (!TryReserveSupplyLocked(state, vendor.Guid.Full, InkWcids, InkCommodities, qty, ledgerDeltas, warehouseDeltas))
+                    {
+                        error = "Out of ink for Trade Note issuance.";
+                        return false;
+                    }
+                }
+                else if (item.GetProperty(PropertyBool.VendorService) == true)
+                {
+                    var spell = TryResolveSpellSafe(item.SpellDID ?? 0);
+                    if (!TryReserveSpellServiceReagentsLocked(state, vendor.Guid.Full, spell, qty, ledgerDeltas, warehouseDeltas))
+                    {
+                        error = "Out of reagents";
+                        return false;
+                    }
+                }
+                else if (item.WeenieType == WeenieType.Scroll)
+                {
+                    var availableDirect = GetProjectedLedgerQtyLocked(state, vendor.Guid.Full, item.WeenieClassId, ledgerDeltas);
+                    if (availableDirect >= qty)
+                    {
+                        AddDelta(ledgerDeltas, (vendor.Guid.Full, item.WeenieClassId), -qty);
+                    }
+                    else
+                    {
+                        var spell = TryResolveSpellSafe(item.SpellDID ?? 0);
+                        if (!TryReserveScrollReagentsLocked(state, vendor.Guid.Full, spell, qty, ledgerDeltas, warehouseDeltas))
+                        {
+                            error = "Out of reagents";
+                            return false;
+                        }
+                    }
+                }
+                else
+                {
+                    var available = GetProjectedLedgerQtyLocked(state, vendor.Guid.Full, item.WeenieClassId, ledgerDeltas);
+                    if (available < qty)
+                    {
+                        error = $"{vendor.Name} is out of stock for {item.Name}.";
+                        return false;
+                    }
+                    AddDelta(ledgerDeltas, (vendor.Guid.Full, item.WeenieClassId), -qty);
+                }
+            }
+
+            foreach (var kvp in ledgerDeltas)
+            {
+                var ledger = GetOrCreateLedgerLocked(state, kvp.Key.vendorGuid, kvp.Key.wcid);
+                ledger.StockQty = Math.Max(0, ledger.StockQty + kvp.Value);
+                ledgerSnapshots.Add(CloneLedger(ledger));
+            }
+
+            foreach (var kvp in warehouseDeltas)
+            {
+                if (state.Warehouses.TryGetValue(kvp.Key, out var wh))
+                {
+                    wh.Qty = Math.Max(0, wh.Qty + kvp.Value);
+                    warehouseSnapshots.Add(CloneWarehouse(wh));
+                }
+            }
+
+            return true;
+        }
