+        public static LogisticsConvoyState DispatchSeaConvoy(
+            uint ownerMonarchId,
+            uint originPortId,
+            uint destPortId,
+            out string error,
+            uint containerKind = 0,
+            string commodityId = "",
+            int commodityQty = 0,
+            double? initialFuelLiters = null,
+            IsoContainerDeployable attachedContainer = null,
+            uint destTownIdForDelivery = 0,
+            ulong? explicitConvoyId = null,
+            string ownerMonarchName = "")
+        {
+            error = null;
+            if (originPortId == 0 || destPortId == 0 || originPortId == destPortId)
+            {
+                error = originPortId == destPortId
+                    ? "Origin and destination ports must be different."
+                    : "Origin and destination ports are required.";
+                return null;
+            }
+
+            LogisticsNavGraph nav;
+            try
+            {
+                nav = LogisticsNavGraph.LoadDefault();
+            }
+            catch (Exception ex)
+            {
+                error = $"Navigation graph unavailable: {ex.Message}";
+                return null;
+            }
+
+            if (!nav.TryFindSeaRoute(originPortId, destPortId, out var seaRoute) || seaRoute.TotalLengthM <= 0.0)
+            {
+                error = $"No valid Outer Ocean sea route from port {originPortId} to port {destPortId} (Item 2 Inner Sea excluded).";
+                return null;
+            }
+
+            var originPort = nav.GetPort(originPortId);
+            var destPort = nav.GetPort(destPortId);
+            var startPose = LogisticsNavGraph.SamplePoseAtDistance(seaRoute, 0.0);
+            uint originLb = originPort != null
+                ? LogisticsNavGraph.NormalizePackedLandblockId(originPort.LandblockId, originPort.ContinentId)
+                : 0u;
+            if (originLb == 0)
+                originLb = startPose.LandblockId;
+
+            double fuel = initialFuelLiters ?? DefaultFeederShipFuelLiters;
+            if (!double.IsFinite(fuel) || fuel < 0.0) fuel = 0.0;
+
+            uint resolvedDestTown = destTownIdForDelivery;
+            if (resolvedDestTown == 0 && destPort != null)
+            {
+                var nearestTown = TownRegistry.AllTowns
+                    .OrderBy(t => Math.Pow(t.WorldX - destPort.X, 2) + Math.Pow(t.WorldY - destPort.Y, 2))
+                    .FirstOrDefault();
+                resolvedDestTown = nearestTown?.TownId ?? 0u;
+            }
+
+            string resolvedMonarchName = !string.IsNullOrWhiteSpace(ownerMonarchName)
+                ? ownerMonarchName
+                : ResolveMonarchName(ownerMonarchId);
+
+            LogisticsConvoyState convoy;
+            Vehicle staleVehicleToDespawn = null;
+            lock (_tickLock)
+            {
+                ulong convoyId;
+                if (explicitConvoyId.HasValue && explicitConvoyId.Value != 0)
+                {
+                    convoyId = explicitConvoyId.Value;
+                    if (_convoys.TryGetValue(convoyId, out var existing))
+                    {
+                        uint existingOwner;
+                        lock (existing.SyncRoot)
+                        {
+                            existingOwner = existing.OwnerMonarchId;
+                        }
+                        if (existingOwner != ownerMonarchId)
+                        {
+                            error = $"Convoy ID {convoyId} belongs to another Allegiance.";
+                            return null;
+                        }
+                        lock (existing.SyncRoot)
+                        {
+                            staleVehicleToDespawn = existing.ActiveVehicle;
+                            existing.ActiveVehicle = null;
+                            existing.VehicleGuid = 0;
+                            existing.LodState = LogisticsLodState.Macro;
+                        }
+                    }
+                    if (convoyId >= _nextConvoyId)
+                        _nextConvoyId = convoyId + 1;
+                }
+                else
+                {
+                    convoyId = _nextConvoyId++;
+                    while (_convoys.ContainsKey(convoyId))
+                        convoyId = _nextConvoyId++;
+                }
+
+                convoy = new LogisticsConvoyState
+                {
+                    ConvoyId = convoyId,
+                    OwnerMonarchId = ownerMonarchId,
+                    OwnerMonarchName = resolvedMonarchName,
+                    VehicleGuid = 0,
+                    VehicleKind = "ContainerShipFeeder",
+                    VehicleClass = (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder,
+                    LodState = LogisticsLodState.Macro,
+                    Status = fuel <= 0.0 ? LogisticsConvoyStatus.OutOfFuel : LogisticsConvoyStatus.EnRoute,
+                    OriginTownId = originPortId,
+                    DestTownId = resolvedDestTown,
+                    OriginPortId = seaRoute.OriginPortId != 0 ? seaRoute.OriginPortId : originPortId,
+                    DestPortId = seaRoute.DestPortId != 0 ? seaRoute.DestPortId : destPortId,
+                    OriginLandblockId = originLb,
+                    ContainerKind = containerKind != 0 ? containerKind : (attachedContainer?.Wcid ?? 0u),
+                    CommodityId = commodityId ?? "",
+                    CommodityQty = Math.Max(0, commodityQty),
+                    SplineSM = 0.0,
+                    FuelLiters = fuel,
+                    WorldX = startPose.X,
+                    WorldY = startPose.Y,
+                    WorldZ = 0.0,
+                    HeadingRad = startPose.HeadingRad,
+                    Route = seaRoute,
+                    AttachedContainer = attachedContainer,
+                    UpdatedUtc = DateTime.UtcNow,
+                };
+
+                if (attachedContainer != null)
+                {
+                    attachedContainer.OriginLandblockId = originLb;
+                    attachedContainer.ExternalReeferPowerConnected = convoy.FuelLiters > 0.0;
+                }
+
+                _convoys[convoy.ConvoyId] = convoy;
+            }
+
+            if (staleVehicleToDespawn != null)
+            {
+                try { VehicleManager.Despawn(staleVehicleToDespawn, "convoy-replaced"); } catch { }
+            }
+
+            PersistConvoy(convoy);
