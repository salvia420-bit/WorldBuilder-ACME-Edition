+        private static bool CheckRadarIntersectionLocked(LogisticsConvoyState convoy, out uint detectingMonarchId, out uint sensorGuid)
+        {
+            detectingMonarchId = 0;
+            sensorGuid = 0;
+
+            // 1. Check ground tactical radars (600 m range)
+            foreach (var dep in DeployableManager.GetAll())
+            {
+                if (dep is not GroundRadarDeployable radar || radar.IsDestroyed || radar.IsPacked || !radar.IsActive)
+                    continue;
+                if (!radar.IsPowered)
+                    continue;
+
+                var rPos = radar.GlobalPosition;
+                double dx = convoy.WorldX - rPos.X;
+                double dy = convoy.WorldY - rPos.Y;
+                if (dx * dx + dy * dy > GroundRadarDeployable.MaxRangeM * GroundRadarDeployable.MaxRangeM)
+                    continue;
+
+                string convoyMonarchName = !string.IsNullOrWhiteSpace(convoy.OwnerMonarchName)
+                    ? convoy.OwnerMonarchName
+                    : null;
+
+                var standing = RadarIff.ResolveStanding(
+                    0u,
+                    convoy.OwnerMonarchId != 0 ? convoy.OwnerMonarchId : (uint?)null,
+                    convoyMonarchName,
+                    0u,
+                    radar.DeployerPlayerGuid,
+                    radar.EffectiveMonarchId,
+                    0u,
+                    radar.EffectivePolicy);
+
+                if (standing == IffStanding.Hostile)
+                {
+                    detectingMonarchId = radar.EffectiveMonarchId;
+                    sensorGuid = radar.Guid.Full;
+                    return true;
+                }
+            }
+
+            // 2. Check strategic AirDefense radar stations (32 km range; detects overland & sea convoys within range/LOS)
+            foreach (var station in AirDefenseManager.Stations)
+            {
+                if (station == null || station.IsDestroyed)
+                    continue;
+
+                var sPos = station.Position;
+                double dx = convoy.WorldX - sPos.X;
+                double dy = convoy.WorldY - sPos.Y;
+                double maxR = RadarStation.MaxRangeM > 0f ? RadarStation.MaxRangeM : AirDefenseManager.MaxDetectionRangeM;
+                if (dx * dx + dy * dy > maxR * maxR)
+                    continue;
+
+                string convoyMonarchName = !string.IsNullOrWhiteSpace(convoy.OwnerMonarchName)
+                    ? convoy.OwnerMonarchName
+                    : null;
+
+                var standing = RadarIff.ResolveStanding(
+                    0u,
+                    convoy.OwnerMonarchId != 0 ? convoy.OwnerMonarchId : (uint?)null,
+                    convoyMonarchName,
+                    0u,
+                    station.DeployerPlayerGuid,
+                    station.EffectiveMonarchId,
+                    0u,
+                    station.EffectivePolicy);
+
+                if (standing == IffStanding.Hostile)
+                {
+                    detectingMonarchId = station.EffectiveMonarchId;
+                    sensorGuid = station.Guid.Full;
+                    return true;
+                }
+            }
+
+            return false;
+        }
