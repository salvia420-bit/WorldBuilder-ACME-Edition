+-- Phase E: Monarch Work-Order & Procurement Bounty Table (MariaDB utf8mb4_general_ci)
+
+CREATE TABLE IF NOT EXISTS `monarch_order` (
+  `order_id` BIGINT UNSIGNED NOT NULL,
+  `monarch_id` INT UNSIGNED NOT NULL,
+  `town_id` INT UNSIGNED NOT NULL,
+  `order_type` VARCHAR(32) NOT NULL DEFAULT 'ProcurementBounty',
+  `item_wcid` INT UNSIGNED NOT NULL DEFAULT 0,
+  `commodity_id` VARCHAR(64) NOT NULL DEFAULT '',
+  `target_qty` INT NOT NULL DEFAULT 0,
+  `remaining_qty` INT NOT NULL DEFAULT 0,
+  `reward_pyreals` BIGINT NOT NULL DEFAULT 0,
+  `claimed_by_guid` INT UNSIGNED NOT NULL DEFAULT 0,
+  `status` VARCHAR(24) NOT NULL DEFAULT 'Open',
+  `created_utc` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  `updated_utc` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+  PRIMARY KEY (`order_id`),
+  KEY `idx_mo_monarch` (`monarch_id`),
+  KEY `idx_mo_town_status` (`town_id`, `status`),
+  KEY `idx_mo_wcid` (`item_wcid`),
+  CONSTRAINT `fk_mo_town` FOREIGN KEY (`town_id`) REFERENCES `town_control` (`town_id`) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
