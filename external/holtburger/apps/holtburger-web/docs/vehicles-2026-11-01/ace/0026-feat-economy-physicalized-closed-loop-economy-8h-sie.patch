@@ -0,0 +1,79 @@
+using System;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Enum.Properties;
+using ACE.Entity.Models;
+using ACE.Server.Economy;
+using ACE.Server.Network.GameMessages.Messages;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Public Commons Starter Hearth (WCID 4000095, DeployableKind.PublicCommonsStarterHearth = 61).
+    /// 0 kW, zero-fuel, indestructible, non-packable civic hearth hydrated in Holtburg (0xA9B4),
+    /// Shoushi (0xDA55), and Yaraq (0x7D64) to break Day-1 cold-start circular dependencies.
+    /// Excluded from ace_shard biota persistence via WorldObject_Database.cs.
+    /// </summary>
+    public class PublicCommonsStarterHearthDeployable : DeployableBase
+    {
+        public const uint StarterHearthWeenieClassId = 4_000_095;
+
+        public uint TownId { get; set; }
+
+        public override bool ConnectsToMicroGrid => false;
+        public override bool IsGeneratorUnit => false;
+        public override bool IsPowerConsumerUnit => false;
+        public override float PowerWatts => 0f;
+        protected override bool BroadcastDespawnOnDestroy => false;
+
+        public PublicCommonsStarterHearthDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.PublicCommonsStarterHearth;
+            Pallet = PalletSize.None;
+            OnlineFlags = DeployableOnlineFlags.Active;
+        }
+
+        public static Weenie BuildWeenie(uint townId = 0, string townName = "Town", Vehicle parentVehicle = null, Player deployer = null)
+        {
+            var label = string.IsNullOrWhiteSpace(townName) ? "Public Commons" : townName;
+            var w = BuildDeployableWeenie(
+                StarterHearthWeenieClassId,
+                "hbtown_starter_hearth",
+                $"{label} Public Commons Starter Hearth",
+                "0 kW indestructible cold-start hearth: emergency tapers (glands/resin), crude pyreal/iron smelting, and basic herb healing kits."
+            );
+            w.PropertiesBool[PropertyBool.Stuck] = true;
+            w.PropertiesBool[PropertyBool.Attackable] = false;
+            w.PropertiesBool[PropertyBool.Ethereal] = true;
+            w.PropertiesBool[PropertyBool.IgnoreCollisions] = true;
+            w.PropertiesBool[PropertyBool.NoCorpse] = true;
+            return w;
+        }
+
+        public override bool SetStowed(bool stowed, Player actor = null) => false;
+
+        public override void Destroy(bool raiseNotifyOfDestructionEvent = true, bool fromLandblockUnload = false)
+        {
+            // Indestructible civic structure: only unloads when the hosting landblock unloads.
+            if (!fromLandblockUnload)
+                return;
+
+            base.Destroy(raiseNotifyOfDestructionEvent, fromLandblockUnload);
+        }
+
+        public override void ActOnUse(WorldObject activator)
+        {
+            if (activator is not Player player)
+                return;
+
+            IndustryManager.TryCraftStarterHearth(this, player, null, out var msg);
+            if (!string.IsNullOrWhiteSpace(msg))
+            {
+                if (player.Session?.Network != null)
+                    player.Session.Network.EnqueueSend(new GameMessageSystemChat(msg, ChatMessageType.Broadcast));
+            }
+        }
+    }
+}
