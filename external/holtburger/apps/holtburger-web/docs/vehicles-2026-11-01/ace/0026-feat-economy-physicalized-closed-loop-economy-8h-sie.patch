+        [GameAction(GameActionType.EconomySiegeAction)]
+        public static void HandleEconomySiegeAction(ClientMessage message, Session session)
+        {
+            if (!TownEconomyManager.Enabled && !VehicleManager.Enabled) return;
+            if (session?.Player == null || !VehicleManager.HasCap(session, VehicleWire.CapObserve)) return;
+            if (VehicleWire.ReadC2S(VehicleWire.OpEconomySiegeAction, message.Payload) is not EconomySiegeAction msg) return;
+
+            var player = session.Player;
+            switch (msg.Action)
+            {
+                case 0: // Query
+                    if (msg.TownId != 0)
+                        TownEconomyManager.SendTownState(player, msg.TownId);
+                    return;
+
+                case 1: // ClaimControlRing
+                {
+                    if (!TownCommands.IsAllegianceMonarch(player))
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat("Only an Allegiance Monarch may submit a Town Charter claim.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    var def = TownRegistry.GetById(msg.TownId);
+                    if (def == null)
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat($"Unknown town {msg.TownId}.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    if (player.Location == null || player.Location.Indoors)
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat($"Move outdoors within {SiegeManager.ControlRingRadiusM:0}m of {def.Name}'s Town Control Node.", ChatMessageType.Broadcast));
+                        return;
+                    }
+
+                    bool withinRing;
+                    if (SiegeManager.TryGetHydratedControlNode(def.TownId, out var node))
+                    {
+                        withinRing = node.IsPlayerInsideControlRing(player);
+                    }
+                    else
+                    {
+                        var (px, py, _) = Vehicle.ToGlobal(player.Location);
+                        withinRing = SiegeManager.IsWithinControlRing((float)Math.Sqrt(Math.Pow(px - def.WorldX, 2) + Math.Pow(py - def.WorldY, 2)));
+                    }
+                    if (!withinRing)
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat($"Move within {SiegeManager.ControlRingRadiusM:0}m of {def.Name}'s Town Control Node.", ChatMessageType.Broadcast));
+                        return;
+                    }
+
+                    var charter = TownCommands.FindTownCharterItem(player);
+                    if (!SiegeManager.TryStartClaim(def.TownId, player, charter != null, out var err))
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat(err, ChatMessageType.Broadcast));
+                        return;
+                    }
+                    TownCommands.ConsumeCharterItem(player, charter);
+                    SendSiegeEventAndState(session, def.TownId, kind: 1);
+                    return;
+                }
+
+                case 2: // DepositSupply
+                {
+                    uint tid = msg.TownId;
+                    ForwardSiegeBeaconDeployable beacon = msg.BeaconGuid != 0
+                        ? DeployableManager.GetDeployable(msg.BeaconGuid) as ForwardSiegeBeaconDeployable
+                        : null;
+                    if (beacon == null && tid != 0)
+                    {
+                        var hydrated = SiegeManager.GetHydratedEntities(tid);
+                        if (hydrated != null && hydrated.BeaconGuid != 0)
+                            beacon = DeployableManager.GetDeployable(hydrated.BeaconGuid) as ForwardSiegeBeaconDeployable;
+                    }
+
+                    if (beacon != null)
+                    {
+                        if (tid == 0)
+                            tid = beacon.ResolveTargetTownId();
+                        if (beacon.Location != null && player.Location != null)
+                        {
+                            var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                            var dist = Vector3.Distance(beacon.GlobalPosition, new Vector3((float)px, (float)py, (float)pz));
+                            if (dist > ForwardSiegeBeaconDeployable.DeliveryRadiusM)
+                            {
+                                session.Network?.EnqueueSend(new GameMessageSystemChat($"Move within {ForwardSiegeBeaconDeployable.DeliveryRadiusM:0}m of the Forward Siege Beacon.", ChatMessageType.Broadcast));
+                                return;
+                            }
+                        }
+                    }
+
+                    double sp = msg.SupplyPoints > 0 ? msg.SupplyPoints : 10.0;
+                    if (!SiegeManager.DeliverSiegeSupply(tid, msg.OriginLandblock, sp, player, out var err))
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat(err, ChatMessageType.Broadcast));
+                        return;
+                    }
+                    SendSiegeEventAndState(session, tid, kind: 3);
+                    return;
+                }
+
+                case 3: // DeployBeacon
+                {
+                    if (player.Location == null || player.Location.Indoors)
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat("Forward Siege Beacons must be deployed outdoors.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    var snap = SiegeManager.GetSiegeState(msg.TownId);
+                    if (snap == null)
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat($"Unknown town {msg.TownId}.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    uint actorMonarch = TownCommands.ResolveEffectiveMonarchId(player);
+                    if (snap.OwnerMonarchId != 0 && actorMonarch == snap.OwnerMonarchId)
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat("Defending Allegiance cannot deploy an attack siege beacon on its own town.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    if (DeployableManager.SpawnDeployable(ForwardSiegeBeaconDeployable.ForwardSiegeBeaconWeenieClassId, player.Location, player) is not ForwardSiegeBeaconDeployable deployed)
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat("Failed to deploy Forward Siege Supply Beacon.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    deployed.TargetTownId = msg.TownId;
+                    deployed.AffiliatedTownId = msg.TownId;
+                    deployed.AttackerMonarchId = actorMonarch;
+                    SendSiegeEventAndState(session, msg.TownId, kind: 0);
+                    return;
+                }
+
+                case 4: // WithdrawEscrow
+                {
+                    if (!TownCommands.CanModifyTownPolicy(player, msg.TownId))
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat("Rejected: Only the owning Allegiance Monarch may withdraw town funds.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    var snap = SiegeManager.GetSiegeState(msg.TownId);
+                    if (snap == null)
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat($"Unknown town {msg.TownId}.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    if (snap.State is "CONTESTED_HOLD" or "STARVING")
+                    {
+                        session.Network?.EnqueueSend(new GameMessageSystemChat("Rejected: Town treasury escrow is frozen during siege.", ChatMessageType.Broadcast));
+                        return;
+                    }
+                    TownEconomyManager.SendTownState(player, msg.TownId);
+                    return;
+                }
+            }
+        }
+
+        private static void SendSiegeEventAndState(Session session, uint townId, byte kind)
+        {
+            var snap = SiegeManager.GetSiegeState(townId);
+            if (snap != null)
+            {
+                VehicleManager.SendTo(null, session, new EconomySiegeEventMsg
+                {
+                    TownId = townId,
+                    Kind = kind,
+                    ControlState = TownEconomyManager.MapControlStateByte(snap.State),
+                    OwnerMonarchId = snap.OwnerMonarchId,
+                    AttackerMonarchId = snap.AttackerMonarchId,
+                    HoldElapsedSec = (uint)Math.Max(0.0, snap.HoldElapsedSec),
+                    SupplyMeterSec = (uint)Math.Max(0.0, snap.SupplyMeterSec),
+                    StarvingSec = (uint)Math.Max(0.0, snap.StarvingSec),
+                    TreasurySpoils = (ulong)Math.Max(0L, snap.AttackerSpoilsPyreals),
+                });
+            }
+            if (session?.Player != null)
+                TownEconomyManager.SendTownState(session.Player, townId);
+        }
+
+        [GameAction(GameActionType.IndustryProspecting)]
+        public static void HandleIndustryProspecting(ClientMessage message, Session session)
+        {
+            if (!TownEconomyManager.Enabled && !VehicleManager.Enabled) return;
+            if (session?.Player == null || !VehicleManager.HasCap(session, VehicleWire.CapObserve)) return;
+            if (VehicleWire.ReadC2S(VehicleWire.OpIndustryProspecting, message.Payload) is not IndustryProspecting msg) return;
+
+            var result = GeologyService.HandleProspectingRequest(session.Player, msg, out var error);
+            if (result != null)
+            {
+                VehicleManager.SendTo(null, session, result);
+            }
+            else if (!string.IsNullOrEmpty(error))
+            {
+                session.Network?.EnqueueSend(new GameMessageSystemChat(error, ChatMessageType.Broadcast));
+            }
+        }
+
+        [GameAction(GameActionType.IndustryFacilityAction)]
+        public static void HandleIndustryFacilityAction(ClientMessage message, Session session)
+        {
+            if (!TownEconomyManager.Enabled && !VehicleManager.Enabled) return;
+            if (session?.Player == null || !VehicleManager.HasCap(session, VehicleWire.CapObserve)) return;
+            if (VehicleWire.ReadC2S(VehicleWire.OpIndustryFacilityAction, message.Payload) is not IndustryFacilityAction msg) return;
+
+            var stateMsg = IndustryManager.HandleFacilityAction(session.Player, msg, out var error);
+            if (stateMsg != null)
+            {
+                var dep = Vehicles.Deployables.DeployableManager.GetDeployable(msg.FacilityGuid);
+                if (dep?.Location != null)
+                    VehicleManager.BroadcastNear(dep.Location, 600.0, session.Player, () => stateMsg);
+                else
+                    VehicleManager.SendTo(null, session, stateMsg);
+            }
+            else if (!string.IsNullOrEmpty(error))
+            {
+                session.Network?.EnqueueSend(new GameMessageSystemChat(error, ChatMessageType.Broadcast));
+            }
+        }
+
+        [GameAction(GameActionType.LogisticsConvoyOrder)]
+        public static void HandleLogisticsConvoyOrder(ClientMessage message, Session session)
+        {
+            if (!TownEconomyManager.Enabled && !VehicleManager.Enabled) return;
+            if (session?.Player == null) return;
+            if (VehicleWire.ReadC2S(VehicleWire.OpLogisticsConvoyOrder, message.Payload) is not LogisticsConvoyOrder msg) return;
+
+            var stateMsg = LogisticsEngine.HandleConvoyOrder(session.Player, msg, out var error);
+            if (stateMsg != null)
+            {
+                VehicleManager.SendTo(null, session, stateMsg);
+            }
+            else if (!string.IsNullOrEmpty(error))
+            {
+                session.Network?.EnqueueSend(new GameMessageSystemChat(error, ChatMessageType.Broadcast));
+            }
+        }
+
+        [GameAction(GameActionType.EconomyMonarchOrder)]
+        public static void HandleEconomyMonarchOrder(ClientMessage message, Session session)
+        {
+            if (!TownEconomyManager.Enabled && !VehicleManager.Enabled) return;
+            if (session?.Player == null || !VehicleManager.HasCap(session, VehicleWire.CapObserve)) return;
+            if (VehicleWire.ReadC2S(VehicleWire.OpEconomyMonarchOrder, message.Payload) is not EconomyMonarchOrder msg) return;
+
+            var reply = TownEconomyManager.HandleMonarchOrderAction(session.Player, msg, out var error);
+            if (reply != null)
+            {
+                VehicleManager.SendTo(null, session, reply);
+                if (msg.TownId != 0 && msg.Action is 1 or 2 or 3 or 4)
+                    TownEconomyManager.SendTownState(session.Player, msg.TownId);
+            }
+            else if (!string.IsNullOrEmpty(error))
+            {
+                session.Network?.EnqueueSend(new GameMessageSystemChat(error, ChatMessageType.Broadcast));
+            }
+        }
     }
 }
