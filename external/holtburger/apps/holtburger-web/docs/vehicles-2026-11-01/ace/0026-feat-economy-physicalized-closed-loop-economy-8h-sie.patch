+        private static bool IsPetroleumDeposit(string resourceType)
+        {
+            if (string.IsNullOrWhiteSpace(resourceType))
+                return false;
+            var rt = resourceType.Trim().ToLowerInvariant();
+            if (rt.Contains("oil") || rt.Contains("crude") || rt.Contains("petroleum") || rt.Contains("bitumen"))
+                return true;
+            return rt.Contains("gas") && !rt.Contains("sulfur") && !rt.Contains("silica");
+        }
