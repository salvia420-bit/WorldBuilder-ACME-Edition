+        private static void RecoverInsolvencyOnSpendableInflowLocked(TownRuntimeState state, DateTime now)
+        {
+            state.Control.LastDeliveryUtc = now;
+            state.InactivityElapsedSec = 0.0;
+            if (state.Control.State == "INSOLVENT_RECEIVERSHIP")
+            {
+                var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+                if (spendable > 0)
+                {
+                    state.Control.State = "CONTROLLED";
+                    state.InsolventSinceUtc = null;
+                    state.InsolvencyGraceElapsedSec = 0.0;
+                }
+            }
+        }
