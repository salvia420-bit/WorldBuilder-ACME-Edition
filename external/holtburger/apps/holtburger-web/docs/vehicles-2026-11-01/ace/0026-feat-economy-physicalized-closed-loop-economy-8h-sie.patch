+        public static uint ResolveTurretEffectiveMonarchId(DeployableBase turret)
+        {
+            if (turret == null) return 0;
+            if (turret.AffiliatedTownId != 0)
+            {
+                var state = TownEconomyManager.GetTownState(turret.AffiliatedTownId);
+                if (state != null)
+                {
+                    lock (state.SyncRoot)
+                    {
+                        if (state.Control.OwnerMonarchId != 0)
+                            return state.Control.OwnerMonarchId;
+                    }
+                }
+                return turret.OwnerMonarchId;
+            }
+            if (turret.OwnerMonarchId != 0)
+                return turret.OwnerMonarchId;
+            if (turret.DeployerMonarchId != 0)
+                return turret.DeployerMonarchId;
+            if (turret.DeployerPlayerGuid != 0)
+            {
+                var p = PlayerManager.GetOnlinePlayer(turret.DeployerPlayerGuid);
+                if (p != null)
+                    return TownCommands.ResolveEffectiveMonarchId(p);
+                return turret.DeployerPlayerGuid;
+            }
+            return 0;
+        }
