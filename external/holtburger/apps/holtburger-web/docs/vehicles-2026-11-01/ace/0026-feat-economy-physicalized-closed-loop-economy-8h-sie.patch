+using System;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Models;
+using ACE.Server.Command.Handlers;
+using ACE.Server.Economy;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Town Logistics Depot Apron (WCID 4000091, DeployableKind.TownDepotApron = 57).
+    /// Non-pallet logistics intake apron hydrated on landblock load for sworn Allegiance members.
+    /// Excluded from ace_shard biota persistence via WorldObject_Database.cs:146.
+    /// </summary>
+    public class TownDepotDeployable : DeployableBase
+    {
+        public const uint TownDepotWeenieClassId = 4_000_091;
+        public const float ApronRadiusM = 24.0f;
+
+        public uint TownId { get; set; }
+
+        protected override bool BroadcastDespawnOnDestroy => false;
+
+        public TownDepotDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.TownDepotApron;
+            Pallet = PalletSize.None;
+            OnlineFlags = DeployableOnlineFlags.Active;
+        }
+
+        public static Weenie BuildWeenie(uint townId = 0, string townName = "Town", Vehicle parentVehicle = null, Player deployer = null)
+        {
+            var label = string.IsNullOrWhiteSpace(townName) ? "Town" : townName;
+            return BuildDeployableWeenie(
+                TownDepotWeenieClassId,
+                "hbtown_depot_apron",
+                $"{label} Town Logistics Depot",
+                "Sworn Allegiance depot apron for container/pallet intake into the town warehouse."
+            );
+        }
+
+        public bool TryAcceptWarehouseDelivery(Player actor, string commodityId, int qty, out string message)
+        {
+            var tid = TownId != 0 ? TownId : (TownRegistry.ResolveTown(this)?.TownId ?? 0u);
+            if (tid == 0)
+            {
+                message = "Town Depot is not linked to a registered town.";
+                return false;
+            }
+
+            if (!TownCommands.CanExecuteTownLogistics(actor, tid))
+            {
+                message = "Only sworn Allegiance members of the controlling Monarch may operate this Town Depot.";
+                return false;
+            }
+
+            if (string.IsNullOrWhiteSpace(commodityId) || qty <= 0)
+            {
+                message = "Invalid commodity or quantity for depot delivery.";
+                return false;
+            }
+
+            TownEconomyManager.RecordWarehouseDelivery(tid, commodityId, qty);
+            SiegeManager.NotifyTownLogisticsDelivery(tid);
+            message = $"Delivered {qty}x {commodityId} into {TownRegistry.GetById(tid)?.Name ?? $"Town #{tid}"} warehouse.";
+            return true;
+        }
+
+        public override void ActOnUse(WorldObject activator)
+        {
+            if (activator is not Player player)
+                return;
+
+            var tid = TownId != 0 ? TownId : (TownRegistry.ResolveTown(this)?.TownId ?? 0u);
+            if (tid == 0)
+            {
+                player.SendMessage("This Town Depot is not linked to a registered town.", ChatMessageType.Broadcast);
+                return;
+            }
+
+            var snap = SiegeManager.GetSiegeState(tid);
+            var def = TownRegistry.GetById(tid);
+            var townLabel = def?.Name ?? $"Town #{tid}";
+            var authorized = TownCommands.CanExecuteTownLogistics(player, tid);
+            player.SendMessage(
+                $"[Depot: {townLabel}] Owner Monarch: {snap?.OwnerMonarchId ?? 0} | Authorized: {(authorized ? "YES (Sworn Member)" : "NO")} | " +
+                $"Treasury: {snap?.TreasuryPyreals ?? 0:N0}p (Spendable: {TownEconomyManager.GetSpendableTreasuryPyreals(tid):N0}p).",
+                ChatMessageType.Broadcast);
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/MarineModel.cs b/Source/ACE.Server/Vehicles/MarineModel.cs
