+        public static bool TryStartClaim(uint townId, Player actor, bool hasCharter, out string message)
+        {
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null)
+            {
+                message = "Town not found.";
+                return false;
+            }
+            if (actor == null)
+            {
+                message = "Player required to claim town.";
+                return false;
+            }
+            if (!hasCharter)
+            {
+                message = "A Town Charter is required to claim an unclaimed town.";
+                return false;
+            }
+
+            var monarchId = TownCommands.ResolveEffectiveMonarchId(actor);
+            if (monarchId == 0)
+            {
+                message = "Could not resolve Allegiance Monarch.";
+                return false;
+            }
+
+            TownControl snap;
+            lock (state.SyncRoot)
+            {
+                if (state.Control.State != "UNCLAIMED_COLD")
+                {
+                    message = $"{state.Control.Name} is currently {state.Control.State} and cannot be claimed peacefully.";
+                    return false;
+                }
+
+                state.ClaimMonarchId = monarchId;
+                state.ClaimElapsedSec = 0.0;
+                state.Control.UpdatedUtc = DateTime.UtcNow;
+                snap = TownEconomyManager.CloneControlSnapshot(state.Control);
+            }
+
+            TownEconomyManager.PersistControlSnapshot(snap);
+            message = $"Town Charter accepted for {state.Control.Name}. Hold the Town Control Node for 15 minutes (900s) to establish control.";
+            return true;
+        }
+
+        public static bool AdvanceClaim(uint townId, uint monarchId, double elapsedSeconds)
+        {
+            if (monarchId == 0 || !double.IsFinite(elapsedSeconds) || elapsedSeconds <= 0.0)
+                return false;
+
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null) return false;
+
+            bool claimed = false;
+            TownControl snap;
+            lock (state.SyncRoot)
+            {
+                if (state.Control.State != "UNCLAIMED_COLD")
+                    return false;
+
+                if (state.ClaimMonarchId != monarchId)
+                {
+                    state.ClaimMonarchId = monarchId;
+                    state.ClaimElapsedSec = 0.0;
+                }
+
+                state.ClaimElapsedSec += elapsedSeconds;
+                if (state.ClaimElapsedSec >= ClaimDurationSec)
+                {
+                    state.Control.State = "CONTROLLED";
+                    state.Control.OwnerMonarchId = monarchId;
+                    state.ClaimMonarchId = 0;
+                    state.ClaimElapsedSec = 0.0;
+                    state.InactivityElapsedSec = 0.0;
+                    state.InsolvencyGraceElapsedSec = 0.0;
+                    state.InsolventSinceUtc = null;
+                    state.Control.LastDeliveryUtc = DateTime.UtcNow;
+                    claimed = true;
+                }
+                state.Control.UpdatedUtc = DateTime.UtcNow;
+                snap = TownEconomyManager.CloneControlSnapshot(state.Control);
+            }
+
+            TownEconomyManager.PersistControlSnapshot(snap);
+            if (claimed)
+                SyncTownRadarIff(townId, monarchId, 0);
+            return claimed;
+        }
+
+        public static bool DeliverSiegeSupply(uint townId, uint originLandblockId, double supplyPoints, Player actor, out string message)
+        {
+            if (supplyPoints <= 0.0 || !double.IsFinite(supplyPoints))
+            {
+                message = "Supply delivery quantity must be positive.";
+                return false;
+            }
+
+            if (!HasValidSupplyProvenance(originLandblockId, townId))
+            {
+                var dist = ComputeDistanceFromOriginToTownM(originLandblockId, townId);
+                message = $"Origin-provenance check failed: cargo origin distance {dist:0.0}m < {MinProvenanceDistanceM:0}m required.";
+                return false;
+            }
+
+            var state = TownEconomyManager.GetTownState(townId);
+            var def = TownRegistry.GetById(townId);
+            if (state == null || def == null)
+            {
+                message = "Target town not found.";
+                return false;
+            }
+
+            var drainPerHour = GetSupplyDrainPerHour(def.Tier);
+            double addedSec = (supplyPoints / drainPerHour) * 3600.0;
+
+            TownControl snap;
+            lock (state.SyncRoot)
+            {
+                if (state.Control.State is not ("CONTESTED_HOLD" or "STARVING"))
+                {
+                    message = $"{def.Name} is not currently in an active siege.";
+                    return false;
+                }
+
+                if (actor != null)
+                {
+                    var actorMonarch = TownCommands.ResolveEffectiveMonarchId(actor);
+                    if (state.Control.AttackerMonarchId != 0 && actorMonarch != state.Control.AttackerMonarchId)
+                    {
+                        message = "Only sworn members of the attacking Allegiance may resupply this Forward Siege Beacon.";
+                        return false;
+                    }
+                }
+
+                state.SupplyMeterSecExact = Math.Min(SupplyMeterMaxSec, state.SupplyMeterSecExact + addedSec);
+                state.Control.SupplyMeterSec = (int)Math.Ceiling(state.SupplyMeterSecExact);
+                state.ApronSupplySp += supplyPoints;
+                state.StarvingSecExact = 0.0;
+                state.Control.StarvingSec = 0;
+                if (state.SupplyMeterSecExact > 900.0)
+                    state.SupplyLowAlertSent = false;
+                if (state.Control.State == "STARVING" && state.SupplyMeterSecExact > 0.0)
+                    state.Control.State = "CONTESTED_HOLD";
+
+                state.Control.LastDeliveryUtc = DateTime.UtcNow;
+                state.Control.UpdatedUtc = DateTime.UtcNow;
+                snap = TownEconomyManager.CloneControlSnapshot(state.Control);
+            }
+
+            TownEconomyManager.PersistControlSnapshot(snap);
+            message = $"Delivered {supplyPoints:0.0} SP (+{addedSec:0}s) to {def.Name} siege supply meter.";
+            return true;
+        }
