+        public static bool HasAvailableMicroGridPower(DeployableBase dep)
+        {
+            if (dep == null || dep.IsDestroyed || dep.IsPacked || dep.IsStowed)
+                return false;
+            if (dep is IsoContainerDeployable ic && IsoContainerDeployable.IsReeferWcid(ic.Wcid) && ic.ExternalReeferPowerConnected)
+                return true;
+            if (dep.IsPowered)
+                return true;
+            return dep.Grid != null && dep.Grid.CanPowerUnit(dep);
+        }
