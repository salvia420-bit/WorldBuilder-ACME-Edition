+        public static bool CanOperateFacility(Player actor, DeployableBase facility, uint townId)
+            => CanOperateFacility(actor, facility, townId, out _);
+
+        public static bool CanOperateFacility(Player actor, DeployableBase facility, uint townId, out string error)
+        {
+            error = null;
+            if (actor == null || facility == null)
+            {
+                error = "Invalid operator or facility.";
+                return false;
+            }
+
+            uint effectiveTownId = townId != 0
+                ? townId
+                : (facility.AffiliatedTownId != 0
+                    ? facility.AffiliatedTownId
+                    : (facility.Location != null ? (TownRegistry.ResolveTown(facility.Location)?.TownId ?? 0u) : 0u));
+
+            if (effectiveTownId != 0)
+            {
+                var townState = TownEconomyManager.GetTownState(effectiveTownId);
+                uint townOwnerMonarchId = 0;
+                if (townState != null)
+                {
+                    lock (townState.SyncRoot)
+                        townOwnerMonarchId = townState.Control.OwnerMonarchId;
+                }
+
+                if (townOwnerMonarchId != 0)
+                {
+                    if (!TownCommands.CanExecuteTownLogistics(actor, effectiveTownId))
+                    {
+                        error = "Only sworn Allegiance members of the controlling Monarch may operate facilities in this town.";
+                        return false;
+                    }
+                    return true;
+                }
+            }
+
+            if (facility is TownMintDeployable or TownWorkshopDeployable)
+            {
+                error = "Civic town facilities can only be operated in a claimed town by the controlling Allegiance.";
+                return false;
+            }
+
+            uint facilityMonarchId = facility.OwnerMonarchId != 0 ? facility.OwnerMonarchId : facility.DeployerMonarchId;
+            uint actorMonarchId = TownCommands.ResolveEffectiveMonarchId(actor);
+
+            if (facilityMonarchId != 0 && actorMonarchId != 0 && actorMonarchId == facilityMonarchId)
+                return true;
+
+            if (facility.DeployerPlayerGuid != 0 && facility.DeployerPlayerGuid == actor.Guid.Full)
+            {
+                if (facilityMonarchId == 0 || facilityMonarchId == facility.DeployerPlayerGuid)
+                    return true;
+            }
+
+            error = "Only the facility owner or sworn Allegiance members may operate this facility.";
+            return false;
+        }
+
+        public static IndustryFacilityStateMsg HandleFacilityAction(Player player, IndustryFacilityAction msg, out string error)
+        {
+            error = null;
+            if (player == null || msg == null)
+            {
+                error = "Invalid facility action.";
+                return null;
+            }
+
+            var dep = DeployableManager.GetDeployable(msg.FacilityGuid);
+            if (dep == null || dep.IsDestroyed || dep.IsPacked)
+            {
+                error = "Industrial facility not found.";
+                return null;
+            }
+
+            if (player.Location != null && dep.Location != null)
+            {
+                var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                if (Vector3.Distance(new Vector3((float)px, (float)py, (float)pz), dep.GlobalPosition) > 15.0f)
+                {
+                    error = "Move within 15 m of the facility.";
+                    return null;
+                }
+            }
+
+            // Action: 1=Start, 2=Stop, 3=SelectRecipe, 4=LoadInput, 5=CollectOutput (vehicles.protocol.xml)
+            if (msg.Action is < 1 or > 5)
+            {
+                error = $"Unsupported facility action {msg.Action}.";
+                return null;
+            }
+
+            uint tid = dep.AffiliatedTownId != 0
+                ? dep.AffiliatedTownId
+                : (dep.Location != null ? (TownRegistry.ResolveTown(dep.Location)?.TownId ?? 0u) : 0u);
+
+            if (dep is PublicCommonsStarterHearthDeployable hearth)
+            {
+                if (msg.Action == 2)
+                    return BuildFacilityStateMsg(hearth, status: 1, progressPct: 0f, recipeId: 0);
+                if (msg.Action is 3 or 4)
+                    return BuildFacilityStateMsg(hearth, status: 1, progressPct: 0f, recipeId: msg.RecipeId);
+
+                string hearthRecipe = msg.RecipeId switch
+                {
+                    1 => "hearth_tapers",
+                    2 => "hearth_smelt_pyreal",
+                    3 => "hearth_smelt_ingot",
+                    4 => "hearth_smelt_iron",
+                    5 => "hearth_healing_kit",
+                    _ => null,
+                };
+                if (!TryCraftStarterHearth(hearth, player, hearthRecipe, out error))
+                    return null;
+                return BuildFacilityStateMsg(hearth, status: 2, progressPct: 100f, recipeId: msg.RecipeId);
+            }
+
+            if (!CanOperateFacility(player, dep, tid, out error))
+                return null;
+
+            if (dep is TownMintDeployable mint)
+            {
+                if (msg.Action == 2) // Stop
+                {
+                    mint.IsActive = false;
+                    mint.OnlineFlags = (byte)(mint.OnlineFlags & ~(DeployableOnlineFlags.Active | DeployableOnlineFlags.Powered));
+                    RecordFacilityState(mint, tid, 0, "");
+                    mint.BroadcastState();
+                    return BuildFacilityStateMsg(mint, status: 0, progressPct: 0f, recipeId: 0);
+                }
+                if (msg.Action is 3 or 4)
+                {
+                    return BuildFacilityStateMsg(mint, status: mint.IsPowered ? (byte)1 : (byte)0, progressPct: 0f, recipeId: msg.RecipeId);
+                }
+
+                // Action == 1 (Start -> Town Treasury Till) or Action == 5 (CollectOutput -> physical Pyreal 273 coins)
+                if (msg.Param > int.MaxValue)
+                {
+                    error = "Mint quantity exceeds maximum allowed.";
+                    return null;
+                }
+                uint bullionWcid = msg.RecipeId != 0 ? msg.RecipeId : PyrealBarWcid;
+                int qty = msg.Param == 0 ? 1 : (int)msg.Param;
+                bool depositToTreasury = msg.Action == 1;
+                if (!TryMintBullion(mint, player, tid, bullionWcid, qty, depositToTreasury, out _, out error))
+                    return null;
+
+                mint.IsActive = true;
+                mint.OnlineFlags |= DeployableOnlineFlags.Active | DeployableOnlineFlags.InFluxRange | DeployableOnlineFlags.Powered;
+                mint.BroadcastState();
+                return BuildFacilityStateMsg(mint, status: 2, progressPct: 100f, recipeId: bullionWcid);
+            }
+
+            if (dep is TownWorkshopDeployable ws)
+            {
+                if (msg.Action == 2) // Stop
+                {
+                    ws.IsActive = false;
+                    ws.OnlineFlags = (byte)(ws.OnlineFlags & ~(DeployableOnlineFlags.Active | DeployableOnlineFlags.Powered));
+                    RecordFacilityState(ws, tid, 0, "");
+                    ws.BroadcastState();
+                    return BuildFacilityStateMsg(ws, status: 0, progressPct: 0f, recipeId: 0);
+                }
+                if (msg.Action is 3 or 4)
+                {
+                    return BuildFacilityStateMsg(ws, status: ws.IsPowered ? (byte)1 : (byte)0, progressPct: 0f, recipeId: msg.RecipeId);
+                }
+
+                uint vendorGuid = msg.Param;
+                uint recipeId = msg.RecipeId != 0 ? msg.RecipeId : 1u;
+                if (!TryCraftWorkshopBatch(ws, player, tid, vendorGuid, recipeId, 1, out _, out error))
+                    return null;
+
+                ws.IsActive = true;
+                ws.OnlineFlags |= DeployableOnlineFlags.Active | DeployableOnlineFlags.InFluxRange | DeployableOnlineFlags.Powered;
+                ws.BroadcastState();
+                return BuildFacilityStateMsg(ws, status: 2, progressPct: 100f, recipeId: recipeId);
+            }
+
+            if (dep is IndustrialGensetDeployable genset)
+            {
+                if (msg.Action == 2) // Stop
+                {
+                    genset.IsActive = false;
+                    genset.OnlineFlags = (byte)(genset.OnlineFlags & ~(DeployableOnlineFlags.Active | DeployableOnlineFlags.Powered));
+                    RecordFacilityState(genset, tid, 0, "");
+                    genset.BroadcastState();
+                    return BuildFacilityStateMsg(genset, status: 0, progressPct: 0f, recipeId: 0);
+                }
+                if (msg.Action == 4) // LoadInput (refuel)
+                {
+                    uint unitsU = msg.Param == 0 ? 1u : msg.Param;
+                    if (unitsU > 100u)
+                    {
+                        error = "Genset refuel request exceeds maximum 100 fuel units per action.";
+                        return null;
+                    }
+                    if (genset.FuelSecondsRemaining >= IndustrialGensetDeployable.MaxFuelSeconds)
+                    {
+                        error = "Industrial Genset fuel tank is already at maximum capacity.";
+                        return null;
+                    }
+
+                    int requestedUnits = (int)unitsU;
+                    double headroomSeconds = Math.Max(0.0, IndustrialGensetDeployable.MaxFuelSeconds - genset.FuelSecondsRemaining);
+                    int warehouseUnits = Math.Min(requestedUnits, Math.Max(1, (int)Math.Ceiling(headroomSeconds / IndustrialGensetDeployable.SecondsPerFuelUnit)));
+                    int scarabUnits = Math.Min(requestedUnits, Math.Max(1, (int)Math.Ceiling(headroomSeconds / PowerGeneratorDeployable.BurnRateSecondsPerScarab)));
+
+                    int consumedUnits = 0;
+                    double secondsPerUnit = IndustrialGensetDeployable.SecondsPerFuelUnit;
+                    bool consumedFuel = false;
+
+                    if (tid != 0 &&
+                        (TownEconomyManager.TryConsumeWarehouseStock(tid, "ulsd_diesel", warehouseUnits, out _) ||
+                         TownEconomyManager.TryConsumeWarehouseStock(tid, "assoc_gas", warehouseUnits, out _) ||
+                         TownEconomyManager.TryConsumeWarehouseStock(tid, "lpg_gas", warehouseUnits, out _)))
+                    {
+                        consumedFuel = true;
+                        consumedUnits = warehouseUnits;
+                    }
+                    else if (TryConsumePlayerInventoryItem(player, PowerGeneratorDeployable.ScarabWcid, scarabUnits))
+                    {
+                        consumedFuel = true;
+                        consumedUnits = scarabUnits;
+                        secondsPerUnit = PowerGeneratorDeployable.BurnRateSecondsPerScarab;
+                    }
+
+                    if (!consumedFuel)
+                    {
+                        int neededDisplay = tid != 0 ? warehouseUnits : scarabUnits;
+                        error = $"Missing {neededDisplay}x fuel (ulsd_diesel, assoc_gas, lpg_gas in town warehouse or Platinum Scarab {PowerGeneratorDeployable.ScarabWcid} in inventory) to refuel Industrial Genset.";
+                        return null;
+                    }
+
+                    genset.AddFuelSeconds(consumedUnits * secondsPerUnit);
+                    RecordFacilityState(genset, tid, 0, "genset_fuel");
+                    genset.BroadcastState();
+                    return BuildFacilityStateMsg(genset, status: 1, progressPct: 100f, recipeId: msg.RecipeId);
+                }
+                if (msg.Action == 1) // Start
+                {
+                    if (genset.FuelSecondsRemaining <= 0.0)
+                    {
+                        error = "Industrial Genset has no fuel remaining.";
+                        return null;
+                    }
+                    genset.IsActive = true;
+                    genset.OnlineFlags |= DeployableOnlineFlags.Active;
+                    RecordFacilityState(genset, tid, 0, "genset_run");
+                    genset.BroadcastState();
+                }
+                return BuildFacilityStateMsg(genset, status: genset.IsActive && genset.FuelSecondsRemaining > 0.0 ? (byte)1 : (byte)0, progressPct: 0f, recipeId: msg.RecipeId);
+            }
+
+            if (dep is IndustrySkidDeployable skid)
+            {
+                if (msg.Action == 2) // Stop (does not require power)
+                {
+                    skid.IsActive = false;
+                    skid.OnlineFlags = (byte)(skid.OnlineFlags & ~(DeployableOnlineFlags.Active | DeployableOnlineFlags.Powered));
+                    RecordFacilityState(skid, tid, skid.TargetDepositId, "");
+                    skid.BroadcastState();
+                    return BuildFacilityStateMsg(skid, status: 0, progressPct: 0f, recipeId: skid.ActiveRecipeId);
+                }
+                if (msg.Action == 3) // SelectRecipe
+                {
+                    skid.ActiveRecipeId = msg.RecipeId;
+                    RecordFacilityState(skid, tid, skid.TargetDepositId, $"recipe_{skid.ActiveRecipeId}");
+                    return BuildFacilityStateMsg(skid, status: skid.IsPowered ? (byte)1 : (byte)0, progressPct: 0f, recipeId: skid.ActiveRecipeId);
+                }
+                if (msg.Action == 4) // LoadInput
+                {
+                    if (msg.Param != 0)
+                        skid.TargetDepositId = msg.Param;
+                    RecordFacilityState(skid, tid, skid.TargetDepositId, $"recipe_{skid.ActiveRecipeId}");
+                    return BuildFacilityStateMsg(skid, status: skid.IsPowered ? (byte)1 : (byte)0, progressPct: 0f, recipeId: skid.ActiveRecipeId);
+                }
+
+                // Action == 1 (Start) or Action == 5 (CollectOutput)
+                if (skid.IsStowed)
+                {
+                    error = $"{skid.Name} is stowed and must be deployed first.";
+                    return null;
+                }
+
+                if (!HasAvailableMicroGridPower(skid))
+                {
+                    error = $"{skid.Name} requires an active powered MicroGrid.";
+                    return null;
+                }
+
+                skid.IsActive = true;
+                skid.OnlineFlags |= DeployableOnlineFlags.Active | DeployableOnlineFlags.InFluxRange | DeployableOnlineFlags.Powered;
+                if (msg.RecipeId != 0)
+                    skid.ActiveRecipeId = msg.RecipeId;
+                RecordFacilityState(skid, tid, skid.TargetDepositId, $"recipe_{skid.ActiveRecipeId}");
+                skid.BroadcastState();
+                return BuildFacilityStateMsg(skid, status: msg.Action == 5 ? (byte)2 : (byte)1, progressPct: 100f, recipeId: skid.ActiveRecipeId);
+            }
+
+            if (msg.Action == 2)
+            {
+                dep.IsActive = false;
+                dep.OnlineFlags = (byte)(dep.OnlineFlags & ~(DeployableOnlineFlags.Active | DeployableOnlineFlags.Powered));
+                dep.BroadcastState();
+                return BuildFacilityStateMsg(dep, status: 0, progressPct: 0f, recipeId: msg.RecipeId);
+            }
+            if (msg.Action == 1)
+            {
+                if (dep.IsStowed)
+                {
+                    error = $"{dep.Name} is stowed.";
+                    return null;
+                }
+                bool hasExternalReeferPower = dep is IsoContainerDeployable reefer &&
+                    IsoContainerDeployable.IsReeferWcid(reefer.Wcid) &&
+                    reefer.ExternalReeferPowerConnected;
+                bool hasGridPower = dep.IsPowered || (dep.Grid != null && dep.Grid.CanPowerUnit(dep));
+
+                if (dep.IsPowerConsumerUnit && !hasGridPower && !hasExternalReeferPower)
+                {
+                    error = $"{dep.Name} requires an active powered MicroGrid.";
+                    return null;
+                }
+
+                dep.IsActive = true;
+                if (dep.IsPowerConsumerUnit)
+                {
+                    if (hasGridPower)
+                        dep.OnlineFlags |= (byte)(DeployableOnlineFlags.Active | DeployableOnlineFlags.InFluxRange | DeployableOnlineFlags.Powered);
+                    else
+                    {
+                        dep.OnlineFlags |= DeployableOnlineFlags.Active;
+                        if (dep.Grid != null && dep.Grid.IsPodActive)
+                            dep.OnlineFlags |= DeployableOnlineFlags.InFluxRange;
+                    }
+                }
+                else
+                {
+                    dep.OnlineFlags |= DeployableOnlineFlags.Active;
+                    if (dep.Grid != null && dep.Grid.IsPodActive)
+                        dep.OnlineFlags |= DeployableOnlineFlags.InFluxRange;
+                }
+                dep.BroadcastState();
+            }
+
+            bool operational = dep.IsPowered ||
+                (dep is IsoContainerDeployable ic && ic.IsPoweredReefer) ||
+                (!dep.IsPowerConsumerUnit && dep.IsActive);
+            return BuildFacilityStateMsg(dep, status: operational ? (byte)1 : (byte)0, progressPct: 0f, recipeId: msg.RecipeId);
+        }
+
+        private static void PersistFacility(IndustryFacility snapshot)
+        {
+            try
+            {
+                DatabaseManager.Shard?.EnqueueIndustryFacilityUpsert(snapshot);
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[INDUSTRY] Failed to enqueue IndustryFacility upsert: {ex.Message}");
+            }
+        }
+
+        private static IndustryFacility CloneFacility(IndustryFacility f) => new()
+        {
+            FacilityGuid = f.FacilityGuid,
+            Wcid = f.Wcid,
+            OwnerMonarchId = f.OwnerMonarchId,
+            TownId = f.TownId,
+            DepositId = f.DepositId,
+            ActiveRecipeId = f.ActiveRecipeId ?? "",
+            PowerKw = Math.Max(0.0f, f.PowerKw),
+            UpdatedUtc = f.UpdatedUtc,
+        };
+    }
+}
