+            }
+        }
+
+        public static int Start(int port = DefaultPort)
+        {
+            EnsureSubscribed();
+
+            lock (_lifecycleLock)
+            {
+                if (_isRunning && _listener != null && (port == 0 || port == _activePort))
+                    return _activePort;
+
+                StopLocked();
+
+                int targetPort = port > 0 ? port : AllocateEphemeralLoopbackPort();
+                HttpListener listener = null;
+                Exception lastEx = null;
+
+                for (int attempt = 0; attempt < 3; attempt++)
+                {
+                    try
+                    {
+                        var candidate = new HttpListener();
+                        candidate.Prefixes.Add($"http://{BindHost}:{targetPort}/");
+                        candidate.Start();
+                        listener = candidate;
+                        break;
+                    }
+                    catch (Exception ex) when (port == 0 && attempt < 2)
+                    {
