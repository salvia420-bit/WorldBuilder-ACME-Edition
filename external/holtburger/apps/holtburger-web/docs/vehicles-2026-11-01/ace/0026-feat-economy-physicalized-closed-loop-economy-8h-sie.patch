+
+CREATE TABLE IF NOT EXISTS `logistics_convoy` (
+  `convoy_id` BIGINT UNSIGNED NOT NULL,
+  `owner_monarch_id` INT UNSIGNED NOT NULL,
+  `vehicle_guid` INT UNSIGNED NOT NULL DEFAULT 0,
+  `vehicle_kind` VARCHAR(32) NOT NULL DEFAULT 'Semi379',
+  `vehicle_class` TINYINT UNSIGNED NOT NULL DEFAULT 3,
+  `lod_state` VARCHAR(16) NOT NULL DEFAULT 'Macro',
+  `origin_town_id` INT UNSIGNED NOT NULL DEFAULT 0,
+  `dest_town_id` INT UNSIGNED NOT NULL DEFAULT 0,
