+            Assert.AreEqual(5_000L, TownEconomyManager.GetTownTillCap(1u));
+
+            var missingCapResp = await http.PostAsync("/api/v1/monarch/orders",
+                new StringContent(JsonSerializer.Serialize(new
+                {
+                    actorGuid = monarchId,
+                    townId = 1u,
+                    action = "set_till_cap",
+                }), Encoding.UTF8, "application/json"));
+            Assert.AreEqual(HttpStatusCode.UnprocessableEntity, missingCapResp.StatusCode);
+            Assert.AreEqual(5_000L, TownEconomyManager.GetTownTillCap(1u));
+
+            // 3) set_price with negative unitPrice returns 422 without clearing existing 999 override
+            var negPriceResp = await http.PostAsync("/api/v1/monarch/orders",
+                new StringContent(JsonSerializer.Serialize(new
+                {
+                    actorGuid = monarchId,
+                    townId = 1u,
+                    action = "set_price",
