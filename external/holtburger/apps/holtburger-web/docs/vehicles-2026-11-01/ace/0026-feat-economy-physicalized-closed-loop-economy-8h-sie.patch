+            using (var context = new ShardDbContext())
+            {
+                long clampedReward = Math.Max(0L, snapshot.RewardPyreals);
+                int clampedTarget = Math.Max(0, snapshot.TargetQty);
+                int clampedRemaining = Math.Max(0, snapshot.RemainingQty);
+                DateTime safeCreated = snapshot.CreatedUtc == default ? DateTime.UtcNow : snapshot.CreatedUtc;
+                DateTime safeUpdated = snapshot.UpdatedUtc == default ? DateTime.UtcNow : snapshot.UpdatedUtc;
