+        public bool RadarDetected { get; set; }
+        public uint DetectingMonarchId { get; set; }
+        public uint DetectingSensorGuid { get; set; }
+        public uint InterdictedByMonarchId { get; set; }
+        public bool DeliverySettled { get; set; }
+        public DateTime UpdatedUtc { get; set; } = DateTime.UtcNow;
+        internal readonly object SyncRoot = new object();
+
+        public LogisticsConvoyStateMsg ToWireMsg()
+        {
+            var pos = Vehicle.ToPosition(WorldX, WorldY, WorldZ, Vehicle.YawOnly(HeadingRad));
+            return new LogisticsConvoyStateMsg
+            {
+                ConvoyId = ConvoyId,
+                OwnerMonarchId = OwnerMonarchId,
+                VehicleGuid = VehicleGuid,
+                VehicleClass = VehicleClass,
+                LodState = (byte)LodState,
+                Status = (byte)Status,
+                Reserved = RadarDetected ? (byte)1 : (byte)0,
+                OriginTownId = OriginTownId,
+                DestTownId = DestTownId,
+                OriginLandblock = OriginLandblockId,
+                SplineSM = (float)Math.Max(0.0, SplineSM),
+                FuelLiters = (float)Math.Max(0.0, FuelLiters),
+                Cell = pos.Cell,
+                Position = pos.Pos,
+                Heading = (float)HeadingRad,
+            };
+        }
+
+        public LogisticsConvoy ToDbRow() => new LogisticsConvoy
+        {
+            ConvoyId = ConvoyId,
+            OwnerMonarchId = OwnerMonarchId,
+            VehicleGuid = VehicleGuid,
+            VehicleKind = VehicleKind ?? "Semi379",
+            VehicleClass = VehicleClass,
+            LodState = LodState.ToString(),
+            OriginTownId = OriginTownId,
+            DestTownId = DestTownId,
+            OriginPortId = OriginPortId,
+            DestPortId = DestPortId,
+            OriginLandblockId = OriginLandblockId,
+            ContainerKind = ContainerKind,
+            CommodityId = CommodityId ?? "",
+            CommodityQty = Math.Max(0, CommodityQty),
+            SplineSM = double.IsFinite(SplineSM) ? Math.Max(0.0, SplineSM) : 0.0,
+            FuelLiters = double.IsFinite(FuelLiters) ? Math.Max(0.0, FuelLiters) : 0.0,
+            WorldX = double.IsFinite(WorldX) ? WorldX : 0.0,
+            WorldY = double.IsFinite(WorldY) ? WorldY : 0.0,
+            WorldZ = double.IsFinite(WorldZ) ? WorldZ : 0.0,
+            HeadingRad = double.IsFinite(HeadingRad) ? HeadingRad : 0.0,
+            Status = Status.ToString(),
+            UpdatedUtc = UpdatedUtc,
+        };
+
+        public static LogisticsConvoyState FromDbRow(LogisticsConvoy row, LogisticsNavGraph nav = null)
+        {
+            if (row == null)
+                return null;
+
+            var status = Enum.TryParse<LogisticsConvoyStatus>(row.Status, true, out var st)
+                ? st
+                : LogisticsConvoyStatus.EnRoute;
+
+            uint originLb = row.OriginLandblockId;
+            LogisticsRoute route = null;
+            if (nav != null)
+            {
+                var originTown = row.OriginTownId != 0 ? nav.GetTown(row.OriginTownId) : null;
+                if (originLb != 0 && originLb <= 0xFFFFu)
+                {
+                    var p = nav.GetPortByLandblock(originLb);
+                    if (p != null)
+                        originLb = LogisticsNavGraph.NormalizePackedLandblockId(originLb, p.ContinentId);
+                    else if (originTown != null)
+                        originLb = LogisticsNavGraph.NormalizePackedLandblockId(originLb, originTown.ContinentId);
+                }
+
+                if ((row.OriginPortId != 0 && row.DestPortId != 0) || (row.OriginTownId != 0 && row.DestTownId != 0))
+                {
+                    LogisticsEngine.ResolveConvoyRoute(
+                        nav,
+                        row.OriginTownId,
+                        row.DestTownId,
+                        originLb,
+                        row.OriginPortId,
+                        row.DestPortId,
+                        row.VehicleClass,
+                        true,
+                        out route);
+                }
+            }
+
+            return new LogisticsConvoyState
+            {
+                ConvoyId = row.ConvoyId,
+                OwnerMonarchId = row.OwnerMonarchId,
+                OwnerMonarchName = LogisticsEngine.ResolveMonarchName(row.OwnerMonarchId),
+                VehicleGuid = 0, // Re-materialize lazily when observer is <= 480 m
+                VehicleKind = row.VehicleKind ?? "Semi379",
+                VehicleClass = row.VehicleClass,
+                LodState = LogisticsLodState.Macro,
+                Status = status,
+                OriginTownId = row.OriginTownId,
+                DestTownId = row.DestTownId,
+                OriginPortId = row.OriginPortId != 0 ? row.OriginPortId : (route?.OriginPortId ?? 0u),
+                DestPortId = row.DestPortId != 0 ? row.DestPortId : (route?.DestPortId ?? 0u),
+                OriginLandblockId = originLb,
+                ContainerKind = row.ContainerKind,
+                CommodityId = row.CommodityId ?? "",
+                CommodityQty = Math.Max(0, row.CommodityQty),
+                SplineSM = Math.Max(0.0, row.SplineSM),
+                FuelLiters = Math.Max(0.0, row.FuelLiters),
+                WorldX = row.WorldX,
+                WorldY = row.WorldY,
+                WorldZ = row.WorldZ,
+                HeadingRad = row.HeadingRad,
+                Route = route,
+                UpdatedUtc = row.UpdatedUtc,
+            };
+        }
+    }
+
+    /// <summary>
+    /// Phase D (F15) Dual-LOD LogisticsEngine:
+    /// - 1 Hz Macro-LOD spline progression, real ULSD/HFO fuel consumption, out-of-fuel stall,
+    ///   radar/patrol IFF sweep, OriginLandblockId >= 1,500 m provenance preservation, and delivery.
+    /// - <= 480.0 m Micro-LOD seamless physical Vehicle materialization (Semi-379 & M/V Dereth Feeder),
+    ///   active landblock retention (safely skipping Ocean Corridor 48960..68928), and clean dematerialization.
+    /// </summary>
+    public static class LogisticsEngine
+    {
+        private static readonly ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
+
+        public const double MicroLodRadiusM = 480.0;
+        public const double MacroLodStepSeconds = 1.0;
+
+        // Fuel consumption rates & cruise speeds
+        public const double TractorCruiseSpeedMps = 22.0;   // Semi-379 VCruise
+        public const double TractorFuelBurnLitersPerM = 0.00040; // 0.40 L/km ULSD diesel
+        public const double DefaultTractorFuelLiters = 300.0;
+
+        public const double FeederShipCruiseSpeedMps = 6.2; // M/V Dereth Feeder maxSpeedMps
+        public const double FeederShipFuelBurnLitersPerM = 0.0120; // 12.0 L/km Marine HFO
+        public const double DefaultFeederShipFuelLiters = 25_000.0;
+
+        public const double UlsdLitersPerUnit = 100.0;
+        public const double MarineHfoLitersPerUnit = 5_000.0;
+
+        public const double InterdictionRangeM = 150.0;
+
+        private static readonly ConcurrentDictionary<ulong, LogisticsConvoyState> _convoys = new();
+        private static readonly List<Player> _testObservers = new();
+        private static readonly object _observerLock = new();
+        private static readonly object _tickLock = new();
+
+        private static long _lastTickTimestamp = 0;
+        private static double _macroAccumulator = 0.0;
+        private static ulong _nextConvoyId = 1;
+        private static volatile bool _initialized = false;
+
+        public static event Action<ulong, uint, uint> ConvoyRadarDetected;
+        public static event Action<ulong, uint, uint> ConvoyInterdicted;
+        public static event Action<ulong, uint, string, int> ConvoyDelivered;
+
+        public static bool ShouldMaterializeMicroLod(double distanceMeters)
+            => double.IsFinite(distanceMeters) && distanceMeters >= 0.0 && distanceMeters <= MicroLodRadiusM;
+
+        public static void Initialize()
+        {
+            LogisticsNavGraph nav = null;
+            try
+            {
+                nav = LogisticsNavGraph.LoadDefault();
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[LOGISTICS] LogisticsNavGraph.LoadDefault failed during Initialize: {ex.Message}");
+            }
+
+            try
+            {
+                var shardDb = DatabaseManager.Shard?.BaseDatabase;
+                if (shardDb != null)
+                {
+                    var rows = shardDb.LoadLogisticsConvoys();
+                    ulong maxId = 0;
+                    foreach (var row in rows)
+                    {
+                        if (row == null || row.ConvoyId == 0) continue;
+                        if (row.ConvoyId > maxId) maxId = row.ConvoyId;
+
+                        if (!Enum.TryParse<LogisticsConvoyStatus>(row.Status, true, out var parsedStatus))
+                            parsedStatus = LogisticsConvoyStatus.EnRoute;
+
+                        if (parsedStatus == LogisticsConvoyStatus.Arrived || parsedStatus == LogisticsConvoyStatus.Aborted)
+                            continue;
+
+                        var state = LogisticsConvoyState.FromDbRow(row, nav);
+                        if (state == null)
+                            continue;
+                        _convoys[state.ConvoyId] = state;
+                    }
+                    if (maxId >= _nextConvoyId)
+                        _nextConvoyId = maxId + 1;
+                }
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[LOGISTICS] Failed to load persisted logistics_convoy rows: {ex.Message}");
+            }
+
+            _initialized = true;
+        }
+
+        public static void ResetForTesting()
+        {
+            lock (_tickLock)
+            {
+                foreach (var convoy in _convoys.Values)
+                {
+                    if (convoy.ActiveVehicle != null)
+                    {
+                        try { VehicleManager.Despawn(convoy.ActiveVehicle, "logistics-reset"); } catch { }
+                        convoy.ActiveVehicle = null;
+                    }
+                }
+                _convoys.Clear();
+                _macroAccumulator = 0.0;
+                _lastTickTimestamp = 0;
+                _nextConvoyId = 1;
+                _initialized = true;
+            }
+            lock (_observerLock)
+            {
+                _testObservers.Clear();
+            }
+            ConvoyRadarDetected = null;
+            ConvoyInterdicted = null;
+            ConvoyDelivered = null;
+        }
+
+        public static void RegisterObserverForTesting(Player player)
+        {
+            if (player == null) return;
+            lock (_observerLock)
+            {
+                if (!_testObservers.Contains(player))
+                    _testObservers.Add(player);
+            }
+        }
+
+        public static void ClearObserversForTesting()
+        {
+            lock (_observerLock)
+            {
+                _testObservers.Clear();
+            }
+        }
+
+        public static LogisticsConvoyState GetConvoy(ulong convoyId)
+            => _convoys.TryGetValue(convoyId, out var c) ? c : null;
+
+        public static IReadOnlyList<LogisticsConvoyState> GetAllConvoys()
+            => _convoys.Values.OrderBy(c => c.ConvoyId).ToList();
+
+        internal static string ResolveMonarchName(uint monarchId, Player actor = null)
+        {
+            if (actor != null)
+            {
+                var actorMonarchName = actor.Allegiance?.Monarch?.Player?.Name ?? actor.Allegiance?.AllegianceName;
+                if (!string.IsNullOrWhiteSpace(actorMonarchName))
+                    return actorMonarchName;
+                if (monarchId != 0 && actor.Guid.Full == monarchId && !string.IsNullOrWhiteSpace(actor.Name))
+                    return actor.Name;
+            }
+            if (monarchId != 0)
+            {
+                try
+                {
+                    var p = PlayerManager.GetOnlinePlayer(monarchId);
+                    var n = p?.Allegiance?.Monarch?.Player?.Name ?? p?.Allegiance?.AllegianceName ?? p?.Name;
+                    if (!string.IsNullOrWhiteSpace(n))
+                        return n;
+                }
+                catch { }
+            }
+            return "";
+        }
+
+        public static LogisticsConvoyState DispatchConvoy(
+            uint ownerMonarchId,
+            uint originTownId,
+            uint destTownId,
+            byte vehicleClass,
+            out string error,
+            uint containerKind = 0,
+            string commodityId = "",
+            int commodityQty = 0,
+            double? initialFuelLiters = null,
+            bool allowFourWdLow = true,
+            uint? explicitOriginLandblockId = null,
+            IsoContainerDeployable attachedContainer = null,
+            ulong? explicitConvoyId = null,
+            string ownerMonarchName = "",
+            uint? explicitOriginPortId = null,
+            bool rejectDuplicateExplicitConvoyId = false,
+            uint? explicitDestPortId = null)
+        {
+            error = null;
+            if (!LogisticsNavGraph.IsSupportedVehicleClass(vehicleClass))
+            {
+                error = $"Unsupported vehicle class {vehicleClass}.";
+                return null;
+            }
+
+            if (originTownId == 0 || destTownId == 0)
+            {
+                error = "Origin and destination towns are required.";
+                return null;
+            }
+
+            bool isShip = vehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder;
+            bool hasExplicitPortTarget = isShip && explicitDestPortId.HasValue && explicitDestPortId.Value != 0;
+            if (!hasExplicitPortTarget && originTownId == destTownId)
+            {
+                error = "Origin and destination towns must be different.";
+                return null;
+            }
+
+            LogisticsNavGraph nav;
+            try
+            {
+                nav = LogisticsNavGraph.LoadDefault();
+            }
+            catch (Exception ex)
+            {
+                error = $"Navigation graph unavailable: {ex.Message}";
+                return null;
+            }
+
+            if (nav.HasInnerSeaLane())
+            {
+                error = "Navigation graph rejected due to excluded basin.";
+                return null;
+            }
+
+            LogisticsRoute route = null;
+            if (isShip && ((explicitOriginPortId.HasValue && explicitOriginPortId.Value != 0) ||
+                           (explicitDestPortId.HasValue && explicitDestPortId.Value != 0)))
+            {
+                var originPortNav = explicitOriginPortId.HasValue && explicitOriginPortId.Value != 0
+                    ? nav.GetPort(explicitOriginPortId.Value)
+                    : nav.FindNearestPortToTown(originTownId);
+                var destPortNav = explicitDestPortId.HasValue && explicitDestPortId.Value != 0
+                    ? nav.GetPort(explicitDestPortId.Value)
+                    : nav.FindNearestPortToTown(destTownId);
+                if (originPortNav != null && destPortNav != null && originPortNav.PortId != destPortNav.PortId &&
+                    nav.TryFindSeaRoute(originPortNav.PortId, destPortNav.PortId, out var explicitSeaRoute))
+                {
+                    route = new LogisticsRoute
+                    {
+                        OriginNodeId = explicitSeaRoute.OriginNodeId,
+                        DestNodeId = explicitSeaRoute.DestNodeId,
+                        OriginTownId = originTownId,
+                        DestTownId = destTownId,
+                        OriginPortId = explicitSeaRoute.OriginPortId,
+                        DestPortId = explicitSeaRoute.DestPortId,
+                        UsesSea = true,
+                        Uses4wdLow = false,
+                        TotalLengthM = explicitSeaRoute.TotalLengthM,
+                        Waypoints = explicitSeaRoute.Waypoints,
+                    };
+                }
+            }
+            else
+            {
+                nav.TryFindRoute(originTownId, destTownId, vehicleClass, allowFourWdLow, out route);
+            }
+
+            if (route == null || route.TotalLengthM <= 0.0)
+            {
+                error = isShip
+                    ? $"No valid Outer Ocean sea route between {originTownId} and {destTownId} for ContainerShipFeeder."
+                    : $"No valid overland logistics route between town {originTownId} and town {destTownId} for vehicle class {vehicleClass}.";
+                return null;
+            }
+
+            var originTown = nav.GetTown(originTownId);
+            var originPort = isShip && route.OriginPortId != 0 ? nav.GetPort(route.OriginPortId) : null;
+            uint originLb;
+            if (explicitOriginLandblockId.HasValue && explicitOriginLandblockId.Value != 0)
+            {
+                byte cont = originTown?.ContinentId ?? ((explicitOriginLandblockId.Value & 0x8000u) != 0 ? (byte)1 : (byte)0);
+                originLb = LogisticsNavGraph.NormalizePackedLandblockId(explicitOriginLandblockId.Value, cont);
+            }
+            else if (isShip && originPort != null && originPort.LandblockId != 0)
+            {
+                originLb = LogisticsNavGraph.NormalizePackedLandblockId(originPort.LandblockId, originPort.ContinentId);
+            }
+            else if (originTown != null && originTown.AnchorLandblockId != 0)
+            {
+                originLb = LogisticsNavGraph.NormalizePackedLandblockId(originTown.AnchorLandblockId, originTown.ContinentId);
+            }
+            else
+            {
+                originLb = 0u;
+            }
+            var startPose = LogisticsNavGraph.SamplePoseAtDistance(route, 0.0);
+            if (originLb == 0)
+                originLb = startPose.LandblockId;
+
+            bool needsSeaFuel = isShip || (vehicleClass == 0 && route.UsesSea);
+            double fuel = initialFuelLiters ?? (needsSeaFuel ? DefaultFeederShipFuelLiters : DefaultTractorFuelLiters);
+            if (!double.IsFinite(fuel) || fuel < 0.0) fuel = 0.0;
+
+            bool initialIsSea = isShip || (vehicleClass == 0 && LogisticsNavGraph.IsSeaSegmentAtDistance(route, 0.0));
+            byte resolvedVehicleClass = vehicleClass != 0
+                ? vehicleClass
+                : (route.UsesSea ? (byte)0 : (byte)ACE.Server.Vehicles.VehicleClass.HeavyTractor);
+            string resolvedMonarchName = !string.IsNullOrWhiteSpace(ownerMonarchName)
+                ? ownerMonarchName
+                : ResolveMonarchName(ownerMonarchId);
+
+            LogisticsConvoyState convoy;
+            Vehicle staleVehicleToDespawn = null;
+            lock (_tickLock)
+            {
+                ulong convoyId;
+                if (explicitConvoyId.HasValue && explicitConvoyId.Value != 0)
+                {
+                    convoyId = explicitConvoyId.Value;
+                    if (_convoys.TryGetValue(convoyId, out var existing))
+                    {
+                        if (rejectDuplicateExplicitConvoyId)
+                        {
+                            error = $"Convoy ID {convoyId} already exists.";
+                            return null;
+                        }
+                        uint existingOwner;
+                        lock (existing.SyncRoot)
+                        {
+                            existingOwner = existing.OwnerMonarchId;
+                        }
+                        if (existingOwner != ownerMonarchId)
+                        {
+                            error = $"Convoy ID {convoyId} belongs to another Allegiance.";
+                            return null;
+                        }
+                        lock (existing.SyncRoot)
+                        {
+                            staleVehicleToDespawn = existing.ActiveVehicle;
+                            existing.ActiveVehicle = null;
+                            existing.VehicleGuid = 0;
+                            existing.LodState = LogisticsLodState.Macro;
+                        }
+                    }
+                    if (convoyId >= _nextConvoyId)
+                        _nextConvoyId = convoyId + 1;
+                }
+                else
+                {
+                    convoyId = _nextConvoyId++;
+                    while (_convoys.ContainsKey(convoyId))
+                        convoyId = _nextConvoyId++;
+                }
+
+                convoy = new LogisticsConvoyState
+                {
+                    ConvoyId = convoyId,
+                    OwnerMonarchId = ownerMonarchId,
+                    OwnerMonarchName = resolvedMonarchName,
+                    VehicleGuid = 0,
+                    VehicleKind = initialIsSea ? "ContainerShipFeeder" : "Semi379",
+                    VehicleClass = resolvedVehicleClass,
+                    LodState = LogisticsLodState.Macro,
+                    Status = fuel <= 0.0 ? LogisticsConvoyStatus.OutOfFuel : LogisticsConvoyStatus.EnRoute,
+                    OriginTownId = originTownId,
+                    DestTownId = destTownId,
+                    OriginPortId = route.OriginPortId,
+                    DestPortId = route.DestPortId,
+                    OriginLandblockId = originLb,
+                    ContainerKind = containerKind != 0 ? containerKind : (attachedContainer?.Wcid ?? 0u),
+                    CommodityId = commodityId ?? "",
+                    CommodityQty = Math.Max(0, commodityQty),
+                    SplineSM = 0.0,
+                    FuelLiters = fuel,
+                    WorldX = startPose.X,
+                    WorldY = startPose.Y,
+                    WorldZ = initialIsSea ? 0.0 : startPose.Z,
+                    HeadingRad = startPose.HeadingRad,
+                    Route = route,
+                    AttachedContainer = attachedContainer,
+                    UpdatedUtc = DateTime.UtcNow,
+                };
+
+                if (attachedContainer != null)
+                {
+                    attachedContainer.OriginLandblockId = originLb;
+                    if (initialIsSea && IsoContainerDeployable.IsReeferWcid(attachedContainer.Wcid))
+                        attachedContainer.ExternalReeferPowerConnected = convoy.FuelLiters > 0.0;
+                }
+
+                _convoys[convoy.ConvoyId] = convoy;
+            }
+
+            if (staleVehicleToDespawn != null)
+            {
+                try { VehicleManager.Despawn(staleVehicleToDespawn, "convoy-replaced"); } catch { }
+            }
+
+            PersistConvoy(convoy);
+            return convoy;
+        }
