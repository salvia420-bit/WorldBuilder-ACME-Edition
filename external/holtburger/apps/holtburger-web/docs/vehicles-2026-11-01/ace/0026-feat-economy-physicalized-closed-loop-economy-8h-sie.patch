+        private static bool IsStarterTaperFeedstock(WorldObject wo)
+        {
+            if (wo == null || wo.IsDestroyed) return false;
+            if (wo.WeenieClassId == CrystallineResinWcid) return true;
+            var cat = PerishableDecay.Classify(wo.WeenieClassId, wo.Name, wo.WeenieType);
+            return cat is PerishableCategory.BioGlandIchorVenom or PerishableCategory.DairyAndMeat;
+        }
+
+        private static bool IsStarterIronFeedstock(WorldObject wo)
+        {
+            if (wo == null || wo.IsDestroyed) return false;
+            if (wo.WeenieClassId is HematiteWcid or IronOreScrapWcid) return true;
+            return wo.MaterialType == MaterialType.Iron;
+        }
+
+        private static bool IsStarterHerbFeedstock(WorldObject wo)
+        {
+            if (wo == null || wo.IsDestroyed) return false;
+            return PerishableDecay.Classify(wo.WeenieClassId, wo.Name, wo.WeenieType) == PerishableCategory.FreshHerb;
+        }
+
+        private static bool IsStarterHideFeedstock(WorldObject wo)
+        {
+            if (wo == null || wo.IsDestroyed) return false;
+            if (wo.WeenieClassId == RawHideScrapWcid) return true;
+            return PerishableDecay.Classify(wo.WeenieClassId, wo.Name, wo.WeenieType) == PerishableCategory.FreshHide;
+        }
