+        /// <summary>
+        /// Rung-0 zero-circular-dependency cold-start recipes on Public Commons Starter Hearths (4000095).
+        /// Runs at 0 kW, 0 fuel, and works even when the hosting town is UNCLAIMED_COLD.
+        /// Recipes:
+        ///  - hearth_tapers: 2x bio-glands/ichor/venom/dairy-meat or Crystalline Resin (40146) -> 5x Prismatic Taper (20631)
+        ///  - hearth_smelt_pyreal: 1x Pyreal Mote (6353) -> 100x Pyreal (273)
+        ///  - hearth_smelt_ingot: 25x Pyreal Mote (6353) -> 1x Quality Pyreal Ingot (6331)
+        ///  - hearth_smelt_iron: 2x Hematite (626) / Iron Scrap (21053) -> 2x Iron Scarab (689)
+        ///  - hearth_healing_kit: 2x Fresh Herb + 1x Fresh Hide -> 2x Crude Healing Kit (628)
+        /// </summary>
+        public static bool TryCraftStarterHearth(
+            PublicCommonsStarterHearthDeployable hearth,
+            Player actor,
+            string recipeId,
+            out string resultMessage)
+        {
+            if (hearth == null || hearth.IsDestroyed)
+            {
+                resultMessage = "Public Commons Starter Hearth is unavailable.";
+                return false;
+            }
+
+            if (actor == null || actor.Inventory == null)
+            {
+                resultMessage = "Player inventory required to use Starter Hearth.";
+                return false;
+            }
+
+            if (hearth.Location != null)
+            {
+                if (actor.Location == null)
