+        private static bool IsObjectInTownBoundary(WorldObject wo, uint townId)
+        {
+            if (wo?.Location == null) return false;
+            var resolved = TownRegistry.ResolveTown(wo);
+            if (resolved != null && resolved.TownId == townId)
+                return true;
+
+            var def = TownRegistry.GetById(townId);
+            if (def == null) return false;
+            var (gx, gy, _) = Vehicle.ToGlobal(wo.Location);
+            var dx = gx - def.WorldX;
+            var dy = gy - def.WorldY;
+            return (dx * dx + dy * dy) <= 600.0 * 600.0;
+        }
