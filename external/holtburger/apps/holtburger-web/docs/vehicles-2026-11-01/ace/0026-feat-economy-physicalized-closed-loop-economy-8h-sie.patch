+        /// <summary>
+        /// Real-time tick called from WorldManager.UpdateGameWorld().
+        /// Fast-returns when physical_economy_enabled is false.
+        /// </summary>
+        public static void Tick()
+        {
+            if (!TownEconomyManager.Enabled)
+            {
+                lastTickTimestamp = 0;
+                return;
+            }
+
+            var nowTs = Stopwatch.GetTimestamp();
+            if (lastTickTimestamp == 0)
+            {
+                lastTickTimestamp = nowTs;
+                return;
+            }
+
+            double dt = (nowTs - lastTickTimestamp) / (double)Stopwatch.Frequency;
+            lastTickTimestamp = nowTs;
+            if (!double.IsFinite(dt) || dt <= 0.0)
+                return;
+            if (dt > 1.0)
+                dt = 1.0;
+
+            Tick(dt, DateTime.UtcNow);
+        }
