@@ -0,0 +1,83 @@
+using System;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Models;
+using ACE.Server.Economy;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Town Control Node (WCID 4000090, DeployableKind.TownControlNode = 56).
+    /// Non-pallet civic anchor hydrated on landblock load; enforces the 30 m capture/control ring.
+    /// Excluded from ace_shard biota persistence via WorldObject_Database.cs:146.
+    /// </summary>
+    public class TownControlNodeDeployable : DeployableBase
+    {
+        public const uint TownControlNodeWeenieClassId = 4_000_090;
+        public const float ControlRingRadiusM = 30.0f;
+
+        public uint TownId { get; set; }
+
+        protected override bool BroadcastDespawnOnDestroy => false;
+
+        public TownControlNodeDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.TownControlNode;
+            Pallet = PalletSize.None;
+            OnlineFlags = DeployableOnlineFlags.Active;
+        }
+
+        public static Weenie BuildWeenie(uint townId = 0, string townName = "Town", Vehicle parentVehicle = null, Player deployer = null)
+        {
+            var label = string.IsNullOrWhiteSpace(townName) ? "Town" : townName;
+            return BuildDeployableWeenie(
+                TownControlNodeWeenieClassId,
+                "hbtown_control_node",
+                $"{label} Town Control Node",
+                "Hold uncontested within 30m for 5m to breach, then 8h with sustained >=1.5km supply to capture."
+            );
+        }
+
+        public bool IsPlayerInsideControlRing(Player player)
+        {
+            if (player?.Location == null || Location == null || player.Location.Indoors)
+                return false;
+
+            var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+            var dist = Vector3.Distance(GlobalPosition, new Vector3((float)px, (float)py, (float)pz));
+            return SiegeManager.IsWithinControlRing(dist);
+        }
+
+        public override void ActOnUse(WorldObject activator)
+        {
+            if (activator is not Player player)
+                return;
+
+            var tid = TownId != 0 ? TownId : (TownRegistry.ResolveTown(this)?.TownId ?? 0u);
+            if (tid == 0)
+            {
+                player.SendMessage("This Town Control Node is not linked to a registered town.", ChatMessageType.Broadcast);
+                return;
+            }
+
+            var snap = SiegeManager.GetSiegeState(tid);
+            if (snap == null)
+            {
+                player.SendMessage($"Town {tid} control state is unavailable.", ChatMessageType.Broadcast);
+                return;
+            }
+
+            var def = TownRegistry.GetById(tid);
+            var townLabel = def?.Name ?? $"Town #{tid}";
+            var drainRate = def != null ? TownRegistry.GetSupplyDrainPerHour(def.Tier) : 40;
+            player.SendMessage(
+                $"[TCN: {townLabel}] State: {snap.State} | Owner Monarch: {snap.OwnerMonarchId} | Attacker: {snap.AttackerMonarchId} | " +
+                $"Hold: {snap.HoldElapsedSec:0}/{SiegeManager.HoldDurationSec:0}s | Supply: {snap.SupplyMeterSec:0}/{SiegeManager.SupplyMeterMaxSec:0}s ({drainRate} SP/hr) | " +
+                $"Treasury: {snap.TreasuryPyreals:N0}p (Escrow: {snap.EscrowPyreals:N0}p, Reserve: {snap.ClearinghouseReservePyreals:N0}p).",
+                ChatMessageType.Broadcast);
+        }
+    }
+}
