+        internal static void FreezeSpendableTreasuryToEscrowLocked(TownRuntimeState state)
+        {
+            var spendable = Math.Max(0L, state.Control.TreasuryPyreals - state.Control.ClearinghouseReservePyreals);
+            if (spendable > 0)
+            {
+                state.Control.TreasuryPyreals -= spendable;
+                state.Control.EscrowPyreals += spendable;
+            }
+        }
+
+        internal static void RestoreEscrowToTreasuryLocked(TownRuntimeState state)
+        {
+            if (state.Control.EscrowPyreals > 0)
+            {
+                state.Control.TreasuryPyreals += state.Control.EscrowPyreals;
+                state.Control.EscrowPyreals = 0;
+            }
+        }
