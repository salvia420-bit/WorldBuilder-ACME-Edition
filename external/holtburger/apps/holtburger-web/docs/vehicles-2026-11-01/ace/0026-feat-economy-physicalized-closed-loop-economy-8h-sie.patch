+        private static void KeepConvoyLandblockActive(double gx, double gy)
+        {
+            // Strictly skip Ocean Corridor [48960, 68928) so no invalid landblock load stalls the world thread
+            if (gy >= LandblockManager.OceanCorridorYMin && gy < LandblockManager.OceanCorridorYMax)
+                return;
+
+            try
+            {
+                int continent = gy >= Vehicle.DericostYOffset ? 1 : 0;
+                double localY = continent == 1 ? gy - Vehicle.DericostYOffset : gy;
+                int lbX = Math.Clamp((int)Math.Floor(gx / 192.0), 0, 254);
+                int lbY = Math.Clamp((int)Math.Floor(localY / 192.0), 0, 254);
+                LandblockManager.GetLoadedLandblock(continent, lbX, lbY)?.SetActive(true);
+            }
+            catch
+            {
+                // Headless unit test without initialized LandblockManager
+            }
+        }
+
+        private static double ComputeNearestObserverDistanceM(double worldX, double worldY)
+        {
+            double minDistSq = double.MaxValue;
+
+            void ConsiderPoint(double ox, double oy)
+            {
+                double dx = worldX - ox;
+                double dy = worldY - oy;
+                double dSq = dx * dx + dy * dy;
+                if (dSq < minDistSq)
+                    minDistSq = dSq;
+            }
+
+            try
+            {
+                foreach (var p in PlayerManager.GetAllOnline())
+                {
+                    if (p == null || p.Location == null || p.Location.Indoors || p.IsLoggingOut)
+                        continue;
+                    var (px, py, _) = VehicleManager.GetObserverGlobalPosition(p);
+                    ConsiderPoint(px, py);
+                }
+            }
+            catch { }
+
+            lock (_observerLock)
+            {
+                foreach (var p in _testObservers)
+                {
+                    if (p == null || p.Location == null || p.Location.Indoors)
+                        continue;
+                    var (px, py, _) = VehicleManager.GetObserverGlobalPosition(p);
+                    ConsiderPoint(px, py);
+                }
+            }
+
+            foreach (var dep in DeployableManager.GetAll())
+            {
+                if (dep == null || dep.IsDestroyed || dep.IsPacked || !dep.IsActive || dep.Location == null)
+                    continue;
+                if (dep is GroundRadarDeployable || dep is MissileTurretDeployable ||
+                    dep is LaserTurretDeployable || dep is MortarTurretDeployable)
+                {
+                    var pos = dep.GlobalPosition;
+                    ConsiderPoint(pos.X, pos.Y);
+                }
+            }
+
+            foreach (var station in AirDefenseManager.Stations)
+            {
+                if (station == null || station.IsDestroyed || station.Location == null)
+                    continue;
+                var pos = station.Position;
+                ConsiderPoint(pos.X, pos.Y);
+            }
+
+            return minDistSq < double.MaxValue ? Math.Sqrt(minDistSq) : double.PositiveInfinity;
+        }
