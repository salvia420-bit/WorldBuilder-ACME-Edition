+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Forward Siege Supply Beacon (WCID 4000092, DeployableKind.ForwardSiegeBeacon = 58).
+    /// Full ISO 6780 pallet deployable placed by attackers to receive >= 1,500 m origin-provenanced
+    /// siege supply deliveries during an active siege.
+    /// Excluded from ace_shard biota persistence via WorldObject_Database.cs:146.
+    /// </summary>
+    public class ForwardSiegeBeaconDeployable : DeployableBase
+    {
+        public const uint ForwardSiegeBeaconWeenieClassId = 4_000_092;
+        public const float DeliveryRadiusM = 20.0f;
+
+        public uint TargetTownId { get; set; }
+        public uint AttackerMonarchId { get; set; }
+
+        public ForwardSiegeBeaconDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.ForwardSiegeBeacon;
+            Pallet = PalletSize.Full;
+            OnlineFlags = DeployableOnlineFlags.Active;
+            if (deployer != null)
+                AttackerMonarchId = TownCommands.ResolveEffectiveMonarchId(deployer);
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                ForwardSiegeBeaconWeenieClassId,
+                "hbsiege_forward_beacon",
+                "Forward Siege Supply Beacon",
+                "Accepts >= 1,500 m origin-provenanced supply cargo to sustain the 90-minute rolling Siege Supply Meter."
+            );
+        }
+
+        private static Vector3 GetDeployableGlobalPosition(DeployableBase unit)
+        {
+            if (unit is SemiTrailerDeployable st)
+            {
+                var (gx, gy, gz) = st.GetGlobalPose();
+                return new Vector3((float)gx, (float)gy, (float)gz);
+            }
+            if (unit is IsoContainerDeployable ic)
+                return ic.Position;
+            return unit.GlobalPosition;
+        }
+
+        private bool IsActorWithinDeliveryRadius(Player actor, out string error)
+        {
+            if (Location != null && actor?.Location != null)
+            {
+                var (ax, ay, az) = Vehicle.ToGlobal(actor.Location);
+                var dist = Vector3.Distance(GlobalPosition, new Vector3((float)ax, (float)ay, (float)az));
+                if (dist > DeliveryRadiusM)
+                {
+                    error = $"Move within {DeliveryRadiusM:0}m of the Forward Siege Beacon ({dist:0.1}m away).";
+                    return false;
+                }
+            }
+            error = null;
+            return true;
+        }
+
+        private static bool IsInActorInventory(Player actor, WorldObject item)
+        {
+            if (actor?.Inventory == null || item == null)
+                return false;
+
+            try
+            {
+                return actor.FindObject(item.Guid.Full, Player.SearchLocations.MyInventory) != null;
+            }
+            catch (NullReferenceException)
+            {
+                return false;
+            }
+        }
+
+        public bool TryAcceptCargoUnit(DeployableBase cargo, Player actor, double supplyPoints, out string message)
+        {
+            if (cargo == null)
+            {
+                message = "No supply cargo unit provided.";
+                return false;
+            }
+
+            lock (cargo)
+            {
+                if (cargo.IsDestroyed || cargo.IsPacked || cargo.OriginLandblockId == 0)
+                {
+                    message = cargo.IsDestroyed || cargo.IsPacked
+                        ? "No supply cargo unit provided."
+                        : "Origin-provenance check failed: cargo unit has no origin landblock.";
+                    return false;
+                }
+
+                if (Location != null && cargo.Location != null)
+                {
+                    var dist = Vector3.Distance(GlobalPosition, GetDeployableGlobalPosition(cargo));
+                    if (dist > DeliveryRadiusM)
+                    {
+                        message = $"Move cargo unit within {DeliveryRadiusM:0}m of the Forward Siege Beacon ({dist:0.1}m away).";
+                        return false;
+                    }
+                }
+
+                if (!IsActorWithinDeliveryRadius(actor, out message))
+                    return false;
+
+                if (!TryAcceptProvenanceDelivery(actor, cargo.OriginLandblockId, supplyPoints, out message))
+                    return false;
+
+                cargo.OriginLandblockId = 0;
+                try { cargo.Destroy(false); } catch (NullReferenceException) { }
+                return true;
+            }
+        }
+
+        public bool TryAcceptInventoryItem(WorldObject item, Player actor, double supplyPoints, out string message)
+        {
+            if (item == null)
+            {
+                message = "No supply item provided.";
+                return false;
+            }
+
+            lock (item)
+            {
+                if (item.IsDestroyed)
+                {
+                    message = "No supply item provided.";
+                    return false;
+                }
+
+                if (Location != null && item.Location != null)
+                {
+                    var (ix, iy, iz) = Vehicle.ToGlobal(item.Location);
+                    var dist = Vector3.Distance(GlobalPosition, new Vector3((float)ix, (float)iy, (float)iz));
+                    if (dist > DeliveryRadiusM)
+                    {
+                        message = $"Move supply item within {DeliveryRadiusM:0}m of the Forward Siege Beacon ({dist:0.1}m away).";
+                        return false;
+                    }
+                }
+
+                if (!IsActorWithinDeliveryRadius(actor, out message))
+                    return false;
+
+                var originLb = (uint)(item.GetProperty(PropertyInt.OriginLandblockId) ?? 0);
+                if (!TryAcceptProvenanceDelivery(actor, originLb, supplyPoints, out message))
+                    return false;
+
+                bool inActorInventory = IsInActorInventory(actor, item);
+                if (actor != null && actor.Session?.Network != null && inActorInventory)
+                {
+                    if ((item.StackSize ?? 1) <= 1)
+                        item.SetProperty(PropertyInt.OriginLandblockId, 0);
+                    actor.TryConsumeFromInventoryWithNetworking(item, 1);
+                }
+                else
+                {
+                    int stackSize = item.StackSize ?? 1;
+                    if (stackSize > 1)
+                    {
+                        item.StackSize = stackSize - 1;
+                    }
+                    else
+                    {
+                        item.SetProperty(PropertyInt.OriginLandblockId, 0);
+                        if (inActorInventory)
+                            actor.TryRemoveFromInventory(item.Guid, out _);
+                        try { item.Destroy(false); } catch (NullReferenceException) { }
+                    }
+                }
+                return true;
+            }
+        }
+
+        public bool TryAcceptContainer(IsoContainerDeployable container, Player actor, double supplyPointsPerPallet, out int acceptedPallets, out string message)
+        {
+            acceptedPallets = 0;
+            if (container == null)
+            {
+                message = "Target ISO container is unavailable.";
+                return false;
+            }
+
+            int rejected = 0;
+            lock (container)
+            {
+                if (container.IsDestroyed || container.IsPacked)
+                {
+                    message = "Target ISO container is unavailable.";
+                    return false;
+                }
+
+                if (Location != null && container.Location != null)
+                {
+                    var dist = Vector3.Distance(GlobalPosition, container.Position);
+                    if (dist > DeliveryRadiusM)
+                    {
+                        message = $"Move container within {DeliveryRadiusM:0}m of the Forward Siege Beacon ({dist:0.1}m away).";
+                        return false;
+                    }
+                }
+
+                if (!IsActorWithinDeliveryRadius(actor, out message))
+                    return false;
+
+                var tid = ResolveTargetTownId();
+                if (tid == 0)
+                {
+                    message = "Forward Siege Beacon has no target town.";
+                    return false;
+                }
+
+                foreach (var slot in container.Slots)
+                {
+                    if (!slot.Occupied && slot.OccupiedSubSlots == 0) continue;
+                    uint origin = slot.CargoStates[0].OriginLandblockId != 0
+                        ? slot.CargoStates[0].OriginLandblockId
+                        : container.OriginLandblockId;
+
+                    if (SiegeManager.DeliverSiegeSupply(tid, origin, supplyPointsPerPallet, actor, out _))
+                    {
+                        acceptedPallets++;
+                        slot.Occupied = false;
+                        slot.OccupiedWcids[0] = 0;
+                        slot.OccupiedWcids[1] = 0;
+                        slot.CargoStates[0] = default;
+                        slot.CargoStates[1] = default;
+                        slot.OccupiedPalletSize = PalletSize.None;
+                        slot.OccupiedSubSlots = 0;
+                    }
+                    else
+                    {
+                        rejected++;
+                    }
+                }
+            }
+
+            if (acceptedPallets > 0)
+            {
+                container.BroadcastState();
+                message = $"Delivered {acceptedPallets} pallet(s) from container to siege apron ({rejected} rejected by provenance/siege state).";
+                return true;
+            }
+
+            message = rejected > 0
+                ? "All container pallets failed >= 1,500m origin-provenance or siege state validation."
+                : "Container has no cargo pallets to deliver.";
+            return false;
+        }
+
+        public bool TryAcceptProvenanceDelivery(Player actor, uint originLandblockId, double supplyPoints, out string message)
+        {
+            var tid = ResolveTargetTownId();
+            if (tid == 0)
+            {
+                message = "Forward Siege Beacon is not associated with a target town.";
+                return false;
+            }
+
+            return SiegeManager.DeliverSiegeSupply(tid, originLandblockId, supplyPoints, actor, out message);
+        }
+
+        public uint ResolveTargetTownId()
+        {
+            if (TargetTownId != 0) return TargetTownId;
+            if (AffiliatedTownId != 0) return AffiliatedTownId;
+            return TownRegistry.ResolveTown(this)?.TownId ?? 0u;
+        }
+
+        public override void ActOnUse(WorldObject activator)
+        {
+            if (activator is not Player player)
+                return;
+
+            var tid = ResolveTargetTownId();
+            if (tid == 0)
+            {
+                player.SendMessage("Forward Siege Supply Beacon has no target town.", ChatMessageType.Broadcast);
+                return;
+            }
+
+            var snap = SiegeManager.GetSiegeState(tid);
+            var def = TownRegistry.GetById(tid);
+            player.SendMessage(
+                $"[Siege Beacon -> {def?.Name ?? $"Town #{tid}"}] State: {snap?.State ?? "UNKNOWN"} | " +
+                $"Supply Meter: {snap?.SupplyMeterSec ?? 0:0}/{SiegeManager.SupplyMeterMaxSec:0}s | Apron SP: {snap?.ApronSupplySp ?? 0:0.0}.",
+                ChatMessageType.Broadcast);
+        }
+    }
+}
