+            Assert.IsTrue(reeferExternal.IsPoweredReefer);
+
+            var glandInReefer = CreateTestGenericItem(10864, "Olthoi Ichor");
+            var herbInExternalReefer = CreateTestGenericItem(625, "Ginseng");
