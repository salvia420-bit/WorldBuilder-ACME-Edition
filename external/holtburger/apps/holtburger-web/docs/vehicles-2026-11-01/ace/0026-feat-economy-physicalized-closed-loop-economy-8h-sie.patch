+        private static void EnsureInitialized()
+        {
+            if (!initialized)
+                Initialize();
+        }
+
+        public static void Initialize()
+        {
+            lock (initLock)
+            {
+                SeedInMemoryLocked();
+
+                var shardDb = DatabaseManager.Shard?.BaseDatabase;
+                if (shardDb != null)
+                {
+                    try
+                    {
+                        var seedRows = deposits.Values.Select(CloneDeposit).ToList();
+                        var (loadedDeposits, loadedFacilities) = shardDb.SeedAndLoadGeology(seedRows);
+                        foreach (var dep in loadedDeposits)
+                        {
+                            if (dep.DepositId <= MaxSafeDepositId)
+                                deposits[dep.DepositId] = CloneDeposit(dep);
+                        }
+                        IndustryManager.LoadPersistedFacilities(loadedFacilities);
+                        log.Info($"[GEOLOGY] Initialized {Basins.Count} subsurface basins and {deposits.Count} deposits from ace_shard.");
+                    }
+                    catch (Exception ex)
+                    {
+                        log.Warn($"[GEOLOGY] Falling back to in-memory geology seeding: {ex.Message}");
+                    }
+                }
+
+                initialized = true;
+            }
+        }
