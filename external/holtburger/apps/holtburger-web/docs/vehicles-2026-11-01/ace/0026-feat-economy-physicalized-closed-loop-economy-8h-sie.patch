@@ -0,0 +1,319 @@
+using System;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Models;
+using ACE.Server.Economy;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Prospecting pallets (4000070-4000074, ISO 6780 Full Pallets, DeployableKind 38-42).
+    /// </summary>
+    public class ProspectingDeployable : DeployableBase
+    {
+        public const uint WcidGprScanner = 4_000_070;
+        public const uint WcidVibroseisSeismic = 4_000_071;
+        public const uint WcidDiamondCoreDrill = 4_000_072;
+        public const uint WcidMobileAssayLab = 4_000_073;
+        public const uint WcidCoreSampleCrate = 4_000_074;
+
+        public ulong CoreDepositId { get; set; }
+        public string CoreBasinId { get; set; } = "";
+        public bool CoreAssayed { get; set; }
+
+        public override bool ConnectsToMicroGrid => true;
+
+        public override float PowerWatts =>
+            (!IsPacked && IsActive && !IsStowed) ? Math.Max(0f, IndustryManager.GetPowerSpecWatts(Wcid)) : 0f;
+
+        public ProspectingDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = weenie.WeenieClassId switch
+            {
+                WcidGprScanner => DeployableKind.GprScanner,
+                WcidVibroseisSeismic => DeployableKind.VibroseisSeismic,
+                WcidDiamondCoreDrill => DeployableKind.DiamondCoreDrill,
+                WcidMobileAssayLab => DeployableKind.MobileAssayLab,
+                WcidCoreSampleCrate => DeployableKind.CoreSampleCrate,
+                _ => throw new ArgumentOutOfRangeException(nameof(weenie)),
+            };
+            Pallet = PalletSize.Full;
+        }
+
+        public static Weenie BuildWeenie(uint wcid, Vehicle parentVehicle = null, Player deployer = null) => wcid switch
+        {
+            WcidGprScanner => BuildDeployableWeenie(wcid, "hbprospect_gpr", "Ground-Penetrating Radar (GPR)", "Stage 2 shallow EM scanner (1-35 m, 1.5 kW). Attenuates in wet marshes."),
+            WcidVibroseisSeismic => BuildDeployableWeenie(wcid, "hbprospect_vibroseis", "Vibroseis Seismic & Mag-Grav Array", "Stage 1/3 acoustic & gravity-magnetic profiler (100-2,500 m, 4 kW). Works in wet marshes."),
+            WcidDiamondCoreDrill => BuildDeployableWeenie(wcid, "hbprospect_coredrill", "Diamond Core Drilling Rig", "Stage 4 wireline core rig (18 kW). Recovers 1.5 m physical cores (cored_flag = true)."),
+            WcidMobileAssayLab => BuildDeployableWeenie(wcid, "hbprospect_assaylab", "Mobile Assay Lab", "Stage 4 geochemical lab (6 kW). Evaluates grade, tonnage, °API gravity, and sulfur wt%."),
+            WcidCoreSampleCrate => BuildDeployableWeenie(wcid, "hbprospect_corecrate", "Core Sample Crate", "Rack-storable ISO 6780 pallet holding proved subsurface core samples."),
+            _ => BuildDeployableWeenie(wcid, "hbprospect_unit", "Prospecting Unit", "Geophysical prospecting pallet."),
+        };
+
+        public override void ActOnUse(WorldObject activator)
+        {
+            if (activator is not Player player || Location == null)
+                return;
+
+            if (IndustryManager.GetPowerSpecWatts(Wcid) > 0f && !IsPowered)
+            {
+                player.SendMessage($"{Name} requires an active powered MicroGrid.", ChatMessageType.Broadcast);
+                return;
+            }
+
+            uint lbId = SiegeManager.PackOriginLandblockId(Location.LandblockId);
+            byte terrain = GeologyService.ResolveTerrainCodeAt(Location);
+
+            switch (Wcid)
+            {
+                case WcidGprScanner:
+                    player.SendMessage(GeologyService.RunGprScan(lbId, terrain).Message, ChatMessageType.Broadcast);
+                    break;
+                case WcidVibroseisSeismic:
+                    player.SendMessage(GeologyService.RunVibroseisScan(lbId, terrain).Message, ChatMessageType.Broadcast);
+                    break;
+                case WcidDiamondCoreDrill:
+                    if (GeologyService.TryDrillCoreAtLandblock(lbId, out var core, out var drillErr))
+                    {
+                        CoreDepositId = core.DepositId;
+                        CoreBasinId = core.BasinId;
+                        player.SendMessage($"[Diamond Core Drill] Cored deposit #{core.DepositId} ({core.ResourceType}) in {core.BasinId}.", ChatMessageType.Broadcast);
+                    }
+                    else
+                        player.SendMessage(drillErr, ChatMessageType.Broadcast);
+                    break;
+                case WcidMobileAssayLab:
+                    var targetDep = CoreDepositId != 0 ? GeologyService.GetDeposit(CoreDepositId) : GeologyService.FindNearestDeposit(lbId);
+                    string assayErr = null;
+                    if (targetDep != null && GeologyService.RunMobileAssay(targetDep.DepositId, out var assay, out assayErr))
+                    {
+                        CoreAssayed = true;
