+        {
+            uint ownMonarch = 0x50000001u;
+            uint enemyMonarch = 0x60000001u;
+
+            for (int trial = 0; trial < 100; trial++)
+            {
+                LogisticsEngine.ResetForTesting();
+                var convoy = LogisticsEngine.DispatchConvoy(ownMonarch, 1u, 5u, (byte)VehicleClass.HeavyTractor, out var err, commodityId: "supply_crate", commodityQty: 5);
+                Assert.IsNotNull(convoy, err);
