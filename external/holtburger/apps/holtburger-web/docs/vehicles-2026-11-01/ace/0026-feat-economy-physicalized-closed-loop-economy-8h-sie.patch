+        private static readonly Dictionary<uint, TownDefinition> TownsById;
+        private static readonly Dictionary<string, TownDefinition> TownsByName;
+        private static readonly List<TownDefinition> DerethTowns = new();
+        private static readonly List<TownDefinition> DericostTowns = new();
+
+        private static readonly Dictionary<string, string> NameAliases = new(StringComparer.OrdinalIgnoreCase)
+        {
+            { "Hebian-to", "Hebian-To" },
+            { "Qalabar", "Qalaba'r" },
+            { "Plateau", "Plateau Village" },
+            { "Fiun", "Fiun Outpost" },
+            { "Freehold", "MacNiall's Freehold" },
+            { "Refuge", "Oolutanga's Refuge" },
+            { "Neydisa", "Neydisa Castle" },
+            { "Outpost", "West Outpost" },
+        };
+
+        static TownRegistry()
+        {
+            TownsById = new Dictionary<uint, TownDefinition>(AllTowns.Count);
+            TownsByName = new Dictionary<string, TownDefinition>(AllTowns.Count, StringComparer.OrdinalIgnoreCase);
+
+            foreach (var town in AllTowns)
+            {
+                TownsById[town.TownId] = town;
+                TownsByName[town.Name] = town;
+                if (town.ContinentId == 1)
+                    DericostTowns.Add(town);
+                else
+                    DerethTowns.Add(town);
+            }
+        }
+
+        public static TownDefinition GetById(uint townId)
+            => TownsById.TryGetValue(townId, out var town) ? town : null;
+
+        public static TownDefinition FindByName(string name)
+        {
+            if (string.IsNullOrWhiteSpace(name))
+                return null;
+
+            var trimmed = name.Trim();
+            if (TownsByName.TryGetValue(trimmed, out var direct))
+                return direct;
+
+            if (NameAliases.TryGetValue(trimmed, out var canonical) && TownsByName.TryGetValue(canonical, out var aliased))
+                return aliased;
+
+            return null;
+        }
+
+        public static bool IsDungeonLandblock(ushort lb)
+        {
+            var lbX = (lb >> 8) & 0xFF;
+            var lbY = lb & 0xFF;
+            return lbX <= 3 || lbY <= 4 || lb == 0x596B || lb == 0x89F4 || lb == 0x5660 || (lb >= 0x5360 && lb <= 0x5369) || HouseManager.ApartmentBlocks.ContainsKey(lb);
+        }
+
+        /// <summary>
+        /// Returns true ONLY for indoor cells inside dedicated dungeon landblocks (Town Network,
+        /// Societies, Marketplace, Gauntlet, etc.). Returns false for indoor cells inside town
+        /// buildings on overworld landblocks (e.g., Holtburg/Yaraq/Sanamar shops).
+        /// </summary>
+        public static bool IsDungeonCell(uint objCellId)
+        {
+            if ((objCellId & 0x8000u) != 0)
+                return false;
+
+            if ((objCellId & 0x7FFFu) < 0x100u)
+                return false;
+
+            var lb = (ushort)(objCellId >> 16);
+            return IsDungeonLandblock(lb);
+        }
+
+        /// <summary>
+        /// Maps interior residential apartment hall landblocks (HouseManager.ApartmentBlocks)
+        /// to their parent overworld hub town so Slumlord purchases and rent route cleanly.
+        /// </summary>
+        public static bool TryResolveApartmentTownId(ushort landblock, out uint townId)
+        {
+            if (landblock >= 0x5360 && landblock <= 0x5369)
+            {
+                townId = 6; // Cragstone (Sanctum Residential Halls)
+                return true;
+            }
+            if (landblock >= 0x7200 && landblock <= 0x7B00 && (landblock & 0xFF) == 0)
+            {
+                townId = 8; // Glenden Wood (Atrium Residential Halls)
+                return true;
+            }
+            if (landblock >= 0x7C00 && landblock <= 0x8500 && (landblock & 0xFF) == 0)
+            {
+                townId = 20; // Khayyaban (Oriel Residential Halls)
+                return true;
+            }
+            if (landblock >= 0x8600 && landblock <= 0x8F00 && (landblock & 0xFF) == 0)
+            {
+                townId = 15; // Lytelthorpe (Haven Residential Halls)
+                return true;
+            }
+            if (landblock >= 0x9000 && landblock <= 0x9900 && (landblock & 0xFF) == 0)
+            {
+                townId = 13; // Samsur (Victory Residential Halls)
+                return true;
+            }
+            if (HouseManager.ApartmentBlocks.ContainsKey(landblock))
+            {
+                townId = 1; // Fallback Holtburg
+                return true;
+            }
+
+            townId = 0;
+            return false;
+        }
+
+        public static TownDefinition ResolveTown(WorldObject obj)
+        {
+            if (obj?.Location == null)
+                return null;
+
+            if (obj.CurrentLandblock?.IsDungeon == true && obj is not SlumLord)
+                return null;
+
+            return ResolveTown(obj.Location, includeApartments: obj is SlumLord);
+        }
+
+        public static TownDefinition ResolveTown(Position pos, bool includeApartments = false)
+        {
+            if (pos == null)
+                return null;
+
+            return ResolveTown(pos.Cell, pos.PositionX, pos.PositionY, includeApartments);
+        }
+
+        public static TownDefinition ResolveTown(uint objCellId, float originX, float originY, bool includeApartments = false)
+        {
+            var lb = (ushort)(objCellId >> 16);
+
+            if (includeApartments && TryResolveApartmentTownId(lb, out var aptTownId))
+                return GetById(aptTownId);
+
+            if (IsDungeonCell(objCellId))
+                return null;
+
+            var isDericost = (objCellId & 0x8000u) != 0;
+            var lbX = (objCellId >> 24) & 0xFFu;
+            var lbY = (objCellId >> 16) & 0xFFu;
+            var gx = lbX * 192.0 + originX;
+            var gy = (isDericost ? Vehicle.DericostYOffset : 0.0) + lbY * 192.0 + originY;
+
+            return ResolveTownGlobal(gx, gy);
+        }
+
+        public static TownDefinition ResolveTownGlobal(double gx, double gy)
+        {
+            var list = gy >= Vehicle.DericostYOffset ? DericostTowns : DerethTowns;
+            TownDefinition best = null;
+            var bestDistSq = double.MaxValue;
+
+            for (int i = 0; i < list.Count; i++)
+            {
+                var town = list[i];
+                var dx = gx - town.WorldX;
+                var dy = gy - town.WorldY;
+                var dSq = dx * dx + dy * dy;
+                if (dSq < bestDistSq)
+                {
+                    bestDistSq = dSq;
+                    best = town;
+                }
+            }
+
+            return best;
+        }
+    }
+}
