+        [TestMethod]
+        public async Task F17_AgentGateway_ConstantTimeAuth_Routes_ValidationParity_AndWsAlerts()
+        {
+            const string token = "test-gateway-secret-token";
+            Assert.IsTrue(AgentGatewayService.ConstantTimeEquals(token, token));
+            Assert.IsFalse(AgentGatewayService.ConstantTimeEquals("", token));
+            Assert.IsFalse(AgentGatewayService.ConstantTimeEquals(token, ""));
+            Assert.IsFalse(AgentGatewayService.ConstantTimeEquals("wrong-token", token));
+
+            uint monarchId = AllocGuid();
+            uint vassalId = AllocGuid();
+            var monarch = CreateTestPlayer(monarchId, 0xA9B40001u, 30f, 30f, 10f, monarchId: monarchId, isMonarch: true);
+            var vassal = CreateTestPlayer(vassalId, 0xA9B40001u, 30f, 30f, 10f, monarchId: monarchId, isMonarch: false);
+            TownEconomyManager.SetTownOwner(1u, monarchId, "CONTROLLED");
+            TownEconomyManager.SeedTownTill(1u, 50_000L);
+
+            AgentGatewayService.TokenOverride = token;
+            AgentGatewayService.EnabledOverride = true;
+            AgentGatewayService.TestActorResolver = id => id == monarchId ? monarch : (id == vassalId ? vassal : null);
+            int port = AgentGatewayService.Start(0);
+
+            using var http = new HttpClient { BaseAddress = new Uri($"http://127.0.0.1:{port}") };
+
+            // Fail-closed 401 on missing / invalid Bearer token
+            var noAuthResp = await http.GetAsync("/api/v1/world/towns");
+            Assert.AreEqual(HttpStatusCode.Unauthorized, noAuthResp.StatusCode);
+
+            using (var badReq = new HttpRequestMessage(HttpMethod.Get, "/api/v1/world/towns"))
+            {
+                badReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", "bad-token");
+                var badResp = await http.SendAsync(badReq);
+                Assert.AreEqual(HttpStatusCode.Unauthorized, badResp.StatusCode);
+            }
+
+            http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
+
+            // All 7 GET endpoints
+            var townsJson = await http.GetStringAsync("/api/v1/world/towns");
+            using (var doc = JsonDocument.Parse(townsJson))
+                Assert.AreEqual(101, doc.RootElement.GetProperty("towns").GetArrayLength());
+
+            Assert.AreEqual(HttpStatusCode.OK, (await http.GetAsync("/api/v1/town/1/ledger")).StatusCode);
+            Assert.AreEqual(HttpStatusCode.OK, (await http.GetAsync("/api/v1/town/1/siege")).StatusCode);
+            Assert.AreEqual(HttpStatusCode.NotFound, (await http.GetAsync("/api/v1/town/99999/ledger")).StatusCode);
+            Assert.AreEqual(HttpStatusCode.NotFound, (await http.GetAsync("/api/v1/town/99999/siege")).StatusCode);
+            Assert.AreEqual(HttpStatusCode.OK, (await http.GetAsync("/api/v1/geology/surveys")).StatusCode);
+            Assert.AreEqual(HttpStatusCode.OK, (await http.GetAsync("/api/v1/logistics/convoys")).StatusCode);
+            Assert.AreEqual(HttpStatusCode.OK, (await http.GetAsync("/api/v1/monarch/orders")).StatusCode);
+
+            var routesResp = await http.GetAsync("/api/v1/logistics/routes");
+            Assert.AreEqual(HttpStatusCode.OK, routesResp.StatusCode);
+            var routesBody = await routesResp.Content.ReadAsStringAsync();
+            Assert.IsFalse(routesBody.Contains("inner_sea", StringComparison.OrdinalIgnoreCase));
+            Assert.IsFalse(routesBody.Contains("port yaraq", StringComparison.OrdinalIgnoreCase));
+
+            // Physical validation parity: non-Monarch rejected with 403
+            var nonMonarchResp = await http.PostAsync("/api/v1/monarch/orders",
+                new StringContent(JsonSerializer.Serialize(new
+                {
+                    actorMonarchId = vassalId,
+                    townId = 1u,
+                    action = "set_tariff",
+                    buyMul = 1.5,
+                    isMonarch = false,
+                }), Encoding.UTF8, "application/json"));
+            Assert.AreEqual(HttpStatusCode.Forbidden, nonMonarchResp.StatusCode);
+
+            // Valid Monarch order succeeds and updates tariff
+            var monarchResp = await http.PostAsync("/api/v1/monarch/orders",
+                new StringContent(JsonSerializer.Serialize(new
+                {
+                    actorGuid = monarchId,
+                    townId = 1u,
+                    action = "set_tariff",
+                    buyMul = 1.25,
+                    sellMul = 0.8,
+                }), Encoding.UTF8, "application/json"));
+            Assert.AreEqual(HttpStatusCode.OK, monarchResp.StatusCode);
+            Assert.AreEqual(1.25f, TownEconomyManager.GetTariffs(1u).BuyMul, 0.01f);
+
+            // Convoy < 1500m / 0 fuel rejected
+            var badConvoyResp = await http.PostAsync("/api/v1/logistics/convoys",
+                new StringContent(JsonSerializer.Serialize(new
+                {
+                    townId = 1u,
+                    originLandblockId = 0xA9B4u,
+                    distanceM = 1499,
+                    fuelLiters = 0,
+                    action = "deliver_siege_supply",
+                }), Encoding.UTF8, "application/json"));
+            Assert.AreEqual(HttpStatusCode.UnprocessableEntity, badConvoyResp.StatusCode);
+
+            // WebSocket unauthenticated rejection
+            using (var unauthWs = new ClientWebSocket())
+            {
+                bool failed = false;
+                try
+                {
+                    await unauthWs.ConnectAsync(new Uri($"ws://127.0.0.1:{port}/ws?token=invalid"), CancellationToken.None);
+                }
+                catch (WebSocketException)
+                {
+                    failed = true;
+                }
+                Assert.IsTrue(failed, "Unauthenticated /ws must reject before upgrade.");
+            }
+
+            // Authenticated WebSocket receives real-time alerts: siege_started, supply_low, convoy_interdicted, town_flipped
+            using var ws = new ClientWebSocket();
+            await ws.ConnectAsync(new Uri($"ws://127.0.0.1:{port}/ws?token={Uri.EscapeDataString(token)}"), CancellationToken.None);
+            Assert.AreEqual(WebSocketState.Open, ws.State);
+
+            var wsDeadline = DateTime.UtcNow.AddSeconds(2);
+            while (AgentGatewayService.WebSocketClientCount == 0 && DateTime.UtcNow < wsDeadline)
+                await Task.Delay(5);
+            Assert.IsTrue(AgentGatewayService.WebSocketClientCount > 0, "Gateway did not register connected WebSocket client in time.");
+
+            var receivedTypes = new List<string>();
+            async Task<string> ReadNextAlertTypeAsync()
+            {
+                var buf = new byte[4096];
+                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(3));
+                var res = await ws.ReceiveAsync(new ArraySegment<byte>(buf), cts.Token);
+                var json = Encoding.UTF8.GetString(buf, 0, res.Count);
+                using var d = JsonDocument.Parse(json);
+                return d.RootElement.GetProperty("type").GetString();
+            }
+
+            // 1) siege_started via SiegeManager breach
+            uint attackerId = AllocGuid();
+            SiegeManager.BeginZeroNoticeBreachForTesting(1u, attackerId, 10_000L);
+            SiegeManager.AdvanceRingHold(1u, attackerId, SiegeManager.BreachGateSec);
+            receivedTypes.Add(await ReadNextAlertTypeAsync());
+
+            // 2) supply_low via SiegeManager meter drop <= 900s
+            SiegeManager.SetSupplyMeterForTesting(1u, 910.0);
+            SiegeManager.TickForTesting(20.0);
+            receivedTypes.Add(await ReadNextAlertTypeAsync());
+
+            // 3) town_flipped via SiegeManager 8h completion (keep meter > 900s each step so supply_low doesn't re-fire)
+            for (int step = 0; step < 7; step++)
+            {
+                SiegeManager.SetSupplyMeterForTesting(1u, 5_400.0);
+                SiegeManager.TickForTesting(4_000.0);
+            }
+            SiegeManager.SetSupplyMeterForTesting(1u, 5_400.0);
+            SiegeManager.TickForTesting(800.0);
+            receivedTypes.Add(await ReadNextAlertTypeAsync());
+
+            // 4) convoy_interdicted via LogisticsEngine (Holtburg 1 -> Cragstone 6 overland)
+            TownEconomyManager.SetTownOwner(1u, monarchId, "CONTROLLED");
+            var convoy = LogisticsEngine.DispatchConvoy(monarchId, 1u, 6u, (byte)VehicleClass.HeavyTractor, out var cErr, initialFuelLiters: 500.0);
+            Assert.IsNotNull(convoy, cErr);
+            var interdictor = CreateTestPlayer(AllocGuid(), 0xA9B40001u, 96f, 96f, 94f, monarchId: attackerId);
+            interdictor.Location = Vehicle.ToPosition(convoy.WorldX, convoy.WorldY, convoy.WorldZ, Quaternion.Identity);
+            Assert.IsTrue(LogisticsEngine.TryInterdictConvoy(convoy.ConvoyId, interdictor, false, out var iErr), iErr);
+            receivedTypes.Add(await ReadNextAlertTypeAsync());
+
+            CollectionAssert.AreEquivalent(
+                new[] { "siege_started", "supply_low", "town_flipped", "convoy_interdicted" },
+                receivedTypes);
+        }
