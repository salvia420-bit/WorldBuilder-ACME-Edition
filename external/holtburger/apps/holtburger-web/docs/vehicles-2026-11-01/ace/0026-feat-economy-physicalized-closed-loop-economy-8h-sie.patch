+            var cellY = Math.Clamp(localY / VertM, 0.0f, 8.0f);
+            var cx0 = (int)MathF.Floor(cellX);
+            var cy0 = (int)MathF.Floor(cellY);
+            var cx1 = Math.Min(cx0 + 1, 8);
+            var cy1 = Math.Min(cy0 + 1, 8);
+            var fx = cellX - (float)cx0;
+            var fy = cellY - (float)cy0;
+            var nearCx = fx < 0.5f ? cx0 : cx1;
+            var nearCy = fy < 0.5f ? cy0 : cy1;
+            var nearT = lbg.Terrain[nearCx * 9 + nearCy];
+            return (nearT >> 2) & 0x1F;
+        }
+
         public const float EarthRadiusM = 6371000.0f;
         public const float DefaultRadarMastHeightM = 3.1f;
         public const float DefaultTargetBeaconHeightM = 1.2f;
