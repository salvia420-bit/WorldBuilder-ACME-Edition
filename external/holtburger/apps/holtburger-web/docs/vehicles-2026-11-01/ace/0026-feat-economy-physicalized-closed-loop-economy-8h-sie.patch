+        public static bool CanTurretUseAirSensor(DeployableBase turret, IAirDefenseSensor sensor)
+        {
+            if (turret == null || sensor == null || !sensor.IsActive)
+                return false;
+
+            var turretMonarch = ResolveTurretEffectiveMonarchId(turret);
+            var station = AirDefenseManager.Stations.FirstOrDefault(s => s.Sensor == sensor);
+            if (station == null)
+            {
+                // Standalone test sensor without RadarStation wrapper: allow if turret has no explicit owner mismatch
+                return true;
+            }
+
+            if (turret.AffiliatedTownId != 0 && station.AffiliatedTownId != 0 && turret.AffiliatedTownId != station.AffiliatedTownId)
+                return false;
+
+            var stationMonarch = station.EffectiveMonarchId;
+            if (turretMonarch == 0 || stationMonarch == 0)
+                return turretMonarch == stationMonarch;
+
+            return turretMonarch == stationMonarch;
+        }
+
+        public static bool CanTurretUseGroundRadar(DeployableBase turret, GroundRadarDeployable radar)
+        {
+            if (turret == null || radar == null || !radar.IsPowered)
+                return false;
+
+            if (turret.AffiliatedTownId != 0 && radar.AffiliatedTownId != 0 && turret.AffiliatedTownId != radar.AffiliatedTownId)
+                return false;
+
+            var turretMonarch = ResolveTurretEffectiveMonarchId(turret);
+            var radarMonarch = radar.EffectiveMonarchId;
+            return turretMonarch == radarMonarch;
+        }
+
+        public static AirTrack? FindNearestHostileForTurret(DeployableBase turret, float maxRange)
+        {
+            if (turret == null)
+                return null;
+
+            var fromPos = turret.GlobalPosition;
+            var turretMonarch = ResolveTurretEffectiveMonarchId(turret);
+            var turretPolicy = turretMonarch != 0 ? RadarIff.GetOrCreateMonarchPolicy(turretMonarch) : null;
+
+            AirTrack? bestTrack = null;
+            float bestDistSq = maxRange * maxRange;
+
+            foreach (var sensor in AirDefenseRegistry.GetAllSensors())
+            {
+                if (!CanTurretUseAirSensor(turret, sensor))
+                    continue;
+
+                foreach (var t in sensor.GetHostileTracks())
+                {
+                    if (turretMonarch != 0 && t.PilotMonarchId.HasValue)
+                    {
+                        var standing = RadarIff.ResolveStanding(
+                            t.PilotGuid, t.PilotMonarchId, null, null,
+                            0u, turretMonarch, null, turretPolicy);
+                        if (standing != IffStanding.Hostile)
+                            continue;
+                    }
+
+                    float dx = t.WorldPos.X - fromPos.X;
+                    float dy = t.WorldPos.Y - fromPos.Y;
+                    float dz = t.WorldPos.Z - fromPos.Z;
+                    float distSq = dx * dx + dy * dy + dz * dz;
+                    if (distSq < bestDistSq)
+                    {
+                        bestDistSq = distSq;
+                        bestTrack = t;
+                    }
+                }
+            }
+
+            return bestTrack;
+        }
