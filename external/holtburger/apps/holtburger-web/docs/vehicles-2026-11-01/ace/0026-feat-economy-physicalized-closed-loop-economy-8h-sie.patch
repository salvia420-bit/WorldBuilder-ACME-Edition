+        private static bool TryConsumePlayerInventoryItem(Player actor, uint wcid, int quantity)
+        {
+            if (actor?.Inventory == null || quantity <= 0)
+                return false;
+
+            if (actor.GetNumInventoryItemsOfWCID(wcid) < quantity)
+                return false;
+
+            if (actor.Session?.Network != null)
+                return actor.TryConsumeFromInventoryWithNetworking(wcid, quantity);
+
+            int remaining = quantity;
+            foreach (var item in actor.GetInventoryItemsOfWCID(wcid))
+            {
+                if (remaining <= 0)
+                    break;
+                int stack = item.StackSize ?? 1;
+                if (stack <= remaining)
+                {
+                    if (!actor.TryRemoveFromInventory(item.Guid, out _))
+                        return false;
+                    try { item.Destroy(false); } catch (NullReferenceException) { }
+                    remaining -= stack;
+                }
+                else
+                {
+                    item.StackSize = stack - remaining;
+                    remaining = 0;
+                }
+            }
+            return remaining == 0;
+        }
