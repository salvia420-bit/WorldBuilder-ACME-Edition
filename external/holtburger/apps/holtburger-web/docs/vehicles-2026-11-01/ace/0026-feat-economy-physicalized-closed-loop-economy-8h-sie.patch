+using System;
+using System.Collections.Generic;
+using ACE.Entity.Enum;
+using ACE.Entity.Enum.Properties;
+using ACE.Server.Vehicles.Deployables;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Economy
+{
+    public enum PerishableCategory : byte
+    {
+        None = 0,
+        BioGlandIchorVenom = 1, // 2-3 h (7,200-10,800 s)
+        DairyAndMeat = 2,       // 3-4 h (10,800-14,400 s)
+        FreshHerb = 3,          // 4-5 h (14,400-18,000 s)
+        FreshHide = 4,          // 5-6 h (18,000-21,600 s)
+    }
+
+    /// <summary>
+    /// Phase C (F12) Cold-Chain Perishable Freshness Decay Engine.
+    /// Uses tick-decremented PropertyFloat values (FreshnessRemainingSec / FreshnessLifetimeSec),
+    /// NEVER wall-clock CreationTimestamp subtraction, so decay freezes at 0.0x inside powered
+    /// 22R1 (4000060) / 45R1 (4000061) Reefers, Marine Terminal Reefer Racks, or M/V Dereth Feeder Bay 06.
+    /// </summary>
+    public static class PerishableDecay
+    {
+        public const double MinAmbientLifetimeSec = 7_200.0;  // 2 hours
+        public const double MaxAmbientLifetimeSec = 21_600.0; // 6 hours
+
+        // 81+ bio-glands / ichor / venom / organic sacs (2-3 h ambient spoilage)
+        private static readonly HashSet<uint> BioGlandIchorVenomWcids = new()
+        {
+            10864, 10865, 10866, 10867, 10869, 10870, 10871, 10872, 10873, 10874,
+            10875, 10876, 10877, 10878, 10879, 10880, 10881, 10882, 10883, 10884,
+            25255, 25256, 25257, 25258, 25259, 25260, 25261, 25262, 25263, 25264,
+            25265, 25266, 25267, 25268, 25269, 25270, 25271, 25272, 25273, 25274,
+            25275, 25276, 25277, 25278, 25279, 25280, 25281, 25282, 25283, 25284,
+            25285, 25286, 25287, 25288, 25289, 25290, 25291, 25292, 25293, 25294,
+            25295, 25296, 25297, 25298, 25299, 25300, 25301, 25302, 25303, 25304,
+            25305, 25306, 25307, 25308, 25309, 25310, 25311, 25312, 25313, 25314,
+            35876, 43907, 43908,
+        };
+
+        private static readonly HashSet<uint> DairyMeatWcids = new()
+        {
+            261, 262, 265, 1446, 1451, 1452, 2463, 4717, 4732, 4742, 5671,
+        };
+
+        private static readonly HashSet<uint> FreshHerbWcids = new()
+        {
+            625, 765, 766, 767, 768, 769, 770, 771, 772, 773, 774, 775, 776, 777, 778, 779, 780, 781,
+        };
+
+        private static readonly HashSet<uint> FreshHideWcids = new()
+        {
+            4232, 4233, 4234, 4235, 4236, 4237, 4238, 4239, 4240, 4241,
+            5892, 8471, 8656, 8657, 8658, 8664, 8674,
+            9258, 9259, 9260, 9261, 9262, 9263,
+            10868, 11339, 11340, 11341, 11342, 12003, 12235,
+            14587, 14589, 23096, 24828,
+        };
+
+        public static IReadOnlyCollection<uint> RegisteredBioGlandWcids => BioGlandIchorVenomWcids;
+
+        /// <summary>
+        /// Pure freshness percentage computation used by E2E and server ticks.
+        /// Powered Reefer freezes decay at 0.0x (returns clamped initialPct).
+        /// </summary>
+        public static double ComputeFreshnessAfter(double initialPct, double ambientLifetimeSec, double elapsedSec, bool isPoweredReefer)
+        {
+            if (!double.IsFinite(initialPct))
+                return 0.0;
+
+            double clampedInitial = Math.Clamp(initialPct, 0.0, 100.0);
+            if (isPoweredReefer)
+                return clampedInitial;
+
+            if (!double.IsFinite(ambientLifetimeSec) || ambientLifetimeSec <= 0.0)
+                return 0.0;
+
+            if (!double.IsFinite(elapsedSec) || elapsedSec <= 0.0)
+                return clampedInitial;
+
+            double pctDrop = (elapsedSec / ambientLifetimeSec) * 100.0;
+            return Math.Clamp(clampedInitial - pctDrop, 0.0, 100.0);
+        }
+
+        public static PerishableCategory Classify(uint wcid, string name = null, WeenieType? weenieType = null)
+        {
+            if (wcid >= 4_000_000u)
+                return PerishableCategory.None;
+
+            if (BioGlandIchorVenomWcids.Contains(wcid))
+                return PerishableCategory.BioGlandIchorVenom;
+
+            if (DairyMeatWcids.Contains(wcid))
+                return PerishableCategory.DairyAndMeat;
+
+            if (FreshHerbWcids.Contains(wcid))
+                return PerishableCategory.FreshHerb;
+
+            if (FreshHideWcids.Contains(wcid))
+                return PerishableCategory.FreshHide;
+
+            if (!string.IsNullOrWhiteSpace(name))
+            {
+                var lower = name.ToLowerInvariant();
+                if (lower.Contains("contract") || lower.Contains("generator") || lower.Contains("treated") ||
+                    lower.Contains("tanned") || lower.Contains("salvaged") || lower.Contains("sealed bag") ||
+                    lower.Contains("dried") || lower.Contains("cured"))
+                {
+                    return PerishableCategory.None;
+                }
+
+                if (lower.Contains("gland") || lower.Contains("ichor") || lower.Contains("venom") || lower.Contains("venom sac"))
+                    return PerishableCategory.BioGlandIchorVenom;
+
+                if (lower.Contains("hide") || lower.Contains("pelt"))
+                    return PerishableCategory.FreshHide;
+
+                if (weenieType == WeenieType.Food &&
+                    (lower.Contains("milk") || lower.Contains("cheese") || lower.Contains("meat") ||
+                     lower.Contains("steak") || lower.Contains("chicken") || lower.Contains("fish")))
+                {
+                    return PerishableCategory.DairyAndMeat;
+                }
+            }
+
+            return PerishableCategory.None;
+        }
+
+        public static double? GetAmbientLifetimeSeconds(uint wcid, string name = null, WeenieType? weenieType = null)
+        {
+            var cat = Classify(wcid, name, weenieType);
+            return cat switch
+            {
+                PerishableCategory.BioGlandIchorVenom => 7_200.0 + (wcid % 37u) * 100.0,  // 7,200 - 10,800 s (2-3 h)
+                PerishableCategory.DairyAndMeat => 10_800.0 + (wcid % 37u) * 100.0,       // 10,800 - 14,400 s (3-4 h)
+                PerishableCategory.FreshHerb => 14_400.0 + (wcid % 37u) * 100.0,          // 14,400 - 18,000 s (4-5 h)
+                PerishableCategory.FreshHide => 18_000.0 + (wcid % 37u) * 100.0,          // 18,000 - 21,600 s (5-6 h)
+                _ => null,
+            };
+        }
+
+        public static double? GetAmbientLifetimeSeconds(WorldObject wo)
+        {
+            if (wo == null) return null;
+            return GetAmbientLifetimeSeconds(wo.WeenieClassId, wo.Name, wo.WeenieType);
+        }
+
+        public static bool IsPerishable(WorldObject wo)
+        {
+            if (wo == null || wo is DeployableBase || wo is Vehicles.Vehicle)
+                return false;
+
+            if (wo.GetProperty(PropertyFloat.FreshnessLifetimeSec).HasValue)
+                return true;
+
+            return GetAmbientLifetimeSeconds(wo).HasValue;
+        }
+
+        public static void EnsureInitialized(WorldObject wo)
+        {
+            if (wo == null || wo is DeployableBase || wo is Vehicles.Vehicle)
+                return;
+
+            var existingLifetime = wo.GetProperty(PropertyFloat.FreshnessLifetimeSec);
+            if (existingLifetime.HasValue)
+            {
+                if (!wo.GetProperty(PropertyFloat.FreshnessRemainingSec).HasValue)
+                    wo.SetProperty(PropertyFloat.FreshnessRemainingSec, existingLifetime.Value);
+                return;
+            }
+
+            var lifetime = GetAmbientLifetimeSeconds(wo);
+            if (!lifetime.HasValue)
+                return;
+
+            wo.SetProperty(PropertyFloat.FreshnessLifetimeSec, lifetime.Value);
+            wo.SetProperty(PropertyFloat.FreshnessRemainingSec, lifetime.Value);
+        }
+
+        public static double GetFreshnessPercent(WorldObject wo)
+        {
+            if (wo == null) return 0.0;
+            EnsureInitialized(wo);
+            var lifetime = wo.GetProperty(PropertyFloat.FreshnessLifetimeSec) ?? 0.0;
+            if (lifetime <= 0.0) return 100.0;
+            var remaining = wo.GetProperty(PropertyFloat.FreshnessRemainingSec) ?? lifetime;
+            return Math.Clamp((remaining / lifetime) * 100.0, 0.0, 100.0);
+        }
+
+        /// <summary>
+        /// Decrements tick-based PropertyFloat freshness unless inside a powered 22R1/45R1 Reefer.
+        /// Returns true if the item has spoiled (FreshnessRemainingSec <= 0).
+        /// </summary>
+        public static bool TickItem(WorldObject wo, double elapsedSeconds, bool isPoweredReefer)
+        {
+            if (wo == null || wo.IsDestroyed)
+                return false;
+
+            if (!IsPerishable(wo))
+                return false;
+
+            EnsureInitialized(wo);
+
+            double lifetime = wo.GetProperty(PropertyFloat.FreshnessLifetimeSec) ?? 0.0;
+            if (lifetime <= 0.0)
+                return false;
+
+            double remaining = wo.GetProperty(PropertyFloat.FreshnessRemainingSec) ?? lifetime;
+            if (isPoweredReefer || !double.IsFinite(elapsedSeconds) || elapsedSeconds <= 0.0)
+            {
+                return remaining <= 0.0;
+            }
+
+            double nextRemaining = Math.Max(0.0, remaining - elapsedSeconds);
+            wo.SetProperty(PropertyFloat.FreshnessRemainingSec, nextRemaining);
+            return nextRemaining <= 0.0;
+        }
+
+        public static bool IsInsidePoweredReefer(WorldObject container, WorldObject rootOwner)
+        {
+            if (container is IsoContainerDeployable ic1 && ic1.IsPoweredReefer)
+                return true;
+            if (rootOwner is IsoContainerDeployable ic2 && ic2.IsPoweredReefer)
+                return true;
+
+            var pos = container?.Location ?? rootOwner?.Location;
+            if (pos != null)
+            {
+                var (gx, gy, gz) = Vehicles.Vehicle.ToGlobal(pos);
+                var pt = new System.Numerics.Vector3((float)gx, (float)gy, (float)gz);
+                foreach (var d in DeployableManager.GetAll())
+                {
+                    if (d is IsoContainerDeployable reefer && reefer.IsPoweredReefer)
+                    {
+                        var rot = reefer.Location != null && reefer.Location.Rotation.LengthSquared() > 1e-6f
+                            ? System.Numerics.Quaternion.Normalize(reefer.Location.Rotation)
+                            : Vehicles.Vehicle.YawOnly(reefer.HeadingRad);
+                        var local = System.Numerics.Vector3.Transform(pt - reefer.Position, System.Numerics.Quaternion.Conjugate(rot));
+                        float halfWidth = Math.Max(1.25f, reefer.ExternalDimensions.X * 0.5f + 0.05f);
+                        float halfLength = reefer.ExternalDimensions.Y > 0.1f
+                            ? reefer.ExternalDimensions.Y * 0.5f + 0.05f
+                            : (reefer.Wcid == IsoContainerDeployable.WcidReefer40HC ? 6.15f : 3.10f);
+                        float height = reefer.ExternalDimensions.Z > 0.1f ? reefer.ExternalDimensions.Z : 2.896f;
+                        if (Math.Abs(local.X) <= halfWidth &&
+                            Math.Abs(local.Y) <= halfLength &&
+                            local.Z >= -0.5f && local.Z <= height + 0.25f)
+                        {
+                            return true;
+                        }
+                    }
+                }
+            }
+
+            return false;
+        }
+    }
+}
