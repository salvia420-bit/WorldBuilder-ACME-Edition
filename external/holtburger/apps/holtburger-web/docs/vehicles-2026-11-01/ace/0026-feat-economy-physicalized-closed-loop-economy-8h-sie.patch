+        private static (int Status, object Payload) ExecuteLogisticsConvoyPost(JsonElement body)
+        {
+            string action = GetJsonString(body, "action", "dispatch").ToLowerInvariant();
+            if (action is "deliver_siege_supply" or "deliver_supply")
+            {
+                uint townId = GetJsonUInt(body, "townId");
+                if (TownEconomyManager.GetTownState(townId) == null)
+                    return (404, new { error = $"Town {townId} not found." });
+
+                uint originLb = GetJsonUInt(body, "originLandblockId");
+                double? distanceM = TryGetJsonDouble(body, "distanceM");
+                double fuelLiters = GetJsonDouble(body, "fuelLiters", 0.0);
+                if (!TryParseOptionalPositiveFiniteDouble(body, "supplyPoints", 10.0, out double supplyPoints))
+                    return (422, new { error = "Convoy delivery rejected: supplyPoints must be a positive finite number." });
+
+                if (!double.IsFinite(fuelLiters) || fuelLiters <= 0.0)
+                    return (422, new { error = "Convoy delivery rejected: fuelLiters must be > 0." });
+
+                if (distanceM.HasValue && (!double.IsFinite(distanceM.Value) || distanceM.Value < SiegeManager.MinProvenanceDistanceM))
+                    return (422, new { error = $"Origin-provenance check failed: distance {distanceM.Value:0.0}m < {SiegeManager.MinProvenanceDistanceM:0}m required." });
+
+                if (!SiegeManager.HasValidSupplyProvenance(originLb, townId))
+                    return (422, new { error = $"Origin-provenance check failed for landblock 0x{originLb:X8}." });
+
+                var actor = ResolveActor(body);
+                if (actor == null)
+                    return (403, new { error = "Physical online player actor required for siege supply delivery." });
+
+                var hydrated = SiegeManager.GetHydratedEntities(townId);
+                if (hydrated != null && hydrated.BeaconGuid != 0 &&
+                    DeployableManager.GetDeployable(hydrated.BeaconGuid) is ForwardSiegeBeaconDeployable beacon &&
+                    !beacon.IsDestroyed && beacon.Location != null && actor.Location != null)
+                {
+                    var (px, py, pz) = Vehicle.ToGlobal(actor.Location);
+                    var dist = Vector3.Distance(beacon.GlobalPosition, new Vector3((float)px, (float)py, (float)pz));
+                    if (dist > ForwardSiegeBeaconDeployable.DeliveryRadiusM)
+                        return (422, new { error = $"Move within {ForwardSiegeBeaconDeployable.DeliveryRadiusM:0}m of Forward Siege Beacon." });
+                }
+
+                if (!SiegeManager.DeliverSiegeSupply(townId, originLb, supplyPoints, actor, out var err))
+                    return (422, new { error = err });
+
+                return (200, new { ok = true, message = err, siege = SiegeManager.GetSiegeState(townId) });
+            }
+
+            var player = ResolveActor(body);
+            if (player == null)
+                return (403, new { error = "Physical online player actor required for convoy orders." });
+
+            if (action == "interdict")
+            {
+                ulong convoyId = GetJsonULong(body, "convoyId");
+                bool capture = GetJsonBool(body, "captureCargo", false);
+                if (!LogisticsEngine.TryInterdictConvoy(convoyId, player, capture, out var err))
+                    return (422, new { error = err });
+                var interdicted = LogisticsEngine.GetConvoy(convoyId);
+                return (200, new { ok = true, convoyId, status = interdicted?.Status.ToString() ?? "Interdicted" });
+            }
+
+            byte wireAction = action switch
+            {
+                "dispatch" => (byte)LogisticsConvoyAction.Dispatch,
+                "abort" => (byte)LogisticsConvoyAction.Abort,
+                "query" => (byte)LogisticsConvoyAction.Query,
+                _ => 0,
+            };
+            if (wireAction == 0)
+                return (400, new { error = $"Unsupported convoy action '{action}'." });
+
+            var order = new LogisticsConvoyOrder
+            {
+                ConvoyId = GetJsonULong(body, "convoyId"),
+                Action = wireAction,
+                VehicleClass = (byte)Math.Clamp(GetJsonUInt(body, "vehicleClass", (uint)VehicleClass.HeavyTractor), 0u, 255u),
+                Flags = (ushort)Math.Clamp(GetJsonUInt(body, "flags"), 0u, 65535u),
+                OriginTownId = GetJsonUInt(body, "originTownId"),
+                DestTownId = GetJsonUInt(body, "destTownId"),
+                ContainerKind = GetJsonUInt(body, "containerKind"),
+                CommodityId = GetJsonUInt(body, "commodityId"),
+            };
+
+            var msg = LogisticsEngine.HandleConvoyOrder(player, order, out var orderErr);
+            if (msg == null)
+                return (422, new { error = orderErr ?? "Convoy order rejected." });
+
+            return (200, new
+            {
+                ok = true,
+                convoyId = msg.ConvoyId,
+                ownerMonarchId = msg.OwnerMonarchId,
+                originTownId = msg.OriginTownId,
+                destTownId = msg.DestTownId,
+                status = ((LogisticsConvoyStatus)msg.Status).ToString(),
+                lodState = ((LogisticsLodState)msg.LodState).ToString(),
+                fuelLiters = msg.FuelLiters,
+                splineSM = msg.SplineSM,
+            });
+        }
+
+        private static (int Status, object Payload) ExecuteMonarchOrderPost(JsonElement body)
+        {
+            string action = GetJsonString(body, "action").ToLowerInvariant();
+            uint townId = GetJsonUInt(body, "townId");
+
+            bool? isMonarchFlag = TryGetJsonBool(body, "isMonarch");
+            if (isMonarchFlag == false && action != "fulfill_order")
+                return (403, new { error = "Rejected: Only the owning Allegiance Monarch may execute town policy orders." });
+
+            var actor = ResolveActor(body);
+            if (actor == null)
+                return (403, new { error = "Rejected: Physical online player actor required." });
+
+            if (action == "fulfill_order")
+            {
+                if (townId == 0 || TownEconomyManager.GetTownState(townId) == null)
+                    return (404, new { error = $"Town {townId} not found." });
+
+                if (!TownCommands.CanExecuteTownLogistics(actor, townId))
+                    return (403, new { error = "Only sworn Allegiance members of the controlling Monarch may fulfill orders in this town." });
+
+                uint itemWcid = GetJsonUInt(body, "itemWcid");
+                uint npcGuid = GetJsonUInt(body, "npcGuid");
+                WorldObject npc = npcGuid != 0 ? actor.CurrentLandblock?.GetObject(new ObjectGuid(npcGuid)) : null;
+                if (npc == null)
+                    return (422, new { error = "Online Trophy Collector NPC within the town is required to fulfill a procurement bounty." });
+
+                if (!TownEconomyManager.IsProcurementDeskNpc(npc))
+                    return (422, new { error = $"{npc.Name} is not a Town Procurement Desk / Trophy Collector NPC." });
+
+                if (TownEconomyManager.ResolveTownId(npc) != townId)
+                    return (422, new { error = $"{npc.Name} does not belong to town {townId}." });
+
+                if (actor.Location == null || npc.Location == null)
+                    return (422, new { error = "Actor and Trophy Collector NPC must both have valid world locations within 15 m." });
+
+                var (ax, ay, az) = Vehicle.ToGlobal(actor.Location);
+                var (nx, ny, nz) = Vehicle.ToGlobal(npc.Location);
+                float npcDistanceM = Vector3.Distance(
+                    new Vector3((float)ax, (float)ay, (float)az),
+                    new Vector3((float)nx, (float)ny, (float)nz));
+                if (npcDistanceM > 15.0f)
+                    return (422, new { error = $"Move within 15 m of {npc.Name} to fulfill a procurement bounty ({npcDistanceM:0.0} m away)." });
+
+                if (itemWcid == 0)
+                    return (422, new { error = "Positive itemWcid is required." });
+
+                var item = actor.GetInventoryItemsOfWCID(itemWcid).FirstOrDefault();
+                if (item == null)
+                    return (422, new { error = $"Actor inventory does not contain WCID {itemWcid}." });
+
+                if (!TownEconomyManager.CanHandleTrophyTurnIn(npc, item, out var precheckErr))
+                    return (422, new { error = precheckErr });
+
+                if (!TryConsumeOneTrophyUnit(actor, item, out var removedWholeItem, out int originalStackSize, out var consumeErr))
+                    return (422, new { error = consumeErr });
+
+                var turnInItem = removedWholeItem ?? item;
+                if (!TownEconomyManager.TryHandleTrophyTurnInForPlayer(npc, turnInItem, actor.Guid.Full, out var payout, out var feedback, 1))
+                {
+                    RefundOneTrophyUnit(actor, item, removedWholeItem, originalStackSize);
+                    return (422, new { error = feedback });
+                }
+
+                if (removedWholeItem != null)
+                {
+                    if (actor.Session?.Network != null)
+                        removedWholeItem.Destroy();
+                    else
+                    {
+                        try { removedWholeItem.Destroy(false); } catch (NullReferenceException) { }
+                    }
+                }
+
+                if (payout > 0)
+                    GrantPyrealsToPlayer(actor, payout);
+
+                return (200, new { ok = true, payoutPyreals = payout, message = feedback });
+            }
+
+            if (action == "transfer_treasury")
+            {
+                uint fromTownId = GetJsonUInt(body, "fromTownId", townId);
+                uint toTownId = GetJsonUInt(body, "toTownId");
+                long amount = GetJsonLong(body, "amount");
+                if (!TownCommands.CanModifyTownPolicy(actor, fromTownId) || !TownCommands.CanModifyTownPolicy(actor, toTownId))
+                    return (403, new { error = "Rejected: Only the Allegiance Monarch owning both towns may transfer treasury funds." });
+                uint monarchId = TownCommands.ResolveEffectiveMonarchId(actor);
+                if (!TownEconomyManager.TryTransferTreasury(fromTownId, toTownId, monarchId, amount, out var err))
+                    return (422, new { error = err });
+                return (200, new { ok = true, fromTownId, toTownId, amount });
+            }
+
+            if (action == "set_price")
+            {
+                if (townId == 0 || TownEconomyManager.GetTownState(townId) == null)
+                    return (404, new { error = $"Town {townId} not found." });
+                if (!TownCommands.CanModifyTownPolicy(actor, townId))
+                    return (403, new { error = "Rejected: Only the owning Allegiance Monarch may set vendor prices." });
+                uint vendorGuid = GetJsonUInt(body, "vendorGuid");
+                uint itemWcid = GetJsonUInt(body, "itemWcid");
+                if (vendorGuid == 0 || itemWcid == 0)
+                    return (400, new { error = "vendorGuid and itemWcid are required." });
+
+                int? priceOverride;
+                bool clearRequested = GetJsonBool(body, "clear", false);
+                JsonElement unitPriceEl = default;
+                bool hasUnitPriceProp = body.ValueKind == JsonValueKind.Object && body.TryGetProperty("unitPrice", out unitPriceEl);
+                if (clearRequested || (hasUnitPriceProp && unitPriceEl.ValueKind == JsonValueKind.Null))
+                {
+                    priceOverride = null;
+                }
+                else if (hasUnitPriceProp && unitPriceEl.ValueKind == JsonValueKind.Number && unitPriceEl.TryGetInt64(out long up))
+                {
+                    if (up <= 0)
+                        return (422, new { error = "unitPrice must be a positive integer (pass unitPrice: null or clear: true to clear override)." });
+                    priceOverride = (int)Math.Min(int.MaxValue, up);
+                }
+                else
+                {
+                    return (422, new { error = "set_price requires a positive integer unitPrice, unitPrice: null, or clear: true." });
+                }
+
+                TownEconomyManager.SetVendorPriceOverride(townId, vendorGuid, itemWcid, priceOverride);
+                return (200, new { ok = true, townId, vendorGuid, itemWcid, unitPriceOverride = priceOverride });
+            }
+
+            if (action == "set_tariff")
+            {
+                if (townId == 0 || TownEconomyManager.GetTownState(townId) == null)
+                    return (404, new { error = $"Town {townId} not found." });
+                if (!TownCommands.CanModifyTownPolicy(actor, townId))
+                    return (403, new { error = "Rejected: Only the owning Allegiance Monarch may modify tariffs." });
+
+                var (curBuy, curSell) = TownEconomyManager.GetTariffs(townId);
+                float buyMul = (float)GetJsonDouble(body, "buyMul", curBuy);
+                float sellMul = (float)GetJsonDouble(body, "sellMul", curSell);
+                TownEconomyManager.SetTownTariffs(townId, buyMul, sellMul);
+                var (actualBuy, actualSell) = TownEconomyManager.GetTariffs(townId);
+                return (200, new { ok = true, townId, tariffBuyMul = actualBuy, tariffSellMul = actualSell });
+            }
+
+            byte orderAction = action switch
+            {
+                "create_bounty" => 1,
+                "cancel_bounty" => 2,
+                "set_till_cap" => 4,
+                "set_diplomacy" => 5,
+                _ => 0,
+            };
+            if (orderAction == 0)
+                return (400, new { error = $"Unsupported monarch order action '{action}'." });
+
+            if (orderAction is 1 or 2 or 4 && townId != 0 && TownEconomyManager.GetTownState(townId) == null)
+                return (404, new { error = $"Town {townId} not found." });
+
+            if ((orderAction is 1 or 2 or 4 && !TownCommands.CanModifyTownPolicy(actor, townId)) ||
+                (orderAction == 5 && !TownCommands.IsAllegianceMonarch(actor)))
+            {
+                return (403, new { error = "Rejected: Only the owning Allegiance Monarch may modify town orders." });
+            }
+
+            ulong rewardOrCapPyreals = GetJsonULong(body, "rewardPyreals");
+            if (orderAction == 4)
+            {
+                if (body.ValueKind != JsonValueKind.Object ||
+                    !body.TryGetProperty("tillCapPyreals", out var capEl) ||
+                    capEl.ValueKind != JsonValueKind.Number ||
+                    !capEl.TryGetInt64(out long tillCap) ||
+                    tillCap < 0)
+                {
+                    return (422, new { error = "set_till_cap requires a non-negative integer tillCapPyreals." });
+                }
+                rewardOrCapPyreals = (ulong)tillCap;
+            }
+
+            var msg = new EconomyMonarchOrder
+            {
+                OrderId = GetJsonULong(body, "orderId"),
+                TownId = townId,
+                Action = orderAction,
+                TargetGuid = GetJsonUInt(body, "targetMonarchId"),
+                ItemWcid = GetJsonUInt(body, "itemWcid"),
+                Quantity = GetJsonUInt(body, "quantity", GetJsonUInt(body, "standing")),
+                RewardPyreals = rewardOrCapPyreals,
+                ParamF32 = (float)GetJsonDouble(body, "value", 1.0),
+            };
+
+            var reply = TownEconomyManager.HandleMonarchOrderAction(actor, msg, out var orderErr);
+            if (reply == null)
+                return (422, new { error = orderErr ?? "Monarch order rejected." });
+
+            return (200, new
+            {
+                ok = true,
+                orderId = reply.OrderId,
+                monarchId = reply.MonarchId,
+                townId = reply.TownId,
+                orderType = reply.OrderType,
+                status = reply.Status,
+                itemWcid = reply.ItemWcid,
+                quantity = reply.Quantity,
+                rewardPyreals = reply.RewardPyreals,
+            });
+        }
+
+        private static Player ResolveActor(JsonElement body)
+        {
+            uint actorGuid = GetJsonUInt(body, "actorGuid", GetJsonUInt(body, "playerGuid", GetJsonUInt(body, "monarchId", GetJsonUInt(body, "actorMonarchId"))));
+            if (actorGuid == 0)
+                return null;
+
+            if (TestActorResolver != null)
+            {
+                var testActor = TestActorResolver(actorGuid);
+                if (testActor != null)
+                    return testActor;
+            }
+
+            try
+            {
+                var online = PlayerManager.GetOnlinePlayer(actorGuid);
+                if (online != null)
+                    return online;
+
+                foreach (var p in PlayerManager.GetAllOnline())
+                {
+                    if (p != null && p.Guid.Full == actorGuid)
+                        return p;
+                }
+            }
+            catch { }
+
+            return null;
+        }
+
+        private static bool TryConsumeOneTrophyUnit(
+            Player actor,
+            WorldObject item,
+            out WorldObject removedWholeItem,
+            out int originalStackSize,
+            out string error)
+        {
+            removedWholeItem = null;
+            originalStackSize = item?.StackSize ?? 1;
+            error = null;
+
+            if (actor == null || item == null)
+            {
+                error = "Actor and item required.";
+                return false;
+            }
+
+            bool wasStacked = originalStackSize > 1;
+            if (actor.Session?.Network != null)
+            {
+                if (wasStacked)
+                {
+                    if (!actor.TryConsumeFromInventoryWithNetworking(item, 1))
+                    {
+                        error = $"Failed to consume 1x WCID {item.WeenieClassId} from inventory.";
+                        return false;
+                    }
+                    return true;
+                }
+
+                if (!actor.TryRemoveFromInventoryWithNetworking(item.Guid, out removedWholeItem, Player.RemoveFromInventoryAction.GiveItem))
+                {
+                    error = $"Failed to remove WCID {item.WeenieClassId} from inventory.";
+                    return false;
+                }
+                return true;
+            }
+
+            if (wasStacked)
+            {
+                int nextStack = originalStackSize - 1;
+                item.SetStackSize(nextStack);
+                if ((item.StackSize ?? 0) != nextStack)
+                    item.StackSize = nextStack;
+                return true;
+            }
+
+            if (!actor.TryRemoveFromInventory(item.Guid, out removedWholeItem))
+            {
+                error = $"Failed to remove WCID {item.WeenieClassId} from inventory.";
+                return false;
+            }
+            return true;
+        }
+
+        private static void RefundOneTrophyUnit(Player actor, WorldObject item, WorldObject removedWholeItem, int originalStackSize)
+        {
+            if (actor == null || item == null)
+                return;
+
+            if (actor.Session?.Network != null)
+            {
+                if (removedWholeItem != null)
+                {
+                    if (!actor.TryCreateInInventoryWithNetworking(removedWholeItem))
+                        removedWholeItem.Destroy();
+                    return;
+                }
+
+                WorldObject refundStack = null;
+                if (DatabaseManager.World != null)
+                {
+                    try { refundStack = WorldObjectFactory.CreateNewWorldObject(item.WeenieClassId); }
+                    catch { refundStack = null; }
+                }
+                if (refundStack != null)
+                {
+                    refundStack.SetStackSize(1);
+                    if (!actor.TryCreateInInventoryWithNetworking(refundStack))
+                        refundStack.Destroy();
+                }
+                return;
+            }
+
+            if (removedWholeItem != null)
+            {
+                if (!actor.TryAddToInventory(removedWholeItem, out _, burdenCheck: false))
+                {
+                    try { removedWholeItem.Destroy(false); } catch (NullReferenceException) { }
+                }
+                return;
+            }
+
+            item.SetStackSize(originalStackSize);
+            if ((item.StackSize ?? 0) != originalStackSize)
+                item.StackSize = originalStackSize;
+        }
+
+        private static void GrantPyrealsToPlayer(Player actor, long totalPyreals)
+        {
+            if (actor == null || totalPyreals <= 0)
+                return;
+
+            long remaining = totalPyreals;
+            while (remaining > 0)
+            {
+                WorldObject coinStack = null;
+                if (DatabaseManager.World != null)
+                {
+                    try { coinStack = WorldObjectFactory.CreateNewWorldObject(TownEconomyManager.PyrealWcid); }
+                    catch { coinStack = null; }
+                }
+
+                if (coinStack == null)
+                {
+                    ObjectGuid coinGuid;
+                    try { coinGuid = GuidManager.NewDynamicGuid(); }
+                    catch (NullReferenceException) { coinGuid = new ObjectGuid(Interlocked.Increment(ref _fallbackCoinGuid)); }
+
+                    var coinWeenie = new ACE.Entity.Models.Weenie
+                    {
+                        WeenieClassId = TownEconomyManager.PyrealWcid,
+                        ClassName = "coinstack",
+                        WeenieType = WeenieType.Coin,
+                        PropertiesInt = new Dictionary<PropertyInt, int>
+                        {
+                            [PropertyInt.ItemType] = (int)ItemType.Money,
+                            [PropertyInt.Value] = 1,
+                            [PropertyInt.MaxStackSize] = 25_000,
+                            [PropertyInt.StackSize] = 1,
+                            [PropertyInt.StackUnitValue] = 1,
+                        },
+                        PropertiesString = new Dictionary<PropertyString, string>
+                        {
+                            [PropertyString.Name] = "Pyreal",
+                            [PropertyString.PluralName] = "Pyreals",
+                        },
+                        PropertiesBool = new Dictionary<PropertyBool, bool>(),
+                        PropertiesFloat = new Dictionary<PropertyFloat, double>(),
+                        PropertiesDID = new Dictionary<PropertyDataId, uint>(),
+                        PropertiesInt64 = new Dictionary<PropertyInt64, long>(),
+                    };
+                    coinStack = new Stackable(coinWeenie, coinGuid);
+                }
+
+                int maxStack = coinStack.MaxStackSize ?? 25_000;
+                int stackAmt = (int)Math.Min(remaining, maxStack);
+                coinStack.SetStackSize(stackAmt);
+
+                if (actor.Session?.Network != null)
+                {
+                    if (!actor.TryCreateInInventoryWithNetworking(coinStack))
+                        coinStack.Destroy();
+                }
+                else
+                {
+                    if (!actor.TryAddToInventory(coinStack, out _, burdenCheck: false))
+                    {
+                        try { coinStack.Destroy(false); } catch (NullReferenceException) { }
+                    }
+                    else
+                    {
+                        actor.CoinValue = actor.GetInventoryItemsOfTypeWeenieType(WeenieType.Coin).Sum(c => c.Value ?? 0);
+                    }
+                }
+
+                remaining -= stackAmt;
+            }
+        }
+
+        private static async Task HandleWebSocketAsync(HttpListenerContext ctx, CancellationToken ct)
+        {
+            EnsureSubscribed();
+            HttpListenerWebSocketContext wsCtx;
+            try
+            {
+                wsCtx = await ctx.AcceptWebSocketAsync(null).ConfigureAwait(false);
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[AGENT_GATEWAY] WebSocket upgrade failed: {ex.Message}");
+                return;
+            }
+
+            var ws = wsCtx.WebSocket;
+            var id = Guid.NewGuid();
+            _wsClients[id] = ws;
+
+            var recvBuf = new byte[1024];
+            try
+            {
+                while (!ct.IsCancellationRequested && ws.State == WebSocketState.Open)
+                {
+                    var result = await ws.ReceiveAsync(new ArraySegment<byte>(recvBuf), ct).ConfigureAwait(false);
+                    if (result.MessageType == WebSocketMessageType.Close)
+                    {
+                        await ws.CloseAsync(WebSocketCloseStatus.NormalClosure, "Closing", CancellationToken.None).ConfigureAwait(false);
+                        break;
+                    }
+                }
+            }
+            catch { }
+            finally
+            {
+                _wsClients.TryRemove(id, out _);
+                try { ws.Dispose(); } catch { }
+            }
+        }
+
+        private static void OnSiegeAlertRaised(uint townId, string eventType, string message)
+        {
+            var normalized = string.IsNullOrWhiteSpace(eventType) ? "siege_alert" : eventType;
+            BroadcastAlertPayload(normalized, townId, 0UL, 0u, 0u, message ?? "");
+        }
+
+        private static void OnConvoyInterdicted(ulong convoyId, uint interdictorMonarchId, uint originLandblockId)
+        {
+            var convoy = LogisticsEngine.GetConvoy(convoyId);
+            uint townId = convoy?.DestTownId ?? 0u;
+            BroadcastAlertPayload("convoy_interdicted", townId, convoyId, interdictorMonarchId, originLandblockId,
+                $"Convoy #{convoyId} interdicted by Monarch {interdictorMonarchId}.");
+        }
+
+        internal static void BroadcastAlertPayload(
+            string alertType,
+            uint townId,
+            ulong convoyId,
+            uint actorMonarchId,
+            uint originLandblockId,
+            string message)
+        {
+            if (_wsClients.IsEmpty)
+                return;
+
+            var json = JsonSerializer.Serialize(new
+            {
+                type = alertType,
+                @event = alertType,
+                alertType,
+                townId,
+                convoyId,
+                actorMonarchId,
+                originLandblockId,
+                message,
+                timestampUtc = DateTime.UtcNow.ToString("O"),
+            }, JsonOpts);
+
+            var bytes = Encoding.UTF8.GetBytes(json);
+            _ = Task.Run(async () =>
+            {
+                await _wsSendLock.WaitAsync().ConfigureAwait(false);
+                try
+                {
+                    foreach (var kvp in _wsClients.ToArray())
+                    {
+                        var ws = kvp.Value;
+                        if (ws.State != WebSocketState.Open)
+                        {
+                            _wsClients.TryRemove(kvp.Key, out _);
+                            try { ws.Dispose(); } catch { }
+                            continue;
+                        }
+                        try
+                        {
+                            await ws.SendAsync(new ArraySegment<byte>(bytes), WebSocketMessageType.Text, true, CancellationToken.None).ConfigureAwait(false);
+                        }
+                        catch
+                        {
+                            _wsClients.TryRemove(kvp.Key, out _);
+                            try { ws.Dispose(); } catch { }
+                        }
+                    }
+                }
+                finally
+                {
+                    _wsSendLock.Release();
+                }
+            });
+        }
+
+        private static bool TryMatchTownSubRoute(string path, string suffix, out uint townId)
+        {
+            townId = 0;
+            const string prefix = "/api/v1/town/";
+            if (!path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
+                return false;
+
+            var rest = path[prefix.Length..];
+            var slashIdx = rest.IndexOf('/');
+            if (slashIdx <= 0)
+                return false;
+
+            var idPart = rest[..slashIdx];
+            var tailPart = rest[(slashIdx + 1)..];
+            return string.Equals(tailPart, suffix, StringComparison.OrdinalIgnoreCase) &&
+                   uint.TryParse(idPart, out townId);
+        }
+
+        private static async Task WriteJsonAsync(HttpListenerResponse resp, int statusCode, object payload, CancellationToken ct)
+        {
+            byte[] bytes = Encoding.UTF8.GetBytes(JsonSerializer.Serialize(payload, JsonOpts));
+            resp.StatusCode = statusCode;
+            resp.ContentType = "application/json; charset=utf-8";
+            resp.ContentLength64 = bytes.Length;
+            await resp.OutputStream.WriteAsync(bytes, 0, bytes.Length, ct).ConfigureAwait(false);
+            resp.OutputStream.Close();
+        }
+
+        private static string GetJsonString(JsonElement el, string prop, string fallback = "")
+            => el.ValueKind == JsonValueKind.Object && el.TryGetProperty(prop, out var v) && v.ValueKind == JsonValueKind.String
+                ? (v.GetString() ?? fallback)
+                : fallback;
+
+        private static uint GetJsonUInt(JsonElement el, string prop, uint fallback = 0u)
+        {
+            if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(prop, out var v))
+                return fallback;
+            if (v.ValueKind == JsonValueKind.Number && v.TryGetUInt32(out var r))
+                return r;
+            if (v.ValueKind == JsonValueKind.String && uint.TryParse(v.GetString(), out var rs))
+                return rs;
+            return fallback;
+        }
+
+        private static ulong GetJsonULong(JsonElement el, string prop, ulong fallback = 0UL)
+        {
+            if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(prop, out var v))
+                return fallback;
+            if (v.ValueKind == JsonValueKind.Number && v.TryGetUInt64(out var r))
+                return r;
+            if (v.ValueKind == JsonValueKind.String && ulong.TryParse(v.GetString(), out var rs))
+                return rs;
+            return fallback;
+        }
+
+        private static long GetJsonLong(JsonElement el, string prop, long fallback = 0L)
+            => TryGetJsonLong(el, prop) ?? fallback;
+
+        private static long? TryGetJsonLong(JsonElement el, string prop)
+        {
+            if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(prop, out var v))
+                return null;
+            if (v.ValueKind == JsonValueKind.Number && v.TryGetInt64(out var r))
+                return r;
+            if (v.ValueKind == JsonValueKind.String && long.TryParse(v.GetString(), out var rs))
+                return rs;
+            return null;
+        }
+
+        private static double GetJsonDouble(JsonElement el, string prop, double fallback = 0.0)
+            => TryGetJsonDouble(el, prop) ?? fallback;
+
+        private static double? TryGetJsonDouble(JsonElement el, string prop)
+        {
+            if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(prop, out var v))
+                return null;
+            if (v.ValueKind == JsonValueKind.Number && v.TryGetDouble(out var r))
+                return r;
+            return null;
+        }
+
+        private static bool TryParseOptionalPositiveFiniteDouble(JsonElement el, string prop, double fallback, out double value)
+        {
+            value = fallback;
+            if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(prop, out var v))
+                return true;
+            if (v.ValueKind != JsonValueKind.Number || !v.TryGetDouble(out value))
+                return false;
+            return double.IsFinite(value) && value > 0.0;
+        }
+
+        private static bool GetJsonBool(JsonElement el, string prop, bool fallback = false)
+            => TryGetJsonBool(el, prop) ?? fallback;
+
+        private static bool? TryGetJsonBool(JsonElement el, string prop)
+        {
+            if (el.ValueKind != JsonValueKind.Object || !el.TryGetProperty(prop, out var v))
+                return null;
+            return v.ValueKind switch
+            {
+                JsonValueKind.True => true,
+                JsonValueKind.False => false,
+                _ => null,
+            };
+        }
+    }
+}
