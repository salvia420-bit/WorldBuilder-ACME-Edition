+        public static void Initialize()
+        {
+            lock (initLock)
+            {
+                SeedInMemoryLocked();
+
+                var shardDb = DatabaseManager.Shard?.BaseDatabase;
+                if (shardDb != null)
+                {
+                    try
+                    {
+                        var seedRows = towns.Values.Select(t => CloneControl(t.Control)).ToList();
+                        var (controls, ledgers, warehouses) = shardDb.SeedAndLoadTownEconomy(seedRows);
+
+                        foreach (var ctrl in controls)
+                        {
+                            if (towns.TryGetValue(ctrl.TownId, out var state))
+                            {
+                                lock (state.SyncRoot)
+                                    state.Control = CloneControl(ctrl);
+                            }
+                        }
+
+                        foreach (var ledger in ledgers)
+                        {
+                            if (towns.TryGetValue(ledger.TownId, out var state))
+                            {
+                                lock (state.SyncRoot)
+                                    state.Ledgers[(ledger.VendorGuid, ledger.ItemWcid)] = CloneLedger(ledger);
+                            }
+                        }
+
+                        foreach (var wh in warehouses)
+                        {
+                            if (towns.TryGetValue(wh.TownId, out var state))
+                            {
+                                lock (state.SyncRoot)
+                                    state.Warehouses[(wh.CommodityId, wh.GradeBps, wh.PoweredReefer)] = CloneWarehouse(wh);
+                            }
+                        }
+
+                        var loadedOrders = shardDb.LoadMonarchOrders();
+                        ulong maxOrderId = 0;
+                        foreach (var ord in loadedOrders)
+                        {
+                            if (ord == null || ord.OrderId == 0) continue;
+                            if (ord.OrderId > maxOrderId) maxOrderId = ord.OrderId;
+                            var cloned = CloneMonarchOrder(ord);
+                            monarchOrders[cloned.OrderId] = cloned;
+
+                            if (string.Equals(cloned.Status, "Open", StringComparison.OrdinalIgnoreCase) &&
+                                cloned.RemainingQty > 0 &&
+                                cloned.ItemWcid != 0 &&
+                                towns.TryGetValue(cloned.TownId, out var state))
+                            {
+                                lock (state.SyncRoot)
+                                {
+                                    state.Bounties[cloned.ItemWcid] = new ProcurementBounty
+                                    {
+                                        OrderId = cloned.OrderId,
+                                        MonarchId = cloned.MonarchId,
+                                        TownId = cloned.TownId,
+                                        ItemWcid = cloned.ItemWcid,
+                                        CommodityId = string.IsNullOrWhiteSpace(cloned.CommodityId) ? $"trophy_{cloned.ItemWcid}" : cloned.CommodityId,
+                                        RewardPyreals = Math.Max(0L, cloned.RewardPyreals),
+                                        TargetQty = Math.Max(0, cloned.TargetQty),
+                                        RemainingQty = Math.Max(0, cloned.RemainingQty),
+                                        CreatedUtc = cloned.CreatedUtc,
+                                    };
+                                }
+                            }
+                        }
+                        if (maxOrderId > (ulong)Interlocked.Read(ref _nextOrderId))
+                            Interlocked.Exchange(ref _nextOrderId, (long)Math.Min(long.MaxValue, maxOrderId));
+
+                        log.Info($"[ECONOMY] TownEconomyManager initialized with {towns.Count} towns and {monarchOrders.Count} monarch orders from ace_shard.");
+                    }
+                    catch (Exception ex)
+                    {
+                        log.Warn($"[ECONOMY] TownEconomyManager fell back to in-memory seeding: {ex.Message}");
+                    }
+                }
+
+                initialized = true;
+            }
+            GeologyService.Initialize();
+        }
