+        private static async Task HandlePostAsync(string path, JsonElement body, HttpListenerResponse resp, CancellationToken ct)
+        {
+            if (TryMatchTownSubRoute(path, "siege", out uint siegeTownId))
+            {
+                var (status, payload) = await DispatchOnWorldThreadAsync(() => ExecuteTownSiegePost(siegeTownId, body), ct).ConfigureAwait(false);
+                await WriteJsonAsync(resp, status, payload, ct).ConfigureAwait(false);
+                return;
+            }
+
+            if (string.Equals(path, "/api/v1/geology/surveys", StringComparison.OrdinalIgnoreCase))
+            {
+                var (status, payload) = await DispatchOnWorldThreadAsync(() => ExecuteGeologySurveyPost(body), ct).ConfigureAwait(false);
+                await WriteJsonAsync(resp, status, payload, ct).ConfigureAwait(false);
+                return;
+            }
+
+            if (string.Equals(path, "/api/v1/industry/facilities", StringComparison.OrdinalIgnoreCase))
+            {
+                var (status, payload) = await DispatchOnWorldThreadAsync(() => ExecuteIndustryFacilityPost(body), ct).ConfigureAwait(false);
+                await WriteJsonAsync(resp, status, payload, ct).ConfigureAwait(false);
+                return;
+            }
+
+            if (string.Equals(path, "/api/v1/logistics/convoys", StringComparison.OrdinalIgnoreCase))
+            {
+                var (status, payload) = await DispatchOnWorldThreadAsync(() => ExecuteLogisticsConvoyPost(body), ct).ConfigureAwait(false);
+                await WriteJsonAsync(resp, status, payload, ct).ConfigureAwait(false);
+                return;
+            }
+
+            if (string.Equals(path, "/api/v1/monarch/orders", StringComparison.OrdinalIgnoreCase))
+            {
+                var (status, payload) = await DispatchOnWorldThreadAsync(() => ExecuteMonarchOrderPost(body), ct).ConfigureAwait(false);
+                await WriteJsonAsync(resp, status, payload, ct).ConfigureAwait(false);
+                return;
+            }
+
+            await WriteJsonAsync(resp, 404, new { error = $"Unknown endpoint {path}" }, ct).ConfigureAwait(false);
+        }
