+        private static void DetachMismatchedVehicleForSwap(LogisticsConvoyState convoy)
+        {
+            Vehicle toDespawn;
+            lock (convoy.SyncRoot)
+            {
+                byte expectedClass = GetExpectedActiveVehicleClass(convoy);
+                if (convoy.ActiveVehicle == null || convoy.ActiveVehicle.IsDestroyed ||
+                    convoy.ActiveVehicle.Profile.VehicleClass == expectedClass)
+                {
+                    return;
+                }
+                toDespawn = convoy.ActiveVehicle;
+                convoy.ActiveVehicle = null;
+                convoy.VehicleGuid = 0;
+                convoy.LodState = LogisticsLodState.Macro;
+            }
+            if (toDespawn != null)
+            {
+                try { VehicleManager.Despawn(toDespawn, "convoy-mode-switch"); } catch { }
+            }
+        }
+
+        private static void MaterializeMicroLod(LogisticsConvoyState convoy)
+        {
+            if (!VehicleManager.Enabled)
+                return;
+
+            byte expectedVehicleClass;
+            double worldX, worldY, worldZ, headingRad;
+            uint ownerMonarchId;
+            string ownerMonarchName;
+            lock (convoy.SyncRoot)
+            {
+                if (convoy.Status != LogisticsConvoyStatus.EnRoute && convoy.Status != LogisticsConvoyStatus.OutOfFuel)
+                    return;
+                if (convoy.LodState == LogisticsLodState.Micro && convoy.ActiveVehicle != null && !convoy.ActiveVehicle.IsDestroyed)
+                    return;
+
+                expectedVehicleClass = GetExpectedActiveVehicleClass(convoy);
+                worldX = convoy.WorldX;
+                worldY = convoy.WorldY;
+                worldZ = expectedVehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder ? 0.0 : convoy.WorldZ;
+                headingRad = convoy.HeadingRad;
+                ownerMonarchId = convoy.OwnerMonarchId;
+                ownerMonarchName = convoy.OwnerMonarchName ?? "";
+            }
+
+            if (worldY >= LandblockManager.OceanCorridorYMin && worldY < LandblockManager.OceanCorridorYMax)
+                expectedVehicleClass = (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder;
+
+            var profile = expectedVehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder
+                ? VehicleProfile.ContainerShipFeeder()
+                : VehicleProfile.Semi379();
+
+            var v = VehicleManager.SpawnAutonomous(
+                profile,
+                worldX,
+                worldY,
+                worldZ,
+                headingRad,
+                out var err,
+                ownerMonarchId,
+                ownerMonarchName);
+
+            if (v == null)
+            {
+                log.Debug($"[LOGISTICS] Micro-LOD materialization skipped for convoy {convoy.ConvoyId}: {err}");
+                return;
+            }
+
+            bool abortSpawn = false;
+            double postX, postY;
+            lock (convoy.SyncRoot)
+            {
+                byte currentExpected = GetExpectedActiveVehicleClass(convoy);
+                if ((convoy.Status != LogisticsConvoyStatus.EnRoute && convoy.Status != LogisticsConvoyStatus.OutOfFuel) ||
+                    (convoy.ActiveVehicle != null && !convoy.ActiveVehicle.IsDestroyed) ||
+                    v.Profile.VehicleClass != currentExpected)
+                {
+                    abortSpawn = true;
+                    postX = convoy.WorldX;
+                    postY = convoy.WorldY;
+                }
+                else
+                {
+                    v.OwnerMonarchId = convoy.OwnerMonarchId;
+                    v.OwnerMonarchName = convoy.OwnerMonarchName ?? "";
+                    v.FuelLiters = (float)convoy.FuelLiters;
+                    convoy.ActiveVehicle = v;
+                    convoy.VehicleGuid = v.Guid.Full;
+                    convoy.LodState = LogisticsLodState.Micro;
+                    if (convoy.AttachedContainer != null &&
+                        v.Profile.VehicleClass == (byte)ACE.Server.Vehicles.VehicleClass.ContainerShipFeeder &&
+                        IsoContainerDeployable.IsReeferWcid(convoy.AttachedContainer.Wcid))
+                    {
+                        v.DockReeferInBay06(convoy.AttachedContainer);
+                    }
+                    SyncActiveVehiclePoseLocked(convoy);
+                    postX = convoy.WorldX;
+                    postY = convoy.WorldY;
+                }
+            }
+
+            if (abortSpawn)
+            {
+                try { VehicleManager.Despawn(v, "micro-lod-aborted-race"); } catch { }
+                return;
+            }
+
+            if ((postY >= LandblockManager.OceanCorridorYMin && postY < LandblockManager.OceanCorridorYMax) || v.PhysicsObj == null)
+            {
+                VehicleManager.SyncOceanCorridorObservers(v, MicroLodRadiusM);
+            }
+            else
+            {
+                KeepConvoyLandblockActive(postX, postY);
+            }
+            PersistConvoy(convoy);
+        }
