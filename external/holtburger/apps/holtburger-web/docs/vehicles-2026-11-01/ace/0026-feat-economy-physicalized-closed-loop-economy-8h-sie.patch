+        /// <summary>
+        /// Checks whether an EmoteCategory.Give set is a repeatable (Quest == null) coin/Trade Note emitter.
+        /// </summary>
+        public static bool IsRepeatableCoinEmote(PropertiesEmote emoteSet, out uint rewardWcid, out int rewardAmount)
+        {
+            rewardWcid = 0;
+            rewardAmount = 0;
+
+            if (emoteSet == null || !string.IsNullOrEmpty(emoteSet.Quest))
+                return false;
+
+            if (emoteSet.PropertiesEmoteAction == null)
+                return false;
+
+            foreach (var action in emoteSet.PropertiesEmoteAction)
+            {
+                if ((EmoteType)action.Type == EmoteType.Give && action.WeenieClassId.HasValue && IsCoinOrTradeNoteWcid(action.WeenieClassId.Value))
+                {
+                    rewardWcid = action.WeenieClassId.Value;
+                    rewardAmount = Math.Max(1, action.StackSize ?? 1);
+                    return true;
+                }
+            }
+            return false;
+        }
