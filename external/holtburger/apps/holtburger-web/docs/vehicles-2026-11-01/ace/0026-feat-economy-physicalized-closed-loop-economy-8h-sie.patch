+        public void F15_ReeferRackBay_4000055_DeterministicSameTickPowerSync()
+        {
+            for (int order = 0; order < 2; order++)
+            {
+                DeployableManager.Clear();
+                DeployableManager.EnterWorldOverrideForTesting = _ => true;
+                var portPos = Vehicle.ToPosition(44960.0, 47860.0, 2.0, Quaternion.Identity);
