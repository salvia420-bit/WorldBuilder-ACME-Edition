+        public static string FindDefaultPath()
+        {
+            var envPath = System.Environment.GetEnvironmentVariable("HB_LOGISTICS_NAV_GRAPH");
+            if (!string.IsNullOrWhiteSpace(envPath) && File.Exists(envPath))
+                return envPath;
+
+            var envLegacy = System.Environment.GetEnvironmentVariable("HB_NAV_GRAPH_PATH");
+            if (!string.IsNullOrWhiteSpace(envLegacy) && File.Exists(envLegacy))
+                return envLegacy;
+
+            var holtDist = System.Environment.GetEnvironmentVariable("HOLTBURGER_DIST");
+            if (!string.IsNullOrWhiteSpace(holtDist))
+            {
+                var p = Path.Combine(holtDist, "world", "logistics_nav_graph.json");
+                if (File.Exists(p))
+                    return p;
+            }
+
+            var baseDir = AppContext.BaseDirectory;
+            var directCandidates = new[]
+            {
+                Path.Combine(baseDir, "logistics_nav_graph.json"),
+                Path.Combine(baseDir, "Data", "logistics_nav_graph.json"),
+                Path.Combine(baseDir, "data", "logistics_nav_graph.json"),
+            };
+            foreach (var c in directCandidates)
+            {
+                if (File.Exists(c))
+                    return c;
+            }
+
+            var dir = baseDir;
+            for (int i = 0; i < 10 && !string.IsNullOrEmpty(dir); i++)
+            {
+                var probes = new[]
+                {
+                    Path.Combine(dir, "WorldBuilder-ACME-Edition", "external", "holtburger", "apps", "holtburger-web", "data", "logistics_nav_graph.json"),
+                    Path.Combine(dir, "WorldBuilder-ACME-Edition", "external", "holtburger", "dist", "world", "logistics_nav_graph.json"),
+                    Path.Combine(dir, "external", "holtburger", "apps", "holtburger-web", "data", "logistics_nav_graph.json"),
+                    Path.Combine(dir, "external", "holtburger", "dist", "world", "logistics_nav_graph.json"),
+                    Path.Combine(dir, "hb-serve", "dist", "current", "world", "logistics_nav_graph.json"),
+                };
+                foreach (var p in probes)
+                {
+                    if (File.Exists(p))
+                        return p;
+                }
+                dir = Directory.GetParent(dir)?.FullName;
+            }
+
+            var osFallbacks = new[]
+            {
+                "/workspace/wb/hb-serve/dist/current/world/logistics_nav_graph.json",
+                "/home/wbterminal/WorldBuilder-ACME-Edition/external/holtburger/apps/holtburger-web/data/logistics_nav_graph.json",
+                "/workspace/wb/home/WorldBuilder-ACME-Edition/external/holtburger/apps/holtburger-web/data/logistics_nav_graph.json",
+            };
+            foreach (var fb in osFallbacks)
+            {
