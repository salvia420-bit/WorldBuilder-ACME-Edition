+        /// <summary>
+        /// Syncs any positive persisted town_vendor_ledger entries for a vendor into its DefaultItemsForSale
+        /// when the world weenie cache and shard DB are active.
+        /// </summary>
+        public static void SyncVendorDefaultListings(Vendor vendor)
+        {
+            if (vendor == null) return;
+            EnsureInitialized();
+            var townId = ResolveTownId(vendor);
+            if (townId == 0) return;
+
+            var state = GetTownState(townId);
+            if (state == null) return;
+
+            var wcids = new List<uint>();
+            lock (state.SyncRoot)
+            {
+                foreach (var kvp in state.Ledgers)
+                {
+                    if (kvp.Key.vendorGuid == vendor.Guid.Full && kvp.Value.StockQty > 0)
+                        wcids.Add(kvp.Key.itemWcid);
+                }
+            }
+
+            foreach (var wcid in wcids)
+                vendor.EnsureBoughtBackDefaultListing(wcid);
+        }
