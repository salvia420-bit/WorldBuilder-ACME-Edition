+        private static int ReadApproachVendorNumItems(Session session, Vendor vendor)
+        {
+            var evt = new GameEventApproachVendor(session, vendor, 0);
+            var bytes = evt.Data.ToArray();
+            // GameEventApproachVendor binary format after GameEvent header (Guid 4, EventType 4):
+            // Wait: use BinaryReader to locate vendor.Guid.Full then skip fixed fields:
+            // vendor.Guid (4), MerchItemTypes (4), MinVal (4), MaxVal (4), DealMagic (4), BuyPrice (4), SellPrice (4), AltCurrency (4), AltCount (4), String16L, numItems (4)
+            using var ms = new MemoryStream(bytes);
+            using var br = new BinaryReader(ms);
+            // GameEventMessage writes: MessageOpcode(4) + PlayerGuid(4) + Sequence(4) + EventType(4) = 16 bytes? Let's search for vendor.Guid.Full to be exact!
+            var target = BitConverter.GetBytes(vendor.Guid.Full);
+            int idx = -1;
+            for (int i = 0; i <= bytes.Length - 4; i++)
+            {
+                if (bytes[i] == target[0] && bytes[i + 1] == target[1] && bytes[i + 2] == target[2] && bytes[i + 3] == target[3])
+                {
+                    idx = i;
+                    break;
+                }
+            }
+            Assert.IsTrue(idx >= 0, "Vendor Guid not found in GameEventApproachVendor payload");
+            ms.Position = idx + 4 + 4 + 4 + 4 + 4 + 4 + 4 + 4 + 4; // skip vendorGuid + 8 uint/float fields
+            ushort strLen = br.ReadUInt16();
+            int paddedLen = ((2 + strLen + 3) / 4) * 4;
+            ms.Position = idx + 36 + paddedLen;
+            return br.ReadInt32();
+        }
+
+        private static (int NumItems, List<int> PackedQuantities) ReadApproachVendorPayload(Session session, Vendor vendor)
+        {
+            var evt = new GameEventApproachVendor(session, vendor, 0);
+            var bytes = evt.Data.ToArray();
+            var target = BitConverter.GetBytes(vendor.Guid.Full);
+            int idx = -1;
+            for (int i = 0; i <= bytes.Length - 4; i++)
+            {
+                if (bytes[i] == target[0] && bytes[i + 1] == target[1] && bytes[i + 2] == target[2] && bytes[i + 3] == target[3])
+                {
+                    idx = i;
+                    break;
+                }
+            }
+            Assert.IsTrue(idx >= 0);
+            using var ms = new MemoryStream(bytes);
+            using var br = new BinaryReader(ms);
+            ms.Position = idx + 36;
+            ushort strLen = br.ReadUInt16();
+            int paddedLen = ((2 + strLen + 3) / 4) * 4;
+            ms.Position = idx + 36 + paddedLen;
+            int numItems = br.ReadInt32();
+            var qtys = new List<int>();
+            if (numItems > 0 && ms.Position + 4 <= ms.Length)
+            {
+                int packed = br.ReadInt32();
+                int qty = packed & 0xFFFFFF;
+                qtys.Add(qty);
+            }
+            return (numItems, qtys);
+        }
