+using System;
+using System.Collections.Generic;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.Economy;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Promoted Outer Ocean Marine Terminal infrastructure deployables (WCID 4000051-4000057, DeployableKind 23-29).
+    /// Excluded from ace_shard biota persistence via WorldObject_Database (WeenieClassId >= 4_000_000u).
+    /// </summary>
+    public class MarineTerminalDeployable : DeployableBase
+    {
+        public const uint WcidStsGantryCrane = 4_000_051;
+        public const uint WcidRmgYardCrane = 4_000_052;
+        public const uint WcidRtgYardCrane = 4_000_053;
+        public const uint WcidTerminalTractorShuttle = 4_000_054;
+        public const uint WcidReeferRackBay = 4_000_055;
+        public const uint WcidQuayBollard = 4_000_056;
+        public const uint WcidMarineFender = 4_000_057;
+
+        public readonly List<uint> DockedReeferGuids = new List<uint>();
+
+        public override bool ConnectsToMicroGrid =>
+            Wcid is WcidStsGantryCrane or WcidRmgYardCrane or WcidRtgYardCrane or WcidReeferRackBay;
+
+        public override float PowerWatts =>
+            (!IsPacked && IsActive && !IsStowed) ? Math.Max(0f, IndustryManager.GetPowerSpecWatts(Wcid)) : 0f;
+
+        public MarineTerminalDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = weenie.WeenieClassId switch
+            {
+                WcidStsGantryCrane => DeployableKind.StsGantryCrane,
+                WcidRmgYardCrane => DeployableKind.RmgYardCrane,
+                WcidRtgYardCrane => DeployableKind.RtgYardCrane,
+                WcidTerminalTractorShuttle => DeployableKind.TerminalTractorShuttle,
+                WcidReeferRackBay => DeployableKind.ReeferRackBay,
+                WcidQuayBollard => DeployableKind.QuayBollard,
+                WcidMarineFender => DeployableKind.MarineFender,
+                _ => throw new ArgumentOutOfRangeException(nameof(weenie)),
+            };
+            Pallet = PalletSize.None;
+            if (Wcid == WcidReeferRackBay || Wcid == WcidStsGantryCrane || Wcid == WcidRmgYardCrane || Wcid == WcidRtgYardCrane)
+                OnlineFlags = 0;
+        }
+
+        public static Weenie BuildWeenie(uint wcid, Vehicle parentVehicle = null, Player deployer = null) => wcid switch
+        {
+            WcidStsGantryCrane => BuildDeployableWeenie(wcid, "hbport_sts_crane", "Ship-to-Shore (STS) Gantry Crane", "Outer Ocean port container gantry crane (120 kW)."),
+            WcidRmgYardCrane => BuildDeployableWeenie(wcid, "hbport_rmg_crane", "Rail-Mounted Gantry (RMG) Yard Crane", "Automated port yard stacking gantry crane (80 kW)."),
+            WcidRtgYardCrane => BuildDeployableWeenie(wcid, "hbport_rtg_crane", "Rubber-Tired Gantry (RTG) Yard Crane", "Port container yard crane (45 kW)."),
+            WcidTerminalTractorShuttle => BuildDeployableWeenie(wcid, "hbport_yard_shuttle", "Terminal Tractor Yard Shuttle", "Quay-to-stack horizontal ISO container shuttle."),
+            WcidReeferRackBay => BuildDeployableWeenie(wcid, "hbport_reefer_rack", "3-Tier Reefer Rack Bay", "Powered shore-power rack bay (18 kW) freezing docked 22R1/45R1 Reefers at 0.0x decay."),
+            WcidQuayBollard => BuildDeployableWeenie(wcid, "hbport_quay_bollard", "Quay Mooring Bollard", "Heavy-duty marine mooring bollard."),
+            WcidMarineFender => BuildDeployableWeenie(wcid, "hbport_marine_fender", "Marine Arch Fender", "Elastic quay fender protecting vessel hulls."),
+            _ => BuildDeployableWeenie(wcid, "hbport_unit", "Marine Terminal Unit", "Outer Ocean Marine Terminal infrastructure."),
+        };
+
+        public bool DockReefer(IsoContainerDeployable reefer)
+        {
+            if (Wcid != WcidReeferRackBay || IsDestroyed || IsPacked)
+                return false;
+            if (reefer == null || reefer.IsDestroyed || !IsoContainerDeployable.IsReeferWcid(reefer.Wcid))
+                return false;
+
+            if (!DockedReeferGuids.Contains(reefer.Guid.Full))
+                DockedReeferGuids.Add(reefer.Guid.Full);
+
+            reefer.ExternalReeferPowerConnected = IsPowered;
+            return true;
+        }
+
+        public bool UndockReefer(IsoContainerDeployable reefer)
+        {
+            if (reefer == null)
+                return false;
+            bool removed = DockedReeferGuids.Remove(reefer.Guid.Full);
+            reefer.ExternalReeferPowerConnected = false;
+            return removed;
+        }
+
+        public void SyncDockedReefers()
+        {
+            if (Wcid != WcidReeferRackBay)
+                return;
+
+            bool shorePowerActive = !IsDestroyed && !IsPacked && IsActive && IsPowered;
+            for (int i = DockedReeferGuids.Count - 1; i >= 0; i--)
+            {
+                var guid = DockedReeferGuids[i];
+                var reefer = DeployableManager.GetDeployable(guid) as IsoContainerDeployable;
+                if (reefer == null || reefer.IsDestroyed || reefer.IsPacked)
+                {
+                    DockedReeferGuids.RemoveAt(i);
+                    continue;
+                }
+                reefer.ExternalReeferPowerConnected = shorePowerActive;
+            }
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+            if (Wcid == WcidReeferRackBay)
+                SyncDockedReefers();
+        }
+
+        public override void Destroy(bool raiseNotifyOfDestructionEvent = true, bool fromLandblockUnload = false)
+        {
+            if (Wcid == WcidReeferRackBay)
+            {
+                foreach (var guid in DockedReeferGuids)
+                {
+                    if (DeployableManager.GetDeployable(guid) is IsoContainerDeployable reefer && !reefer.IsDestroyed)
+                        reefer.ExternalReeferPowerConnected = false;
+                }
+                DockedReeferGuids.Clear();
+            }
+            base.Destroy(raiseNotifyOfDestructionEvent, fromLandblockUnload);
+        }
+    }
+}
