@@ -0,0 +1,394 @@
+using System;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// Surface-water vessel state in AC world metres (X, Y, Z up; Heading compass rad [0, 2π)).
+    /// Mirrors ship_kinematics.js / port_specs.js (M/V Dereth Feeder HLTB-FC-120).
+    /// </summary>
+    public struct MarineState
+    {
+        public double X, Y, Z;
+        public double Heading;
+        public double Pitch;
+        public double Roll;
+        public double SurgeU;
+        public double SwayV;
+        public double YawRateR;
+        public double HeaveVel;
+        public double PitchVel;
+        public double RollVel;
+        public double Throttle;
+        public double RudderRad;
+        public double TargetRudderRad;
+        public double BowThruster;
+        public double SternThruster;
+        public double Speed;
+        public double WaterDepthM;
+        public double UkcM;
+        public double TimeSec;
+        public int Mode;
+        public bool Moored;
+        public bool Grounded;
+        public bool FenderContact;
+
+        public FlightState ToFlightState() => new FlightState
+        {
+            X = X,
+            Y = Y,
+            Z = Z,
+            Heading = Heading,
+            Pitch = Pitch,
+            Bank = Roll,
+            Speed = Speed,
+            Mode = Mode,
+        };
+
+        public static MarineState FromFlightState(in FlightState s) => new MarineState
+        {
+            X = s.X,
+            Y = s.Y,
+            Z = s.Z,
+            Heading = s.Heading,
+            Pitch = s.Pitch,
+            Roll = s.Bank,
+            Speed = s.Speed,
+            SurgeU = s.Speed,
+            Mode = s.Mode,
+        };
+    }
+
+    public struct MarineInput
+    {
+        public double Throttle;
+        public double TargetRudderRad;
+        public double BowThruster;
+        public double SternThruster;
+
+        public static MarineInput FromFrame(in VehicleInputFrame f)
+        {
+            double thr = (f.Throttle == 0 && f.Pitch != 0)
+                ? VehicleInputFrame.Stick(f.Pitch)
+                : f.Throttle / 255.0;
+            double steer = VehicleInputFrame.Stick(f.Yaw != 0 ? f.Yaw : f.Roll);
+            double maxRudder = 35.0 * Math.PI / 180.0;
+            bool bowOrStern = (f.Buttons & VehicleInputFrame.ButtonLowRange) != 0;
+
+            return new MarineInput
+            {
+                Throttle = Math.Clamp(thr, -1.0, 1.0),
+                TargetRudderRad = Math.Clamp(steer * maxRudder, -maxRudder, maxRudder),
+                BowThruster = bowOrStern ? Math.Clamp(steer, -1.0, 1.0) : 0.0,
+                SternThruster = 0.0,
+            };
+        }
+    }
+
+    public sealed class MarineParams
+    {
+        public double MassKg = 950_000.0;
+        public double YawInertiaKgM2 = 1.8e8;
+        public double MaxAheadThrustN = 520_000.0;
+        public double MaxAsternThrustN = 360_000.0;
+        public double BowThrusterMaxN = 270_000.0;
+        public double SternThrusterMaxN = 270_000.0;
+        public double MaxSpeedMps = 6.2;
+        public double MaxReverseMps = -3.2;
+        public double MaxSwayMps = 1.8;
+        public double MaxYawRateRadSec = 0.24;
+        public double SurgeQuadDrag = 11_800.0;
+        public double SurgeLinDrag = 10_000.0;
+        public double SwayQuadDrag = 110_000.0;
+        public double SwayLinDrag = 90_000.0;
+        public double YawQuadDrag = 2.0e8;
+        public double YawLinDrag = 9.5e7;
+        public double RudderLiftCoeff = 22_000.0;
+        public double PropWashKickN = 160_000.0;
+        public double MaxRudderRad = 35.0 * Math.PI / 180.0;
+        public double RudderRateRadSec = 18.0 * Math.PI / 180.0;
+        public double BowThrusterY = 31.0;
+        public double SternThrusterY = -31.0;
+        public double RudderY = -36.8;
+        public double DraftM = 3.80;
+        public double HalfBeamM = 7.2;
+        public double HalfLoaM = 39.0;
+
+        public static MarineParams FromProfile(VehicleProfile p)
+        {
+            var mp = new MarineParams();
+            if (p != null)
+            {
+                if (p.VMax > 0f) mp.MaxSpeedMps = p.VMax;
+                if (p.ReverseMax < 0f) mp.MaxReverseMps = p.ReverseMax;
+                if (p.YawRate > 0f) mp.MaxYawRateRadSec = p.YawRate;
+            }
+            return mp;
+        }
+    }
+
+    /// <summary>
+    /// 3+3 wave-locked Marine hydrodynamics and buoyancy matching port_specs.js & ship_kinematics.js.
+    /// </summary>
+    public static class MarineModel
+    {
+        public const int SimHz = 30;
+        public const double Dt = 1.0 / SimHz;
+        public const double FairwayDepthM = 12.0;
+        public const double ShallowDepthM = 6.6;
+
+        public static bool IsNavigableWaterCode(int terrainCode)
+            => terrainCode < 0 || terrainCode == 20 || terrainCode == 18 || terrainCode == 19;
+
+        public static double WaterSwellAt(double x, double y, double t)
+        {
+            double wx = double.IsFinite(x) ? x : 0.0;
+            double wy = double.IsFinite(y) ? y : 0.0;
+            double ts = double.IsFinite(t) ? t : 0.0;
+            return Math.Sin(ts * 0.5 + wx * 0.045) * 0.15 + Math.Sin(ts * 0.7 + wy * 0.062) * 0.10;
+        }
+
+        public static double WaterSwellLattice(double x, double y, double t)
+        {
+            double wx = double.IsFinite(x) ? x : 0.0;
+            double wy = double.IsFinite(y) ? y : 0.0;
+            double ts = double.IsFinite(t) ? t : 0.0;
+            double c0x = Math.Floor(wx / 24.0) * 24.0;
+            double c0y = Math.Floor(wy / 24.0) * 24.0;
+            double fx = (wx - c0x) / 24.0;
+            double fy = (wy - c0y) / 24.0;
+            double s00 = WaterSwellAt(c0x, c0y, ts);
+            double s10 = WaterSwellAt(c0x + 24.0, c0y, ts);
+            double s01 = WaterSwellAt(c0x, c0y + 24.0, ts);
+            double s11 = WaterSwellAt(c0x + 24.0, c0y + 24.0, ts);
+            double s0 = s00 + (s10 - s00) * fx;
+            double s1 = s01 + (s11 - s01) * fx;
+            return s0 + (s1 - s0) * fy;
+        }
+
+        public static (double vx, double vy, double vz) Velocity(in MarineState s)
+        {
+            double sin = Math.Sin(s.Heading);
+            double cos = Math.Cos(s.Heading);
+            double vx = s.SurgeU * sin + s.SwayV * cos;
+            double vy = s.SurgeU * cos - s.SwayV * sin;
+            return (vx, vy, s.HeaveVel);
+        }
+
+        private static (double wx, double wy) LocalToWorld2D(double lx, double ly, double x, double y, double heading)
+        {
+            double s = Math.Sin(heading);
+            double c = Math.Cos(heading);
+            return (x + lx * c + ly * s, y - lx * s + ly * c);
+        }
+
+        public static void Step(
+            ref MarineState s,
+            in MarineInput u,
+            MarineParams p,
+            Func<double, double, int> terrainCodeLookup,
+            double dt = Dt,
+            bool swellEnabled = true)
+        {
+            p ??= new MarineParams();
+            if (!double.IsFinite(dt) || dt <= 0.0)
+                return;
+
+            // Sanitize any pre-existing non-finite state before integration
+            if (!double.IsFinite(s.X)) s.X = 0.0;
+            if (!double.IsFinite(s.Y)) s.Y = 0.0;
+            if (!double.IsFinite(s.Z)) s.Z = 0.0;
+            if (!double.IsFinite(s.Heading)) s.Heading = 0.0;
+            if (!double.IsFinite(s.Pitch)) s.Pitch = 0.0;
+            if (!double.IsFinite(s.Roll)) s.Roll = 0.0;
+            if (!double.IsFinite(s.SurgeU)) s.SurgeU = 0.0;
+            if (!double.IsFinite(s.SwayV)) s.SwayV = 0.0;
+            if (!double.IsFinite(s.YawRateR)) s.YawRateR = 0.0;
+            if (!double.IsFinite(s.HeaveVel)) s.HeaveVel = 0.0;
+            if (!double.IsFinite(s.PitchVel)) s.PitchVel = 0.0;
+            if (!double.IsFinite(s.RollVel)) s.RollVel = 0.0;
+            if (!double.IsFinite(s.Throttle)) s.Throttle = 0.0;
+            if (!double.IsFinite(s.RudderRad)) s.RudderRad = 0.0;
+            if (!double.IsFinite(s.TargetRudderRad)) s.TargetRudderRad = 0.0;
+            if (!double.IsFinite(s.BowThruster)) s.BowThruster = 0.0;
+            if (!double.IsFinite(s.SternThruster)) s.SternThruster = 0.0;
+            if (!double.IsFinite(s.TimeSec)) s.TimeSec = 0.0;
+
+            const double MaxSubStepDt = 0.05;
+            double totalDt = Math.Min(dt, 10.0);
+            int subSteps = Math.Max(1, (int)Math.Ceiling(totalDt / MaxSubStepDt));
+            double subDt = totalDt / subSteps;
+
+            for (int step = 0; step < subSteps; step++)
+            {
+                StepSingle(ref s, in u, p, terrainCodeLookup, subDt, swellEnabled);
+            }
+        }
+
+        private static void StepSingle(
+            ref MarineState s,
+            in MarineInput u,
+            MarineParams p,
+            Func<double, double, int> terrainCodeLookup,
+            double dt,
+            bool swellEnabled)
+        {
+            double cmdThrottle = Math.Clamp(double.IsFinite(u.Throttle) ? u.Throttle : s.Throttle, -1.0, 1.0);
+            double cmdRudder = Math.Clamp(double.IsFinite(u.TargetRudderRad) ? u.TargetRudderRad : s.TargetRudderRad, -p.MaxRudderRad, p.MaxRudderRad);
+            double cmdBow = Math.Clamp(double.IsFinite(u.BowThruster) ? u.BowThruster : 0.0, -1.0, 1.0);
+            double cmdStern = Math.Clamp(double.IsFinite(u.SternThruster) ? u.SternThruster : 0.0, -1.0, 1.0);
+
+            s.Throttle = FlightModel.MoveToward(s.Throttle, cmdThrottle, 1.6 * dt);
+            s.TargetRudderRad = cmdRudder;
+            s.RudderRad = FlightModel.MoveToward(s.RudderRad, cmdRudder, p.RudderRateRadSec * dt);
+            s.BowThruster = FlightModel.MoveToward(s.BowThruster, cmdBow, 3.5 * dt);
+            s.SternThruster = FlightModel.MoveToward(s.SternThruster, cmdStern, 3.5 * dt);
+
+            double prevX = s.X;
+            double prevY = s.Y;
+
+            if (s.Moored)
+            {
+                s.SurgeU = FlightModel.MoveToward(s.SurgeU, 0.0, 2.0 * dt);
+                s.SwayV = FlightModel.MoveToward(s.SwayV, 0.0, 2.0 * dt);
+                s.YawRateR = FlightModel.MoveToward(s.YawRateR, 0.0, 1.0 * dt);
+                s.FenderContact = true;
+                s.Grounded = false;
+            }
+            else
+            {
+                double fProp = s.Throttle >= 0.0
+                    ? s.Throttle * p.MaxAheadThrustN
+                    : s.Throttle * p.MaxAsternThrustN;
+
+                double rudderSin = Math.Sin(s.RudderRad);
+                double flowFactor = s.SurgeU * Math.Abs(s.SurgeU);
+                double washForce = Math.Max(0.0, s.Throttle) * p.PropWashKickN * rudderSin;
+                double rudderSideN = -(flowFactor * p.RudderLiftCoeff * rudderSin + washForce);
+                double rudderYawNm = -rudderSideN * Math.Abs(p.RudderY);
+
+                double fBowN = s.BowThruster * p.BowThrusterMaxN;
+                double fSternN = s.SternThruster * p.SternThrusterMaxN;
+
+                double dragSurgeN = p.SurgeLinDrag * s.SurgeU + p.SurgeQuadDrag * s.SurgeU * Math.Abs(s.SurgeU);
+                double dragSwayN = p.SwayLinDrag * s.SwayV + p.SwayQuadDrag * s.SwayV * Math.Abs(s.SwayV);
+                double dragYawNm = p.YawLinDrag * s.YawRateR + p.YawQuadDrag * s.YawRateR * Math.Abs(s.YawRateR);
+
+                double m = p.MassKg;
+                double iz = p.YawInertiaKgM2;
+                double fSurgeTotal = fProp - dragSurgeN + m * s.SwayV * s.YawRateR * 0.25;
+                double fSwayTotal = fBowN + fSternN + rudderSideN * 0.15 - dragSwayN - m * s.SurgeU * s.YawRateR * 0.25;
+                double tauYawTotal = fBowN * p.BowThrusterY + fSternN * p.SternThrusterY + rudderYawNm - dragYawNm;
+
+                s.SurgeU = Math.Clamp(s.SurgeU + (fSurgeTotal / m) * dt, p.MaxReverseMps, p.MaxSpeedMps);
+                s.SwayV = Math.Clamp(s.SwayV + (fSwayTotal / m) * dt, -p.MaxSwayMps, p.MaxSwayMps);
+                s.YawRateR = Math.Clamp(s.YawRateR + (tauYawTotal / iz) * dt, -p.MaxYawRateRadSec, p.MaxYawRateRadSec);
+
+                double sinH = Math.Sin(s.Heading);
+                double cosH = Math.Cos(s.Heading);
+                double vx = s.SurgeU * sinH + s.SwayV * cosH;
+                double vy = s.SurgeU * cosH - s.SwayV * sinH;
+
+                s.X += vx * dt;
+                s.Y += vy * dt;
+                s.Heading = FlightModel.WrapHeading(s.Heading + s.YawRateR * dt);
+
+                // Water terrain & hull grounding guard (code 20 = deep water, 18/19 = shallow)
+                s.Grounded = false;
+                s.FenderContact = false;
+                if (terrainCodeLookup != null)
+                {
+                    double halfB = p.HalfBeamM;
+                    double halfL = p.HalfLoaM * 0.90;
+                    Span<(double lx, double ly)> hullPts = stackalloc (double, double)[]
+                    {
+                        (-halfB, +halfL), (+halfB, +halfL),
+                        (-halfB, 0.0),    (+halfB, 0.0),
+                        (-halfB, -halfL), (+halfB, -halfL),
+                    };
+
+                    bool hitDryLand = false;
+                    foreach (var (lx, ly) in hullPts)
+                    {
+                        var (wx, wy) = LocalToWorld2D(lx, ly, s.X, s.Y, s.Heading);
+                        int code = terrainCodeLookup(wx, wy);
+                        if (!IsNavigableWaterCode(code))
+                        {
+                            hitDryLand = true;
+                            break;
+                        }
+                    }
+
+                    if (hitDryLand)
+                    {
+                        s.Grounded = true;
+                        s.X = prevX;
+                        s.Y = prevY;
+                        s.SurgeU *= 0.1;
+                        s.SwayV *= 0.1;
+                        s.YawRateR *= 0.2;
+                    }
+                }
+
+                s.X = Math.Clamp(s.X, FlightModel.WorldXMin + 40.0, FlightModel.WorldXMax - 40.0);
+                s.Y = Math.Clamp(s.Y, FlightModel.WorldYMin + 40.0, FlightModel.WorldYMax - 40.0);
+            }
+
+            // 3-DOF wave-locked buoyancy (heave Z around water level 0.0, pitch, roll)
+            double t = s.TimeSec;
+            double targetZ = 0.0;
+            double targetPitch = 0.0;
+            double targetRoll = 0.0;
+
+            if (swellEnabled)
+            {
+                double damp = s.Moored ? 0.35 : 1.0;
+                var (bx, by) = LocalToWorld2D(0.0, +32.0, s.X, s.Y, s.Heading);
+                var (sx, sy) = LocalToWorld2D(0.0, -32.0, s.X, s.Y, s.Heading);
+                var (rx, ry) = LocalToWorld2D(+6.5, 0.0, s.X, s.Y, s.Heading);
+                var (px, py) = LocalToWorld2D(-6.5, 0.0, s.X, s.Y, s.Heading);
+                double zBow = WaterSwellLattice(bx, by, t);
+                double zStern = WaterSwellLattice(sx, sy, t);
+                double zStbd = WaterSwellLattice(rx, ry, t);
+                double zPort = WaterSwellLattice(px, py, t);
+
+                targetZ = 0.25 * (zBow + zStern + zStbd + zPort) * damp;
+                targetPitch = Math.Atan2(zBow - zStern, 64.0) * damp;
+                targetRoll = Math.Atan2(zPort - zStbd, 13.0) * damp;
+            }
+
+            targetRoll += Math.Clamp(-s.SurgeU * s.YawRateR * 0.06, -0.055, 0.055);
+
+            const double kHeave = 14.0, cHeave = 6.5;
+            s.HeaveVel = Math.Clamp(s.HeaveVel + ((targetZ - s.Z) * kHeave - s.HeaveVel * cHeave) * dt, -10.0, 10.0);
+            s.Z = Math.Clamp(s.Z + s.HeaveVel * dt, -5.0, 5.0);
+
+            const double kPitch = 9.0, cPitch = 5.2;
+            s.PitchVel = Math.Clamp(s.PitchVel + ((targetPitch - s.Pitch) * kPitch - s.PitchVel * cPitch) * dt, -5.0, 5.0);
+            s.Pitch = Math.Clamp(s.Pitch + s.PitchVel * dt, -0.18, 0.18);
+
+            const double kRoll = 7.5, cRoll = 4.6;
+            s.RollVel = Math.Clamp(s.RollVel + ((targetRoll - s.Roll) * kRoll - s.RollVel * cRoll) * dt, -5.0, 5.0);
+            s.Roll = Math.Clamp(s.Roll + s.RollVel * dt, -0.22, 0.22);
+
+            double sF = Math.Sin(s.Heading);
+            double cF = Math.Cos(s.Heading);
+            double vxOut = s.SurgeU * sF + s.SwayV * cF;
+            double vyOut = s.SurgeU * cF - s.SwayV * sF;
+            s.Speed = Math.Sqrt(vxOut * vxOut + vyOut * vyOut);
+
+            int centerCode = terrainCodeLookup != null ? terrainCodeLookup(s.X, s.Y) : 20;
+            s.WaterDepthM = centerCode switch
+            {
+                < 0 => FairwayDepthM,
+                20 => FairwayDepthM,
+                18 or 19 => ShallowDepthM,
+                _ => 0.0,
+            };
+            s.UkcM = Math.Max(0.0, s.WaterDepthM - p.DraftM);
+            s.Mode = (!s.Moored && (s.Speed > 0.05 || (double.IsFinite(u.Throttle) && Math.Abs(u.Throttle) > 0.01)))
+                ? VehicleMode.Driving
+                : VehicleMode.Parked;
+            s.TimeSec += dt;
+        }
+    }
+}
