+        /// <summary>
+        /// Town Mint (4000093, 30 kW): converts Pyreal Bars (6329), Quality Pyreal Ingots (6331),
+        /// or Pyreal Motes (6353) into Town Treasury pyreals (and optional physical Pyreal 273 coins).
+        /// </summary>
+        public static bool TryMintBullion(
+            TownMintDeployable mint,
+            Player actor,
+            uint townId,
+            uint bullionWcid,
+            int quantity,
+            bool depositToTreasury,
+            out long mintedPyreals,
+            out string error)
+        {
+            mintedPyreals = 0;
+            error = null;
+
+            if (mint == null || mint.IsDestroyed || mint.IsPacked || mint.IsStowed)
+            {
+                error = "Town Mint is unavailable.";
+                return false;
+            }
+            if (!HasAvailableMicroGridPower(mint))
+            {
+                error = "Town Mint (30 kW) is browned out.";
+                return false;
+            }
+            if (quantity <= 0)
+            {
+                error = "Quantity must be positive.";
+                return false;
+            }
+
+            uint tid = townId != 0 ? townId : mint.AffiliatedTownId;
+            if (tid == 0)
+            {
+                error = "Town Mint is not bound to a registered town.";
+                return false;
+            }
+
+            if (actor != null && !TownCommands.CanExecuteTownLogistics(actor, tid))
+            {
+                error = "Only sworn Allegiance members of the controlling Monarch may operate this Town Mint.";
+                return false;
+            }
+
+            var townState = TownEconomyManager.GetTownState(tid);
+            if (townState == null)
+            {
+                error = $"Town {tid} not found.";
+                return false;
+            }
+            lock (townState.SyncRoot)
+            {
+                if (townState.Control.State is "CONTESTED_HOLD" or "STARVING")
+                {
+                    error = "Town Mint operations are suspended while the town is under siege.";
+                    return false;
+                }
+            }
+
+            long ratePerUnit = bullionWcid switch
+            {
+                PyrealBarWcid => PyrealsPerBar,
+                QualityPyrealIngotWcid => PyrealsPerIngot,
+                PyrealMoteWcid => PyrealsPerMote,
+                _ => 0L,
+            };
+            if (ratePerUnit <= 0)
+            {
+                error = $"Unsupported mint feedstock WCID {bullionWcid}. Expected Pyreal Bar (6329), Ingot (6331), or Mote (6353).";
+                return false;
+            }
+
+            string whCommodity = bullionWcid switch
+            {
+                PyrealBarWcid => "pyreal_bar",
+                QualityPyrealIngotWcid => "pyreal_ingot",
+                PyrealMoteWcid => "pyreal_mote",
+                _ => "pyreal_bar",
+            };
+
+            long totalPyreals;
+            try
+            {
+                totalPyreals = checked(ratePerUnit * (long)quantity);
+            }
+            catch (OverflowException)
+            {
+                error = "Mint quantity overflows pyreal total.";
+                return false;
+            }
+
+            bool consumedFromInventory = TryConsumePlayerInventoryItem(actor, bullionWcid, quantity);
+
+            if (!consumedFromInventory && !TownEconomyManager.TryConsumeWarehouseStock(tid, whCommodity, quantity, out _))
+            {
+                error = $"Missing {quantity}x bullion/motes (WCID {bullionWcid}) in inventory or town warehouse.";
+                return false;
+            }
+
+            mintedPyreals = totalPyreals;
+            if (depositToTreasury)
+            {
+                TownEconomyManager.DepositToTownTill(tid, mintedPyreals, "TownMint");
+            }
+            else if (actor != null)
+            {
+                long remainingCoins = mintedPyreals;
+                while (remainingCoins > 0)
+                {
+                    int stackAmt = (int)Math.Min(remainingCoins, 25_000L);
+                    var coin = WorldObjectFactory.CreateNewWorldObject(TownEconomyManager.PyrealWcid);
+                    if (coin != null)
+                    {
+                        coin.SetStackSize(stackAmt);
+                        actor.TryCreateInInventoryWithNetworking(coin);
+                    }
+                    remainingCoins -= stackAmt;
+                }
+            }
+
+            RecordFacilityState(mint, tid, 0, $"mint_{bullionWcid}");
+            return true;
+        }
+
+        /// <summary>
+        /// Town Workshop (4000094, 25 kW): consumes refined intermediates from town_warehouse_stock
+        /// and crafts finished retail goods directly into town_vendor_ledger.
+        /// </summary>
+        public static bool TryCraftWorkshopBatch(
+            TownWorkshopDeployable workshop,
+            Player actor,
+            uint townId,
+            uint vendorGuid,
+            uint recipeId,
+            int batches,
+            out int craftedQty,
+            out string error)
+        {
+            craftedQty = 0;
+            error = null;
+
+            if (workshop == null || workshop.IsDestroyed || workshop.IsPacked || workshop.IsStowed)
+            {
+                error = "Town Workshop is unavailable.";
+                return false;
+            }
+            if (!HasAvailableMicroGridPower(workshop))
+            {
+                error = "Town Workshop (25 kW) is browned out.";
+                return false;
+            }
+            if (batches <= 0 || !WorkshopRecipes.TryGetValue(recipeId, out var recipe))
+            {
+                error = $"Unknown workshop recipe {recipeId} or invalid batch count.";
+                return false;
+            }
+
+            uint tid = townId != 0 ? townId : workshop.AffiliatedTownId;
+            if (tid == 0)
+            {
+                error = "Town Workshop is not bound to a registered town.";
+                return false;
+            }
+
+            if (actor != null && !TownCommands.CanExecuteTownLogistics(actor, tid))
+            {
+                error = "Only sworn Allegiance members of the controlling Monarch may operate this Town Workshop.";
+                return false;
+            }
+
+            if (vendorGuid == 0)
+            {
+                error = "Target vendor GUID is required.";
+                return false;
+            }
+
+            // Pre-check all inputs before consuming any commodity (with overflow protection)
+            int totalCrafted;
+            try
+            {
+                totalCrafted = checked(recipe.OutputQty * batches);
+                foreach (var req in recipe.RequiredCommodities)
+                {
+                    int needed = checked(req.Value * batches);
+                    int avail = TownEconomyManager.GetWarehouseStockQty(tid, req.Key);
+                    if (avail < needed)
+                    {
+                        error = $"Town warehouse lacks {req.Key}: need {needed}, have {avail}.";
+                        return false;
+                    }
+                }
+            }
+            catch (OverflowException)
+            {
+                error = "Workshop batch quantity overflows integer bounds.";
+                return false;
+            }
+
+            foreach (var req in recipe.RequiredCommodities)
+            {
+                int needed = checked(req.Value * batches);
+                if (!TownEconomyManager.TryConsumeWarehouseStock(tid, req.Key, needed, out error))
+                    return false;
+            }
+
+            craftedQty = totalCrafted;
+            TownEconomyManager.DepositVendorStock(tid, vendorGuid, recipe.OutputItemWcid, craftedQty);
+            RecordFacilityState(workshop, tid, 0, recipe.Name);
+            return true;
+        }
