@@ -0,0 +1,574 @@
+using System;
+using System.Globalization;
+using System.Linq;
+using ACE.Common;
+using ACE.Database;
+using ACE.Entity.Enum;
+using ACE.Server.Economy;
+using ACE.Server.Managers;
+using ACE.Server.Network;
+using ACE.Server.Vehicles;
+using ACE.Server.Vehicles.AirDefense;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Command.Handlers
+{
+    public static class TownCommands
+    {
+        public static uint ResolveEffectiveMonarchId(Player player)
+        {
+            if (player == null)
+                return 0u;
+
+            if (player.Allegiance?.Monarch?.PlayerGuid.Full is uint mGuid && mGuid != 0)
+                return mGuid;
+
+            if (player.Allegiance?.MonarchId is uint aMonarch && aMonarch != 0)
+                return aMonarch;
+
+            if (player.MonarchId is uint pMonarch && pMonarch != 0)
+                return pMonarch;
+
+            return player.Guid.Full;
+        }
+
+        public static bool IsAllegianceMonarch(Player player)
+        {
+            if (player == null)
+                return false;
+
+            if (player.PatronId != null)
+                return false;
+
+            if (player.AllegianceNode != null && !player.AllegianceNode.IsMonarch)
+                return false;
+
+            var effMonarch = ResolveEffectiveMonarchId(player);
+            return effMonarch != 0 && effMonarch == player.Guid.Full;
+        }
+
+        public static bool CanModifyTownPolicy(Player player, uint townId)
+        {
+            if (player == null || townId == 0)
+                return false;
+
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null)
+                return false;
+
+            uint owner;
+            lock (state.SyncRoot)
+                owner = state.Control.OwnerMonarchId;
+
+            return owner != 0 && IsAllegianceMonarch(player) && ResolveEffectiveMonarchId(player) == owner;
+        }
+
+        public static bool CanExecuteTownLogistics(Player player, uint townId)
+        {
+            if (player == null || townId == 0)
+                return false;
+
+            var state = TownEconomyManager.GetTownState(townId);
+            if (state == null)
+                return false;
+
+            uint owner;
+            lock (state.SyncRoot)
+                owner = state.Control.OwnerMonarchId;
+
+            return owner != 0 && ResolveEffectiveMonarchId(player) == owner;
+        }
+
+        [CommandHandler("town", AccessLevel.Player, CommandHandlerFlag.RequiresWorld, 0,
+            "Inspect and govern Allegiance-controlled towns.",
+            "town <info|claim|tariff|price|tillcap|transfer|diplomacy|bounty> ...")]
+        public static void HandleTown(Session session, params string[] parameters)
+        {
+            var player = session?.Player;
+            ExecuteTownCommand(player, parameters, out var message);
+            CommandHandlerHelper.WriteOutputInfo(session, message, ChatMessageType.Broadcast);
+        }
+
+        public static bool ExecuteTownCommand(Player player, string[] parameters, out string message)
+        {
+            if (player == null)
+            {
+                message = "Player context required.";
+                return false;
+            }
+
+            if (parameters == null || parameters.Length == 0)
+            {
+                return HandleInfo(player, Array.Empty<string>(), out message);
+            }
+
+            var sub = parameters[0].Trim().ToLowerInvariant();
+            switch (sub)
+            {
+                case "info":
+                case "status":
+                    return HandleInfo(player, parameters.Skip(1).ToArray(), out message);
+                case "claim":
+                    return HandleClaim(player, parameters.Skip(1).ToArray(), out message);
+                case "tariff":
+                    return HandleTariff(player, parameters.Skip(1).ToArray(), out message);
+                case "price":
+                    return HandlePrice(player, parameters.Skip(1).ToArray(), out message);
+                case "tillcap":
+                    return HandleTillCap(player, parameters.Skip(1).ToArray(), out message);
+                case "transfer":
+                    return HandleTransfer(player, parameters.Skip(1).ToArray(), out message);
+                case "diplomacy":
+                    return HandleDiplomacy(player, parameters.Skip(1).ToArray(), out message);
+                case "bounty":
+                    return HandleBounty(player, parameters.Skip(1).ToArray(), out message);
+                default:
+                    message = "Usage: @town <info|claim|tariff|price|tillcap|transfer|diplomacy|bounty> ...";
+                    return false;
+            }
+        }
+
+        private static TownDefinition ResolveTownArg(Player player, string arg)
+        {
+            if (string.IsNullOrWhiteSpace(arg))
+                return TownRegistry.ResolveTown(player);
+
+            if (uint.TryParse(arg.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
+                return TownRegistry.GetById(id);
+
+            return TownRegistry.FindByName(arg.Replace('_', ' '));
+        }
+
+        private static bool HandleInfo(Player player, string[] args, out string message)
+        {
+            var townArg = args.Length > 0 ? string.Join(' ', args) : null;
+            var def = ResolveTownArg(player, townArg);
+            if (def == null)
+            {
+                message = "Could not resolve town. Stand near a town or pass a valid town name/ID.";
+                return false;
+            }
+
+            var snap = SiegeManager.GetSiegeState(def.TownId);
+            if (snap == null)
+            {
+                message = $"Town state unavailable for {def.Name}.";
+                return false;
+            }
+
+            var (buyMul, sellMul) = TownEconomyManager.GetTariffs(def.TownId);
+            var tillCap = TownEconomyManager.GetTownTillCap(def.TownId);
+            var spendable = TownEconomyManager.GetSpendableTreasuryPyreals(def.TownId);
+            var drainRate = TownRegistry.GetSupplyDrainPerHour(def.Tier);
+
+            message =
+                $"[{def.Name} (#{def.TownId}, {def.Tier}, {def.Continent})] State: {snap.State} | Owner Monarch: {snap.OwnerMonarchId} | " +
+                $"Attacker: {snap.AttackerMonarchId} | Hold: {snap.HoldElapsedSec:0}/{SiegeManager.HoldDurationSec:0}s | " +
+                $"Supply: {snap.SupplyMeterSec:0}/{SiegeManager.SupplyMeterMaxSec:0}s ({drainRate} SP/hr) | " +
+                $"Treasury: {snap.TreasuryPyreals:N0}p (Spendable: {spendable:N0}p, Escrow: {snap.EscrowPyreals:N0}p, Reserve: {snap.ClearinghouseReservePyreals:N0}p) | " +
+                $"Tariffs: Buy {buyMul:0.00}x / Sell {sellMul:0.00}x | TillCap: {tillCap:N0}p.";
+            return true;
+        }
+
+        private static bool HandleClaim(Player player, string[] args, out string message)
+        {
+            var townArg = args.Length > 0 ? string.Join(' ', args) : null;
+            var def = ResolveTownArg(player, townArg);
+            if (def == null)
+            {
+                message = "Could not resolve town to claim.";
+                return false;
+            }
+
+            if (!IsAllegianceMonarch(player))
+            {
+                message = "Only an Allegiance Monarch may submit a Town Charter claim.";
+                return false;
+            }
+
+            if (player.Location == null || player.Location.Indoors)
+            {
+                message = $"You must be outdoors within {SiegeManager.ControlRingRadiusM:0}m of {def.Name}'s Town Control Node to submit a claim.";
+                return false;
+            }
+
+            bool withinRing;
+            if (SiegeManager.TryGetHydratedControlNode(def.TownId, out var node))
+            {
+                withinRing = node.IsPlayerInsideControlRing(player);
+            }
+            else
+            {
+                var (px, py, _) = Vehicle.ToGlobal(player.Location);
+                var dx = px - def.WorldX;
+                var dy = py - def.WorldY;
+                withinRing = SiegeManager.IsWithinControlRing((float)Math.Sqrt(dx * dx + dy * dy));
+            }
+
+            if (!withinRing)
+            {
+                message = $"You must stand within {SiegeManager.ControlRingRadiusM:0}m of {def.Name}'s Town Control Node to claim it.";
+                return false;
+            }
+
+            var charterItem = FindTownCharterItem(player);
+            bool hasCharter = charterItem != null;
+            if (!SiegeManager.TryStartClaim(def.TownId, player, hasCharter, out message))
+                return false;
+
+            ConsumeCharterItem(player, charterItem);
+            return true;
+        }
+
+        internal static WorldObject FindTownCharterItem(Player player)
+        {
+            if (player?.Inventory == null)
+                return null;
+            return FindTownCharterInContainer(player);
+        }
+
+        private static string SafeGetWeenieClassName(WorldObject wo)
+        {
+            if (wo == null || DatabaseManager.World == null || ConfigManager.Config == null)
+                return null;
+
+            try
+            {
+                return wo.WeenieClassName;
+            }
+            catch
+            {
+                return null;
+            }
+        }
+
+        private static WorldObject FindTownCharterInContainer(Container container)
+        {
+            if (container?.Inventory == null)
+                return null;
+
+            foreach (var wo in container.Inventory.Values)
+            {
+                if (wo == null || wo.IsDestroyed) continue;
+                if (wo.WeenieClassId == TownEconomyManager.ParchmentWcid)
+                    return wo;
+                if (!string.IsNullOrWhiteSpace(wo.Name) && wo.Name.Contains("Town Charter", StringComparison.OrdinalIgnoreCase))
+                    return wo;
+                var weenieClassName = SafeGetWeenieClassName(wo);
+                if (!string.IsNullOrWhiteSpace(weenieClassName) && weenieClassName.Contains("charter", StringComparison.OrdinalIgnoreCase))
+                    return wo;
+                if (wo is Container sub)
+                {
+                    var nested = FindTownCharterInContainer(sub);
+                    if (nested != null)
+                        return nested;
+                }
+            }
+            return null;
+        }
+
+        internal static void ConsumeCharterItem(Player player, WorldObject charterItem)
+        {
+            if (player == null || charterItem == null)
+                return;
+
+            if (player.Session?.Network != null)
+            {
+                player.TryConsumeFromInventoryWithNetworking(charterItem, 1);
+                return;
+            }
+
+            int stack = charterItem.StackSize ?? 1;
+            if (stack > 1)
+            {
+                charterItem.StackSize = stack - 1;
+            }
+            else
+            {
+                player.TryRemoveFromInventory(charterItem.Guid, out _);
+                try { charterItem.Destroy(false); } catch (NullReferenceException) { }
+            }
+        }
+
+        private static bool HandleTariff(Player player, string[] args, out string message)
+        {
+            if (args.Length < 3)
+            {
+                message = "Usage: @town tariff <town> <buyMul> <sellMul>";
+                return false;
+            }
+
+            if (!float.TryParse(args[^2], NumberStyles.Float, CultureInfo.InvariantCulture, out var buyMul) ||
+                !float.TryParse(args[^1], NumberStyles.Float, CultureInfo.InvariantCulture, out var sellMul))
+            {
+                message = "Invalid tariff multipliers. Usage: @town tariff <town> <buyMul> <sellMul>";
+                return false;
+            }
+
+            var townName = string.Join(' ', args.Take(args.Length - 2));
+            var def = ResolveTownArg(player, townName);
