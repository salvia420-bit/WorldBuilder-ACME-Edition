+                double safeZ = double.IsFinite(snapshot.WorldZ) ? snapshot.WorldZ : 0.0;
+                double safeHeading = double.IsFinite(snapshot.HeadingRad) ? snapshot.HeadingRad : 0.0;
+                DateTime safeUpdatedUtc = snapshot.UpdatedUtc == default ? DateTime.UtcNow : snapshot.UpdatedUtc;
+
+                var existing = context.LogisticsConvoy.FirstOrDefault(c => c.ConvoyId == snapshot.ConvoyId);
+                if (existing == null)
