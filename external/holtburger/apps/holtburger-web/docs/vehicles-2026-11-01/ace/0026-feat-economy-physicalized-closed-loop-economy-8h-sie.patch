+
+namespace ACE.Server.Tests.Economy
+{
+    [TestClass]
+    public class PhaseAEconomyCoreTests
+    {
+        [TestInitialize]
+        public void Init()
+        {
+            TownEconomyManager.EnabledOverride = null;
+            TownEconomyManager.ResetForTesting();
+        }
+
+        [TestCleanup]
+        public void Cleanup()
+        {
+            TownEconomyManager.EnabledOverride = null;
+            PropertyManager.ModifyBool("physical_economy_enabled", false);
+            TownEconomyManager.ResetForTesting();
+        }
+
+        [TestMethod]
+        public void F1_PhysicalEconomyProperty_DefaultsFalseAndTogglesCleanly()
+        {
+            Assert.IsTrue(DefaultPropertyManager.DefaultBooleanProperties.TryGetValue("physical_economy_enabled", out var prop));
+            Assert.IsFalse(prop.Item);
+
+            PropertyManager.ModifyBool("physical_economy_enabled", false);
+            Assert.IsFalse(TownEconomyManager.Enabled);
+
+            Assert.IsTrue(PropertyManager.ModifyBool("physical_economy_enabled", true));
+            Assert.IsTrue(TownEconomyManager.Enabled);
+
+            TownEconomyManager.EnabledOverride = false;
+            Assert.IsFalse(TownEconomyManager.Enabled);
+
+            TownEconomyManager.EnabledOverride = true;
+            Assert.IsTrue(TownEconomyManager.Enabled);
+        }
+
+        [TestMethod]
+        public void F1_ColdStart_SeedsAll101TownsWithZeroTreasuryAndZeroStock()
+        {
+            TownEconomyManager.EnabledOverride = true;
+            TownEconomyManager.ResetForTesting();
+
+            Assert.AreEqual(101, TownEconomyManager.TownCount);
+
+            foreach (var town in TownRegistry.AllTowns)
+            {
+                var state = TownEconomyManager.GetTownState(town.TownId);
+                Assert.IsNotNull(state, $"Missing state for town {town.TownId} ({town.Name})");
+                Assert.AreEqual("UNCLAIMED_COLD", state.Control.State);
+                Assert.AreEqual(0L, state.Control.TreasuryPyreals);
+                Assert.AreEqual(0L, state.Control.EscrowPyreals);
+                Assert.AreEqual(0L, state.Control.ClearinghouseReservePyreals);
+                Assert.AreEqual(1.0f, state.Control.TariffBuyMul);
+                Assert.AreEqual(1.0f, state.Control.TariffSellMul);
+                Assert.AreEqual(0, TownEconomyManager.GetVendorStock(town.TownId, 0x80001234u, 273u));
+            }
+        }
+
+        [TestMethod]
+        public void F2_TownRegistry_HasExact101UniqueTownsWithCorrectContinentsAndTiers()
+        {
+            var all = TownRegistry.AllTowns;
+            Assert.AreEqual(101, all.Count);
+            Assert.AreEqual(60, all.Count(t => t.ContinentId == 0 && t.Continent == "Dereth"));
+            Assert.AreEqual(41, all.Count(t => t.ContinentId == 1 && t.Continent == "Dericost"));
+
+            Assert.AreEqual(101, all.Select(t => t.TownId).Distinct().Count());
+            Assert.AreEqual(101, all.Select(t => t.Name).Distinct(StringComparer.OrdinalIgnoreCase).Count());
+            Assert.AreEqual(1u, all.Min(t => t.TownId));
+            Assert.AreEqual(101u, all.Max(t => t.TownId));
+
+            foreach (var dereth in all.Where(t => t.ContinentId == 0))
+            {
+                Assert.AreEqual(0u, dereth.AnchorLandblock & 0x8000u, $"{dereth.Name} should not have Dericost bit set");
+                Assert.IsTrue(dereth.WorldY < 68928.0, $"{dereth.Name} WorldY out of Dereth range");
+            }
+
+            foreach (var dericost in all.Where(t => t.ContinentId == 1))
+            {
+                Assert.AreEqual(0x8000u, dericost.AnchorLandblock & 0x8000u, $"{dericost.Name} missing Dericost bit 0x8000");
+                Assert.IsTrue(dericost.WorldY >= 68928.0, $"{dericost.Name} WorldY should be >= 68928.0");
+            }
+
+            var holtburg = TownRegistry.FindByName("Holtburg");
+            Assert.IsNotNull(holtburg);
+            Assert.AreEqual(TownTier.CapitalPort, holtburg.Tier);
+            Assert.AreEqual(200, TownRegistry.GetSupplyDrainPerHour(holtburg.Tier));
+
+            var rithwic = TownRegistry.FindByName("Rithwic");
+            Assert.IsNotNull(rithwic);
+            Assert.AreEqual(TownTier.RegionalHub, rithwic.Tier);
+            Assert.AreEqual(100, TownRegistry.GetSupplyDrainPerHour(rithwic.Tier));
+
+            var kryst = TownRegistry.FindByName("Kryst");
+            Assert.IsNotNull(kryst);
+            Assert.AreEqual(TownTier.Village, kryst.Tier);
+            Assert.AreEqual(40, TownRegistry.GetSupplyDrainPerHour(kryst.Tier));
+
+            Assert.IsNotNull(TownRegistry.FindByName("Candeth Keep"));
+            Assert.IsNotNull(TownRegistry.FindByName("Wai Jhou"));
+            Assert.IsNotNull(TownRegistry.FindByName("Merwart Village"));
+            Assert.IsNotNull(TownRegistry.FindByName("Crater Lake Village"));
+            Assert.IsNotNull(TownRegistry.FindByName("Tou-Tou"));
+            Assert.IsNotNull(TownRegistry.FindByName("Vasmora"));
+            Assert.IsNotNull(TownRegistry.FindByName("South-Haven"));
+        }
