+        public static byte MapOrderStatusByte(string status) => status?.Trim().ToLowerInvariant() switch
+        {
+            "open" => 0,
+            "fulfilled" => 1,
+            "cancelled" => 2,
+            "expired" => 3,
+            _ => 0,
+        };
+
+        public static EconomyMonarchOrderStateMsg BuildMonarchOrderStateMsg(MonarchOrder order, float valueF32 = 0f, ushort flags = 0)
+        {
+            if (order == null) return null;
+            byte orderTypeByte = order.OrderType?.Trim().ToLowerInvariant() switch
+            {
+                "procurementbounty" => 1,
+                "tariff" => 2,
+                "tillcap" => 3,
+                "diplomacy" => 4,
+                _ => 1,
+            };
+            return new EconomyMonarchOrderStateMsg
+            {
+                OrderId = order.OrderId,
+                MonarchId = order.MonarchId,
+                TownId = order.TownId,
+                OrderType = orderTypeByte,
+                Status = MapOrderStatusByte(order.Status),
+                Flags = flags,
+                ClaimedByGuid = order.ClaimedByGuid,
+                ItemWcid = order.ItemWcid,
+                Quantity = (uint)Math.Max(0, order.RemainingQty),
+                RewardPyreals = (ulong)Math.Max(0L, order.RewardPyreals),
+                ValueF32 = valueF32,
+            };
+        }
