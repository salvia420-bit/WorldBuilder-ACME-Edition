+        [TestMethod]
+        public void Test04_ConcurrentPurchasesAndBuybacksAreThreadSafe()
+        {
+            var cragstone = TownRegistry.FindByName("Cragstone");
+            var vendor = CreateTestVendor(669, 0xBB9F0101u, "Cragstone Armorer");
+            const uint itemWcid = 5001;
