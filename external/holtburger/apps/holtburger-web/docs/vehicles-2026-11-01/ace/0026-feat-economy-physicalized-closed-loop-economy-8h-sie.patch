+        private static int CountTownSupplyLocked(TownRuntimeState state, uint vendorGuid, uint wcid, string[] commodities)
+            => CountTownSupplyAnyLocked(state, vendorGuid, new[] { wcid }, commodities);
+
+        private static int CountTownSupplyAnyLocked(TownRuntimeState state, uint vendorGuid, uint[] wcids, string[] commodities)
+        {
+            int total = 0;
+            foreach (var wcid in wcids)
+            {
+                if (state.Ledgers.TryGetValue((vendorGuid, wcid), out var direct))
+                    total += Math.Max(0, direct.StockQty);
+
+                foreach (var kvp in state.Ledgers)
+                {
+                    if (kvp.Key.vendorGuid != vendorGuid && kvp.Key.itemWcid == wcid)
+                        total += Math.Max(0, kvp.Value.StockQty);
+                }
+            }
+            foreach (var wh in state.Warehouses.Values)
+            {
+                if (wh.Qty > 0 && commodities.Any(c => string.Equals(c, wh.CommodityId, StringComparison.OrdinalIgnoreCase)))
+                    total += wh.Qty;
+            }
+            return total;
+        }
+
+        private static int CountScrollReagentsLocked(TownRuntimeState state, uint vendorGuid, Spell spell)
+        {
+            var parchment = CountTownSupplyLocked(state, vendorGuid, ParchmentWcid, ParchmentCommodities);
+            var ink = CountTownSupplyAnyLocked(state, vendorGuid, InkWcids, InkCommodities);
+            var scarab = CountTownSupplyAnyLocked(state, vendorGuid, ScarabWcids, ScarabCommodities);
+            return Math.Min(parchment, Math.Min(ink, scarab));
+        }
+
+        private static int CountServiceReagentsLocked(TownRuntimeState state, uint vendorGuid, Spell spell)
+        {
+            var probeLedger = new Dictionary<(uint vendorGuid, uint wcid), int>();
+            var probeWh = new Dictionary<(string commodityId, int gradeBps, bool poweredReefer), int>();
+            if (!TryReserveSpellServiceReagentsLocked(state, vendorGuid, spell, 1, probeLedger, probeWh))
+                return 0;
+
+            long totalUnits = 0;
+            foreach (var l in state.Ledgers.Values)
+            {
+                if (l.StockQty > 0) totalUnits += l.StockQty;
+            }
+            foreach (var w in state.Warehouses.Values)
+            {
+                if (w.Qty > 0) totalUnits += w.Qty;
+            }
+
+            int lo = 1;
+            int hi = (int)Math.Clamp(totalUnits, 1L, 0xFFFFFFL);
+            while (lo < hi)
+            {
+                int mid = lo + ((hi - lo + 1) / 2);
+                probeLedger.Clear();
+                probeWh.Clear();
+                if (TryReserveSpellServiceReagentsLocked(state, vendorGuid, spell, mid, probeLedger, probeWh))
+                    lo = mid;
+                else
+                    hi = mid - 1;
+            }
+            return lo;
+        }
+
+        private static bool TryReserveScrollReagentsLocked(
+            TownRuntimeState state,
+            uint vendorGuid,
+            Spell spell,
+            int qty,
+            Dictionary<(uint vendorGuid, uint wcid), int> ledgerDeltas,
+            Dictionary<(string commodityId, int gradeBps, bool poweredReefer), int> warehouseDeltas)
+        {
+            if (!TryReserveSupplyLocked(state, vendorGuid, new[] { ParchmentWcid }, ParchmentCommodities, qty, ledgerDeltas, warehouseDeltas))
+                return false;
+            if (!TryReserveSupplyLocked(state, vendorGuid, InkWcids, InkCommodities, qty, ledgerDeltas, warehouseDeltas))
+                return false;
+
+            var tierScarab = GetTierScarabWcids(spell);
+            if (!TryReserveSupplyLocked(state, vendorGuid, tierScarab, ScarabCommodities, qty, ledgerDeltas, warehouseDeltas))
+                return false;
+
+            return true;
+        }
+
+        private static bool TryReserveSpellServiceReagentsLocked(
+            TownRuntimeState state,
+            uint vendorGuid,
+            Spell spell,
+            int qty,
+            Dictionary<(uint vendorGuid, uint wcid), int> ledgerDeltas,
+            Dictionary<(string commodityId, int gradeBps, bool poweredReefer), int> warehouseDeltas)
+        {
+            // When DatManager.PortalDat is loaded, try resolving exact Spell.Formula.Components
+            // (do not gate on !spell.NotFound, since Spell.Formula only requires PortalDat _spellBase)
+            if (DatManager.PortalDat != null && spell != null && spell.Formula?.Components != null && spell.Formula.Components.Count > 0)
+            {
+                var compWcids = new List<uint>();
+                foreach (var compId in spell.Formula.Components)
+                {
+                    var wcid = TryGetComponentWcidSafe(compId);
+                    if (wcid != 0)
+                        compWcids.Add(wcid);
+                }
+
+                if (compWcids.Count > 0)
+                {
+                    bool allFound = true;
+                    var tempLedger = new Dictionary<(uint, uint), int>(ledgerDeltas);
+                    var tempWh = new Dictionary<(string, int, bool), int>(warehouseDeltas);
+                    foreach (var wcid in compWcids)
+                    {
+                        var fallbackComms = CategorizeComponentCommodities(wcid);
+                        if (!TryReserveSupplyLocked(state, vendorGuid, new[] { wcid }, fallbackComms, qty, tempLedger, tempWh))
+                        {
+                            allFound = false;
+                            break;
+                        }
+                    }
+
+                    if (allFound)
+                    {
+                        ledgerDeltas.Clear();
+                        foreach (var kv in tempLedger) ledgerDeltas[kv.Key] = kv.Value;
+                        warehouseDeltas.Clear();
+                        foreach (var kv in tempWh) warehouseDeltas[kv.Key] = kv.Value;
+                        return true;
+                    }
+                }
+            }
+
+            // Standard closed-loop service draw: Taper + Tier Scarab + Botanical Herb
+            if (!TryReserveSupplyLocked(state, vendorGuid, TaperWcids, TaperCommodities, qty, ledgerDeltas, warehouseDeltas))
+                return false;
+            if (!TryReserveSupplyLocked(state, vendorGuid, GetTierScarabWcids(spell), ScarabCommodities, qty, ledgerDeltas, warehouseDeltas))
+                return false;
+            if (!TryReserveSupplyLocked(state, vendorGuid, HerbWcids, HerbCommodities, qty, ledgerDeltas, warehouseDeltas))
+                return false;
+
+            return true;
+        }
+
+        private static uint TryGetComponentWcidSafe(uint compId)
+        {
+            try
+            {
+                return Spell.GetComponentWCID(compId);
+            }
+            catch
+            {
+                return 0;
+            }
+        }
+
+        private static Spell TryResolveSpellSafe(uint spellDid)
+        {
+            if (spellDid == 0 || DatManager.PortalDat?.SpellTable?.Spells == null)
+                return null;
+
+            try
+            {
+                return new Spell(spellDid, loadDB: DatabaseManager.World != null);
+            }
+            catch
+            {
+                try
+                {
+                    return new Spell(spellDid, loadDB: false);
+                }
+                catch
+                {
+                    return null;
+                }
+            }
+        }
+
+        private static uint[] GetTierScarabWcids(Spell spell)
+        {
+            uint level = 1;
+            try
+            {
+                if (spell != null)
+                {
+                    if (!spell.NotFound)
+                        level = Math.Max(1u, spell.Level);
+                    else if (spell.Formula != null && spell.Formula.Level > 0)
+                        level = Math.Max(1u, spell.Formula.Level);
+                }
+            }
+            catch
+            {
+                level = 1;
+            }
+
+            uint preferred = level switch
+            {
+                1 => 686u,   // Copper
+                2 => 688u,   // Silver
+                3 => 687u,   // Gold
+                4 => 690u,   // Pyreal
+                5 => 8897u,  // Platinum
+                _ => 7299u,  // Diamond
+            };
+
+            return new[] { preferred }.Concat(ScarabWcids.Where(w => w != preferred)).ToArray();
+        }
+
+        private static string[] CategorizeComponentCommodities(uint wcid)
+        {
+            if (TaperWcids.Contains(wcid)) return TaperCommodities;
+            if (ScarabWcids.Contains(wcid)) return ScarabCommodities;
+            if (HerbWcids.Contains(wcid)) return HerbCommodities;
+            if (InkWcids.Contains(wcid)) return InkCommodities;
+            if (wcid == ParchmentWcid) return ParchmentCommodities;
+            return Array.Empty<string>();
+        }
+
+        private static bool TryReserveSupplyLocked(
+            TownRuntimeState state,
+            uint vendorGuid,
+            uint[] candidateWcids,
+            string[] candidateCommodities,
+            int neededQty,
+            Dictionary<(uint vendorGuid, uint wcid), int> ledgerDeltas,
+            Dictionary<(string commodityId, int gradeBps, bool poweredReefer), int> warehouseDeltas)
+        {
+            int remaining = neededQty;
+
+            // 1. Prefer vendor's own ledger first
+            foreach (var wcid in candidateWcids)
+            {
+                if (remaining <= 0) break;
+                var avail = GetProjectedLedgerQtyLocked(state, vendorGuid, wcid, ledgerDeltas);
+                if (avail > 0)
+                {
+                    var take = Math.Min(remaining, avail);
+                    AddDelta(ledgerDeltas, (vendorGuid, wcid), -take);
+                    remaining -= take;
+                }
+            }
+
+            // 2. Check town-wide vendor ledgers (e.g. local Archmage/Scribe reagent pool)
+            if (remaining > 0)
+            {
+                foreach (var wcid in candidateWcids)
+                {
+                    if (remaining <= 0) break;
+                    foreach (var kvp in state.Ledgers)
+                    {
+                        if (kvp.Key.vendorGuid == vendorGuid || kvp.Key.itemWcid != wcid) continue;
+                        var avail = GetProjectedLedgerQtyLocked(state, kvp.Key.vendorGuid, wcid, ledgerDeltas);
+                        if (avail > 0)
+                        {
+                            var take = Math.Min(remaining, avail);
+                            AddDelta(ledgerDeltas, kvp.Key, -take);
+                            remaining -= take;
+                            if (remaining <= 0) break;
+                        }
+                    }
+                }
+            }
+
+            // 3. Check town_warehouse_stock commodities
+            if (remaining > 0 && candidateCommodities.Length > 0)
+            {
+                foreach (var kvp in state.Warehouses)
+                {
+                    if (!candidateCommodities.Any(c => string.Equals(c, kvp.Key.commodityId, StringComparison.OrdinalIgnoreCase)))
+                        continue;
+
+                    var avail = GetProjectedWarehouseQtyLocked(state, kvp.Key, warehouseDeltas);
+                    if (avail > 0)
+                    {
+                        var take = Math.Min(remaining, avail);
+                        AddDelta(warehouseDeltas, kvp.Key, -take);
+                        remaining -= take;
+                        if (remaining <= 0) break;
+                    }
+                }
+            }
+
+            return remaining == 0;
+        }
+
+        private static int GetProjectedLedgerQtyLocked(
+            TownRuntimeState state,
+            uint vendorGuid,
+            uint wcid,
+            Dictionary<(uint vendorGuid, uint wcid), int> deltas)
+        {
+            var baseQty = state.Ledgers.TryGetValue((vendorGuid, wcid), out var l) ? l.StockQty : 0;
+            var delta = deltas.TryGetValue((vendorGuid, wcid), out var d) ? d : 0;
+            return Math.Max(0, baseQty + delta);
+        }
+
+        private static int GetProjectedWarehouseQtyLocked(
+            TownRuntimeState state,
+            (string commodityId, int gradeBps, bool poweredReefer) key,
+            Dictionary<(string commodityId, int gradeBps, bool poweredReefer), int> deltas)
+        {
+            var baseQty = state.Warehouses.TryGetValue(key, out var w) ? w.Qty : 0;
+            var delta = deltas.TryGetValue(key, out var d) ? d : 0;
+            return Math.Max(0, baseQty + delta);
+        }
+
+        private static void AddDelta<TKey>(Dictionary<TKey, int> dict, TKey key, int delta)
+        {
+            dict[key] = (dict.TryGetValue(key, out var cur) ? cur : 0) + delta;
+        }
+
+        private static TownVendorLedger GetOrCreateLedgerLocked(TownRuntimeState state, uint vendorGuid, uint itemWcid)
+        {
+            if (!state.Ledgers.TryGetValue((vendorGuid, itemWcid), out var ledger))
+            {
+                ledger = new TownVendorLedger
+                {
+                    TownId = state.Control.TownId,
+                    VendorGuid = vendorGuid,
+                    ItemWcid = itemWcid,
+                    StockQty = 0,
+                    TillPyreals = 0,
+                    TillCapPyreals = 0,
+                    UnitPriceOverride = null,
+                };
+                state.Ledgers[(vendorGuid, itemWcid)] = ledger;
+            }
+            return ledger;
+        }
+
+        private static void PersistTownControl(TownControl snapshot)
+        {
+            try
+            {
+                DatabaseManager.Shard?.EnqueueTownControlUpsert(snapshot);
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[ECONOMY] Failed to enqueue TownControl upsert: {ex.Message}");
+            }
+        }
+
+        private static void PersistVendorLedger(TownVendorLedger snapshot)
+        {
+            try
+            {
+                DatabaseManager.Shard?.EnqueueTownVendorLedgerUpsert(snapshot);
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[ECONOMY] Failed to enqueue TownVendorLedger upsert: {ex.Message}");
+            }
+        }
+
+        private static void PersistWarehouseStock(TownWarehouseStock snapshot)
+        {
+            try
+            {
+                DatabaseManager.Shard?.EnqueueTownWarehouseStockUpsert(snapshot);
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[ECONOMY] Failed to enqueue TownWarehouseStock upsert: {ex.Message}");
+            }
+        }
+
+        private static void PersistMonarchOrder(MonarchOrder snapshot)
+        {
+            try
+            {
+                DatabaseManager.Shard?.EnqueueMonarchOrderUpsert(snapshot);
+            }
+            catch (Exception ex)
+            {
+                log.Warn($"[ECONOMY] Failed to enqueue MonarchOrder upsert: {ex.Message}");
+            }
+        }
+
+        private static MonarchOrder CloneMonarchOrder(MonarchOrder o) => new()
+        {
+            OrderId = o.OrderId,
+            MonarchId = o.MonarchId,
+            TownId = o.TownId,
+            OrderType = o.OrderType ?? "ProcurementBounty",
+            ItemWcid = o.ItemWcid,
+            CommodityId = o.CommodityId ?? "",
+            TargetQty = Math.Max(0, o.TargetQty),
+            RemainingQty = Math.Max(0, o.RemainingQty),
+            RewardPyreals = Math.Max(0L, o.RewardPyreals),
+            ClaimedByGuid = o.ClaimedByGuid,
+            Status = o.Status ?? "Open",
+            CreatedUtc = o.CreatedUtc,
+            UpdatedUtc = o.UpdatedUtc,
+        };
+
+        private static TownControl CloneControl(TownControl c) => new()
+        {
+            TownId = c.TownId,
+            Continent = c.Continent,
+            Name = c.Name,
+            AnchorLandblock = c.AnchorLandblock,
+            State = c.State,
+            OwnerMonarchId = c.OwnerMonarchId,
+            AttackerMonarchId = c.AttackerMonarchId,
+            HoldElapsedSec = c.HoldElapsedSec,
+            SupplyMeterSec = c.SupplyMeterSec,
+            StarvingSec = c.StarvingSec,
+            TreasuryPyreals = c.TreasuryPyreals,
+            EscrowPyreals = c.EscrowPyreals,
+            ClearinghouseReservePyreals = c.ClearinghouseReservePyreals,
+            TariffBuyMul = c.TariffBuyMul,
+            TariffSellMul = c.TariffSellMul,
+            LastDeliveryUtc = c.LastDeliveryUtc,
+            CooldownUntilUtc = c.CooldownUntilUtc,
+            UpdatedUtc = c.UpdatedUtc,
+        };
+
+        private static TownVendorLedger CloneLedger(TownVendorLedger l) => new()
+        {
+            TownId = l.TownId,
+            VendorGuid = l.VendorGuid,
+            ItemWcid = l.ItemWcid,
+            StockQty = l.StockQty,
+            TillPyreals = l.TillPyreals,
+            TillCapPyreals = l.TillCapPyreals,
+            UnitPriceOverride = l.UnitPriceOverride,
+        };
+
+        private static TownWarehouseStock CloneWarehouse(TownWarehouseStock w) => new()
+        {
+            TownId = w.TownId,
+            CommodityId = w.CommodityId,
+            GradeBps = w.GradeBps,
+            Qty = w.Qty,
+            FreshnessPct = w.FreshnessPct,
+            PoweredReefer = w.PoweredReefer,
+        };
+    }
+}
