+        public static void SetProcurementBounty(uint townId, uint itemWcid, string commodityId, long rewardPyreals, int maxQty)
+            => SetProcurementBountyOrder(townId, itemWcid, commodityId, rewardPyreals, maxQty, monarchId: 0, explicitOrderId: 0);
+
+        public static MonarchOrder SetProcurementBountyOrder(
+            uint townId,
+            uint itemWcid,
+            string commodityId,
+            long rewardPyreals,
+            int maxQty,
+            uint monarchId = 0,
+            ulong explicitOrderId = 0)
+        {
+            var state = GetTownState(townId);
+            if (state == null || itemWcid == 0) return null;
+
+            MonarchOrder orderSnap = null;
+            var now = DateTime.UtcNow;
+
+            lock (state.SyncRoot)
+            {
+                if (maxQty <= 0 || rewardPyreals <= 0)
+                {
+                    if (state.Bounties.TryGetValue(itemWcid, out var oldBounty) && oldBounty.OrderId != 0)
+                    {
+                        var cancelSnap = new MonarchOrder
+                        {
+                            OrderId = oldBounty.OrderId,
+                            MonarchId = oldBounty.MonarchId != 0 ? oldBounty.MonarchId : state.Control.OwnerMonarchId,
+                            TownId = townId,
+                            OrderType = "ProcurementBounty",
+                            ItemWcid = itemWcid,
+                            CommodityId = oldBounty.CommodityId,
+                            TargetQty = Math.Max(0, oldBounty.TargetQty),
+                            RemainingQty = 0,
+                            RewardPyreals = Math.Max(0L, oldBounty.RewardPyreals),
+                            ClaimedByGuid = 0,
+                            Status = "Cancelled",
+                            CreatedUtc = oldBounty.CreatedUtc,
+                            UpdatedUtc = now,
+                        };
+                        monarchOrders[cancelSnap.OrderId] = CloneMonarchOrder(cancelSnap);
+                        orderSnap = cancelSnap;
+                    }
+                    state.Bounties.Remove(itemWcid);
+                }
+                else
+                {
+                    long clampedReward = Math.Max(0L, rewardPyreals);
+                    string resolvedCommodity = string.IsNullOrWhiteSpace(commodityId) ? $"trophy_{itemWcid}" : commodityId;
+                    uint effectiveMonarch = monarchId != 0 ? monarchId : state.Control.OwnerMonarchId;
+                    ulong oid = explicitOrderId != 0
+                        ? AllocateOrderId(explicitOrderId)
+                        : (state.Bounties.TryGetValue(itemWcid, out var existing) && existing.OrderId != 0
+                            ? existing.OrderId
+                            : AllocateOrderId());
+
+                    var bounty = new ProcurementBounty
+                    {
+                        OrderId = oid,
+                        MonarchId = effectiveMonarch,
+                        TownId = townId,
+                        ItemWcid = itemWcid,
+                        CommodityId = resolvedCommodity,
+                        RewardPyreals = clampedReward,
+                        TargetQty = maxQty,
+                        RemainingQty = maxQty,
+                        CreatedUtc = now,
+                    };
+                    state.Bounties[itemWcid] = bounty;
+
+                    orderSnap = new MonarchOrder
+                    {
+                        OrderId = oid,
+                        MonarchId = effectiveMonarch,
+                        TownId = townId,
+                        OrderType = "ProcurementBounty",
+                        ItemWcid = itemWcid,
+                        CommodityId = resolvedCommodity,
+                        TargetQty = maxQty,
+                        RemainingQty = maxQty,
+                        RewardPyreals = clampedReward,
+                        ClaimedByGuid = 0,
+                        Status = "Open",
+                        CreatedUtc = now,
+                        UpdatedUtc = now,
+                    };
+                    monarchOrders[oid] = CloneMonarchOrder(orderSnap);
+                }
+            }
+
+            if (orderSnap != null)
+                PersistMonarchOrder(orderSnap);
+
+            return orderSnap != null ? CloneMonarchOrder(orderSnap) : null;
+        }
+
+        public static bool CancelMonarchOrder(uint townId, ulong orderId, uint itemWcid, out MonarchOrder cancelled)
+        {
+            cancelled = null;
+            var state = GetTownState(townId);
+            if (state == null) return false;
+
+            MonarchOrder targetOrder = null;
+            if (orderId != 0 && monarchOrders.TryGetValue(orderId, out var found) && found.TownId == townId)
+                targetOrder = found;
+
+            MonarchOrder snap = null;
+            var now = DateTime.UtcNow;
+            lock (state.SyncRoot)
+            {
+                uint wcidToRemove = itemWcid != 0 ? itemWcid : (targetOrder?.ItemWcid ?? 0u);
+                if (wcidToRemove != 0 && state.Bounties.TryGetValue(wcidToRemove, out var bounty))
+                {
+                    if (orderId == 0 || bounty.OrderId == orderId)
+                    {
+                        state.Bounties.Remove(wcidToRemove);
+                        ulong oid = bounty.OrderId != 0 ? bounty.OrderId : orderId;
+                        if (oid != 0)
+                        {
+                            snap = new MonarchOrder
+                            {
+                                OrderId = oid,
+                                MonarchId = bounty.MonarchId != 0 ? bounty.MonarchId : state.Control.OwnerMonarchId,
+                                TownId = townId,
+                                OrderType = "ProcurementBounty",
+                                ItemWcid = wcidToRemove,
+                                CommodityId = bounty.CommodityId,
+                                TargetQty = Math.Max(0, bounty.TargetQty),
+                                RemainingQty = 0,
+                                RewardPyreals = Math.Max(0L, bounty.RewardPyreals),
+                                ClaimedByGuid = 0,
+                                Status = "Cancelled",
+                                CreatedUtc = bounty.CreatedUtc,
+                                UpdatedUtc = now,
+                            };
+                        }
+                    }
+                }
+                else if (targetOrder != null)
+                {
+                    snap = CloneMonarchOrder(targetOrder);
+                    snap.RemainingQty = 0;
+                    snap.Status = "Cancelled";
+                    snap.UpdatedUtc = now;
+                }
+
+                if (snap != null)
+                    monarchOrders[snap.OrderId] = CloneMonarchOrder(snap);
+            }
+
+            if (snap == null)
+                return false;
+
+            PersistMonarchOrder(snap);
+            cancelled = CloneMonarchOrder(snap);
+            return true;
+        }
