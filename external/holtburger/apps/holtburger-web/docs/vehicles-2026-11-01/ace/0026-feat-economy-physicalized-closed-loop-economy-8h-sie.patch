+        // --- RadarIff Synchronization & Turret Policy Filtering ---
+
+        public static void SyncTownRadarIff(uint townId, uint newOwnerMonarchId, uint? previousOwnerMonarchId = null)
+        {
+            var policy = newOwnerMonarchId != 0 ? RadarIff.GetOrCreateMonarchPolicy(newOwnerMonarchId) : null;
+
+            foreach (var station in AirDefenseManager.Stations)
+            {
+                if (station == null || station.IsDestroyed) continue;
+                bool match = station.AffiliatedTownId == townId ||
+                    (station.AffiliatedTownId == 0 && IsObjectInTownBoundary(station, townId) &&
+                     (!previousOwnerMonarchId.HasValue || previousOwnerMonarchId.Value == 0 ||
+                      station.OwnerMonarchId == previousOwnerMonarchId.Value ||
+                      station.DeployerMonarchId == previousOwnerMonarchId.Value));
+                if (!match) continue;
+
+                station.AffiliatedTownId = townId;
+                station.OwnerMonarchId = newOwnerMonarchId;
+                station.Policy = policy;
+                station.Sensor?.ClearTracks();
+                station.BroadcastState();
+            }
+
+            foreach (var dep in DeployableManager.GetAll())
+            {
+                if (dep == null || dep.IsDestroyed) continue;
+                if (dep is not GroundRadarDeployable &&
+                    dep is not MissileTurretDeployable &&
+                    dep is not LaserTurretDeployable &&
+                    dep is not MortarTurretDeployable &&
+                    dep is not TownControlNodeDeployable &&
+                    dep is not TownDepotDeployable)
+                {
+                    continue;
+                }
+
+                uint depDeployerMonarch = dep.DeployerMonarchId;
+                if (depDeployerMonarch == 0 && dep.DeployerPlayerGuid != 0)
+                {
+                    var deployerPlayer = PlayerManager.GetOnlinePlayer(dep.DeployerPlayerGuid);
+                    if (deployerPlayer != null)
+                        depDeployerMonarch = TownCommands.ResolveEffectiveMonarchId(deployerPlayer);
+                }
+
+                bool match = dep.AffiliatedTownId == townId ||
+                    (dep.AffiliatedTownId == 0 && IsObjectInTownBoundary(dep, townId) &&
+                     (!previousOwnerMonarchId.HasValue || previousOwnerMonarchId.Value == 0 ||
+                      dep.OwnerMonarchId == previousOwnerMonarchId.Value ||
+                      depDeployerMonarch == previousOwnerMonarchId.Value));
+                if (!match) continue;
+
+                dep.AffiliatedTownId = townId;
+                dep.OwnerMonarchId = newOwnerMonarchId;
+                if (dep is GroundRadarDeployable groundRadar)
+                {
+                    groundRadar.Policy = policy;
+                    groundRadar.ClearContacts();
+                }
+                dep.BroadcastState();
+            }
+        }
+
+        public static void SyncMonarchRadarPolicies(uint monarchId)
+        {
+            if (monarchId == 0) return;
+            var policy = RadarIff.GetOrCreateMonarchPolicy(monarchId);
+
+            foreach (var station in AirDefenseManager.Stations)
+            {
+                if (station == null || station.IsDestroyed) continue;
+                if (station.EffectiveMonarchId == monarchId)
+                {
+                    station.Policy = policy;
+                    station.Sensor?.ClearTracks();
+                    station.BroadcastState();
+                }
+            }
+
+            foreach (var dep in DeployableManager.GetAll())
+            {
+                if (dep is GroundRadarDeployable gr && !gr.IsDestroyed && gr.EffectiveMonarchId == monarchId)
+                {
+                    gr.Policy = policy;
+                    gr.ClearContacts();
+                    gr.BroadcastState();
+                }
+            }
+        }
