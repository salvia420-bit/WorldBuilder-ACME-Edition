+        public byte VehicleClass { get; set; } = (byte)ACE.Server.Vehicles.VehicleClass.HeavyTractor;
+        public LogisticsLodState LodState { get; set; } = LogisticsLodState.Macro;
+        public LogisticsConvoyStatus Status { get; set; } = LogisticsConvoyStatus.EnRoute;
+        public uint OriginTownId { get; set; }
+        public uint DestTownId { get; set; }
+        public uint OriginPortId { get; set; }
+        public uint DestPortId { get; set; }
+        public uint OriginLandblockId { get; set; }
+        public uint ContainerKind { get; set; }
+        public string CommodityId { get; set; } = "";
