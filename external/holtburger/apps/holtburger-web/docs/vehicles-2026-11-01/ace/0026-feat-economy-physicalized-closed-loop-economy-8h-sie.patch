+        public static LogisticsNavGraph LoadDefault()
+        {
+            var path = FindDefaultPath();
+            if (string.IsNullOrEmpty(path))
+                throw new FileNotFoundException("Could not locate logistics_nav_graph.json via HB_LOGISTICS_NAV_GRAPH, HOLTBURGER_DIST, AppContext.BaseDirectory parent walk, or standard dist paths.");
+
+            lock (_cacheLock)
+            {
+                if (_cachedDefault != null && string.Equals(_cachedDefaultPath, path, StringComparison.Ordinal))
+                    return _cachedDefault;
+
+                var loaded = LoadFromFile(path);
+                _cachedDefault = loaded;
+                _cachedDefaultPath = path;
+                return loaded;
+            }
+        }
