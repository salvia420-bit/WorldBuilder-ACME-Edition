+        public static bool TryInterdictConvoy(ulong convoyId, Player interdictor, bool captureCargo, out string error)
+        {
+            error = null;
+            if (!_convoys.TryGetValue(convoyId, out var convoy))
+            {
+                error = $"Convoy {convoyId} not found.";
+                return false;
+            }
+            if (interdictor == null || interdictor.Location == null)
+            {
+                error = "Interdictor player location required.";
+                return false;
+            }
+
+            uint interdictorMonarch = TownCommands.ResolveEffectiveMonarchId(interdictor);
+            var (px, py, _) = VehicleManager.GetObserverGlobalPosition(interdictor);
+
+            uint capturedDestTown = 0;
+            string seizedCommodity;
+            int seizedQty;
+            uint originLb;
+            Vehicle toDespawn;
+
+            lock (convoy.SyncRoot)
+            {
+                if (convoy.Status == LogisticsConvoyStatus.Arrived ||
+                    convoy.Status == LogisticsConvoyStatus.Aborted ||
+                    convoy.Status == LogisticsConvoyStatus.Interdicted)
+                {
+                    error = $"Convoy {convoyId} is already {convoy.Status}.";
+                    return false;
+                }
+
+                double dx = convoy.WorldX - px;
+                double dy = convoy.WorldY - py;
+                double dist = Math.Sqrt(dx * dx + dy * dy);
+                if (dist > InterdictionRangeM)
+                {
+                    error = $"Move within {InterdictionRangeM:0} m of the convoy to interdict (currently {dist:0.0} m).";
+                    return false;
+                }
+
+                if (interdictorMonarch != 0 && interdictorMonarch == convoy.OwnerMonarchId)
+                {
+                    error = "Cannot interdict your own Allegiance's convoy.";
+                    return false;
+                }
+
+                convoy.Status = LogisticsConvoyStatus.Interdicted;
+                convoy.InterdictedByMonarchId = interdictorMonarch;
+                convoy.UpdatedUtc = DateTime.UtcNow;
+
+                toDespawn = convoy.ActiveVehicle;
+                if (toDespawn != null && !toDespawn.IsDestroyed)
+                {
+                    if (toDespawn.Profile.Locomotion == VehicleLocomotion.Marine)
+                    {
+                        convoy.WorldX = toDespawn.MarineState.X;
+                        convoy.WorldY = toDespawn.MarineState.Y;
+                        convoy.WorldZ = 0.0;
+                        convoy.HeadingRad = toDespawn.MarineState.Heading;
+                    }
+                    else
+                    {
+                        convoy.WorldX = toDespawn.State.X;
+                        convoy.WorldY = toDespawn.State.Y;
+                        convoy.WorldZ = toDespawn.State.Z;
+                        convoy.HeadingRad = toDespawn.State.Heading;
+                    }
+                }
+                convoy.ActiveVehicle = null;
+                convoy.VehicleGuid = 0;
+                convoy.LodState = LogisticsLodState.Macro;
+
+                seizedCommodity = convoy.CommodityId;
+                seizedQty = convoy.CommodityQty;
+                originLb = convoy.OriginLandblockId;
+
+                if (captureCargo && !string.IsNullOrWhiteSpace(seizedCommodity) && seizedQty > 0)
+                {
+                    var resolved = VehicleManager.VehicleOf(interdictor) != null
+                        ? TownRegistry.ResolveTownGlobal(px, py)
+                        : (TownRegistry.ResolveTown(interdictor.Location) ?? TownRegistry.ResolveTownGlobal(px, py));
+                    if (resolved != null)
+                        capturedDestTown = resolved.TownId;
+                    convoy.CommodityQty = 0;
+                }
+            }
+
+            if (toDespawn != null)
+            {
+                try { VehicleManager.Despawn(toDespawn, "convoy-interdicted"); } catch { }
+            }
+
+            if (capturedDestTown != 0 && !string.IsNullOrWhiteSpace(seizedCommodity) && seizedQty > 0)
+            {
+                TownEconomyManager.RecordWarehouseDelivery(capturedDestTown, seizedCommodity, seizedQty);
+            }
+
+            PersistConvoy(convoy);
+            ConvoyInterdicted?.Invoke(convoyId, interdictorMonarch, originLb);
+            BroadcastConvoyState(convoy);
+            return true;
+        }
