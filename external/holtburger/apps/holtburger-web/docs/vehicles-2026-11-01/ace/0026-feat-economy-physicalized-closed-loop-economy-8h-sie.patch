+        private static (int Status, object Payload) ExecuteTownSiegePost(uint townId, JsonElement body)
+        {
+            var snap = SiegeManager.GetSiegeState(townId);
+            if (snap == null)
+                return (404, new { error = $"Town {townId} not found." });
+
+            string action = GetJsonString(body, "action").ToLowerInvariant();
+            if (action == "probe_alert")
+            {
+                string alertType = GetJsonString(body, "alertType", "supply_low");
+                if (alertType is not ("siege_started" or "supply_low" or "convoy_interdicted" or "town_flipped"))
+                    return (400, new { error = $"Unsupported alertType '{alertType}'." });
+
+                string message = GetJsonString(body, "message", $"Gateway alert probe: {alertType} on town {townId}");
+                if (alertType == "convoy_interdicted")
+                {
+                    BroadcastAlertPayload("convoy_interdicted", townId, 0UL, 0u, 0u, message);
+                }
+                else
+                {
+                    EnsureSubscribed();
+                    SiegeManager.RaiseSiegeAlert(townId, alertType, message);
+                }
+                return (200, new { ok = true, alertType, townId, message });
+            }
+
+            var actor = ResolveActor(body);
+            if (actor == null)
+                return (403, new { error = "Physical online player actor required for siege actions." });
+
+            switch (action)
+            {
+                case "claim":
+                {
+                    if (!TownCommands.IsAllegianceMonarch(actor))
+                        return (403, new { error = "Only an Allegiance Monarch may submit a Town Charter claim." });
+                    if (actor.Location == null || actor.Location.Indoors)
+                        return (422, new { error = $"Actor must be outdoors within {SiegeManager.ControlRingRadiusM:0}m of the Town Control Node." });
+
+                    var def = TownRegistry.GetById(townId);
+                    bool withinRing;
+                    if (SiegeManager.TryGetHydratedControlNode(townId, out var node))
+                    {
+                        withinRing = node.IsPlayerInsideControlRing(actor);
+                    }
+                    else
+                    {
+                        var (px, py, _) = Vehicle.ToGlobal(actor.Location);
+                        withinRing = SiegeManager.IsWithinControlRing((float)Math.Sqrt(Math.Pow(px - def.WorldX, 2) + Math.Pow(py - def.WorldY, 2)));
+                    }
+                    if (!withinRing)
+                        return (422, new { error = $"Actor must stand within {SiegeManager.ControlRingRadiusM:0}m of {def.Name}'s Town Control Node." });
+
+                    var charter = TownCommands.FindTownCharterItem(actor);
+                    if (!SiegeManager.TryStartClaim(townId, actor, charter != null, out var err))
+                        return (422, new { error = err });
+
+                    TownCommands.ConsumeCharterItem(actor, charter);
+                    return (200, new { ok = true, message = err, siege = SiegeManager.GetSiegeState(townId) });
+                }
+
+                case "deliver_supply":
+                {
+                    uint originLb = GetJsonUInt(body, "originLandblockId");
+                    if (!TryParseOptionalPositiveFiniteDouble(body, "supplyPoints", 10.0, out double supplyPoints))
+                        return (422, new { error = "Positive finite supplyPoints required for supply delivery." });
+                    double? explicitDistanceM = TryGetJsonDouble(body, "distanceM");
+                    double fuelLiters = GetJsonDouble(body, "fuelLiters", 0.0);
+
+                    if (!double.IsFinite(fuelLiters) || fuelLiters <= 0.0)
+                        return (422, new { error = "Positive finite fuelLiters required for supply delivery." });
+                    if (explicitDistanceM.HasValue && (!double.IsFinite(explicitDistanceM.Value) || explicitDistanceM.Value < SiegeManager.MinProvenanceDistanceM))
+                        return (422, new { error = $"Origin-provenance check failed: distance {explicitDistanceM.Value:0.0}m < {SiegeManager.MinProvenanceDistanceM:0}m." });
+
+                    var hydrated = SiegeManager.GetHydratedEntities(townId);
+                    if (hydrated != null && hydrated.BeaconGuid != 0 &&
+                        DeployableManager.GetDeployable(hydrated.BeaconGuid) is ForwardSiegeBeaconDeployable beacon &&
+                        !beacon.IsDestroyed && beacon.Location != null && actor.Location != null)
+                    {
+                        var (px, py, pz) = Vehicle.ToGlobal(actor.Location);
+                        var dist = Vector3.Distance(beacon.GlobalPosition, new Vector3((float)px, (float)py, (float)pz));
+                        if (dist > ForwardSiegeBeaconDeployable.DeliveryRadiusM)
+                            return (422, new { error = $"Actor must be within {ForwardSiegeBeaconDeployable.DeliveryRadiusM:0}m of Forward Siege Beacon." });
+                    }
+
+                    if (!SiegeManager.DeliverSiegeSupply(townId, originLb, supplyPoints, actor, out var err))
+                        return (422, new { error = err });
+
+                    return (200, new { ok = true, message = err, siege = SiegeManager.GetSiegeState(townId) });
+                }
+
+                default:
+                    return (400, new { error = $"Unsupported siege action '{action}'." });
+            }
+        }
