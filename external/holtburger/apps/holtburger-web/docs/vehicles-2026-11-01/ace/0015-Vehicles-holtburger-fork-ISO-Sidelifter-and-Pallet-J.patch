+        private static bool ContainersOverlap2DAndZ(
+            double ax, double ay, double az, double aHeading, Vector3 aDims,
+            double bx, double by, double bz, double bHeading, Vector3 bDims)
+        {
+            if (az >= bz + bDims.Z - 0.05 || bz >= az + aDims.Z - 0.05)
+                return false;
+
+            double halfAX = aDims.X * 0.5;
+            double halfAY = aDims.Y * 0.5;
+            double halfBX = bDims.X * 0.5;
+            double halfBY = bDims.Y * 0.5;
+
+            double cosA = Math.Cos(aHeading), sinA = Math.Sin(aHeading);
+            double cosB = Math.Cos(bHeading), sinB = Math.Sin(bHeading);
+
+            // AC local X = (cosH, -sinH), local Y = (sinH, cosH)
+            double uAx = cosA, uAy = -sinA;
+            double vAx = sinA, vAy = cosA;
+            double uBx = cosB, uBy = -sinB;
+            double vBx = sinB, vBy = cosB;
+
+            double dx = bx - ax;
+            double dy = by - ay;
+
+            bool SeparatedOnAxis(double axisX, double axisY)
+            {
+                double dist = Math.Abs(dx * axisX + dy * axisY);
+                double projA = halfAX * Math.Abs(uAx * axisX + uAy * axisY) + halfAY * Math.Abs(vAx * axisX + vAy * axisY);
+                double projB = halfBX * Math.Abs(uBx * axisX + uBy * axisY) + halfBY * Math.Abs(vBx * axisX + vBy * axisY);
+                return dist >= projA + projB - 1e-3;
+            }
+
+            if (SeparatedOnAxis(uAx, uAy)) return false;
+            if (SeparatedOnAxis(vAx, vAy)) return false;
+            if (SeparatedOnAxis(uBx, uBy)) return false;
+            if (SeparatedOnAxis(vBx, vBy)) return false;
+            return true;
+        }
