+        public bool TryDropToGround(Player player, out WorldObject spawned, out string error, bool activateOnDrop = false)
+        {
+            spawned = null;
+            error = null;
+            if (IsDestroyed || StowedOnTrailerGuid != 0 || !IsActive)
+            {
+                error = "Pallet jack is unavailable.";
+                return false;
+            }
+            if (player == null || OperatorPlayerGuid != player.Guid.Full)
+            {
+                error = "Grab pallet jack before dropping cargo.";
+                return false;
+            }
+            if (CarriedWcid == 0)
+            {
+                error = "Pallet jack is not carrying a pallet.";
+                return false;
+            }
+            if (OnContainerRampOrFloor)
+            {
+                error = "Roll out of the container onto ground before placing deployable.";
+                return false;
+            }
+
+            var jPos = GlobalPosition;
+            double dropX = jPos.X + Math.Sin(HeadingRad) * 0.65;
+            double dropY = jPos.Y + Math.Cos(HeadingRad) * 0.65;
+            double gz = VehicleManager.SampleTrailerTerrainZ(dropX, dropY, jPos.Z);
+            if (!double.IsFinite(gz) || gz < 0.0)
+            {
+                error = "Invalid or underwater ground drop location.";
+                return false;
+            }
+
+            foreach (var d in DeployableManager.GetAll())
+            {
+                if (d is not IsoContainerDeployable c || c.IsDestroyed || c.IsPacked || !c.IsActive)
+                    continue;
+                if (c.ProbeWalkableSupport((float)dropX, (float)dropY, (float)gz).Found ||
+                    c.ProbeWalkableSupport((float)dropX, (float)dropY, jPos.Z).Found)
+                {
+                    error = "Roll out of the container onto clear ground before placing deployable.";
+                    return false;
+                }
+                if (Math.Abs(c.Position.Z - gz) <= 1.5)
+                {
+                    float dxC = (float)dropX - c.Position.X;
+                    float dyC = (float)dropY - c.Position.Y;
+                    float cosH = (float)Math.Cos(c.HeadingRad);
+                    float sinH = (float)Math.Sin(c.HeadingRad);
+                    float lx = dxC * cosH - dyC * sinH;
+                    float ly = dxC * sinH + dyC * cosH;
+                    if (Math.Abs(lx) <= c.ExternalDimensions.X * 0.5f && Math.Abs(ly) <= c.ExternalDimensions.Y * 0.5f)
+                    {
+                        error = "Cannot place deployable inside a container footprint.";
+                        return false;
+                    }
+                }
+            }
+
+            var bridgeDrop = VehicleColliderCache.GetBridgeSupport((float)dropX, (float)dropY, jPos.Z);
+            if (bridgeDrop.Found)
+            {
+                if (bridgeDrop.Nz < Physics.PhysicsGlobals.FloorZ)
+                {
+                    error = "Terrain is too steep to place deployable.";
+                    return false;
+                }
+            }
+            else
+            {
+                var tCenter = VehicleTerrain.HeightAt((float)dropX, (float)dropY);
+                var gzX = VehicleTerrain.HeightAt((float)dropX + 0.5f, (float)dropY);
+                var gzY = VehicleTerrain.HeightAt((float)dropX, (float)dropY + 0.5f);
+                if (!float.IsNaN(tCenter) && !float.IsNaN(gzX) && !float.IsNaN(gzY))
+                {
+                    var normal = Vector3.Normalize(new Vector3(-(gzX - tCenter) / 0.5f, -(gzY - tCenter) / 0.5f, 1.0f));
+                    if (normal.Z < Physics.PhysicsGlobals.FloorZ)
+                    {
+                        error = "Terrain is too steep to place deployable.";
+                        return false;
+                    }
+                }
+            }
+
+            var dropPos = Vehicle.ToPosition(dropX, dropY, gz, Vehicle.YawOnly(HeadingRad));
+            if (dropPos == null || dropPos.LandblockId.LandblockX > 254 || dropPos.LandblockId.LandblockY > 254)
+            {
+                error = "Drop location is outside valid world bounds.";
+                return false;
+            }
+
+            if (CarriedWcid == 4000002)
+            {
+                var weenie = AirDefense.RadarStation.BuildWeenie(null, player);
+                ObjectGuid guid;
+                try { guid = GuidManager.NewDynamicGuid(); }
+                catch (NullReferenceException) { guid = new ObjectGuid(0x75000000u | ((uint)new Random().Next(0x00010000, 0x000FFFFF))); }
+
+                var station = new AirDefense.RadarStation(weenie, guid, null, player)
+                {
+                    Location = dropPos,
+                    IsActive = activateOnDrop,
+                };
+                if (!DeployableManager.TryEnterWorld(station))
+                {
+                    try { GuidManager.RecycleDynamicGuid(guid); } catch (NullReferenceException) { }
+                    error = "Failed to place radar station in world.";
+                    return false;
+                }
+                AirDefense.AirDefenseManager.RegisterStation(station);
+                spawned = station;
+            }
+            else
+            {
+                var dep = DeployableManager.SpawnDeployable(CarriedWcid, dropPos, player);
+                if (dep == null)
+                {
+                    error = "Failed to place deployable in world.";
+                    return false;
+                }
+                if (CarriedCargoState.HasState)
+                    dep.RestoreCargoState(CarriedCargoState);
+                dep.SetStowed(!activateOnDrop, player);
+                spawned = dep;
+            }
+
+            CarriedWcid = 0;
+            CarriedPalletSize = PalletSize.None;
+            CarriedCargoState = default;
+            ForkHeightM = LoweredForkHeightM;
+            ForkState = 0;
+            BroadcastState();
+            return true;
+        }
+
+        private IsoContainerDeployable ResolveContainerTarget(uint containerGuid)
+        {
+            if (containerGuid != 0)
+                return DeployableManager.GetDeployable(containerGuid) as IsoContainerDeployable;
+            return DeployableManager.FindNearbyGlobal<IsoContainerDeployable>(GlobalPosition, 12.0f, includeInactive: false);
+        }
+
+        private bool IsNearContainerSlot(IsoContainerDeployable container, int slotIndex, int subSlot, PalletSize palletSize, out string error)
+        {
+            error = null;
+            if (!ContainerLogistics.ResolveSpec(container.Kind, out var interior, out var slotDefs))
+            {
+                error = "Invalid container type.";
+                return false;
+            }
+            if (slotIndex < 0 || slotIndex >= slotDefs.Length)
+            {
+                error = $"Invalid container bay slot {slotIndex}.";
+                return false;
+            }
+
+            var jPos = GlobalPosition;
+            var cPos = container.Position;
+            double dx = jPos.X - cPos.X;
+            double dy = jPos.Y - cPos.Y;
+            double cosH = Math.Cos(container.HeadingRad);
+            double sinH = Math.Sin(container.HeadingRad);
+            double localX = dx * cosH - dy * sinH;
+            double localY = dx * sinH + dy * cosH;
+
+            if (Math.Abs(localX) > 1.5 || localY < -(interior.HalfL + 1.8) || localY > interior.HalfL + 0.5)
+            {
+                error = "Position pallet jack inside container before engaging bay slots.";
+                return false;
+            }
+
+            var box = ContainerLogistics.GetSlotSubBox(in slotDefs[slotIndex], palletSize, subSlot);
+            double distToSlot = Math.Sqrt((localX - box.X) * (localX - box.X) + (localY - box.Y) * (localY - box.Y));
+            if (distToSlot > MaxSlotEngageDistanceM)
+            {
+                error = $"Move pallet jack closer to bay {slotIndex} ({distToSlot:0.00} m > {MaxSlotEngageDistanceM:0.0} m).";
+                return false;
+            }
+
+            return true;
+        }
+
+        public bool TryPickContainerSlot(Player player, uint containerGuid, byte slotIndex, byte subSlot, out string error)
+        {
+            error = null;
+            if (IsDestroyed || StowedOnTrailerGuid != 0 || !IsActive)
+            {
+                error = "Pallet jack is unavailable.";
+                return false;
+            }
+            if (player == null || OperatorPlayerGuid != player.Guid.Full)
+            {
+                error = "Grab pallet jack before unloading container.";
+                return false;
+            }
+            if (CarriedWcid != 0)
+            {
+                error = "Pallet jack is already carrying a pallet.";
+                return false;
+            }
+            if (ForkHeightM > 0.10f)
+            {
+                error = "ISO 3691-5: Lower forks completely before engaging a pallet.";
+                return false;
+            }
+
+            var container = ResolveContainerTarget(containerGuid);
+            if (container == null || container.IsDestroyed || container.IsPacked || !container.IsActive)
+            {
+                error = "Target container not found.";
+                return false;
+            }
+            if (container.MountedOnTrailerGuid != 0 || SemiTrailerDeployable.IsContainerInSideliftTransfer(container.Guid.Full))
+            {
+                error = "ISO 3874: Offload container to ground before pallet jack unloading.";
+                return false;
+            }
+            if (container.DoorProgress < 0.95f)
+            {
+                error = "Open container doors completely before unloading.";
+                return false;
+            }
+            if (slotIndex >= container.Slots.Count)
+            {
+                error = $"Invalid container bay slot {slotIndex}.";
+                return false;
+            }
+            if (subSlot > 1)
+            {
+                error = $"Invalid sub-slot {subSlot}.";
+                return false;
+            }
+
+            var slotObj = container.Slots[slotIndex];
+            var slotSize = slotObj.OccupiedPalletSize != PalletSize.None ? slotObj.OccupiedPalletSize : PalletSize.Full;
+            if (!IsNearContainerSlot(container, slotIndex, subSlot, slotSize, out error))
+                return false;
+
+            var lifo = ContainerLogistics.IsSlotReachableForUnload(container, slotIndex, subSlot);
+            if (!lifo.Reachable)
+            {
+                error = lifo.BlockedBySlotIndex.HasValue
+                    ? $"ISO LIFO: Blocked by Bay {lifo.BlockedBySlotIndex.Value} — clear front pallet first."
+                    : $"Slot {slotIndex} cannot be unloaded ({lifo.Reason}).";
+                return false;
+            }
+
+            if (!container.TryUnpackSlot(slotIndex, out uint wcid, out PalletCargoState cargoState, (sbyte)subSlot))
+            {
+                error = $"Slot {slotIndex} is empty or unavailable.";
+                return false;
+            }
+
+            CarriedWcid = wcid;
+            CarriedPalletSize = IsoContainerDeployable.DeterminePalletSize(wcid);
+            CarriedCargoState = cargoState;
+            ForkHeightM = RaisedForkHeightM;
+            ForkState = 2; // Raised
+
+            container.BroadcastState();
+            BroadcastState();
+            return true;
+        }
+
+        public bool TryLoadContainerSlot(Player player, uint containerGuid, byte slotIndex, byte subSlot, out string error)
+        {
+            error = null;
+            if (IsDestroyed || StowedOnTrailerGuid != 0 || !IsActive)
+            {
+                error = "Pallet jack is unavailable.";
+                return false;
+            }
+            if (player == null || OperatorPlayerGuid != player.Guid.Full)
+            {
+                error = "Grab pallet jack before loading container.";
+                return false;
+            }
+            if (CarriedWcid == 0)
+            {
+                error = "Pallet jack is not carrying a pallet.";
+                return false;
+            }
+
+            var container = ResolveContainerTarget(containerGuid);
+            if (container == null || container.IsDestroyed || container.IsPacked || !container.IsActive)
+            {
+                error = "Target container not found.";
+                return false;
+            }
+            if (container.MountedOnTrailerGuid != 0 || SemiTrailerDeployable.IsContainerInSideliftTransfer(container.Guid.Full))
+            {
+                error = "ISO 3874: Offload container to ground before pallet jack loading.";
+                return false;
+            }
+            if (container.DoorProgress < 0.95f)
+            {
+                error = "Open container doors completely before loading.";
+                return false;
+            }
+
+            var palletSize = CarriedPalletSize != PalletSize.None
+                ? CarriedPalletSize
+                : IsoContainerDeployable.DeterminePalletSize(CarriedWcid);
+            if (palletSize == PalletSize.None)
+            {
+                error = "Carried cargo has no valid GMA pallet size.";
+                return false;
+            }
+            if (subSlot > 1 || (palletSize == PalletSize.Full && subSlot != 0))
+            {
+                error = $"Invalid sub-slot {subSlot} for {palletSize} pallet.";
+                return false;
+            }
+
+            if (!IsNearContainerSlot(container, slotIndex, subSlot, palletSize, out error))
+                return false;
+
+            var lifo = ContainerLogistics.IsSlotReachableForLoad(container, slotIndex, subSlot, palletSize);
+            if (!lifo.Reachable)
+            {
+                if (lifo.Reason == "slot_occupied")
+                    error = $"Bay {slotIndex} is already occupied.";
+                else if (lifo.BlockedBySlotIndex.HasValue)
+                    error = $"ISO LIFO: Bay {slotIndex} path blocked by Bay {lifo.BlockedBySlotIndex.Value}.";
+                else
+                    error = $"Bay {slotIndex} cannot be loaded ({lifo.Reason}).";
+                return false;
+            }
+
+            if (!container.TryLoadWcid(slotIndex, CarriedWcid, palletSize, subSlot, ignoreDoorState: false, cargoState: CarriedCargoState))
+            {
+                error = $"Failed to load pallet into bay {slotIndex}.";
+                return false;
+            }
+
+            CarriedWcid = 0;
+            CarriedPalletSize = PalletSize.None;
+            CarriedCargoState = default;
+            ForkHeightM = LoweredForkHeightM;
+            ForkState = 0;
+
+            container.BroadcastState();
+            BroadcastState();
+            return true;
+        }
+
+        protected override bool BroadcastDespawnOnDestroy => false;
+
+        public override void Destroy(bool raiseNotifyOfDestructionEvent = true, bool fromLandblockUnload = false)
+        {
+            if (IsDestroyed) return;
+
+            var opPlayer = OperatorPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(OperatorPlayerGuid) : null;
+            if (!fromLandblockUnload && OperatorPlayerGuid != 0)
+                ForceRelease();
+            else
+            {
+                OperatorPlayerGuid = 0;
+                TillerAngle = 0f;
+                LastPoseUtc = default;
+                _poseBudgetM = MaxPoseBudgetM;
+            }
+
+            if (StowedOnTrailerGuid != 0)
+            {
+                var trailer = DeployableManager.GetDeployable(StowedOnTrailerGuid) as SemiTrailerDeployable;
+                if (trailer != null && trailer.StowedPalletJackGuid == Guid.Full)
+                {
+                    trailer.StowedPalletJackGuid = 0;
+                    if (!fromLandblockUnload && !trailer.IsDestroyed)
+                        trailer.BroadcastState();
+                }
+                StowedOnTrailerGuid = 0;
+            }
+
+            if (!fromLandblockUnload && Location != null && PhysicsObj != null)
+            {
+                var actor = opPlayer ?? (DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null);
+                var at = new Position(Location);
+                var guid = Guid.Full;
+                VehicleManager.BroadcastNear(at, 600.0f, actor, () => new VehicleEventMsg
+                {
+                    Vehicle = guid,
+                    Kind = (uint)VehicleEventKind.Despawn,
+                    Step = 0,
+                    Subject = guid,
+                    Cell = at.Cell,
+                    Position = at.Pos,
+                    Value = 0f,
+                });
+            }
+
+            base.Destroy(raiseNotifyOfDestructionEvent, fromLandblockUnload);
+        }
+    }
+}
