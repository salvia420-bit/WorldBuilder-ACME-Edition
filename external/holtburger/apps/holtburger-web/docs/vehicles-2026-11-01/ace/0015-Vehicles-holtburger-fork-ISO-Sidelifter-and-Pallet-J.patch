+        public bool CheckOutriggerAndDropTerrain(sbyte side, double spanY, double slotLocalY, out double centerDropZ, out string reason)
+        {
+            reason = null;
+            sbyte effSide = side < 0 ? (sbyte)-1 : (sbyte)1;
+            var (tx, ty, tz) = GetGlobalPose();
+            var (cxOff, cyOff, _) = TrailerKinematics.RotateByOrientation(HeadingRad, 0.0, 0.0, effSide * SidelifterKinematics.SidelifterOutreachX, slotLocalY, 0.0);
+            centerDropZ = VehicleManager.SampleTrailerTerrainZ(tx + cxOff, ty + cyOff, tz);
+            if (!double.IsFinite(centerDropZ) || centerDropZ < 0.0)
+            {
+                reason = "ISO 3874: Invalid or underwater sidelifter transfer zone.";
+                return false;
+            }
+
+            double yF = slotLocalY + spanY;
+            double yR = slotLocalY - spanY;
+
+            // Drop container 4-corner footprint
+            double zFL = SampleCornerZ(effSide * SidelifterKinematics.SidelifterOutreachX - 1.22, yF, tz);
+            double zFR = SampleCornerZ(effSide * SidelifterKinematics.SidelifterOutreachX + 1.22, yF, tz);
+            double zRL = SampleCornerZ(effSide * SidelifterKinematics.SidelifterOutreachX - 1.22, yR, tz);
+            double zRR = SampleCornerZ(effSide * SidelifterKinematics.SidelifterOutreachX + 1.22, yR, tz);
+            if (!double.IsFinite(zFL) || !double.IsFinite(zFR) || !double.IsFinite(zRL) || !double.IsFinite(zRR) ||
+                zFL < 0.0 || zFR < 0.0 || zRL < 0.0 || zRR < 0.0)
+            {
+                reason = "ISO 3874: Outrigger/drop footprint extends over invalid terrain.";
+                return false;
+            }
+            var dropSlope = SidelifterKinematics.CheckOutriggerSlope(zFL, zFR, zRL, zRR, 2.44, 2.0 * spanY);
+            if (!dropSlope.Ok)
+            {
+                reason = $"ISO 3874: Ground slope ({dropSlope.SlopeDeg:0.0} deg) exceeds 6 deg sidelifter limit.";
+                return false;
+            }
+
+            // Cross-chassis to outrigger pad slope check
+            double cFL = SampleCornerZ(0.0, +spanY, tz);
+            double cRL = SampleCornerZ(0.0, -spanY, tz);
+            double oFR = SampleCornerZ(effSide * SidelifterKinematics.OutriggerReachX, +spanY, tz);
+            double oRR = SampleCornerZ(effSide * SidelifterKinematics.OutriggerReachX, -spanY, tz);
+            if (double.IsFinite(cFL) && double.IsFinite(cRL) && double.IsFinite(oFR) && double.IsFinite(oRR))
+            {
+                var outriggerSlope = effSide > 0
+                    ? SidelifterKinematics.CheckOutriggerSlope(cFL, oFR, cRL, oRR, SidelifterKinematics.OutriggerReachX, 2.0 * spanY)
+                    : SidelifterKinematics.CheckOutriggerSlope(oFR, cFL, oRR, cRL, SidelifterKinematics.OutriggerReachX, 2.0 * spanY);
+                if (!outriggerSlope.Ok)
+                {
+                    reason = $"ISO 3874: Outrigger terrain slope ({outriggerSlope.SlopeDeg:0.0} deg) exceeds 6 deg limit.";
+                    return false;
+                }
+            }
+
+            return true;
+        }
