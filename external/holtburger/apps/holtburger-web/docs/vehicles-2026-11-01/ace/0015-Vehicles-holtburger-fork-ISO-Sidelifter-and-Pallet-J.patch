+            var bDereth = (ACE.Server.Physics.Common.BuildingObj)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Physics.Common.BuildingObj));
+            bDereth.CurCell = new ACE.Server.Physics.Common.SortCell { ID = 0xA9B30105u };
+            Assert.AreEqual(0xA9B37FFFu, bDereth.LandblockID, "Dereth building must map to 0x7FFF landblock mask");
+
+            var bDericost = (ACE.Server.Physics.Common.BuildingObj)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Physics.Common.BuildingObj));
+            bDericost.CurCell = new ACE.Server.Physics.Common.SortCell { ID = 0xA9B38105u };
+            Assert.AreEqual(0xA9B3FFFFu, bDericost.LandblockID, "Dericost building must preserve bit 15 (0xFFFF)");
+
+            // 2) LScape.get_landblock distinguishes Dereth (bit 15 = 0) and Dericost (bit 15 = 1)
+            var prevEng = ACE.Server.Physics.PhysicsEngine.Instance;
+            var derethLb = (ACE.Server.Physics.Common.Landblock)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Physics.Common.Landblock));
+            var dericostLb = (ACE.Server.Physics.Common.Landblock)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Physics.Common.Landblock));
+            uint derethKey = 0x10207FFFu;
+            uint dericostKey = 0x1020FFFFu;
+            bool hadD0 = ACE.Server.Physics.Common.LScape.Landblocks.TryGetValue(derethKey, out var prevD0);
+            bool hadD1 = ACE.Server.Physics.Common.LScape.Landblocks.TryGetValue(dericostKey, out var prevD1);
+
+            try
+            {
+                var eng = (ACE.Server.Physics.PhysicsEngine)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Physics.PhysicsEngine));
+                eng.Server = false;
+                ACE.Server.Physics.PhysicsEngine.Instance = eng;
+                ACE.Server.Physics.Common.LScape.Landblocks[derethKey] = derethLb;
+                ACE.Server.Physics.Common.LScape.Landblocks[dericostKey] = dericostLb;
+
+                Assert.AreSame(derethLb, ACE.Server.Physics.Common.LScape.get_landblock(0x10200005u));
+                Assert.AreSame(dericostLb, ACE.Server.Physics.Common.LScape.get_landblock(0x10208005u));
+            }
+            finally
+            {
+                ACE.Server.Physics.PhysicsEngine.Instance = prevEng;
+                if (hadD0) ACE.Server.Physics.Common.LScape.Landblocks[derethKey] = prevD0;
+                else ACE.Server.Physics.Common.LScape.Landblocks.TryRemove(derethKey, out _);
+                if (hadD1) ACE.Server.Physics.Common.LScape.Landblocks[dericostKey] = prevD1;
+                else ACE.Server.Physics.Common.LScape.Landblocks.TryRemove(dericostKey, out _);
+            }
+
+            // 3) Entity.Landblock.HasPlayers detects both active players and pendingAdditions players
+            var lb = (ACE.Server.Entity.Landblock)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Entity.Landblock));
+            var playersList = new List<Player>();
+            var pendingDict = new Dictionary<ObjectGuid, WorldObject>();
+            typeof(ACE.Server.Entity.Landblock).GetField("players", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(lb, playersList);
+            typeof(ACE.Server.Entity.Landblock).GetField("pendingAdditions", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(lb, pendingDict);
+
+            Assert.IsFalse(lb.HasPlayers);
+            var p = CreateTestPlayer(0x50006601u, 100.0, 100.0, 40.0);
+            pendingDict[p.Guid] = p;
+            Assert.IsTrue(lb.HasPlayers, "Landblock with pending Player addition must report HasPlayers = true");
+            pendingDict.Clear();
+            playersList.Add(p);
+            Assert.IsTrue(lb.HasPlayers, "Landblock with active Player must report HasPlayers = true");
+        }
+
+        [TestMethod]
+        public void UnmountContainerRejectedDuringSideliftHoisting()
+        {
+            const int lbX = 16, lbY = 25;
+            uint gridKey = ((uint)lbX << 24) | ((uint)lbY << 16);
+            var gridsField = typeof(VehicleTerrain).GetField("grids", BindingFlags.Static | BindingFlags.NonPublic);
+            var grids = (ConcurrentDictionary<uint, LandblockGrid>)gridsField?.GetValue(null);
+            bool hadPrev = grids.TryGetValue(gridKey, out var prevGrid);
+
+            double x = lbX * 192.0 + 60.0, y = lbY * 192.0 + 60.0, z = 40.0;
+            var flat40 = new float[81];
+            Array.Fill(flat40, 40.0f);
+            grids[gridKey] = new LandblockGrid { Heights = flat40 };
+
+            var player = CreateTestPlayer(0x50006701u, x, y, z);
+            RegisterOnlinePlayer(player);
+            try
+            {
+                var sl = RegisterSidelifter(0x75006701u, x, y, z);
+                var c40 = RegisterContainer(0x75006702u, IsoContainerDeployable.Wcid40ft, x, y, z + 1.32);
+                Assert.IsTrue(sl.TryMountContainer(c40, 0, out _));
+
+                Assert.IsTrue(sl.TryStartSideliftOffload(1, autoCycle: true, out var offErr, player), offErr);
+                StepSidelifterSeconds(sl, 4.5);
+                Assert.AreEqual(SideliftPhase.Hoisting, sl.SideliftPhase);
+
+                Assert.IsFalse(sl.UnmountContainer(out var unmountErr, snapToGround: true));
+                StringAssert.Contains(unmountErr, "active", StringComparison.OrdinalIgnoreCase);
+
+                Assert.IsFalse(VehicleManager.HandleTrailerAction(player, new VehicleTrailerAction
+                {
+                    TrailerGuid = sl.Guid.Full,
+                    Action = (byte)TrailerActionKind.UnmountContainer,
+                }, out var actErr));
+                StringAssert.Contains(actErr, "active", StringComparison.OrdinalIgnoreCase);
+
+                Assert.AreEqual(c40.Guid.Full, sl.MountedContainerGuid);
+                Assert.AreEqual(sl.Guid.Full, c40.MountedOnTrailerGuid);
+
+                sl.Destroy(true, false);
+            }
+            finally
+            {
+                UnregisterOnlinePlayer(player.Guid.Full);
+                if (hadPrev) grids[gridKey] = prevGrid;
+                else grids.TryRemove(gridKey, out _);
+            }
+        }
+
+        [TestMethod]
+        public void UnhitchTrailerActionRejectedWhileMovingAndDuringOutriggersDeploying()
+        {
+            const int lbX = 16, lbY = 26;
+            uint gridKey = ((uint)lbX << 24) | ((uint)lbY << 16);
+            var gridsField = typeof(VehicleTerrain).GetField("grids", BindingFlags.Static | BindingFlags.NonPublic);
+            var grids = (ConcurrentDictionary<uint, LandblockGrid>)gridsField?.GetValue(null);
+            bool hadPrev = grids.TryGetValue(gridKey, out var prevGrid);
+
+            double x = lbX * 192.0 + 60.0, y = lbY * 192.0 + 60.0, z = 40.0;
+            var flat40 = new float[81];
+            Array.Fill(flat40, 40.0f);
+            grids[gridKey] = new LandblockGrid { Heights = flat40 };
+
+            var player = CreateTestPlayer(0x50006801u, x, y, z);
+            RegisterOnlinePlayer(player);
+            try
+            {
+                var tractor = CreateTestSemi(0x75006801u, x, y, z);
+                var fw = TrailerKinematics.ComputeFifthWheelPose(tractor.GroundState, tractor.Profile.FifthWheelOffsetY, tractor.Profile.FifthWheelOffsetZ);
+                var sl = RegisterSidelifter(0x75006802u, fw.x, fw.y - TrailerKinematics.Chassis40.KpY, z);
+                var c40 = RegisterContainer(0x75006803u, IsoContainerDeployable.Wcid40ft, fw.x, fw.y - TrailerKinematics.Chassis40.KpY, z + 1.32);
+
+                Assert.IsTrue(VehicleManager.TryHitchTrailer(tractor, sl, player, out _));
+                Assert.IsTrue(sl.TryMountContainer(c40, 0, out _));
+
+                // [N3] Moving at 15 m/s must reject TrailerActionKind.Unhitch
+                tractor.GroundState.Mode = VehicleMode.Driving;
+                tractor.GroundState.Speed = 15.0;
+                tractor.State = tractor.GroundState.ToFlightState();
+                Assert.IsFalse(VehicleManager.HandleTrailerAction(player, new VehicleTrailerAction
+                {
+                    VehicleGuid = tractor.Guid.Full,
+                    TrailerGuid = sl.Guid.Full,
+                    Action = (byte)TrailerActionKind.Unhitch,
+                }, out var moveErr));
+                StringAssert.Contains(moveErr, "Stop", StringComparison.OrdinalIgnoreCase);
+                Assert.AreEqual(sl.Guid.Full, tractor.HitchedTrailerGuid);
+
+                // Restore parked state
+                tractor.GroundState.Mode = VehicleMode.Parked;
+                tractor.GroundState.Speed = 0.0;
+                tractor.State = tractor.GroundState.ToFlightState();
+
+                // [N3b] OutriggersDeploying must reject TrailerActionKind.Unhitch
+                Assert.IsTrue(sl.TryStartSideliftOffload(1, autoCycle: true, out var offErr, player), offErr);
+                Assert.AreEqual(SideliftPhase.OutriggersDeploying, sl.SideliftPhase);
+                Assert.IsFalse(VehicleManager.HandleTrailerAction(player, new VehicleTrailerAction
+                {
+                    VehicleGuid = tractor.Guid.Full,
+                    TrailerGuid = sl.Guid.Full,
+                    Action = (byte)TrailerActionKind.Unhitch,
+                }, out var phaseErr));
+                StringAssert.Contains(phaseErr, "sidelifter", StringComparison.OrdinalIgnoreCase);
+                Assert.AreEqual(sl.Guid.Full, tractor.HitchedTrailerGuid);
+
+                // Cancel and retract to Idle -> Unhitch succeeds
+                Assert.IsTrue(sl.CancelSidelift(out var cancelErr), cancelErr);
+                StepSidelifterSeconds(sl, 2.5);
+                Assert.AreEqual(SideliftPhase.Idle, sl.SideliftPhase);
+
+                Assert.IsTrue(VehicleManager.HandleTrailerAction(player, new VehicleTrailerAction
+                {
+                    VehicleGuid = tractor.Guid.Full,
+                    TrailerGuid = sl.Guid.Full,
+                    Action = (byte)TrailerActionKind.Unhitch,
+                }, out var okErr), okErr);
+                Assert.AreEqual(0u, tractor.HitchedTrailerGuid);
+            }
+            finally
+            {
+                UnregisterOnlinePlayer(player.Guid.Full);
+                if (hadPrev) grids[gridKey] = prevGrid;
+                else grids.TryRemove(gridKey, out _);
+            }
+        }
+    }
+}
