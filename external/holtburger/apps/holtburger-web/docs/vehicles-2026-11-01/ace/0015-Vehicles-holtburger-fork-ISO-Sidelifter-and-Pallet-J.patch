+        [TestMethod]
+        public void DeployableStowInterlockMicroGridAndTurretElevation()
+        {
+            double x = 3400.0, y = 4400.0, z = 40.0;
+            VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = z, Nz = 1.0 };
+
+            var player = CreateTestPlayer(0x50007201u, x + 1.0, y, z);
+            var flux = new FluxPodDeployable(FluxPodDeployable.BuildWeenie(), new ObjectGuid(0x75007201u), null, player)
+            {
+                Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity)
+            };
+            flux.Grid.Center = flux.Position;
+            DeployableManager.RegisterGrid(flux.Grid);
+            DeployableManager.Register(flux);
+
+            var turret = new MissileTurretDeployable(MissileTurretDeployable.BuildWeenie(), new ObjectGuid(0x75007202u), null, player)
+            {
+                Location = Vehicle.ToPosition(x + 1.0, y, z, Quaternion.Identity),
+                ElevationM = 0.85f,
+                AmmoRemaining = 2,
+            };
+            flux.Grid.Register(turret);
+            DeployableManager.Register(turret);
+
+            var jack = new PalletJackDeployable(new Vector3((float)(x + 1.0), (float)y, (float)z), 0f, player);
+            DeployableManager.Register(jack);
+            Assert.IsTrue(jack.TryGrab(player, out _));
+
+            // 1) Refuses pickup when unstowed/active
+            Assert.IsFalse(jack.TryPickGroundDeployable(player, turret.Guid.Full, out var stowErr));
+            StringAssert.Contains(stowErr, "Stow", StringComparison.OrdinalIgnoreCase);
+
+            // 2) Stow via 0x0910 ToggleDeployableStow -> OnlineFlags |= 0x10, ElevationM = 0, unregistered from MicroGrid
+            Assert.IsTrue(VehicleManager.HandlePalletJackAction(player, new VehiclePalletJackAction
+            {
+                Action = (byte)PalletJackActionKind.ToggleDeployableStow,
+                TargetGuid = turret.Guid.Full,
+            }, out var tErr), tErr);
+            Assert.IsTrue(turret.IsStowed);
+            Assert.IsFalse(turret.IsActive);
+            Assert.AreEqual(0.0f, turret.ElevationM, 1e-6f);
+            Assert.IsNull(turret.Grid);
+            Assert.AreEqual(DeployableOnlineFlags.Stowed, turret.CreateStateMsg().OnlineFlags);
+
+            // 3) Refuses pickup if forks raised
+            Assert.IsTrue(jack.RaiseForks(player, out _));
+            Assert.IsFalse(jack.TryPickGroundDeployable(player, turret.Guid.Full, out var forkErr));
+            StringAssert.Contains(forkErr, "Lower forks", StringComparison.OrdinalIgnoreCase);
+
+            // 4) Lower forks -> pick succeeds, preserves AmmoRemaining = 2, raises forks to 0.200m
+            Assert.IsTrue(jack.LowerForks(player, out _));
+            Assert.IsTrue(jack.TryPickGroundDeployable(player, turret.Guid.Full, out var pickErr), pickErr);
+            Assert.AreEqual(MissileTurretDeployable.MissileTurretWeenieClassId, jack.CarriedWcid);
+            Assert.AreEqual(PalletSize.Full, jack.CarriedPalletSize);
+            Assert.AreEqual((ushort)2, jack.CarriedCargoState.AmmoRemaining);
+            Assert.AreEqual(0.200f, jack.ForkHeightM, 1e-4f);
+            Assert.IsTrue(turret.IsDestroyed);
+        }
