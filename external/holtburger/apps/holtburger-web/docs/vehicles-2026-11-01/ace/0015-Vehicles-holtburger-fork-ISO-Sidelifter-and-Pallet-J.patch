+        private bool CheckTractorStoppedForRack(out string reason)
+        {
+            reason = null;
+            if (CoupledTractorGuid != 0)
+            {
+                var tractor = VehicleManager.Get(CoupledTractorGuid);
+                if (tractor != null && !tractor.IsDestroyed && !tractor.IsParked &&
+                    Math.Max(Math.Abs(tractor.State.Speed), Math.Abs(tractor.GroundState.Speed)) > 0.25)
+                {
