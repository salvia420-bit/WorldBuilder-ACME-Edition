+        public static SlotBox GetSlotSubBox(in PinwheelSlotDef slotDef, PalletSize palletSize, int subSlot = 0)
+        {
+            if (palletSize != PalletSize.Half)
+            {
+                double hxFull = slotDef.Dx * 0.5;
+                double hyFull = slotDef.Dy * 0.5;
+                return new SlotBox
+                {
+                    SlotIndex = slotDef.SlotIndex,
+                    SubSlot = 0,
+                    PalletSize = PalletSize.Full,
+                    X = slotDef.X,
+                    Y = slotDef.Y,
+                    Dx = slotDef.Dx,
+                    Dy = slotDef.Dy,
+                    Orient = slotDef.Orient,
+                    X0 = slotDef.X - hxFull,
+                    X1 = slotDef.X + hxFull,
+                    Y0 = slotDef.Y - hyFull,
+                    Y1 = slotDef.Y + hyFull,
+                };
+            }
+
+            int sub = subSlot == 1 ? 1 : 0;
+            double off = sub == 1 ? HalfOffsetM : -HalfOffsetM;
+            double cx;
+            double cy;
+            double dx;
+            double dy;
+            if (slotDef.Orient == 'Y')
+            {
+                // +90 deg CCW rotation maps local (off, 0) -> (0, off)
+                cx = slotDef.X;
+                cy = slotDef.Y + off;
+                dx = GmaDepth;     // 1.0160
+                dy = GmaHalfWidth; // 0.6096
+            }
+            else
+            {
+                cx = slotDef.X + off;
+                cy = slotDef.Y;
+                dx = GmaHalfWidth; // 0.6096
+                dy = GmaDepth;     // 1.0160
+            }
+
+            double hx = dx * 0.5;
+            double hy = dy * 0.5;
+            return new SlotBox
+            {
+                SlotIndex = slotDef.SlotIndex,
+                SubSlot = sub,
+                PalletSize = PalletSize.Half,
+                X = cx,
+                Y = cy,
+                Dx = dx,
+                Dy = dy,
+                Orient = slotDef.Orient,
+                X0 = cx - hx,
+                X1 = cx + hx,
+                Y0 = cy - hy,
+                Y1 = cy + hy,
+            };
+        }
