+        [TestMethod]
+        public void EndToEndContainerRoundTripPreservesCargoStateAndEnforcesRampAndLifo()
+        {
+            const int lbX = 16, lbY = 16;
+            uint gridKey = ((uint)lbX << 24) | ((uint)lbY << 16);
