@@ -0,0 +1,300 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+
+namespace ACE.Server.Vehicles
+{
+    public readonly struct SidelifterContainerLocalPose
+    {
+        public readonly double X;
+        public readonly double Y;
+        public readonly double Z;
+        public readonly double Roll;
+        public readonly double CraneBoomAngle;
+        public readonly double CraneJibAngle;
+        public readonly double ChainLen;
+
+        public SidelifterContainerLocalPose(double x, double y, double z, double roll, double craneBoomAngle, double craneJibAngle, double chainLen)
+        {
+            X = x;
+            Y = y;
+            Z = z;
+            Roll = roll;
+            CraneBoomAngle = craneBoomAngle;
+            CraneJibAngle = craneJibAngle;
+            ChainLen = chainLen;
+        }
+    }
+
+    public readonly struct OutriggerSlopeResult
+    {
+        public readonly bool Ok;
+        public readonly double CosTheta;
+        public readonly double SlopeDeg;
+
+        public OutriggerSlopeResult(bool ok, double cosTheta, double slopeDeg)
+        {
+            Ok = ok;
+            CosTheta = cosTheta;
+            SlopeDeg = slopeDeg;
+        }
+    }
+
+    /// <summary>
+    /// Pure deterministic ISO 3874 / ISO 1161 sidelifter trailer kinematics (HBV1 v7).
+    /// 1:1 parity twin of holtburger-web scene3d/vehicle/sidelifter_kinematics.js.
+    ///
+    /// Coordinate convention (AC vehicle local frame):
+    ///   +X = right (curbside)
+    ///   +Y = forward (kingpin)
+    ///   +Z = up
+    /// </summary>
+    public static class SidelifterKinematics
+    {
+        public const double SidelifterOutreachX = 3.85;
+        public const double OutriggerReachX = 3.60;
+        public const double HoistClearanceZ = 0.45;
+        public const double SwingArcCrownZ = 0.25;
+        public const double MaxSlopeCos = 0.9945; // cos(6.0 deg) ISO 3874 cross-slope ceiling
+        public const double ChassisDeckZ = 1.32;
+        public const double CraneSpanY20ft = 2.9265; // half of 5.853m ISO 1161 20ft corner-casting span
+        public const double CraneSpanY40ft = 5.9925; // half of 11.985m ISO 1161 40ft/40HC span
+
+        public static double Clamp01(double v)
+        {
+            if (double.IsNaN(v) || v <= 0.0)
+                return 0.0;
+            if (v >= 1.0)
+                return 1.0;
+            return v;
+        }
+
+        public static double Smoothstep(double t)
+        {
+            var c = Clamp01(t);
+            return c * c * (3.0 - 2.0 * c);
+        }
+
+        public static double GetPhaseDuration(SideliftPhase phase) => phase switch
+        {
+            SideliftPhase.Idle => 0.0,
+            SideliftPhase.OutriggersDeploying => 2.2,
+            SideliftPhase.OutriggersPlanted => 0.0,
+            SideliftPhase.CranesPositioning => 1.5,
+            SideliftPhase.CranesLatched => 0.8,
+            SideliftPhase.Hoisting => 1.8,
+            SideliftPhase.Swinging => 3.0,
+            SideliftPhase.Lowering => 2.0,
+            SideliftPhase.Releasing => 0.7,
+            SideliftPhase.CranesStowing => 1.5,
+            SideliftPhase.OutriggersRetracting => 2.2,
+            _ => 0.0,
+        };
+
+        public static double GetPhaseDuration(int phase) =>
+            phase >= 0 && phase <= (int)SideliftPhase.OutriggersRetracting
+                ? GetPhaseDuration((SideliftPhase)phase)
+                : 0.0;
+
+        public static double ComputeCraneSpanY(DeployableKind kind) =>
+            kind == DeployableKind.IsoContainer20 ? CraneSpanY20ft : CraneSpanY40ft;
+
+        public static double ComputeCraneSpanY(uint kindOrWcid) =>
+            (kindOrWcid == (uint)DeployableKind.IsoContainer20 || kindOrWcid == 4000020u || kindOrWcid == 20u)
+                ? CraneSpanY20ft
+                : CraneSpanY40ft;
+
+        public static double ComputeCraneSpanY(string kind)
+        {
+            if (string.IsNullOrWhiteSpace(kind))
+                return CraneSpanY40ft;
+            var s = kind.Trim().ToLowerInvariant();
+            if (s is "20" or "20ft" or "22g1" or "1cc" or "isocontainer20" or "4000020" or "10")
+                return CraneSpanY20ft;
+            return CraneSpanY40ft;
+        }
+
+        public static SidelifterContainerLocalPose EvaluateContainerLocalPose(
+            int phase,
+            double progress,
+            int side = 1,
+            string direction = "offload",
+            double deckZ = ChassisDeckZ,
+            double groundLocalZ = 0.0,
+            double containerSlotY = 0.0)
+        {
+            bool isLoad = string.Equals(direction?.Trim(), "load", StringComparison.OrdinalIgnoreCase);
+            var ph = (phase >= 0 && phase <= (int)SideliftPhase.OutriggersRetracting)
+                ? (SideliftPhase)phase
+                : (phase < 0 ? SideliftPhase.Idle : SideliftPhase.OutriggersRetracting);
+            return EvaluateContainerLocalPose(ph, progress, side, isLoad, deckZ, groundLocalZ, containerSlotY);
+        }
+
+        public static SidelifterContainerLocalPose EvaluateContainerLocalPose(
+            SideliftPhase phase,
+            double progress,
+            int side = 1,
+            bool isLoad = false,
+            double deckZ = ChassisDeckZ,
+            double groundLocalZ = 0.0,
+            double containerSlotY = 0.0)
+        {
+            var p = Clamp01(progress);
+            var s = Smoothstep(p);
+            var sideSign = side < 0 ? -1 : 1;
+
+            var deck = double.IsFinite(deckZ) ? deckZ : ChassisDeckZ;
+            var gnd = double.IsFinite(groundLocalZ) ? groundLocalZ : 0.0;
+            var slotY = double.IsFinite(containerSlotY) ? containerSlotY : 0.0;
+
+            var hoistZ = Math.Max(deck, gnd) + HoistClearanceZ;
+            var minZ = Math.Min(deck, gnd);
+            var zSpan = Math.Max(0.25, hoistZ - minZ);
+
+            var startX = isLoad ? sideSign * SidelifterOutreachX : 0.0;
+            var startZ = isLoad ? gnd : deck;
+            var endX = isLoad ? 0.0 : sideSign * SidelifterOutreachX;
+            var endZ = isLoad ? deck : gnd;
+
+            double x;
+            double z;
+
+            if (phase <= SideliftPhase.CranesLatched)
+            {
+                x = startX;
+                z = startZ;
+            }
+            else if (phase == SideliftPhase.Hoisting)
+            {
+                x = startX;
+                z = startZ + (hoistZ - startZ) * s;
+            }
+            else if (phase == SideliftPhase.Swinging)
+            {
+                x = startX + (endX - startX) * s;
+                z = hoistZ + SwingArcCrownZ * Math.Sin(Math.PI * s);
+            }
+            else if (phase == SideliftPhase.Lowering)
+            {
+                x = endX;
+                z = hoistZ + (endZ - hoistZ) * s;
+            }
+            else
+            {
+                x = endX;
+                z = endZ;
+            }
+
+            (double boom, double jib, double chain) CraneAt(double cx, double cz)
+            {
+                var reach = Math.Abs(cx) / SidelifterOutreachX;
+                var liftRatio = Clamp01((cz - minZ) / zSpan);
+                var dropRatio = Clamp01((hoistZ - cz) / zSpan);
+                return (
+                    sideSign * (0.22 + 0.70 * reach - 0.08 * liftRatio),
+                    sideSign * (0.55 + 0.20 * reach - 0.15 * liftRatio),
+                    0.65 + 0.45 * dropRatio
+                );
+            }
+
+            double craneBoomAngle = 0.0;
+            double craneJibAngle = 0.0;
+            double chainLen = 0.0;
+
+            if (phase == SideliftPhase.CranesPositioning)
+            {
+                var c = CraneAt(startX, startZ);
+                craneBoomAngle = c.boom * s;
+                craneJibAngle = c.jib * s;
+                chainLen = c.chain * s;
+            }
+            else if (phase >= SideliftPhase.CranesLatched && phase <= SideliftPhase.Releasing)
+            {
+                var c = CraneAt(x, z);
+                craneBoomAngle = c.boom;
+                craneJibAngle = c.jib;
+                chainLen = c.chain;
+            }
+            else if (phase == SideliftPhase.CranesStowing)
+            {
+                var c = CraneAt(endX, endZ);
+                var k = 1.0 - s;
+                craneBoomAngle = c.boom * k;
+                craneJibAngle = c.jib * k;
+                chainLen = c.chain * k;
+            }
+
+            return new SidelifterContainerLocalPose(x, slotY, z, 0.0, craneBoomAngle, craneJibAngle, chainLen);
+        }
+
+        public static bool IsSlopeWithinLimit(double cosTheta) =>
+            double.IsFinite(cosTheta) && cosTheta >= MaxSlopeCos;
+
+        public static OutriggerSlopeResult CheckOutriggerSlope(double cosTheta)
+        {
+            if (!double.IsFinite(cosTheta) || cosTheta < -1.0 || cosTheta > 1.0)
+                return new OutriggerSlopeResult(false, 0.0, 90.0);
+            var c = Clamp01(cosTheta);
+            return new OutriggerSlopeResult(c >= MaxSlopeCos, c, Math.Acos(c) * 180.0 / Math.PI);
+        }
+
+        public static OutriggerSlopeResult CheckOutriggerSlope(
+            double zFL, double zFR, double zRL, double zRR,
+            double spanX = 2.44, double spanY = 11.985)
+        {
+            if (!double.IsFinite(zFL) || !double.IsFinite(zFR) ||
+                !double.IsFinite(zRL) || !double.IsFinite(zRR) ||
+                !double.IsFinite(spanX) || spanX <= 0.0 ||
+                !double.IsFinite(spanY) || spanY <= 0.0)
+            {
+                return new OutriggerSlopeResult(false, 0.0, 90.0);
+            }
+
+            var nx = -((zFR + zRR) - (zFL + zRL)) / (2.0 * spanX);
+            var ny = -((zFL + zFR) - (zRL + zRR)) / (2.0 * spanY);
+            var planeCos = 1.0 / Math.Sqrt(nx * nx + ny * ny + 1.0);
+            var dxF = (zFR - zFL) / spanX;
+            var dxR = (zRR - zRL) / spanX;
+            var dyL = (zFL - zRL) / spanY;
+            var dyR = (zFR - zRR) / spanY;
+            var frontCos = 1.0 / Math.Sqrt(dxF * dxF + 1.0);
+            var rearCos = 1.0 / Math.Sqrt(dxR * dxR + 1.0);
+            var leftCos = 1.0 / Math.Sqrt(dyL * dyL + 1.0);
+            var rightCos = 1.0 / Math.Sqrt(dyR * dyR + 1.0);
+            var cosTheta = Math.Min(planeCos, Math.Min(Math.Min(frontCos, rearCos), Math.Min(leftCos, rightCos)));
+            return new OutriggerSlopeResult(
+                cosTheta >= MaxSlopeCos,
+                cosTheta,
+                Math.Acos(Clamp01(cosTheta)) * 180.0 / Math.PI);
+        }
+
+        public static OutriggerSlopeResult CheckOutriggerSlope(IEnumerable<Vector3> normals)
+        {
+            if (normals == null)
+                return new OutriggerSlopeResult(false, 0.0, 90.0);
+
+            int count = 0;
+            double minCos = 1.0;
+            foreach (var n in normals)
+            {
+                count++;
+                if (!float.IsFinite(n.X) || !float.IsFinite(n.Y) || !float.IsFinite(n.Z))
+                    return new OutriggerSlopeResult(false, 0.0, 90.0);
+                double x = n.X, y = n.Y, z = n.Z;
+                double len = Math.Sqrt(x * x + y * y + z * z);
+                if (!(len > 1e-6) || z <= 0.0)
+                    return new OutriggerSlopeResult(false, 0.0, 90.0);
+                double c = Clamp01(z / len);
+                if (c < minCos)
+                    minCos = c;
+            }
+            if (count == 0)
+                return new OutriggerSlopeResult(false, 0.0, 90.0);
+
+            return new OutriggerSlopeResult(
+                minCos >= MaxSlopeCos,
+                minCos,
+                Math.Acos(Clamp01(minCos)) * 180.0 / Math.PI);
+        }
+    }
+}
