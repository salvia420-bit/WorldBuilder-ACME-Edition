+                    if (player.Location != null)
+                        SendEventTo(player, msg?.PalletJackGuid ?? 0, VehicleEventKind.SideliftRefused, msg?.Action ?? 0, player.Location);
+                    session.Network?.EnqueueSend(new GameMessageSystemChat(error, ChatMessageType.Broadcast));
+                }
+            }
+            else if (msg != null && msg.Action != (byte)PalletJackActionKind.UpdatePose && player.Location != null)
+            {
+                SendEventTo(player, msg.PalletJackGuid != 0 ? msg.PalletJackGuid : msg.TargetGuid, VehicleEventKind.PalletJackEvent, msg.Action, player.Location);
+            }
+        }
+
+        public static bool HandlePalletJackAction(Player player, VehiclePalletJackAction msg) =>
+            HandlePalletJackAction(player, msg, out _);
+
+        public static bool HandlePalletJackAction(Player player, VehiclePalletJackAction msg, out string error)
+        {
+            error = null;
+            if (!Enabled) { error = "vehicles_enabled is off."; return false; }
+            if (player == null || msg == null) { error = "Invalid pallet jack action."; return false; }
+
+            if (msg.Action == (byte)PalletJackActionKind.ToggleDeployableStow)
+            {
+                if (player.Location == null) { error = "Player location unavailable."; return false; }
+                var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                var pVec = new Vector3((float)px, (float)py, (float)pz);
+                Deployables.DeployableBase target = msg.TargetGuid != 0
+                    ? Deployables.DeployableManager.GetDeployable(msg.TargetGuid)
+                    : Deployables.DeployableManager.FindNearbyGlobal<Deployables.DeployableBase>(
+                        pVec, 4.5f, includeInactive: true, d => d.Pallet != PalletSize.None);
+                if (target == null)
+                {
+                    var radar = msg.TargetGuid != 0
+                        ? AirDefense.AirDefenseManager.Stations.FirstOrDefault(s => s.Guid.Full == msg.TargetGuid)
+                        : AirDefense.AirDefenseManager.Stations
+                            .Where(s => !s.IsDestroyed && s.Location != null)
+                            .Select(s =>
+                            {
+                                var (rx, ry, rz) = Vehicle.ToGlobal(s.Location);
+                                return (s, dist: Vector3.Distance(pVec, new Vector3((float)rx, (float)ry, (float)rz)));
+                            })
+                            .Where(x => x.dist <= 4.5f)
+                            .OrderBy(x => x.dist)
+                            .FirstOrDefault().s;
+                    if (radar != null && !radar.IsDestroyed)
+                    {
+                        if (radar.Location == null)
+                        {
+                            error = "Radar station location unavailable.";
+                            return false;
+                        }
+                        var (rx, ry, rz) = Vehicle.ToGlobal(radar.Location);
+                        if (Vector3.Distance(pVec, new Vector3((float)rx, (float)ry, (float)rz)) > 4.5f)
+                        {
+                            error = "Move within 4.5 m of radar station to stow/activate.";
+                            return false;
+                        }
+                        radar.IsActive = !radar.IsActive;
+                        return true;
+                    }
+                }
+                if (target == null || target.IsDestroyed || target.IsPacked || target.Pallet == PalletSize.None)
+                {
+                    error = "No stowable deployable found within 4.5 m.";
+                    return false;
+                }
+                if (target.Location != null)
+                {
+                    var (tx, ty, tz) = Vehicle.ToGlobal(target.Location);
+                    if (Vector3.Distance(pVec, new Vector3((float)tx, (float)ty, (float)tz)) > 4.5f)
+                    {
+                        error = "Move within 4.5 m of deployable to stow/activate.";
+                        return false;
+                    }
+                }
+                if (!target.ToggleStow(player))
+                {
+                    error = "Deployable cannot be stowed.";
+                    return false;
+                }
+                return true;
+            }
+
+            Deployables.PalletJackDeployable jack = null;
+            if (msg.PalletJackGuid != 0)
+            {
+                jack = Deployables.DeployableManager.GetDeployable(msg.PalletJackGuid) as Deployables.PalletJackDeployable;
+            }
+            else if (msg.Action == (byte)PalletJackActionKind.Grab && player.Location != null)
+            {
+                var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                jack = Deployables.DeployableManager.FindNearbyGlobal<Deployables.PalletJackDeployable>(
+                    new Vector3((float)px, (float)py, (float)pz), (float)Deployables.PalletJackDeployable.MaxGrabDistanceM);
+            }
+            else
+            {
+                jack = FindOperatedPalletJack(player);
+            }
+
+            if (jack == null || jack.IsDestroyed || jack.IsPacked)
+            {
+                error = "Pallet jack not found.";
+                return false;
+            }
+
+            switch ((PalletJackActionKind)msg.Action)
+            {
+                case PalletJackActionKind.Grab:
+                    return jack.TryGrab(player, out error);
+                case PalletJackActionKind.Release:
+                    return jack.Release(player, out error);
+                case PalletJackActionKind.UpdatePose:
+                    return jack.ApplyPoseUpdate(player, msg.Cell, msg.Position, msg.Heading, msg.TillerAngle, out error);
+                case PalletJackActionKind.RaiseForks:
+                    return jack.RaiseForks(player, out error);
+                case PalletJackActionKind.LowerForks:
+                    return jack.LowerForks(player, out error);
+                case PalletJackActionKind.PickGroundDeployable:
+                    return jack.TryPickGroundDeployable(player, msg.TargetGuid, out error);
