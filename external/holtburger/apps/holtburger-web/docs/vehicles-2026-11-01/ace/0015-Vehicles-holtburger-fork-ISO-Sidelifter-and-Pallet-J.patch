+        [TestMethod]
+        public void GrabReleaseBurstLoopRespectsPersistentLeakyBucket()
+        {
+            double x = 3650.0, y = 4650.0, z = 40.0;
+            VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = z, Nz = 1.0 };
+
+            var player = CreateTestPlayer(0x50007B01u, x, y, z);
+            RegisterOnlinePlayer(player);
+            try
+            {
+                var jack = new PalletJackDeployable(new Vector3((float)x, (float)y, (float)z), 0f, player);
+                DeployableManager.Register(jack);
+
+                var t = DateTime.UtcNow;
+                int accepted = 0;
+                double curX = x;
+                for (int i = 0; i < 50; i++)
+                {
+                    Assert.IsTrue(jack.TryGrab(player, out var gErr), gErr);
+                    t = t.AddMilliseconds(1);
+                    var nextPos = Vehicle.ToPosition(curX + 1.49, y, z, Quaternion.Identity);
+                    if (jack.ApplyPoseUpdate(player, nextPos.Cell, nextPos.Pos, 0f, 0f, out _, t))
+                    {
+                        accepted++;
+                        curX += 1.49;
+                        player.Location = Vehicle.ToPosition(curX - 0.62, y, z, Quaternion.Identity);
+                    }
+                    Assert.IsTrue(jack.Release(player, out var rErr), rErr);
+                }
+
+                Assert.AreEqual(1, accepted, $"Grab->Move(+1.49m)->Release loop must not bypass 3.2 m/s bucket (accepted={accepted})");
+                Assert.IsTrue(jack.GlobalPosition.X - x <= 1.55, $"Jack displacement must stay <= 1.55m, got {jack.GlobalPosition.X - x:0.00}m");
+
+                // After real wall-clock idle > 0.5s, re-grabbing refills bucket cleanly for normal operation
+                Thread.Sleep(550);
+                Assert.IsTrue(jack.TryGrab(player, out var gErr2), gErr2);
+                var afterIdle = Vehicle.ToPosition(curX + 1.20, y, z, Quaternion.Identity);
+                Assert.IsTrue(jack.ApplyPoseUpdate(player, afterIdle.Cell, afterIdle.Pos, 0f, 0f, out var idleErr), idleErr);
+            }
+            finally
+            {
+                UnregisterOnlinePlayer(player.Guid.Full);
+            }
+        }
+    }
+}
