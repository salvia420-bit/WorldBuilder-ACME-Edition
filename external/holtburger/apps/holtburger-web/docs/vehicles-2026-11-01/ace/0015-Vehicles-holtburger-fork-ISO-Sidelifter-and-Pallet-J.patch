+        public bool TryStartSideliftOffload(sbyte side, bool autoCycle, out string reason, Player actor = null)
+        {
+            reason = null;
+            if (!IsSidelifter) { reason = "Trailer is not a sidelifter."; return false; }
+            if (MountedContainerGuid == 0) { reason = "No mounted container to offload."; return false; }
+
+            var container = DeployableManager.GetDeployable(MountedContainerGuid) as IsoContainerDeployable;
+            if (container == null || container.IsDestroyed || container.IsPacked)
+            {
+                reason = "Mounted container is unavailable.";
+                return false;
+            }
+
+            if (!autoCycle && SideliftPhase != SideliftPhase.OutriggersPlanted)
+            {
+                reason = "ISO 3874: Deploy stabilizing outriggers before lifting.";
+                return false;
+            }
+            if (autoCycle && SideliftPhase != SideliftPhase.Idle && SideliftPhase != SideliftPhase.OutriggersPlanted)
+            {
+                reason = "Sidelifter operation already in progress.";
+                return false;
+            }
+
+            if (!CheckTractorParked(out reason)) return false;
+
+            if (container.DoorState != ContainerDoorState.Closed || container.DoorProgress > 0.01f)
+            {
+                reason = "ISO 3874: Close and latch container doors before lifting.";
+                return false;
+            }
+
+            if (!autoCycle && TwistlockLocked)
+            {
+                reason = "ISO 3874: Unlock chassis twistlocks before offloading.";
+                return false;
+            }
+
+            sbyte effSide = side == 0 ? SideliftSide : (side < 0 ? (sbyte)-1 : (sbyte)1);
+            if (SideliftPhase == SideliftPhase.OutriggersPlanted && effSide != SideliftSide)
+            {
+                reason = "Retract outriggers before switching side.";
+                return false;
+            }
+            double spanY = SidelifterKinematics.ComputeCraneSpanY(container.Kind);
+            double slotLocalY = ComputeSlotLocalY(container, ContainerSlot, ContainerExplicitCenter);
+            if (!CheckOutriggerAndDropTerrain(effSide, spanY, slotLocalY, out double dropZ, out reason))
+                return false;
+
+            var (tx, ty, tz) = GetGlobalPose();
+            var (dxOff, dyOff, _) = TrailerKinematics.RotateByOrientation(HeadingRad, 0.0, 0.0, effSide * SidelifterKinematics.SidelifterOutreachX, slotLocalY, 0.0);
+            double dropX = tx + dxOff;
+            double dropY = ty + dyOff;
+
+            foreach (var d in DeployableManager.GetAll())
+            {
+                if (d is IsoContainerDeployable other && other != container && !other.IsDestroyed && !other.IsPacked && other.IsActive)
+                {
+                    var oGlobal = other.Location != null
+                        ? Vehicle.ToGlobal(other.Location)
+                        : ((double)other.Position.X, (double)other.Position.Y, (double)other.Position.Z);
+                    if (ContainersOverlap2DAndZ(
+                        dropX, dropY, dropZ, HeadingRad, container.ExternalDimensions,
+                        oGlobal.Item1, oGlobal.Item2, oGlobal.Item3, other.HeadingRad, other.ExternalDimensions))
+                    {
+                        reason = "ISO 3874: Another container obstructs the sidelifter drop zone.";
+                        return false;
+                    }
+                }
+            }
+
+            SideliftIsLoad = false;
+            SideliftSide = effSide;
+            CraneSpanY = (float)spanY;
+            TransferContainerGuid = container.Guid.Full;
+            TransferSlot = ContainerSlot;
+            TransferExplicitCenter = ContainerExplicitCenter;
+            TransferGroundLocalZ = dropZ - tz;
+            AutoCycleActive = autoCycle;
+
+            if (SideliftPhase == SideliftPhase.Idle)
+            {
+                SideliftPhase = SideliftPhase.OutriggersDeploying;
+                SideliftProgress = 0f;
+                OutriggerProgress = 0f;
+            }
+            else
+            {
+                if (autoCycle) TwistlockLocked = false;
+                SideliftPhase = SideliftPhase.CranesPositioning;
+                SideliftProgress = 0f;
+                OutriggerProgress = 1f;
+            }
+
+            EmitSideliftEvent(VehicleEventKind.SideliftStarted, actor, container.Guid.Full, effSide);
+            BroadcastState();
+            return true;
+        }
