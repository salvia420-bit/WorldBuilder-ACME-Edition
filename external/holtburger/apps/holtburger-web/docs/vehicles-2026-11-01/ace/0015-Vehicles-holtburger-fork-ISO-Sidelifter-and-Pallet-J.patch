+        private double SampleCornerZ(double localX, double localY, double refZ)
+        {
+            var (tx, ty, _) = GetGlobalPose();
+            var (ox, oy, _) = TrailerKinematics.RotateByOrientation(HeadingRad, 0.0, 0.0, localX, localY, 0.0);
+            return VehicleManager.SampleTrailerTerrainZ(tx + ox, ty + oy, refZ);
+        }
