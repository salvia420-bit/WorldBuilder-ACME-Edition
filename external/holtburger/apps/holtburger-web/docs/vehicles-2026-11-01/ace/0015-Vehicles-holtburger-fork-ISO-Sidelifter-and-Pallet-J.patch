+        [TestMethod]
+        public void OperatorGrabReleaseSpeedClampAndLifecycleHooks()
+        {
+            double x = 3300.0, y = 4300.0, z = 40.0;
+            VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = z, Nz = 1.0 };
+
+            var player = CreateTestPlayer(0x50007101u, x + 4.0, y, z);
+            var jack = new PalletJackDeployable(new Vector3((float)x, (float)y, (float)z), 0f, player);
+            DeployableManager.Register(jack);
+
+            // Too far (> 3.5 m)
+            Assert.IsFalse(jack.TryGrab(player, out _));
+
+            // Within 3.5 m
+            player.Location = Vehicle.ToPosition(x + 2.0, y, z, Quaternion.Identity);
+            Assert.IsTrue(jack.TryGrab(player, out var grabErr), grabErr);
+            Assert.AreEqual(player.Guid.Full, jack.OperatorPlayerGuid);
+
+            // Cannot grab a second jack while holding one
+            var jack2 = new PalletJackDeployable(new Vector3((float)(x + 2.5), (float)y, (float)z), 0f, player);
+            DeployableManager.Register(jack2);
+            Assert.IsFalse(jack2.TryGrab(player, out _));
+
+            // Anti-teleport speed cap (> 3.2 m/s)
+            var t0 = DateTime.UtcNow;
+            var posOk = Vehicle.ToPosition(x + 0.1, y, z, Quaternion.Identity);
+            Assert.IsTrue(jack.ApplyPoseUpdate(player, posOk.Cell, posOk.Pos, 0f, 0.2f, out _, t0), "0.1m initial step should pass");
+
+            var posFar = Vehicle.ToPosition(x + 25.0, y, z, Quaternion.Identity);
+            Assert.IsFalse(jack.ApplyPoseUpdate(player, posFar.Cell, posFar.Pos, 0f, 0.2f, out var speedErr, t0.AddMilliseconds(100)),
+                "25m jump in 0.1s must be rejected");
+            StringAssert.Contains(speedErr, "3.2");
+
+            // Lifecycle hooks: logout & teleport & death release operator cleanly
+            VehicleManager.OnPlayerLogout(player);
+            Assert.AreEqual(0u, jack.OperatorPlayerGuid);
+
+            Assert.IsTrue(jack.TryGrab(player, out _));
+            VehicleManager.OnPlayerTeleport(player);
+            Assert.AreEqual(0u, jack.OperatorPlayerGuid);
+
+            Assert.IsTrue(jack.TryGrab(player, out _));
+            VehicleManager.OnPlayerDeath(player);
+            VehicleManager.ProcessDeathsForTesting();
+            Assert.AreEqual(0u, jack.OperatorPlayerGuid);
+        }
