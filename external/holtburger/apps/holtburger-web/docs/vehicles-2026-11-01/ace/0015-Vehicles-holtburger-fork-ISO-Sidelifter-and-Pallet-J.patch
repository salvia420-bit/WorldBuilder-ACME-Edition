+            double slotLocalY = ComputeSlotLocalY(container, slot, explicitCenter);
+            double spanY = SidelifterKinematics.ComputeCraneSpanY(container.Kind);
+            if (!CheckOutriggerAndDropTerrain(effSide, spanY, slotLocalY, out _, out reason))
+                return false;
+
+            TwistlockLocked = false;
+            SideliftIsLoad = true;
+            SideliftSide = effSide;
+            CraneSpanY = (float)spanY;
+            TransferContainerGuid = container.Guid.Full;
+            TransferSlot = slot;
+            TransferExplicitCenter = explicitCenter;
+            TransferGroundLocalZ = cGlobal.Item3 - tz;
+            AutoCycleActive = autoCycle;
+
+            if (SideliftPhase == SideliftPhase.Idle)
+            {
+                SideliftPhase = SideliftPhase.OutriggersDeploying;
+                SideliftProgress = 0f;
+                OutriggerProgress = 0f;
+            }
+            else
+            {
+                SideliftPhase = SideliftPhase.CranesPositioning;
+                SideliftProgress = 0f;
+                OutriggerProgress = 1f;
+            }
+
+            EmitSideliftEvent(VehicleEventKind.SideliftStarted, actor, container.Guid.Full, effSide);
+            BroadcastState();
+            return true;
+        }
+
+        public bool CancelSidelift(out string reason)
+        {
+            reason = null;
+            if (!IsSidelifter) { reason = "Trailer is not a sidelifter."; return false; }
+            if (SideliftPhase == SideliftPhase.Idle) return true;
+            if (SideliftPhase >= SideliftPhase.Hoisting && SideliftPhase <= SideliftPhase.Lowering)
+            {
+                reason = "ISO 3874: Cannot cancel sidelift while container is suspended mid-air.";
+                return false;
+            }
+
+            AutoCycleActive = false;
+            TransferContainerGuid = 0;
+            SideliftIsLoad = false;
+
+            if (SideliftPhase == SideliftPhase.OutriggersDeploying)
+            {
+                SideliftPhase = SideliftPhase.OutriggersRetracting;
+                SideliftProgress = Math.Clamp(1.0f - OutriggerProgress, 0f, 1f);
+            }
+            else if (SideliftPhase == SideliftPhase.OutriggersPlanted)
+            {
+                SideliftPhase = SideliftPhase.OutriggersRetracting;
+                SideliftProgress = 0f;
+            }
+            else if (SideliftPhase == SideliftPhase.CranesPositioning || SideliftPhase == SideliftPhase.CranesLatched)
+            {
+                SideliftPhase = SideliftPhase.CranesStowing;
+                SideliftProgress = 0f;
+            }
+
+            BroadcastState();
+            return true;
+        }
+
+        public void OnTransferContainerDestroyed(bool fromLandblockUnload = false)
+        {
+            TransferContainerGuid = 0;
+            AutoCycleActive = false;
+            SideliftIsLoad = false;
+            if (SideliftPhase >= SideliftPhase.CranesPositioning && SideliftPhase <= SideliftPhase.Releasing)
+            {
+                SideliftPhase = SideliftPhase.CranesStowing;
+                SideliftProgress = 0f;
+            }
+            if (!fromLandblockUnload && !IsDestroyed)
+                BroadcastState();
+        }
+
+        private void UpdateTransferContainerPose()
+        {
+            if (TransferContainerGuid == 0) return;
+            var container = DeployableManager.GetDeployable(TransferContainerGuid) as IsoContainerDeployable;
+            if (container == null || container.IsDestroyed)
+            {
+                OnTransferContainerDestroyed();
+                return;
+            }
+
+            double slotLocalY = ComputeSlotLocalY(container, TransferSlot, TransferExplicitCenter);
+            var localPose = SidelifterKinematics.EvaluateContainerLocalPose(
+                SideliftPhase,
+                SideliftProgress,
+                SideliftSide,
+                SideliftIsLoad,
+                Spec.DeckZ,
+                TransferGroundLocalZ,
+                slotLocalY);
+
+            var (tx, ty, tz) = GetGlobalPose();
+            var (dx, dy, dz) = TrailerKinematics.RotateByOrientation(
+                HeadingRad, PitchRadD, BankRad,
+                localPose.X, localPose.Y, localPose.Z);
+
+            var tractor = CoupledTractorGuid != 0 ? VehicleManager.Get(CoupledTractorGuid) : null;
+            container.SetWorldPose(tx + dx, ty + dy, tz + dz, HeadingRad, PitchRadD, BankRad);
+            VehicleManager.MoveAuxWorldObject(container, container.Location, tractor);
+        }
+
+        private void CompleteTouchdown()
+        {
+            var container = TransferContainerGuid != 0
+                ? DeployableManager.GetDeployable(TransferContainerGuid) as IsoContainerDeployable
+                : null;
+            var tractor = CoupledTractorGuid != 0 ? VehicleManager.Get(CoupledTractorGuid) : null;
+
+            if (container != null && !container.IsDestroyed)
+            {
+                if (!SideliftIsLoad)
+                {
+                    double slotLocalY = ComputeSlotLocalY(container, TransferSlot, TransferExplicitCenter);
+                    var (tx, ty, tz) = GetGlobalPose();
+                    var (dx, dy, _) = TrailerKinematics.RotateByOrientation(
+                        HeadingRad, PitchRadD, BankRad,
+                        SideliftSide * SidelifterKinematics.SidelifterOutreachX, slotLocalY, 0.0);
+                    double dropX = tx + dx;
+                    double dropY = ty + dy;
+                    double gz = VehicleManager.SampleTrailerTerrainZ(dropX, dropY, tz);
+                    double targetZ = double.IsFinite(gz) ? gz : tz;
+
+                    MountedContainerGuid = 0;
+                    ContainerSlot = 0;
+                    ContainerExplicitCenter = false;
+                    TwistlockLocked = false;
+                    container.MountedOnTrailerGuid = 0;
+                    container.SetWorldPose(dropX, dropY, targetZ, HeadingRad, 0.0, 0.0);
+                    VehicleManager.MoveAuxWorldObject(container, container.Location, tractor);
+                    container.BroadcastState();
+
+                    if (tractor != null && tractor.HitchedTrailerGuid == Guid.Full)
+                    {
+                        tractor.GroundState.TowMassMul = TrailerKinematics.TowMassEmptyChassis;
+                        tractor.TrailerFlags = ComputeTrailerFlags();
+                        tractor.PilotStateAcc = 1.0;
+                        tractor.ObserverStateAcc = 1.0;
+                    }
+                }
+                else
+                {
+                    MountedContainerGuid = container.Guid.Full;
+                    ContainerSlot = TransferSlot;
+                    ContainerExplicitCenter = TransferExplicitCenter;
+                    container.MountedOnTrailerGuid = Guid.Full;
+                    TwistlockLocked = true;
+                    SyncMountedContainerPose(container);
+                    VehicleManager.MoveAuxWorldObject(container, container.Location, tractor);
+                    container.BroadcastState();
+
+                    if (tractor != null && tractor.HitchedTrailerGuid == Guid.Full)
+                    {
+                        tractor.GroundState.TowMassMul = TrailerKinematics.TowMassLoaded;
+                        tractor.TrailerFlags = ComputeTrailerFlags();
+                        tractor.PilotStateAcc = 1.0;
+                        tractor.ObserverStateAcc = 1.0;
+                    }
+                }
+
+                EmitSideliftEvent(VehicleEventKind.SideliftComplete, null, container.Guid.Full, SideliftSide);
+            }
+        }
+
+        public void TickSidelifter(double dt)
+        {
+            if (!IsSidelifter || IsDestroyed || IsPacked)
+                return;
+            if (SideliftPhase == SideliftPhase.Idle || SideliftPhase == SideliftPhase.OutriggersPlanted)
+                return;
+            if (!double.IsFinite(dt) || dt <= 0.0)
+                return;
+
+            double remaining = dt;
+            bool transitioned = false;
+
+            while (remaining > 1e-9 &&
+                   SideliftPhase != SideliftPhase.Idle &&
+                   SideliftPhase != SideliftPhase.OutriggersPlanted)
+            {
+                double dur = SidelifterKinematics.GetPhaseDuration(SideliftPhase);
+                if (dur <= 0.0) break;
+
+                double step = Math.Min(remaining, Math.Max(0.0, (1.0 - SideliftProgress) * dur));
+                SideliftProgress = (float)Math.Clamp(SideliftProgress + step / dur, 0.0, 1.0);
+                remaining -= step;
+
+                if (SideliftPhase == SideliftPhase.OutriggersDeploying)
+                    OutriggerProgress = SideliftProgress;
+                else if (SideliftPhase == SideliftPhase.OutriggersRetracting)
+                    OutriggerProgress = Math.Clamp(1.0f - SideliftProgress, 0f, 1f);
+
+                if (SideliftPhase >= SideliftPhase.Hoisting && SideliftPhase <= SideliftPhase.Lowering)
+                    UpdateTransferContainerPose();
+
+                if (SideliftProgress >= 1.0f - 1e-6f)
+                {
+                    transitioned = true;
+                    switch (SideliftPhase)
+                    {
+                        case SideliftPhase.OutriggersDeploying:
+                            OutriggerProgress = 1.0f;
+                            if (AutoCycleActive && TransferContainerGuid != 0)
+                            {
+                                var c = DeployableManager.GetDeployable(TransferContainerGuid) as IsoContainerDeployable;
+                                if (c == null || c.IsDestroyed || c.DoorState != ContainerDoorState.Closed || c.DoorProgress > 0.01f ||
+                                    (SideliftIsLoad && (c.MountedOnTrailerGuid != 0 || IsContainerInSideliftTransfer(c.Guid.Full, Guid.Full))) ||
+                                    (!SideliftIsLoad && c.MountedOnTrailerGuid != Guid.Full) ||
+                                    !CheckTractorParked(out _))
+                                {
+                                    AutoCycleActive = false;
+                                    TransferContainerGuid = 0;
+                                    SideliftPhase = SideliftPhase.OutriggersPlanted;
+                                    SideliftProgress = 0f;
+                                    EmitSideliftEvent(VehicleEventKind.SideliftRefused, null, c?.Guid.Full ?? 0, SideliftSide);
+                                }
+                                else
+                                {
+                                    if (!SideliftIsLoad) TwistlockLocked = false;
+                                    SideliftPhase = SideliftPhase.CranesPositioning;
+                                    SideliftProgress = 0f;
+                                }
+                            }
+                            else
+                            {
+                                SideliftPhase = SideliftPhase.OutriggersPlanted;
+                                SideliftProgress = 0f;
+                            }
+                            break;
+
+                        case SideliftPhase.CranesPositioning:
+                            SideliftPhase = SideliftPhase.CranesLatched;
+                            SideliftProgress = 0f;
+                            break;
+
+                        case SideliftPhase.CranesLatched:
+                            SideliftPhase = SideliftPhase.Hoisting;
+                            SideliftProgress = 0f;
+                            break;
+
+                        case SideliftPhase.Hoisting:
+                            SideliftPhase = SideliftPhase.Swinging;
+                            SideliftProgress = 0f;
+                            break;
+
+                        case SideliftPhase.Swinging:
+                            SideliftPhase = SideliftPhase.Lowering;
+                            SideliftProgress = 0f;
+                            break;
+
+                        case SideliftPhase.Lowering:
+                            SideliftPhase = SideliftPhase.Releasing;
+                            SideliftProgress = 0f;
+                            CompleteTouchdown();
+                            break;
+
+                        case SideliftPhase.Releasing:
+                            SideliftPhase = SideliftPhase.CranesStowing;
+                            SideliftProgress = 0f;
+                            TransferContainerGuid = 0;
+                            break;
+
+                        case SideliftPhase.CranesStowing:
+                            SideliftIsLoad = false;
+                            if (AutoCycleActive)
+                            {
+                                SideliftPhase = SideliftPhase.OutriggersRetracting;
+                                SideliftProgress = 0f;
+                            }
+                            else
+                            {
+                                SideliftPhase = SideliftPhase.OutriggersPlanted;
+                                SideliftProgress = 0f;
+                            }
+                            break;
+
+                        case SideliftPhase.OutriggersRetracting:
+                            SideliftPhase = SideliftPhase.Idle;
+                            SideliftProgress = 0f;
+                            OutriggerProgress = 0f;
+                            AutoCycleActive = false;
+                            TransferContainerGuid = 0;
+                            SideliftIsLoad = false;
+                            break;
+                    }
+                }
+            }
+
+            _phaseBroadcastAcc += dt;
+            if (transitioned || _phaseBroadcastAcc >= 0.066)
+            {
+                _phaseBroadcastAcc = 0.0;
+                BroadcastState();
+                if (TransferContainerGuid != 0)
+                {
+                    var tc = DeployableManager.GetDeployable(TransferContainerGuid) as IsoContainerDeployable;
+                    tc?.BroadcastState();
+                }
+            }
+        }
+
