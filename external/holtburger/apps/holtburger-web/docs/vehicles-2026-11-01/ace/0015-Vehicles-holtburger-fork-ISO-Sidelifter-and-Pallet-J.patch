+        public static ReachableSlotListResult ComputeReachableUnloadSlots(DeployableKind containerKind, IReadOnlyList<SlotBox> occupiedBoxes)
+        {
+            var result = new ReachableSlotListResult();
+            if (!ResolveSpec(containerKind, out var interior, out _))
+                return result;
+            if (occupiedBoxes == null)
+                return result;
+
+            for (int i = 0; i < occupiedBoxes.Count; i++)
+            {
+                var item = occupiedBoxes[i];
+                var corr = EvaluateCorridorFromDoor(in item, occupiedBoxes, interior.HalfW);
+                var entry = new ReachableSlotEntry
+                {
+                    SlotIndex = item.SlotIndex,
+                    SubSlot = item.SubSlot,
+                    PalletSize = item.PalletSize,
+                    CargoWcid = item.CargoWcid,
+                    X = item.X,
+                    Y = item.Y,
+                    Dx = item.Dx,
+                    Dy = item.Dy,
+                    Orient = item.Orient,
+                    Reachable = corr.Reachable,
+                    BlockedBySlotIndex = corr.BlockedBySlotIndex,
+                    BlockedBySubSlot = corr.BlockedBySubSlot,
+                    BlockedBy = corr.BlockedBy,
+                };
+                result.All.Add(entry);
+                if (corr.Reachable) result.Reachable.Add(entry);
+                else result.Blocked.Add(entry);
+            }
+
+            static int ByShallowFirst(ReachableSlotEntry a, ReachableSlotEntry b)
+            {
+                int cmp = a.Y.CompareTo(b.Y);
+                if (cmp != 0) return cmp;
+                cmp = a.SlotIndex.CompareTo(b.SlotIndex);
+                return cmp != 0 ? cmp : a.SubSlot.CompareTo(b.SubSlot);
+            }
+
+            result.Reachable.Sort(ByShallowFirst);
+            result.Blocked.Sort(ByShallowFirst);
+            result.All.Sort(ByShallowFirst);
+            return result;
+        }
