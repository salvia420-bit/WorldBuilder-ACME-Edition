+        public bool TryStowPalletJack(PalletJackDeployable jack, out string reason)
+        {
+            reason = null;
+            if (!IsSidelifter) { reason = "Only sidelifter trailers have an under-frame pallet jack rack."; return false; }
+            if (!CheckTractorStoppedForRack(out reason)) return false;
+            if (StowedPalletJackGuid != 0) { reason = "Trailer pallet jack rack is already occupied."; return false; }
+            if (jack == null || jack.IsDestroyed || jack.IsPacked) { reason = "Pallet jack unavailable."; return false; }
+            if (jack.StowedOnTrailerGuid != 0) { reason = "Pallet jack is already stowed on a trailer."; return false; }
+            if (jack.OperatorPlayerGuid != 0) { reason = "Release pallet jack before stowing on rack."; return false; }
+            if (jack.CarriedWcid != 0) { reason = "Unload pallet jack cargo before stowing on rack."; return false; }
+
+            var (tx, ty, tz) = GetGlobalPose();
+            var jPos = jack.GlobalPosition;
+            double distSq = (jPos.X - tx) * (jPos.X - tx) + (jPos.Y - ty) * (jPos.Y - ty) + (jPos.Z - tz) * (jPos.Z - tz);
+            if (distSq > 6.5 * 6.5)
+            {
+                reason = "Move pallet jack within 6.5 m of trailer rack to stow.";
+                return false;
+            }
+
+            StowedPalletJackGuid = jack.Guid.Full;
+            jack.StowedOnTrailerGuid = Guid.Full;
+            jack.IsActive = false;
+            jack.OnContainerRampOrFloor = false;
+            var (rx, ry, rz) = TrailerKinematics.RotateByOrientation(HeadingRad, PitchRadD, BankRad, -0.95, -1.6, 0.55);
+            jack.SetWorldPose(tx + rx, ty + ry, tz + rz, HeadingRad);
+            VehicleManager.MoveAuxWorldObject(jack, jack.Location, null);
+            jack.BroadcastState();
+            BroadcastState();
+            return true;
+        }
+
