+            Assert.AreEqual(2.9265, SidelifterKinematics.CraneSpanY20ft, 1e-12);
+            Assert.AreEqual(5.9925, SidelifterKinematics.CraneSpanY40ft, 1e-12);
+
+            Assert.AreEqual(0.0, SidelifterKinematics.GetPhaseDuration(SideliftPhase.Idle), 1e-12);
+            Assert.AreEqual(2.2, SidelifterKinematics.GetPhaseDuration(SideliftPhase.OutriggersDeploying), 1e-12);
+            Assert.AreEqual(3.0, SidelifterKinematics.GetPhaseDuration(SideliftPhase.Swinging), 1e-12);
+            Assert.AreEqual(2.9265, SidelifterKinematics.ComputeCraneSpanY(DeployableKind.IsoContainer20), 1e-12);
+            Assert.AreEqual(5.9925, SidelifterKinematics.ComputeCraneSpanY(DeployableKind.IsoContainer40), 1e-12);
+            Assert.AreEqual(5.9925, SidelifterKinematics.ComputeCraneSpanY(DeployableKind.IsoContainer40HC), 1e-12);
+
+            Assert.AreEqual(0.0, SidelifterKinematics.Clamp01(double.NaN));
+            Assert.AreEqual(0.0, SidelifterKinematics.Clamp01(double.NegativeInfinity));
+            Assert.AreEqual(1.0, SidelifterKinematics.Clamp01(double.PositiveInfinity));
+
+            // C0 continuity across phases 0..10
+            foreach (bool isLoad in new[] { false, true })
+            {
+                foreach (int side in new[] { 1, -1 })
+                {
+                    foreach (double gnd in new[] { -0.5, 0.0, 1.5 })
+                    {
+                        for (int ph = 0; ph < 10; ph++)
+                        {
+                            var a = SidelifterKinematics.EvaluateContainerLocalPose((SideliftPhase)ph, 1.0, side, isLoad, 1.32, gnd, 0.25);
+                            var b = SidelifterKinematics.EvaluateContainerLocalPose((SideliftPhase)(ph + 1), 0.0, side, isLoad, 1.32, gnd, 0.25);
+                            Assert.AreEqual(a.X, b.X, 1e-12, $"X ph {ph}->{ph + 1}");
+                            Assert.AreEqual(a.Y, b.Y, 1e-12, $"Y ph {ph}->{ph + 1}");
+                            Assert.AreEqual(a.Z, b.Z, 1e-12, $"Z ph {ph}->{ph + 1}");
+                            Assert.AreEqual(a.CraneBoomAngle, b.CraneBoomAngle, 1e-12);
+                            Assert.AreEqual(a.CraneJibAngle, b.CraneJibAngle, 1e-12);
+                            Assert.AreEqual(a.ChainLen, b.ChainLen, 1e-12);
+                            Assert.AreEqual(0.0, a.Roll, 1e-12);
+                        }
+
+                        var mid = SidelifterKinematics.EvaluateContainerLocalPose(SideliftPhase.Swinging, 0.5, side, isLoad, 1.32, gnd, 0.0);
+                        double expectedPeak = Math.Max(1.32, gnd) + SidelifterKinematics.HoistClearanceZ + SidelifterKinematics.SwingArcCrownZ;
+                        Assert.AreEqual(side * 3.85 * 0.5, mid.X, 1e-12);
+                        Assert.AreEqual(expectedPeak, mid.Z, 1e-12);
+                    }
+                }
+            }
+
+            // Slope check boundaries: 5.9 deg passes, 6.0 deg passes, 6.1 deg fails, single corner drop fails
+            double dz59 = Math.Tan(Deg(5.9)) * 2.44;
+            Assert.IsTrue(SidelifterKinematics.CheckOutriggerSlope(10, 10 + dz59, 10, 10 + dz59).Ok);
+            double dz60 = Math.Tan(Deg(6.0)) * 2.44;
+            Assert.IsTrue(SidelifterKinematics.CheckOutriggerSlope(10, 10 + dz60, 10, 10 + dz60).Ok);
+            double dz61 = Math.Tan(Deg(6.1)) * 2.44;
+            Assert.IsFalse(SidelifterKinematics.CheckOutriggerSlope(10, 10 + dz61, 10, 10 + dz61).Ok);
+            Assert.IsFalse(SidelifterKinematics.CheckOutriggerSlope(10, 10, 10, 10 - 0.35, 2.44, 11.985).Ok);
+            Assert.IsFalse(SidelifterKinematics.CheckOutriggerSlope(new[] { new Vector3(0, 0, -1) }).Ok);
+            Assert.IsFalse(SidelifterKinematics.CheckOutriggerSlope(new[] { new Vector3(0, 0, 0) }).Ok);
+        }
