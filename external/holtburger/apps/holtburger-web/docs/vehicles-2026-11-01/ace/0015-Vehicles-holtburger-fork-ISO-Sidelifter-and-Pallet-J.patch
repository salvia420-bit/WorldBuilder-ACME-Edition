+        static List<VehicleS2C> DrainVehicleMessages(Session session)
+        {
+            var netSession = session.Network;
+            var bundleField = typeof(NetworkSession).GetField("currentBundles", BindingFlags.Instance | BindingFlags.NonPublic);
+            var bundleType = typeof(NetworkSession).Assembly.GetType("ACE.Server.Network.NetworkBundle");
+            var bundles = (Array)bundleField?.GetValue(netSession);
+            var qField = bundleType?.GetField("messages", BindingFlags.Instance | BindingFlags.NonPublic);
+            var uiBundle = bundles?.GetValue((int)GameMessageGroup.UIQueue);
+            var uiQueue = (Queue<GameMessage>)qField?.GetValue(uiBundle);
+            var outList = new List<VehicleS2C>();
+            while (uiQueue != null && uiQueue.Count > 0)
+            {
+                var gm = uiQueue.Dequeue();
+                if (gm is GameEventVehicle gev)
+                {
+                    var bytes = gev.Data.ToArray();
+                    if (bytes.Length > 16)
+                    {
+                        using var ms = new MemoryStream(bytes, 16, bytes.Length - 16);
+                        using var br = new BinaryReader(ms);
+                        var s2c = VehicleWire.ReadS2C((uint)gev.EventType, br);
+                        if (s2c != null) outList.Add(s2c);
+                    }
+                }
+            }
+            return outList;
+        }
