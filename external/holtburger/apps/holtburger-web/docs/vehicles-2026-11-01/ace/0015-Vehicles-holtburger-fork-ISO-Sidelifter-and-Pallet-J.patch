+        public static CorridorReachabilityResult IsSlotReachableForUnload(
+            DeployableKind containerKind,
+            IReadOnlyList<SlotBox> occupiedBoxes,
+            int slotIndex,
+            int subSlot = 0)
+        {
+            if (!ResolveSpec(containerKind, out var interior, out var slotDefs))
+                return new CorridorReachabilityResult(false, null, null, null, "invalid_container");
+            if (slotIndex < 0 || slotIndex >= slotDefs.Length)
+                return new CorridorReachabilityResult(false, null, null, null, "invalid_slot");
+            if (subSlot < 0 || subSlot > 1)
+                return new CorridorReachabilityResult(false, null, null, null, "invalid_subslot");
+
+            if (occupiedBoxes == null)
+                return new CorridorReachabilityResult(false, null, null, null, "slot_empty");
+
+            bool foundSlot = false;
+            SlotBox? target = null;
+            for (int i = 0; i < occupiedBoxes.Count; i++)
+            {
+                var o = occupiedBoxes[i];
+                if (o.SlotIndex != slotIndex) continue;
+                foundSlot = true;
+                if (o.PalletSize == PalletSize.Full)
+                {
+                    if (subSlot != 0)
+                        return new CorridorReachabilityResult(false, null, null, null, "invalid_subslot");
+                    target = o;
+                    break;
+                }
+                if (o.SubSlot == subSlot)
+                {
+                    target = o;
+                    break;
+                }
+            }
+
+            if (!target.HasValue)
+                return new CorridorReachabilityResult(false, null, null, null, foundSlot ? "slot_empty" : "slot_empty");
+
+            var t = target.Value;
+            return EvaluateCorridorFromDoor(in t, occupiedBoxes, interior.HalfW);
+        }
