+        public bool TryPickGroundDeployable(Player player, uint deployableGuid, out string error)
+        {
+            error = null;
+            if (IsDestroyed || StowedOnTrailerGuid != 0 || !IsActive)
+            {
+                error = "Pallet jack is unavailable.";
+                return false;
+            }
+            if (player == null || OperatorPlayerGuid != player.Guid.Full)
+            {
+                error = "Grab pallet jack before picking cargo.";
+                return false;
+            }
+            if (CarriedWcid != 0)
+            {
+                error = "Pallet jack is already carrying a pallet.";
+                return false;
+            }
+            if (ForkHeightM > 0.10f)
+            {
+                error = "ISO 3691-5: Lower forks completely before engaging a pallet.";
+                return false;
+            }
+
+            var jackPos = GlobalPosition;
+            DeployableBase target = null;
+            if (deployableGuid != 0)
+            {
+                target = DeployableManager.GetDeployable(deployableGuid);
+            }
+            else
+            {
+                target = DeployableManager.FindNearbyGlobal<DeployableBase>(jackPos, (float)MaxPickDistanceM, includeInactive: true);
+                if (target != null && target.Pallet == PalletSize.None)
+                {
+                    target = DeployableManager.GetAll()
+                        .Where(d => !d.IsDestroyed && !d.IsPacked && d.Pallet != PalletSize.None && d.Location != null)
+                        .Select(d =>
+                        {
+                            var (dx, dy, dz) = Vehicle.ToGlobal(d.Location);
+                            return (d, dist: Vector3.Distance(jackPos, new Vector3((float)dx, (float)dy, (float)dz)));
+                        })
+                        .Where(x => x.dist <= MaxPickDistanceM)
+                        .OrderBy(x => x.dist)
+                        .FirstOrDefault().d;
+                }
+            }
+
+            if (target == null)
+            {
+                AirDefense.RadarStation radar = null;
+                if (deployableGuid != 0)
+                {
+                    radar = AirDefense.AirDefenseManager.Stations.FirstOrDefault(s => s.Guid.Full == deployableGuid);
+                }
+                else
+                {
+                    radar = AirDefense.AirDefenseManager.Stations
+                        .Where(s => !s.IsDestroyed && s.Location != null)
+                        .Select(s =>
+                        {
+                            var (rx, ry, rz) = Vehicle.ToGlobal(s.Location);
+                            return (s, dist: Vector3.Distance(jackPos, new Vector3((float)rx, (float)ry, (float)rz)));
+                        })
+                        .Where(x => x.dist <= MaxPickDistanceM)
+                        .OrderBy(x => x.dist)
+                        .FirstOrDefault().s;
+                }
+
+                if (radar != null && !radar.IsDestroyed)
+                {
+                    if (radar.Location == null)
+                    {
+                        error = "Radar station location unavailable.";
+                        return false;
+                    }
+                    var (rx, ry, rz) = Vehicle.ToGlobal(radar.Location);
+                    if (Vector3.Distance(jackPos, new Vector3((float)rx, (float)ry, (float)rz)) > MaxPickDistanceM)
+                    {
+                        error = "Too far from radar station (must be <= 1.6 m).";
+                        return false;
+                    }
+                    if (radar.IsActive)
+                    {
+                        error = "ISO 3691-5: Stow/power-down radar station [R] before pallet pickup.";
+                        return false;
+                    }
+                    CarriedCargoState = default;
+                    CarriedWcid = AirDefense.RadarStation.RadarWeenieClassId;
+                    CarriedPalletSize = PalletSize.Full;
+                    AirDefense.AirDefenseManager.UnregisterStation(radar.Guid.Full);
+                    radar.Destroy();
+                    ForkHeightM = RaisedForkHeightM;
+                    ForkState = 2;
+                    BroadcastState();
+                    return true;
+                }
+            }
+
+            if (target == null || target.IsDestroyed || target.IsPacked || target.Pallet == PalletSize.None)
+            {
+                error = "No palletized deployable within 1.6 m pickup range.";
+                return false;
+            }
+            if (!target.IsStowed)
+            {
+                error = "ISO 3691-5: Stow/power-down deployable [R] before pallet pickup.";
+                return false;
+            }
+            if (target.ElevationM > 0.02f)
+            {
+                error = "ISO 3691-5: Wait for deployable mast/turret to finish lowering.";
+                return false;
+            }
+
+            var tGlobal = target.Location != null
+                ? Vehicle.ToGlobal(target.Location)
+                : (0.0, 0.0, 0.0);
+            var tVec = new Vector3((float)tGlobal.Item1, (float)tGlobal.Item2, (float)tGlobal.Item3);
+            if (Vector3.Distance(jackPos, tVec) > MaxPickDistanceM)
+            {
+                error = "Too far from deployable (must be <= 1.6 m).";
+                return false;
+            }
+
+            CarriedCargoState = target.CaptureCargoState();
+            CarriedWcid = target.Wcid;
+            CarriedPalletSize = target.Pallet;
+
+            target.Destroy();
+
+            ForkHeightM = RaisedForkHeightM;
+            ForkState = 2; // Raised
+            BroadcastState();
+            return true;
+        }
