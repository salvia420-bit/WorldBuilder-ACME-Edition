+        [TestMethod]
+        public void PalletJackRapidBurstPoseSpeedCapAndRemoteRadarBypass()
+        {
+            double x = 3520.0, y = 4520.0, z = 40.0;
+            VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = z, Nz = 1.0 };
+
+            var player = CreateTestPlayer(0x50007701u, x, y, z);
+            RegisterOnlinePlayer(player);
+            try
+            {
+                var jack = new PalletJackDeployable(new Vector3((float)x, (float)y, (float)z), 0f, player);
+                DeployableManager.Register(jack);
+                Assert.IsTrue(jack.TryGrab(player, out _));
+
+                // 1) Leaky-bucket cap: 100-packet 1ms burst of +0.44m each must cap total distance <= ~1.82m (not 44m)
+                var t = DateTime.UtcNow;
+                int accepted = 0;
+                double curX = x;
+                for (int i = 0; i < 100; i++)
+                {
+                    t = t.AddMilliseconds(1);
+                    var nextPos = Vehicle.ToPosition(curX + 0.44, y, z, Quaternion.Identity);
+                    if (jack.ApplyPoseUpdate(player, nextPos.Cell, nextPos.Pos, 0f, 0f, out _, t))
+                    {
+                        accepted++;
+                        curX += 0.44;
+                    }
+                }
+                Assert.IsTrue(accepted <= 4, $"1ms burst must be capped by leaky bucket (accepted={accepted})");
+                Assert.IsTrue(jack.GlobalPosition.X - x <= 2.0, "Total burst displacement must stay within budget");
+
+                // Wait 1s for bucket refill, then legitimate 15 Hz driving (2.2 m/s -> ~0.147 m per 66ms) must succeed continuously
+                t = t.AddSeconds(1);
+                for (int i = 0; i < 20; i++)
+                {
+                    t = t.AddMilliseconds(66);
+                    var stepPos = Vehicle.ToPosition(jack.GlobalPosition.X + 0.145, y, z, Quaternion.Identity);
+                    Assert.IsTrue(jack.ApplyPoseUpdate(player, stepPos.Cell, stepPos.Pos, 0f, 0f, out var driveErr, t), driveErr);
