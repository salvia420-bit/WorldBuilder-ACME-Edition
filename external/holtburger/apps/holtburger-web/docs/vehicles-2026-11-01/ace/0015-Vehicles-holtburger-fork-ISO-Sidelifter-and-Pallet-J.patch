+        static void RegisterOnlinePlayer(Player player)
+        {
+            var lockField = typeof(PlayerManager).GetField("playersLock", BindingFlags.Static | BindingFlags.NonPublic);
+            var dictField = typeof(PlayerManager).GetField("onlinePlayers", BindingFlags.Static | BindingFlags.NonPublic);
+            var rwLock = (ReaderWriterLockSlim)lockField?.GetValue(null);
+            var dict = (Dictionary<uint, Player>)dictField?.GetValue(null);
+            rwLock.EnterWriteLock();
+            try { dict[player.Guid.Full] = player; }
+            finally { rwLock.ExitWriteLock(); }
+        }
+
+        static void UnregisterOnlinePlayer(uint guid)
+        {
+            var lockField = typeof(PlayerManager).GetField("playersLock", BindingFlags.Static | BindingFlags.NonPublic);
+            var dictField = typeof(PlayerManager).GetField("onlinePlayers", BindingFlags.Static | BindingFlags.NonPublic);
+            var rwLock = (ReaderWriterLockSlim)lockField?.GetValue(null);
+            var dict = (Dictionary<uint, Player>)dictField?.GetValue(null);
+            rwLock.EnterWriteLock();
+            try { dict.Remove(guid); }
+            finally { rwLock.ExitWriteLock(); }
+        }
