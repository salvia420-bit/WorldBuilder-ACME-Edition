+                Assert.AreEqual(op.Guid.Full, jack.OperatorPlayerGuid);
+
+                DrainVehicleMessages(opSession);
+                jack.Destroy(true, false);
+
+                Assert.AreEqual(0u, jack.OperatorPlayerGuid);
+                var msgs = DrainVehicleMessages(opSession).OfType<VehiclePalletJackStateMsg>().ToList();
+                Assert.IsTrue(msgs.Any(m => m.PalletJackGuid == jack.Guid.Full && m.OperatorGuid == 0),
+                    "Non-deployer operator must receive PalletJackState(OperatorGuid=0) when jack is destroyed");
+            }
+            finally
+            {
+                UnregisterOnlinePlayer(deployer.Guid.Full);
+                UnregisterOnlinePlayer(op.Guid.Full);
+            }
+        }
