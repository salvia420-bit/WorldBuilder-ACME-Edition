diff --git a/Source/ACE.Server/Vehicles/Deployables/PalletJackDeployable.cs b/Source/ACE.Server/Vehicles/Deployables/PalletJackDeployable.cs
new file mode 100644
index 00000000..ba55a884
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Deployables/PalletJackDeployable.cs
@@ -0,0 +1,897 @@
+using System;
+using System.Linq;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// ISO 3691-5 walk-behind pedestrian low-lift pallet jack (WCID 4000035, DeployableKind.PalletJack = 16).
+    /// Subclasses DeployableBase; excluded from shard DB persistence.
+    /// </summary>
+    public class PalletJackDeployable : DeployableBase
+    {
+        public const uint WcidPalletJack = 4000035;
+        public const uint StandInSetup = 0x0200026B;
+
+        public const float LoweredForkHeightM = (float)ContainerLogistics.ForkLoweredZ; // 0.085f
+        public const float RaisedForkHeightM = (float)ContainerLogistics.ForkRaisedZ;   // 0.200f
+        public const double MaxGrabDistanceM = 3.5;
+        public const double MaxPickDistanceM = 1.6;
+        public const double MaxSlotEngageDistanceM = 1.8;
+        public const double AntiTeleportSpeedMps = 3.2;
+        public const double MaxPoseBudgetM = 1.5;
+
+        public uint OperatorPlayerGuid { get; set; }
+        public uint StowedOnTrailerGuid { get; set; }
+        public float TillerAngle { get; set; }
+        public float ForkHeightM { get; set; } = LoweredForkHeightM;
+        public byte ForkState { get; set; } = 0; // 0=Lowered, 1=Raising, 2=Raised, 3=Lowering
+        public uint CarriedWcid { get; set; }
+        public PalletSize CarriedPalletSize { get; set; } = PalletSize.None;
+        public PalletCargoState CarriedCargoState { get; set; }
+        public bool OnContainerRampOrFloor { get; set; }
+        public DateTime LastPoseUtc { get; set; }
+
+        private double _poseBudgetM = MaxPoseBudgetM;
+        private double _headingRad;
+        private bool _hasPose;
+        private Vector3? _customGlobalPos;
+
+        public float HeadingRad
+        {
+            get => _hasPose || Location == null ? (float)_headingRad : (float)VehicleManager.HeadingOf(Location.Rotation);
+            private set { _headingRad = GroundModel.WrapHeading(value); _hasPose = true; YawRad = (float)_headingRad; }
+        }
+
+        public Vector3 GlobalPosition
+        {
+            get
+            {
+                if (_customGlobalPos.HasValue) return _customGlobalPos.Value;
+                if (Location != null)
+                {
+                    var (gx, gy, gz) = Vehicle.ToGlobal(Location);
+                    return new Vector3((float)gx, (float)gy, (float)gz);
+                }
+                return Vector3.Zero;
+            }
+        }
+
+        public override string Name => "ISO 3691-5 Walk-Behind Pallet Jack";
+
+        public PalletJackDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.PalletJack;
+            Pallet = PalletSize.None;
+        }
+
+        public PalletJackDeployable(Vector3? globalPos = null, float heading = 0f, Player deployer = null)
+            : base(BuildWeenie(null, deployer), new ObjectGuid(0x75000000u | ((uint)new Random().Next(0x00010000, 0x000FFFFF))), null, deployer)
+        {
+            Kind = DeployableKind.PalletJack;
+            Pallet = PalletSize.None;
+            if (globalPos.HasValue)
+                SetWorldPose(globalPos.Value.X, globalPos.Value.Y, globalPos.Value.Z, heading);
+            else
+                HeadingRad = heading;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null) =>
+            BuildDeployableWeenie(
+                WcidPalletJack,
+                "hbpallet_jack",
+                "ISO 3691-5 Walk-Behind Pallet Jack",
+                "Pedestrian low-lift pallet jack. Grab tiller with [B] to move GMA pallets.");
+
+        public void SyncFromLocation()
+        {
+            if (Location == null) return;
+            _headingRad = VehicleManager.HeadingOf(Location.Rotation);
+            _hasPose = true;
+            YawRad = (float)_headingRad;
+        }
+
+        public void SetWorldPose(double gx, double gy, double gz, double heading)
+        {
+            var wrappedH = GroundModel.WrapHeading(heading);
+            _headingRad = wrappedH;
+            _hasPose = true;
+            YawRad = (float)wrappedH;
+            PitchRad = 0f;
+            RollRad = 0f;
+            _customGlobalPos = null;
+            if (Location != null && !PendingRelocateFromLandblock.HasValue)
+                PendingRelocateFromLandblock = Location.LandblockId;
+            Location = Vehicle.ToPosition(gx, gy, gz, Vehicle.YawOnly(wrappedH));
+        }
+
+        public VehiclePalletJackStateMsg CreatePalletJackStateMsg()
+        {
+            byte flags = 0;
+            if (CarriedWcid != 0) flags |= PalletJackFlags.Carrying;
+            if (OnContainerRampOrFloor) flags |= PalletJackFlags.OnContainerRampOrFloor;
+            if (StowedOnTrailerGuid != 0) flags |= PalletJackFlags.Stowed;
+
+            return new VehiclePalletJackStateMsg
+            {
+                PalletJackGuid = Guid.Full,
+                OperatorGuid = OperatorPlayerGuid,
+                StowedOnTrailerGuid = StowedOnTrailerGuid,
+                Cell = Location?.Cell ?? 0,
+                Position = Location != null ? Location.Pos : Vector3.Zero, // wire contract: landblock-local
+                Heading = HeadingRad,
+                TillerAngle = TillerAngle,
+                ForkHeightM = ForkHeightM,
+                ForkState = ForkState,
+                CarriedPalletSize = (byte)CarriedPalletSize,
+                Flags = flags,
+                Reserved = 0,
+                CarriedWcid = CarriedWcid,
+                OwnerGuid = DeployerPlayerGuid,
+            };
+        }
+
+        public override void BroadcastState(float range = 600.0f)
+        {
+            if (Location == null) return;
+            var actor = OperatorPlayerGuid != 0
+                ? PlayerManager.GetOnlinePlayer(OperatorPlayerGuid)
+                : (DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null);
+            VehicleManager.BroadcastNear(Location, range, actor, () => CreatePalletJackStateMsg());
+        }
+
+        public bool TryGrab(Player player, out string error)
+        {
+            error = null;
+            if (IsDestroyed || IsPacked)
+            {
+                error = "Pallet jack is unavailable.";
+                return false;
+            }
+            if (StowedOnTrailerGuid != 0 || !IsActive)
+            {
+                error = "Unstow pallet jack from trailer rack before grabbing tiller.";
+                return false;
+            }
+            if (player == null || player.Location == null)
+            {
+                error = "Player unavailable.";
+                return false;
+            }
+            if (VehicleManager.IsSeated(player))
+            {
+                error = "Exit vehicle before operating pallet jack.";
+                return false;
+            }
+            if (OperatorPlayerGuid != 0 && OperatorPlayerGuid != player.Guid.Full)
+            {
+                error = "Pallet jack is operated by another player.";
+                return false;
+            }
+            foreach (var other in DeployableManager.GetAll())
+            {
+                if (other is PalletJackDeployable pj && pj != this && !pj.IsDestroyed && pj.OperatorPlayerGuid == player.Guid.Full)
+                {
+                    error = "Already operating another pallet jack.";
+                    return false;
+                }
+            }
+
+            var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+            var pGlobal = new Vector3((float)px, (float)py, (float)pz);
+            if (Vector3.Distance(pGlobal, GlobalPosition) > MaxGrabDistanceM)
+            {
+                error = "Too far from pallet jack (must be <= 3.5 m).";
+                return false;
+            }
+
+            var now = DateTime.UtcNow;
+            if (LastPoseUtc == default)
+            {
+                _poseBudgetM = MaxPoseBudgetM;
+                LastPoseUtc = now;
+            }
+            else if (now > LastPoseUtc)
+            {
+                _poseBudgetM = Math.Min(MaxPoseBudgetM, _poseBudgetM + AntiTeleportSpeedMps * (now - LastPoseUtc).TotalSeconds);
+                LastPoseUtc = now;
+            }
+            OperatorPlayerGuid = player.Guid.Full;
+            BroadcastState();
+            return true;
+        }
+
+        public bool Release(Player player, out string error)
+        {
+            error = null;
+            if (OperatorPlayerGuid == 0)
+                return true;
+            if (player != null && OperatorPlayerGuid != player.Guid.Full)
+            {
+                error = "You are not operating this pallet jack.";
+                return false;
+            }
+            ForceRelease();
+            return true;
+        }
+
+        public void ForceRelease()
+        {
+            if (OperatorPlayerGuid == 0 && TillerAngle == 0f)
+                return;
+            var prevOp = OperatorPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(OperatorPlayerGuid) : null;
+            OperatorPlayerGuid = 0;
+            TillerAngle = 0f;
+            if (Location != null)
+            {
+                var actor = prevOp ?? (DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null);
+                VehicleManager.BroadcastNear(Location, 600.0f, actor, () => CreatePalletJackStateMsg());
+            }
+        }
+
+        public bool ApplyPoseUpdate(Player player, uint cell, Vector3 localPos, float heading, float tillerAngle, out string error, DateTime? nowUtcOverride = null)
+        {
+            error = null;
+            if (IsDestroyed || IsPacked || StowedOnTrailerGuid != 0 || !IsActive)
+            {
+                error = "Pallet jack is stowed or unavailable.";
+                return false;
+            }
+            if (player == null || OperatorPlayerGuid != player.Guid.Full)
+            {
+                error = "You are not operating this pallet jack.";
+                return false;
+            }
+            if (!float.IsFinite(localPos.X) || !float.IsFinite(localPos.Y) || !float.IsFinite(localPos.Z) ||
+                !float.IsFinite(heading) || !float.IsFinite(tillerAngle))
+            {
+                error = "Invalid pallet jack pose.";
+                return false;
+            }
+
+            var candidatePos = new Position(cell, localPos.X, localPos.Y, localPos.Z, 0f, 0f, 0f, 1f);
+            var (gx, gy, gz) = Vehicle.ToGlobal(candidatePos);
+            gx = Math.Clamp(gx, VehicleManager.BodyEdgeMin, VehicleManager.BodyEdgeMax);
+            gy = Math.Clamp(gy, VehicleManager.BodyEdgeMin, VehicleManager.BodyEdgeMax);
+
+            var now = nowUtcOverride ?? DateTime.UtcNow;
+            var cur = GlobalPosition;
+            double horizDist = Math.Sqrt((gx - cur.X) * (gx - cur.X) + (gy - cur.Y) * (gy - cur.Y));
+            double nextBudget = _poseBudgetM;
+            if (LastPoseUtc != default)
+            {
+                double dt = Math.Max(0.0, (now - LastPoseUtc).TotalSeconds);
+                nextBudget = Math.Min(MaxPoseBudgetM, _poseBudgetM + AntiTeleportSpeedMps * dt);
+            }
+            if (horizDist > nextBudget + 1e-6)
+            {
+                error = "Pallet jack movement exceeds 3.2 m/s ISO 3691-5 limit.";
+                return false;
+            }
+
+            // Probe container walkable floor/ramp vs ground terrain
+            bool onContainer = false;
+            double clampedZ = gz;
+
+            foreach (var d in DeployableManager.GetAll())
+            {
+                if (d is not IsoContainerDeployable c || c.IsDestroyed || c.IsPacked || !c.IsActive)
+                    continue;
+                var sup = c.ProbeWalkableSupport((float)gx, (float)gy, (float)gz);
+                if (sup.Found)
+                {
+                    if (c.MountedOnTrailerGuid != 0 || SemiTrailerDeployable.IsContainerInSideliftTransfer(c.Guid.Full))
+                    {
+                        error = "ISO 3874: Offload container to ground before operating pallet jack on it.";
+                        return false;
+                    }
+                    onContainer = true;
+                    clampedZ = sup.DeckZ;
+                    break;
+                }
+            }
+
+            if (!onContainer)
+            {
+                var sampled = VehicleManager.SampleTrailerTerrainZ(gx, gy, gz);
+                if (double.IsFinite(sampled))
+                    clampedZ = sampled;
+            }
+
+            OnContainerRampOrFloor = onContainer;
+            TillerAngle = Math.Clamp(tillerAngle, -(float)ContainerLogistics.MaxTillerRad, (float)ContainerLogistics.MaxTillerRad);
+            _poseBudgetM = Math.Max(0.0, nextBudget - horizDist);
+            LastPoseUtc = now;
+
+            SetWorldPose(gx, gy, clampedZ, heading);
+            VehicleManager.MoveAuxWorldObject(this, Location, null);
+            if (player.PhysicsObj != null && player.Location != null)
+            {
+                double opX = gx - Math.Sin(heading) * 0.62;
+                double opY = gy - Math.Cos(heading) * 0.62;
+                var opPos = Vehicle.ToPosition(opX, opY, clampedZ, Vehicle.YawOnly(heading));
+                if (opPos != null)
+                    VehicleManager.MoveBody(player, opPos);
+            }
+            BroadcastState();
+            return true;
+        }
+
+        public bool RaiseForks(Player player, out string error)
+        {
+            error = null;
+            if (IsDestroyed || StowedOnTrailerGuid != 0 || !IsActive)
+            {
+                error = "Pallet jack is unavailable.";
+                return false;
+            }
+            if (player == null || OperatorPlayerGuid != player.Guid.Full)
+            {
+                error = "You are not operating this pallet jack.";
+                return false;
+            }
+            ForkHeightM = RaisedForkHeightM;
+            ForkState = 2; // Raised
+            BroadcastState();
+            return true;
+        }
+
+        public bool LowerForks(Player player, out string error)
+        {
+            error = null;
+            if (IsDestroyed || StowedOnTrailerGuid != 0 || !IsActive)
+            {
+                error = "Pallet jack is unavailable.";
+                return false;
+            }
