+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    public struct PalletCargoState
+    {
+        public bool HasState;
+        public ushort AmmoRemaining;
+        public float FuelRemaining;
+        public float EnergyStoredJoules;
+        public float ReloadTimerS;
+    }
+
+    public readonly struct PinwheelSlotDef
+    {
+        public readonly int SlotIndex;
+        public readonly double X;
+        public readonly double Y;
+        public readonly char Orient;
+        public readonly double Dx;
+        public readonly double Dy;
+
+        public PinwheelSlotDef(int slotIndex, double x, double y, char orient, double dx, double dy)
+        {
+            SlotIndex = slotIndex;
+            X = x;
+            Y = y;
+            Orient = orient;
+            Dx = dx;
+            Dy = dy;
+        }
+    }
+
+    public readonly struct ContainerInteriorSpec
+    {
+        public readonly DeployableKind Kind;
+        public readonly double Width;
+        public readonly double Length;
+        public readonly double HalfW;
+        public readonly double HalfL;
+        public readonly double FloorZ;
+        public readonly int MaxFull;
+        public readonly int MaxHalf;
+
+        public ContainerInteriorSpec(DeployableKind kind, double width, double length, double halfW, double halfL, double floorZ, int maxFull, int maxHalf)
+        {
+            Kind = kind;
+            Width = width;
+            Length = length;
+            HalfW = halfW;
+            HalfL = halfL;
+            FloorZ = floorZ;
+            MaxFull = maxFull;
+            MaxHalf = maxHalf;
+        }
+    }
+
+    public struct SlotBox
+    {
+        public int SlotIndex;
+        public int SubSlot;
+        public PalletSize PalletSize;
+        public uint CargoWcid;
+        public double X;
+        public double Y;
+        public double Dx;
+        public double Dy;
+        public char Orient;
+        public double X0;
+        public double X1;
+        public double Y0;
+        public double Y1;
+    }
+
+    public readonly struct SlotRef : IEquatable<SlotRef>
+    {
+        public readonly int SlotIndex;
