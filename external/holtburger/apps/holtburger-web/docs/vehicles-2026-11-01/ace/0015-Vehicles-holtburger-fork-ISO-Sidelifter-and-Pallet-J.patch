+            jack.IsActive = true;
+            jack.OnContainerRampOrFloor = false;
+            jack.SetWorldPose(wx, wy, targetZ, HeadingRad);
+            VehicleManager.MoveAuxWorldObject(jack, jack.Location, null);
+            jack.BroadcastState();
+            BroadcastState();
+            return true;
+        }
