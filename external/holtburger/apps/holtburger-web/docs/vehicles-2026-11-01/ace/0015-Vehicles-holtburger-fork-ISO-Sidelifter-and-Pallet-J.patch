+        public static List<SlotBox> ExtractOccupiedBoxes(IsoContainerDeployable container)
+        {
+            var boxes = new List<SlotBox>();
+            if (container == null) return boxes;
+            if (!ResolveSpec(container.Kind, out _, out var slotDefs)) return boxes;
+
+            foreach (var s in container.Slots)
+            {
+                if (s.SlotIndex < 0 || s.SlotIndex >= slotDefs.Length) continue;
+                if (!s.Occupied && s.OccupiedSubSlots == 0) continue;
+
+                var def = slotDefs[s.SlotIndex];
+                if (s.OccupiedPalletSize == PalletSize.Full)
+                {
+                    var box = GetSlotSubBox(in def, PalletSize.Full, 0);
+                    box.CargoWcid = s.OccupiedWcids[0];
+                    boxes.Add(box);
+                }
+                else if (s.OccupiedPalletSize == PalletSize.Half)
+                {
+                    for (int sub = 0; sub <= 1; sub++)
+                    {
+                        if ((s.OccupiedSubSlots & (1 << sub)) != 0)
+                        {
+                            var box = GetSlotSubBox(in def, PalletSize.Half, sub);
+                            box.CargoWcid = s.OccupiedWcids[sub];
+                            boxes.Add(box);
+                        }
+                    }
+                }
+            }
+            return boxes;
+        }
