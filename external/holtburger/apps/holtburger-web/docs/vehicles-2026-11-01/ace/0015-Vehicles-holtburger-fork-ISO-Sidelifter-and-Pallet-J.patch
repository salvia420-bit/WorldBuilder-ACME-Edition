+        [TestMethod]
+        public void ContainerLogisticsPinwheelLifoHalfSubslotsPinchAndBounds()
+        {
+            // 1) 20ft full-pallet peel (10 -> 0)
+            var c20 = new IsoContainerDeployable(IsoContainerDeployable.BuildWeenie(IsoContainerDeployable.Wcid20ft), new ObjectGuid(0x75007001u));
+            c20.SetDoorProgress(1.0f);
+            for (int i = 0; i < 10; i++)
+                Assert.IsTrue(c20.TryLoadWcid(i, 4000010, PalletSize.Full, 0));
+
+            var init20 = ContainerLogistics.ComputeReachableUnloadSlots(c20);
+            CollectionAssert.AreEqual(new[] { 8, 9 }, init20.Reachable.Select(r => r.SlotIndex).OrderBy(x => x).ToArray());
+            Assert.IsFalse(ContainerLogistics.IsSlotReachableForUnload(c20, 0).Reachable);
+
+            Assert.IsTrue(c20.TryUnpackSlot(9, out uint _));
+            var blk6 = ContainerLogistics.IsSlotReachableForUnload(c20, 6);
+            Assert.IsFalse(blk6.Reachable);
+            Assert.AreEqual(8, blk6.BlockedBySlotIndex);
+
+            int peel20 = 0;
+            while (c20.OccupiedFullBayCount > 0)
+            {
+                var res = ContainerLogistics.ComputeReachableUnloadSlots(c20);
+                Assert.IsTrue(res.Reachable.Count > 0, $"20ft deadlock with {c20.OccupiedFullBayCount} left");
+                var pick = res.Reachable[0];
+                Assert.IsTrue(c20.TryUnpackSlot(pick.SlotIndex, out uint _, (sbyte)pick.SubSlot));
+                peel20++;
+            }
+            Assert.AreEqual(9, peel20);
+
+            // 2) 40ft full-pallet peel (21 -> 0)
+            var c40 = new IsoContainerDeployable(IsoContainerDeployable.BuildWeenie(IsoContainerDeployable.Wcid40ftHC), new ObjectGuid(0x75007002u));
+            c40.SetDoorProgress(1.0f);
+            for (int i = 0; i < 21; i++)
+                Assert.IsTrue(c40.TryLoadWcid(i, 4000011, PalletSize.Full, 0));
+
+            var init40 = ContainerLogistics.ComputeReachableUnloadSlots(c40);
+            CollectionAssert.AreEqual(new[] { 18, 20 }, init40.Reachable.Select(r => r.SlotIndex).OrderBy(x => x).ToArray());
+
+            int peel40 = 0;
+            while (c40.OccupiedFullBayCount > 0)
+            {
+                var res = ContainerLogistics.ComputeReachableUnloadSlots(c40);
+                Assert.IsTrue(res.Reachable.Count > 0, $"40ft deadlock with {c40.OccupiedFullBayCount} left");
+                var pick = res.Reachable[0];
+                Assert.IsTrue(c40.TryUnpackSlot(pick.SlotIndex, out uint _, (sbyte)pick.SubSlot));
+                peel40++;
+            }
+            Assert.AreEqual(21, peel40);
+
+            // 3) 'Y' (+90 deg) subSlot 0 blocks subSlot 1; 0.685m pallet jack pinch blocks 16:1 between 18:0 and 20
+            var slot8 = ContainerLogistics.PinwheelSlots20[8];
+            var s8_0 = ContainerLogistics.GetSlotSubBox(in slot8, PalletSize.Half, 0);
+            var s8_1 = ContainerLogistics.GetSlotSubBox(in slot8, PalletSize.Half, 1);
+            Assert.IsTrue(s8_0.Y < s8_1.Y);
+
+            var occY = new[]
+            {
+                s8_0,
+                s8_1,
+            };
+            Assert.IsTrue(ContainerLogistics.IsSlotReachableForUnload(DeployableKind.IsoContainer20, occY, 8, 0).Reachable);
+            var yBlk = ContainerLogistics.IsSlotReachableForUnload(DeployableKind.IsoContainer20, occY, 8, 1);
+            Assert.IsFalse(yBlk.Reachable);
+            Assert.AreEqual(8, yBlk.BlockedBySlotIndex);
+            Assert.AreEqual(0, yBlk.BlockedBySubSlot);
+
+            var pinchOcc = new[]
+            {
+                ContainerLogistics.GetSlotSubBox(in ContainerLogistics.PinwheelSlots40[18], PalletSize.Half, 0),
+                ContainerLogistics.GetSlotSubBox(in ContainerLogistics.PinwheelSlots40[20], PalletSize.Full, 0),
+                ContainerLogistics.GetSlotSubBox(in ContainerLogistics.PinwheelSlots40[16], PalletSize.Half, 1),
+            };
+            Assert.IsFalse(ContainerLogistics.IsSlotReachableForUnload(DeployableKind.IsoContainer40, pinchOcc, 16, 1).Reachable);
+
+            // 4) Deepest-first load (+Y -> -Y) and strict bounds checks (no subSlot & 1 aliasing)
+            var loadInit = ContainerLogistics.ComputeReachableLoadSlots(DeployableKind.IsoContainer20, Array.Empty<SlotBox>(), PalletSize.Full);
+            Assert.AreEqual(10, loadInit.Reachable.Count);
+            Assert.IsTrue(loadInit.Reachable[0].Y >= loadInit.Reachable[^1].Y);
+
+            Assert.AreEqual("invalid_slot", ContainerLogistics.IsSlotReachableForLoad(c20, -1, 0, PalletSize.Full).Reason);
+            Assert.AreEqual("invalid_slot", ContainerLogistics.IsSlotReachableForLoad(c20, 10, 0, PalletSize.Full).Reason);
+            Assert.AreEqual("invalid_subslot", ContainerLogistics.IsSlotReachableForLoad(c20, 0, 2, PalletSize.Half).Reason);
+            Assert.AreEqual("invalid_subslot", ContainerLogistics.IsSlotReachableForLoad(c20, 0, 1, PalletSize.Full).Reason);
+            Assert.AreEqual("invalid_subslot", ContainerLogistics.IsSlotReachableForUnload(c20, 0, 3).Reason);
+        }
