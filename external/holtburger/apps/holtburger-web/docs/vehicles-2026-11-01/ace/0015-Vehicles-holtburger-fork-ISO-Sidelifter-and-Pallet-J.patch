+            if (palletSize != PalletSize.Full && palletSize != PalletSize.Half)
+                return new CorridorReachabilityResult(false, null, null, null, "invalid_pallet_size");
+            if (palletSize == PalletSize.Full && subSlot != 0)
+                return new CorridorReachabilityResult(false, null, null, null, "invalid_subslot");
+
+            if (occupiedBoxes != null)
+            {
+                int? firstHalfSub = null;
+                for (int i = 0; i < occupiedBoxes.Count; i++)
+                {
+                    var o = occupiedBoxes[i];
+                    if (o.SlotIndex != slotIndex) continue;
+                    if (o.PalletSize == PalletSize.Full)
+                    {
+                        return new CorridorReachabilityResult(
+                            false, slotIndex, 0, new[] { new SlotRef(slotIndex, 0) }, "slot_occupied");
+                    }
+                    if (o.PalletSize == PalletSize.Half)
+                    {
+                        if (palletSize == PalletSize.Full)
+                        {
+                            if (!firstHalfSub.HasValue || o.SubSlot < firstHalfSub.Value)
+                                firstHalfSub = o.SubSlot;
+                        }
+                        else if (o.SubSlot == subSlot)
+                        {
+                            return new CorridorReachabilityResult(
+                                false, slotIndex, subSlot, new[] { new SlotRef(slotIndex, subSlot) }, "slot_occupied");
+                        }
+                    }
+                }
+                if (firstHalfSub.HasValue)
+                {
+                    return new CorridorReachabilityResult(
+                        false, slotIndex, firstHalfSub.Value, new[] { new SlotRef(slotIndex, firstHalfSub.Value) }, "slot_occupied");
+                }
+            }
+
+            var cand = GetSlotSubBox(in slotDefs[slotIndex], palletSize, palletSize == PalletSize.Half ? subSlot : 0);
+            return EvaluateCorridorFromDoor(in cand, occupiedBoxes, interior.HalfW);
+        }
+    }
+}
