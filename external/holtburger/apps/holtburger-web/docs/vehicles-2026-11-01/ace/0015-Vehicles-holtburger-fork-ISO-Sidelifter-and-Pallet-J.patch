+        public static ReachableSlotListResult ComputeReachableLoadSlots(DeployableKind containerKind, IReadOnlyList<SlotBox> occupiedBoxes, PalletSize palletSize)
+        {
+            var result = new ReachableSlotListResult();
+            if (!ResolveSpec(containerKind, out var interior, out var slotDefs))
+                return result;
+            if (palletSize != PalletSize.Full && palletSize != PalletSize.Half)
+                return result;
+
+            var fullSet = new HashSet<int>();
+            var halfMap = new Dictionary<int, HashSet<int>>();
+            if (occupiedBoxes != null)
+            {
+                for (int i = 0; i < occupiedBoxes.Count; i++)
+                {
+                    var o = occupiedBoxes[i];
+                    if (o.PalletSize == PalletSize.Full)
+                    {
+                        fullSet.Add(o.SlotIndex);
+                    }
+                    else if (o.PalletSize == PalletSize.Half)
+                    {
+                        if (!halfMap.TryGetValue(o.SlotIndex, out var set))
+                        {
+                            set = new HashSet<int>();
+                            halfMap[o.SlotIndex] = set;
+                        }
+                        set.Add(o.SubSlot);
+                    }
+                }
+            }
+
+            bool wantHalf = palletSize == PalletSize.Half;
+            var candidates = new List<SlotBox>();
+            for (int i = 0; i < slotDefs.Length; i++)
+            {
+                var def = slotDefs[i];
+                if (fullSet.Contains(def.SlotIndex))
+                    continue;
+                halfMap.TryGetValue(def.SlotIndex, out var subs);
+                if (!wantHalf)
+                {
+                    if (subs != null && subs.Count > 0)
+                        continue;
+                    candidates.Add(GetSlotSubBox(in def, PalletSize.Full, 0));
+                }
+                else
+                {
+                    for (int sub = 0; sub <= 1; sub++)
+                    {
+                        if (subs != null && subs.Contains(sub))
+                            continue;
+                        candidates.Add(GetSlotSubBox(in def, PalletSize.Half, sub));
+                    }
+                }
+            }
+
+            for (int i = 0; i < candidates.Count; i++)
+            {
+                var cand = candidates[i];
+                var corr = EvaluateCorridorFromDoor(in cand, occupiedBoxes, interior.HalfW);
+                var entry = new ReachableSlotEntry
+                {
+                    SlotIndex = cand.SlotIndex,
+                    SubSlot = cand.SubSlot,
+                    PalletSize = cand.PalletSize,
+                    X = cand.X,
+                    Y = cand.Y,
+                    Dx = cand.Dx,
+                    Dy = cand.Dy,
+                    Orient = cand.Orient,
+                    Reachable = corr.Reachable,
+                    BlockedBySlotIndex = corr.BlockedBySlotIndex,
+                    BlockedBySubSlot = corr.BlockedBySubSlot,
+                    BlockedBy = corr.BlockedBy,
+                };
+                result.All.Add(entry);
+                if (corr.Reachable) result.Reachable.Add(entry);
+                else result.Blocked.Add(entry);
+            }
+
+            // Deepest-first (+Y -> -Y) for back-to-front loading order
+            static int ByDeepestFirst(ReachableSlotEntry a, ReachableSlotEntry b)
+            {
+                int cmp = b.Y.CompareTo(a.Y);
+                if (cmp != 0) return cmp;
+                cmp = a.SlotIndex.CompareTo(b.SlotIndex);
+                return cmp != 0 ? cmp : b.SubSlot.CompareTo(a.SubSlot);
+            }
+
+            result.Reachable.Sort(ByDeepestFirst);
+            result.Blocked.Sort(ByDeepestFirst);
+            result.All.Sort(ByDeepestFirst);
+            return result;
+        }
