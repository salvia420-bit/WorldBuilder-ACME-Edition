+        public static CorridorReachabilityResult EvaluateCorridorFromDoor(
+            in SlotBox targetBox,
+            IReadOnlyList<SlotBox> obstacleBoxes,
+            double halfW = 1.176)
+        {
+            var blockers = new Dictionary<SlotRef, SlotBox>();
+            void AddBlocker(in SlotBox b)
+            {
+                var key = new SlotRef(b.SlotIndex, b.SubSlot);
+                if (!blockers.ContainsKey(key))
+                    blockers[key] = b;
+            }
+
+            var frontObstacles = new List<SlotBox>();
+            if (obstacleBoxes != null)
+            {
+                for (int i = 0; i < obstacleBoxes.Count; i++)
+                {
+                    var b = obstacleBoxes[i];
+                    if (b.SlotIndex == targetBox.SlotIndex && b.SubSlot == targetBox.SubSlot)
+                        continue;
+
+                    if (b.Y0 < targetBox.Y0 - Eps)
+                    {
+                        frontObstacles.Add(b);
+                        double overlapX = Math.Min(targetBox.X1, b.X1) - Math.Max(targetBox.X0, b.X0);
+                        if (overlapX > Eps)
+                            AddBlocker(in b);
+                    }
+                }
+            }
+
+            double requiredWidth = Math.Max(targetBox.Dx, PalletJackWidth);
+            for (int i = 0; i < frontObstacles.Count; i++)
+            {
+                var b = frontObstacles[i];
+                if (blockers.ContainsKey(new SlotRef(b.SlotIndex, b.SubSlot)))
+                    continue;
+
+                double leftWall = -halfW;
+                double rightWall = halfW;
+                SlotBox? leftBlocker = null;
+                SlotBox? rightBlocker = null;
+
+                for (int j = 0; j < frontObstacles.Count; j++)
+                {
+                    var o = frontObstacles[j];
+                    double overlapY = Math.Min(b.Y1, o.Y1) - Math.Max(b.Y0, o.Y0);
+                    if (overlapY <= Eps)
+                        continue;
+
+                    if (o.X1 <= targetBox.X0 + Eps && o.X1 > leftWall)
+                    {
+                        leftWall = o.X1;
+                        leftBlocker = o;
+                    }
+                    if (o.X0 >= targetBox.X1 - Eps && o.X0 < rightWall)
+                    {
+                        rightWall = o.X0;
+                        rightBlocker = o;
+                    }
+                }
+
+                if (rightWall - leftWall < requiredWidth - Eps)
+                {
+                    if (leftBlocker.HasValue && rightBlocker.HasValue)
+                    {
+                        double dLeft = targetBox.X0 - leftBlocker.Value.X1;
+                        double dRight = rightBlocker.Value.X0 - targetBox.X1;
+                        var chosen = dLeft <= dRight ? leftBlocker.Value : rightBlocker.Value;
+                        AddBlocker(in chosen);
+                    }
+                    else if (leftBlocker.HasValue)
+                    {
+                        var chosen = leftBlocker.Value;
+                        AddBlocker(in chosen);
+                    }
+                    else if (rightBlocker.HasValue)
+                    {
+                        var chosen = rightBlocker.Value;
+                        AddBlocker(in chosen);
+                    }
+                    else
+                    {
+                        AddBlocker(in b);
+                    }
+                }
+            }
+
+            var sorted = blockers.Values
+                .OrderBy(a => a.Y0)
+                .ThenBy(a => a.SlotIndex)
+                .ThenBy(a => a.SubSlot)
+                .ToList();
+
+            var refs = sorted.Select(b => new SlotRef(b.SlotIndex, b.SubSlot)).ToArray();
+            return new CorridorReachabilityResult(
+                reachable: sorted.Count == 0,
+                blockedBySlotIndex: sorted.Count > 0 ? sorted[0].SlotIndex : null,
+                blockedBySubSlot: sorted.Count > 0 ? sorted[0].SubSlot : null,
+                blockedBy: refs,
+                reason: sorted.Count == 0 ? null : "blocked");
+        }
