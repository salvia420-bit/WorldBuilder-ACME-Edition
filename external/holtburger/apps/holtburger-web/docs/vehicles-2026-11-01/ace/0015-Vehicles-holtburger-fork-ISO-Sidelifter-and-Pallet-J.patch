+        private double ComputeSlotLocalY(IsoContainerDeployable container, byte slot, bool explicitCenter)
+        {
+            if (Spec.Kind == "40ft" && container != null && container.ExternalDimensions.Y < 7.0f)
+            {
+                if (slot == 1) return 2.9295;
