+        /// <summary>
+        /// The physics GfxObjs (polygons + BSP trees) of a Setup's parts, built off the world thread into ACE's permanent
+        /// GfxObjCache (a ConcurrentDictionary; the polygon / vertex / BSP sub-caches are disabled, so construction shares
+        /// no state). Without it the first InitPhysicsObj of a model builds them on the landblock tick: m3-y on the
+        /// 1070-session server: Royal Guard 106 ms, Necromancer 73 ms, a door 96 ms, a Festival Stone 45 ms.
+        /// </summary>
+        static void WarmPhysicsParts(SetupModel setup)
+        {
+            if (setup?.Parts == null)
+                return;
+            foreach (var part in setup.Parts)
+            {
+                if (part == 0 || !warmedGfxObjs.TryAdd(part, 0))
+                    continue;
+                var t0 = Stopwatch.GetTimestamp();
+                try
+                {
+                    ACE.Server.Physics.Entity.GfxObjCache.Get(part);
+                }
+                catch (Exception e)
+                {
+                    log.Debug($"[VEHICLE] physics warm-up of GfxObj {part:X8} failed: {e.Message}");
+                }
+                Interlocked.Increment(ref GfxObjsWarmed);
+                Interlocked.Add(ref gfxWarmTicks, Stopwatch.GetTimestamp() - t0);
+            }
+        }
+        static readonly ConcurrentDictionary<uint, byte> warmedGfxObjs = new ConcurrentDictionary<uint, byte>();
