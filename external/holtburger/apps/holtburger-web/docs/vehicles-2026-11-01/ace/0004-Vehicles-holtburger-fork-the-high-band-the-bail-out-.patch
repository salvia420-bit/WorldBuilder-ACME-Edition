+        /// <summary>Height above the ground under the vehicle (NaN off the map).</summary>
+        static double Agl(Vehicle v) => v.State.Z - VehicleTerrain.Ground(v.State.X, v.State.Y);
+
+        /// <summary>
+        /// vehicle_derelict_high_agl (flight experience): an empty vehicle left high in the air (its pilot bailed out of the
+        /// high band) glides down at idle for many minutes — ~13 min and ~25 km from 5 km up — loading a 3×3 of landblocks
+        /// at every crossing for nobody. Above the threshold it despawns 30 s after it went derelict (it is a dot by then).
+        /// </summary>
+        static bool IsDerelictHigh(Vehicle v)
+        {
+            var band = DerelictHighAgl;
+            if (band <= 0 || (DateTime.UtcNow - v.ModeSinceUtc).TotalSeconds < DerelictHighDespawnSeconds)
+                return false;
+            var agl = Agl(v);
+            return !double.IsNaN(agl) && agl > band;
+        }
+
+        /// <summary>vehicle_high_band_agl (flight experience): the pilot is above the band where the ground matters.</summary>
+        public static bool InHighBand(Vehicle v)
+        {
+            var band = HighBandAgl;
+            if (band <= 0)
+                return false;
+            var agl = Agl(v);
+            return !double.IsNaN(agl) && agl > band;
+        }
