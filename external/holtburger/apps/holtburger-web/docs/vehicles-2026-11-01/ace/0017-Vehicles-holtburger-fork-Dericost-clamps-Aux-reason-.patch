+        [TestMethod]
+        public void R1_Dericost_PalletJack_ApplyPoseUpdate_AllowsValidStepsAndEnforcesSpeedLimit()
+        {
+            double gx = 10000.0;
+            double gy = Vehicle.DericostYOffset + 1000.0; // 69928.0
+            double gz = 40.0;
+            VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = gz, Nz = 1.0 };
+
+            var player = CreateTestPlayer(0x50010001u, gx, gy - 0.62, gz);
+            var jack = new PalletJackDeployable(new Vector3((float)gx, (float)gy, (float)gz), 0f, player);
+            DeployableManager.Register(jack);
+
+            Assert.IsTrue(jack.TryGrab(player, out var gErr), gErr);
+            var t0 = DateTime.UtcNow;
+
+            var stepPos = Vehicle.ToPosition(gx, gy + 0.15, gz, Quaternion.Identity);
+            Assert.AreNotEqual(0u, stepPos.Cell & 0x8000u, "Dericost cell must set bit 15 (0x8000)");
+            Assert.IsTrue(jack.ApplyPoseUpdate(player, stepPos.Cell, stepPos.Pos, 0f, 0f, out var stepErr, t0.AddMilliseconds(100)), stepErr);
+            Assert.IsTrue(jack.GlobalPosition.Y >= 69928.0f, $"Dericost Y must not be clamped to Dereth (got {jack.GlobalPosition.Y})");
+            Assert.AreEqual(gy + 0.15, jack.GlobalPosition.Y, 0.05);
+
+            var jumpPos = Vehicle.ToPosition(gx, gy + 10.15, gz, Quaternion.Identity);
+            Assert.IsFalse(jack.ApplyPoseUpdate(player, jumpPos.Cell, jumpPos.Pos, 0f, 0f, out var jumpErr, t0.AddMilliseconds(200)));
+            StringAssert.Contains(jumpErr, "3.2");
+        }
