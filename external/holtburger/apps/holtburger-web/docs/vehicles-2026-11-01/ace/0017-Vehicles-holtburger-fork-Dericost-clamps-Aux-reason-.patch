+        [TestMethod]
+        public void M1_Iter2_TrailerHitchAndUnhitch_RejectsSeatedNonPilotPassenger()
+        {
+            double x = 3500.0, y = 4500.0, z = 40.0;
+            var driver = CreateTestPlayer(0x50010981u, x, y, z);
+            var passenger = CreateTestPlayer(0x50010982u, x, y, z);
+            CreateSessionWithCapture(driver, caps: VehicleWire.CapObserve | VehicleWire.CapPilot);
+            CreateSessionWithCapture(passenger, caps: VehicleWire.CapObserve | VehicleWire.CapPilot);
+            RegisterOnlinePlayer(driver);
+            RegisterOnlinePlayer(passenger);
+
+            try
+            {
+                var tractor = CreateTestSemi(0x75010981u, x, y, z);
+                var fw = TrailerKinematics.ComputeFifthWheelPose(tractor.GroundState, tractor.Profile.FifthWheelOffsetY, tractor.Profile.FifthWheelOffsetZ);
+                var trailer = RegisterSidelifter(0x75010982u, fw.x, fw.y - TrailerKinematics.Chassis40.KpY, z);
+
+                // Seat-1 passenger cannot Hitch while seated
+                VehicleManager.SetSeatedForTesting(passenger, tractor, 1);
+                Assert.IsFalse(VehicleManager.HandleTrailerAction(passenger, new VehicleTrailerAction
+                {
+                    TrailerGuid = trailer.Guid.Full,
+                    VehicleGuid = tractor.Guid.Full,
+                    Action = (byte)TrailerActionKind.Hitch,
+                }, out var passengerHitchErr));
+                StringAssert.Contains(passengerHitchErr, "driver");
+                Assert.AreEqual(0u, tractor.HitchedTrailerGuid);
+
+                // Seat-0 driver CAN Hitch while seated
+                VehicleManager.SetSeatedForTesting(driver, tractor, 0);
+                Assert.IsTrue(VehicleManager.HandleTrailerAction(driver, new VehicleTrailerAction
+                {
+                    TrailerGuid = trailer.Guid.Full,
+                    VehicleGuid = tractor.Guid.Full,
+                    Action = (byte)TrailerActionKind.Hitch,
+                }, out var driverHitchErr), driverHitchErr);
+                Assert.AreEqual(trailer.Guid.Full, tractor.HitchedTrailerGuid);
+
+                // Seat-1 passenger cannot Unhitch while seated
+                Assert.IsFalse(VehicleManager.HandleTrailerAction(passenger, new VehicleTrailerAction
+                {
+                    TrailerGuid = trailer.Guid.Full,
+                    VehicleGuid = tractor.Guid.Full,
+                    Action = (byte)TrailerActionKind.Unhitch,
+                }, out var passengerUnhitchErr));
+                StringAssert.Contains(passengerUnhitchErr, "driver");
+                Assert.AreEqual(trailer.Guid.Full, tractor.HitchedTrailerGuid);
+
+                // Seat-0 driver CAN Unhitch while seated
+                Assert.IsTrue(VehicleManager.HandleTrailerAction(driver, new VehicleTrailerAction
+                {
+                    TrailerGuid = trailer.Guid.Full,
+                    VehicleGuid = tractor.Guid.Full,
+                    Action = (byte)TrailerActionKind.Unhitch,
+                }, out var driverUnhitchErr), driverUnhitchErr);
+                Assert.AreEqual(0u, tractor.HitchedTrailerGuid);
+            }
+            finally
+            {
+                VehicleManager.ClearSeatedForTesting(driver);
+                VehicleManager.ClearSeatedForTesting(passenger);
+                UnregisterOnlinePlayer(driver.Guid.Full);
+                UnregisterOnlinePlayer(passenger.Guid.Full);
+            }
+        }
+    }
+}
