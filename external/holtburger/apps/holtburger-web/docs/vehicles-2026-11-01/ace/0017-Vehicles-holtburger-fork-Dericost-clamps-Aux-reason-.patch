+                    TargetGuid = station.Guid.Full,
+                }));
+                Assert.IsTrue(jack.TryPickGroundDeployable(actor, station.Guid.Full, out _));
+                DrainVehicleMessages(lateSession);
+                Assert.IsTrue(jack.TryDropToGround(actor, out var droppedObj, out var dropErr, activateOnDrop: false), dropErr);
+                var droppedRadar = droppedObj as RadarStation;
+                Assert.IsNotNull(droppedRadar);
+                var dropMsgs = DrainVehicleMessages(lateSession).OfType<VehicleDeployableStateMsg>()
+                    .Where(m => m.DeployableGuid == droppedRadar.Guid.Full).ToList();
+                Assert.IsTrue(dropMsgs.Any(m => m.OnlineFlags == DeployableOnlineFlags.Stowed));
+            }
+            finally
+            {
+                UnregisterOnlinePlayer(actor.Guid.Full);
+                UnregisterOnlinePlayer(lateObserver.Guid.Full);
+            }
+        }
