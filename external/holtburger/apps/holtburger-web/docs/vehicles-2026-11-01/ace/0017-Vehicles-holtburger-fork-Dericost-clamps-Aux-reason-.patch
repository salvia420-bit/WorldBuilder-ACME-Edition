+                // TryDropToGround for RadarStation (activateOnDrop: false) broadcasts stowed initial state
+                VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = z, Nz = 1.0 };
+                var jack = new PalletJackDeployable(new Vector3((float)(x + 0.5), (float)y, (float)z), 0f, actor);
