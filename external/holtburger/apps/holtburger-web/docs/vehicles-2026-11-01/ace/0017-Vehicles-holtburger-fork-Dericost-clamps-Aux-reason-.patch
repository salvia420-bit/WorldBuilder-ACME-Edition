+        [TestMethod]
+        public void M1_Iter2_IsoContainer_TryUnpackSlot_4000002_UsesTryEnterWorld_And_PreservesSlotOnFailure()
+        {
+            double x = 3500.0, y = 4500.0, z = 40.0;
+            var owner = CreateTestPlayer(0x50010961u, x, y, z);
+            var session = CreateSessionWithCapture(owner);
+            RegisterOnlinePlayer(owner);
+
+            var prevOverride = DeployableManager.EnterWorldOverrideForTesting;
+            try
+            {
+                var box = RegisterContainer(0x75010960u, IsoContainerDeployable.Wcid40ftHC, x, y, z);
+                box.SetDoorProgress(1.0f);
+                Assert.IsTrue(box.TryLoadWcid(0, RadarStation.RadarWeenieClassId));
+                Assert.AreEqual(1, box.OccupiedFullBayCount);
+
+                // Failure path: TryEnterWorld returns false -> slot preserved, nothing registered or broadcast
+                DeployableManager.EnterWorldOverrideForTesting = _ => false;
+                DrainVehicleMessages(session);
+                Assert.IsFalse(box.TryUnpackSlot(0, out WorldObject failedSpawn));
+                Assert.IsNull(failedSpawn);
+                Assert.AreEqual(0, AirDefenseManager.Stations.Count);
+                Assert.AreEqual(0, DrainVehicleMessages(session).OfType<VehicleDeployableStateMsg>().Count());
+                Assert.AreEqual(1, box.OccupiedFullBayCount, "Failed TryEnterWorld must not consume container slot");
+                Assert.IsTrue(box.Slots[0].Occupied);
+                Assert.AreEqual(RadarStation.RadarWeenieClassId, box.Slots[0].OccupiedWcids[0]);
+
+                // Success path: TryEnterWorld returns true -> station registered and local state broadcast
+                DeployableManager.EnterWorldOverrideForTesting = _ => true;
+                DrainVehicleMessages(session);
+                Assert.IsTrue(box.TryUnpackSlot(0, out WorldObject okSpawn));
+                var station = okSpawn as RadarStation;
+                Assert.IsNotNull(station);
+                Assert.AreEqual(0, box.OccupiedFullBayCount);
+                Assert.AreEqual(1, AirDefenseManager.Stations.Count);
+
+                var msgs = DrainVehicleMessages(session).OfType<VehicleDeployableStateMsg>()
+                    .Where(m => m.DeployableGuid == station.Guid.Full).ToList();
+                Assert.AreEqual(1, msgs.Count);
+                Assert.AreEqual((uint)DeployableKind.RadarStation, msgs[0].DeployableKind);
+                Assert.AreEqual((byte)(DeployableOnlineFlags.Powered | DeployableOnlineFlags.Active), msgs[0].OnlineFlags);
+                Assert.IsTrue(msgs[0].Position.X >= 0f && msgs[0].Position.X < 192f);
+                Assert.IsTrue(msgs[0].Position.Y >= 0f && msgs[0].Position.Y < 192f);
+            }
+            finally
+            {
+                DeployableManager.EnterWorldOverrideForTesting = prevOverride;
+                UnregisterOnlinePlayer(owner.Guid.Full);
+            }
+        }
