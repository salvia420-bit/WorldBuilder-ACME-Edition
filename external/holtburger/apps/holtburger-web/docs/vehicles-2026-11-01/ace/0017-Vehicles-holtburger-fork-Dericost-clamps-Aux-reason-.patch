+        [TestMethod]
+        public void R1_Dericost_ProbeExitPosition_SanitizeLoginLocation_And_Bailout_PreserveContinent()
+        {
+            double gx = 10000.0;
+            double gy = Vehicle.DericostYOffset + 2000.0; // 70928.0
+            double gz = 40.0;
+            VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = gz, Nz = 1.0 };
+
+            var v = CreateTestSemi(0x75010002u, gx, gy, gz);
+            var exitPos = VehicleManager.ProbeExitPosition(v, 0);
+            var (_, exitY, _) = Vehicle.ToGlobal(exitPos);
+            Assert.AreEqual((byte)1, exitPos.LandblockId.Continent, "ProbeExitPosition must preserve Continent=1 on Dericost");
+            Assert.AreEqual(gy, exitY, 5.0, "ProbeExitPosition Y must stay near Dericost coordinate");
+
+            // Airborne login sanitization on Dericost (use VehicleTerrain grid injected with 0x8000 bit)
+            var gridsField = typeof(VehicleTerrain).GetField("grids", BindingFlags.Static | BindingFlags.NonPublic);
+            var grids = (ConcurrentDictionary<uint, LandblockGrid>)gridsField?.GetValue(null);
+            Assert.IsNotNull(grids);
+            var lbX = (int)Math.Floor(gx / 192.0);
+            var lbY = (int)Math.Floor((gy - Vehicle.DericostYOffset) / 192.0);
+            uint dericostGridKey = ((uint)lbX << 24) | ((uint)lbY << 16) | 0x8000u;
+            bool hadPrev = grids.TryGetValue(dericostGridKey, out var prevGrid);
+            try
+            {
+                var flat40 = new float[81];
+                Array.Fill(flat40, 40.0f);
+                grids[dericostGridKey] = new LandblockGrid { Heights = flat40 };
+
+                Assert.AreEqual(40.0f, VehicleTerrain.HeightAt((float)gx, (float)gy), 1e-3f, "VehicleTerrain.HeightAt must resolve Dericost grid");
+                Assert.IsTrue(float.IsNaN(VehicleTerrain.HeightAt((float)gx, 55000.0f)), "Ocean corridor [49152, 68928) must remain NaN");
+
+                var player = CreateTestPlayer(0x50010003u, gx, gy, 500.0);
+                VehicleManager.MarkAirborne(player, true);
+                VehicleManager.SanitizeLoginLocation(player);
+                var (_, loginY, loginZ) = Vehicle.ToGlobal(player.Location);
+                Assert.AreEqual((byte)1, player.Location.LandblockId.Continent, "SanitizeLoginLocation must preserve Dericost continent");
+                Assert.IsTrue(loginY >= Vehicle.DericostYOffset, $"Sanitized Y must remain on Dericost (got {loginY})");
+                Assert.AreEqual(40.05, loginZ, 0.1);
+
+                // VehicleBailout.Bail + StepFall
+                var plane = VehicleProfile.HellcatDemo();
+                var pv = new Vehicle(Vehicle.BuildWeenie(plane), new ObjectGuid(0x75010004u), plane);
+                pv.State = new FlightState { X = gx, Y = gy, Z = 500.0, Heading = 0.0, Speed = 30.0, Mode = VehicleMode.Flight };
+                pv.Location = pv.VehiclePosition();
+                VehicleManager.RegisterForTesting(pv);
+                _registeredVehicles.Add(pv.Guid.Full);
+                RegisterOnlinePlayer(player);
+                try
+                {
+                    VehicleManager.SetSeatedForTesting(player, pv, 0);
+                    VehicleBailout.Bail(pv, player);
+                    Assert.IsTrue(VehicleBailout.IsFalling(player));
+                    double bx = gx, by = gy, bz = 500.0, vx = 0.0, vy = 10.0, vz = 0.0;
+                    VehicleBailout.StepFall(ref bx, ref by, ref bz, ref vx, ref vy, ref vz, 0.0, false, 0.1);
+                    Assert.IsTrue(by >= Vehicle.DericostYOffset, $"StepFall must preserve Dericost Y (got {by})");
+                }
+                finally
+                {
+                    VehicleBailout.Cancel(player);
+                    UnregisterOnlinePlayer(player.Guid.Full);
+                }
+            }
+            finally
+            {
+                if (hadPrev) grids[dericostGridKey] = prevGrid;
+                else grids.TryRemove(dericostGridKey, out _);
+            }
+        }
