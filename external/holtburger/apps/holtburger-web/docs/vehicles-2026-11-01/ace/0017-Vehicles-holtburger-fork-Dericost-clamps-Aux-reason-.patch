+            // Cross-continent negative test: same local Position (10,10,40) on Dereth vs Dericost must NOT bind
+            DeployableManager.Clear();
+            var fluxDereth = new FluxPodDeployable(FluxPodDeployable.BuildWeenie(), new ObjectGuid(0x75010410u))
