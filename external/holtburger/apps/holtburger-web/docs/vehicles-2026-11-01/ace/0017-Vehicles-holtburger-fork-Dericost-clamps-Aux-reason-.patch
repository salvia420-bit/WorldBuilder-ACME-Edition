+                // Late observer receives stowed state on 1 Hz AirDefenseManager.Tick even though !station.IsActive
+                DrainVehicleMessages(lateSession);
+                AirDefenseManager.Tick(1.1);
+                var lateMsgs = DrainVehicleMessages(lateSession).OfType<VehicleDeployableStateMsg>().ToList();
+                Assert.IsTrue(lateMsgs.Any(m => m.DeployableGuid == station.Guid.Full && m.OnlineFlags == DeployableOnlineFlags.Stowed),
+                    "AirDefenseManager.Tick must broadcast stowed RadarStation state to late observers");
+
+                // Unstow
+                DrainVehicleMessages(actorSession);
+                Assert.IsTrue(VehicleManager.HandlePalletJackAction(actor, new VehiclePalletJackAction
+                {
+                    Action = (byte)PalletJackActionKind.ToggleDeployableStow,
+                    TargetGuid = station.Guid.Full,
+                }, out var unstowErr), unstowErr);
+                var activeMsgs = DrainVehicleMessages(actorSession).OfType<VehicleDeployableStateMsg>().ToList();
+                Assert.IsTrue(activeMsgs.Any(m => m.OnlineFlags == (DeployableOnlineFlags.Powered | DeployableOnlineFlags.Active)));
