+                DeployableManager.Tick(0.6);
+
+                var msg = DrainVehicleMessages(deployerSession).OfType<VehicleGroundContactsMsg>().LastOrDefault();
+                Assert.IsNotNull(msg);
+
+                var cAlly = msg.Contacts.FirstOrDefault(c => c.TargetGuid == ally.Guid.Full);
+                var cNeutral = msg.Contacts.FirstOrDefault(c => c.TargetGuid == neutral.Guid.Full);
+                var cHostile = msg.Contacts.FirstOrDefault(c => c.TargetGuid == hostile.Guid.Full);
+                var cOwnTruck = msg.Contacts.FirstOrDefault(c => c.TargetGuid == ownParkedTruck.Guid.Full);
