+
+                var turret = new MissileTurretDeployable(MissileTurretDeployable.BuildWeenie(), new ObjectGuid(0x75010402u))
+                {
+                    Location = Vehicle.ToPosition(x + 5.0, y, z, Quaternion.Identity),
+                };
+                flux.Grid.Register(turret);
+                DeployableManager.Register(turret);
+                flux.Grid.Tick(0.1f);
+                Assert.IsTrue((turret.OnlineFlags & DeployableOnlineFlags.Powered) != 0);
+
+                // Stowing FluxPod immediately unregisters turret AND clears Powered | InFluxRange
+                Assert.IsTrue(flux.SetStowed(true));
+                Assert.IsNull(turret.Grid);
+                Assert.AreEqual(0, DeployableManager.GetAllGrids().Count);
