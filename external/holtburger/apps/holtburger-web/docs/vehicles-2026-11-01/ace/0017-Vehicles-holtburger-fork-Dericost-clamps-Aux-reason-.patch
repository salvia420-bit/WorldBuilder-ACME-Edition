+        [TestMethod]
+        public void R2_PalletJackEventPopulatesExactAuxForSuccessAndFailures()
+        {
+            double cx = 3600.0, cy = 4600.0, cz = 40.0;
+            VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = cz, Nz = 1.0 };
+
+            var p1 = CreateTestPlayer(0x50010201u, cx, cy - 10.0, cz);
+            var s1 = CreateSessionWithCapture(p1);
+            var p2 = CreateTestPlayer(0x50010202u, cx, cy - 10.0, cz);
+            var s2 = CreateSessionWithCapture(p2);
+            RegisterOnlinePlayer(p1);
+            RegisterOnlinePlayer(p2);
+
+            try
+            {
+                var jack = new PalletJackDeployable(new Vector3((float)cx, (float)(cy - 10.0), (float)cz), 0f, p1);
+                DeployableManager.Register(jack);
+
+                VehicleEventMsg RunPj(Session sess, VehiclePalletJackAction act)
+                {
+                    DrainVehicleMessages(sess);
+                    VehicleManager.HandlePalletJackAction(sess, act);
+                    var ev = DrainVehicleMessages(sess).OfType<VehicleEventMsg>().LastOrDefault();
+                    Assert.IsNotNull(ev, $"Expected event for PalletJack action {act.Action}");
+                    Assert.AreEqual((uint)VehicleEventKind.PalletJackEvent, ev.Kind, "Failures and successes must emit PalletJackEvent (25)");
+                    return ev;
+                }
+
+                // Grab -> Aux 1
+                Assert.AreEqual((uint)PalletJackEventReason.Grabbed, RunPj(s1, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    Action = (byte)PalletJackActionKind.Grab,
+                }).Aux);
+
+                // Another player tries Grab -> Aux 7 (OperatedByOther)
+                Assert.AreEqual((uint)PalletJackEventReason.OperatedByOther, RunPj(s2, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    Action = (byte)PalletJackActionKind.Grab,
+                }).Aux);
+
+                // RaiseForks -> Aux 0 (Completed)
+                Assert.AreEqual((uint)PalletJackEventReason.Completed, RunPj(s1, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    Action = (byte)PalletJackActionKind.RaiseForks,
+                }).Aux);
+
+                // PickGroundDeployable with raised forks -> Aux 6 (OutOfRangeOrForks)
+                var turret = new MissileTurretDeployable(MissileTurretDeployable.BuildWeenie(), new ObjectGuid(0x75010203u), null, p1)
+                {
+                    Location = Vehicle.ToPosition(cx, cy - 10.0, cz, Quaternion.Identity),
+                };
+                DeployableManager.Register(turret);
+                Assert.AreEqual((uint)PalletJackEventReason.OutOfRangeOrForks, RunPj(s1, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    TargetGuid = turret.Guid.Full,
+                    Action = (byte)PalletJackActionKind.PickGroundDeployable,
+                }).Aux);
+
+                // Lower forks then try pickup unstowed deployable -> Aux 3 (StowDeployableFirst)
+                Assert.AreEqual((uint)PalletJackEventReason.Completed, RunPj(s1, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    Action = (byte)PalletJackActionKind.LowerForks,
+                }).Aux);
+                Assert.AreEqual((uint)PalletJackEventReason.StowDeployableFirst, RunPj(s1, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    TargetGuid = turret.Guid.Full,
+                    Action = (byte)PalletJackActionKind.PickGroundDeployable,
+                }).Aux);
+
+                // Container doors closed -> Aux 5 (ContainerDoorsClosed)
+                var box = RegisterContainer(0x75010204u, IsoContainerDeployable.Wcid20ft, cx, cy, cz);
+                box.TryLoadWcid(0, PowerGeneratorDeployable.PowerGeneratorWeenieClassId, ignoreDoorState: true);
+                box.TryLoadWcid(3, PowerGeneratorDeployable.PowerGeneratorWeenieClassId, ignoreDoorState: true);
+                jack.SetWorldPose(cx + box.Slots[3].X, cy + box.Slots[3].Y, cz + box.FloorZ, 0.0);
+                p1.Location = Vehicle.ToPosition(cx + box.Slots[3].X, cy + box.Slots[3].Y - 0.62, cz + box.FloorZ, Quaternion.Identity);
+
+                Assert.AreEqual((uint)PalletJackEventReason.ContainerDoorsClosed, RunPj(s1, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    TargetGuid = box.Guid.Full,
+                    SlotIndex = 3,
+                    Action = (byte)PalletJackActionKind.PickContainerSlot,
+                }).Aux);
+
+                // Open doors, pick deep slot 0 blocked by slot 3 -> Aux 4 (LifoBlocked)
+                box.SetDoorProgress(1.0f);
+                jack.SetWorldPose(cx + box.Slots[0].X, cy + box.Slots[0].Y, cz + box.FloorZ, 0.0);
+                Assert.AreEqual((uint)PalletJackEventReason.LifoBlocked, RunPj(s1, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    TargetGuid = box.Guid.Full,
+                    SlotIndex = 0,
+                    Action = (byte)PalletJackActionKind.PickContainerSlot,
+                }).Aux);
+
+                // Release -> Aux 2
+                Assert.AreEqual((uint)PalletJackEventReason.Released, RunPj(s1, new VehiclePalletJackAction
+                {
+                    PalletJackGuid = jack.Guid.Full,
+                    Action = (byte)PalletJackActionKind.Release,
+                }).Aux);
+            }
+            finally
+            {
+                UnregisterOnlinePlayer(p1.Guid.Full);
+                UnregisterOnlinePlayer(p2.Guid.Full);
+            }
+        }
