+
+                // Unstowing FluxPod without calling DeployableManager.Tick sets Grid.Center = GlobalPosition
+                Assert.IsTrue(flux.SetStowed(false));
+                Assert.AreEqual(1, DeployableManager.GetAllGrids().Count);
+                Assert.AreEqual(flux.GlobalPosition.X, flux.Grid.Center.X, 1e-3f, $"{label}: Grid.Center.X");
+                Assert.AreEqual(flux.GlobalPosition.Y, flux.Grid.Center.Y, 1e-3f, $"{label}: Grid.Center.Y");
+
+                // Stowing then unstowing turret binds directly to flux.Grid without DeployableManager.Tick
