+        [TestMethod]
+        public void R8_VehicleManager_TryHitchTrailer_RejectsNonIdleSidelifter()
+        {
+            const int lbX = 19, lbY = 22;
+            uint gridKey = ((uint)lbX << 24) | ((uint)lbY << 16);
+            var gridsField = typeof(VehicleTerrain).GetField("grids", BindingFlags.Static | BindingFlags.NonPublic);
+            var grids = (ConcurrentDictionary<uint, LandblockGrid>)gridsField?.GetValue(null);
+            bool hadPrev = grids.TryGetValue(gridKey, out var prevGrid);
+
+            double x = lbX * 192.0 + 60.0, y = lbY * 192.0 + 60.0, z = 40.0;
+            var flat40 = new float[81];
+            Array.Fill(flat40, 40.0f);
+            grids[gridKey] = new LandblockGrid { Heights = flat40 };
+
+            var player = CreateTestPlayer(0x50010911u, x, y, z);
+            try
+            {
+                var tractor = CreateTestSemi(0x75010911u, x, y, z);
+                var fw = TrailerKinematics.ComputeFifthWheelPose(tractor.GroundState, tractor.Profile.FifthWheelOffsetY, tractor.Profile.FifthWheelOffsetZ);
+                var sl = RegisterSidelifter(0x75010912u, fw.x, fw.y - TrailerKinematics.Chassis40.KpY, z);
+
+                Assert.IsTrue(sl.TryDeployOutriggers(1, out _, player));
+                Assert.AreNotEqual(SideliftPhase.Idle, sl.SideliftPhase);
+                Assert.IsFalse(VehicleManager.TryHitchTrailer(tractor, sl, player, out var err));
+                StringAssert.Contains(err, "sidelifter", StringComparison.OrdinalIgnoreCase);
+
+                sl.TickSidelifter(2.5);
+                Assert.IsTrue(sl.TryRetractOutriggers(out _));
+                sl.TickSidelifter(2.5);
+                Assert.AreEqual(SideliftPhase.Idle, sl.SideliftPhase);
+
+                Assert.IsTrue(VehicleManager.TryHitchTrailer(tractor, sl, player, out var okErr), okErr);
+            }
+            finally
+            {
+                if (hadPrev) grids[gridKey] = prevGrid;
+                else grids.TryRemove(gridKey, out _);
+            }
+        }
