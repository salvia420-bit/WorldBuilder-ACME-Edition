+            {
+                Location = Vehicle.ToPosition(10.0, Vehicle.DericostYOffset + 10.0, 40.0, Quaternion.Identity),
+            };
+            Assert.IsTrue(turretDericost.SetStowed(true));
+            Assert.IsTrue(turretDericost.SetStowed(false));
+            Assert.IsNull(turretDericost.Grid, "Dericost turret must not bind to Dereth FluxPod sharing local (10,10)");
+        }
