+        [TestMethod]
+        public void TryUnpackSlot_SpawnFailure_RollsBackNonRadarFullAndHalfPalletsWithCargoState()
+        {
+            var prevOverride = DeployableManager.EnterWorldOverrideForTesting;
+            var container = new IsoDeployable(IsoDeployable.BuildWeenie(IsoDeployable.Wcid20ft), new ObjectGuid(0x75004099u), null, null);
+            container.Location = Vehicle.ToPosition(13824.0, 20352.0, 10.0, Quaternion.Identity);
+            container.SetDoorProgress(1.0f);
+            DeployableManager.Register(container);
+
+            try
+            {
+                var fullState = new PalletCargoState { HasState = true, FuelRemaining = 123.5f };
+                Assert.IsTrue(container.TryLoadWcid(0, 4000012u, PalletSize.Full, 0, ignoreDoorState: true, fullState));
+
+                var halfState0 = new PalletCargoState { HasState = true, AmmoRemaining = 7 };
+                var halfState1 = new PalletCargoState { HasState = true, EnergyStoredJoules = 456789f };
+                Assert.IsTrue(container.TryLoadWcid(1, 4000016u, PalletSize.Half, 0, ignoreDoorState: true, halfState0));
+                Assert.IsTrue(container.TryLoadWcid(1, 4000013u, PalletSize.Half, 1, ignoreDoorState: true, halfState1));
+
+                Assert.IsTrue(container.TryLoadWcid(2, 4000002u, PalletSize.Full, 0, ignoreDoorState: true, null));
+
+                DeployableManager.EnterWorldOverrideForTesting = _ => false;
+
+                Assert.IsFalse(container.TryUnpackSlot(0, out ACE.Server.WorldObjects.WorldObject sp0));
+                Assert.IsNull(sp0);
+                Assert.IsTrue(container.Slots[0].Occupied);
+                Assert.AreEqual(PalletSize.Full, container.Slots[0].OccupiedPalletSize);
+                Assert.AreEqual(4000012u, container.Slots[0].OccupiedWcids[0]);
+                Assert.IsTrue(container.Slots[0].CargoStates[0].HasState);
+                Assert.AreEqual(123.5f, container.Slots[0].CargoStates[0].FuelRemaining, 1e-4f);
+
+                Assert.IsFalse(container.TryUnpackSlot(1, out ACE.Server.WorldObjects.WorldObject sp1, 1));
+                Assert.IsNull(sp1);
+                Assert.IsTrue(container.Slots[1].Occupied);
+                Assert.AreEqual((byte)0x03, container.Slots[1].OccupiedSubSlots);
+                Assert.AreEqual(PalletSize.Half, container.Slots[1].OccupiedPalletSize);
+                Assert.AreEqual(4000016u, container.Slots[1].OccupiedWcids[0]);
+                Assert.AreEqual(4000013u, container.Slots[1].OccupiedWcids[1]);
+                Assert.IsTrue(container.Slots[1].CargoStates[1].HasState);
+                Assert.AreEqual(456789f, container.Slots[1].CargoStates[1].EnergyStoredJoules, 1e-2f);
+
+                // Also verify half-pallet auto-select (subSlot = -1) rolls back into subSlot 0 with its state
+                Assert.IsFalse(container.TryUnpackSlot(1, out ACE.Server.WorldObjects.WorldObject sp1Auto, -1));
+                Assert.IsNull(sp1Auto);
+                Assert.AreEqual((byte)0x03, container.Slots[1].OccupiedSubSlots);
+                Assert.AreEqual(4000016u, container.Slots[1].OccupiedWcids[0]);
+                Assert.AreEqual((ushort)7, container.Slots[1].CargoStates[0].AmmoRemaining);
+
+                Assert.IsFalse(container.TryUnpackSlot(2, out ACE.Server.WorldObjects.WorldObject sp2));
+                Assert.IsNull(sp2);
+                Assert.AreEqual(4000002u, container.Slots[2].OccupiedWcids[0]);
+            }
+            finally
+            {
+                DeployableManager.EnterWorldOverrideForTesting = prevOverride;
+                DeployableManager.Unregister(container.Guid.Full);
+            }
+        }
+
         #endregion
     }
 }
diff --git a/Source/ACE.Server.Tests/Vehicles/PalletJackLogisticsTests.cs b/Source/ACE.Server.Tests/Vehicles/PalletJackLogisticsTests.cs
