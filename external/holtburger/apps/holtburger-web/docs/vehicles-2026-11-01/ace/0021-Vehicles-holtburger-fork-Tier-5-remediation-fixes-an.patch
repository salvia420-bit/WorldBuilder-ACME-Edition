+
+        [TestMethod]
+        public void Sidelifter_OnTransferContainerDestroyedDuringAutoCycle_RetractsToIdle()
+        {
+            const int lbX = 16, lbY = 26;
+            uint gridKey = ((uint)lbX << 24) | ((uint)lbY << 16);
+            var gridsField = typeof(VehicleTerrain).GetField("grids", BindingFlags.Static | BindingFlags.NonPublic);
+            var grids = (ConcurrentDictionary<uint, LandblockGrid>)gridsField?.GetValue(null);
+            bool hadPrev = grids.TryGetValue(gridKey, out var prevGrid);
+
+            double x = lbX * 192.0 + 60.0, y = lbY * 192.0 + 60.0, z = 40.0;
+            var flat40 = new float[81];
+            Array.Fill(flat40, 40.0f);
+            grids[gridKey] = new LandblockGrid { Heights = flat40 };
+
+            var player = CreateTestPlayer(0x50006901u, x, y, z);
+            RegisterOnlinePlayer(player);
+            try
+            {
+                var tractor = CreateTestSemi(0x75006901u, x, y, z);
+                var fw = TrailerKinematics.ComputeFifthWheelPose(tractor.GroundState, tractor.Profile.FifthWheelOffsetY, tractor.Profile.FifthWheelOffsetZ);
+                var sl = RegisterSidelifter(0x75006902u, fw.x, fw.y - TrailerKinematics.Chassis40.KpY, z);
+                Assert.IsTrue(VehicleManager.TryHitchTrailer(tractor, sl, player, out _));
+
+                var (sx, sy, sz) = sl.GetGlobalPose();
+                var c40 = RegisterContainer(0x75006903u, IsoContainerDeployable.Wcid40ft, sx + 3.85, sy, sz);
+                Assert.IsTrue(sl.TryStartSideliftLoad(c40.Guid.Full, 1, autoCycle: true, out var startErr, player), startErr);
+                Assert.AreEqual(SideliftPhase.OutriggersDeploying, sl.SideliftPhase);
+                Assert.IsTrue(sl.AutoCycleActive);
+
+                // Advance through OutriggersDeploying + CranesPositioning + CranesLatched + Hoisting into Swinging
+                StepSidelifterSeconds(sl, 7.5);
+                Assert.AreEqual(SideliftPhase.Swinging, sl.SideliftPhase);
+                Assert.IsTrue(sl.AutoCycleActive);
+
+                // Destroy container mid-lift -> must stow cranes AND retract outriggers cleanly to Idle
+                c40.Destroy(true, false);
+                Assert.AreEqual(SideliftPhase.CranesStowing, sl.SideliftPhase);
+
+                StepSidelifterSeconds(sl, 15.0);
+                Assert.AreEqual(SideliftPhase.Idle, sl.SideliftPhase, "AutoCycle sidelifter must retract outriggers to Idle after container destruction");
+                Assert.IsFalse(sl.AutoCycleActive);
+                Assert.AreEqual(0.0f, sl.OutriggerProgress, 1e-4f);
+            }
+            finally
+            {
+                UnregisterOnlinePlayer(player.Guid.Full);
+                if (hadPrev) grids[gridKey] = prevGrid;
+                else grids.TryRemove(gridKey, out _);
+            }
+        }
     }
 }
