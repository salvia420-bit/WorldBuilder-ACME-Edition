diff --git a/Source/ACE.Entity/LandblockId.cs b/Source/ACE.Entity/LandblockId.cs
index cf25718c..b40c8b5d 100644
--- a/Source/ACE.Entity/LandblockId.cs
+++ b/Source/ACE.Entity/LandblockId.cs
@@ -17,21 +17,26 @@ public LandblockId(byte x, byte y)
             Raw = (uint)x << 24 | (uint)y << 16;
         }
 
-        public LandblockId East => new LandblockId(Convert.ToByte(LandblockX + 1), LandblockY);
+        public LandblockId(byte x, byte y, byte continent)
+        {
+            Raw = (uint)x << 24 | (uint)y << 16 | ((uint)(continent & 1) << 15);
+        }
+
+        public LandblockId East => new LandblockId(Convert.ToByte(LandblockX + 1), LandblockY, Continent);
 
-        public LandblockId West => new LandblockId(Convert.ToByte(LandblockX - 1), LandblockY);
+        public LandblockId West => new LandblockId(Convert.ToByte(LandblockX - 1), LandblockY, Continent);
 
-        public LandblockId North => new LandblockId(LandblockX, Convert.ToByte(LandblockY + 1));
+        public LandblockId North => new LandblockId(LandblockX, Convert.ToByte(LandblockY + 1), Continent);
 
-        public LandblockId South => new LandblockId(LandblockX, Convert.ToByte(LandblockY - 1));
+        public LandblockId South => new LandblockId(LandblockX, Convert.ToByte(LandblockY - 1), Continent);
 
-        public LandblockId NorthEast => new LandblockId(Convert.ToByte(LandblockX + 1), Convert.ToByte(LandblockY + 1));
+        public LandblockId NorthEast => new LandblockId(Convert.ToByte(LandblockX + 1), Convert.ToByte(LandblockY + 1), Continent);
 
-        public LandblockId NorthWest => new LandblockId(Convert.ToByte(LandblockX - 1), Convert.ToByte(LandblockY + 1));
+        public LandblockId NorthWest => new LandblockId(Convert.ToByte(LandblockX - 1), Convert.ToByte(LandblockY + 1), Continent);
 
-        public LandblockId SouthEast => new LandblockId(Convert.ToByte(LandblockX + 1), Convert.ToByte(LandblockY - 1));
+        public LandblockId SouthEast => new LandblockId(Convert.ToByte(LandblockX + 1), Convert.ToByte(LandblockY - 1), Continent);
 
-        public LandblockId SouthWest => new LandblockId(Convert.ToByte(LandblockX - 1), Convert.ToByte(LandblockY - 1));
+        public LandblockId SouthWest => new LandblockId(Convert.ToByte(LandblockX - 1), Convert.ToByte(LandblockY - 1), Continent);
 
         public ushort Landblock => (ushort)((Raw >> 16) & 0xFFFF);
 
diff --git a/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs b/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
index 37cde49f..f9aa50e3 100644
--- a/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
+++ b/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
@@ -2258,6 +2258,117 @@ public void T5_ADV_09_GroundModel_HeadlightsAndHornFlags_TransitionCleanly()
             Assert.IsTrue((state.GroundFlags & 0x20) == 0, "Horn flag bit 0x20 must clear when released");
         }
 
+        [TestMethod]
+        public void GroundRadar_IgnoresIndoorDeadPlayersAndAirborneDestroyedVehicles()
+        {
+            double x = 3350.0, y = 4350.0, z = 40.0;
+            var prevOverride = DeployableManager.EnterWorldOverrideForTesting;
+            DeployableManager.Clear();
+            DeployableManager.EnterWorldOverrideForTesting = _ => true;
+
+            var deployer = CreateTestPlayer(0x5000E101u, x, y, z, monarchId: 100u);
+            var indoorPlayer = CreateTestPlayer(0x5000E102u, x + 20.0, y, z, monarchId: 300u);
+            indoorPlayer.Location = new Position(0x1010_0100u, new Vector3(10f, 10f, 0f), Quaternion.Identity);
+
+            var deadPlayer = CreateTestPlayer(0x5000E103u, x + 30.0, y, z, monarchId: 300u);
+            deadPlayer.Biota.PropertiesAttribute2nd ??= new Dictionary<PropertyAttribute2nd, PropertiesAttribute2nd>();
+            deadPlayer.Biota.PropertiesAttribute2nd[PropertyAttribute2nd.MaxHealth] =
+                new PropertiesAttribute2nd { InitLevel = 100, CurrentLevel = 100 };
+            var deadVitals = new Dictionary<PropertyAttribute2nd, ACE.Server.WorldObjects.Entity.CreatureVital>
+            {
+                [PropertyAttribute2nd.MaxHealth] = new ACE.Server.WorldObjects.Entity.CreatureVital(deadPlayer, PropertyAttribute2nd.MaxHealth) { Current = 0 }
+            };
+            typeof(Creature).GetField("Vitals", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.SetValue(deadPlayer, deadVitals);
+
+            var loggingOutPlayer = CreateTestPlayer(0x5000E104u, x + 35.0, y, z, monarchId: 300u);
+            loggingOutPlayer.IsLoggingOut = true;
+
+            var lockField = typeof(ACE.Server.Managers.PlayerManager).GetField("playersLock", BindingFlags.Static | BindingFlags.NonPublic);
+            var dictField = typeof(ACE.Server.Managers.PlayerManager).GetField("onlinePlayers", BindingFlags.Static | BindingFlags.NonPublic);
+            var rwLock = (System.Threading.ReaderWriterLockSlim)lockField?.GetValue(null);
+            var onlineDict = (Dictionary<uint, Player>)dictField?.GetValue(null);
+            void RegPlayer(Player p) { rwLock.EnterWriteLock(); try { onlineDict[p.Guid.Full] = p; } finally { rwLock.ExitWriteLock(); } }
+            void UnregPlayer(uint g) { rwLock.EnterWriteLock(); try { onlineDict.Remove(g); } finally { rwLock.ExitWriteLock(); } }
+
+            RegPlayer(deployer);
+            RegPlayer(indoorPlayer);
+            RegPlayer(deadPlayer);
+            RegPlayer(loggingOutPlayer);
+
+            var hellcat = CreateTestAircraft(0x7500E110u, x + 40.0, y, z + 5.0);
+            var wreckedJeep = CreateTestJeep(0x7500E111u, x + 50.0, y, z);
+            typeof(WorldObject).GetProperty("IsDestroyed", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+                ?.SetValue(wreckedJeep, true);
+            VehicleManager.RegisterForTesting(hellcat);
+            VehicleManager.RegisterForTesting(wreckedJeep);
+
+            try
+            {
+                var flux = new FluxPodDeployable(FluxPodDeployable.BuildWeenie(), new ObjectGuid(0x7500E101u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity),
+                };
+                flux.Grid.Center = flux.GlobalPosition;
+                DeployableManager.RegisterGrid(flux.Grid);
+                DeployableManager.Register(flux);
+
+                var gen = new PowerGeneratorDeployable(PowerGeneratorDeployable.BuildWeenie(), new ObjectGuid(0x7500E102u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 1.0, y, z, Quaternion.Identity),
+                    FuelSecondsRemaining = 120.0,
+                };
+                flux.Grid.Register(gen);
+                DeployableManager.Register(gen);
+
+                var radar = new GroundRadarDeployable(GroundRadarDeployable.BuildWeenie(), new ObjectGuid(0x7500E103u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 2.0, y, z, Quaternion.Identity),
+                };
+                flux.Grid.Register(radar);
+                DeployableManager.Register(radar);
+
+                DeployableManager.Tick(0.6);
+                Assert.IsTrue(radar.IsPowered);
+                Assert.IsFalse(radar.FindNearestGroundContact(out _, out _, out _), "GroundRadar must not cue on indoor/dead/logging-out players or airborne/destroyed vehicles");
+                Assert.AreEqual(0, radar.ContactCount, "GroundRadar _latestContacts must be empty");
+            }
+            finally
+            {
+                VehicleManager.UnregisterForTesting(hellcat.Guid.Full);
+                VehicleManager.UnregisterForTesting(wreckedJeep.Guid.Full);
+                UnregPlayer(deployer.Guid.Full);
+                UnregPlayer(indoorPlayer.Guid.Full);
+                UnregPlayer(deadPlayer.Guid.Full);
+                UnregPlayer(loggingOutPlayer.Guid.Full);
+                DeployableManager.Clear();
+                DeployableManager.EnterWorldOverrideForTesting = prevOverride;
+            }
+        }
+
+        [TestMethod]
+        public void MicroGrid_PreservesBatteryChargeWhenInsufficientForConsumers()
+        {
+            double x = 3400.0, y = 4400.0, z = 40.0;
+            var grid = new MicroGrid(new Vector3((float)x, (float)y, (float)z));
+
+            var bat = new BatteryDeployable(BatteryDeployable.BuildWeenie(), new ObjectGuid(0x7500E201u))
+            {
+                Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity),
+                CapacitorJoules = 400.0f,
+            };
+            // MissileTurret is 1500W -> 1500J/s deficit
+            var sam = new MissileTurretDeployable(MissileTurretDeployable.BuildWeenie(), new ObjectGuid(0x7500E202u))
+            {
+                Location = Vehicle.ToPosition(x + 2.0, y, z, Quaternion.Identity),
+            };
+            grid.Register(bat);
+            grid.Register(sam);
+
+            grid.Tick(1.0f);
+            Assert.IsFalse(sam.IsPowered, "Consumers must remain unpowered when battery energy < 1s deficit");
+            Assert.AreEqual(400.0f, bat.CapacitorJoules, 1e-4f, "MicroGrid must NOT drain battery when insufficient to power consumers");
+        }
+
         #endregion
     }
 }
diff --git a/Source/ACE.Server.Tests/Vehicles/DericostContinentInvariantsTests.cs b/Source/ACE.Server.Tests/Vehicles/DericostContinentInvariantsTests.cs
index cd55fd6b..9d9318ec 100644
--- a/Source/ACE.Server.Tests/Vehicles/DericostContinentInvariantsTests.cs
+++ b/Source/ACE.Server.Tests/Vehicles/DericostContinentInvariantsTests.cs
@@ -192,5 +192,110 @@ public void LScape_GetLandblock_NonServerFallback_UsesFFFFNot7FFF()
                 ACE.Server.Physics.PhysicsEngine.Instance = prevEng;
             }
         }
+
+        [TestMethod]
+        public void LandCell_AddAllOutsideCellsAndAddCellBlock_IndoorEnvCell8100AndFFFF_UseDerethCells()
+        {
+            var prevEng = ACE.Server.Physics.PhysicsEngine.Instance;
+            uint[] keys = { 0x1020_7FFFu, 0x0F20_7FFFu, 0x0F1F_7FFFu, 0x101F_7FFFu, 0x1020_FFFFu, 0x0F20_FFFFu, 0x0F1F_FFFFu, 0x101F_FFFFu };
+            var saved = new System.Collections.Generic.Dictionary<uint, (bool had, ACE.Server.Physics.Common.Landblock lb)>();
+            foreach (var k in keys)
+            {
+                bool had = LScape.Landblocks.TryGetValue(k, out var prevLb);
+                saved[k] = (had, prevLb);
+            }
+
+            try
+            {
+                ACE.Server.Physics.PhysicsEngine.Instance = null;
+                foreach (var k in keys)
+                {
+                    var lb = new ACE.Server.Physics.Common.Landblock { SideCellCount = 8 };
+                    for (int idx = 0; idx < 64; idx++)
+                        lb.LandCells[idx] = new LandCell((k & 0xFFFF_0000u) | (uint)(idx + 1));
+                    LScape.Landblocks[k] = lb;
+                }
+
+                // 1) add_cell_block with indoor EnvCell 0x1020_8100 and BlockCellID 0x1020_FFFF
+                var blockArr = new ACE.Server.Physics.Common.CellArray();
+                LandCell.add_cell_block(16 * 8, 32 * 8, 16 * 8 + 1, 32 * 8 + 1, blockArr, 0x1020_8100u);
+                Assert.IsTrue(blockArr.Cells.Count > 0);
+                foreach (var cellId in blockArr.Cells.Keys)
+                {
+                    Assert.IsFalse(LandDefs.IsDericostCell(cellId), $"add_cell_block(0x1020_8100) produced Dericost cell {cellId:X8}");
+                    Assert.AreEqual(0u, cellId & 0x8000u, $"Expected Dereth cell without bit 15, got {cellId:X8}");
+                }
+
+                var sentinelArr = new ACE.Server.Physics.Common.CellArray();
+                LandCell.add_cell_block(16 * 8, 32 * 8, 16 * 8 + 1, 32 * 8 + 1, sentinelArr, 0x1020_FFFFu);
+                Assert.IsTrue(sentinelArr.Cells.Count > 0);
+                foreach (var cellId in sentinelArr.Cells.Keys)
+                {
+                    Assert.IsFalse(LandDefs.IsDericostCell(cellId), $"add_cell_block(0x1020_FFFF) produced Dericost cell {cellId:X8}");
+                    Assert.AreEqual(0u, cellId & 0x8000u, $"Expected Dereth cell without bit 15, got {cellId:X8}");
+                }
+
+                // 2) add_all_outside_cells with spheres near (0,0) corner on 0x1020_8100 and 0x1020_FFFF
+                foreach (uint srcCell in new[] { 0x1020_8100u, 0x1020_FFFFu })
+                {
+                    var outsideArr = new ACE.Server.Physics.Common.CellArray();
+                    var pos = new ACE.Server.Physics.Common.Position
+                    {
+                        ObjCellID = srcCell,
+                        Frame = new ACE.Server.Physics.Animation.AFrame(new Vector3(1.0f, 1.0f, 10.0f), Quaternion.Identity),
+                    };
+                    var spheres = new System.Collections.Generic.List<ACE.Server.Physics.Sphere>
+                    {
+                        new ACE.Server.Physics.Sphere(new Vector3(1.0f, 1.0f, 10.0f), 2.0f)
+                    };
+                    LandCell.add_all_outside_cells(pos, spheres.Count, spheres, outsideArr);
+                    Assert.IsTrue(outsideArr.Cells.Count > 0, $"add_all_outside_cells({srcCell:X8}) must add outside cells");
+                    foreach (var cellId in outsideArr.Cells.Keys)
+                    {
+                        Assert.IsFalse(LandDefs.IsDericostCell(cellId), $"add_all_outside_cells({srcCell:X8}) produced Dericost cell {cellId:X8}");
+                        Assert.AreEqual(0u, cellId & 0x8000u, $"Expected Dereth cell without bit 15, got {cellId:X8}");
+                    }
+                }
+            }
+            finally
+            {
+                foreach (var kv in saved)
+                {
+                    if (kv.Value.had) LScape.Landblocks[kv.Key] = kv.Value.lb;
+                    else LScape.Landblocks.TryRemove(kv.Key, out _);
+                }
+                ACE.Server.Physics.PhysicsEngine.Instance = prevEng;
+            }
+        }
+
+        [TestMethod]
+        public void LandblockId_DirectionalProperties_PreserveDericostContinentBit()
+        {
+            var dericost = new LandblockId(0x1020_8000u);
+            Assert.AreEqual((byte)1, dericost.Continent);
+
+            var neighbors = new[]
+            {
+                (dericost.East, (byte)0x11, (byte)0x20),
+                (dericost.West, (byte)0x0F, (byte)0x20),
+                (dericost.North, (byte)0x10, (byte)0x21),
+                (dericost.South, (byte)0x10, (byte)0x1F),
+                (dericost.NorthEast, (byte)0x11, (byte)0x21),
+                (dericost.NorthWest, (byte)0x0F, (byte)0x21),
+                (dericost.SouthEast, (byte)0x11, (byte)0x1F),
+                (dericost.SouthWest, (byte)0x0F, (byte)0x1F),
+            };
+            foreach (var (n, ex, ey) in neighbors)
+            {
+                Assert.AreEqual(ex, n.LandblockX);
+                Assert.AreEqual(ey, n.LandblockY);
+                Assert.AreEqual((byte)1, n.Continent, $"Neighbor {n} must preserve Dericost Continent == 1");
+                Assert.AreNotEqual(0u, n.Raw & 0x8000u, $"Neighbor {n} must preserve bit 15");
+            }
+
+            var dereth = new LandblockId(0x1020_0000u);
+            Assert.AreEqual((byte)0, dereth.East.Continent);
+            Assert.AreEqual(0u, dereth.East.Raw & 0x8000u);
+        }
     }
 }
diff --git a/Source/ACE.Server.Tests/Vehicles/IsoContainerTests.cs b/Source/ACE.Server.Tests/Vehicles/IsoContainerTests.cs
