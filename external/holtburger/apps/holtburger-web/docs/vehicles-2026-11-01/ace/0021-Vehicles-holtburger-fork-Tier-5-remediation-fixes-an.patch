@@ -888,5 +888,75 @@ public void GrabReleaseBurstLoopRespectsPersistentLeakyBucket()
                 UnregisterOnlinePlayer(player.Guid.Full);
             }
         }
+
+        [TestMethod]
+        public void CargoPackRejectsAfterRadarPickedByPalletJackOrPackedByContainer_NoDuplication()
+        {
+            double x = 3680.0, y = 4680.0, z = 40.0;
+            var player = CreateTestPlayer(0x50007C01u, x, y - 1.6, z);
+            RegisterOnlinePlayer(player);
+            try
+            {
+                var p = VehicleProfile.JeepMb();
+                p.CargoWcid = RadarStation.RadarWeenieClassId;
+                p.Parts.Add(new VehiclePartDef { Offset = new Vector3(0.0f, -1.05f, 0.90f) });
+                p.PartRoles.Add(VehiclePartRole.Cargo);
+                var jeep = new Vehicle(Vehicle.BuildWeenie(p), new ObjectGuid(0x75007C01u), p)
+                {
+                    Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity),
+                    CargoLoaded = true,
+                };
+                jeep.State.X = x;
+                jeep.State.Y = y;
+                jeep.State.Z = z;
+                VehicleManager.RegisterForTesting(jeep);
+                _registeredVehicles.Add(jeep.Guid.Full);
+                VehicleManager.ClearSeatedForTesting(player);
+
+                // 1) Deploy RadarStation from Jeep, then pick it up with a Pallet Jack
+                Assert.IsTrue(VehicleManager.HandleCargo(player, new VehicleCargo { Vehicle = jeep.Guid.Full, Action = VehicleCargo.ActionDeploy }));
+                Assert.IsFalse(jeep.CargoLoaded);
+                var radar1 = jeep.DeployedRadar;
+                Assert.IsNotNull(radar1);
+
+                var (rx, ry, rz) = Vehicle.ToGlobal(radar1.Location);
+                var jack = new PalletJackDeployable(new Vector3((float)rx, (float)ry, (float)rz), 0f, player);
+                DeployableManager.Register(jack);
+                radar1.IsActive = false;
+                Assert.IsTrue(jack.TryGrab(player, out var gErr), gErr);
+                Assert.IsTrue(jack.TryPickGroundDeployable(player, 0, out var pickErr), pickErr);
+                Assert.AreEqual(RadarStation.RadarWeenieClassId, jack.CarriedWcid);
+                Assert.IsTrue(radar1.IsDestroyed);
+                Assert.IsNull(jeep.DeployedRadar, "Picking up RadarStation via pallet jack must clear parent vehicle DeployedRadar");
+
+                Assert.IsFalse(VehicleManager.HandleCargo(player, new VehicleCargo { Vehicle = jeep.Guid.Full, Action = VehicleCargo.ActionPack }),
+                    "ActionPack must reject after RadarStation was picked up by pallet jack (no duplication)");
+                Assert.IsFalse(jeep.CargoLoaded);
+
+                // 2) Reload Jeep cargo, deploy a second RadarStation, pack it into an ISO Container
+                jeep.CargoLoaded = true;
+                Assert.IsTrue(VehicleManager.HandleCargo(player, new VehicleCargo { Vehicle = jeep.Guid.Full, Action = VehicleCargo.ActionDeploy }));
+                var radar2 = jeep.DeployedRadar;
+                Assert.IsNotNull(radar2);
+
