+        private static ClientMessage WrapVehicleC2S(VehicleC2S msg)
+        {
+            using var ms = new MemoryStream();
+            using var bw = new BinaryWriter(ms);
+            bw.Write(msg.Opcode); // 4-byte opcode consumed by ClientMessage ctor
+            msg.Write(bw);
+            bw.Flush();
+            return new ClientMessage(ms.ToArray());
