+        [TestMethod]
+        public void Tier5_LOW01_ConvoyAndOrderId_SafeJs53BitBounds()
+        {
+            uint monarchId = AllocTestGuid();
+            var monarch = CreateInventoryPlayer(monarchId, 0xA9B40001u, 50f, 50f, 10f, monarchId: monarchId);
+            TownEconomyManager.SetTownOwner(1u, monarchId, "CONTROLLED");
+            TownEconomyManager.SetTownOwner(6u, monarchId, "CONTROLLED");
+            TownEconomyManager.SeedWarehouseStock(1u, "ulsd_diesel", 10);
+
+            var ord = TownEconomyManager.SetProcurementBountyOrder(1u, 51234u, "raw_hide", 100L, 1, monarchId);
+            Assert.IsNotNull(ord);
+            Assert.IsTrue(ord.OrderId <= TownEconomyManager.MaxSafeJsUInt53,
+                $"[LOW-01] Generated OrderId {ord.OrderId} must stay <= 2^53 - 1");
+
+            ulong over53 = TownEconomyManager.MaxSafeJsUInt53 + 1UL;
+            var badOrdReply = TownEconomyManager.HandleMonarchOrderAction(monarch, new EconomyMonarchOrder
+            {
+                TownId = 1u, Action = 1, OrderId = over53, ItemWcid = 51235u, Quantity = 1, RewardPyreals = 100,
+            }, out var ordErr);
+            Assert.IsNull(badOrdReply, "[LOW-01] OrderId > 2^53 - 1 must be rejected");
+            Assert.IsFalse(string.IsNullOrWhiteSpace(ordErr));
+
+            var convoy = LogisticsEngine.DispatchConvoy(monarchId, 1u, 6u, (byte)VehicleClass.HeavyTractor, out var cErr, initialFuelLiters: 200.0);
+            Assert.IsNotNull(convoy, cErr);
+            Assert.IsTrue(convoy.ConvoyId <= LogisticsEngine.MaxSafeJsUInt53,
+                $"[LOW-01] Generated ConvoyId {convoy.ConvoyId} must stay <= 2^53 - 1");
+
+            var badConvoy = LogisticsEngine.DispatchConvoy(monarchId, 1u, 6u, (byte)VehicleClass.HeavyTractor, out var badCErr, initialFuelLiters: 200.0, explicitConvoyId: over53);
+            Assert.IsNull(badConvoy, "[LOW-01] Explicit ConvoyId > 2^53 - 1 must be rejected");
+            Assert.IsFalse(string.IsNullOrWhiteSpace(badCErr));
+        }
+    }
