+            beacon.TargetTownId = 1u;
+
+            // 1. Adversarial wire packet: SupplyPoints=99999, OriginLandblock=0x7D64 (Yaraq > 1500m), ZERO physical cargo
+            var spoofMsg = WrapVehicleC2S(new EconomySiegeAction
+            {
+                TownId = 1u,
+                BeaconGuid = beacon.Guid.Full,
+                Action = 2, // DepositSupply
+                SupplyPoints = 99_999,
+                OriginLandblock = 0x7D640001u,
+            });
+            GameActionVehicle.HandleEconomySiegeAction(spoofMsg, session);
+            Assert.AreEqual(0.0, SiegeManager.GetSiegeState(1u).SupplyMeterSec, 0.001,
+                "[CRIT-01] DepositSupply without physical cargo MUST fail closed with 0 supply added");
+
+            // 2. Local physical cargo (< 1,500m) MUST also be rejected and NOT consumed
+            uint localOrigin = SiegeManager.PackOriginLandblockId(new LandblockId(holtburg.AnchorLandblock));
+            var localCrate = CreateTestItem(99101u, WeenieType.Generic, ItemType.Misc, 10, name: "Local Crate");
+            localCrate.SetProperty(PropertyInt.OriginLandblockId, (int)localOrigin);
