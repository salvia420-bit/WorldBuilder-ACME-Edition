+
+            var localAttempt = WrapVehicleC2S(new EconomySiegeAction
+            {
+                TownId = 1u,
+                BeaconGuid = beacon.Guid.Full,
+                Action = 2,
+                SupplyPoints = 99_999,
+                OriginLandblock = 0x7D640001u, // Spoofed distant origin must be ignored!
+            });
+            GameActionVehicle.HandleEconomySiegeAction(localAttempt, session);
+            Assert.AreEqual(0.0, SiegeManager.GetSiegeState(1u).SupplyMeterSec, 0.001,
+                "[CRIT-01] Client msg.OriginLandblock MUST NOT override local item OriginLandblockId");
+            Assert.AreEqual(1, attacker.GetNumInventoryItemsOfWCID(99101u), "Rejected local item must remain in inventory");
+
+            // 3. Valid >= 1,500m physical cargo in inventory IS consumed and uses authoritative server SP (25 SP, not 99,999 SP)
+            attacker.TryRemoveFromInventory(localCrate.Guid, out _);
+            uint farOrigin = SiegeManager.PackOriginLandblockId(new LandblockId(0xB2B40001u)); // +1,728m east of Holtburg
+            var farCrate = CreateTestItem(99102u, WeenieType.Generic, ItemType.Misc, 10, name: "Far Siege Crate");
+            farCrate.SetProperty(PropertyInt.OriginLandblockId, (int)farOrigin);
+            Assert.IsTrue(attacker.TryAddToInventory(farCrate, out _, burdenCheck: false));
+
+            var validAttempt = WrapVehicleC2S(new EconomySiegeAction
+            {
+                TownId = 1u,
+                BeaconGuid = beacon.Guid.Full,
+                Action = 2,
+                SupplyPoints = 99_999, // Must be ignored in favor of server-authoritative unit SP (25 SP)
+                OriginLandblock = 0u,
+            });
+            GameActionVehicle.HandleEconomySiegeAction(validAttempt, session);
