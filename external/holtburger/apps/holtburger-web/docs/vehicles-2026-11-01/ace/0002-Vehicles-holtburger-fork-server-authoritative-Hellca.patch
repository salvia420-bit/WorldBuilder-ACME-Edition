+        // wide-sight visibility cost (PhysicsObj.enter_cell_server for a pilot): the last and the worst call
+        public static double VisLastHandleMs, VisLastEnqueueMs, VisMaxHandleMs, VisMaxEnqueueMs;
+        public static int VisLastNew, VisMaxNew;
+        public static long VisCalls;
+
+        public static void NoteVisibilityCost(double handleMs, double enqueueMs, int newlyVisible)
+        {
+            VisCalls++;
+            VisLastHandleMs = handleMs;
+            VisLastEnqueueMs = enqueueMs;
+            VisLastNew = newlyVisible;
+            if (handleMs > VisMaxHandleMs) VisMaxHandleMs = handleMs;
+            if (enqueueMs > VisMaxEnqueueMs) VisMaxEnqueueMs = enqueueMs;
+            if (newlyVisible > VisMaxNew) VisMaxNew = newlyVisible;
