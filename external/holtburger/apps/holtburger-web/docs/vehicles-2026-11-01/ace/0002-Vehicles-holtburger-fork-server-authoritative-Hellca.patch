+                    };
+                case "Vehicle_Event":
+                    return new VehicleEventMsg
+                    {
+                        Vehicle = U(f, "Vehicle"), Kind = U(f, "Kind"), Step = U(f, "Step"), Subject = U(f, "Subject"), Cell = U(f, "Cell"),
+                        Position = V3(f, "Position"), Value = F(f, "Value"),
+                    };
