+                    };
+                case "Vehicle_Fire":
+                    return new VehicleFireMsg
+                    {
+                        Vehicle = U(f, "Vehicle"), Step = U(f, "Step"), Mount = (ushort)U(f, "Mount"), Count = (ushort)U(f, "Count"), Cell = U(f, "Cell"),
