+        public static void HandleRetailUse(Player player, Vehicle v)
+        {
+            var capable = HasCap(player.Session, VehicleWire.CapPilot);
+            var text = capable
+                ? $"The {v.Name} is a vehicle: board it from the vehicle controls."
+                : $"The {v.Name} is a holtburger-web vehicle. You can watch it fly; flying it needs the holtburger-web client.";
+            player.Session.Network.EnqueueSend(new GameMessageSystemChat(text, ChatMessageType.Broadcast));
