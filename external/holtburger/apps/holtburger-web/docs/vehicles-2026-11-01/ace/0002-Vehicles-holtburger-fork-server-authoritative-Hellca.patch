+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Numerics;
+
+using ACE.Common.Extensions;
+using ACE.Server.Network;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// HBV1 — the holtburger vehicle messages (vehicles design 2026-11-01, DESIGN.md §5).
+    ///
+    /// The wire spec is holtburger's apps/holtburger-web/docs/vehicles-2026-11-01/protocol/vehicles.protocol.xml
+    /// (Chorizite style; one definition shared with holtburger-protocol in Rust and a future Chorizite plugin).
+    /// This file is its C# mirror; ACE.Server.Tests/Vehicles/VehicleWireTests.cs round-trips the shared byte fixtures
+    /// (vehicle-wire-fixtures.json, generated from the XML) so the two sides cannot drift.
+    ///
+    /// Every payload starts with the 8-byte header: the tag "HBV1" (0x31564248), version (1), reserved (0).
+    /// Readers reject a payload without the tag; a higher version is parsed for its v1 fields (versions only append).
+    /// </summary>
+    public static class VehicleWire
+    {
+        public const uint Tag = 0x31564248;
+        public const ushort Version = 1;
+
+        // capability bits (ClientCapabilities.Flags / CapabilitiesAck.Granted)
+        public const uint CapObserve = 0x1;
+        public const uint CapPilot = 0x2;
+        public const uint CapDatPatch = 0x4;
+
+        // C2S game actions
+        public const uint OpClientCapabilities = 0x0900;
+        public const uint OpBoard = 0x0902;
+        public const uint OpExit = 0x0903;
+        public const uint OpInput = 0x0905;
+
+        // S2C game events
+        public const uint OpCapabilitiesAck = 0x0900;
+        public const uint OpProfile = 0x0901;
+        public const uint OpSeat = 0x0904;
+        public const uint OpState = 0x0906;
+        public const uint OpFire = 0x0907;
+        public const uint OpEvent = 0x0908;
+
+        public static void WriteHeader(BinaryWriter w)
+        {
+            w.Write(Tag);
+            w.Write(Version);
+            w.Write((ushort)0);
+        }
+
+        /// <summary>Reads and validates the header. Returns the version, or 0 if this is not an HBV1 payload.</summary>
+        public static ushort ReadHeader(BinaryReader r)
+        {
+            var tag = r.ReadUInt32();
+            var version = r.ReadUInt16();
+            r.ReadUInt16(); // reserved
+            if (tag != Tag || version == 0)
+                return 0;
+            return version;
+        }
+
+        internal static void WriteVec3(BinaryWriter w, Vector3 v)
+        {
+            w.Write(v.X);
+            w.Write(v.Y);
+            w.Write(v.Z);
+        }
+
+        internal static Vector3 ReadVec3(BinaryReader r) => new Vector3(r.ReadSingle(), r.ReadSingle(), r.ReadSingle());
+
+        /// <summary>A bounded list count: each element needs at least minElem bytes.</summary>
+        internal static int ReadCount(BinaryReader r, int minElem)
+        {
+            var n = r.ReadUInt32();
+            var left = r.BaseStream.Length - r.BaseStream.Position;
+            if ((long)n * minElem > left)
+                throw new EndOfStreamException("HBV1 list count exceeds payload");
+            return (int)n;
+        }
+
+        /// <summary>Reads a C2S payload (positioned at the header). Returns null on a bad tag or a truncated payload.</summary>
+        public static VehicleC2S ReadC2S(uint opcode, BinaryReader r)
+        {
+            var start = r.BaseStream.Position;
+            try
+            {
+                var version = ReadHeader(r);
+                if (version == 0)
+                    return null;
+                VehicleC2S msg = opcode switch
+                {
+                    OpClientCapabilities => new VehicleClientCapabilities { Flags = r.ReadUInt32() },
+                    OpBoard => new VehicleBoard { Vehicle = r.ReadUInt32(), Seat = r.ReadUInt32() },
+                    OpExit => new VehicleExit { Vehicle = r.ReadUInt32(), Mode = r.ReadUInt32() },
+                    OpInput => ReadInput(r),
+                    _ => null,
+                };
+                if (msg != null && version > Version)
+                    r.BaseStream.Position = r.BaseStream.Length;
+                return msg;
+            }
+            catch (EndOfStreamException)
+            {
+                r.BaseStream.Position = start;
+                return null;
+            }
+        }
+
+        private static VehicleInput ReadInput(BinaryReader r)
+        {
+            var msg = new VehicleInput { Vehicle = r.ReadUInt32() };
+            var n = ReadCount(r, VehicleInputFrame.WireSize);
+            for (var i = 0; i < n; i++)
+                msg.Frames.Add(VehicleInputFrame.Read(r));
+            return msg;
+        }
+
+        /// <summary>Reads an S2C payload (tests and tools; ACE never receives these).</summary>
+        public static VehicleS2C ReadS2C(uint opcode, BinaryReader r)
+        {
+            var start = r.BaseStream.Position;
+            try
+            {
+                var version = ReadHeader(r);
+                if (version == 0)
+                    return null;
+                VehicleS2C msg = opcode switch
+                {
+                    OpCapabilitiesAck => new VehicleCapabilitiesAck { Granted = r.ReadUInt32(), SimHz = r.ReadUInt16(), Reserved = r.ReadUInt16() },
+                    OpProfile => VehicleProfileMsg.ReadBody(r),
+                    OpSeat => new VehicleSeatMsg { Vehicle = r.ReadUInt32(), Seat = r.ReadUInt32(), Occupant = r.ReadUInt32(), State = r.ReadUInt32(), Reason = r.ReadUInt32() },
+                    OpState => VehicleStateMsg.ReadBody(r),
+                    OpFire => VehicleFireMsg.ReadBody(r),
+                    OpEvent => new VehicleEventMsg
+                    {
+                        Vehicle = r.ReadUInt32(), Kind = r.ReadUInt32(), Step = r.ReadUInt32(), Subject = r.ReadUInt32(),
+                        Cell = r.ReadUInt32(), Position = ReadVec3(r), Value = r.ReadSingle()
+                    },
+                    _ => null,
+                };
+                if (msg != null && version > Version)
+                    r.BaseStream.Position = r.BaseStream.Length;
+                return msg;
+            }
+            catch (EndOfStreamException)
+            {
+                r.BaseStream.Position = start;
+                return null;
+            }
+        }
+
+        public static byte[] Pack(VehicleMessage msg)
+        {
+            using var ms = new MemoryStream();
+            using var w = new BinaryWriter(ms);
+            msg.Write(w);
+            w.Flush();
+            return ms.ToArray();
+        }
+    }
+
+    public abstract class VehicleMessage
+    {
+        public abstract uint Opcode { get; }
+
+        /// <summary>Header + fields (no opcode).</summary>
+        public void Write(BinaryWriter w)
+        {
+            VehicleWire.WriteHeader(w);
+            WriteBody(w);
+        }
+
+        protected abstract void WriteBody(BinaryWriter w);
+    }
+
+    public abstract class VehicleC2S : VehicleMessage { }
+
+    public abstract class VehicleS2C : VehicleMessage { }
+
+    // ------------------------------------------------------------------ C2S
+
+    public sealed class VehicleClientCapabilities : VehicleC2S
+    {
+        public uint Flags;
+        public override uint Opcode => VehicleWire.OpClientCapabilities;
+        protected override void WriteBody(BinaryWriter w) => w.Write(Flags);
+    }
+
+    public sealed class VehicleBoard : VehicleC2S
+    {
+        public uint Vehicle;
+        public uint Seat;
+        public override uint Opcode => VehicleWire.OpBoard;
+        protected override void WriteBody(BinaryWriter w) { w.Write(Vehicle); w.Write(Seat); }
+    }
+
+    public sealed class VehicleExit : VehicleC2S
+    {
+        public const uint ModeExit = 0;
+        public const uint ModeBail = 1;
+        /// <summary>While falling after a bail-out: open the parachute now (otherwise it opens at 150 m above the ground).</summary>
+        public const uint ModeChute = 2;
+        public uint Vehicle;
+        public uint Mode;
+        public override uint Opcode => VehicleWire.OpExit;
+        protected override void WriteBody(BinaryWriter w) { w.Write(Vehicle); w.Write(Mode); }
+    }
+
+    public struct VehicleInputFrame
+    {
+        public const int WireSize = 12;
+        public const byte ButtonBoost = 0x01;
+        public const byte ButtonFire = 0x02;
+        public const byte ButtonLand = 0x04;
+
+        public uint Seq;
+        public byte Throttle;
+        public sbyte Pitch;
+        public sbyte Roll;
+        public sbyte Yaw;
+        public byte Buttons;
+        public byte Reserved0, Reserved1, Reserved2;
+
+        public static VehicleInputFrame Read(BinaryReader r) => new VehicleInputFrame
+        {
+            Seq = r.ReadUInt32(), Throttle = r.ReadByte(), Pitch = r.ReadSByte(), Roll = r.ReadSByte(), Yaw = r.ReadSByte(),
+            Buttons = r.ReadByte(), Reserved0 = r.ReadByte(), Reserved1 = r.ReadByte(), Reserved2 = r.ReadByte(),
+        };
+
+        public void Write(BinaryWriter w)
+        {
+            w.Write(Seq); w.Write(Throttle); w.Write(Pitch); w.Write(Roll); w.Write(Yaw);
+            w.Write(Buttons); w.Write(Reserved0); w.Write(Reserved1); w.Write(Reserved2);
+        }
+
+        /// <summary>Stick scaling shared with the JS predictor: i8 / 127, -128 clamps to -1.</summary>
+        public static double Stick(sbyte v) => Math.Max(-1.0, v / 127.0);
+        public double ThrottleUnit => Throttle / 255.0;
+    }
+
+    public sealed class VehicleInput : VehicleC2S
+    {
+        public uint Vehicle;
+        /// <summary>Newest first, then up to two older frames.</summary>
