+        public static Player PilotOf(Vehicle v)
+        {
+            var guid = v.Pilot;
+            if (guid == 0) return null;
+            var p = PlayerManager.GetOnlinePlayer(guid);
+            if (p == null || p.PhysicsObj == null || p.IsLoggingOut)
+                return null;
