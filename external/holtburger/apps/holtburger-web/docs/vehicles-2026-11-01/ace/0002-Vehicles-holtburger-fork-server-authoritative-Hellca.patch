+        /// <summary>Profile + seats + current state, the first time a capable session sees a vehicle.</summary>
+        static void SendIntro(Player player, Vehicle v)
+        {
+            var session = player.Session;
+            if (!HasCap(session, VehicleWire.CapObserve))
+                return;
+            SendTo(v, session, v.Profile.ToMsg(v.Guid.Full, v.VCap > 0 ? v.VCap : SpeedCap, SimHz));
+            for (var i = 0; i < v.SeatOccupants.Length; i++)
+                if (v.SeatOccupants[i] != 0)
+                    SendTo(v, session, new VehicleSeatMsg { Vehicle = v.Guid.Full, Seat = (uint)i, Occupant = v.SeatOccupants[i], State = VehicleSeatMsg.StateOccupied });
+            SendTo(v, session, v.BuildStateMsg(v.Pilot == player.Guid.Full));
+        }
