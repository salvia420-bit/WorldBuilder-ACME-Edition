diff --git a/Source/ACE.Server.Tests/Vehicles/FlightModelParityTests.cs b/Source/ACE.Server.Tests/Vehicles/FlightModelParityTests.cs
new file mode 100644
index 0000000..8c92824
--- /dev/null
+++ b/Source/ACE.Server.Tests/Vehicles/FlightModelParityTests.cs
@@ -0,0 +1,189 @@
+using System;
+using System.IO;
+using System.Text.Json;
+
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+
+using ACE.Server.Vehicles;
+
+namespace ACE.Server.Tests.Vehicles
+{
+    /// <summary>
+    /// Flight-model parity (vehicles DESIGN §7): the authoritative C# FlightModel must reproduce the golden trajectories
+    /// generated by the client's predictor twin (holtburger scene3d/vehicle/flight_model.js, gen_golden.mjs) within
+    /// 1 mm after 30 s (900 steps), and the gun's spread RNG must replay the same offsets the client draws tracers with.
+    /// The JSON is a copy of holtburger docs/vehicles-2026-11-01/flight/flight-golden.json (sync-ace-fixtures.sh).
+    /// </summary>
+    [TestClass]
+    public class FlightModelParityTests
+    {
+        static JsonElement root;
+
+        [ClassInitialize]
+        public static void Init(TestContext _)
+        {
+            var path = Path.Combine(AppContext.BaseDirectory, "Vehicles", "flight-golden.json");
+            root = JsonDocument.Parse(File.ReadAllText(path)).RootElement;
+        }
+
+        static double D(JsonElement o, string k) => o.GetProperty(k).GetDouble();
+
+        static FlightParams Params()
+        {
+            var p = root.GetProperty("params");
+            return new FlightParams
+            {
+                VMin = D(p, "vMin"), VCruise = D(p, "vCruise"), VMax = D(p, "vMax"), Accel = D(p, "accel"), Decel = D(p, "decel"),
+                MaxBank = D(p, "maxBank"), RollRate = D(p, "rollRate"), MaxPitch = D(p, "maxPitch"), PitchRate = D(p, "pitchRate"),
+                YawRate = D(p, "yawRate"), ClimbMax = D(p, "climbMax"), SinkMax = D(p, "sinkMax"), FloorAgl = D(p, "floorAgl"),
+                CeilingAgl = D(p, "ceilingAgl"), TakeoffClimb = D(p, "takeoffClimb"), LandingSpeed = D(p, "landingSpeed"),
+            };
+        }
+
+        static FlightState State(JsonElement s) => new FlightState
+        {
+            X = D(s, "x"), Y = D(s, "y"), Z = D(s, "z"), Heading = D(s, "heading"), Pitch = D(s, "pitch"), Bank = D(s, "bank"),
+            Speed = D(s, "speed"), Mode = s.GetProperty("mode").GetInt32(),
+        };
+
+        [TestMethod]
+        public void GoldenTrajectoriesWithin1mmAfter30s()
+        {
+            var g = root.GetProperty("ground");
+            double gb = D(g, "base"), ga = D(g, "amp"), kx = D(g, "kx"), ky = D(g, "ky");
+            Func<double, double, double> ground = (x, y) => gb + ga * Math.Sin(x / kx) * Math.Cos(y / ky);
+            var p = Params();
+            var vCap = D(root, "vCap");
+            var dt = D(root, "dt");
+            Assert.AreEqual(FlightModel.Dt, dt, 0.0, "step length");
+            var worst = 0.0;
+            foreach (var seq in root.GetProperty("sequences").EnumerateArray())
+            {
+                var name = seq.GetProperty("name").GetString();
+                var s = State(seq.GetProperty("initial"));
+                var checkpoints = seq.GetProperty("checkpoints");
+                var ci = 0;
+                var step = 0;
+                foreach (var fr in seq.GetProperty("frames").EnumerateArray())
+                {
+                    var frame = new VehicleInputFrame
+                    {
+                        Throttle = (byte)fr[0].GetInt32(), Pitch = (sbyte)fr[1].GetInt32(), Roll = (sbyte)fr[2].GetInt32(),
+                        Yaw = (sbyte)fr[3].GetInt32(), Buttons = (byte)fr[4].GetInt32(),
+                    };
+                    FlightModel.Step(ref s, FlightInput.FromFrame(frame), p, vCap, ground, dt);
+                    step++;
+                    if (ci < checkpoints.GetArrayLength() && checkpoints[ci].GetProperty("step").GetInt32() == step)
+                    {
+                        var want = State(checkpoints[ci].GetProperty("state"));
+                        var dist = Math.Sqrt((s.X - want.X) * (s.X - want.X) + (s.Y - want.Y) * (s.Y - want.Y) + (s.Z - want.Z) * (s.Z - want.Z));
+                        worst = Math.Max(worst, dist);
+                        Assert.IsTrue(dist < 0.001, $"{name} step {step}: position off by {dist} m");
+                        Assert.AreEqual(want.Mode, s.Mode, $"{name} step {step}: mode");
+                        Assert.AreEqual(want.Speed, s.Speed, 1e-6, $"{name} step {step}: speed");
+                        Assert.AreEqual(0.0, Math.IEEERemainder(s.Heading - want.Heading, 2 * Math.PI), 1e-6, $"{name} step {step}: heading");
+                        Assert.AreEqual(want.Pitch, s.Pitch, 1e-6, $"{name} step {step}: pitch");
+                        Assert.AreEqual(want.Bank, s.Bank, 1e-6, $"{name} step {step}: bank");
+                        ci++;
+                    }
+                }
+                Assert.AreEqual(checkpoints.GetArrayLength(), ci, $"{name}: every checkpoint compared");
+            }
+            Console.WriteLine($"worst checkpoint distance C# vs JS: {worst:E3} m");
+        }
+
+        [TestMethod]
+        public void BailoutFallMatchesClientModel()
+        {
+            var g = root.GetProperty("fall");
+            var i0 = g.GetProperty("initial");
+            double x = D(i0, "x"), y = D(i0, "y"), z = D(i0, "z"), vx = D(i0, "vx"), vy = D(i0, "vy"), vz = D(i0, "vz");
+            var heading = D(i0, "heading");
+            var chuteAt = g.GetProperty("chuteAtStep").GetInt32();
+            var cps = g.GetProperty("checkpoints");
+            var ci = 0;
+            var chute = false;
+            for (var i = 1; i <= g.GetProperty("steps").GetInt32(); i++)
+            {
+                if (i == chuteAt) chute = true;
+                VehicleBailout.StepFall(ref x, ref y, ref z, ref vx, ref vy, ref vz, heading, chute, FlightModel.Dt);
+                if (ci < cps.GetArrayLength() && cps[ci].GetProperty("step").GetInt32() == i)
+                {
+                    var st = cps[ci].GetProperty("state");
+                    var d = Math.Sqrt(Math.Pow(x - D(st, "x"), 2) + Math.Pow(y - D(st, "y"), 2) + Math.Pow(z - D(st, "z"), 2));
+                    Assert.IsTrue(d < 0.001, $"fall step {i}: {d} m");
+                    Assert.AreEqual(D(st, "vz"), vz, 1e-9, $"fall step {i}: vz");
+                    ci++;
+                }
+            }
+            Assert.AreEqual(cps.GetArrayLength(), ci);
+        }
+
+        [TestMethod]
+        public void SpreadRngMatchesClientTracers()
+        {
+            var sp = root.GetProperty("spread");
+            foreach (var pair in sp.GetProperty("xorshift").EnumerateArray())
+            {
+                var s = pair[0].GetUInt32();
+                Assert.AreEqual(pair[1].GetUInt32(), VehicleWeapons.XorShift(ref s));
+            }
+            var rng = sp.GetProperty("seed").GetUInt32();
+            var spread = D(sp, "spread");
+            foreach (var o in sp.GetProperty("offsets").EnumerateArray())
+            {
+                var (dr, du) = VehicleWeapons.SpreadOffset(ref rng, spread);
+                Assert.AreEqual(D(o, "dRight"), dr, 1e-15);
+                Assert.AreEqual(D(o, "dUp"), du, 1e-15);
+            }
+        }
+
+        [TestMethod]
+        public void InputQueueSubstitutesAndNeverWaits()
+        {
+            var q = new PilotInputQueue();
+            var msg = new VehicleInput { Vehicle = 1 };
+            msg.Frames.Add(new VehicleInputFrame { Seq = 11, Throttle = 200 });
+            msg.Frames.Add(new VehicleInputFrame { Seq = 10, Throttle = 100 });
+            q.Add(msg, DateTime.UtcNow);
+            var f = q.Next(out var sub);
+            Assert.IsFalse(sub); Assert.AreEqual(10u, f.Seq);
+            f = q.Next(out sub);
+            Assert.IsFalse(sub); Assert.AreEqual(11u, f.Seq);
+            f = q.Next(out sub); // 12 missing → substitute (repeat 11's input as seq 12)
+            Assert.IsTrue(sub); Assert.AreEqual(12u, f.Seq); Assert.AreEqual(200, f.Throttle);
+            var late = new VehicleInput { Vehicle = 1 };
+            late.Frames.Add(new VehicleInputFrame { Seq = 13, Throttle = 50 });
+            late.Frames.Add(new VehicleInputFrame { Seq = 12, Throttle = 10 }); // redundant copy of the substituted seq: dropped
+            q.Add(late, DateTime.UtcNow);
+            f = q.Next(out sub);
+            Assert.IsFalse(sub); Assert.AreEqual(13u, f.Seq); Assert.AreEqual(50, f.Throttle);
+            Assert.AreEqual(1, q.Substituted);
+        }
+
+        [TestMethod]
+        public void InputQueueWaitsForTheNextFrameUnlessItIsLost()
+        {
+            var q = new PilotInputQueue();
+            Assert.IsFalse(q.HasNext(), "empty, not started");
+            var a = new VehicleInput { Vehicle = 1 };
+            a.Frames.Add(new VehicleInputFrame { Seq = 2 });
+            a.Frames.Add(new VehicleInputFrame { Seq = 1 });
+            q.Add(a, DateTime.UtcNow);
+            Assert.IsTrue(q.HasNext(), "jitter buffer filled");
+            q.Next(out _); q.Next(out _);
+            Assert.IsFalse(q.HasNext(), "seq 3 not here yet: wait (stall), do not substitute");
+            var b = new VehicleInput { Vehicle = 1 };
+            b.Frames.Add(new VehicleInputFrame { Seq = 5 });
+            q.Add(b, DateTime.UtcNow);
+            Assert.IsFalse(q.HasNext(), "5 < 3 + LostGap: 3 may still come");
+            var c = new VehicleInput { Vehicle = 1 };
+            c.Frames.Add(new VehicleInputFrame { Seq = 6 });
+            q.Add(c, DateTime.UtcNow);
+            Assert.IsTrue(q.HasNext(), "6 >= 3 + LostGap: 3 is lost");
+            var f = q.Next(out var sub);
+            Assert.IsTrue(sub); Assert.AreEqual(3u, f.Seq);
+            Assert.IsTrue(q.Starving(DateTime.UtcNow.AddSeconds(2), 1.0));
+        }
+    }
+}
