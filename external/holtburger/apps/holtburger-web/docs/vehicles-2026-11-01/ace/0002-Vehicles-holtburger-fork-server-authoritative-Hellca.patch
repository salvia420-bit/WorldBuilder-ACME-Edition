+
+        static VehicleMessage Read(string dir, uint opcode, byte[] bytes)
+        {
+            using var r = new BinaryReader(new MemoryStream(bytes));
+            return dir == "C2S" ? VehicleWire.ReadC2S(opcode, r) : VehicleWire.ReadS2C(opcode, r);
+        }
+
+        [TestMethod]
+        public void Hbv1FixturesRoundTrip()
+        {
+            Assert.AreEqual(VehicleWire.Tag, doc.RootElement.GetProperty("tag").GetUInt32());
+            var checkedCount = 0;
+            foreach (var fx in doc.RootElement.GetProperty("fixtures").EnumerateArray())
+            {
+                var name = fx.GetProperty("name").GetString();
+                var message = fx.GetProperty("message").GetString();
+                var dir = fx.GetProperty("dir").GetString();
+                var opcode = fx.GetProperty("opcode").GetUInt32();
+                var hex = fx.GetProperty("hex").GetString();
+                var bytes = Hex(hex);
+                var reject = fx.GetProperty("expect").GetString() == "reject";
+                var future = fx.TryGetProperty("trailing_hex", out var trailing);
+
+                var msg = Read(dir, opcode, bytes);
+                if (reject)
+                {
+                    Assert.IsNull(msg, $"{name}: must be rejected");
+                    continue;
+                }
+                Assert.IsNotNull(msg, $"{name}: unpack failed");
+                Assert.AreEqual(opcode, msg.Opcode, name);
+
+                var repacked = Hex(VehicleWire.Pack(msg));
+                var built = Hex(VehicleWire.Pack(Build(message, fx.GetProperty("fields"))));
+                if (future)
+                {
+                    // a v1 writer emits version 1 and no trailing bytes
+                    var want = bytes.Take(bytes.Length - trailing.GetString().Length / 2).ToArray();
+                    want[4] = 1; want[5] = 0;
+                    Assert.AreEqual(Hex(want), repacked, $"{name}: v1 repack of a future payload");
+                    Assert.AreEqual(Hex(want), built, $"{name}: v1 build");
+                }
+                else
+                {
+                    Assert.AreEqual(hex, repacked, $"{name}: unpack → pack");
+                    Assert.AreEqual(hex, built, $"{name}: fields → pack");
+                }
+                checkedCount++;
+            }
+            Assert.IsTrue(checkedCount >= 12, $"only {checkedCount} fixtures checked");
+        }
+
+        [TestMethod]
+        public void Hbv1TruncatedAndHostileInputRejected()
+        {
+            var fx = doc.RootElement.GetProperty("fixtures").EnumerateArray().First(f => f.GetProperty("name").GetString() == "vehicle_input_3");
+            var bytes = Hex(fx.GetProperty("hex").GetString());
+            foreach (var cut in new[] { bytes.Length - 1, 20, 9, 0 })
+                Assert.IsNull(Read("C2S", VehicleWire.OpInput, bytes.Take(cut).ToArray()), $"cut {cut}");
+            var evil = bytes.Take(16).ToArray();
+            BitConverter.GetBytes(uint.MaxValue).CopyTo(evil, 12);
+            Assert.IsNull(Read("C2S", VehicleWire.OpInput, evil), "hostile count");
+        }
+
+        [TestMethod]
+        public void TerrainSplitAndTriangleMatchHoltburger()
+        {
+            // Golden values from holtburger-dat terrain_subdiv (cell_swto_ne_cut / triangle_height_in_cell): spot values
+            // computed with the same 32-bit wrapping formula.
+            Assert.AreEqual(Ref(0, 0), VehicleTerrain.CellSwToNeCut(0, 0));
+            for (uint x = 1352; x < 1360; x++)
+                for (uint y = 1440; y < 1448; y++)
+                    Assert.AreEqual(Ref(x, y), VehicleTerrain.CellSwToNeCut(x, y), $"{x},{y}");
+            Assert.AreEqual(10f, VehicleTerrain.TriangleHeightInCell(10, 20, 30, 40, 0, 0, true));
+            Assert.AreEqual(40f, VehicleTerrain.TriangleHeightInCell(10, 20, 30, 40, 1, 1, true));
+            Assert.AreEqual(20f, VehicleTerrain.TriangleHeightInCell(10, 20, 30, 40, 1, 0, false));
+            Assert.AreEqual(30f, VehicleTerrain.TriangleHeightInCell(10, 20, 30, 40, 0, 1, false));
+        }
+
+        static bool Ref(uint gx, uint gy)
+        {
+            unchecked
+            {
+                ulong inner = (uint)(214614067u * gx + 1813693831u);
+                uint v8 = (uint)(gy * (uint)inner) - 1109124029u * gx - 1369149221u;
+                return v8 * 2.3283064e-10 >= 0.5;
+            }
+        }
+    }
+}
