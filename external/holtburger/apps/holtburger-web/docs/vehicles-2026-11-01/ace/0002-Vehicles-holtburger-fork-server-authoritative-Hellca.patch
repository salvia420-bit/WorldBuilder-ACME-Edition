+using System;
+using System.IO;
+using System.Linq;
+using System.Numerics;
+using System.Text.Json;
+
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+
+using ACE.Server.Vehicles;
+
+namespace ACE.Server.Tests.Vehicles
+{
+    /// <summary>
+    /// HBV1 wire parity: the byte fixtures generated from holtburger's vehicles.protocol.xml (gen_fixtures.py) must
+    /// round-trip through ACE's VehicleWire exactly as they do through holtburger-protocol (Rust).
+    ///   unpack(hex) → pack == hex,   build(fields) → pack == hex,   bad tag → rejected,   future version → v1 fields.
+    /// The JSON here is a copy of the canonical file (holtburger docs/vehicles-2026-11-01/protocol/sync-ace-fixtures.sh).
+    /// </summary>
+    [TestClass]
+    public class VehicleWireTests
+    {
+        static JsonDocument doc;
+
+        [ClassInitialize]
+        public static void Init(TestContext _)
+        {
+            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
+            var path = Path.Combine(AppContext.BaseDirectory, "Vehicles", "vehicle-wire-fixtures.json");
+            doc = JsonDocument.Parse(File.ReadAllText(path));
+        }
+
+        static byte[] Hex(string h) => Convert.FromHexString(h);
+        static string Hex(byte[] b) => Convert.ToHexString(b).ToLowerInvariant();
+
+        static uint U(JsonElement o, string k) => o.GetProperty(k).GetUInt32();
+        static float F(JsonElement o, string k) => (float)o.GetProperty(k).GetDouble();
+        static Vector3 V3(JsonElement o, string k)
+        {
+            var v = o.GetProperty(k);
+            return new Vector3(F(v, "X"), F(v, "Y"), F(v, "Z"));
+        }
+
+        static VehicleMessage Build(string message, JsonElement f)
+        {
+            switch (message)
+            {
+                case "Vehicle_ClientCapabilities": return new VehicleClientCapabilities { Flags = U(f, "Flags") };
+                case "Vehicle_Board": return new VehicleBoard { Vehicle = U(f, "Vehicle"), Seat = U(f, "Seat") };
+                case "Vehicle_Exit": return new VehicleExit { Vehicle = U(f, "Vehicle"), Mode = U(f, "Mode") };
+                case "Vehicle_Input":
+                {
+                    var m = new VehicleInput { Vehicle = U(f, "Vehicle") };
+                    foreach (var fr in f.GetProperty("Frames").EnumerateArray())
+                        m.Frames.Add(new VehicleInputFrame
+                        {
+                            Seq = U(fr, "Seq"), Throttle = (byte)U(fr, "Throttle"), Pitch = (sbyte)fr.GetProperty("Pitch").GetInt32(),
+                            Roll = (sbyte)fr.GetProperty("Roll").GetInt32(), Yaw = (sbyte)fr.GetProperty("Yaw").GetInt32(),
+                            Buttons = (byte)U(fr, "Buttons"), Reserved0 = (byte)U(fr, "Reserved0"), Reserved1 = (byte)U(fr, "Reserved1"), Reserved2 = (byte)U(fr, "Reserved2"),
+                        });
+                    return m;
+                }
+                case "Vehicle_CapabilitiesAck":
+                    return new VehicleCapabilitiesAck { Granted = U(f, "Granted"), SimHz = (ushort)U(f, "SimHz"), Reserved = (ushort)U(f, "Reserved") };
+                case "Vehicle_Profile":
+                {
+                    var p = new VehicleProfileMsg
+                    {
+                        Vehicle = U(f, "Vehicle"), ProfileKey = f.GetProperty("ProfileKey").GetString(), DisplayName = f.GetProperty("DisplayName").GetString(),
+                        Locomotion = U(f, "Locomotion"), StandInSetup = U(f, "StandInSetup"), SimHz = (ushort)U(f, "SimHz"), Reserved = (ushort)U(f, "Reserved"),
+                        VMin = F(f, "VMin"), VCruise = F(f, "VCruise"), VMax = F(f, "VMax"), SpeedCap = F(f, "SpeedCap"), Accel = F(f, "Accel"), Decel = F(f, "Decel"),
+                        MaxBank = F(f, "MaxBank"), RollRate = F(f, "RollRate"), MaxPitch = F(f, "MaxPitch"), PitchRate = F(f, "PitchRate"), YawRate = F(f, "YawRate"),
+                        ClimbMax = F(f, "ClimbMax"), SinkMax = F(f, "SinkMax"), FloorAgl = F(f, "FloorAgl"), CeilingAgl = F(f, "CeilingAgl"),
+                        TakeoffClimb = F(f, "TakeoffClimb"), LandingSpeed = F(f, "LandingSpeed"), LeadSeconds = F(f, "LeadSeconds"), ObjectRadius = U(f, "ObjectRadius"),
+                    };
+                    foreach (var s in f.GetProperty("Seats").EnumerateArray())
+                        p.Seats.Add(new VehicleSeatDef { Role = U(s, "Role"), Motion = U(s, "Motion"), Offset = V3(s, "Offset") });
+                    foreach (var w in f.GetProperty("Weapons").EnumerateArray())
+                        p.Weapons.Add(new VehicleWeaponDef
+                        {
+                            Kind = U(w, "Kind"), RoundsPerSecond = F(w, "RoundsPerSecond"), Spread = F(w, "Spread"), Range = F(w, "Range"),
+                            Damage = F(w, "Damage"), Magazine = U(w, "Magazine"), Muzzle = V3(w, "Muzzle"),
+                        });
+                    foreach (var pt in f.GetProperty("Parts").EnumerateArray())
+                    {
+                        var r = pt.GetProperty("Rotation");
+                        p.Parts.Add(new VehiclePartDef
+                        {
+                            Did = U(pt, "Did"), Offset = V3(pt, "Offset"),
+                            Rotation = new Quaternion(F(r, "X"), F(r, "Y"), F(r, "Z"), F(r, "W")), Scale = F(pt, "Scale"),
