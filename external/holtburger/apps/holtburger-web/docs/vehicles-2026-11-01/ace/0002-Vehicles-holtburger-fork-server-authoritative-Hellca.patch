+        static bool warmupStarted;
+        public static double WarmupMs = double.NaN;
+
+        /// <summary>
+        /// One-time costs a pilot would otherwise pay on the world thread, run off-thread once vehicles are enabled:
+        /// HouseCell's static tables (~13,900 entries, ONE huge static constructor: 144 ms idle, 300-950 ms under load —
+        /// the first villa / mansion CreateObject evaluates House.RootGuid; benches m3-e/f/g stalled on it at 0xBCAD).
+        /// Vanilla ACE pays the same cost for the first player who sees a villa or mansion.
+        /// </summary>
+        static void StartWarmup()
+        {
+            warmupStarted = true;
+            System.Threading.Tasks.Task.Run(() =>
+            {
+                var sw = Stopwatch.StartNew();
+                try
+                {
+                    System.Runtime.CompilerServices.RuntimeHelpers.RunClassConstructor(typeof(HouseCell).TypeHandle);
+                    WarmupMs = sw.Elapsed.TotalMilliseconds;
+                    log.Info($"[VEHICLE] warm-up: HouseCell tables ready in {WarmupMs:0.0} ms (off the world thread)");
+                }
+                catch (Exception e)
+                {
+                    log.Warn($"[VEHICLE] warm-up failed: {e.Message}");
+                }
+            });
+        }
+
+        // a seated pilot's CreateObject cost per object: the worst since the last tick (for the stall line) and overall
+        public static double CoWindowWorstMs, CoWorstMs;
+        public static string CoWindowWorstDesc = "", CoWorstDesc = "";
+        public static long CoOver20Ms;
+
+        static string Describe(WorldObject wo) =>
+            $"{wo.Name} 0x{wo.Guid.Full:X8} wcid {wo.WeenieClassId} {wo.WeenieType}{(wo is House h ? " " + h.HouseType : "")} at {wo.Location?.Cell ?? 0:X8}";
+
+        public static void NoteCreateObjectCost(WorldObject wo, long t0)
+        {
+            var ms = (Stopwatch.GetTimestamp() - t0) * 1000.0 / Stopwatch.Frequency;
+            if (ms < 2.0 && ms <= CoWindowWorstMs)
+                return;
+            if (ms > CoWindowWorstMs)
+            {
+                CoWindowWorstMs = ms;
+                CoWindowWorstDesc = Describe(wo);
+            }
+            if (ms > CoWorstMs)
+            {
+                CoWorstMs = ms;
+                CoWorstDesc = Describe(wo);
+            }
+            if (ms >= 20.0)
+            {
+                CoOver20Ms++;
+                log.Warn($"[VEHICLE][CO] pilot CreateObject for {Describe(wo)} took {ms:0.0} ms");
+            }
+        }
+
+        /// <summary>Player.TrackObject hook: CreateObject was just sent for this object.</summary>
+        public static void OnTracked(Player player, WorldObject wo)
+        {
+            if (wo is Vehicle v && !v.IsDestroyed)
+                SendIntro(player, v);
+        }
+
+        /// <summary>
+        /// Player.TrackObject hook for a SEATED pilot (M3 metric): the object's along-track distance ÷ the vehicle's speed
+        /// at the moment the server sends its CreateObject — the warning a pilot gets, independent of client rendering.
+        /// </summary>
+        public static void OnFirstSight(Player pilot, WorldObject wo)
+        {
+            var v = VehicleOf(pilot);
+            if (v == null || wo is Vehicle || v.State.Mode != VehicleMode.Flight || v.State.Speed < 20 || wo.Location == null)
+                return;
+            var (ox, oy, _) = Vehicle.ToGlobal(wo.Location);
+            var dx = ox - v.State.X;
+            var dy = oy - v.State.Y;
+            var along = dx * Math.Sin(v.State.Heading) + dy * Math.Cos(v.State.Heading);
+            var warn = along / v.State.Speed;
+            var c = v.Costs;
+            c.FirstSights++;
+            if (warn >= 1.0) c.FirstSightsOver1s++;
+            if (along > 0) c.FirstSightsAhead++;
+            c.FirstSightDistTotal += Math.Sqrt(dx * dx + dy * dy);
+            if (c.WarnSamples.Count < 20000) c.WarnSamples.Add(warn);
+        }
