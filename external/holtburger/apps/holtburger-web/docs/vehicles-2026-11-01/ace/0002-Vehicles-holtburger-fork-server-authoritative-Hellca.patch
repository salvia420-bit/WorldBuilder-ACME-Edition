+                case "Vehicle_Seat":
+                    return new VehicleSeatMsg { Vehicle = U(f, "Vehicle"), Seat = U(f, "Seat"), Occupant = U(f, "Occupant"), State = U(f, "State"), Reason = U(f, "Reason") };
+                case "Vehicle_State":
