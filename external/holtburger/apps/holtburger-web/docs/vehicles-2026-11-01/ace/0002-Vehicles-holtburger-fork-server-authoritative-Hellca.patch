+            n = VehicleWire.ReadCount(r, 36);
+            for (var i = 0; i < n; i++)
+                p.Weapons.Add(new VehicleWeaponDef
+                {
+                    Kind = r.ReadUInt32(), RoundsPerSecond = r.ReadSingle(), Spread = r.ReadSingle(), Range = r.ReadSingle(),
+                    Damage = r.ReadSingle(), Magazine = r.ReadUInt32(), Muzzle = VehicleWire.ReadVec3(r),
+                });
+            n = VehicleWire.ReadCount(r, 36);
+            for (var i = 0; i < n; i++)
+            {
+                var did = r.ReadUInt32();
+                var off = VehicleWire.ReadVec3(r);
+                var qw = r.ReadSingle(); var qx = r.ReadSingle(); var qy = r.ReadSingle(); var qz = r.ReadSingle();
+                p.Parts.Add(new VehiclePartDef { Did = did, Offset = off, Rotation = new Quaternion(qx, qy, qz, qw), Scale = r.ReadSingle() });
+            }
+            return p;
+        }
+    }
