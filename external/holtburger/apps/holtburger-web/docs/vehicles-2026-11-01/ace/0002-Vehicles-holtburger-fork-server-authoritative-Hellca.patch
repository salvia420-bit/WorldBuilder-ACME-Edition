+            p.Accel = r.ReadSingle(); p.Decel = r.ReadSingle(); p.MaxBank = r.ReadSingle(); p.RollRate = r.ReadSingle();
+            p.MaxPitch = r.ReadSingle(); p.PitchRate = r.ReadSingle(); p.YawRate = r.ReadSingle(); p.ClimbMax = r.ReadSingle();
+            p.SinkMax = r.ReadSingle(); p.FloorAgl = r.ReadSingle(); p.CeilingAgl = r.ReadSingle(); p.TakeoffClimb = r.ReadSingle();
+            p.LandingSpeed = r.ReadSingle(); p.LeadSeconds = r.ReadSingle();
