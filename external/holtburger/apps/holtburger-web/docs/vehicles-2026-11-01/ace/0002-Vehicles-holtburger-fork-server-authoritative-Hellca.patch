@@ -0,0 +1,31 @@
+using System.Numerics;
+
+using ACE.Entity.Enum;
+
+using ACE.Server.Network.Structure;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Network.GameMessages.Messages
+{
+    /// <summary>
+    /// A standard UpdatePosition (0xF748) for a vehicle or its seated pilot, with the flight velocity filled in so
+    /// retail clients dead-reckon between the 10 Hz updates. The physics object's own Velocity stays zero (a non-zero
+    /// Velocity would make the landblock tick integrate the body server-side and fight the vehicle).
+    /// </summary>
+    public class GameMessageVehicleUpdatePosition : GameMessage
+    {
+        public GameMessageVehicleUpdatePosition(WorldObject wo, Vector3 velocity, bool grounded)
+            : base(GameMessageOpcode.UpdatePosition, GameMessageGroup.SmartboxQueue, 68)
+        {
+            var pack = new PositionPack(wo); // increments the object's position sequence once
+            pack.Velocity = velocity;
+            pack.Flags = pack.BuildFlags();
+            if (grounded)
+                pack.Flags |= PositionFlags.IsGrounded;
+            else
+                pack.Flags &= ~PositionFlags.IsGrounded;
+            Writer.WriteGuid(wo.Guid);
+            Writer.Write(pack);
+        }
+    }
+}
