@@ -0,0 +1,41 @@
+using ACE.Server.Vehicles;
+
+namespace ACE.Server.Network.GameAction.Actions
+{
+    /// <summary>
+    /// HBV1 vehicle game actions (holtburger vehicles fork). A payload without the HBV1 tag, or any vehicle action while
+    /// the vehicles_enabled property is off, is dropped silently; pilot actions need the session's pilot bit.
+    /// </summary>
+    public static class GameActionVehicle
+    {
+        [GameAction(GameActionType.VehicleClientCapabilities)]
+        public static void HandleCapabilities(ClientMessage message, Session session)
+        {
+            if (VehicleWire.ReadC2S(VehicleWire.OpClientCapabilities, message.Payload) is VehicleClientCapabilities msg)
+                VehicleManager.HandleCapabilities(session, msg);
+        }
+
+        [GameAction(GameActionType.VehicleBoard)]
+        public static void HandleBoard(ClientMessage message, Session session)
+        {
+            if (!VehicleManager.Enabled) return;
+            if (VehicleWire.ReadC2S(VehicleWire.OpBoard, message.Payload) is VehicleBoard msg)
+                VehicleManager.HandleBoard(session, msg);
+        }
+
+        [GameAction(GameActionType.VehicleExit)]
+        public static void HandleExit(ClientMessage message, Session session)
+        {
+            if (VehicleWire.ReadC2S(VehicleWire.OpExit, message.Payload) is VehicleExit msg)
+                VehicleManager.HandleExit(session, msg);
+        }
+
+        [GameAction(GameActionType.VehicleInput)]
+        public static void HandleInput(ClientMessage message, Session session)
+        {
+            if (!VehicleManager.Enabled) return;
+            if (VehicleWire.ReadC2S(VehicleWire.OpInput, message.Payload) is VehicleInput msg)
+                VehicleManager.HandleInput(session, msg);
+        }
+    }
+}
