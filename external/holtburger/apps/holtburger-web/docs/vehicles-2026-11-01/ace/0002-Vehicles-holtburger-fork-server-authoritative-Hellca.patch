+        // ================================================================ spawn / despawn
+
+        public static Vehicle Spawn(Player by, VehicleProfile profile, out string error)
+        {
+            error = null;
+            if (!Enabled) { error = "vehicles_enabled is off (@modifybool vehicles_enabled true)"; return null; }
+            if (by.Location.Indoors) { error = "outdoors only"; return null; }
+
+            var (px, py, _) = Vehicle.ToGlobal(by.Location);
+            var heading = HeadingOf(by.Location.Rotation);
+            // 6 m ahead: clear of the caller, inside the 8 m boarding range
+            var gx = px + 6.0 * Math.Sin(heading);
+            var gy = py + 6.0 * Math.Cos(heading);
+            var gz = VehicleTerrain.Ground(gx, gy);
+            if (double.IsNaN(gz)) { error = "no terrain there"; return null; }
+
+            var guid = GuidManager.NewDynamicGuid();
+            var v = new Vehicle(Vehicle.BuildWeenie(profile), guid, profile);
+            v.State = new FlightState { X = gx, Y = gy, Z = gz, Heading = FlightModel.WrapHeading(heading), Mode = VehicleMode.Parked };
+            v.VCap = SpeedCap;
+            v.SpawnedBy = by.Guid.Full;
+            v.Location = v.VehiclePosition();
+            if (!v.EnterWorld())
+            {
+                GuidManager.RecycleDynamicGuid(guid);
+                error = "EnterWorld failed (placement)";
+                return null;
+            }
+            vehicles[guid.Full] = v;
+            log.Info($"[VEHICLE] {by.Name} spawned {profile.Key} 0x{guid.Full:X8} at {v.Location.ToLOCString()}");
+            return v;
+        }
+
+        public static void Despawn(Vehicle v, string why)
+        {
+            if (!vehicles.Remove(v.Guid.Full))
+                return;
+            for (var i = 0; i < v.SeatOccupants.Length; i++)
+            {
+                var occ = v.SeatOccupants[i] != 0 ? PlayerManager.GetOnlinePlayer(v.SeatOccupants[i]) : null;
+                if (occ != null)
+                    Unseat(v, occ, placeOnGround: true);
+                else if (v.SeatOccupants[i] != 0)
+                {
+                    seated.Remove(v.SeatOccupants[i]);
+                    v.SeatOccupants[i] = 0;
+                }
+            }
+            if (v.PhysicsObj != null)
+                BroadcastEvent(v, VehicleEventKind.Despawn, 0, 0f);
+            log.Info($"[VEHICLE] despawn {v.Name} 0x{v.Guid.Full:X8} ({why})");
+            if (!v.IsDestroyed)
+                v.Destroy();
+        }
+
+        public static double HeadingOf(Quaternion q)
+        {
+            var fwd = Vector3.Transform(Vector3.UnitY, q);
+            return FlightModel.WrapHeading(Math.Atan2(fwd.X, fwd.Y));
+        }
+
+        // ================================================================ costs (@vehicles)
+
+        public static string CostReport()
+        {
+            var sb = new StringBuilder();
+            var now = DateTime.UtcNow;
+            sb.AppendLine(VehicleStreaming.Report() + $"; sight radius {SightRadius:0.#} m; " + VehicleBailout.Report());
+            sb.AppendLine($"wide-sight visibility: {VisCalls} cell changes, worst gather+admit {VisMaxHandleMs:0.0} ms, worst CreateObjects {VisMaxEnqueueMs:0.0} ms, most new per call {VisMaxNew}, deferred {Physics.Common.ObjectMaint.WideSightDeferred}; worst single CreateObject {CoWorstMs:0.0} ms ({CoWorstDesc}), >=20 ms {CoOver20Ms}");
+            sb.AppendLine(LandblockManager.LockReport());
+            sb.AppendLine(WorldTickMonitor.Report() + $"; warm-up {(double.IsNaN(WarmupMs) ? "pending" : $"{WarmupMs:0} ms")}");
+            sb.AppendLine($"vehicles: {vehicles.Count} active, enabled={Enabled}, cap={SpeedCap:0.#} m/s, wake={PropertyManager.GetBool("landblock_wake_on_entry", false).Item}; " +
+                $"steps {TotalSteps}, landblock loads {TotalLandblockLoads}, tick {LastTickMicros:0} us (max {MaxTickMicros:0}), terrain cache {VehicleTerrain.CachedLandblocks} lb");
+            foreach (var v in vehicles.Values)
+            {
+                var pilot = PilotOf(v);
+                var c = v.Costs;
+                var known = pilot?.PhysicsObj?.ObjMaint.GetKnownObjectsValues().Count ?? 0;
+                var age = Math.Max(1.0, (now - v.SpawnedUtc).TotalSeconds);
+                sb.AppendLine($"0x{v.Guid.Full:X8} {v.Profile.Key} {VehicleMode.Name(v.State.Mode)} at {v.Location.ToLOCString()} " +
+                    $"speed {v.State.Speed:0.0} m/s ({v.State.Speed * 3.6:0} km/h) agl {v.State.Z - VehicleTerrain.Ground(v.State.X, v.State.Y):0.0} m");
+                sb.AppendLine($"   pilot {(pilot != null ? pilot.Name : "-")} | steps {c.Steps} avg {(c.Steps > 0 ? c.StepMicrosTotal / c.Steps : 0):0.0} us max {c.StepMicrosMax:0} us" +
+                    $" | lb loads {c.LandblockLoads} (60s: {c.LoadsLast60s(now)}) | input depth {v.Input.Depth} subst {v.Input.Substituted} late {v.Input.LateDropped} dup {v.Input.Duplicates} reanchor {v.Input.Reanchors} stalls {v.Stalls} catchups {v.CatchUps} debt {v.StepDebt}" +
+                    $" | pilot knows {known} objs | {c.MessagesSent} msgs {c.BytesSent / age:0} B/s | bolts {c.BoltsFired} hits {c.BoltsHit} ammo {v.Ammo}");
+                var ws = c.WarnSamples.OrderBy(x => x).ToList();
+                sb.AppendLine($"   first sight (server, in flight): {c.FirstSights} objects, ahead {(c.FirstSights > 0 ? 100.0 * c.FirstSightsAhead / c.FirstSights : 0):0}%, " +
+                    $">=1 s warning {(c.FirstSights > 0 ? 100.0 * c.FirstSightsOver1s / c.FirstSights : 0):0}%, median warning {(ws.Count > 0 ? ws[ws.Count / 2] : 0):0.00} s, mean distance {(c.FirstSights > 0 ? c.FirstSightDistTotal / c.FirstSights : 0):0} m");
+                sb.AppendLine($"   tick max {c.TickMsMax:0.0} ms, stalls>50ms {c.Stalls50} | relocations {c.Relocations} avg {(c.Relocations > 0 ? c.RelocateMsTotal / c.Relocations : 0):0.0} ms max {c.RelocateMsMax:0.0} ms" +
+                    $" | loads on arrival {c.LandblockLoads} (avg {(c.LandblockLoads > 0 ? c.LoadMsTotal / Math.Max(1, c.LandblockLoads) : 0):0.0} ms/lb, max call {c.LoadMsMax:0.0} ms)" +
+                    $" | preloads {v.Stream.Preloads} (max {v.Stream.PreloadMsMax:0.0} ms; construct {v.Stream.ConstructMsTotal / Math.Max(1, v.Stream.Preloads):0.0} / init {v.Stream.InitMsTotal / Math.Max(1, v.Stream.Preloads):0.0} ms avg) lead {v.Stream.LeadSeconds:0.0} s back-pressure {v.BackPressure} ({v.Stream.BackPressureEvents} events) vCap {v.VCap:0.#}");
+            }
+            return sb.ToString();
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/VehicleProfile.cs b/Source/ACE.Server/Vehicles/VehicleProfile.cs
new file mode 100644
index 0000000..cf51f5d
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleProfile.cs
@@ -0,0 +1,118 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// A vehicle TYPE as data (DESIGN.md §3.2). Only the locomotion class is code (FlightModel for Air).
+    /// v1 keeps the profiles in code (one demo profile); they move to weenie properties with the economy layer.
+    /// </summary>
+    public sealed class VehicleProfile
+    {
+        public string Key = "";
+        public string DisplayName = "";
+        public uint Locomotion = 1; // Air
+
+        /// <summary>The base-DAT Setup every client (retail included) is sent in CreateObject.</summary>
+        public uint StandInSetup;
+        public float StandInScale = 1.0f;
+
+        // movement (SI units, radians)
+        public float VMin, VCruise, VMax, Accel, Decel;
+        public float MaxBank, RollRate, MaxPitch, PitchRate, YawRate;
+        public float ClimbMax, SinkMax, FloorAgl, CeilingAgl, TakeoffClimb, LandingSpeed;
+
+        // client streaming while seated
+        public float LeadSeconds = 6f;
+        public uint ObjectRadius = 4;
+
+        // server streaming (M3)
+        public float SightRadius = 112.5f;
+        public float PreloadSeconds = 6f;
+        public float MaxLandblockLoadsPerSec = 4f;
+
+        public List<VehicleSeatDef> Seats = new List<VehicleSeatDef>();
+        public List<VehicleWeaponDef> Weapons = new List<VehicleWeaponDef>();
+        public List<VehiclePartDef> Parts = new List<VehiclePartDef>();
+
+        public const uint MotionSitting = 0x41000013;
+
+        static float Deg(double d) => (float)(d * Math.PI / 180.0);
+
+        /// <summary>
+        /// The Hellcat-type demo fighter (DESIGN.md §3.4). Speeds: 108 / 300 / 350 km/h; the server's
+        /// vehicle_speed_cap property (69 m/s = 250 km/h until M3) caps them.
+        /// </summary>
+        public static VehicleProfile HellcatDemo()
+        {
+            var p = new VehicleProfile
+            {
+                Key = "hellcat-demo",
+                DisplayName = "Hellcat",
+                Locomotion = 1,
+                // Retail stand-in: the Drudge Balloon (wcid 35580's Setup), the only flying-vehicle model in the base DATs.
+                // Scaled so the balloon reads as "a craft in the sky" without swallowing the seated pilot (decision log).
+                StandInSetup = 0x020016F1,
+                StandInScale = 0.3f,
+                // vMax 111 m/s (400 km/h, boost): the M3 bench speed; the server's vehicle_speed_cap still caps it
+                // (69 m/s = 250 km/h until M3). Design §3.4 had 97 (350 km/h) — decisions log.
+                VMin = 30f, VCruise = 83f, VMax = 111f,
+                Accel = 8f, Decel = 12f,
+                MaxBank = Deg(60), RollRate = Deg(90),
+                MaxPitch = Deg(25), PitchRate = Deg(45),
+                YawRate = Deg(10),
+                ClimbMax = 20f, SinkMax = 25f,
+                FloorAgl = 30f, CeilingAgl = 450f,
+                TakeoffClimb = 8f, LandingSpeed = 25f,
+                LeadSeconds = 6f, ObjectRadius = 4,
+                SightRadius = 112.5f, PreloadSeconds = 6f, MaxLandblockLoadsPerSec = 4f,
+            };
+            p.Seats.Add(new VehicleSeatDef { Role = 0, Motion = MotionSitting, Offset = new Vector3(0f, -0.5f, 0.6f) });
+            p.Weapons.Add(new VehicleWeaponDef
+            {
+                Kind = 1, RoundsPerSecond = 8f, Spread = Deg(1.5), Range = 120f, Damage = 12f, Magazine = 200,
+                Muzzle = new Vector3(0f, 4f, 0.5f),
+            });
+            // Looks as data (DESIGN §5.1 rule 2): a placeholder composite of retail parts. v1 = the stand-in itself;
+            // the composite airframe replaces it in M5 without a protocol change.
+            p.Parts.Add(new VehiclePartDef { Did = p.StandInSetup, Offset = Vector3.Zero, Rotation = Quaternion.Identity, Scale = p.StandInScale });
+            return p;
+        }
+
+        public static VehicleProfile ByKey(string key)
+        {
+            switch ((key ?? "").ToLowerInvariant())
+            {
+                case "":
+                case "hellcat":
+                case "hellcat-demo":
+                    return HellcatDemo();
+                default:
+                    return null;
+            }
+        }
+
+        /// <summary>The profile as sent to capable clients. The client's predictor uses exactly these (f32) numbers.</summary>
+        public VehicleProfileMsg ToMsg(uint vehicleGuid, float speedCap, ushort simHz)
+        {
+            return new VehicleProfileMsg
+            {
+                Vehicle = vehicleGuid,
+                ProfileKey = Key,
+                DisplayName = DisplayName,
+                Locomotion = Locomotion,
+                StandInSetup = StandInSetup,
+                SimHz = simHz,
+                VMin = VMin, VCruise = VCruise, VMax = VMax, SpeedCap = speedCap,
+                Accel = Accel, Decel = Decel, MaxBank = MaxBank, RollRate = RollRate, MaxPitch = MaxPitch,
+                PitchRate = PitchRate, YawRate = YawRate, ClimbMax = ClimbMax, SinkMax = SinkMax,
+                FloorAgl = FloorAgl, CeilingAgl = CeilingAgl, TakeoffClimb = TakeoffClimb, LandingSpeed = LandingSpeed,
+                LeadSeconds = LeadSeconds, ObjectRadius = ObjectRadius,
+                Seats = new List<VehicleSeatDef>(Seats),
+                Weapons = new List<VehicleWeaponDef>(Weapons),
+                Parts = new List<VehiclePartDef>(Parts),
+            };
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/VehicleStreaming.cs b/Source/ACE.Server/Vehicles/VehicleStreaming.cs
new file mode 100644
index 0000000..d57c74c
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleStreaming.cs
@@ -0,0 +1,613 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Threading;
+using System.Threading.Tasks;
+
+using log4net;
+
+using ACE.DatLoader;
+using ACE.DatLoader.FileTypes;
+using ACE.Entity;
+using ACE.Server.Entity;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// Streaming ahead of fast vehicles (DESIGN.md §4.5, milestone M3).
+    ///
+    /// * Preload: each tick, the landblocks of a corridor along the velocity (0..PreloadSeconds ahead, the 3×3 around
+    ///   each point — a landblock crossing relocates with loadAdjacents, so the whole band must exist) that are not
+    ///   loaded are loaded EARLY and ONE AT A TIME: at most one landblock per world tick across all vehicles, at most
+    ///   the profile's MaxLandblockLoadsPerSec per vehicle and a global per-second cap. Their DAT records (CellLandblock,
+    ///   LandblockInfo, EnvCells) are read off-thread first (the DAT cache is concurrent), so the world-thread load
+    ///   finds them warm. v2 (vehicle_preload_offthread): ACE's own GetLandblock on a background task, started once the
+    ///   warm-up is done; LandblockManager keeps the world thread from waiting on it (read-lock fast path that never
+    ///   hands out an initializing landblock; group additions / unloads retried next tick while a load holds the lock).
+    /// * Back-pressure: when the first unloaded corridor landblock is less than 2 s ahead, the vehicle's speed cap is
+    ///   lowered (the pilot sees "engine strain"); it is released once the lead is back above 3 s. The world never
+    ///   stalls to keep one vehicle fast.
+    /// * Retention: landblocks a vehicle caused to load are marked vehicle-only and unload after 60 s instead of
+    ///   ACE's 5 min, until a player on foot enters one.
+    /// Behind server properties: vehicle_preload, vehicle_short_retention (default off).
+    /// </summary>
+    public static class VehicleStreaming
+    {
+        static readonly ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
+
+        public static bool PreloadEnabled => PropertyManager.GetBool("vehicle_preload", false).Item;
+        public static bool ShortRetention => PropertyManager.GetBool("vehicle_short_retention", false).Item;
+
+        /// <summary>
+        /// vehicle_landblock_budget: a landblock only vehicles have been in brings its objects in within a shared per-world-tick
+        /// budget (Landblock.AddCreatedWorldObjects), and its loot generators wait for a player on foot (Landblock tick).
+        /// </summary>
+        public static bool LandblockBudget => PropertyManager.GetBool("vehicle_landblock_budget", false).Item;
+        public const double BringUpBudgetMs = 8.0;
+        static long bringUpTicksUsed;
+        public static long BringUpChunks, LootGeneratorsDeferred, LootGeneratorsRestored;
+
+        /// <summary>World thread, start of each world tick.</summary>
+        public static void ResetBringUpBudget() => Interlocked.Exchange(ref bringUpTicksUsed, 0);
+        public static bool BringUpBudgetLeft() => Interlocked.Read(ref bringUpTicksUsed) < (long)(BringUpBudgetMs * Stopwatch.Frequency / 1000.0);
+        public static void ChargeBringUp(long ticks) => Interlocked.Add(ref bringUpTicksUsed, ticks);
+
+        // a generator power-up's slice of the per-tick budget (WorldObject.GeneratorRegeneration → Generator_Generate).
+        // Only the generator whose regeneration opened the slice can yield: every other Generator_Generate (a container's
+        // StartGenerator, use, emotes, a nested power-up of something it spawned) runs ACE's loop unchanged.
+        [ThreadStatic] static WorldObject sliceOwner;
+        [ThreadStatic] static long sliceStart, sliceTicks;
+        [ThreadStatic] static bool sliceYielded;
+        public static long PowerUpYields;
+
+        public static void BeginPowerUpSlice(WorldObject generator)
+        {
+            sliceYielded = false;
+            sliceOwner = null;
+            var lb = generator.CurrentLandblock;
+            if (lb == null || !lb.VehicleOnly || !LandblockBudget)
+                return;
+            sliceTicks = Math.Max(0, (long)(BringUpBudgetMs * Stopwatch.Frequency / 1000.0) - Interlocked.Read(ref bringUpTicksUsed));
+            sliceStart = Stopwatch.GetTimestamp();
+            sliceOwner = generator;
+        }
+
+        public static bool PowerUpSliceSpent(WorldObject generator)
+        {
+            if (sliceOwner == null || !ReferenceEquals(sliceOwner, generator) || Stopwatch.GetTimestamp() - sliceStart < sliceTicks)
+                return false;
+            sliceYielded = true;
+            Interlocked.Increment(ref PowerUpYields);
+            return true;
+        }
+
+        public static bool EndPowerUpSlice()
+        {
+            var yielded = sliceYielded;
+            sliceYielded = false;
+            sliceOwner = null;
+            return yielded;
+        }
+
+        public static long CellsPrewarmed, CellPrewarmLandblocks;
+        public static double CellPrewarmMsTotal, CellPrewarmMsMax;
+
+        /// <summary>Build every indoor cell (EnvCell + its static objects) of a landblock a vehicle background load just loaded.</summary>
+        public static void PrewarmCells(Landblock lb)
+        {
+            var info = lb.LandblockInfo;
+            if (lb.IsDungeon || info == null || info.NumCells == 0)
+                return;
+            var sw = Stopwatch.StartNew();
+            var baseId = lb.Id.Raw & 0xFFFF0000;
+            for (uint i = 0; i < info.NumCells; i++)
+                ACE.Server.Physics.Common.LScape.get_landcell(baseId | (0x100 + i));
+            var ms = sw.Elapsed.TotalMilliseconds;
+            lock (statsLock)
+            {
+                CellPrewarmLandblocks++;
+                CellsPrewarmed += info.NumCells;
+                CellPrewarmMsTotal += ms;
+                if (ms > CellPrewarmMsMax) CellPrewarmMsMax = ms;
+            }
+        }
+
+        /// <summary>
+        /// A vehicle-only landblock loaded outside the corridor loader (the pilot's relocation, a neighbour touched from
+        /// another landblock's tick) warms its spawn caches on a background task; its generators wait for it.
+        /// </summary>
+        public static void WarmSpawnsAsync(Landblock lb)
+        {
+            lb.SpawnWarmupPending = true;
+            Interlocked.Increment(ref LateWarmups);
+            Task.Run(async () =>
+            {
+                try
+                {
+                    await WarmSpawns((ushort)(lb.Id.Raw >> 16)).ConfigureAwait(false);
+                }
+                catch (Exception e)
+                {
+                    log.Debug($"[VEHICLE] spawn warm-up {lb.Id.Raw >> 16:X4} failed: {e.Message}");
+                }
+                finally
+                {
+                    lb.SpawnWarmupPending = false;
+                }
+            });
+        }
+        public static long LateWarmups;
+
+        public static void NoteHeavyAdd(WorldObject wo, long ticks, string what)
+        {
+            var ms = ticks * 1000.0 / Stopwatch.Frequency;
+            if (ms < 30.0)
+                return;
+            if (Interlocked.Increment(ref heavyAddLogs) <= 30)
+                log.Warn($"[VEHICLE][HEAVYADD] {what} {wo.Name} 0x{wo.Guid.Full:X8} wcid {wo.WeenieClassId} {wo.WeenieType} took {ms:0.0} ms in landblock {wo.CurrentLandblock?.Id.Raw >> 16:X4}");
+        }
+        static int heavyAddLogs;
+
+        public static long LootProfilesDeferred;
+
+        /// <summary>A loot profile (treasure / container / shop) of a generator in a vehicle-only landblock: hold its queue.</summary>
+        public static bool DeferLootProfile(GeneratorProfile profile)
+        {
+            var lb = profile.Generator?.CurrentLandblock;
+            if (lb == null || !lb.VehicleOnly || !LandblockBudget)
+                return false;
+            if ((profile.RegenLocationType & (ACE.Entity.Enum.RegenLocationType.Contain | ACE.Entity.Enum.RegenLocationType.Shop | ACE.Entity.Enum.RegenLocationType.Treasure)) == 0)
+                return false;
+            if (lb.DeferLootProfile(profile))
+                Interlocked.Increment(ref LootProfilesDeferred);
+            return true;
+        }
+
+        /// <summary>A generator whose every profile puts loot somewhere (into a container, a shop, or treasure rolls).</summary>
+        public static bool IsLootGenerator(WorldObject g)
+        {
+            var profiles = g.GeneratorProfiles;
+            if (profiles == null || profiles.Count == 0)
+                return false;
+            var any = false;
+            foreach (var p in profiles)
+            {
+                if (p.IsPlaceholder)
+                    continue;
+                if ((p.RegenLocationType & (ACE.Entity.Enum.RegenLocationType.Contain | ACE.Entity.Enum.RegenLocationType.Shop | ACE.Entity.Enum.RegenLocationType.Treasure)) == 0)
+                    return false;
+                any = true;
+            }
+            return any;
+        }
+        /// <summary>v2: build corridor landblocks (constructor + physics PostInit) off the world thread, publish on it.</summary>
+        public static bool OffThread => PropertyManager.GetBool("vehicle_preload_offthread", false).Item;
+        const int MaxBuildsInFlight = 2;
+        static readonly ConcurrentDictionary<ushort, Task> builds = new ConcurrentDictionary<ushort, Task>();
+        public static long OffThreadBuilds, Published, Discarded, BuildFailures;
+        public static double PublishMsMax, PublishMsTotal, BuildMsMax, BuildMsTotal;
+
+        public const double CorridorStepSeconds = 0.5;
+        public const int GlobalLoadsPerSecond = 6;
+        public const double BackPressureLeadSeconds = 2.0;
+        public const double BackPressureReleaseSeconds = 3.0;
+        public static readonly TimeSpan VehicleOnlyUnloadInterval = TimeSpan.FromSeconds(60);
+
+        static int loadsThisTick;
+        static readonly Queue<DateTime> globalLoads = new Queue<DateTime>();
+        static readonly ConcurrentDictionary<ushort, Task> prefetch = new ConcurrentDictionary<ushort, Task>();
+
+        // global counters
+        public static long Preloads, PrefetchesStarted, PrefetchesWarm;
+        public static double PreloadMsMax, PreloadMsTotal;
+
+        public static void BeginTick()
+        {
+            loadsThisTick = 0;
+            LandblockManager.FastLookup = PreloadEnabled && OffThread;
+        }
+
+        static ushort Key(int lbx, int lby) => (ushort)((lbx << 8) | lby);
+
+        static LandblockId IdOf(ushort key) => new LandblockId((uint)key << 16 | 0xFFFF);
+
+        /// <summary>Off-thread DAT warm-up for a landblock the corridor will need.</summary>
+        static void Prefetch(ushort key)
+        {
+            if (prefetch.ContainsKey(key))
+                return;
+            PrefetchesStarted++;
+            // the DAT warm-up (fast) gates the background load; the spawn-cache warm-up (DB, one at a time) follows it and
+            // gates only the landblock's generators (Landblock.SpawnWarmupPending), never the load itself
+            var dat = Task.Run(() =>
+            {
+                DatDatabase.BackgroundReaderThread = true;
+                try
+                {
+                    var id = (uint)key << 16;
+                    DatManager.CellDat.ReadFromDat<CellLandblock>(id | 0xFFFF);
+                    var info = DatManager.CellDat.ReadFromDat<LandblockInfo>(id | 0xFFFE);
+                    if (info != null)
+                        for (uint i = 0; i < info.NumCells; i++)
+                            DatManager.CellDat.ReadFromDat<EnvCell>(id | (0x100 + i));
+                }
+                catch (Exception e)
+                {
+                    log.Debug($"[VEHICLE] prefetch {key:X4} failed: {e.Message}");
+                }
+                finally
+                {
+                    DatDatabase.BackgroundReaderThread = false;
+                }
+            });
+            prefetch[key] = dat;
+            spawnWarmups[key] = dat.ContinueWith(async _ =>
+            {
+                try
+                {
+                    await WarmSpawns(key).ConfigureAwait(false);
+                }
+                catch (Exception e)
+                {
+                    log.Debug($"[VEHICLE] spawn warm-up {key:X4} failed: {e.Message}");
+                }
+            }, TaskScheduler.Default).Unwrap();
+            if (prefetch.Count > 4096)
+            {
+                prefetch.Clear();
+                spawnWarmups.Clear();
+            }
+        }
+
+        static readonly ConcurrentDictionary<ushort, Task> spawnWarmups = new ConcurrentDictionary<ushort, Task>();
+
+        /// <summary>
+        /// At construction of a landblock a vehicle background load is loading: its generators wait for its spawn-cache
+        /// warm-up if that is still running (or start one if the corridor never prefetched it).
+        /// </summary>
+        public static void MarkSpawnWarmup(Landblock lb)
+        {
+            if (!LandblockBudget)
+                return;
+            var key = (ushort)(lb.Id.Raw >> 16);
+            if (!spawnWarmups.TryGetValue(key, out var warm))
+            {
+                WarmSpawnsAsync(lb);
+                return;
+            }
+            if (warm.IsCompleted)
+                return;
+            lb.SpawnWarmupPending = true;
+            warm.ContinueWith(_ => lb.SpawnWarmupPending = false, TaskScheduler.Default);
+        }
+
+        public static long WeeniesWarmed, WarmupLandblocks;
+        public static double WarmupMsTotal, WarmupMsMax;
+
+        /// <summary>
+        /// World-DB and DAT caches for everything the landblock will create and spawn: its instances' and region encounters' weenies, their
+        /// generator profiles and create lists (recursively, each weenie once per process), wielded / death treasure tables,
+        /// and each weenie's Setup and MotionTable. Without it the landblock's first generator spawns fetch cold weenies on the
+        /// world tick — 40-90 ms per spawn under load (benches m3-h..k: ~110 world ticks over 50 ms per 400 km/h flight,
+        /// all in the landblock tick, 95 % of the spawn time in WorldObjectFactory). Same caches ACE fills from
+        /// CreateWorldObjects' own background task; the DB layer opens a context per query.
+        /// </summary>
+        static async Task WarmSpawns(ushort key)
+        {
+            // one warm-up at a time (its DB work — ACE + mysqld — otherwise competes with everything else for the cores);
+            // waiting holds no thread
+            await warmupGate.WaitAsync().ConfigureAwait(false);
+            var flag = DatDatabase.BackgroundReaderThread;
+            DatDatabase.BackgroundReaderThread = true;
+            try
+            {
+                WarmSpawnsGated(key);
+            }
+            finally
+            {
+                DatDatabase.BackgroundReaderThread = flag;
+                warmupGate.Release();
+            }
+        }
+
+        static readonly SemaphoreSlim warmupGate = new SemaphoreSlim(1, 1);
+
+        static void WarmSpawnsGated(ushort key)
+        {
+            var sw = Stopwatch.StartNew();
+            var seen = new HashSet<uint>(); // this walk's cycle guard; warmedWeenies = subtrees finished by any walk
+            var before = warmedWeenies.Count;
+            var instances = ACE.Database.DatabaseManager.World.GetCachedInstancesByLandblock(key);
+            if (instances != null)
+                foreach (var inst in instances)
+                    WarmWeenie(inst.WeenieClassId, seen, 0);
+            // region encounters (Landblock.SpawnEncounters): most outdoor monster generators come from these, not from
+            // the landblock's instances (m3-n: the cold spawns were "Newbie / Low A Aluvian" encounter generators)
+            var encounters = ACE.Database.DatabaseManager.World.GetCachedEncountersByLandblock(key);
+            if (encounters != null)
+                foreach (var enc in encounters)
+                    WarmWeenie(enc.WeenieClassId, seen, 0);
+            var ms = sw.Elapsed.TotalMilliseconds;
+            lock (statsLock)
+            {
+                WarmupLandblocks++;
+                WeeniesWarmed += warmedWeenies.Count - before;
+                WarmupMsTotal += ms;
+                if (ms > WarmupMsMax) WarmupMsMax = ms;
+            }
+        }
+
+        /// <summary>Weenies whose whole spawn tree is cached (marked when its walk FINISHES, so a concurrent walk never
+        /// skips a subtree still being fetched; process lifetime).</summary>
+        static readonly ConcurrentDictionary<uint, byte> warmedWeenies = new ConcurrentDictionary<uint, byte>();
+
+        static void WarmWeenie(uint wcid, HashSet<uint> seen, int depth)
+        {
+            if (wcid == 0 || depth > 4 || warmedWeenies.ContainsKey(wcid) || !seen.Add(wcid))
+                return;
+            WarmWeenieTree(wcid, seen, depth);
+            warmedWeenies.TryAdd(wcid, 0);
+        }
+
+        static void WarmWeenieTree(uint wcid, HashSet<uint> seen, int depth)
+        {
+            var w = ACE.Database.DatabaseManager.World.GetCachedWeenie(wcid);
+            if (w == null)
+                return;
+            if (w.PropertiesGenerator != null)
+                foreach (var g in w.PropertiesGenerator)
+                {
+                    if (g.WhereCreate.HasFlag(ACE.Entity.Enum.RegenLocationType.Treasure))
+                        ACE.Database.DatabaseManager.World.GetCachedDeathTreasure(g.WeenieClassId);
+                    else
+                        WarmWeenie(g.WeenieClassId, seen, depth + 1);
+                }
+            if (w.PropertiesCreateList != null)
+                foreach (var c in w.PropertiesCreateList)
+                    WarmWeenie(c.WeenieClassId, seen, depth + 1);
+            var dids = w.PropertiesDID;
+            if (dids == null)
+                return;
+            if (dids.TryGetValue(ACE.Entity.Enum.Properties.PropertyDataId.WieldedTreasureType, out var wielded))
+            {
+                var list = ACE.Database.DatabaseManager.World.GetCachedWieldedTreasure(wielded);
+                if (list != null)
+                    foreach (var t in list)
+                        WarmWeenie(t.WeenieClassId, seen, depth + 1);
+            }
+            if (dids.TryGetValue(ACE.Entity.Enum.Properties.PropertyDataId.DeathTreasureType, out var death))
+                ACE.Database.DatabaseManager.World.GetCachedDeathTreasure(death);
+            if (dids.TryGetValue(ACE.Entity.Enum.Properties.PropertyDataId.Setup, out var setupId))
+                DatManager.PortalDat.ReadFromDat<SetupModel>(setupId);
+            if (dids.TryGetValue(ACE.Entity.Enum.Properties.PropertyDataId.MotionTable, out var motionTable))
+                DatManager.PortalDat.ReadFromDat<MotionTable>(motionTable);
+        }
+
+        /// <summary>Per piloted vehicle, after its steps this tick.</summary>
+        public static void Tick(Vehicle v, Player pilot)
+        {
+            if (pilot == null || !PreloadEnabled)
+            {
+                v.Stream.LeadSeconds = double.NaN;
+                ReleaseBackPressure(v);
+                return;
+            }
+            var mode = v.State.Mode;
+            if (mode != VehicleMode.Flight && mode != VehicleMode.Takeoff && mode != VehicleMode.Landing)
+            {
+                v.Stream.LeadSeconds = double.NaN;
+                ReleaseBackPressure(v);
+                return;
+            }
+            var vel = v.WorldVelocity();
+            var horiz = Math.Sqrt(vel.X * vel.X + vel.Y * vel.Y);
+
+            // the corridor, nearest first
+            var targets = v.Stream.Targets;
+            targets.Clear();
+            var seen = v.Stream.Seen;
+            seen.Clear();
+            var horizon = Math.Max(1.0, v.Profile.PreloadSeconds);
+            for (var t = 0.0; t <= horizon + 1e-9; t += CorridorStepSeconds)
+            {
+                var px = v.State.X + vel.X * t;
+                var py = v.State.Y + vel.Y * t;
+                var lbx = (int)Math.Floor(px / 192.0);
+                var lby = (int)Math.Floor(py / 192.0);
+                for (var dx = -1; dx <= 1; dx++)
+                    for (var dy = -1; dy <= 1; dy++)
+                    {
+                        int x = lbx + dx, y = lby + dy;
+                        if (x < 0 || y < 0 || x > 254 || y > 254) continue;
+                        var k = Key(x, y);
+                        if (seen.Add(k))
+                            targets.Add((k, t));
+                    }
+                if (horiz < 1.0) break; // hovering / vertical: the 3×3 is enough
+            }
+
+            // lead: time to the first corridor landblock that is not loaded yet
+            var lead = double.PositiveInfinity;
+            ushort next = 0;
+            var haveNext = false;
+            foreach (var (k, t) in targets)
+            {
+                if (LandblockManager.IsLoaded(IdOf(k)))
+                    continue;
+                Prefetch(k);
+                if (t < lead) lead = t;
+                if (!haveNext) { next = k; haveNext = true; }
+            }
+            v.Stream.LeadSeconds = lead;
+
+            if (OffThread)
+            {
+                // v2: load the nearest missing corridor landblocks on background tasks (≤ 2 in flight)
+                CollectFinished(v);
+                foreach (var (k, t) in targets)
+                {
+                    if (builds.Count >= MaxBuildsInFlight) break;
+                    if (builds.ContainsKey(k) || LandblockManager.IsLoaded(IdOf(k))) continue;
+                    var key = k;
+                    // start the load once its DAT warm-up has finished: the constructor runs under ACE's landblock WRITE
+                    // lock (every world-thread lookup waits for it), so it must find its records cached
+                    builds[key] = prefetch.TryGetValue(key, out var warmup) && !warmup.IsCompleted
+                        ? warmup.ContinueWith(_ => Load(key), TaskScheduler.Default)
+                        : Task.Run(() => Load(key));
+                    OffThreadBuilds++;
+                }
+            }
+            // budgeted synchronous load of the nearest missing landblock (v1; under v2 only when the corridor is short:
+            // the vehicle is about to arrive and no build can finish in time)
+            else if (haveNext && loadsThisTick == 0 && v.Stream.TryTakeToken(v.Profile.MaxLandblockLoadsPerSec) && GlobalTokenAvailable())
+            {
+                var warm = prefetch.TryGetValue(next, out var task) && task.IsCompleted;
+                // prefer to wait (up to ~0.5 s of lead margin) for the off-thread warm-up when there is time
+                if (warm || lead <= horizon * 0.5)
+                {
+                    var sw = Stopwatch.StartNew();
+                    var lb = LandblockManager.GetLandblock(IdOf(next), false);
+                    var ms = sw.Elapsed.TotalMilliseconds;
+                    lb.VehicleOnly = true;
+                    loadsThisTick++;
+                    globalLoads.Enqueue(DateTime.UtcNow);
+                    Preloads++;
+                    if (warm) PrefetchesWarm++;
+                    PreloadMsTotal += ms;
+                    if (ms > PreloadMsMax) PreloadMsMax = ms;
+                    v.Stream.Preloads++;
+                    v.Stream.PreloadMsTotal += ms;
+                    if (ms > v.Stream.PreloadMsMax) v.Stream.PreloadMsMax = ms;
+                    v.Stream.ConstructMsTotal += LandblockManager.LastLoadConstructMs;
+                    v.Stream.InitMsTotal += LandblockManager.LastLoadInitMs;
+                    if (ms > 50)
+                        log.Warn($"[VEHICLE][PRELOAD] landblock {next:X4} took {ms:0.0} ms (warm={warm}; construct {LandblockManager.LastLoadConstructMs:0.0} ms, init {LandblockManager.LastLoadInitMs:0.0} ms)");
+                }
+                else
+                    v.Stream.TokenRefund();
+            }
+
+            // back-pressure
+            var cap = (float)VehicleManager.SpeedCap;
+            if (lead < BackPressureLeadSeconds)
+            {
+                // lower the cap toward 85 % of the current speed each tick (never below vMin): "engine strain"
+                var lowered = (float)Math.Max(v.Params.VMin, Math.Min(v.State.Speed * 0.85, v.BackPressureCap));
+                if (!v.BackPressure)
+                {
+                    VehicleManager.BackPressureEvents++;
+                    v.Stream.BackPressureEvents++;
+                }
+                v.BackPressure = true;
+                v.BackPressureCap = lowered;
+            }
+            else if (v.BackPressure && lead >= BackPressureReleaseSeconds)
+                ReleaseBackPressure(v);
+            v.VCap = v.BackPressure ? Math.Min(cap, v.BackPressureCap) : cap;
+        }
+
+        /// <summary>
+        /// v2: ACE's own lock-protected GetLandblock (constructor + physics PostInit + the usual off-thread object
+        /// creation), run on a background task — the same path ACE's parallel landblock groups take when physics
+        /// reaches an unloaded landblock. The world thread never pays for a corridor landblock.
+        /// </summary>
+        static void Load(ushort key)
+        {
+            var sw = Stopwatch.StartNew();
+            LandblockManager.IsVehicleLoaderThread = true;
+            DatDatabase.BackgroundReaderThread = true;
+            Interlocked.Increment(ref LoadsActive);
+            try
+            {
+                LandblockManager.GetLandblock(IdOf(key), false);
+                var ms = sw.Elapsed.TotalMilliseconds;
+                lock (statsLock)
+                {
+                    BuildMsTotal += ms;
+                    if (ms > BuildMsMax) BuildMsMax = ms;
+                }
+            }
+            catch (Exception e)
+            {
+                BuildFailures++;
+                log.Warn($"[VEHICLE][LOAD] landblock {key:X4} off-thread load failed: {e.Message}");
+            }
+            finally
+            {
+                Interlocked.Decrement(ref LoadsActive);
+                LandblockManager.IsVehicleLoaderThread = false;
+                DatDatabase.BackgroundReaderThread = false;
+            }
+        }
+
+        /// <summary>Background loads running right now (the world-tick monitor attributes stalls with this).</summary>
+        public static int LoadsActive;
+
+        static readonly object statsLock = new object();
+
+        /// <summary>World thread: account the finished background loads (flag them vehicle-only for the 60 s retention).</summary>
+        static void CollectFinished(Vehicle v)
+        {
+            foreach (var kv in builds)
+            {
+                if (!kv.Value.IsCompleted)
+                    continue;
+                builds.TryRemove(kv.Key, out _);
+                var lb = LandblockManager.GetLoadedLandblock(kv.Key >> 8, kv.Key & 0xFF);
+                if (lb == null)
+                    continue;
+                lb.VehicleOnly = true;
+                Published++;
+                v.Stream.Preloads++;
+            }
+        }
+
+        static void ReleaseBackPressure(Vehicle v)
+        {
+            v.BackPressure = false;
+            v.BackPressureCap = float.MaxValue;
+        }
+
+        static bool GlobalTokenAvailable()
+        {
+            var now = DateTime.UtcNow;
+            while (globalLoads.Count > 0 && (now - globalLoads.Peek()).TotalSeconds > 1.0)
+                globalLoads.Dequeue();
+            return globalLoads.Count < GlobalLoadsPerSecond;
+        }
+
+        public static string Report() =>
+            $"streaming: preload={PreloadEnabled} offthread={OffThread} retention60s={ShortRetention}; sync preloads {Preloads} (avg {(Preloads > 0 ? PreloadMsTotal / Preloads : 0):0.0} ms, max {PreloadMsMax:0.0} ms), " +
+            $"off-thread loads {OffThreadBuilds} (avg {(OffThreadBuilds > 0 ? BuildMsTotal / OffThreadBuilds : 0):0.0} ms, max {BuildMsMax:0.0} ms, on a background task) collected {Published} failed {BuildFailures}, " +
+            $"landblock budget={LandblockBudget}: {BringUpChunks} object chunks deferred to later ticks, {PowerUpYields} generator power-ups continued next tick, loot generators deferred {LootGeneratorsDeferred} (restored {LootGeneratorsRestored}), loot profiles held {LootProfilesDeferred}; " +
+            $"late spawn warm-ups (vehicle-only landblocks loaded outside the corridor) {LateWarmups}; indoor cells built off-thread {CellsPrewarmed} in {CellPrewarmLandblocks} landblocks (avg {(CellPrewarmLandblocks > 0 ? CellPrewarmMsTotal / CellPrewarmLandblocks : 0):0.0} ms, max {CellPrewarmMsMax:0.0} ms); " +
+            $"prefetches {PrefetchesStarted} (warm at load {PrefetchesWarm}; spawn caches: {WarmupLandblocks} landblocks, {WeeniesWarmed} weenies, avg {(WarmupLandblocks > 0 ? WarmupMsTotal / WarmupLandblocks : 0):0.0} ms, max {WarmupMsMax:0.0} ms, off-thread), back-pressure events {VehicleManager.BackPressureEvents}";
+    }
+
+    /// <summary>Per-vehicle streaming state.</summary>
+    public sealed class VehicleStreamState
+    {
+        public readonly List<(ushort key, double t)> Targets = new List<(ushort, double)>();
+        public readonly HashSet<ushort> Seen = new HashSet<ushort>();
+        public double LeadSeconds = double.NaN;
+        public long Preloads, BackPressureEvents;
+        public double PreloadMsTotal, PreloadMsMax, ConstructMsTotal, InitMsTotal;
+        double tokens = 2;
+        DateTime lastRefill = DateTime.UtcNow;
+
+        public bool TryTakeToken(double perSecond)
+        {
+            var now = DateTime.UtcNow;
+            tokens = Math.Min(2, tokens + (now - lastRefill).TotalSeconds * Math.Max(0.5, perSecond));
+            lastRefill = now;
+            if (tokens < 1) return false;
+            tokens -= 1;
+            return true;
+        }
+
+        public void TokenRefund() => tokens = Math.Min(2, tokens + 1);
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/VehicleTerrain.cs b/Source/ACE.Server/Vehicles/VehicleTerrain.cs
new file mode 100644
index 0000000..e0e4f87
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleTerrain.cs
@@ -0,0 +1,120 @@
+using System;
+using System.Collections.Concurrent;
+
+using ACE.DatLoader;
+using ACE.DatLoader.FileTypes;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// Retail terrain height straight from the cell DAT — the vehicle flight model's `ground(x, y)`.
+    ///
+    /// Mirrors holtburger's `WorldState::terrain_height_at` / `SessionHandle.terrainHeightAt` operation for operation
+    /// (f32 throughout, the retail per-cell split diagonal `cell_swto_ne_cut`, the per-cell triangle interpolation),
+    /// so the server and the pilot's predictor clamp against the same surface. It never loads a landblock (no world
+    /// objects, no DB): only the CellLandblock heightmap record (DatManager caches it) and the region's height table.
+    /// </summary>
+    public static class VehicleTerrain
+    {
+        const float LbM = 192.0f;
+        const float VertM = 24.0f;
+
+        static readonly ConcurrentDictionary<uint, float[]> grids = new ConcurrentDictionary<uint, float[]>();
+        static float[] landHeightTable;
+
+        public static int CachedLandblocks => grids.Count;
+
+        static float[] HeightTable()
+        {
+            if (landHeightTable == null)
+                landHeightTable = DatManager.PortalDat.RegionDesc.LandDefs.LandHeightTable.ToArray();
+            return landHeightTable;
+        }
+
+        /// <summary>9×9 vertex heights, index vx * 9 + vy (CellLandblock layout). Null if the landblock has no record.</summary>
+        public static float[] Grid(int lbX, int lbY)
+        {
+            var key = ((uint)lbX << 24) | ((uint)lbY << 16);
+            if (grids.TryGetValue(key, out var g))
+                return g;
+            float[] grid = null;
+            try
+            {
+                var cl = DatManager.CellDat.ReadFromDat<CellLandblock>(key | 0xFFFF);
+                if (cl?.Height != null && cl.Height.Count >= 81)
+                {
+                    var table = HeightTable();
+                    grid = new float[81];
+                    for (var i = 0; i < 81; i++)
+                        grid[i] = table[cl.Height[i]];
+                }
+            }
+            catch (Exception)
+            {
+                grid = null;
+            }
+            grids[key] = grid;
+            return grid;
+        }
+
+        /// <summary>Terrain height at world (x, y) in AC metres, or NaN outside the map / without terrain data.</summary>
+        public static float HeightAt(float worldX, float worldY)
+        {
+            if (!float.IsFinite(worldX) || !float.IsFinite(worldY))
+                return float.NaN;
+            var lbX = (int)MathF.Floor(worldX / LbM);
+            var lbY = (int)MathF.Floor(worldY / LbM);
+            if (lbX < 0 || lbX >= 256 || lbY < 0 || lbY >= 256)
+                return float.NaN;
+            var grid = Grid(lbX, lbY);
+            if (grid == null)
+                return float.NaN;
+
+            var localX = worldX - (float)lbX * LbM;
+            var localY = worldY - (float)lbY * LbM;
+            var cellX = Math.Clamp(localX / VertM, 0.0f, 8.0f);
+            var cellY = Math.Clamp(localY / VertM, 0.0f, 8.0f);
+            var cx0 = (int)MathF.Floor(cellX);
+            var cy0 = (int)MathF.Floor(cellY);
+            var cx1 = Math.Min(cx0 + 1, 8);
+            var cy1 = Math.Min(cy0 + 1, 8);
+            var fx = cellX - (float)cx0;
+            var fy = cellY - (float)cy0;
+            var z00 = grid[cx0 * 9 + cy0];
+            var z10 = grid[cx1 * 9 + cy0];
+            var z01 = grid[cx0 * 9 + cy1];
+            var z11 = grid[cx1 * 9 + cy1];
+            var gx = (uint)lbX * 8u + (uint)cx0;
+            var gy = (uint)lbY * 8u + (uint)cy0;
+            return TriangleHeightInCell(z00, z10, z01, z11, fx, fy, CellSwToNeCut(gx, gy));
+        }
+
+        /// <summary>Retail per-cell split (acclient; holtburger-dat terrain_subdiv::cell_swto_ne_cut). 32-bit wrapping.</summary>
+        public static bool CellSwToNeCut(uint gx, uint gy)
+        {
+            unchecked
+            {
+                var inner = 214614067u * gx + 1813693831u;
+                var v8 = gy * inner - 1109124029u * gx - 1369149221u;
+                return (double)v8 * 2.3283064e-10 >= 0.5;
+            }
+        }
+
+        /// <summary>holtburger-dat terrain_subdiv::triangle_height_in_cell, same expression order (f32).</summary>
+        public static float TriangleHeightInCell(float z00, float z10, float z01, float z11, float fx, float fy, bool swNeCut)
+        {
+            if (swNeCut)
+            {
+                if (fx >= fy)
+                    return z00 + (z10 - z00) * fx + (z11 - z10) * fy;
+                return z00 + (z11 - z01) * fx + (z01 - z00) * fy;
+            }
+            if (fx + fy <= 1.0f)
+                return z00 + (z10 - z00) * fx + (z01 - z00) * fy;
+            return z11 + (z01 - z11) * (1.0f - fx) + (z10 - z11) * (1.0f - fy);
+        }
+
+        /// <summary>The flight model's ground function: double in, double out (NaN = unknown).</summary>
+        public static double Ground(double x, double y) => HeightAt((float)x, (float)y);
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/VehicleWeapons.cs b/Source/ACE.Server/Vehicles/VehicleWeapons.cs
new file mode 100644
index 0000000..1503c5b
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleWeapons.cs
@@ -0,0 +1,239 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+
+using ACE.Entity.Enum;
+using ACE.Server.Entity;
+using ACE.Server.Network.GameEvent.Events;
+using ACE.Server.Network.GameMessages.Messages;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// Vehicle guns vs monsters (DESIGN.md §4.7). The server owns the rate (accumulator per mount), the spread (a seeded
+    /// RNG the clients can replay from VehicleFire.Seed) and the ammo. No per-bolt projectile objects: each bolt is a ray
+    /// from the muzzle, tested against the cylinders of the creatures the pilot already tracks, occluded by the terrain
+    /// heightmap. Damage goes through ACE's normal creature path (Creature.TakeDamage with the pilot as the source), so
+    /// aggro, death, XP and loot behave as for any player attack and retail clients see monsters take damage and die.
+    /// </summary>
+    public static class VehicleWeapons
+    {
+        /// <summary>Seconds after the magazine empties before it is full again (demo: effectively unlimited ammo).</summary>
+        public const double ReloadSeconds = 2.0;
+        const double OcclusionStep = 4.0;
+
+        /// <summary>xorshift32 — the spread RNG, mirrored by the client's tracer code (scene3d/vehicle/weapons.js).</summary>
+        public static uint XorShift(ref uint s)
+        {
+            unchecked
+            {
+                s ^= s << 13;
+                s ^= s >> 17;
+                s ^= s << 5;
+                return s;
+            }
+        }
+
+        /// <summary>Unit float in [0, 1) from the RNG (24 bits, exact in f32 and double).</summary>
+        public static double Unit(ref uint s) => (XorShift(ref s) >> 8) * (1.0 / 16777216.0);
+
+        /// <summary>
+        /// The k-th bolt's spread offsets (radians, right / up) for a burst seed: uniform over the cone's disc.
+        /// The client replays exactly this to draw the tracers.
+        /// </summary>
+        public static (double dRight, double dUp) SpreadOffset(ref uint rng, double spread)
+        {
+            var r = spread * Math.Sqrt(Unit(ref rng));
+            var a = 2.0 * Math.PI * Unit(ref rng);
+            return (r * Math.Cos(a), r * Math.Sin(a));
+        }
+
+        public static void StepFire(Vehicle v, Player pilot)
+        {
+            if (v.Profile.Weapons.Count == 0 || v.State.Mode != VehicleMode.Flight)
+            {
+                v.FireAccumulator = 0;
+                return;
+            }
+            var wpn = v.Profile.Weapons[0];
+            if (v.Ammo <= 0)
+            {
+                if (v.ReloadAtUtc == DateTime.MinValue)
+                    v.ReloadAtUtc = DateTime.UtcNow.AddSeconds(ReloadSeconds);
+                if (DateTime.UtcNow < v.ReloadAtUtc)
+                    return;
+                v.Ammo = (int)wpn.Magazine;
+                v.ReloadAtUtc = DateTime.MinValue;
+            }
+
+            v.FireAccumulator += wpn.RoundsPerSecond * FlightModel.Dt;
+            var count = 0;
+            while (v.FireAccumulator >= 1.0 && v.Ammo > 0)
+            {
+                v.FireAccumulator -= 1.0;
+                v.Ammo--;
+                count++;
+            }
+            if (count == 0)
+                return;
+
+            var q = v.CurrentOrientation;
+            var fwd = Vector3.Normalize(Vector3.Transform(Vector3.UnitY, q));
+            var right = Vector3.Normalize(Vector3.Transform(Vector3.UnitX, q));
+            var up = Vector3.Normalize(Vector3.Transform(Vector3.UnitZ, q));
+            var (mx, my, mz) = v.LocalToWorld(wpn.Muzzle);
+            var muzzle = new Vector3((float)mx, (float)my, (float)mz);
+
+            var seed = v.FireSeed;
+            if (seed == 0) seed = 0x9E3779B9;
+            var burstSeed = seed;
+            var rng = seed;
+
+            var candidates = Candidates(pilot, muzzle, wpn.Range);
+            for (var i = 0; i < count; i++)
+            {
+                var (dr, du) = SpreadOffset(ref rng, wpn.Spread);
+                var dir = Vector3.Normalize(fwd + right * (float)Math.Tan(dr) + up * (float)Math.Tan(du));
+                v.Costs.BoltsFired++;
+                var hit = Resolve(candidates, muzzle, dir, wpn.Range);
+                if (hit != null)
+                    ApplyHit(v, pilot, hit, wpn);
+            }
+            // next burst continues the stream
+            v.FireSeed = XorShift(ref rng) | 1u;
+
+            // tracers for capable clients (pilot included)
+            var pos = Vehicle.ToPosition(mx, my, mz, q);
+            var fire = new VehicleFireMsg
+            {
+                Vehicle = v.Guid.Full, Step = v.SimStep, Mount = 0, Count = (ushort)count, Cell = pos.Cell, Muzzle = pos.Pos,
+                DirX = (short)Math.Round(fwd.X * 32767f), DirY = (short)Math.Round(fwd.Y * 32767f), DirZ = (short)Math.Round(fwd.Z * 32767f),
+                Seed = burstSeed,
+            };
+            VehicleManager.BroadcastFire(v, fire);
+        }
+
+        struct Candidate
+        {
+            public Creature Creature;
+            public Vector3 Base;
+            public float Radius, Height;
+        }
+
+        static List<Candidate> Candidates(Player pilot, Vector3 muzzle, float range)
+        {
+            var list = new List<Candidate>();
+            if (pilot?.PhysicsObj == null)
+                return list;
+            foreach (var c in pilot.PhysicsObj.ObjMaint.GetKnownObjectsValuesAsCreature())
+            {
+                if (c == null || c is Player || c.IsDead || !c.Attackable || c.PhysicsObj == null || c.Location == null || c.Location.Indoors)
+                    continue;
+                var (cx, cy, cz) = Vehicle.ToGlobal(c.Location);
+                var b = new Vector3((float)cx, (float)cy, (float)cz);
+                var radius = Math.Max(0.3f, c.PhysicsObj.GetRadius());
+                var height = Math.Max(0.5f, c.PhysicsObj.GetHeight());
+                if (Vector3.Distance(muzzle, b) > range + radius + height)
+                    continue;
+                list.Add(new Candidate { Creature = c, Base = b, Radius = radius, Height = height });
+            }
+            return list;
+        }
+
+        /// <summary>Nearest creature cylinder the ray enters within range, unless the terrain is in the way.</summary>
+        static Creature Resolve(List<Candidate> candidates, Vector3 o, Vector3 d, float range)
+        {
+            Creature best = null;
+            var bestT = double.MaxValue;
+            foreach (var c in candidates)
+            {
+                if (!RayCylinder(o, d, c.Base, c.Radius, c.Height, range, out var t) || t >= bestT)
+                    continue;
+                if (TerrainOccludes(o, d, t))
+                    continue;
+                best = c.Creature;
+                bestT = t;
+            }
+            return best;
+        }
+
+        /// <summary>Ray (unit d) vs an upright cylinder [base.z, base.z + h]; first entry distance in [0, range].</summary>
+        public static bool RayCylinder(Vector3 o, Vector3 d, Vector3 b, float r, float h, float range, out double tEnter)
+        {
+            tEnter = 0;
+            double t0 = 0, t1 = range;
+            // horizontal: |(o.xy - b.xy) + t d.xy| <= r
+            double px = o.X - b.X, py = o.Y - b.Y;
+            double a = d.X * d.X + d.Y * d.Y;
+            double c = px * px + py * py - (double)r * r;
+            if (a < 1e-12)
+            {
+                if (c > 0) return false;
+            }
+            else
+            {
+                double bq = 2 * (px * d.X + py * d.Y);
+                double disc = bq * bq - 4 * a * c;
+                if (disc < 0) return false;
+                var sq = Math.Sqrt(disc);
+                var ta = (-bq - sq) / (2 * a);
+                var tb = (-bq + sq) / (2 * a);
+                t0 = Math.Max(t0, ta);
+                t1 = Math.Min(t1, tb);
+            }
+            // vertical band
+            if (Math.Abs(d.Z) < 1e-9)
+            {
+                if (o.Z < b.Z || o.Z > b.Z + h) return false;
+            }
+            else
+            {
+                var za = (b.Z - o.Z) / d.Z;
+                var zb = (b.Z + h - o.Z) / d.Z;
+                t0 = Math.Max(t0, Math.Min(za, zb));
+                t1 = Math.Min(t1, Math.Max(za, zb));
+            }
+            if (t0 > t1) return false;
+            tEnter = t0;
+            return true;
+        }
+
+        static bool TerrainOccludes(Vector3 o, Vector3 d, double tHit)
+        {
+            for (var t = OcclusionStep; t < tHit - 0.5; t += OcclusionStep)
+            {
+                var p = o + d * (float)t;
+                var g = VehicleTerrain.HeightAt(p.X, p.Y);
+                if (!float.IsNaN(g) && p.Z < g)
+                    return true;
+            }
+            return false;
+        }
+
+        static void ApplyHit(Vehicle v, Player pilot, Creature target, VehicleWeaponDef wpn)
+        {
+            v.Costs.BoltsHit++;
+            var amount = wpn.Damage * (float)(0.85 + 0.3 * VehicleRng.NextDouble());
+            var dealt = target.TakeDamage(pilot, DamageType.Pierce, amount, false);
+
+            if (target.IsAlive && dealt > 0)
+            {
+                pilot.Session.Network.EnqueueSend(new GameEventAttackerNotification(pilot.Session, target.Name, DamageType.Pierce,
+                    (float)dealt / Math.Max(1u, target.Health.MaxValue), dealt, false, AttackConditions.None));
+                // visible to everyone around the target (retail included)
+                target.EnqueueBroadcast(new GameMessageSound(target.Guid, Sound.HitFlesh1, 0.5f));
+                target.EmoteManager.OnDamage(pilot);
+            }
+            pilot.OnAttackMonster(target);
+            VehicleManager.BroadcastEvent(v, VehicleEventKind.Hit, target.Guid.Full, dealt);
+        }
+
+        /// <summary>Server-only randomness (damage variance), not replayed by clients.</summary>
+        static class VehicleRng
+        {
+            [ThreadStatic] static Random rng;
+            public static double NextDouble() => (rng ??= new Random()).NextDouble();
+        }
+    }
+}
