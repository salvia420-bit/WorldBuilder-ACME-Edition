+
+        internal static VehicleStateMsg ReadBody(BinaryReader r) => new VehicleStateMsg
+        {
+            Vehicle = r.ReadUInt32(), Step = r.ReadUInt32(), AckInputSeq = r.ReadUInt32(), Cell = r.ReadUInt32(),
+            Position = VehicleWire.ReadVec3(r), Heading = r.ReadSingle(), Pitch = r.ReadSingle(), Bank = r.ReadSingle(),
+            Speed = r.ReadSingle(), VCap = r.ReadSingle(), Ammo = r.ReadUInt16(), Mode = r.ReadByte(), Flags = r.ReadByte(),
+        };
+    }
+
+    public sealed class VehicleFireMsg : VehicleS2C
+    {
+        public uint Vehicle, Step;
+        public ushort Mount, Count;
+        public uint Cell;
+        public Vector3 Muzzle;
+        public short DirX, DirY, DirZ;
+        public ushort Reserved;
+        public uint Seed;
+
+        public override uint Opcode => VehicleWire.OpFire;
+
+        protected override void WriteBody(BinaryWriter w)
+        {
+            w.Write(Vehicle); w.Write(Step); w.Write(Mount); w.Write(Count); w.Write(Cell);
+            VehicleWire.WriteVec3(w, Muzzle);
+            w.Write(DirX); w.Write(DirY); w.Write(DirZ); w.Write(Reserved); w.Write(Seed);
+        }
+
+        internal static VehicleFireMsg ReadBody(BinaryReader r) => new VehicleFireMsg
+        {
+            Vehicle = r.ReadUInt32(), Step = r.ReadUInt32(), Mount = r.ReadUInt16(), Count = r.ReadUInt16(), Cell = r.ReadUInt32(),
+            Muzzle = VehicleWire.ReadVec3(r), DirX = r.ReadInt16(), DirY = r.ReadInt16(), DirZ = r.ReadInt16(),
+            Reserved = r.ReadUInt16(), Seed = r.ReadUInt32(),
+        };
+    }
+
+    public enum VehicleEventKind : uint
+    {
+        Takeoff = 1, Landed = 2, Crashed = 3, Despawn = 4, Bail = 5, Chute = 6, Touchdown = 7, Hit = 8,
+    }
+
+    public sealed class VehicleEventMsg : VehicleS2C
+    {
+        public uint Vehicle, Kind, Step, Subject, Cell;
+        public Vector3 Position;
+        public float Value;
+        public override uint Opcode => VehicleWire.OpEvent;
+        protected override void WriteBody(BinaryWriter w)
+        {
+            w.Write(Vehicle); w.Write(Kind); w.Write(Step); w.Write(Subject); w.Write(Cell);
+            VehicleWire.WriteVec3(w, Position);
+            w.Write(Value);
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/WorldTickMonitor.cs b/Source/ACE.Server/Vehicles/WorldTickMonitor.cs
new file mode 100644
index 0000000..8b6c23a
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/WorldTickMonitor.cs
@@ -0,0 +1,234 @@
+using System;
+using System.Diagnostics;
+using System.Text;
+using System.Threading;
+
+using log4net;
+
+using ACE.Server.Managers;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// holtburger vehicles fork (M3 done-when: "no world-thread stall > 50 ms from vehicles"): while any vehicle or bail-out
+    /// exists, every world-loop iteration (WorldManager.UpdateWorld) is timed by phase; iterations over 50 ms are logged
+    /// with the breakdown, GC pauses and landblock-lock waits, and counted by cause:
+    ///   vehicle = the vehicle phase + lock waits (only vehicle background loads hold the landblock lock off the world
+    ///             thread in this fork) are at least half of it; gc = a GC pause is; other = everything else (ACE's own
+    ///             landblock / network work — reported with its phase so it can be judged).
+    /// No cost while no vehicle exists (one bool test per phase).
+    /// </summary>
+    public static class WorldTickMonitor
+    {
+        static readonly ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
+
+        public enum Phase { Players, Inbound, Actions, Delay, Vehicles, LbPending, LbPhysics, LbMultiThreaded, LbSingleThreaded, LbUnload, Houses, Sessions, Count }
+
+        public const double StallMs = 50.0;
+
+        static readonly double[] ms = new double[(int)Phase.Count];
+        static bool active;
+        static long t0, last;
+        static TimeSpan gc0;
+        static int gen2_0;
+
+        public static long Ticks, Stalls, StallsVehicle, StallsGc, StallsOther;
+        public static double MaxMs;
+        public static string MaxDesc = "";
+        static int stallLogs;
+
+        public static void Begin()
+        {
+            active = VehicleManager.Count > 0 || VehicleBailout.Count > 0;
+            if (!active)
+                return;
+            Array.Clear(ms, 0, ms.Length);
+            gc0 = GC.GetTotalPauseDuration();
+            gen2_0 = GC.CollectionCount(2);
+            LandblockManager.TickLockWaitMs = 0;
+            t0 = last = Stopwatch.GetTimestamp();
+        }
+
+        public static void Mark(Phase p)
+        {
+            if (!active)
+                return;
+            var now = Stopwatch.GetTimestamp();
+            ms[(int)p] += (now - last) * 1000.0 / Stopwatch.Frequency;
+            last = now;
+        }
+
+        public static void End()
+        {
+            if (!active)
+                return;
+            active = false;
+            Ticks++;
+            var total = (Stopwatch.GetTimestamp() - t0) * 1000.0 / Stopwatch.Frequency;
+            if (total < StallMs)
+                return;
+
+            var gcMs = (GC.GetTotalPauseDuration() - gc0).TotalMilliseconds;
+            var gen2 = GC.CollectionCount(2) - gen2_0;
+            var lockMs = LandblockManager.TickLockWaitMs;
+            var vehicleMs = ms[(int)Phase.Vehicles] + lockMs;
+            string cause;
+            if (vehicleMs >= total * 0.5) { cause = "vehicle"; StallsVehicle++; }
+            else if (gcMs >= total * 0.5) { cause = "gc"; StallsGc++; }
+            else { cause = "other"; StallsOther++; }
+            Stalls++;
+
+            var sb = new StringBuilder();
+            for (var i = 0; i < (int)Phase.Count; i++)
+                if (ms[i] >= 1.0)
+                    sb.Append($" {(Phase)i} {ms[i]:0.0}");
+            var desc = $"{total:0.0} ms [{cause}]:{sb} | lock waits {lockMs:0.0} ms, GC pause {gcMs:0.0} ms (gen2 +{gen2}), background loads running {VehicleStreaming.LoadsActive}";
+            if (total > MaxMs)
+            {
+                MaxMs = total;
+                MaxDesc = desc;
+            }
+            if (stallLogs++ < 200)
+                log.Warn($"[VEHICLE][WORLDSTALL] world tick {desc}");
+        }
+
+        // per-landblock multi-threaded tick cost while vehicles exist (group threads: guarded counters)
+        static readonly object lbLock = new object();
+        public static long LbSlowTicks, LbSlowTicksVehicleOnly, LbSlowFirstTicks;
+        public static double LbWorstMs;
+        public static string LbWorstDesc = "";
+        static int lbLogs;
+
+        public static void NoteLandblockTick(Entity.Landblock lb, long t0, long t1, long t2, long t3, long t4, long t5, long t6)
+        {
+            if (!active)
+                return;
+            double f(long a, long b) => (b - a) * 1000.0 / Stopwatch.Frequency;
+            var total = f(t0, t6);
+            if (total < 20.0)
+                return;
+            var desc = $"landblock {lb.Id.Raw >> 16:X4} tick {total:0.0} ms (tick #{lb.VehicleTicks}{(lb.VehicleOnly ? ", vehicle-only" : "")}, {lb.WorldObjectCount} objects): " +
+                $"actions {f(t0, t1):0.0}, add/remove {f(t1, t2):0.0}, monsters {f(t2, t3):0.0}, generators {f(t3, t4):0.0}, regen {f(t4, t5):0.0}, heartbeat+save {f(t5, t6):0.0}";
+            lock (lbLock)
+            {
+                LbSlowTicks++;
+                if (lb.VehicleOnly) LbSlowTicksVehicleOnly++;
+                if (lb.VehicleTicks <= 3) LbSlowFirstTicks++;
+                if (total > LbWorstMs)
+                {
+                    LbWorstMs = total;
+                    LbWorstDesc = desc;
+                }
+            }
+            if (Interlocked.Increment(ref lbLogs) <= 400)
+                log.Warn($"[VEHICLE][LBTICK] {desc}");
+        }
+
+        static int genLogs;
+        public static long GenSlowCalls;
+
+        public static void NoteGeneratorCall(Entity.Landblock lb, WorldObjects.WorldObject gen, string what, long t0)
+        {
+            if (!active)
+                return;
+            var ms = (Stopwatch.GetTimestamp() - t0) * 1000.0 / Stopwatch.Frequency;
+            if (ms < 30.0)
+                return;
+            Interlocked.Increment(ref GenSlowCalls);
+            if (Interlocked.Increment(ref genLogs) <= 60)
+                log.Warn($"[VEHICLE][GEN] {what} of {gen.Name} 0x{gen.Guid.Full:X8} wcid {gen.WeenieClassId} in landblock {lb.Id.Raw >> 16:X4} (tick #{lb.VehicleTicks}{(lb.VehicleOnly ? ", vehicle-only" : "")}) took {ms:0.0} ms; spawned now {(gen.GeneratorProfiles != null ? gen.CurrentCreate : 0)} / max {gen.MaxGeneratedObjects}, {gen.GeneratorProfiles?.Count ?? 0} profiles");
+        }
+
+        // the spawn path split (generator spawns and landblock object additions), while vehicles exist
+        [ThreadStatic] static double lastAddInitMs, lastAddPlaceMs, lastAddNotifyMs;
+        static int spawnLogs;
+        public static long SpawnsSlow;
+        public static double SpawnFactoryMsTotal, SpawnPlaceMsTotal, SpawnInitPhysMsTotal, SpawnAddPhysMsTotal, SpawnNotifyMsTotal;
+
+        public static void NoteAdd(WorldObjects.WorldObject wo, long t0, long t1, long t2, long t3, long t4)
+        {
+            if (!active)
+                return;
+            double f(long a, long b) => (b - a) * 1000.0 / Stopwatch.Frequency;
+            lastAddInitMs = f(t0, t1);
+            lastAddPlaceMs = f(t1, t2);
+            lastAddNotifyMs = f(t3, t4);
+        }
+
+        // creation split of the most recent constructor on this thread (base WorldObject, then Creature)
+        [ThreadStatic] static double ctorBiotaMs, ctorBaseEphemeralMs, ctorGeneratorMs;
+        [ThreadStatic] static double crFaceMs, crStatsMs, crWieldListMs, crWieldedTreasureMs, crInventoryTreasureMs, crRestMs;
+        [ThreadStatic] static double ctorAccBiota, ctorAccEphemeral, ctorAccGenerator, crAccFace, crAccStats, crAccWield, crAccWTreasure, crAccITreasure, crAccRest;
+
+        public static void NoteBaseCtor(long t0, long t1, long t2, long t3)
+        {
+            if (!active)
+                return;
+            double f(long a, long b) => (b - a) * 1000.0 / Stopwatch.Frequency;
+            ctorAccBiota += f(t0, t1);
+            ctorAccEphemeral += f(t1, t2);
+            ctorAccGenerator += f(t2, t3);
+        }
+
+        public static void NoteCreatureCtor(long t0, long t1, long t2, long t3, long t4, long t5, long t6)
+        {
+            if (!active)
+                return;
+            double f(long a, long b) => (b - a) * 1000.0 / Stopwatch.Frequency;
+            crAccFace += f(t0, t1);
+            crAccStats += f(t1, t2);
+            crAccWield += f(t2, t3);
+            crAccWTreasure += f(t3, t4);
+            crAccITreasure += f(t4, t5);
+            crAccRest += f(t5, t6);
+        }
+
+        /// <summary>Resets this thread's creation accumulators (GeneratorProfile.Spawn start).</summary>
+        public static void BeginSpawn()
+        {
+            spFactoryMs = spAppearanceMs = 0;
+            ctorAccBiota = ctorAccEphemeral = ctorAccGenerator = 0;
+            crAccFace = crAccStats = crAccWield = crAccWTreasure = crAccITreasure = crAccRest = 0;
+        }
+
+        [ThreadStatic] static double spFactoryMs, spAppearanceMs;
+        [ThreadStatic] static long datWait0, datReads0;
+
+        public static void NoteSpawnFactory(long t0, long tf, long t1)
+        {
+            spFactoryMs = (tf - t0) * 1000.0 / Stopwatch.Frequency;
+            spAppearanceMs = (t1 - tf) * 1000.0 / Stopwatch.Frequency;
+        }
+
+        static string CtorSplit() =>
+            $"[factory {spFactoryMs:0.0} / appearance (CalculateObjDesc) {spAppearanceMs:0.0}; ctor: biota copy {ctorAccBiota:0.0}, ephemeral {ctorAccEphemeral:0.0} (creature: face {crAccFace:0.0}, stats {crAccStats:0.0}, wield list {crAccWield:0.0}, wielded treasure {crAccWTreasure:0.0}, inventory treasure {crAccITreasure:0.0}, rest {crAccRest:0.0}), generator init {ctorAccGenerator:0.0}]";
+
+        public static void NoteSpawn(WorldObjects.WorldObject gen, System.Collections.Generic.List<WorldObjects.WorldObject> objects, long t0, long t1, long t2)
+        {
+            if (!active)
+                return;
+            double f(long a, long b) => (b - a) * 1000.0 / Stopwatch.Frequency;
+            var total = f(t0, t2);
+            if (total < 20.0)
+                return;
+            lock (lbLock)
+            {
+                SpawnsSlow++;
+                SpawnFactoryMsTotal += f(t0, t1);
+                SpawnPlaceMsTotal += f(t1, t2);
+                SpawnInitPhysMsTotal += lastAddInitMs;
+                SpawnAddPhysMsTotal += lastAddPlaceMs;
+                SpawnNotifyMsTotal += lastAddNotifyMs;
+            }
+            if (Interlocked.Increment(ref spawnLogs) <= 60)
+            {
+                var o = objects != null && objects.Count > 0 ? objects[0] : null;
+                log.Warn($"[VEHICLE][SPAWN] {gen.Name} wcid {gen.WeenieClassId} spawned {objects?.Count ?? 0} ({o?.Name} wcid {o?.WeenieClassId} {o?.WeenieType}) in {total:0.0} ms: create {f(t0, t1):0.0} {CtorSplit()}, place {f(t1, t2):0.0} (last add: physics init {lastAddInitMs:0.0}, placement {lastAddPlaceMs:0.0}, notify players {lastAddNotifyMs:0.0})");
+            }
+        }
+
+        public static string Report() =>
+            $"world ticks while vehicles exist: {Ticks}, over {StallMs:0} ms: {Stalls} (vehicle {StallsVehicle}, gc {StallsGc}, other {StallsOther}); worst {(MaxMs > 0 ? MaxDesc : "-")}; " +
+            $"world write-lock deferrals {LandblockManager.WorldWriteLockDeferrals}; DAT stream lock (non-prefetch threads, process lifetime): {ACE.DatLoader.DatDatabase.ForegroundReads} reads, waited {ACE.DatLoader.DatDatabase.ForegroundWaitTicks * 1000.0 / Stopwatch.Frequency:0} ms total, max {ACE.DatLoader.DatDatabase.ForegroundWaitMaxTicks * 1000.0 / Stopwatch.Frequency:0.0} ms; landblock ticks >= 20 ms: {LbSlowTicks} (vehicle-only {LbSlowTicksVehicleOnly}, within 3 ticks of loading {LbSlowFirstTicks}), worst {(LbWorstMs > 0 ? LbWorstDesc : "-")}; generator calls >= 30 ms: {GenSlowCalls}; spawns >= 20 ms: {SpawnsSlow} (create {SpawnFactoryMsTotal:0} ms, place {SpawnPlaceMsTotal:0} ms of which physics init {SpawnInitPhysMsTotal:0}, placement {SpawnAddPhysMsTotal:0}, notify {SpawnNotifyMsTotal:0}); {LandblockManager.LoadReport()}";
+    }
+}
