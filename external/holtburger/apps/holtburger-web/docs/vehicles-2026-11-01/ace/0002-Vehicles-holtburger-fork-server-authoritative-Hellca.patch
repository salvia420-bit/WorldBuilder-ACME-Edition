+        public static void HandleInput(Session session, VehicleInput msg)
+        {
+            if (!HasCap(session, VehicleWire.CapPilot))
+                return;
+            var v = VehicleOf(session.Player);
+            if (v == null || v.Guid.Full != msg.Vehicle || v.Pilot != session.Player.Guid.Full)
+                return;
+            v.Input.Add(msg, DateTime.UtcNow);
+        }
