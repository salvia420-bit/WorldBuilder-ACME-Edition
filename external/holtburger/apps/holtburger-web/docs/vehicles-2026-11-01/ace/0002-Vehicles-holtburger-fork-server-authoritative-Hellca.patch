+
+        public static void HandleCapabilities(Session session, VehicleClientCapabilities msg)
+        {
+            var granted = Enabled ? msg.Flags & (VehicleWire.CapObserve | VehicleWire.CapPilot) : 0u;
+            session.VehicleCapabilities = granted;
+            session.Network.EnqueueSend(new GameEventVehicle(session, new VehicleCapabilitiesAck { Granted = granted, SimHz = SimHz }));
+            log.Info($"[VEHICLE] {session.Player?.Name}: ClientCapabilities 0x{msg.Flags:X} → granted 0x{granted:X}");
+            if ((granted & VehicleWire.CapObserve) != 0 && session.Player?.PhysicsObj != null)
+            {
+                foreach (var po in session.Player.PhysicsObj.ObjMaint.GetKnownObjectsValues())
+                    if (po.WeenieObj?.WorldObject is Vehicle v && !v.IsDestroyed)
+                        SendIntro(session.Player, v);
+            }
+        }
+
+        static void Refuse(Session session, uint vehicle, uint seat, VehicleRefusal reason)
+        {
+            session.Network.EnqueueSend(new GameEventVehicle(session, new VehicleSeatMsg
+            {
+                Vehicle = vehicle, Seat = seat, Occupant = 0, State = VehicleSeatMsg.StateRefused, Reason = (uint)reason,
+            }));
+        }
+
+        public static void HandleBoard(Session session, VehicleBoard msg)
+        {
+            var player = session.Player;
+            if (!Enabled) { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.Disabled); return; }
+            if (!HasCap(session, VehicleWire.CapPilot)) { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.NoCapability); return; }
+            var v = Get(msg.Vehicle);
+            if (v == null || v.IsDestroyed) { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.Busy); return; }
+            if (IsSeated(player) || player.IsDead || player.Teleporting || player.IsBusy)
+            { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.Busy); return; }
+            if (player.CombatMode != CombatMode.NonCombat) { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.InCombatMode); return; }
+            if (player.Location.Indoors) { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.Indoors); return; }
+            if (!v.IsParked) { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.NotParked); return; }
+            var seat = (int)msg.Seat;
+            if (seat < 0 || seat >= v.SeatOccupants.Length || v.SeatOccupants[seat] != 0)
+            { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.SeatTaken); return; }
+            if (player.Location.DistanceTo(v.Location) > BoardDistance)
+            { Refuse(session, msg.Vehicle, msg.Seat, VehicleRefusal.TooFar); return; }
+
+            v.SeatOccupants[seat] = player.Guid.Full;
+            seated[player.Guid.Full] = (v.Guid.Full, seat);
+            player.PhysicsObj.ObjMaint.SetSightRadius(SightRadius);
+            v.Input.Reset();
+            v.PilotStateAcc = 1.0;
+
+            // the body: no gravity while seated (retail observers would otherwise drop it between updates), seated motion
+            player.PhysicsObj.State &= ~PhysicsState.Gravity;
+            player.EnqueueBroadcastPhysicsState();
+            var sit = new Motion(MotionStance.NonCombat, MotionCommand.Sitting);
+            player.CurrentMotionState = sit;
+            player.EnqueueBroadcastMotion(sit);
+            MovePilot(v, player, v.SeatPosition(seat));
+
+            BroadcastSeat(v, seat, player);
+            SendTo(v, session, v.BuildStateMsg(true));
+            log.Info($"[VEHICLE] {player.Name} boarded {v.Name} 0x{v.Guid.Full:X8} seat {seat}");
+        }
+
+        public static void HandleExit(Session session, VehicleExit msg)
+        {
+            var player = session.Player;
+            if (msg.Mode == VehicleExit.ModeChute)
+            {
+                VehicleBailout.OpenChute(player);
+                return;
+            }
+            var v = VehicleOf(player);
+            if (v == null || v.Guid.Full != msg.Vehicle)
+                return;
+            if (msg.Mode == VehicleExit.ModeExit && !v.IsParked)
+            {
+                if (v.State.Mode == VehicleMode.Landing)
+                {
+                    // the pilot's client predicted the touchdown a few steps ahead of us: exit when we park
+                    v.ExitPending = player.Guid.Full;
+                    return;
+                }
+                // exit only on the ground; in the air the client must bail
+                session.Network.EnqueueSend(new GameMessageSystemChat("Land first (or bail out).", ChatMessageType.Broadcast));
+                return;
+            }
+            if (msg.Mode == VehicleExit.ModeBail && !v.IsParked)
+            {
+                VehicleBailout.Bail(v, player);
+                return;
+            }
+            Unseat(v, player, placeOnGround: true);
+        }
