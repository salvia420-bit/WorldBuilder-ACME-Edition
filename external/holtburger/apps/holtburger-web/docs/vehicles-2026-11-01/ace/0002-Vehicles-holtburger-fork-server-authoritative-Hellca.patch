+        // ================================================================ seats
+
+        /// <summary>Empties the player's seat. placeOnGround: put the body on the terrain beside the vehicle.</summary>
+        public static void Unseat(Vehicle v, Player player, bool placeOnGround, bool keepAirborne = false)
+        {
+            if (!seated.TryGetValue(player.Guid.Full, out var s) || s.vehicle != v.Guid.Full)
+                return;
+            seated.Remove(player.Guid.Full);
+            v.SeatOccupants[s.seat] = 0;
+            v.Input.Reset();
+            player.PhysicsObj?.ObjMaint.SetSightRadius(Physics.Common.ObjectMaint.InitialClamp_Dist);
+
+            if (!keepAirborne)
+            {
+                player.PhysicsObj.State |= PhysicsState.Gravity;
+                player.EnqueueBroadcastPhysicsState();
+            }
+            var ready = new Motion(MotionStance.NonCombat, MotionCommand.Ready);
+            player.CurrentMotionState = ready;
+            player.EnqueueBroadcastMotion(ready);
+
+            // order matters for the capable client: seat released, then the body placed, then Touchdown (carrying the
+            // placement) — the two game events share one ordered stream, the UpdatePosition does not.
+            BroadcastSeat(v, s.seat, player);
+            if (placeOnGround)
+            {
+                var (x, y, _) = v.LocalToWorld(new Vector3(-3.0f, 0.0f, 0.0f));
+                var gz = VehicleTerrain.HeightAt((float)x, (float)y);
+                if (float.IsNaN(gz)) gz = (float)v.State.Z;
+                var pos = Vehicle.ToPosition(x, y, gz + 0.05, Vehicle.YawOnly(v.State.Heading));
+                PlaceBody(player, pos, v);
+                BroadcastEvent(v, VehicleEventKind.Touchdown, player.Guid.Full, 0f, pos, player);
+            }
+            if (!v.IsParked && v.State.Mode != VehicleMode.Crashed && v.State.Mode != VehicleMode.Derelict)
+            {
+                v.State.Mode = VehicleMode.Derelict;
+                v.ModeSinceUtc = DateTime.UtcNow;
+            }
+            log.Info($"[VEHICLE] {player.Name} left {v.Name} 0x{v.Guid.Full:X8} (ground={placeOnGround})");
+        }
+
+        /// <summary>Moves a body the server owns (a falling player): loads ahead, places, relocates. No echo to its client.</summary>
+        public static void MoveBody(Player player, Position pos)
+        {
+            var prevLb = player.Location.Landblock;
+            if (pos.Landblock != prevLb && !LandblockManager.IsLoaded(new LandblockId(pos.Cell | 0xFFFF)))
+                LandblockManager.GetLandblock(new LandblockId(pos.Cell | 0xFFFF), true);
+            player.Location = pos;
+            player.PhysicsObj.set_current_pos(new Physics.Common.Position(pos));
+            if (pos.Landblock != prevLb)
+                LandblockManager.RelocateObjectForPhysics(player, true);
+        }
+
+        /// <summary>A vehicle event for one capable player, when the vehicle object is already gone.</summary>
+        public static void SendEventTo(Player player, uint vehicle, VehicleEventKind kind, float value, Position at)
+        {
+            if (!HasCap(player?.Session, VehicleWire.CapObserve))
+                return;
+            SendTo(null, player.Session, new VehicleEventMsg
+            {
+                Vehicle = vehicle, Kind = (uint)kind, Step = 0, Subject = player.Guid.Full, Cell = at.Cell, Position = at.Pos, Value = value,
+            });
+        }
+
+        /// <summary>Server-side placement of a body with a forced position update (the client snaps to it).</summary>
+        public static void PlaceBody(Player player, Position pos, Vehicle v = null)
+        {
+            var prevLb = player.Location.Landblock;
+            player.Location = pos;
+            player.PhysicsObj.set_current_pos(new Physics.Common.Position(pos));
+            if (pos.Landblock != prevLb)
+            {
+                if (v != null) Relocate(player, v);
+                else LandblockManager.RelocateObjectForPhysics(player, true);
+            }
+            player.LastGroundPos = new Position(pos);
+            player.Sequences.GetNextSequence(Network.Sequence.SequenceType.ObjectForcePosition);
+            player.SendUpdatePosition();
+        }
