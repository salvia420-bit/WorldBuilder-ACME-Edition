diff --git a/Source/ACE.Server/Vehicles/FlightModel.cs b/Source/ACE.Server/Vehicles/FlightModel.cs
new file mode 100644
index 0000000..1c4d82b
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/FlightModel.cs
@@ -0,0 +1,243 @@
+using System;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>Vehicle modes (wire: VehicleState.Mode).</summary>
+    public static class VehicleMode
+    {
+        public const int Parked = 0;
+        public const int Takeoff = 1;
+        public const int Flight = 2;
+        public const int Landing = 3;
+        public const int Crashed = 4;
+        public const int Derelict = 5;
+
+        public static string Name(int m) => m switch
+        {
+            Parked => "Parked", Takeoff => "Takeoff", Flight => "Flight", Landing => "Landing",
+            Crashed => "Crashed", Derelict => "Derelict", _ => $"?{m}",
+        };
+    }
+
+    /// <summary>Flight state in AC world metres (X = landblockX * 192 + local x, Y likewise; Z up).</summary>
+    public struct FlightState
+    {
+        public double X, Y, Z;
+        /// <summary>Compass radians [0, 2π): 0 = north (+Y), π/2 = east (+X).</summary>
+        public double Heading;
+        /// <summary>Nose up positive.</summary>
+        public double Pitch;
+        /// <summary>Right wing down positive.</summary>
+        public double Bank;
+        public double Speed;
+        public int Mode;
+    }
+
+    /// <summary>One step of pilot input, dequantized exactly as the client predictor does.</summary>
+    public struct FlightInput
+    {
+        public double Throttle; // [0, 1]
+        public double Pitch, Roll, Yaw; // [-1, 1]
+        public bool Boost, Land, Fire;
+
+        public static FlightInput FromFrame(in VehicleInputFrame f) => new FlightInput
+        {
+            Throttle = f.Throttle / 255.0,
+            Pitch = VehicleInputFrame.Stick(f.Pitch),
+            Roll = VehicleInputFrame.Stick(f.Roll),
+            Yaw = VehicleInputFrame.Stick(f.Yaw),
+            Boost = (f.Buttons & VehicleInputFrame.ButtonBoost) != 0,
+            Fire = (f.Buttons & VehicleInputFrame.ButtonFire) != 0,
+            Land = (f.Buttons & VehicleInputFrame.ButtonLand) != 0,
+        };
+
+        /// <summary>No pilot (derelict / autopilot): idle throttle, nose slightly down, wings level.</summary>
+        public static readonly FlightInput Derelict = new FlightInput { Throttle = 0, Pitch = -0.5 };
+    }
+
+    /// <summary>
+    /// Movement numbers as doubles, taken from the f32 profile fields the clients receive, so the server and the
+    /// client predictor integrate with bit-identical constants.
+    /// </summary>
+    public sealed class FlightParams
+    {
+        public double VMin, VCruise, VMax, Accel, Decel, MaxBank, RollRate, MaxPitch, PitchRate, YawRate;
+        public double ClimbMax, SinkMax, FloorAgl, CeilingAgl, TakeoffClimb, LandingSpeed;
+
+        public static FlightParams FromProfile(VehicleProfile p) => new FlightParams
+        {
+            VMin = p.VMin, VCruise = p.VCruise, VMax = p.VMax, Accel = p.Accel, Decel = p.Decel,
+            MaxBank = p.MaxBank, RollRate = p.RollRate, MaxPitch = p.MaxPitch, PitchRate = p.PitchRate, YawRate = p.YawRate,
+            ClimbMax = p.ClimbMax, SinkMax = p.SinkMax, FloorAgl = p.FloorAgl, CeilingAgl = p.CeilingAgl,
+            TakeoffClimb = p.TakeoffClimb, LandingSpeed = p.LandingSpeed,
+        };
+    }
+
+    /// <summary>
+    /// The Air locomotion model, v1 (DESIGN.md §4.4) — arcade, deterministic, double precision.
+    ///
+    /// SPECIFIED ONCE, IMPLEMENTED TWICE: this file (authoritative, server) and holtburger
+    /// apps/holtburger-web/scene3d/vehicle/flight_model.js (the pilot's predictor). Keep the operation ORDER identical;
+    /// the golden-trajectory test (ACE.Server.Tests/Vehicles + tests/vehicle_flight.test.mjs) holds them within 1 mm
+    /// after 30 s. `ground(x, y)` returns the retail terrain height or NaN when unknown (then no clamps apply).
+    /// </summary>
+    public static class FlightModel
+    {
+        public const double Gravity = 9.8;
+        public const int SimHz = 30;
+        public const double Dt = 1.0 / SimHz;
+        /// <summary>Parked → Takeoff when the throttle is at least this.</summary>
+        public const double TakeoffThrottle = 0.25;
+        /// <summary>Coordinated-turn speed floor (avoids g·tanφ/v blowing up at low speed).</summary>
+        public const double MinTurnSpeed = 10.0;
+        /// <summary>Flight → Landing once the speed is within this of LandingSpeed (with Land held).</summary>
+        public const double LandingSpeedSlack = 0.5;
+        public const double WorldMin = 0.5;
+        public const double WorldMax = 256.0 * 192.0 - 0.5;
+        const double TwoPi = 2.0 * Math.PI;
+
+        public static double MoveToward(double cur, double target, double maxDelta)
+        {
+            var d = target - cur;
+            if (d > maxDelta) d = maxDelta;
+            else if (d < -maxDelta) d = -maxDelta;
+            return cur + d;
+        }
+
+        public static double WrapHeading(double h) => h - TwoPi * Math.Floor(h / TwoPi);
+
+        static double Clamp(double v, double lo, double hi) => v < lo ? lo : (v > hi ? hi : v);
+
+        /// <summary>Advance one fixed step. `vCap` is the speed cap in force (profile cap, lowered by back-pressure).</summary>
+        public static void Step(ref FlightState s, in FlightInput u, FlightParams p, double vCap, Func<double, double, double> ground, double dt = Dt)
+        {
+            switch (s.Mode)
+            {
+                case VehicleMode.Parked:
+                {
+                    s.Speed = 0.0;
+                    s.Pitch = 0.0;
+                    s.Bank = 0.0;
+                    s.Heading = WrapHeading(s.Heading + u.Yaw * p.YawRate * dt);
+                    var g = ground(s.X, s.Y);
+                    if (!double.IsNaN(g)) s.Z = g;
+                    if (u.Throttle >= TakeoffThrottle && !u.Land)
+                        s.Mode = VehicleMode.Takeoff;
+                    return;
+                }
+                case VehicleMode.Takeoff:
+                {
+                    s.Speed = 0.0;
+                    s.Bank = MoveToward(s.Bank, 0.0, p.RollRate * dt);
+                    s.Pitch = MoveToward(s.Pitch, 0.0, p.PitchRate * dt);
+                    s.Heading = WrapHeading(s.Heading + u.Yaw * p.YawRate * dt);
+                    s.Z = s.Z + p.TakeoffClimb * dt;
+                    var g = ground(s.X, s.Y);
+                    if (double.IsNaN(g) || s.Z >= g + p.FloorAgl)
+                    {
+                        if (!double.IsNaN(g)) s.Z = g + p.FloorAgl;
+                        s.Mode = VehicleMode.Flight;
+                        s.Speed = Math.Min(p.VMin, vCap);
+                    }
+                    return;
+                }
+                case VehicleMode.Flight:
+                case VehicleMode.Derelict:
+                {
+                    var derelict = s.Mode == VehicleMode.Derelict;
+                    // 1. speed toward the throttle target (Land: LandingSpeed; Boost: VMax), capped
+                    double target;
+                    if (u.Land) target = p.LandingSpeed;
+                    else if (u.Boost) target = p.VMax;
+                    else target = p.VMin + Clamp(u.Throttle, 0.0, 1.0) * (p.VCruise - p.VMin);
+                    if (target > vCap) target = vCap;
+                    s.Speed = MoveToward(s.Speed, target, (target > s.Speed ? p.Accel : p.Decel) * dt);
+                    // 2. attitude toward the sticks at the rate limits
+                    s.Bank = MoveToward(s.Bank, Clamp(u.Roll, -1.0, 1.0) * p.MaxBank, p.RollRate * dt);
+                    s.Pitch = MoveToward(s.Pitch, Clamp(u.Pitch, -1.0, 1.0) * p.MaxPitch, p.PitchRate * dt);
+                    // 3. coordinated turn + rudder
+                    var psiDot = Gravity * Math.Tan(s.Bank) / Math.Max(s.Speed, MinTurnSpeed) + Clamp(u.Yaw, -1.0, 1.0) * p.YawRate;
+                    s.Heading = WrapHeading(s.Heading + psiDot * dt);
+                    // 4. velocity
+                    var w = Clamp(s.Speed * Math.Sin(s.Pitch), -p.SinkMax, p.ClimbMax);
+                    var h = s.Speed * Math.Cos(s.Pitch);
+                    // 5. integrate, then the envelope
+                    var nx = Clamp(s.X + h * Math.Sin(s.Heading) * dt, WorldMin, WorldMax);
+                    var ny = Clamp(s.Y + h * Math.Cos(s.Heading) * dt, WorldMin, WorldMax);
+                    var nz = s.Z + w * dt;
+                    var g = ground(nx, ny);
+                    if (!double.IsNaN(g))
+                    {
+                        if (derelict)
+                        {
+                            if (nz <= g)
+                            {
+                                nz = g;
+                                s.Mode = VehicleMode.Crashed;
+                                s.Speed = 0.0;
+                            }
+                        }
+                        else if (nz < g + p.FloorAgl)
+                            nz = g + p.FloorAgl;
+                        if (nz > g + p.CeilingAgl)
+                            nz = g + p.CeilingAgl;
+                    }
+                    s.X = nx;
+                    s.Y = ny;
+                    s.Z = nz;
+                    if (s.Mode == VehicleMode.Flight && u.Land && s.Speed <= p.LandingSpeed + LandingSpeedSlack)
+                        s.Mode = VehicleMode.Landing;
+                    return;
+                }
+                case VehicleMode.Landing:
+                {
+                    s.Bank = MoveToward(s.Bank, 0.0, p.RollRate * dt);
+                    s.Pitch = MoveToward(s.Pitch, 0.0, p.PitchRate * dt);
+                    s.Speed = MoveToward(s.Speed, 0.0, p.Decel * dt);
+                    s.Heading = WrapHeading(s.Heading + Clamp(u.Yaw, -1.0, 1.0) * p.YawRate * dt);
+                    var nx = Clamp(s.X + s.Speed * Math.Sin(s.Heading) * dt, WorldMin, WorldMax);
+                    var ny = Clamp(s.Y + s.Speed * Math.Cos(s.Heading) * dt, WorldMin, WorldMax);
+                    var nz = s.Z - p.TakeoffClimb * dt;
+                    var g = ground(nx, ny);
+                    if (!double.IsNaN(g) && nz <= g)
+                    {
+                        nz = g;
+                        s.Mode = VehicleMode.Parked;
+                        s.Speed = 0.0;
+                        s.Pitch = 0.0;
+                        s.Bank = 0.0;
+                    }
+                    s.X = nx;
+                    s.Y = ny;
+                    s.Z = nz;
+                    return;
+                }
+                default:
+                    // Crashed: inert
+                    s.Speed = 0.0;
+                    return;
+            }
+        }
+
+        /// <summary>World velocity (m/s) of a state, for dead reckoning in UpdatePosition and for bolts.</summary>
+        public static (double vx, double vy, double vz) Velocity(in FlightState s, FlightParams p)
+        {
+            switch (s.Mode)
+            {
+                case VehicleMode.Takeoff:
+                    return (0, 0, p.TakeoffClimb);
+                case VehicleMode.Landing:
+                    return (s.Speed * Math.Sin(s.Heading), s.Speed * Math.Cos(s.Heading), -p.TakeoffClimb);
+                case VehicleMode.Flight:
+                case VehicleMode.Derelict:
+                {
+                    var w = Clamp(s.Speed * Math.Sin(s.Pitch), -p.SinkMax, p.ClimbMax);
+                    var h = s.Speed * Math.Cos(s.Pitch);
+                    return (h * Math.Sin(s.Heading), h * Math.Cos(s.Heading), w);
+                }
+                default:
+                    return (0, 0, 0);
+            }
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Vehicle.cs b/Source/ACE.Server/Vehicles/Vehicle.cs
new file mode 100644
index 0000000..5523dc7
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Vehicle.cs
@@ -0,0 +1,381 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Enum.Properties;
+using ACE.Entity.Models;
+using ACE.Server.Entity;
+using ACE.Server.Network.GameMessages.Messages;
+using ACE.Server.WorldObjects;
+
+using Position = ACE.Entity.Position;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// Pilot input queue (DESIGN.md §4.3): the server consumes one input per step, in sequence order, never waiting.
+    /// A missing input is substituted with the last one and its sequence number is consumed (a late copy is then
+    /// dropped), so the ack always means "the state after step N of the pilot's inputs".
+    /// </summary>
+    public sealed class PilotInputQueue
+    {
+        readonly SortedDictionary<uint, VehicleInputFrame> pending = new SortedDictionary<uint, VehicleInputFrame>();
+
+        public bool Started;
+        public uint LastConsumedSeq;
+        public VehicleInputFrame Last;
+        public DateTime LastReceivedUtc = DateTime.MinValue;
+
+        // counters
+        public long Received, Duplicates, LateDropped, Substituted, Reanchors, Overflow;
+
+        /// <summary>Frames buffered and not yet consumed.</summary>
+        public int Depth => pending.Count;
+
+        public uint NewestSeq;
+
+        /// <summary>Jitter buffer: wait for this many frames before the first consume.</summary>
+        public const int StartDepth = 2;
+        /// <summary>Above this depth the manager runs a catch-up step.</summary>
+        public const int HighWater = 4;
+        /// <summary>
+        /// Above this depth the oldest frames are dropped (bounded latency). Dropping SKIPS sequence numbers the server
+        /// never stepped (the pilot then sees an N-step correction), so it is only a guard against a client that sends
+        /// faster than real time; a burst after a client stall is absorbed and repaid as step debt instead.
+        /// </summary>
+        public const int MaxDepth = 150;
+        /// <summary>A frame this far behind the consumed sequence means the client stalled: re-anchor on it.</summary>
+        public const uint ReanchorGap = 45;
+
+        public void Add(VehicleInput msg, DateTime nowUtc)
+        {
+            LastReceivedUtc = nowUtc;
+            foreach (var f in msg.Frames)
+            {
+                Received++;
+                if (f.Seq > NewestSeq) NewestSeq = f.Seq;
+                if (Started && f.Seq <= LastConsumedSeq)
+                {
+                    if (LastConsumedSeq - f.Seq > ReanchorGap && f.Seq == msg.Frames[0].Seq)
+                    {
+                        // the client fell far behind the server (its tab stalled): re-anchor on its newest frame
+                        pending.Clear();
+                        LastConsumedSeq = f.Seq - 1;
+                        pending[f.Seq] = f;
+                        Reanchors++;
+                    }
+                    else if (LastConsumedSeq - f.Seq <= 2)
+                        Duplicates++; // redundant copy
+                    else
+                        LateDropped++;
+                    continue;
+                }
+                if (pending.ContainsKey(f.Seq))
+                {
+                    Duplicates++;
+                    continue;
+                }
+                pending[f.Seq] = f;
+            }
+            while (pending.Count > MaxDepth)
+            {
+                using var e = pending.Keys.GetEnumerator();
+                e.MoveNext();
+                var oldest = e.Current;
+                pending.Remove(oldest);
+                Overflow++;
+                if (Started && oldest > LastConsumedSeq) LastConsumedSeq = oldest;
+            }
+        }
+
+        /// <summary>A frame this many sequence numbers past the expected one means the expected one is lost (3× redundancy).</summary>
+        public const uint LostGap = 3;
+
+        /// <summary>
+        /// True when the next step can run on the pilot's own input: the expected frame is buffered, or it is lost
+        /// (newer frames are buffered past the redundancy window, so Next substitutes it), or the jitter buffer filled.
+        /// False = wait (the manager stalls this step and repays it when the frame arrives).
+        /// </summary>
+        public bool HasNext()
+        {
+            if (!Started)
+                return pending.Count >= StartDepth;
+            var expected = LastConsumedSeq + 1;
+            if (pending.ContainsKey(expected))
+                return true;
+            return pending.Count > 0 && NewestSeq >= expected + LostGap;
+        }
+
+        /// <summary>No frame at all for this long: the pilot's client is gone or frozen.</summary>
+        public bool Starving(DateTime nowUtc, double seconds) => (nowUtc - LastReceivedUtc).TotalSeconds > seconds;
+
+        /// <summary>The input for the next step. Substituted = the pilot's frame for this sequence had not arrived.</summary>
+        public VehicleInputFrame Next(out bool substituted)
+        {
+            if (!Started)
+            {
+                if (pending.Count < StartDepth)
+                {
+                    substituted = true;
+                    return Last; // idle (zero) input until the jitter buffer fills
+                }
+                using var e = pending.Keys.GetEnumerator();
+                e.MoveNext();
+                LastConsumedSeq = e.Current - 1;
+                Started = true;
+            }
+            var expected = LastConsumedSeq + 1;
+            if (pending.TryGetValue(expected, out var frame))
+            {
+                pending.Remove(expected);
+                LastConsumedSeq = expected;
+                Last = frame;
+                substituted = false;
+                return frame;
+            }
+            // missing: drop anything older (cannot happen, kept for safety) and substitute
+            LastConsumedSeq = expected;
+            Substituted++;
+            substituted = true;
+            var sub = Last;
+            sub.Seq = expected;
+            Last = sub;
+            return sub;
+        }
+
+        public void Reset()
+        {
+            pending.Clear();
+            Started = false;
+            LastConsumedSeq = 0;
+            NewestSeq = 0;
+            Last = default;
+        }
+    }
+
+    /// <summary>Per-vehicle cost counters (DESIGN.md §4.10).</summary>
+    public sealed class VehicleCosts
+    {
+        public long Steps;
+        public double StepMicrosTotal;
+        public double StepMicrosMax;
+        public long LandblockLoads;
+        public long BytesSent;
+        public long MessagesSent;
+        public long BoltsFired, BoltsHit;
+        public long Corrections; // substituted steps seen by the pilot
+        public double TickMsMax, LastRelocateMs, RelocateMsTotal, RelocateMsMax, LoadMsTotal, LastLoadMs, LoadMsMax;
+        public long Stalls50, Relocations;
+        public long FirstSights, FirstSightsAhead, FirstSightsOver1s;
+        public double PhaseVehicleMs, PhasePilotMs, PhasePilotRelocMonstersMs, PhaseSendMs, PhaseStreamMs;
+        public double FirstSightDistTotal;
+        public readonly List<double> WarnSamples = new List<double>();
+        public readonly Queue<DateTime> RecentLoads = new Queue<DateTime>();
+
+        public int LoadsLast60s(DateTime now)
+        {
+            while (RecentLoads.Count > 0 && (now - RecentLoads.Peek()).TotalSeconds > 60)
+                RecentLoads.Dequeue();
+            return RecentLoads.Count;
+        }
+    }
+
+    /// <summary>
+    /// A vehicle in the world (DESIGN.md §4.1): a standard world object (CreateObject / UpdatePosition with the
+    /// profile's retail stand-in Setup, so every client sees it) whose motion is owned by VehicleManager.
+    /// Not persisted (IsDynamicThatShouldPersistToShard returns false for vehicles).
+    /// </summary>
+    public class Vehicle : WorldObject
+    {
+        /// <summary>Custom weenie class id for vehicles (outside the retail content range; never in the world DB).</summary>
+        public const uint VehicleWeenieClassId = 4_000_001;
+
+        public VehicleProfile Profile { get; private set; }
+        public FlightParams Params { get; private set; }
+        public FlightState State;
+        public uint SimStep;
+        public double StepAccumulator;
+        /// <summary>Steps owed to real time: stalls while the pilot's input had not arrived, repaid when it does.</summary>
+        public int StepDebt;
+        public long Stalls, CatchUps;
+        public uint[] SeatOccupants;
+        public readonly PilotInputQueue Input = new PilotInputQueue();
+        public bool LastStepSubstituted;
+        public int Ammo;
+        public double FireAccumulator;
+        public DateTime ReloadAtUtc = DateTime.MinValue;
+        public uint FireSeed = 0x9E3779B9;
+        public float VCap;
+        public bool BackPressure;
+        /// <summary>The speed cap back-pressure imposes (float.MaxValue = none).</summary>
+        public float BackPressureCap = float.MaxValue;
+        public readonly VehicleStreamState Stream = new VehicleStreamState();
+        public DateTime KeepAliveUtc = DateTime.MinValue;
+        public DateTime RetailChatCheckUtc = DateTime.MinValue;
+        /// <summary>An exit requested during Landing (completed when the vehicle parks).</summary>
+        public uint ExitPending;
+        public Player PendingUnseat;
+        public DateTime SpawnedUtc = DateTime.UtcNow;
+        public DateTime ModeSinceUtc = DateTime.UtcNow;
+        public uint SpawnedBy;
+        public readonly VehicleCosts Costs = new VehicleCosts();
+        /// <summary>Fractional send accumulators (pilot 20 Hz, observers 10 Hz, standard UpdatePosition 10 Hz).</summary>
+        public double PilotStateAcc, ObserverStateAcc, UpdatePosAcc;
+        /// <summary>Sessions that were sent this vehicle's profile (guid → true).</summary>
+        public readonly HashSet<uint> ProfileSentTo = new HashSet<uint>();
+
+        public Vehicle(Weenie weenie, ObjectGuid guid, VehicleProfile profile) : base(weenie, guid)
+        {
+            Profile = profile;
+            Params = FlightParams.FromProfile(profile);
+            SeatOccupants = new uint[Math.Max(1, profile.Seats.Count)];
+            Ammo = profile.Weapons.Count > 0 ? (int)profile.Weapons[0].Magazine : 0;
+            State.Mode = VehicleMode.Parked;
+        }
+
+        /// <summary>Builds the in-memory weenie for a vehicle of this profile (Generic, stuck, ethereal, no gravity).</summary>
+        public static Weenie BuildWeenie(VehicleProfile p)
+        {
+            var w = new Weenie
+            {
+                WeenieClassId = VehicleWeenieClassId,
+                ClassName = "hbvehicle_" + p.Key.Replace('-', '_'),
+                WeenieType = WeenieType.Generic,
+                PropertiesBool = new Dictionary<PropertyBool, bool>
+                {
+                    [PropertyBool.Stuck] = true,
+                    [PropertyBool.Attackable] = false,
+                    [PropertyBool.Ethereal] = true,
+                    [PropertyBool.IgnoreCollisions] = true,
+                    [PropertyBool.ReportCollisions] = false,
+                    [PropertyBool.GravityStatus] = false,
+                },
+                PropertiesDID = new Dictionary<PropertyDataId, uint>
+                {
+                    [PropertyDataId.Setup] = p.StandInSetup,
+                    [PropertyDataId.Icon] = 0x06003711, // the Drudge Balloon's icon
+                },
+                PropertiesFloat = new Dictionary<PropertyFloat, double>
+                {
+                    [PropertyFloat.DefaultScale] = p.StandInScale,
+                    [PropertyFloat.UseRadius] = 6.0,
+                    // never rot: ACE decays dynamic world objects without a TimeToRot after a few minutes
+                    [PropertyFloat.TimeToRot] = -1.0,
+                },
+                PropertiesInt = new Dictionary<PropertyInt, int>
+                {
+                    [PropertyInt.ItemType] = (int)ItemType.Misc,
+                    [PropertyInt.ItemUseable] = (int)Usable.Remote,
+                    [PropertyInt.ShowableOnRadar] = (int)ACE.Entity.Enum.RadarBehavior.ShowAlways,
+                    [PropertyInt.RadarBlipColor] = (int)ACE.Entity.Enum.RadarColor.Yellow,
+                    [PropertyInt.Value] = 0,
+                    [PropertyInt.EncumbranceVal] = 0,
+                },
+                PropertiesString = new Dictionary<PropertyString, string>
+                {
+                    [PropertyString.Name] = p.DisplayName,
+                    [PropertyString.Use] = "A holtburger-web vehicle. Board it from a capable client.",
+                },
+            };
+            return w;
+        }
+
+        public uint Pilot => SeatOccupants.Length > 0 ? SeatOccupants[0] : 0;
+
+        public bool IsParked => State.Mode == VehicleMode.Parked;
+
+        // ------------------------------------------------------------ geometry
+
+        public static Quaternion Orientation(double heading, double pitch, double bank)
+        {
+            var qYaw = Quaternion.CreateFromAxisAngle(Vector3.UnitZ, (float)-heading);
+            var qPitch = Quaternion.CreateFromAxisAngle(Vector3.UnitX, (float)pitch);
+            var qRoll = Quaternion.CreateFromAxisAngle(Vector3.UnitY, (float)bank);
+            return Quaternion.Normalize(qYaw * qPitch * qRoll);
+        }
+
+        public static Quaternion YawOnly(double heading) => Quaternion.CreateFromAxisAngle(Vector3.UnitZ, (float)-heading);
+
+        /// <summary>Global AC metres → a landblock-local outdoor Position (cell = the outdoor land cell).</summary>
+        public static Position ToPosition(double gx, double gy, double gz, Quaternion rot)
+        {
+            var lbX = (int)Math.Floor(gx / 192.0);
+            var lbY = (int)Math.Floor(gy / 192.0);
+            lbX = Math.Clamp(lbX, 0, 255);
+            lbY = Math.Clamp(lbY, 0, 255);
+            var lx = (float)(gx - lbX * 192.0);
+            var ly = (float)(gy - lbY * 192.0);
+            lx = Math.Clamp(lx, 0.0f, 191.999f);
+            ly = Math.Clamp(ly, 0.0f, 191.999f);
+            var cellX = (uint)(lx / 24.0f);
+            var cellY = (uint)(ly / 24.0f);
+            var cell = ((uint)lbX << 24) | ((uint)lbY << 16) | (cellX * 8 + cellY + 1);
+            return new Position(cell, lx, ly, (float)gz, rot.X, rot.Y, rot.Z, rot.W);
+        }
+
+        public static (double x, double y, double z) ToGlobal(Position p)
+        {
+            var x = (p.Cell >> 24) * 192.0 + p.PositionX;
+            var y = ((p.Cell >> 16) & 0xFF) * 192.0 + p.PositionY;
+            return (x, y, p.PositionZ);
+        }
+
+        public Quaternion CurrentOrientation => Orientation(State.Heading, State.Pitch, State.Bank);
+
+        /// <summary>A point in the vehicle frame (x right, y forward, z up) in world coordinates.</summary>
+        public (double x, double y, double z) LocalToWorld(Vector3 local)
+        {
+            var v = Vector3.Transform(local, CurrentOrientation);
+            return (State.X + v.X, State.Y + v.Y, State.Z + v.Z);
+        }
+
+        public Position SeatPosition(int seat)
+        {
+            var off = seat < Profile.Seats.Count ? Profile.Seats[seat].Offset : Vector3.Zero;
+            var (x, y, z) = LocalToWorld(off);
+            return ToPosition(x, y, z, YawOnly(State.Heading));
+        }
+
+        public Position VehiclePosition() => ToPosition(State.X, State.Y, State.Z, CurrentOrientation);
+
+        public Vector3 WorldVelocity()
+        {
+            var (vx, vy, vz) = FlightModel.Velocity(State, Params);
+            return new Vector3((float)vx, (float)vy, (float)vz);
+        }
+
+        public VehicleStateMsg BuildStateMsg(bool pilotCopy)
+        {
+            var pos = VehiclePosition();
+            byte flags = 0;
+            if (pilotCopy) flags |= VehicleStateMsg.FlagPilotCopy;
+            if (pilotCopy && LastStepSubstituted) flags |= VehicleStateMsg.FlagInputSubstituted;
+            if (BackPressure) flags |= VehicleStateMsg.FlagBackPressure;
+            return new VehicleStateMsg
+            {
+                Vehicle = Guid.Full,
+                Step = SimStep,
+                AckInputSeq = pilotCopy ? Input.LastConsumedSeq : 0,
+                Cell = pos.Cell,
+                Position = pos.Pos,
+                Heading = (float)State.Heading,
+                Pitch = (float)State.Pitch,
+                Bank = (float)State.Bank,
+                Speed = (float)State.Speed,
+                VCap = VCap,
+                Ammo = (ushort)Math.Clamp(Ammo, 0, ushort.MaxValue),
+                Mode = (byte)State.Mode,
+                Flags = flags,
+            };
+        }
+
+        public override void ActOnUse(WorldObject activator)
+        {
+            // Retail clients (and holtburger-web without ?vehicles) Use the stand-in: explain, never board.
+            if (activator is Player player)
+                VehicleManager.HandleRetailUse(player, this);
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/VehicleBailout.cs b/Source/ACE.Server/Vehicles/VehicleBailout.cs
new file mode 100644
index 0000000..17e9ed7
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleBailout.cs
@@ -0,0 +1,223 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Numerics;
+
+using log4net;
+
+using ACE.Server.Network.GameMessages.Messages;
+using ACE.Server.WorldObjects;
+
+using Position = ACE.Entity.Position;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// Bail-out (DESIGN.md §4.8, milestone M4): the seat empties and the player becomes a falling body SIMULATED BY
+    /// THE SERVER (so ACE's own falling logic never applies twice): gravity, drag to a 50 m/s terminal speed, the
+    /// inherited horizontal speed decaying; the parachute opens at 150 m above the ground (or on command: VehicleExit
+    /// mode 2) → 5 m/s descent, 8 m/s glide along the heading; touchdown → on foot (ACE rules again). No fall damage on a
+    /// parachute landing (vertical speed ≤ 6 m/s); without the chute ACE's falling-damage formula applies.
+    /// The empty vehicle goes derelict (glide, crash, despawn after 10 s — VehicleManager).
+    /// Retail clients see the body fall and land through standard UpdatePositions; capable clients get Bail / Chute /
+    /// Touchdown events and run the same model locally (scene3d/vehicle/fall_model.js), re-anchored on each event.
+    /// </summary>
+    public static class VehicleBailout
+    {
+        static readonly ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
+
+        public const double Gravity = 9.8;
+        public const double TerminalSpeed = 50.0;
+        public const double HorizontalTau = 4.0;
+        public const double ChuteAgl = 150.0;
+        public const double ChuteSink = 5.0;
+        public const double ChuteGlide = 8.0;
+        public const double ChuteDecel = 15.0;
+        public const double SafeLandingSpeed = 6.0;
+        const double Dt = FlightModel.Dt;
+        const double UpdatePositionHz = 10.0;
+
+        public sealed class FallState
+        {
+            public Player Player;
+            public uint Vehicle;
+            public double X, Y, Z, Vx, Vy, Vz, Heading;
+            public bool Chute;
+            public double Acc, UpdAcc;
+            public uint Steps;
+            public DateTime StartedUtc = DateTime.UtcNow;
+            public double StartAgl;
+        }
+
+        static readonly Dictionary<uint, FallState> falls = new Dictionary<uint, FallState>();
+        static readonly Stopwatch clock = Stopwatch.StartNew();
+        static double last;
+
+        public static int Count => falls.Count;
+
+        public static bool IsFalling(Player player) => player != null && falls.ContainsKey(player.Guid.Full);
+
+        static double MoveToward(double cur, double target, double maxDelta) => FlightModel.MoveToward(cur, target, maxDelta);
+
+        /// <summary>One step of the fall model (mirrored by the client's fall_model.js).</summary>
+        public static void StepFall(ref double x, ref double y, ref double z, ref double vx, ref double vy, ref double vz,
+            double heading, bool chute, double dt)
+        {
+            if (!chute)
+            {
+                vz -= Gravity * dt;
+                if (vz < -TerminalSpeed) vz = -TerminalSpeed;
+                var k = Math.Exp(-dt / HorizontalTau);
+                vx *= k;
+                vy *= k;
+            }
+            else
+            {
+                vz = MoveToward(vz, -ChuteSink, ChuteDecel * dt);
+                vx = MoveToward(vx, Math.Sin(heading) * ChuteGlide, ChuteDecel * 0.5 * dt);
+                vy = MoveToward(vy, Math.Cos(heading) * ChuteGlide, ChuteDecel * 0.5 * dt);
+            }
+            x = Math.Clamp(x + vx * dt, FlightModel.WorldMin, FlightModel.WorldMax);
+            y = Math.Clamp(y + vy * dt, FlightModel.WorldMin, FlightModel.WorldMax);
+            z += vz * dt;
+        }
+
+        public static void Bail(Vehicle v, Player player)
+        {
+            var seat = v.SeatPosition(0);
+            var (sx, sy, sz) = Vehicle.ToGlobal(seat);
+            var vel = v.WorldVelocity();
+            var heading = v.State.Heading;
+            VehicleManager.Unseat(v, player, placeOnGround: false);
+            var g = VehicleTerrain.Ground(sx, sy);
+            var f = new FallState
+            {
+                Player = player, Vehicle = v.Guid.Full, X = sx, Y = sy, Z = sz, Vx = vel.X, Vy = vel.Y, Vz = vel.Z,
+                Heading = heading, StartAgl = double.IsNaN(g) ? 0 : sz - g,
+            };
+            falls[player.Guid.Full] = f;
+            // Value = the vehicle's heading at the bail: the chute glides along it (the client needs the same number)
+            VehicleManager.BroadcastEvent(v, VehicleEventKind.Bail, player.Guid.Full, (float)heading, seat, player);
+            log.Info($"[VEHICLE] {player.Name} bailed out of {v.Name} 0x{v.Guid.Full:X8} at {f.StartAgl:0} m AGL");
+        }
+
+        /// <summary>VehicleExit mode 2 while falling: open the parachute now.</summary>
+        public static void OpenChute(Player player)
+        {
+            if (!falls.TryGetValue(player.Guid.Full, out var f) || f.Chute)
+                return;
+            OpenChute(f);
+        }
+
+        static void OpenChute(FallState f)
+        {
+            f.Chute = true;
+            var pos = Vehicle.ToPosition(f.X, f.Y, f.Z, Vehicle.YawOnly(f.Heading));
+            var v = VehicleManager.Get(f.Vehicle);
+            if (v != null && !v.IsDestroyed && v.PhysicsObj != null)
+                VehicleManager.BroadcastEvent(v, VehicleEventKind.Chute, f.Player.Guid.Full, (float)f.Vz, pos, f.Player);
+            else
+                VehicleManager.SendEventTo(f.Player, f.Vehicle, VehicleEventKind.Chute, (float)f.Vz, pos);
+        }
+
+        public static void Tick()
+        {
+            var now = clock.Elapsed.TotalSeconds;
+            var elapsed = Math.Min(0.5, now - last);
+            last = now;
+            if (falls.Count == 0)
+                return;
+            List<FallState> done = null;
+            foreach (var f in falls.Values)
+            {
+                var p = f.Player;
+                if (p == null || p.PhysicsObj == null || p.IsLoggingOut)
+                {
+                    (done ??= new List<FallState>()).Add(f);
+                    continue;
+                }
+                f.Acc += elapsed;
+                var landed = false;
+                while (f.Acc >= Dt && !landed)
+                {
+                    f.Acc -= Dt;
+                    StepFall(ref f.X, ref f.Y, ref f.Z, ref f.Vx, ref f.Vy, ref f.Vz, f.Heading, f.Chute, Dt);
+                    f.Steps++;
+                    var g = VehicleTerrain.Ground(f.X, f.Y);
+                    if (!double.IsNaN(g))
+                    {
+                        if (!f.Chute && f.Z - g <= ChuteAgl)
+                            OpenChute(f);
+                        if (f.Z <= g)
+                        {
+                            f.Z = g;
+                            landed = true;
+                        }
+                    }
+                }
+                var pos = Vehicle.ToPosition(f.X, f.Y, f.Z + (landed ? 0.05 : 0), Vehicle.YawOnly(f.Heading));
+                VehicleManager.MoveBody(p, pos);
+                if (landed)
+                {
+                    Land(f, pos);
+                    (done ??= new List<FallState>()).Add(f);
+                    continue;
+                }
+                f.UpdAcc += elapsed * UpdatePositionHz;
+                if (f.UpdAcc >= 1.0)
+                {
+                    f.UpdAcc = Math.Min(f.UpdAcc - 1.0, 1.0);
+                    // to everyone else: the capable client of the falling player runs the model itself
+                    p.EnqueueBroadcast(false, new GameMessageVehicleUpdatePosition(p, new Vector3((float)f.Vx, (float)f.Vy, (float)f.Vz), false));
+                }
+            }
+            if (done != null)
+                foreach (var f in done)
+                    falls.Remove(f.Player?.Guid.Full ?? 0);
+        }
+
+        static void Land(FallState f, Position pos)
+        {
+            var p = f.Player;
+            var impact = -f.Vz;
+            VehicleManager.PlaceBody(p, pos);
+            if (!f.Chute && impact > SafeLandingSpeed)
+            {
+                // ACE's falling-damage formula (Player.HandleFallingDamage): overspeed beyond a jump's velocity
+                var jumpVelocity = 11.25434;
+                var overspeed = jumpVelocity - impact + 4.5;
+                var ratio = -overspeed / jumpVelocity;
+                if (ratio > 0)
+                    p.TakeDamage_Falling((float)(ratio * 87.293810));
+            }
+            var v = VehicleManager.Get(f.Vehicle);
+            if (v != null && !v.IsDestroyed && v.PhysicsObj != null)
+                VehicleManager.BroadcastEvent(v, VehicleEventKind.Touchdown, p.Guid.Full, (float)impact, pos, p);
+            else
+                VehicleManager.SendEventTo(p, f.Vehicle, VehicleEventKind.Touchdown, (float)impact, pos);
+            log.Info($"[VEHICLE] {p.Name} touched down at {impact:0.0} m/s (chute={f.Chute}) after {f.Steps / 30.0:0.0} s from {f.StartAgl:0} m AGL");
+        }
+
+        /// <summary>Logout while falling: put the body on the ground under it now (never saved in the air).</summary>
+        public static void LandNow(Player player)
+        {
+            if (!falls.TryGetValue(player.Guid.Full, out var f))
+                return;
+            var g = VehicleTerrain.Ground(f.X, f.Y);
+            f.Z = double.IsNaN(g) ? f.Z : g;
+            f.Vz = -ChuteSink;
+            f.Chute = true;
+            Land(f, Vehicle.ToPosition(f.X, f.Y, f.Z + 0.05, Vehicle.YawOnly(f.Heading)));
+            falls.Remove(player.Guid.Full);
+        }
+
+        /// <summary>A teleport while falling ends the fall (the teleport places the body).</summary>
+        public static void Cancel(Player player)
+        {
+            if (player != null)
+                falls.Remove(player.Guid.Full);
+        }
+
+        public static string Report() => $"falling: {falls.Count}";
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/VehicleCommands.cs b/Source/ACE.Server/Vehicles/VehicleCommands.cs
new file mode 100644
index 0000000..4aa7437
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleCommands.cs
@@ -0,0 +1,132 @@
+using System;
+using System.Linq;
+
+using ACE.Entity.Enum;
+using ACE.Server.Command;
+using ACE.Server.Command.Handlers;
+using ACE.Server.Entity.Actions;
+using ACE.Server.Factories;
+using ACE.Server.Managers;
+using ACE.Server.Network;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>Admin commands for the vehicles demo (DESIGN.md §4.1, §4.10).</summary>
+    public static class VehicleCommands
+    {
+        [CommandHandler("vehicle", AccessLevel.Developer, CommandHandlerFlag.RequiresWorld, 1,
+            "holtburger vehicles demo.",
+            "spawn [profile]   - park a vehicle (default hellcat-demo) on open ground 6 m in front of you\n" +
+            "despawn [all]     - remove the nearest vehicle (or all)\n" +
+            "list              - list vehicles\n" +
+            "terrain           - the vehicle terrain sampler's height under you (parity check vs the client)\n" +
+            "board             - (debug) seat yourself in the nearest vehicle regardless of capability")]
+        public static void HandleVehicle(Session session, params string[] parameters)
+        {
+            var player = session.Player;
+            switch (parameters[0].ToLowerInvariant())
+            {
+                case "spawn":
+                {
+                    var key = parameters.Length > 1 ? parameters[1] : "hellcat-demo";
+                    var profile = VehicleProfile.ByKey(key);
+                    if (profile == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"unknown vehicle profile '{key}' (known: hellcat-demo)");
+                        return;
+                    }
+                    var v = VehicleManager.Spawn(player, profile, out var error);
+                    CommandHandlerHelper.WriteOutputInfo(session, v != null
+                        ? $"spawned {profile.DisplayName} 0x{v.Guid.Full:X8} at {v.Location.ToLOCString()}"
+                        : $"vehicle spawn failed: {error}");
+                    return;
+                }
+                case "despawn":
+                {
+                    if (parameters.Length > 1 && parameters[1].Equals("all", StringComparison.OrdinalIgnoreCase))
+                    {
+                        var all = VehicleManager.All.ToList();
+                        foreach (var v in all)
+                            VehicleManager.Despawn(v, $"@vehicle despawn all by {player.Name}");
+                        CommandHandlerHelper.WriteOutputInfo(session, $"despawned {all.Count} vehicle(s)");
+                        return;
+                    }
+                    var nearest = VehicleManager.All.OrderBy(v => v.Location.DistanceTo(player.Location)).FirstOrDefault();
+                    if (nearest == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "no vehicles");
+                        return;
+                    }
+                    VehicleManager.Despawn(nearest, $"@vehicle despawn by {player.Name}");
+                    CommandHandlerHelper.WriteOutputInfo(session, $"despawned 0x{nearest.Guid.Full:X8}");
+                    return;
+                }
+                case "list":
+                    CommandHandlerHelper.WriteOutputInfo(session, VehicleManager.CostReport());
+                    return;
+                case "terrain":
+                {
+                    var (x, y, z) = Vehicle.ToGlobal(player.Location);
+                    var g = VehicleTerrain.HeightAt((float)x, (float)y);
+                    CommandHandlerHelper.WriteOutputInfo(session,
+                        $"terrain at world ({x:0.000}, {y:0.000}) = {g:R} (player z {z:0.000}, cell 0x{player.Location.Cell:X8})");
+                    return;
+                }
+                case "board":
+                {
+                    var nearest = VehicleManager.All.OrderBy(v => v.Location.DistanceTo(player.Location)).FirstOrDefault();
+                    if (nearest == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "no vehicles");
+                        return;
+                    }
+                    var caps = session.VehicleCapabilities;
+                    session.VehicleCapabilities |= VehicleWire.CapPilot;
+                    VehicleManager.HandleBoard(session, new VehicleBoard { Vehicle = nearest.Guid.Full, Seat = 0 });
+                    session.VehicleCapabilities = caps | (VehicleManager.IsSeated(player) ? VehicleWire.CapPilot : 0);
+                    return;
+                }
+                default:
+                    CommandHandlerHelper.WriteOutputInfo(session, "usage: @vehicle spawn [profile] | despawn [all] | list | terrain | board");
+                    return;
+            }
+        }
+
+        [CommandHandler("vehicles", AccessLevel.Developer, CommandHandlerFlag.None, 0,
+            "holtburger vehicles: per-vehicle costs (steps, step time, landblock loads, input queue, bytes/s, bolts).")]
+        public static void HandleVehicles(Session session, params string[] parameters)
+        {
+            if (session == null)
+            {
+                // console thread: read on the world thread
+                WorldManager.EnqueueAction(new ActionEventDelegate(() => CommandHandlerHelper.WriteOutputInfo(null, VehicleManager.CostReport())));
+                return;
+            }
+            CommandHandlerHelper.WriteOutputInfo(session, VehicleManager.CostReport());
+        }
+
+        [CommandHandler("vehicle-createbench", AccessLevel.Developer, CommandHandlerFlag.None, 1,
+            "holtburger vehicles (M3 diagnosis): time WorldObjectFactory.CreateNewWorldObject on the world thread.",
+            "<wcid> [count]  - create count (default 5) objects off-world, report each creation time, destroy them")]
+        public static void HandleCreateBench(Session session, params string[] parameters)
+        {
+            if (!uint.TryParse(parameters[0], out var wcid))
+                return;
+            var count = parameters.Length > 1 && int.TryParse(parameters[1], out var c) ? Math.Clamp(c, 1, 50) : 5;
+            WorldManager.EnqueueAction(new ActionEventDelegate(() =>
+            {
+                var times = new System.Collections.Generic.List<double>();
+                string name = null;
+                for (var i = 0; i < count; i++)
+                {
+                    var sw = System.Diagnostics.Stopwatch.StartNew();
+                    var wo = WorldObjectFactory.CreateNewWorldObject(wcid);
+                    times.Add(sw.Elapsed.TotalMilliseconds);
+                    name ??= wo?.Name;
+                    wo?.Destroy();
+                }
+                CommandHandlerHelper.WriteOutputInfo(session, $"createbench wcid {wcid} ({name}): {string.Join(", ", times.Select(t => t.ToString("0.00")))} ms");
+            }));
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/VehicleManager.cs b/Source/ACE.Server/Vehicles/VehicleManager.cs
new file mode 100644
index 0000000..9bbd3d0
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/VehicleManager.cs
@@ -0,0 +1,959 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Linq;
+using System.Numerics;
+using System.Text;
+
+using log4net;
+
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Server.Entity;
+using ACE.Server.Managers;
+using ACE.Server.Network;
+using ACE.Server.Network.GameEvent.Events;
+using ACE.Server.Network.GameMessages;
+using ACE.Server.Network.GameMessages.Messages;
+using ACE.Server.Physics;
+using ACE.Server.WorldObjects;
+
+using Position = ACE.Entity.Position;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// The vehicle registry and simulation ("what is coming at the server", DESIGN.md §4.2).
+    ///
+    /// Ticked from WorldManager.UpdateGameWorld right BEFORE LandblockManager.Tick, on the world thread, so vehicles and
+    /// their pilots are placed before landblock physics and visibility run. Fixed 30 Hz steps (accumulator, catch-up
+    /// capped). Everything here runs on the world thread: game-action handlers (inbound queue), the tick and the
+    /// in-game commands. Behind the vehicles_enabled server property: off = no vehicle can be spawned and every HBV1
+    /// action is ignored.
+    /// </summary>
+    public static class VehicleManager
+    {
+        static readonly ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
+
+        public const ushort SimHz = FlightModel.SimHz;
+        const double Dt = FlightModel.Dt;
+        const int MaxStepsPerTick = 8;
+        /// <summary>VehicleState rates (DESIGN §5): pilot 20 Hz, capable observers 10 Hz; standard UpdatePosition 10 Hz.</summary>
+        const double PilotStateHz = 20.0, ObserverStateHz = 10.0, UpdatePositionHz = 10.0;
+        const double BoardDistance = 8.0;
+        const double InputTimeoutSeconds = 3.0;
+        const double CrashedDespawnSeconds = 10.0;
+        /// <summary>A vehicle tick longer than this is a world-thread stall caused by a vehicle (M3 criterion: none).</summary>
+        const double StallWarnMs = 50.0;
+
+        static readonly Dictionary<uint, Vehicle> vehicles = new Dictionary<uint, Vehicle>();
+        /// <summary>player guid → (vehicle guid, seat)</summary>
+        static readonly Dictionary<uint, (uint vehicle, int seat)> seated = new Dictionary<uint, (uint, int)>();
+        static readonly Stopwatch clock = Stopwatch.StartNew();
+        static double lastTickSeconds;
+
+        // global counters
+        public static long TotalSteps, TotalLandblockLoads, BackPressureEvents;
+        public static double LastTickMicros, MaxTickMicros;
+
+        public static bool Enabled => PropertyManager.GetBool("vehicles_enabled", false).Item;
+        public static float SpeedCap => (float)PropertyManager.GetDouble("vehicle_speed_cap", 69.0).Item;
+        /// <summary>First-sight radius for seated pilots (M3; 112.5 = ACE's own). Landmarks only beyond 112.5 m.</summary>
+        public static float SightRadius => (float)Math.Max(Physics.Common.ObjectMaint.InitialClamp_Dist, PropertyManager.GetDouble("vehicle_sight_radius", 112.5).Item);
+
+        public static int Count => vehicles.Count;
+        public static IEnumerable<Vehicle> All => vehicles.Values;
+
+        public static Vehicle Get(uint guid) => vehicles.TryGetValue(guid, out var v) ? v : null;
+
+        public static bool IsSeated(Player player) => player != null && seated.ContainsKey(player.Guid.Full);
+
+        public static Vehicle VehicleOf(Player player) =>
+            player != null && seated.TryGetValue(player.Guid.Full, out var s) ? Get(s.vehicle) : null;
+
+        static bool HasCap(Session session, uint cap) => session != null && (session.VehicleCapabilities & cap) != 0;
+
+        // ================================================================ tick
+
+        public static void Tick()
+        {
+            LandblockManager.WorldThreadId = Environment.CurrentManagedThreadId;
+            CoWindowWorstMs = 0;
+            CoWindowWorstDesc = "";
+            if (!warmupStarted && Enabled)
+                StartWarmup();
+            VehicleStreaming.ResetBringUpBudget();
+            VehicleStreaming.BeginTick();
+            InVehicleTick = true;
+            try
+            {
+                TickInner();
+            }
+            finally
+            {
+                InVehicleTick = false;
+            }
+        }
+
+        /// <summary>True on the world thread while VehicleManager.Tick runs (landblock loads then are vehicle-caused).</summary>
+        public static bool InVehicleTick;
+
+        static void TickInner()
+        {
+            var now = clock.Elapsed.TotalSeconds;
+            var elapsed = now - lastTickSeconds;
+            lastTickSeconds = now;
+            if (vehicles.Count == 0)
+                return;
+            // a world stall: the time is NOT dropped — piloted vehicles owe the steps (repaid as catch-up), the others
+            // cap it in TickVehicle
+            if (elapsed > 5.0) elapsed = 5.0;
+
+            var sw = Stopwatch.StartNew();
+            var speedCap = SpeedCap;
+            List<(Vehicle v, string why)> despawn = null;
+
+            foreach (var v in vehicles.Values)
+            {
+                if (v.IsDestroyed || v.PhysicsObj == null)
+                {
+                    (despawn ??= new List<(Vehicle, string)>()).Add((v, v.IsDestroyed ? "world object destroyed" : "physics object gone"));
+                    continue;
+                }
+                v.VCap = v.BackPressure ? Math.Min(speedCap, v.BackPressureCap) : speedCap;
+                var loads0 = v.Costs.LandblockLoads;
+                var gcPause0 = GC.GetTotalPauseDuration();
+                var gc2Count0 = GC.CollectionCount(2);
+                var tv = Stopwatch.GetTimestamp();
+                TickVehicle(v, elapsed);
+                var ms = (Stopwatch.GetTimestamp() - tv) * 1000.0 / Stopwatch.Frequency;
+                if (ms > v.Costs.TickMsMax) v.Costs.TickMsMax = ms;
+                if (ms > StallWarnMs)
+                {
+                    v.Costs.Stalls50++;
+                    log.Warn($"[VEHICLE][STALL] {v.Name} 0x{v.Guid.Full:X8} tick took {ms:0.0} ms (landblock loads {v.Costs.LandblockLoads - loads0}, last load {v.Costs.LastLoadMs:0.0} ms, relocate {v.Costs.LastRelocateMs:0.0} ms; " +
+                        $"phases: vehicle {v.Costs.PhaseVehicleMs:0.0}, pilot {v.Costs.PhasePilotMs:0.0} (reloc+monsters {v.Costs.PhasePilotRelocMonstersMs:0.0}; last visibility gather+admit {VisLastHandleMs:0.0} / CreateObjects {VisLastEnqueueMs:0.0} for {VisLastNew}; worst object this tick {CoWindowWorstMs:0.0} ms {CoWindowWorstDesc}; lock waits max {LandblockManager.LockWaitMaxMs:0.0} ms {LandblockManager.LockWaitMaxWhat}), send {v.Costs.PhaseSendMs:0.0}, streaming {v.Costs.PhaseStreamMs:0.0} ms; GC pauses during the tick {(GC.GetTotalPauseDuration() - gcPause0).TotalMilliseconds:0.0} ms, gen2 +{GC.CollectionCount(2) - gc2Count0}) at {v.Location.ToLOCString()}");
+                }
+                if (v.State.Mode == VehicleMode.Crashed && (DateTime.UtcNow - v.ModeSinceUtc).TotalSeconds >= CrashedDespawnSeconds)
+                    (despawn ??= new List<(Vehicle, string)>()).Add((v, "crashed"));
+            }
+
+            if (despawn != null)
+                foreach (var (v, why) in despawn)
+                {
+                    if (why != "crashed")
+                        log.Warn($"[VEHICLE] {v.Name} 0x{v.Guid.Full:X8}: {why} outside VehicleManager — despawning");
+                    Despawn(v, why);
+                }
+
+            LastTickMicros = sw.Elapsed.TotalMilliseconds * 1000.0;
+            if (LastTickMicros > MaxTickMicros) MaxTickMicros = LastTickMicros;
+        }
+
+        /// <summary>A piloted vehicle steps only on the pilot's inputs: after this long without any, it steps on its own.</summary>
+        const double StarvationSeconds = 2.5;
+        /// <summary>Steps owed beyond this are forgiven (the pilot's client runs slower than real time).</summary>
+        const int MaxStepDebt = 150;
+        const int MaxCatchUpPerTick = 10;
+
+        static void TickVehicle(Vehicle v, double elapsed)
+        {
+            v.StepAccumulator += elapsed;
+            var budget = (int)(v.StepAccumulator / Dt);
+            v.StepAccumulator -= budget * Dt;
+            if (budget > MaxStepsPerTick)
+            {
+                // a world-thread stall: the steps beyond the cap are owed, not lost (they are repaid as catch-up)
+                v.StepDebt += budget - MaxStepsPerTick;
+                budget = MaxStepsPerTick;
+            }
+
+            var pilot = PilotOf(v);
+            var ran = 0;
+            if (pilot == null || v.State.Mode == VehicleMode.Derelict || v.State.Mode == VehicleMode.Crashed)
+            {
+                // nobody flying: real-time steps, a stall's excess is simply skipped
+                for (var i = 0; i < budget; i++) { StepVehicle(v, pilot); ran++; }
+                v.StepDebt = 0;
+            }
+            else
+            {
+                // Input-driven (decisions log #15): the server's state after step N is a function of the pilot's inputs
+                // up to N only, so the pilot's prediction stays exact. A step whose input has not arrived is STALLED and
+                // owed; it is repaid (up to 3 extra per tick) once the input is there. A client silent for a second
+                // gets real-time steps on its last input (and is re-anchored when it comes back).
+                var now = DateTime.UtcNow;
+                var starving = v.Input.Starving(now, StarvationSeconds);
+                for (var i = 0; i < budget; i++)
+                {
+                    if (starving || v.Input.HasNext()) { StepVehicle(v, pilot); ran++; }
+                    else { v.StepDebt++; v.Stalls++; }
+                }
+                var extra = 0;
+                while (v.StepDebt > 0 && extra < MaxCatchUpPerTick && v.Input.HasNext())
+                {
+                    StepVehicle(v, pilot);
+                    v.StepDebt--;
+                    extra++;
+                    ran++;
+                    v.CatchUps++;
+                }
+                if (v.StepDebt > MaxStepDebt) v.StepDebt = MaxStepDebt;
+                if (starving) v.StepDebt = 0;
+            }
+            // a vehicle keeps its own landblock loaded (ACE unloads landblocks without players after 5 min, which would
+            // destroy a parked vehicle); refreshed every 5 s, this landblock only (no adjacents)
+            if ((DateTime.UtcNow - v.KeepAliveUtc).TotalSeconds > 5)
+            {
+                v.KeepAliveUtc = DateTime.UtcNow;
+                v.CurrentLandblock?.SetActive(true);
+            }
+
+            if (ran == 0)
+                return;
+
+            ApplyToWorld(v, pilot, ran);
+            var ts = Stopwatch.GetTimestamp();
+            VehicleStreaming.Tick(v, pilot);
+            v.Costs.PhaseStreamMs = (Stopwatch.GetTimestamp() - ts) * 1000.0 / Stopwatch.Frequency;
+            if (v.PendingUnseat != null)
+            {
+                var who = v.PendingUnseat;
+                v.PendingUnseat = null;
+                Unseat(v, who, placeOnGround: true);
+            }
+        }
+
+        static void StepVehicle(Vehicle v, Player pilot)
+        {
+            var t0 = Stopwatch.GetTimestamp();
+            FlightInput u = default;
+            var substituted = false;
+            if (v.State.Mode == VehicleMode.Derelict)
+                u = FlightInput.Derelict;
+            else if (pilot != null)
+            {
+                var frame = v.Input.Next(out substituted);
+                u = FlightInput.FromFrame(frame);
+                if ((DateTime.UtcNow - v.Input.LastReceivedUtc).TotalSeconds > InputTimeoutSeconds)
+                {
+                    // the pilot's client went quiet: level the wings, hold the throttle, never fire
+                    u.Pitch = 0; u.Roll = 0; u.Yaw = 0; u.Fire = false; u.Boost = false;
+                }
+            }
+            v.LastStepSubstituted = substituted;
+            if (substituted && v.Input.Started) v.Costs.Corrections++;
+
+            var prevMode = v.State.Mode;
+            FlightModel.Step(ref v.State, u, v.Params, v.VCap, VehicleTerrain.Ground);
+            v.SimStep++;
+
+            if (pilot != null && u.Fire)
+                VehicleWeapons.StepFire(v, pilot);
+            else
+                v.FireAccumulator = 0;
+
+            if (v.State.Mode != prevMode)
+                OnModeChanged(v, prevMode, pilot);
+
+            var micros = (Stopwatch.GetTimestamp() - t0) * 1_000_000.0 / Stopwatch.Frequency;
+            v.Costs.Steps++;
+            v.Costs.StepMicrosTotal += micros;
+            if (micros > v.Costs.StepMicrosMax) v.Costs.StepMicrosMax = micros;
+            TotalSteps++;
+        }
+
+        static void OnModeChanged(Vehicle v, int prevMode, Player pilot)
+        {
+            v.ModeSinceUtc = DateTime.UtcNow;
+            var kind = v.State.Mode switch
+            {
+                VehicleMode.Flight when prevMode == VehicleMode.Takeoff => VehicleEventKind.Takeoff,
+                VehicleMode.Parked => VehicleEventKind.Landed,
+                VehicleMode.Crashed => VehicleEventKind.Crashed,
+                _ => (VehicleEventKind)0,
+            };
+            if (kind != 0)
+                BroadcastEvent(v, kind, pilot?.Guid.Full ?? 0, 0f);
+            if (v.State.Mode == VehicleMode.Crashed)
+                log.Info($"[VEHICLE] {v.Name} 0x{v.Guid.Full:X8} crashed at {v.VehiclePosition().ToLOCString()}");
+            if (v.State.Mode == VehicleMode.Parked && v.ExitPending != 0)
+            {
+                var who = v.ExitPending;
+                v.ExitPending = 0;
+                if (pilot != null && pilot.Guid.Full == who)
+                    v.PendingUnseat = pilot; // after this step's world placement (TickVehicle)
+            }
+        }
+
+        // ================================================================ world placement
+
+        /// <summary>Moves the vehicle object and its pilot after this tick's steps; fans out state messages.</summary>
+        static void ApplyToWorld(Vehicle v, Player pilot, int steps)
+        {
+            var t0 = Stopwatch.GetTimestamp();
+            MoveWorldObject(v, v.VehiclePosition());
+            var t1 = Stopwatch.GetTimestamp();
+            if (pilot != null)
+                MovePilot(v, pilot, v.SeatPosition(0));
+            var t2 = Stopwatch.GetTimestamp();
+            SendStates(v, pilot, steps);
+            var t3 = Stopwatch.GetTimestamp();
+            double Ms(long a, long b) => (b - a) * 1000.0 / Stopwatch.Frequency;
+            v.Costs.PhaseVehicleMs = Ms(t0, t1);
+            v.Costs.PhasePilotMs = Ms(t1, t2);
+            v.Costs.PhaseSendMs = Ms(t2, t3);
+        }
+
+        static void MoveWorldObject(Vehicle v, Position pos)
+        {
+            var prevLb = v.Location.Landblock;
+            if (pos.Landblock != prevLb)
+                EnsureLoaded(pos, v);
+            v.Location = pos;
+            v.PhysicsObj.set_current_pos(new Physics.Common.Position(pos));
+            if (pos.Landblock != prevLb)
+                Relocate(v, v);
+        }
+
+        /// <summary>
+        /// Loads the landblock of `pos` and its neighbours (what the relocation would load) up front: set_current_pos
+        /// would otherwise load the landblock inside LScape.get_landcell, unaccounted. With vehicle_preload on they are
+        /// normally loaded already.
+        /// </summary>
+        static void EnsureLoaded(Position pos, Vehicle v)
+        {
+            var id = new LandblockId(pos.Cell | 0xFFFF);
+            var lbx = id.LandblockX;
+            var lby = id.LandblockY;
+            Span<bool> before = stackalloc bool[9];
+            var missing = 0;
+            for (var i = 0; i < 9; i++)
+            {
+                before[i] = LandblockManager.GetLoadedLandblock(lbx + i / 3 - 1, lby + i % 3 - 1) != null;
+                if (!before[i]) missing++;
+            }
+            // with off-thread preload a corridor landblock may still be loading on its background task: let it finish
+            // there rather than loading it here (the relocation below would block on the landblock lock anyway)
+            if (missing == 0)
+                return;
+            var t0 = Stopwatch.GetTimestamp();
+            LandblockManager.GetLandblock(id, true);
+            var ms = (Stopwatch.GetTimestamp() - t0) * 1000.0 / Stopwatch.Frequency;
+            var loaded = 0;
+            for (var i = 0; i < 9; i++)
+            {
+                if (before[i]) continue;
+                var lb = LandblockManager.GetLoadedLandblock(lbx + i / 3 - 1, lby + i % 3 - 1);
+                if (lb == null) continue;
+                lb.VehicleOnly = true;
+                loaded++;
+            }
+            v.Costs.LandblockLoads += loaded;
+            TotalLandblockLoads += loaded;
+            for (var i = 0; i < loaded; i++) v.Costs.RecentLoads.Enqueue(DateTime.UtcNow);
+            v.Costs.LoadMsTotal += ms;
+            v.Costs.LastLoadMs = ms;
+            if (ms > v.Costs.LoadMsMax) v.Costs.LoadMsMax = ms;
+        }
+
+        /// <summary>
+        /// The pilot's body is slaved to the seat (DESIGN §4.3): ACE's own player machinery follows unchanged —
+        /// cell-change visibility (set_current_pos → handle_visible_cells), landblock relocation, monster awareness.
+        /// No AutonomousPosition is processed for a seated player, so none of ACE's step checks apply here.
+        /// </summary>
+        static void MovePilot(Vehicle v, Player pilot, Position seatPos)
+        {
+            var prevLb = pilot.Location.Landblock;
+            if (seatPos.Landblock != prevLb)
+                EnsureLoaded(seatPos, v);
+            pilot.Location = seatPos;
+            pilot.PhysicsObj.set_current_pos(new Physics.Common.Position(seatPos));
+            var tc = Stopwatch.GetTimestamp();
+            if (seatPos.Landblock != prevLb)
+                Relocate(pilot, v);
+            if (v.SimStep % 6 == 0)
+                pilot.CheckMonsters();
+            v.Costs.PhasePilotRelocMonstersMs = (Stopwatch.GetTimestamp() - tc) * 1000.0 / Stopwatch.Frequency;
+        }
+
+        static void Relocate(WorldObject wo, Vehicle v)
+        {
+            var wasLoaded = LandblockManager.IsLoaded(wo.Location.LandblockId);
+            // which of the 3×3 the relocation (loadAdjacents) is about to load: those become vehicle-only
+            var lbx = wo.Location.LandblockId.LandblockX;
+            var lby = wo.Location.LandblockId.LandblockY;
+            Span<bool> before = stackalloc bool[9];
+            for (var i = 0; i < 9; i++)
+                before[i] = LandblockManager.GetLoadedLandblock(lbx + i / 3 - 1, lby + i % 3 - 1) != null;
+            var t0 = Stopwatch.GetTimestamp();
+            LandblockManager.RelocateObjectForPhysics(wo, true);
+            for (var i = 0; i < 9; i++)
+            {
+                if (before[i]) continue;
+                var lb = LandblockManager.GetLoadedLandblock(lbx + i / 3 - 1, lby + i % 3 - 1);
+                if (lb != null) lb.VehicleOnly = true;
+            }
+            v.Costs.LastRelocateMs = (Stopwatch.GetTimestamp() - t0) * 1000.0 / Stopwatch.Frequency;
+            v.Costs.RelocateMsTotal += v.Costs.LastRelocateMs;
+            v.Costs.Relocations++;
+            if (v.Costs.LastRelocateMs > v.Costs.RelocateMsMax) v.Costs.RelocateMsMax = v.Costs.LastRelocateMs;
+            if (!wasLoaded)
+            {
+                v.Costs.LandblockLoads++;
+                v.Costs.RecentLoads.Enqueue(DateTime.UtcNow);
+                TotalLandblockLoads++;
+            }
+        }
+
+        /// <summary>Retail indication (DESIGN §5, M5): seconds between two chat lines to the same standard client.</summary>
+        const double RetailChatPerPlayerSeconds = 60.0;
+        const float RetailChatRange = 250f;
+        static readonly Dictionary<uint, DateTime> retailChatAt = new Dictionary<uint, DateTime>();
+        public static bool RetailChat => PropertyManager.GetBool("vehicle_retail_chat", false).Item;
+
+        /// <summary>
+        /// A standard (non-capable) client near a flying vehicle gets one local system line a minute — standard chat,
+        /// no new opcode. Capable clients draw the vehicle and never get it.
+        /// </summary>
+        static void RetailIndication(Vehicle v, List<Player> observers)
+        {
+            if (!RetailChat || (v.State.Mode != VehicleMode.Flight && v.State.Mode != VehicleMode.Derelict))
+                return;
+            var now = DateTime.UtcNow;
+            if ((now - v.RetailChatCheckUtc).TotalSeconds < 2)
+                return;
+            v.RetailChatCheckUtc = now;
+            foreach (var p in observers)
+            {
+                if (p.Session == null || HasCap(p.Session, VehicleWire.CapObserve) || VehicleOf(p) == v)
+                    continue;
+                if (p.Location.DistanceTo(v.Location) > RetailChatRange)
+                    continue;
+                if (retailChatAt.TryGetValue(p.Guid.Full, out var at) && (now - at).TotalSeconds < RetailChatPerPlayerSeconds)
+                    continue;
+                retailChatAt[p.Guid.Full] = now;
+                var text = v.State.Mode == VehicleMode.Derelict
+                    ? $"An empty {v.Name} drops out of the sky."
+                    : $"A {v.Name} roars overhead.";
+                p.Session.Network.EnqueueSend(new GameMessageSystemChat(text, ChatMessageType.Broadcast));
+            }
+        }
+
+        static void SendStates(Vehicle v, Player pilot, int steps)
+        {
+            var observers = v.PhysicsObj.ObjMaint.GetKnownPlayersValuesAsPlayer();
+            RetailIndication(v, observers);
+
+            v.PilotStateAcc += steps * PilotStateHz / SimHz;
+            v.ObserverStateAcc += steps * ObserverStateHz / SimHz;
+            v.UpdatePosAcc += steps * UpdatePositionHz / SimHz;
+
+            if (pilot != null && v.PilotStateAcc >= 1.0)
+            {
+                v.PilotStateAcc = Math.Min(v.PilotStateAcc - 1.0, 1.0);
+                if (HasCap(pilot.Session, VehicleWire.CapObserve))
+                    SendTo(v, pilot.Session, v.BuildStateMsg(true));
+            }
+
+            if (v.ObserverStateAcc >= 1.0)
+            {
+                v.ObserverStateAcc = Math.Min(v.ObserverStateAcc - 1.0, 1.0);
+                VehicleStateMsg msg = null;
+                foreach (var p in observers)
+                {
+                    if (p == pilot || !HasCap(p.Session, VehicleWire.CapObserve)) continue;
+                    msg ??= v.BuildStateMsg(false);
+                    SendTo(v, p.Session, msg);
+                }
+            }
+
+            if (v.UpdatePosAcc >= 1.0)
+            {
+                v.UpdatePosAcc = Math.Min(v.UpdatePosAcc - 1.0, 1.0);
+                var vel = v.WorldVelocity();
+                var grounded = v.State.Mode == VehicleMode.Parked || v.State.Mode == VehicleMode.Crashed;
+                v.EnqueueBroadcast(new GameMessageVehicleUpdatePosition(v, vel, grounded));
+                if (pilot != null)
+                    pilot.EnqueueBroadcast(false, new GameMessageVehicleUpdatePosition(pilot, vel, grounded));
+            }
+        }
+
+        public static void SendTo(Vehicle v, Session session, VehicleS2C msg)
+        {
+            var ev = new GameEventVehicle(session, msg);
+            if (v != null)
+            {
+                v.Costs.BytesSent += ev.Data.Length;
+                v.Costs.MessagesSent++;
+            }
+            session.Network.EnqueueSend(ev);
+        }
+
+        static void BroadcastToCapable(Vehicle v, Func<VehicleS2C> build, Player alsoTo = null)
+        {
+            VehicleS2C msg = null;
+            var sent = new HashSet<uint>();
+            foreach (var p in v.PhysicsObj?.ObjMaint.GetKnownPlayersValuesAsPlayer() ?? new List<Player>())
+            {
+                if (!HasCap(p.Session, VehicleWire.CapObserve)) continue;
+                msg ??= build();
+                SendTo(v, p.Session, msg);
+                sent.Add(p.Guid.Full);
+            }
+            if (alsoTo != null && !sent.Contains(alsoTo.Guid.Full) && HasCap(alsoTo.Session, VehicleWire.CapObserve))
+                SendTo(v, alsoTo.Session, msg ?? build());
+        }
+
+        public static void BroadcastEvent(Vehicle v, VehicleEventKind kind, uint subject, float value, Position at = null, Player alsoTo = null)
+        {
+            var pos = at ?? v.VehiclePosition();
+            BroadcastToCapable(v, () => new VehicleEventMsg
+            {
+                Vehicle = v.Guid.Full, Kind = (uint)kind, Step = v.SimStep, Subject = subject,
+                Cell = pos.Cell, Position = pos.Pos, Value = value,
+            }, alsoTo ?? PilotOf(v));
+        }
+
+        public static void BroadcastFire(Vehicle v, VehicleFireMsg msg) => BroadcastToCapable(v, () => msg, PilotOf(v));
+
+        static void BroadcastSeat(Vehicle v, int seat, Player alsoTo)
+        {
+            BroadcastToCapable(v, () => new VehicleSeatMsg
+            {
+                Vehicle = v.Guid.Full, Seat = (uint)seat, Occupant = v.SeatOccupants[seat],
+                State = v.SeatOccupants[seat] != 0 ? VehicleSeatMsg.StateOccupied : VehicleSeatMsg.StateEmpty,
+            }, alsoTo);
