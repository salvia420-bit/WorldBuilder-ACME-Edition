@@ -0,0 +1,32 @@
+using System;
+using System.Diagnostics;
+using System.Runtime.CompilerServices;
+
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+
+using ACE.Server.Entity;
+
+namespace ACE.Server.Tests.Vehicles
+{
+    /// <summary>
+    /// holtburger vehicles fork (M3): the first CreateObject of a villa / mansion evaluates House.RootGuid, which touches
+    /// HouseCell — three static tables (~13,900 entries) built by ONE huge static constructor. Its first run (JIT + fill)
+    /// is a one-time world-thread stall; VehicleManager pre-warms it off-thread. This measures that cost.
+    /// </summary>
+    [TestClass]
+    public class HouseCellWarmupTests
+    {
+        [TestMethod]
+        public void HouseCellStaticConstructorCost()
+        {
+            var sw = Stopwatch.StartNew();
+            RuntimeHelpers.RunClassConstructor(typeof(HouseCell).TypeHandle);
+            var first = sw.Elapsed.TotalMilliseconds;
+            sw.Restart();
+            var root = HouseCell.RootGuids.TryGetValue(0x7BCAD044, out var r) ? r : 0;
+            var second = sw.Elapsed.TotalMilliseconds;
+            Console.WriteLine($"HouseCell cctor {first:0.0} ms; a lookup afterwards {second:0.000} ms; tables {HouseCell.HouseCells.Count}/{HouseCell.MansionCells.Count}/{HouseCell.RootGuids.Count}");
+            Assert.AreEqual(0x7BCAD041u, root);
+        }
+    }
+}
