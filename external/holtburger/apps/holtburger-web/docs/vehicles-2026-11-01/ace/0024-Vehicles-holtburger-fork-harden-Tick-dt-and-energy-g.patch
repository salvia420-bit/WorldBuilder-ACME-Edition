+        [TestMethod]
+        public void LaserTurret_Tick_IgnoresNonPositiveAndNonFiniteElapsedSeconds()
+        {
+            double x = 1000.0, y = 2000.0, z = 40.0;
+            var grid = new MicroGrid(new Vector3((float)x, (float)y, (float)z));
+            var bat = new BatteryDeployable(BatteryDeployable.BuildWeenie(), new ObjectGuid(0x7500E511u))
+            {
+                Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity),
+                CapacitorJoules = 600000.0f,
+            };
+            var laser = new LaserTurretDeployable(LaserTurretDeployable.BuildWeenie(), new ObjectGuid(0x7500E512u))
+            {
+                Location = Vehicle.ToPosition(x + 1.0, y, z, Quaternion.Identity),
+                OnlineFlags = DeployableOnlineFlags.Active | DeployableOnlineFlags.Powered,
+            };
+            grid.Register(bat);
+            grid.Register(laser);
+
+            var sensor = new AirDefenseSensor(0x7500E510u, new Vector3((float)x, (float)y, (float)z));
+            sensor.ProcessSweep(new[]
+            {
+                new AirTrackCandidate
+                {
+                    VehicleGuid = 0x7500E598u,
+                    Standing = IffStanding.Hostile,
+                    WorldPos = new Vector3((float)x + 200f, (float)y, (float)z + 60f),
+                    WorldVel = Vector3.Zero,
+                    RangeM = 200f,
+                    BearingRad = 0f,
+                    AltitudeAglM = 60f,
+                }
+            }, DateTime.UtcNow);
+            AirDefenseRegistry.RegisterSensor(sensor);
+
+            try
+            {
+                foreach (double bad in new[] { 0.0, -5.0, double.NaN, double.PositiveInfinity, double.NegativeInfinity })
+                {
+                    laser.Tick(bad);
+                    Assert.AreEqual(600000.0f, bat.CapacitorJoules, 1e-4f, $"LaserTurret Tick({bad}) must not fire");
+                }
+
+                laser.Tick(0.1);
+                Assert.AreEqual(480000.0f, bat.CapacitorJoules, 1e-4f, "First valid tick must fire 120 kJ shot");
+
+                foreach (double bad in new[] { 0.0, -5.0, double.NaN, double.PositiveInfinity, double.NegativeInfinity })
+                {
+                    laser.Tick(bad);
+                }
+                laser.Tick(0.5);
+                Assert.AreEqual(480000.0f, bat.CapacitorJoules, 1e-4f, "Invalid ticks must not bypass 2.0s laser cooldown");
+
+                laser.Tick(1.6); // clears remaining 1.5s cooldown and returns
+                laser.Tick(0.1); // fires second shot if cooldown wasn't extended/bricked by -5.0 / -Infinity
+                Assert.AreEqual(360000.0f, bat.CapacitorJoules, 1e-4f, "Cooldown must expire normally after valid elapsed time");
+            }
+            finally
+            {
+                AirDefenseRegistry.Clear();
+            }
+        }
