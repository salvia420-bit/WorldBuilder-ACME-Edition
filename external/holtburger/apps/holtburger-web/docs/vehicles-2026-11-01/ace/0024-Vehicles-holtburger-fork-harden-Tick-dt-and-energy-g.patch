+        [TestMethod]
+        public void SemiTrailerDeployable_Tick_IgnoresNonPositiveAndNonFiniteElapsedSeconds()
+        {
+            const int lbX = 14, lbY = 14;
+            uint gridKey = ((uint)lbX << 24) | ((uint)lbY << 16);
+            var gridsField = typeof(VehicleTerrain).GetField("grids", BindingFlags.Static | BindingFlags.NonPublic);
+            var grids = (System.Collections.Concurrent.ConcurrentDictionary<uint, LandblockGrid>)gridsField?.GetValue(null);
+            bool hadPrev = grids.TryGetValue(gridKey, out var prevGrid);
+
+            try
+            {
+                var flat40 = new float[81];
+                Array.Fill(flat40, 40.0f);
+                grids[gridKey] = new LandblockGrid { Heights = flat40 };
+
+                double gx = lbX * 192.0 + 60.0;
+                double gy = lbY * 192.0 + 60.0;
+                var sl = new SemiTrailerDeployable(SemiTrailerDeployable.WcidSidelifter40, new Vector3((float)gx, (float)gy, 40.0f));
+                Assert.IsTrue(sl.TryDeployOutriggers(1, out var reason, null), reason ?? "TryDeployOutriggers failed");
+                Assert.AreEqual(SideliftPhase.OutriggersDeploying, sl.SideliftPhase);
+                Assert.AreEqual(0.0f, sl.SideliftProgress, 1e-6f);
+
+                foreach (double bad in new[] { 0.0, -5.0, double.NaN, double.PositiveInfinity, double.NegativeInfinity })
+                {
+                    sl.Tick(bad);
+                    Assert.AreEqual(0.0f, sl.SideliftProgress, 1e-6f, $"SemiTrailer Tick({bad}) must not advance SideliftProgress");
+                    Assert.AreEqual(0.0f, sl.OutriggerProgress, 1e-6f);
+                    Assert.AreEqual(SideliftPhase.OutriggersDeploying, sl.SideliftPhase);
+                }
+            }
+            finally
+            {
+                if (hadPrev) grids[gridKey] = prevGrid;
+                else grids.TryRemove(gridKey, out _);
+            }
+        }
