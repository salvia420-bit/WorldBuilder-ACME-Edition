+        [TestMethod]
+        public void MortarTurret_Tick_IgnoresNonPositiveAndNonFiniteElapsedSeconds()
+        {
+            double x = 3550.0, y = 4550.0, z = 40.0;
+            var prevOverride = DeployableManager.EnterWorldOverrideForTesting;
+            DeployableManager.Clear();
+            DeployableManager.EnterWorldOverrideForTesting = _ => true;
+
+            var deployer = CreateTestPlayer(0x5000E521u, x, y, z, monarchId: 100u);
+            var foreignPlayer = CreateTestPlayer(0x5000E522u, x + 100.0, y, z, monarchId: 200u);
+
+            var lockField = typeof(ACE.Server.Managers.PlayerManager).GetField("playersLock", BindingFlags.Static | BindingFlags.NonPublic);
+            var dictField = typeof(ACE.Server.Managers.PlayerManager).GetField("onlinePlayers", BindingFlags.Static | BindingFlags.NonPublic);
+            var rwLock = (System.Threading.ReaderWriterLockSlim)lockField?.GetValue(null);
+            var onlineDict = (Dictionary<uint, Player>)dictField?.GetValue(null);
+            void RegPlayer(Player p) { rwLock.EnterWriteLock(); try { onlineDict[p.Guid.Full] = p; } finally { rwLock.ExitWriteLock(); } }
+            void UnregPlayer(uint g) { rwLock.EnterWriteLock(); try { onlineDict.Remove(g); } finally { rwLock.ExitWriteLock(); } }
+
+            RegPlayer(deployer);
+            RegPlayer(foreignPlayer);
+
+            try
+            {
+                var flux = new FluxPodDeployable(FluxPodDeployable.BuildWeenie(), new ObjectGuid(0x7500E521u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity),
+                };
+                flux.Grid.Center = flux.GlobalPosition;
+                DeployableManager.RegisterGrid(flux.Grid);
+                DeployableManager.Register(flux);
+
+                var gen = new PowerGeneratorDeployable(PowerGeneratorDeployable.BuildWeenie(), new ObjectGuid(0x7500E522u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 1.0, y, z, Quaternion.Identity),
+                    FuelSecondsRemaining = 120.0,
+                };
+                flux.Grid.Register(gen);
+                DeployableManager.Register(gen);
+
+                var radar = new GroundRadarDeployable(GroundRadarDeployable.BuildWeenie(), new ObjectGuid(0x7500E523u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 2.0, y, z, Quaternion.Identity),
+                    TargetMonsters = false,
+                };
+                flux.Grid.Register(radar);
+                DeployableManager.Register(radar);
+
+                DeployableManager.Tick(0.6);
+                Assert.IsTrue(radar.IsPowered);
+                Assert.AreEqual(1, radar.ContactCount);
+
+                var mortar = new MortarTurretDeployable(MortarTurretDeployable.BuildWeenie(), new ObjectGuid(0x7500E524u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 3.0, y, z, Quaternion.Identity),
+                    OnlineFlags = DeployableOnlineFlags.Active | DeployableOnlineFlags.Powered,
+                };
+                flux.Grid.Register(mortar);
+
+                foreach (double bad in new[] { 0.0, -5.0, double.NaN, double.PositiveInfinity, double.NegativeInfinity })
+                {
+                    mortar.Tick(bad);
+                    Assert.AreEqual(0.0f, mortar.PitchRad, 1e-6f, $"MortarTurret Tick({bad}) must not fire");
+                }
+
+                mortar.Tick(0.1);
+                Assert.AreEqual((float)(Math.PI / 4.0), mortar.PitchRad, 1e-5f, "Valid tick must fire mortar");
+                mortar.PitchRad = 0.0f;
+
+                foreach (double bad in new[] { 0.0, -5.0, double.NaN, double.PositiveInfinity, double.NegativeInfinity })
+                {
+                    mortar.Tick(bad);
+                }
+                mortar.Tick(1.0);
+                Assert.AreEqual(0.0f, mortar.PitchRad, 1e-6f, "Invalid ticks must not bypass 6.0s mortar cooldown");
+
+                mortar.Tick(5.1); // clears remaining 5.0s cooldown and returns
+                mortar.Tick(0.1); // fires second mortar round
+                Assert.AreEqual((float)(Math.PI / 4.0), mortar.PitchRad, 1e-5f, "Mortar cooldown must expire normally after valid elapsed time");
+            }
+            finally
+            {
+                UnregPlayer(deployer.Guid.Full);
+                UnregPlayer(foreignPlayer.Guid.Full);
+                DeployableManager.Clear();
+                DeployableManager.EnterWorldOverrideForTesting = prevOverride;
+            }
+        }
