+        [TestMethod]
+        public void MissileTurret_Tick_And_AdvanceRise_IgnoreNonPositiveAndNonFiniteDt()
+        {
+            double x = 1000.0, y = 2000.0, z = 40.0;
+            var grid = new MicroGrid(new Vector3((float)x, (float)y, (float)z));
+            var sam = new MissileTurretDeployable(MissileTurretDeployable.BuildWeenie(), new ObjectGuid(0x7500E501u))
+            {
+                Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity),
+                OnlineFlags = DeployableOnlineFlags.Active | DeployableOnlineFlags.Powered,
+            };
+            grid.Register(sam);
+
+            var sensor = new AirDefenseSensor(0x7500E500u, new Vector3((float)x, (float)y, (float)z));
+            sensor.ProcessSweep(new[]
+            {
+                new AirTrackCandidate
+                {
+                    VehicleGuid = 0x7500E599u,
+                    Standing = IffStanding.Hostile,
+                    WorldPos = new Vector3((float)x + 200f, (float)y, (float)z + 160f),
+                    WorldVel = Vector3.Zero,
+                    RangeM = 200f,
+                    BearingRad = 0f,
+                    AltitudeAglM = 160f,
+                }
+            }, DateTime.UtcNow);
+            AirDefenseRegistry.RegisterSensor(sensor);
+
+            try
+            {
+                foreach (float bad in new[] { 0.0f, -5.0f, float.NaN, float.PositiveInfinity, float.NegativeInfinity })
+                {
+                    sam.AdvanceRise(bad);
+                    Assert.AreEqual(0.0f, sam.ElevationM, 1e-6f, $"AdvanceRise({bad}) must not mutate ElevationM");
+                }
+
+                foreach (double bad in new[] { 0.0, -5.0, double.NaN, double.PositiveInfinity, double.NegativeInfinity })
+                {
+                    sam.Tick(bad);
+                    Assert.AreEqual(0.0f, sam.ElevationM, 1e-6f, $"Pre-fire Tick({bad}) must not raise turret");
+                    Assert.AreEqual(MissileTurretDeployable.MaxAmmo, sam.AmmoRemaining);
+                    Assert.AreEqual(0.0f, sam.ReloadTimerS, 1e-6f);
+                }
+
+                sam.Tick(0.4);
+                Assert.AreEqual(MissileTurretDeployable.TargetElevationM, sam.ElevationM, 1e-5f);
+                Assert.AreEqual((ushort)0, sam.AmmoRemaining);
+                Assert.AreEqual(MissileTurretDeployable.ReloadDurationS, sam.ReloadTimerS, 1e-5f);
+                Assert.IsTrue(sam.IsReloading);
+
+                foreach (double bad in new[] { 0.0, -5.0, double.NaN, double.PositiveInfinity, double.NegativeInfinity })
+                {
+                    sam.Tick(bad);
+                    Assert.AreEqual(MissileTurretDeployable.ReloadDurationS, sam.ReloadTimerS, 1e-5f, $"Reload Tick({bad}) must be ignored");
+                    Assert.AreEqual((ushort)0, sam.AmmoRemaining);
+                    Assert.IsTrue(sam.IsReloading);
+                }
+
+                sam.Tick(6.0);
+                Assert.AreEqual(6.0f, sam.ReloadTimerS, 1e-4f, "ReloadTimerS must still advance normally after invalid ticks");
+                AirDefenseRegistry.Clear();
+                sam.Tick(6.0);
+                Assert.AreEqual(0.0f, sam.ReloadTimerS, 1e-5f);
+                Assert.AreEqual(MissileTurretDeployable.MaxAmmo, sam.AmmoRemaining);
+                Assert.IsFalse(sam.IsReloading);
+            }
+            finally
+            {
+                AirDefenseRegistry.Clear();
+            }
+        }
