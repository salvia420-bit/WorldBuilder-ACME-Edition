@@ -0,0 +1,72 @@
+using System;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using ACE.Entity;
+
+namespace ACE.Server.Tests.Vehicles
+{
+    [TestClass]
+    public class DericostContinentInvariantsTests
+    {
+        [TestMethod]
+        public void LandblockId_ContinentFlag_ExtractsBit15()
+        {
+            var derethId = new LandblockId(0x12340001);
+            Assert.AreEqual((byte)0, derethId.Continent);
+
+            var dericostId = new LandblockId(0x12348001);
+            Assert.AreEqual((byte)1, dericostId.Continent);
+        }
+
+        [TestMethod]
+        public void LandblockId_Indoors_MasksBit15_PreventsFalseIndoorsOnDericost()
+        {
+            // Dereth outdoor cell 1
+            var derethOutdoor = new LandblockId(0x10200001);
+            Assert.IsFalse(derethOutdoor.Indoors);
+
+            // Dereth dungeon cell 0x100
+            var derethDungeon = new LandblockId(0x10200100);
+            Assert.IsTrue(derethDungeon.Indoors);
+
+            // Dericost outdoor cell 1 (Bit 15 is 1, raw low 16 bits = 0x8001)
+            var dericostOutdoor = new LandblockId(0x10208001);
+            Assert.IsFalse(dericostOutdoor.Indoors, "Dericost outdoor cells must not be classified as indoors");
+
+            // Dericost dungeon cell (Bit 15 is 1, raw low 16 bits = 0x8100)
+            var dericostDungeon = new LandblockId(0x10208100);
+            Assert.IsTrue(dericostDungeon.Indoors, "Dericost dungeon cells must still be classified as indoors");
+        }
+
+        [TestMethod]
+        public void LandblockId_Equality_CrossContinentDifferentiation()
+        {
+            var derethBlock = new LandblockId(0x10200001);
+            var dericostBlock = new LandblockId(0x10208001);
+
+            Assert.AreNotEqual(derethBlock, dericostBlock);
+            Assert.IsTrue(derethBlock != dericostBlock);
+            Assert.IsFalse(derethBlock == dericostBlock);
+            Assert.IsFalse(derethBlock.Equals(dericostBlock));
+
