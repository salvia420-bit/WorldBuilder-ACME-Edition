+++ b/Source/ACE.Server.Tests/Vehicles/ChallengerM2ContinentStressTests.cs
@@ -0,0 +1,275 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Numerics;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using ACE.Entity;
+using ACE.Server.Vehicles;
+
+namespace ACE.Server.Tests.Vehicles
+{
+    [TestClass]
+    public class ChallengerM2ContinentStressTests
+    {
+        // -------------------------------------------------------------
+        // 1. Stress Test: LandblockId All Outdoor Cells (1..64) on Dereth and Dericost
+        // -------------------------------------------------------------
+        [TestMethod]
+        public void LandblockId_AllOutdoorCells_IndoorsIsFalse_BothContinents()
+        {
+            for (int lbX = 0; lbX < 255; lbX += 32)
+            {
+                for (int lbY = 0; lbY < 255; lbY += 32)
+                {
+                    uint baseDereth = ((uint)lbX << 24) | ((uint)lbY << 16);
+                    uint baseDericost = baseDereth | 0x8000;
+
+                    for (uint cell = 1; cell <= 64; cell++)
+                    {
+                        var derethId = new LandblockId(baseDereth | cell);
+                        var dericostId = new LandblockId(baseDericost | cell);
+
+                        Assert.IsFalse(derethId.Indoors, $"Dereth LB({lbX},{lbY}) cell {cell} must be outdoor");
+                        Assert.AreEqual((byte)0, derethId.Continent, $"Dereth LB({lbX},{lbY}) cell {cell} continent must be 0");
+
+                        Assert.IsFalse(dericostId.Indoors, $"Dericost LB({lbX},{lbY}) cell {cell} must be outdoor");
+                        Assert.AreEqual((byte)1, dericostId.Continent, $"Dericost LB({lbX},{lbY}) cell {cell} continent must be 1");
+                    }
+                }
+            }
+        }
+
+        // -------------------------------------------------------------
+        // 2. Stress Test: LandblockId Indoor Dungeon / EnvCells on Dereth and Dericost
+        // -------------------------------------------------------------
+        [TestMethod]
+        public void LandblockId_IndoorEnvCells_IndoorsIsTrue_BothContinents()
+        {
+            uint[] testDungeonCells = { 0x0100, 0x0101, 0x0150, 0x0200, 0x03FF, 0x0FFF };
+
+            foreach (var cell in testDungeonCells)
+            {
+                var derethDungeon = new LandblockId(0x10200000 | cell);
+                var dericostDungeon = new LandblockId(0x10208000 | cell);
+
+                Assert.IsTrue(derethDungeon.Indoors, $"Dereth dungeon cell 0x{cell:X4} must be indoor");
+                Assert.AreEqual((byte)0, derethDungeon.Continent);
+
+                Assert.IsTrue(dericostDungeon.Indoors, $"Dericost dungeon cell 0x{cell:X4} must be indoor");
+                Assert.AreEqual((byte)1, dericostDungeon.Continent);
+            }
+        }
+
+        // -------------------------------------------------------------
+        // 3. Stress Test: Cross-Continent Equality & Hashing in Collections
+        // -------------------------------------------------------------
+        [TestMethod]
+        public void LandblockId_CrossContinent_SetAndDictionaryCollisions()
+        {
+            var derethId = new LandblockId(0x10200001);
+            var dericostId = new LandblockId(0x10208001);
+
+            Assert.AreNotEqual(derethId, dericostId);
+            Assert.IsFalse(derethId == dericostId);
+            Assert.IsTrue(derethId != dericostId);
+            Assert.AreNotEqual(derethId.GetHashCode(), dericostId.GetHashCode());
+
+            var set = new HashSet<LandblockId> { derethId, dericostId };
+            Assert.AreEqual(2, set.Count, "HashSet must store Dereth and Dericost landblocks as distinct entries");
+            Assert.IsTrue(set.Contains(derethId));
+            Assert.IsTrue(set.Contains(dericostId));
+
+            var dict = new ConcurrentDictionary<LandblockId, string>();
+            dict[derethId] = "Dereth";
+            dict[dericostId] = "Dericost";
+
+            Assert.AreEqual(2, dict.Count);
+            Assert.AreEqual("Dereth", dict[derethId]);
+            Assert.AreEqual("Dericost", dict[dericostId]);
+        }
+
+        // -------------------------------------------------------------
+        // 4. Stress Test: LandblockId Transitions Preserve Continent Bit 15
+        // -------------------------------------------------------------
+        [TestMethod]
+        public void LandblockId_Transitions_PreserveContinentBit()
+        {
+            var dericostStart = new LandblockId(0x10208001); // lbX=16, lbY=32, continent=1, cell=1
+
+            var transEast = dericostStart.TransitionX(1);
+            Assert.IsNotNull(transEast);
+            Assert.AreEqual((byte)1, transEast.Value.Continent, "TransitionX East must preserve continent");
+            Assert.AreEqual((byte)17, transEast.Value.LandblockX);
+            Assert.IsFalse(transEast.Value.Indoors);
+
+            var transWest = dericostStart.TransitionX(-1);
+            Assert.IsNotNull(transWest);
+            Assert.AreEqual((byte)1, transWest.Value.Continent, "TransitionX West must preserve continent");
+            Assert.AreEqual((byte)15, transWest.Value.LandblockX);
+
+            var transNorth = dericostStart.TransitionY(5);
+            Assert.IsNotNull(transNorth);
+            Assert.AreEqual((byte)1, transNorth.Value.Continent, "TransitionY North must preserve continent");
+            Assert.AreEqual((byte)37, transNorth.Value.LandblockY);
+
+            var transSouth = dericostStart.TransitionY(-5);
+            Assert.IsNotNull(transSouth);
+            Assert.AreEqual((byte)1, transSouth.Value.Continent, "TransitionY South must preserve continent");
+            Assert.AreEqual((byte)27, transSouth.Value.LandblockY);
+
+            // Boundary clamping: transition beyond map limits returns null
+            Assert.IsNull(dericostStart.TransitionX(-20), "TransitionX beyond west edge must return null");
+            Assert.IsNull(dericostStart.TransitionY(230), "TransitionY beyond north edge must return null");
+        }
+
+        // -------------------------------------------------------------
+        // 5. Stress Test: Position.SetLandblock and SetLandCell on Dericost
+        // -------------------------------------------------------------
+        [TestMethod]
+        public void Position_SetLandblockAndLandCell_PreserveContinentBit()
+        {
+            // Position on Dericost outdoor cell
+            var p = new Position(0x10208001, new Vector3(50.0f, 50.0f, 10.0f), Quaternion.Identity);
+            Assert.AreEqual((byte)1, p.LandblockId.Continent);
+            Assert.IsFalse(p.Indoors);
+
+            // Move within landblock: triggers SetLandCell
+            p.SetPosition(new Vector3(100.0f, 120.0f, 10.0f));
+            Assert.AreEqual((byte)1, p.LandblockId.Continent, "SetLandCell must preserve Dericost continent flag");
+            Assert.IsFalse(p.Indoors);
+
+            // Move across landblock boundary to the East (X >= 192.0): triggers SetLandblock
+            p.SetPosition(new Vector3(250.0f, 50.0f, 10.0f));
+            Assert.AreEqual((byte)1, p.LandblockId.Continent, "SetLandblock East crossing must preserve continent flag");
+            Assert.AreEqual((uint)17, p.LandblockX);
+            Assert.AreEqual(58.0f, p.PositionX, 0.01f);
+            Assert.IsFalse(p.Indoors);
+
+            // Move across landblock boundary to the North (Y >= 192.0): triggers SetLandblock
+            p.SetPosition(new Vector3(50.0f, 220.0f, 10.0f));
+            Assert.AreEqual((byte)1, p.LandblockId.Continent, "SetLandblock North crossing must preserve continent flag");
+            Assert.AreEqual((uint)33, p.LandblockY);
+            Assert.AreEqual(28.0f, p.PositionY, 0.01f);
+            Assert.IsFalse(p.Indoors);
+        }
+
+        // -------------------------------------------------------------
+        // 6. Stress Test: Cross-Continent 3D Distance Symmetry and Accuracy
+        // -------------------------------------------------------------
+        [TestMethod]
+        public void Position_CrossContinentDistance_SymmetryAndAccuracy()
+        {
+            // Point on Dereth: lbX=128, lbY=254 (Dereth North shore), Y=192m -> Global Y = 254*192 + 192 = 48,960.0m
+            var pDerethNorth = new Position(0x80FE0001, new Vector3(96.0f, 192.0f, 0.0f), Quaternion.Identity);
+
+            // Point on Dericost: lbX=128, lbY=0 (Dericost South landfall), Y=0m -> Global Y = 68,928.0m
+            var pDericostSouth = new Position(0x80008001, new Vector3(96.0f, 0.0f, 0.0f), Quaternion.Identity);
+
+            // The ocean gap distance is exactly 68,928.0 - 48,960.0 = 19,968.0m
+            const double expectedGap = 19968.0;
+
+            var distFwd = pDerethNorth.DistanceTo(pDericostSouth);
+            var distRev = pDericostSouth.DistanceTo(pDerethNorth);
+
+            Assert.AreEqual((float)expectedGap, distFwd, 0.5f, "Dereth-to-Dericost distance must match ocean gap (19,968m)");
+            Assert.AreEqual(distFwd, distRev, 0.01f, "DistanceTo must be strictly symmetric");
+
+            var offsetFwd = pDerethNorth.GetOffset(pDericostSouth);
+            var offsetRev = pDericostSouth.GetOffset(pDerethNorth);
+
+            Assert.AreEqual(0.0f, offsetFwd.X, 0.01f);
+            Assert.AreEqual((float)expectedGap, offsetFwd.Y, 0.5f, "Offset from Dereth North to Dericost South must be +19,968m on Y");
+
+            Assert.AreEqual(0.0f, offsetRev.X, 0.01f);
+            Assert.AreEqual(-(float)expectedGap, offsetRev.Y, 0.5f, "Offset from Dericost South to Dereth North must be -19,968m on Y");
+        }
+
+        // -------------------------------------------------------------
+        // 7. Stress Test: Vehicle.ToPosition and Vehicle.ToGlobal Round-Trip
+        // -------------------------------------------------------------
+        [TestMethod]
+        public void Vehicle_GlobalConversions_RoundTrip_BothContinents()
+        {
+            // Dereth coordinates
+            double[] derethYs = { 10.0, 1000.0, 24480.0, 48950.0 };
+            foreach (var gy in derethYs)
+            {
+                double gx = 24480.0;
+                double gz = 75.0;
+                var pos = Vehicle.ToPosition(gx, gy, gz, Quaternion.Identity);
+
+                Assert.AreEqual((byte)0, pos.LandblockId.Continent, $"Continent for gy={gy} must be Dereth (0)");
+                Assert.IsFalse(pos.Indoors);
+
+                var (backX, backY, backZ) = Vehicle.ToGlobal(pos);
+                Assert.AreEqual(gx, backX, 0.05, $"Round-trip X for gy={gy}");
+                Assert.AreEqual(gy, backY, 0.05, $"Round-trip Y for gy={gy}");
+                Assert.AreEqual(gz, backZ, 0.01, $"Round-trip Z for gy={gy}");
+            }
+
+            // Dericost coordinates
+            double[] dericostYs = { 68928.0, 70000.0, 85000.0, 105000.0, 117880.0 };
+            foreach (var gy in dericostYs)
+            {
+                double gx = 30000.0;
+                double gz = 120.0;
+                var pos = Vehicle.ToPosition(gx, gy, gz, Quaternion.Identity);
+
+                Assert.AreEqual((byte)1, pos.LandblockId.Continent, $"Continent for gy={gy} must be Dericost (1)");
+                Assert.IsFalse(pos.Indoors);
+
+                var (backX, backY, backZ) = Vehicle.ToGlobal(pos);
+                Assert.AreEqual(gx, backX, 0.05, $"Round-trip X for gy={gy}");
+                Assert.AreEqual(gy, backY, 0.05, $"Round-trip Y for gy={gy}");
+                Assert.AreEqual(gz, backZ, 0.01, $"Round-trip Z for gy={gy}");
+            }
+        }
+
+        // -------------------------------------------------------------
+        // 8. Stress Test: Vehicle Predictive Streaming Target Generation
+        // -------------------------------------------------------------
+        [TestMethod]
+        public void Vehicle_FlightCorridor_TargetsSkipOceanGap_TargetDericostOnApproach()
+        {
+            // Ocean gap boundaries
+            const double oceanMin = 48960.0;
+            const double oceanMax = 68928.0;
+
+            // Scenario A: Inside Ocean Corridor (py = 58,000m, cruising North at 83 m/s)
+            // Any candidate py within [48960, 68928) must be excluded from target landblocks
+            double cruiseSpeed = 83.0;
+            double horizon = 5.0;
+            double startY = 58000.0;
+
+            for (double t = 0.0; t <= horizon; t += 0.5)
+            {
+                double py = startY + cruiseSpeed * t;
+                bool isOcean = py >= oceanMin && py < oceanMax;
+                Assert.IsTrue(isOcean, $"py={py} must be recognized as inside ocean gap");
+            }
+
+            // Scenario B: Approach Landfall (py = 68,700m, 228m South of Dericost)
+            // At t = 0, py = 68,700m (in ocean -> skip)
+            // At t = 3.0s, py = 68,700 + 83 * 3 = 68,949m >= 68928m -> Dericost Landblock with Continent=1
+            startY = 68700.0;
+            int targetedDericostCount = 0;
+
+            for (double t = 0.0; t <= horizon; t += 0.5)
+            {
+                double py = startY + cruiseSpeed * t;
+                if (py >= oceanMin && py < oceanMax)
+                    continue; // skipped
+
+                var continent = py >= Vehicle.DericostYOffset ? 1 : 0;
+                var localPy = continent == 1 ? py - Vehicle.DericostYOffset : py;
+                var lby = (int)Math.Floor(localPy / 192.0);
+
+                Assert.AreEqual(1, continent, "Approach past landfall must target Dericost (continent 1)");
+                Assert.IsTrue(lby >= 0 && lby < 255, $"lby={lby} must be within valid Dericost range [0, 254]");
+                targetedDericostCount++;
+            }
+
+            Assert.IsTrue(targetedDericostCount > 0, "Corridor prefetch must generate Dericost targets ahead of landfall");
+        }
+    }
+}
