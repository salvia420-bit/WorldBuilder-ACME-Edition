@@ -1,6 +1,9 @@
 using System;
+using System.Numerics;
 using Microsoft.VisualStudio.TestTools.UnitTesting;
 using ACE.Entity;
+using ACE.Server.Physics.Common;
+using ACE.Server.Vehicles;
 
 namespace ACE.Server.Tests.Vehicles
 {
@@ -57,8 +60,8 @@ public void LandblockId_Equality_CrossContinentDifferentiation()
         [TestMethod]
         public void Position_Distance_AccountsForContinentDelta()
         {
-            var pDereth = new Position(0x10200001, new System.Numerics.Vector3(50.0f, 50.0f, 10.0f), System.Numerics.Quaternion.Identity);
-            var pDericost = new Position(0x10208001, new System.Numerics.Vector3(50.0f, 50.0f, 10.0f), System.Numerics.Quaternion.Identity);
+            var pDereth = new ACE.Entity.Position(0x10200001, new System.Numerics.Vector3(50.0f, 50.0f, 10.0f), System.Numerics.Quaternion.Identity);
+            var pDericost = new ACE.Entity.Position(0x10208001, new System.Numerics.Vector3(50.0f, 50.0f, 10.0f), System.Numerics.Quaternion.Identity);
 
             var distSq = pDereth.SquaredDistanceTo(pDericost);
             var expectedDist = 68928.0;
@@ -68,5 +71,78 @@ public void Position_Distance_AccountsForContinentDelta()
             Assert.AreEqual((float)expectedDist, pDereth.DistanceTo(pDericost), 0.1f);
             Assert.AreEqual((float)expectedDist, pDereth.Distance2D(pDericost), 0.1f);
         }
+
+        [TestMethod]
+        public void LandDefs_DericostOutdoorCell_ResolvesLCoordAndPreservesBit15()
+        {
+            uint dericostCell = 0xA6908025;
+            Assert.IsTrue(LandDefs.inbound_valid_cellid(dericostCell), "Dericost outdoor cell must be valid");
+            var lcoord = LandDefs.gid_to_lcoord(dericostCell);
+            Assert.IsNotNull(lcoord, "Dericost outdoor cell must resolve lcoord without envCheck rejection");
+            Assert.AreEqual(0xA6 * 8 + 4, (int)lcoord.Value.X);
+            Assert.AreEqual(0x90 * 8 + 4, (int)lcoord.Value.Y);
+
+            uint cell = 0xA6908001;
+            var loc = new Vector3(96.0f, 96.0f, 278.0f);
+            Assert.IsTrue(LandDefs.AdjustToOutside(ref cell, ref loc));
+            Assert.AreEqual(0xA6908025u, cell, "AdjustToOutside must preserve Dericost bit 15");
+            var physPos = new ACE.Server.Physics.Common.Position
+            {
+                ObjCellID = 0xA6908001,
+                Frame = new ACE.Server.Physics.Animation.AFrame(loc, Quaternion.Identity),
+            };
+            Assert.AreEqual(0xA6908025u, physPos.GetCell(0xA6908001));
+        }
+
+        [TestMethod]
+        public void VehicleTerrain_And_PhysicsLandblock_DericostGridSetsBit15AndHeight()
+        {
+            const int verts = 255 * 8 + 1;
+            var h = new byte[verts * verts];
+            var t = new byte[verts * verts];
+            var table = new float[256];
+            for (int i = 0; i < 256; i++) table[i] = i * 2.0f;
+
+            // Populate Dericost landblock (166, 144) = 0xA690 with height index 139 -> 278.0m
+            for (int col = 0; col <= 8; col++)
+                for (int row = 0; row <= 8; row++)
+                    h[(144 * 8 + row) * verts + (166 * 8 + col)] = 139;
+
+            var prevLandHeight = LandDefs.LandHeightTable;
+            var prevEng = ACE.Server.Physics.PhysicsEngine.Instance;
+            const uint dericostKey = 0xA690FFFFu;
+            bool hadKey = LScape.Landblocks.TryGetValue(dericostKey, out var prevLb);
+            try
+            {
+                ACE.Server.Physics.PhysicsEngine.Instance = null;
+                LandDefs.LandHeightTable = new System.Collections.Generic.List<float>(table);
+                VehicleTerrain.SetDericostGridsForTesting(h, t, table);
+
+                var grid = VehicleTerrain.GetGrid(166, 144, 1);
+                Assert.IsNotNull(grid);
+                Assert.AreEqual(278.0f, grid.Heights[0], 0.01f);
+
+                float gz = VehicleTerrain.HeightAt(166 * 192.0f + 96.0f, (float)Vehicle.DericostYOffset + 144 * 192.0f + 96.0f);
+                Assert.AreEqual(278.0f, gz, 0.01f);
+
+                Assert.IsTrue(VehicleTerrain.TryGetDericostCellLandblock(166, 144, out var cl));
+                var physLb = new ACE.Server.Physics.Common.Landblock(cl, isDericost: true);
+                physLb.init_landcell();
+                LScape.Landblocks[dericostKey] = physLb;
+                Assert.IsTrue(physLb.IsDericost);
+                var lc = physLb.get_landcell(0xA6908025);
+                Assert.IsNotNull(lc, "PhysicsLandblock.get_landcell must find Dericost cell 0xA6908025");
+                Assert.AreEqual(0xA6908025u, lc.ID);
+                Assert.AreEqual(278.0f, physLb.GetZ(new Vector3(96.0f, 96.0f, 278.0f)), 0.05f);
+            }
+            finally
+            {
+                if (hadKey) LScape.Landblocks[dericostKey] = prevLb;
+                else LScape.Landblocks.TryRemove(dericostKey, out _);
+                ACE.Server.Physics.PhysicsEngine.Instance = prevEng;
+                VehicleTerrain.SetDericostGridsForTesting(null, null, null);
+                LandDefs.LandHeightTable = prevLandHeight;
+            }
+        }
     }
 }
