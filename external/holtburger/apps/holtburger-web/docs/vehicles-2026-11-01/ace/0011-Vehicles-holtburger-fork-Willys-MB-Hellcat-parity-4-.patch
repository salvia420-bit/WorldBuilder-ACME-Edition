+        [TestMethod]
+        public void HandleCargo_JeepMbRejectsCargoDeployAndPack()
+        {
+            VehicleManager.EnabledOverride = true;
+            var v = CreateTestJeep(0x70000017, 1000.0, 2000.0, 100.0);
+            VehicleManager.RegisterForTesting(v);
+
+            try
+            {
+                var player = CreateTestPlayer(0x10000009, 1000.0, 1996.95, 100.75);
+                VehicleManager.ClearSeatedForTesting(player);
+
+                // Jeep MB has CargoWcid == 0, HandleCargo must strictly reject deploy and pack
+                var deployMsg = new VehicleCargo { Vehicle = v.Guid.Full, Action = 1, Target = 0 };
+                var deployOk = VehicleManager.HandleCargo(player, deployMsg);
+                Assert.IsFalse(deployOk, "HandleCargo Deploy must return false for jeep-mb (CargoWcid == 0)");
+
+                var packMsg = new VehicleCargo { Vehicle = v.Guid.Full, Action = 2, Target = 0 };
+                var packOk = VehicleManager.HandleCargo(player, packMsg);
+                Assert.IsFalse(packOk, "HandleCargo Pack must return false for jeep-mb (CargoWcid == 0)");
+                Assert.IsFalse(v.CargoLoaded, "Jeep MB CargoLoaded must remain false");
+            }
+            finally
+            {
+                VehicleManager.UnregisterForTesting(v.Guid.Full);
+            }
+        }
+
+        [TestMethod]
+        public void FirstOpenSeat_ScansAndPrioritizesDriverSeat()
+        {
+            var v = CreateTestJeep(0x70000018, 1000.0, 2000.0, 100.0);
+            var playerDriverSide = CreateTestPlayer(0x10000010, 999.0, 2000.0, 100.0);
+            var playerShotgunSide = CreateTestPlayer(0x10000011, 1001.0, 2000.0, 100.0);
+            var playerRearLeft = CreateTestPlayer(0x10000012, 999.0, 1999.0, 100.0);
+            var playerRearRight = CreateTestPlayer(0x10000013, 1001.0, 1999.0, 100.0);
+
+            // 1. When empty, Seat 0 is always prioritized
+            Assert.AreEqual(0, v.FirstOpenSeat(playerShotgunSide.Location), "Empty vehicle prioritizes Seat 0 (driver)");
+            Assert.AreEqual(0, v.FirstOpenSeat(null), "Null player location prioritizes Seat 0");
+
+            // 2. Seat 0 occupied -> scans nearest unoccupied seat
+            v.SeatOccupants[0] = 0x10000010;
+
+            Assert.AreEqual(1, v.FirstOpenSeat(playerShotgunSide.Location), "Player on shotgun side chooses Seat 1");
+            Assert.AreEqual(2, v.FirstOpenSeat(playerRearLeft.Location), "Player at rear left chooses Seat 2");
+            Assert.AreEqual(3, v.FirstOpenSeat(playerRearRight.Location), "Player at rear right chooses Seat 3");
+
+            // 3. Seats 0 and 1 occupied -> selects nearest open rear seat
+            v.SeatOccupants[1] = 0x10000011;
+            Assert.AreEqual(2, v.FirstOpenSeat(playerRearLeft.Location));
+            Assert.AreEqual(3, v.FirstOpenSeat(playerRearRight.Location));
+
+            // 4. Seats 0, 1, 2 occupied -> selects seat 3
+            v.SeatOccupants[2] = 0x10000012;
+            Assert.AreEqual(3, v.FirstOpenSeat(playerDriverSide.Location));
+
+            // 5. All seats occupied -> returns -1
+            v.SeatOccupants[3] = 0x10000013;
+            Assert.AreEqual(-1, v.FirstOpenSeat(playerDriverSide.Location), "All seats occupied returns -1");
+        }
+
+        [TestMethod]
+        public void VehicleBoardCommand_SeatsPlayerInTargetSeatOrFallback()
+        {
+            VehicleManager.EnabledOverride = true;
+            var v = CreateTestJeep(0x70000019, 1000.0, 2000.0, 100.0);
+            VehicleManager.RegisterForTesting(v);
+
+            try
+            {
+                var player1 = CreateTestPlayer(0x10000021, 1000.0, 2000.0, 100.0);
+                var player2 = CreateTestPlayer(0x10000022, 1000.0, 2000.0, 100.0);
+
+                var session1 = (Session)System.Runtime.CompilerServices.RuntimeHelpers.GetUninitializedObject(typeof(Session));
+                session1.SetPlayer(player1);
+                session1.VehicleCapabilities = VehicleWire.CapObserve | VehicleWire.CapPilot;
+
+                var session2 = (Session)System.Runtime.CompilerServices.RuntimeHelpers.GetUninitializedObject(typeof(Session));
+                session2.SetPlayer(player2);
+                session2.VehicleCapabilities = VehicleWire.CapObserve | VehicleWire.CapPilot;
+
+                // Board passenger seat directly (Seat 1)
+                VehicleCommands.HandleVehicle(session1, "board", "1");
+                Assert.AreEqual(player1.Guid.Full, v.SeatOccupants[1], "Player 1 boards Seat 1");
+
+                // Board with fallback (Seat 0 is empty -> boards Seat 0)
+                VehicleCommands.HandleVehicle(session2, "board");
+                Assert.AreEqual(player2.Guid.Full, v.SeatOccupants[0], "Player 2 boards Seat 0 (first open seat)");
+            }
+            finally
+            {
+                VehicleManager.UnregisterForTesting(v.Guid.Full);
+            }
+        }
+
+        [TestMethod]
+        public void DriverExit_AutoBrakes_KeepsPassengersSeated()
+        {
+            VehicleManager.EnabledOverride = true;
+            var v = CreateTestJeep(0x7000001A, 1000.0, 2000.0, 100.0);
+            VehicleManager.RegisterForTesting(v);
+
+            try
+            {
+                var pilot = CreateTestPlayer(0x10000031, 1000.0, 2000.0, 100.0);
+                var passenger = CreateTestPlayer(0x10000032, 1000.0, 2000.0, 100.0);
+
+                VehicleManager.SetSeatedForTesting(pilot, v, 0);
+                VehicleManager.SetSeatedForTesting(passenger, v, 1);
+
+                v.State.Mode = VehicleMode.Driving;
+                v.State.Speed = 15.0f;
+                v.GroundState.Speed = 15.0;
+                v.GroundState.Mode = VehicleMode.Driving;
+
+                Assert.AreEqual(pilot.Guid.Full, v.SeatOccupants[0]);
+                Assert.AreEqual(passenger.Guid.Full, v.SeatOccupants[1]);
+
+                // Pilot exits moving vehicle
+                VehicleManager.Unseat(v, pilot, placeOnGround: false);
+
+                // Driver vacated, but passenger remains seated
+                Assert.AreEqual(0u, v.SeatOccupants[0], "Driver seat must be vacated");
+                Assert.AreEqual(passenger.Guid.Full, v.SeatOccupants[1], "Passenger must stay seated in Seat 1");
+                Assert.IsTrue(VehicleManager.IsSeated(passenger), "Passenger is still seated in VehicleManager");
+
+                // Step vehicle once with pilot == null: auto-handbrake decelerates
+                VehicleManager.StepVehicleForTesting(v, null);
+                Assert.IsTrue(v.GroundState.Speed < 15.0, "Vehicle should decelerate under auto-handbrake");
+                Assert.AreEqual(passenger.Guid.Full, v.SeatOccupants[1], "Passenger remains seated during auto-braking");
+            }
+            finally
+            {
+                VehicleManager.UnregisterForTesting(v.Guid.Full);
+            }
+        }
     }
 }
