+using System;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.Entity;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Solar Panels (WCID 4000011, Full Pallet).
+    /// Sun-tracking dual-wing photovoltaic array generating up to 50 kW based on Dereth diurnal sun pitch and weather.
+    /// </summary>
+    public class SolarPanelsDeployable : DeployableBase
+    {
+        public const uint SolarPanelsWeenieClassId = 4_000_011;
+
+        public float WeatherMultiplier { get; set; } = 1.0f;
+
+        public SolarPanelsDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.SolarPanels;
+            Pallet = PalletSize.Full;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                SolarPanelsWeenieClassId,
+                "hbdeployable_solarpanels",
+                "Sun-Tracking Solar Array",
+                "Dual-wing sun-tracking solar array. Generates up to 50 kW clean microgrid power."
+            );
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+            if (IsPacked || !IsActive)
+            {
+                PowerWatts = 0f;
+                return;
+            }
+
+            var hour = DerethSolarModel.GetDerethHour(Timers.PortalYearTicks);
+            PowerWatts = DerethSolarModel.CalculatePower(hour, WeatherMultiplier);
+            PitchRad = DerethSolarModel.GetSunPitchRad(hour);
+        }
+    }
+}
