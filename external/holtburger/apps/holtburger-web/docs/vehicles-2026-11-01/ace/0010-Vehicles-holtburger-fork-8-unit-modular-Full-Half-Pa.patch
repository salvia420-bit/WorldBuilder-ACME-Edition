+        public bool LoadHalfPallet(int slot, uint wcid)
+        {
+            if (wcid == 0) return false;
+            lock (_cargoLock)
+            {
+                if (slot == 0)
+                {
+                    if ((CargoMask & 0x01) != 0 || (CargoMask & 0x04) != 0) return false;
+                    CargoMask |= 0x01;
+                    PalletSize0 = PalletSize.Half;
+                    CargoSlot0Wcid = wcid;
+                    _legacyCargoLoaded = true;
+                    return true;
+                }
+                else if (slot == 1)
+                {
+                    if ((CargoMask & 0x02) != 0 || (CargoMask & 0x04) != 0) return false;
+                    CargoMask |= 0x02;
+                    PalletSize1 = PalletSize.Half;
+                    CargoSlot1Wcid = wcid;
+                    _legacyCargoLoaded = true;
+                    return true;
+                }
+                return false;
+            }
+        }
+
+        public bool UnloadSlot(int slot, out uint wcid)
+        {
+            wcid = 0;
