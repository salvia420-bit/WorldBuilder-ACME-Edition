+        [TestMethod]
+        public void T1_11_WP_01_DeployableState_FieldParity()
+        {
+            var msg = new VehicleDeployableStateMsg
+            {
+                DeployableGuid = 0x70000099,
+                DeployableKind = (uint)DeployableKind.FluxPod,
+                PalletSize = (byte)PalletSize.Full,
+                OnlineFlags = 0x01,
+                AmmoRemaining = 10,
+                OwnerGuid = 0x10000001,
+                ParentVehicle = 0x70000002,
+                Cell = 0x12345678,
+                Position = new Vector3(100.0f, 200.0f, 30.0f),
+                Heading = 1.57f,
+                PowerWatts = 45000.0f,
+                EnergyStoredJoules = 300000.0f,
+                EnergyCapacityJoules = 600000.0f,
+                FuelRemaining = 120.0f,
+                PitchRad = 0.1f,
+                YawRad = 0.2f,
+                RollRad = 0.0f,
+                ElevationM = 0.85f
+            };
+
+            byte[] bytes = VehicleWire.Pack(msg);
+            using var ms = new MemoryStream(bytes);
+            using var reader = new BinaryReader(ms);
+
+            var readMsg = VehicleWire.ReadS2C(VehicleWire.OpDeployableState, reader) as VehicleDeployableStateMsg;
+            Assert.IsNotNull(readMsg);
+            Assert.AreEqual(0x70000099u, readMsg.DeployableGuid);
+            Assert.AreEqual((uint)DeployableKind.FluxPod, readMsg.DeployableKind);
+            Assert.AreEqual((byte)PalletSize.Full, readMsg.PalletSize);
+            Assert.AreEqual(0x01, readMsg.OnlineFlags);
+            Assert.AreEqual(10, readMsg.AmmoRemaining);
+            Assert.AreEqual(0x10000001u, readMsg.OwnerGuid);
+            Assert.AreEqual(0x70000002u, readMsg.ParentVehicle);
+            Assert.AreEqual(0x12345678u, readMsg.Cell);
