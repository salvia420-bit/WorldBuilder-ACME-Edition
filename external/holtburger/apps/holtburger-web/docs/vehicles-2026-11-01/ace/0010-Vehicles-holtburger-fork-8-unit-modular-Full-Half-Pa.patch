+            var evil = (byte[])gcBytes.Clone();
+            BitConverter.GetBytes(uint.MaxValue).CopyTo(evil, contactCountAt);
+            Assert.IsNull(Read("S2C", VehicleWire.OpGroundContacts, evil), "hostile ground contact count");
