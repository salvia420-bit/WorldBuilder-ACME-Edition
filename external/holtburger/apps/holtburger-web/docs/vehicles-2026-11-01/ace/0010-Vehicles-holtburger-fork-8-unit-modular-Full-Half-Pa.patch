+        public class HeavyLaserTurretModel
+        {
+            public const float MaxRangeM = 850.0f;
+            public const float EnergyCostJoules = 120000.0f; // 120 kJ
+
+            public bool TryFire(Vector3 turretPos, Vector3 targetPos, BatteryCapacitorModel battery)
+            {
+                float range = Vector3.Distance(turretPos, targetPos);
+                if (range > MaxRangeM) return false;
+
+                if (battery != null && battery.TryDischarge(EnergyCostJoules))
