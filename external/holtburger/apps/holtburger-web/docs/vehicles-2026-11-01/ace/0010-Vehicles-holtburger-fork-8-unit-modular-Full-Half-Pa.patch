@@ -0,0 +1,120 @@
+using System;
+using System.Linq;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Mortar Turret (WCID 4000016, Half Pallet).
+    /// Cued by Ground Radar, traverses and juts up, lobbing heavy mortars along a 50% current / 50% linear-lead
+    /// parabolic trajectory with green smoke and 2 ground bounces before detonation.
+    /// </summary>
+    public class MortarTurretDeployable : DeployableBase
+    {
+        public const uint MortarTurretWeenieClassId = 4_000_016;
+        public const float StandbyPowerWatts = 800.0f;
+        public const int BounceCount = 2; // Dual bounce invariant
+
+        public override float PowerWatts => StandbyPowerWatts;
+
+        private double _fireCooldownS = 0.0;
+
+        public MortarTurretDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.MortarTurret;
+            Pallet = PalletSize.Half;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                MortarTurretWeenieClassId,
+                "hbdeployable_mortarturret",
+                "Automated Heavy Mortar Turret",
+                "Ground-cued mortar turret. Fires 50/50 linear-lead shells with dual ground bounce detonation."
+            );
+        }
+
+        public Vector3 ComputeAimPoint(Vector3 currentPos, Vector3 velocity, float timeOfFlight)
+        {
+            // 50% current / 50% linear-lead trajectory: P0 + 0.5 * V * tof
+            return currentPos + 0.5f * velocity * timeOfFlight;
+        }
+
+        public bool FireMortar(uint targetGuid, Vector3 targetPos, Vector3 velocity)
+        {
+            if (Location == null) return false;
+            var muzzlePos = Position + new Vector3(0f, 0f, 0.8f);
+            var tof = 3.0f; // nominal time of flight
+            var aimPoint = ComputeAimPoint(targetPos, velocity, tof);
+
+            var dir = aimPoint - muzzlePos;
+            if (dir.LengthSquared() > 0.001f)
+            {
+                var norm = Vector3.Normalize(dir);
+                YawRad = (float)Math.Atan2(norm.X, norm.Y);
+                PitchRad = (float)(Math.PI / 4.0); // 45 deg loft
+            }
+
+            // Lob velocity: horizontal + vertical parabolic component
+            var horizDir = new Vector3(dir.X, dir.Y, 0f);
+            float dist = horizDir.Length();
+            float vHoriz = dist / tof;
+            float vVert = 0.5f * 9.81f * tof;
+            var launchVel = dist > 0.001f ? Vector3.Normalize(horizDir) * vHoriz + new Vector3(0f, 0f, vVert) : new Vector3(0f, 0f, 30f);
+
+            var msg = new VehicleDeployableFireMsg
+            {
+                DeployableGuid = Guid.Full,
+                WeaponKind = (uint)DeployableWeaponKind.Mortar,
+                Step = 0,
+                TargetGuid = targetGuid,
+                Cell = Location != null ? Location.Cell : 0,
+                Muzzle = muzzlePos,
+                TargetPos = aimPoint,
+                Velocity = launchVel,
+                EnergyJoules = 0f,
+                BurstCount = 1,
+            };
+
+            var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+            VehicleManager.BroadcastNear(Location, 1200.0f, deployer, () => msg);
+            BroadcastState();
+            return true;
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+            if (IsPacked || !IsActive) return;
+
+            if (_fireCooldownS > 0.0)
+            {
+                _fireCooldownS = Math.Max(0.0, _fireCooldownS - elapsedSeconds);
+                return;
+            }
+
+            // Cueing from Ground Radar: find nearest ground radar in same grid or nearby
+            GroundRadarDeployable radar = null;
+            if (Grid != null)
+            {
+                radar = Grid.Units.OfType<GroundRadarDeployable>().FirstOrDefault(r => !r.IsPacked && r.IsActive);
+            }
+            if (radar == null)
+            {
+                radar = DeployableManager.FindNearby<GroundRadarDeployable>(Position, 600.0f);
+            }
+
+            if (radar != null && radar.FindNearestGroundContact(out var targetGuid, out var targetPos, out var targetVel, 500.0f))
+            {
+                FireMortar(targetGuid, targetPos, targetVel);
+                _fireCooldownS = 6.0; // 6s cycle between mortar shots
+            }
+        }
+    }
+}
