@@ -0,0 +1,206 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Ground Radar (WCID 4000015, Half Pallet).
+    /// 600m spinning surface radar (30 RPM = 180 deg/s) tracking outdoor players and ground vehicles via IFF,
+    /// with optional monster targeting. Broadcasts Vehicle_GroundContacts (0x090D).
+    /// </summary>
+    public class GroundRadarDeployable : DeployableBase
+    {
+        public const uint GroundRadarWeenieClassId = 4_000_015;
+        public const float RPM = 30.0f;
+        public const float DegreesPerSecond = RPM * 360.0f / 60.0f; // 180 deg/s
+        public const float MaxRangeM = 600.0f;
+
+        public float SweepAngleDeg { get; set; } = 0.0f;
+        public bool TargetMonsters { get; set; } = false;
+        public override float PowerWatts => 500.0f;
+
+        private double _scanTimer = 0.0;
+        private readonly List<GroundContactWire> _latestContacts = new List<GroundContactWire>();
+        private readonly object _contactsLock = new object();
+
+        public GroundRadarDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.GroundRadar;
+            Pallet = PalletSize.Half;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                GroundRadarWeenieClassId,
+                "hbdeployable_groundradar",
+                "Mobile Ground-Surveillance Radar",
+                "600m surface radar (30 RPM). Sweeps outdoor players, ground vehicles, and hostile contacts."
+            );
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+            if (IsPacked || !IsActive) return;
+
+            SweepAngleDeg = (SweepAngleDeg + DegreesPerSecond * (float)elapsedSeconds) % 360.0f;
+            YawRad = (float)(SweepAngleDeg * Math.PI / 180.0);
+
+            _scanTimer += elapsedSeconds;
+            if (_scanTimer >= 0.5) // 2 Hz radar scan
+            {
+                _scanTimer = 0.0;
+                ScanContacts();
+            }
+        }
+
+        private void ScanContacts()
+        {
+            if (Location == null) return;
+            var contacts = new List<GroundContactWire>();
+            var center = Position;
+
+            // 1. Scan online outdoor players
+            foreach (var p in PlayerManager.GetAllOnline())
+            {
+                if (p == null || p.Location == null || p.Guid.Full == DeployerPlayerGuid) continue;
+                var pPos = new Vector3((float)p.Location.Pos.X, (float)p.Location.Pos.Y, (float)p.Location.Pos.Z);
+                float dist = Vector3.Distance(center, pPos);
+                if (dist <= MaxRangeM)
+                {
+                    float heading = (float)VehicleManager.HeadingOf(p.Location.Rotation);
+                    byte headingU8 = (byte)Math.Clamp(Math.Round((heading / (2.0 * Math.PI)) * 255.0), 0, 255);
+                    contacts.Add(new GroundContactWire
+                    {
+                        TargetGuid = p.Guid.Full,
+                        DxM = pPos.X - center.X,
+                        DyM = pPos.Y - center.Y,
+                        DzM = pPos.Z - center.Z,
+                        Kind = (byte)GroundContactKind.Player,
+                        Standing = 2, // Hostile / default external contact
+                        HeadingU8 = headingU8,
+                        SpeedMpsU8 = 0,
+                        Flags = 0,
+                    });
+                }
+            }
+
+            // 2. Scan active ground vehicles
+            foreach (var v in VehicleManager.All)
+            {
+                if (v == null || v.Location == null || v.Guid.Full == ParentVehicleGuid) continue;
+                var vLoc = v.VehiclePosition();
+                var (vx, vy, vz) = Vehicle.ToGlobal(vLoc);
+                var vPos = new Vector3((float)vx, (float)vy, (float)vz);
+                float dist = Vector3.Distance(center, vPos);
+                if (dist <= MaxRangeM)
+                {
+                    float speed = (float)Math.Abs(v.State.Speed);
+                    byte speedU8 = (byte)Math.Clamp(Math.Round(speed), 0, 255);
+                    float heading = (float)v.State.Heading;
+                    byte headingU8 = (byte)Math.Clamp(Math.Round((heading / (2.0 * Math.PI)) * 255.0), 0, 255);
+                    contacts.Add(new GroundContactWire
+                    {
+                        TargetGuid = v.Guid.Full,
+                        DxM = vPos.X - center.X,
+                        DyM = vPos.Y - center.Y,
+                        DzM = vPos.Z - center.Z,
+                        Kind = (byte)GroundContactKind.Vehicle,
+                        Standing = 2,
+                        HeadingU8 = headingU8,
+                        SpeedMpsU8 = speedU8,
+                        Flags = 0,
+                    });
+                }
+            }
+
+            // 3. Scan monsters if enabled
+            if (TargetMonsters && CurrentLandblock != null)
+            {
+                foreach (var wo in CurrentLandblock.GetWorldObjectsForPhysicsHandling())
+                {
+                    if (wo is Creature c && c.IsAlive && c.Location != null)
+                    {
+                        var (cx, cy, cz) = Vehicle.ToGlobal(c.Location);
+                        var cPos = new Vector3((float)cx, (float)cy, (float)cz);
+                        float dist = Vector3.Distance(center, cPos);
+                        if (dist <= MaxRangeM)
+                        {
+                            contacts.Add(new GroundContactWire
+                            {
+                                TargetGuid = c.Guid.Full,
+                                DxM = cPos.X - center.X,
+                                DyM = cPos.Y - center.Y,
+                                DzM = cPos.Z - center.Z,
+                                Kind = (byte)GroundContactKind.Monster,
+                                Standing = 2,
+                                HeadingU8 = 0,
+                                SpeedMpsU8 = 0,
+                                Flags = 0,
+                            });
+                        }
+                    }
+                }
+            }
+
+            lock (_contactsLock)
+            {
+                _latestContacts.Clear();
+                _latestContacts.AddRange(contacts);
+            }
+
+            // Broadcast Vehicle_GroundContacts (0x090D)
+            var msg = new VehicleGroundContactsMsg
+            {
+                RadarGuid = Guid.Full,
+                ParentVehicle = ParentVehicleGuid,
+                RadarX = center.X,
+                RadarY = center.Y,
+                RadarZ = center.Z,
+                RangeM = MaxRangeM,
+                SweepAngleRad = (float)(SweepAngleDeg * Math.PI / 180.0),
+                Contacts = contacts,
+            };
+
+            if (Location == null) return;
+            var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+            VehicleManager.BroadcastNear(Location, MaxRangeM, deployer, () => msg);
+        }
+
+        public bool FindNearestGroundContact(out uint targetGuid, out Vector3 targetPos, out Vector3 targetVel, float maxRange = MaxRangeM)
+        {
+            targetGuid = 0;
+            targetPos = Vector3.Zero;
+            targetVel = Vector3.Zero;
+
+            lock (_contactsLock)
+            {
+                float bestDistSq = maxRange * maxRange;
+                bool found = false;
+
+                foreach (var c in _latestContacts)
+                {
+                    float distSq = c.DxM * c.DxM + c.DyM * c.DyM + c.DzM * c.DzM;
+                    if (distSq < bestDistSq)
+                    {
+                        bestDistSq = distSq;
+                        targetGuid = c.TargetGuid;
+                        targetPos = Position + new Vector3(c.DxM, c.DyM, c.DzM);
+                        float speed = c.SpeedMpsU8;
+                        float headingRad = (float)(c.HeadingU8 / 255.0 * 2.0 * Math.PI);
+                        targetVel = new Vector3((float)Math.Sin(headingRad) * speed, (float)Math.Cos(headingRad) * speed, 0f);
+                        found = true;
+                    }
+                }
+                return found;
+            }
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Deployables/LaserTurretDeployable.cs b/Source/ACE.Server/Vehicles/Deployables/LaserTurretDeployable.cs
new file mode 100644
index 00000000..3cef0222
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Deployables/LaserTurretDeployable.cs
@@ -0,0 +1,124 @@
+using System;
+using System.Linq;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.Managers;
+using ACE.Server.Vehicles.AirDefense;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Heavy Laser Turret (WCID 4000017, Half Pallet).
+    /// Cued by Air Radar and Ground Radar (850m line of sight).
+    /// Fires instant hitscan burst of red laser light consuming 120 kJ grid energy per shot via Vehicle_DeployableFire (0x090C).
+    /// </summary>
+    public class LaserTurretDeployable : DeployableBase
+    {
+        public const uint LaserTurretWeenieClassId = 4_000_017;
+        public const float StandbyPowerWatts = 2000.0f;
+        public const float MaxRangeM = 850.0f;
+        public const float EnergyCostJoules = 120000.0f; // 120 kJ
+
+        public override float PowerWatts => StandbyPowerWatts;
+
+        private double _fireCooldownS = 0.0;
+
+        public LaserTurretDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.HeavyLaserTurret;
+            Pallet = PalletSize.Half;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                LaserTurretWeenieClassId,
+                "hbdeployable_laserturret",
+                "High-Energy Laser Air/Ground Defense Turret",
+                "850m line-of-sight hitscan laser turret. Dual-cued by Air/Ground radar; consumes 120 kJ grid energy."
+            );
+        }
+
+        public bool TryFire(uint targetGuid, Vector3 targetPos)
+        {
+            if (Location == null) return false;
+            float range = Vector3.Distance(Position, targetPos);
+            if (range > MaxRangeM) return false;
+
+            // Must have connected MicroGrid with at least 120 kJ stored energy
+            if (Grid == null || !Grid.TryDischargeEnergy(EnergyCostJoules))
+                return false;
+
+            var muzzlePos = Position + new Vector3(0f, 0f, 0.7f);
+            var dir = targetPos - muzzlePos;
+            var normDir = dir.LengthSquared() > 0.001f ? Vector3.Normalize(dir) : Vector3.UnitY;
+
+            YawRad = (float)Math.Atan2(normDir.X, normDir.Y);
+            PitchRad = (float)Math.Asin(Math.Clamp(normDir.Z, -1.0f, 1.0f));
+
+            var msg = new VehicleDeployableFireMsg
+            {
+                DeployableGuid = Guid.Full,
+                WeaponKind = (uint)DeployableWeaponKind.Laser,
+                Step = 0,
+                TargetGuid = targetGuid,
+                Cell = Location != null ? Location.Cell : 0,
+                Muzzle = muzzlePos,
+                TargetPos = targetPos,
+                Velocity = normDir * 299792458.0f, // Instant hitscan
+                EnergyJoules = EnergyCostJoules,
+                BurstCount = 1,
+            };
+
+            var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+            VehicleManager.BroadcastNear(Location, 1500.0f, deployer, () => msg);
+            BroadcastState();
+            return true;
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+            if (IsPacked || !IsActive) return;
+
+            if (_fireCooldownS > 0.0)
+            {
+                _fireCooldownS = Math.Max(0.0, _fireCooldownS - elapsedSeconds);
+                return;
+            }
+
+            // Dual sensor cueing: Air radar first, then Ground radar
+            var airHostile = AirDefenseRegistry.FindNearestHostile(Position, MaxRangeM);
+            if (airHostile.HasValue)
+            {
+                if (TryFire(airHostile.Value.VehicleGuid, airHostile.Value.WorldPos))
+                {
+                    _fireCooldownS = 2.0; // 2s cycle
+                    return;
+                }
+            }
+
+            // Check Ground radar
+            GroundRadarDeployable groundRadar = null;
+            if (Grid != null)
+            {
+                groundRadar = Grid.Units.OfType<GroundRadarDeployable>().FirstOrDefault(r => !r.IsPacked && r.IsActive);
+            }
+            if (groundRadar == null)
+            {
+                groundRadar = DeployableManager.FindNearby<GroundRadarDeployable>(Position, MaxRangeM);
+            }
+
+            if (groundRadar != null && groundRadar.FindNearestGroundContact(out var targetGuid, out var targetPos, out _, MaxRangeM))
+            {
+                if (TryFire(targetGuid, targetPos))
+                {
+                    _fireCooldownS = 2.0;
+                }
+            }
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Deployables/MicroGrid.cs b/Source/ACE.Server/Vehicles/Deployables/MicroGrid.cs
new file mode 100644
index 00000000..71e318db
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Deployables/MicroGrid.cs
@@ -0,0 +1,186 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Wireless power distribution grid centered on a Flux Pod within an axis-aligned ±75m (150m cube) volume.
+    /// Aggregates power generation and consumption, and charges/discharges battery capacitor banks.
+    /// </summary>
+    public class MicroGrid
+    {
+        public const float HalfVolumeM = 75.0f; // ±75m (150m cube)
+
+        private readonly object _lock = new object();
+        public Vector3 Center { get; set; }
+        public FluxPodDeployable Pod { get; }
+
+        private readonly List<DeployableBase> _units = new List<DeployableBase>();
+        public IReadOnlyList<DeployableBase> Units
+        {
+            get
+            {
+                lock (_lock)
+                {
+                    return _units.ToList();
+                }
+            }
+        }
+
+        public MicroGrid(FluxPodDeployable pod)
+        {
+            Pod = pod;
+            Center = pod != null ? pod.Position : Vector3.Zero;
+        }
+
+        public MicroGrid(Vector3 center)
+        {
+            Center = center;
+        }
+
+        public bool Contains(Vector3 point)
+        {
+            return Math.Abs(point.X - Center.X) <= HalfVolumeM &&
+                   Math.Abs(point.Y - Center.Y) <= HalfVolumeM &&
+                   Math.Abs(point.Z - Center.Z) <= HalfVolumeM;
+        }
+
+        public void Register(DeployableBase unit)
+        {
+            if (unit == null) return;
+            lock (_lock)
+            {
+                if (!_units.Contains(unit))
+                {
+                    _units.Add(unit);
+                    unit.Grid = this;
+                }
+            }
+        }
+
+        public void Unregister(DeployableBase unit)
+        {
+            if (unit == null) return;
+            lock (_lock)
+            {
+                if (_units.Remove(unit))
+                {
+                    if (unit.Grid == this)
+                        unit.Grid = null;
+                }
+            }
+        }
+
+        public float TotalGenerationWatts()
+        {
+            float total = 0f;
+            lock (_lock)
+            {
+                foreach (var u in _units)
+                {
+                    if (u.IsPacked || !u.IsActive) continue;
+                    if (u.Kind == DeployableKind.SolarPanels || u.Kind == DeployableKind.PowerGenerator)
+                        total += u.PowerWatts;
+                }
+            }
+            return total;
+        }
+
+        public float TotalConsumptionWatts()
+        {
+            float total = 0f;
+            lock (_lock)
+            {
+                foreach (var u in _units)
+                {
+                    if (u.IsPacked || !u.IsActive) continue;
+                    if (u.Kind == DeployableKind.GroundRadar) total += 500.0f;
+                    else if (u.Kind == DeployableKind.MissileTurret) total += 1500.0f;
+                    else if (u.Kind == DeployableKind.MortarTurret) total += 800.0f;
+                    else if (u.Kind == DeployableKind.HeavyLaserTurret) total += 2000.0f; // standby
+                }
+            }
+            return total;
+        }
+
+        public float NetPowerBalanceWatts() => TotalGenerationWatts() - TotalConsumptionWatts();
+
+        public void Tick(float deltaSeconds)
+        {
+            if (Pod != null && Pod.Location != null)
+                Center = Pod.Position;
+
+            float netWatts = NetPowerBalanceWatts();
+            float netJoules = netWatts * deltaSeconds;
+
+            lock (_lock)
+            {
+                var batteries = _units.OfType<BatteryDeployable>().Where(b => !b.IsPacked && b.IsActive).ToList();
+                if (batteries.Count == 0) return;
+
+                if (netJoules > 0)
+                {
+                    // Distribute excess energy among batteries that have headroom
+                    float remainingCharge = netJoules;
+                    foreach (var b in batteries)
+                    {
+                        float space = b.EnergyCapacityJoules - b.CapacitorJoules;
+                        if (space > 0)
+                        {
+                            float toAdd = Math.Min(space, remainingCharge);
+                            b.Charge(toAdd);
+                            remainingCharge -= toAdd;
+                            if (remainingCharge <= 0) break;
+                        }
+                    }
+                }
+                else if (netJoules < 0)
+                {
+                    // Draw deficit from batteries that have stored energy
+                    float remainingDeficit = Math.Abs(netJoules);
+                    foreach (var b in batteries)
+                    {
+                        if (b.CapacitorJoules > 0)
+                        {
+                            float toDraw = Math.Min(b.CapacitorJoules, remainingDeficit);
+                            b.CapacitorJoules -= toDraw;
+                            remainingDeficit -= toDraw;
+                            if (remainingDeficit <= 0) break;
+                        }
+                    }
+                }
+            }
+        }
+
+        public bool TryDischargeEnergy(float joules)
+        {
+            if (float.IsNaN(joules) || float.IsInfinity(joules) || joules < 0.0f) return false;
+            if (joules == 0.0f) return true;
+
+            lock (_lock)
+            {
+                var batteries = _units.OfType<BatteryDeployable>()
+                    .Where(b => !b.IsPacked && b.IsActive && !float.IsNaN(b.CapacitorJoules) && !float.IsInfinity(b.CapacitorJoules) && b.CapacitorJoules > 0.0f)
+                    .ToList();
+                float totalAvailable = batteries.Sum(b => b.CapacitorJoules);
+                if (float.IsNaN(totalAvailable) || float.IsInfinity(totalAvailable) || totalAvailable < joules)
+                    return false;
+
+                float remainingToDischarge = joules;
+                foreach (var b in batteries)
+                {
+                    if (b.CapacitorJoules > 0)
+                    {
+                        float draw = Math.Min(b.CapacitorJoules, remainingToDischarge);
+                        b.CapacitorJoules -= draw;
+                        remainingToDischarge -= draw;
+                        if (remainingToDischarge <= 0) break;
+                    }
+                }
+                return true;
+            }
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Deployables/MissileTurretDeployable.cs b/Source/ACE.Server/Vehicles/Deployables/MissileTurretDeployable.cs
new file mode 100644
index 00000000..e088f481
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Deployables/MissileTurretDeployable.cs
@@ -0,0 +1,126 @@
+using System;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.Managers;
+using ACE.Server.Vehicles.AirDefense;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Autonomous Missile Turret (WCID 4000014, Full Pallet).
+    /// Cued by Air Radar (RadarStation), rises suddenly on pneumatic cylinders (0.35s to 0.85m),
+    /// unlocks agile 3-axis tracking, and fires 4 homing SAMs via Vehicle_DeployableFire (0x090C) with 12s reload.
+    /// </summary>
+    public class MissileTurretDeployable : DeployableBase
+    {
+        public const uint MissileTurretWeenieClassId = 4_000_014;
+        public const float TargetElevationM = 0.85f;
+        public const float RiseDurationS = 0.35f;
+        public const float ReloadDurationS = 12.0f;
+        public const ushort MaxAmmo = 4;
+        public const float StandbyPowerWatts = 1500.0f;
+
+        public override float PowerWatts => StandbyPowerWatts;
+        public override ushort AmmoRemaining { get; set; } = MaxAmmo;
+
+        public float ReloadTimerS { get; set; } = 0.0f;
+        public bool IsReloading => ReloadTimerS > 0.0f;
+
+        public MissileTurretDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.MissileTurret;
+            Pallet = PalletSize.Full;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                MissileTurretWeenieClassId,
+                "hbdeployable_missileturret",
+                "Autonomous Air-Defense Missile Turret",
+                "Pneumatic 4-tube SAM launcher. Cued by Air Radar with 3-axis agile tracking and 12s reload."
+            );
+        }
+
+        public void CueTarget(Vector3 targetPos)
+        {
+            var dir = targetPos - Position;
+            if (dir.LengthSquared() > 0.001f)
+            {
+                dir = Vector3.Normalize(dir);
+                YawRad = (float)Math.Atan2(dir.X, dir.Y);
+                PitchRad = (float)Math.Asin(Math.Clamp(dir.Z, -1.0f, 1.0f));
+            }
+        }
+
+        public void AdvanceRise(float dt)
+        {
+            ElevationM = Math.Min(TargetElevationM, ElevationM + (TargetElevationM / RiseDurationS) * dt);
+        }
+
+        public bool FireSalvo(uint targetGuid, Vector3 targetPos)
+        {
+            if (Location == null) return false;
+            if (ElevationM < TargetElevationM || AmmoRemaining == 0 || IsReloading)
+                return false;
+
+            AmmoRemaining = 0;
+            ReloadTimerS = ReloadDurationS;
+
+            var muzzlePos = Position + new Vector3(0f, 0f, ElevationM + 0.5f);
+            var dir = targetPos - muzzlePos;
+            var vel = dir.LengthSquared() > 0.001f ? Vector3.Normalize(dir) * 250.0f : Vector3.UnitY * 250.0f;
+
+            var msg = new VehicleDeployableFireMsg
+            {
+                DeployableGuid = Guid.Full,
+                WeaponKind = (uint)DeployableWeaponKind.SAM,
+                Step = 0,
+                TargetGuid = targetGuid,
+                Cell = Location != null ? Location.Cell : 0,
+                Muzzle = muzzlePos,
+                TargetPos = targetPos,
+                Velocity = vel,
+                EnergyJoules = 0f,
+                BurstCount = 4,
+            };
+
+            var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+            VehicleManager.BroadcastNear(Location, 2000.0f, deployer, () => msg);
+            BroadcastState();
+            return true;
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+            if (IsPacked || !IsActive) return;
+
+            if (ReloadTimerS > 0.0f)
+            {
+                ReloadTimerS = Math.Max(0.0f, ReloadTimerS - (float)elapsedSeconds);
+                if (ReloadTimerS == 0.0f)
+                {
+                    AmmoRemaining = MaxAmmo;
+                    BroadcastState();
+                }
+            }
+
+            // Autonomous cueing via AirDefenseRegistry
+            var hostile = AirDefenseRegistry.FindNearestHostile(Position, 32187.0f);
+            if (hostile.HasValue)
+            {
+                AdvanceRise((float)elapsedSeconds);
+                CueTarget(hostile.Value.WorldPos);
+
+                if (ElevationM >= TargetElevationM && AmmoRemaining > 0 && !IsReloading)
+                {
+                    FireSalvo(hostile.Value.VehicleGuid, hostile.Value.WorldPos);
+                }
+            }
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Deployables/MortarTurretDeployable.cs b/Source/ACE.Server/Vehicles/Deployables/MortarTurretDeployable.cs
