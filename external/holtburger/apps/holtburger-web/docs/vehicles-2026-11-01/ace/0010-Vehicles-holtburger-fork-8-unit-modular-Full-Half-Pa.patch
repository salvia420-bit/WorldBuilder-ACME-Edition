+        public bool LoadFullPallet(uint wcid)
+        {
+            if (wcid == 0) return false;
+            lock (_cargoLock)
+            {
+                if (CargoMask != 0) return false;
+                CargoMask = 0x07;
+                PalletSize0 = PalletSize.Full;
+                PalletSize1 = PalletSize.Full;
+                CargoSlot0Wcid = wcid;
