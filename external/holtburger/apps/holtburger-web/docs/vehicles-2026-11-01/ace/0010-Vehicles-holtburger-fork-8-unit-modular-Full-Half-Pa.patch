+        public static class PalletGeometry
+        {
+            public static readonly float FullWidthM = 2.40f;
+            public static readonly float FullLengthM = 2.40f;
+            public static readonly float FullHeightM = 0.15f;
+
+            public static readonly float HalfWidthM = 1.20f;
+            public static readonly float HalfLengthM = 2.40f;
+            public static readonly float HalfHeightM = 0.15f;
+
+            public static readonly float HalfSlot0XOffsetM = -0.60f;
+            public static readonly float HalfSlot1XOffsetM = +0.60f;
+
+            public static readonly float ForkPocketWidthM = 0.25f;
+            public static readonly float ForkPocketHeightM = 0.10f;
+
+            public static Vector3 FullBoundingBoxMin => new Vector3(-FullWidthM / 2f, -FullLengthM / 2f, 0.0f);
+            public static Vector3 FullBoundingBoxMax => new Vector3(FullWidthM / 2f, FullLengthM / 2f, FullHeightM);
+
+            public static Vector3 HalfBoundingBoxMin => new Vector3(-HalfWidthM / 2f, -HalfLengthM / 2f, 0.0f);
+            public static Vector3 HalfBoundingBoxMax => new Vector3(HalfWidthM / 2f, HalfLengthM / 2f, HalfHeightM);
+
+            public static Vector3 ComputeSideBySideCombinedFootprint(Vector3 posSlot0, Vector3 posSlot1)
+            {
+                float minX = Math.Min(posSlot0.X - HalfWidthM / 2f, posSlot1.X - HalfWidthM / 2f);
+                float maxX = Math.Max(posSlot0.X + HalfWidthM / 2f, posSlot1.X + HalfWidthM / 2f);
+                float length = Math.Max(HalfLengthM, HalfLengthM);
+                return new Vector3(maxX - minX, length, FullHeightM);
+            }
+
+            public static Quaternion AlignToNormal(Vector3 normal)
+            {
+                var v0 = Vector3.UnitZ;
+                var v1 = Vector3.Normalize(normal);
+                float dot = Math.Clamp(Vector3.Dot(v0, v1), -1.0f, 1.0f);
+                if (dot > 0.999999f) return Quaternion.Identity;
+                if (dot < -0.999999f) return Quaternion.CreateFromAxisAngle(Vector3.UnitX, (float)Math.PI);
+                var axis = Vector3.Normalize(Vector3.Cross(v0, v1));
+                float angle = (float)Math.Acos(dot);
+                return Quaternion.CreateFromAxisAngle(axis, angle);
+            }
+        }
