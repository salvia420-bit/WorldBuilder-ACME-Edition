new file mode 100644
index 00000000..40737ead
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Deployables/BatteryDeployable.cs
@@ -0,0 +1,64 @@
+using System;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Battery Capacitor Unit (WCID 4000013, Half Pallet).
+    /// 600 kJ capacitor bank buffer with 5-bar state-of-charge display.
+    /// Stores excess microgrid power and buffers night/cloud deficits and weapon firing spikes.
+    /// </summary>
+    public class BatteryDeployable : DeployableBase
+    {
+        public const uint BatteryWeenieClassId = 4_000_013;
+        public const float MaxCapacityJoules = 600000.0f; // 600 kJ
+
+        public float CapacitorJoules { get; set; }
+        public override float EnergyStoredJoules => CapacitorJoules;
+        public override float EnergyCapacityJoules => MaxCapacityJoules;
+
+        public int StateOfChargeBars
+        {
+            get
+            {
+                if (CapacitorJoules <= 0.0f) return 0;
+                if (CapacitorJoules >= MaxCapacityJoules) return 5;
+                return (int)Math.Floor(CapacitorJoules / (MaxCapacityJoules / 5.0f));
+            }
+        }
+
+        public BatteryDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.BatteryUnit;
+            Pallet = PalletSize.Half;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                BatteryWeenieClassId,
+                "hbdeployable_battery",
+                "Battery Capacitor Bank",
+                "600 kJ capacitor bank with 5-bar state of charge. Buffers solar/generator microgrid power."
+            );
+        }
+
+        public void Charge(float joules)
+        {
+            CapacitorJoules = Math.Clamp(CapacitorJoules + joules, 0.0f, MaxCapacityJoules);
+        }
+
+        public bool TryDischarge(float joules)
+        {
+            if (CapacitorJoules >= joules)
+            {
+                CapacitorJoules -= joules;
+                return true;
+            }
+            return false;
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Deployables/DeployableBase.cs b/Source/ACE.Server/Vehicles/Deployables/DeployableBase.cs
new file mode 100644
index 00000000..581c1e10
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Deployables/DeployableBase.cs
@@ -0,0 +1,149 @@
+using System;
+using System.Collections.Generic;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Enum.Properties;
+using ACE.Entity.Models;
+using ACE.Server.Entity;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Base class for all modular deployable units in the 8-unit ecosystem.
+    /// Excluded from shard persistence in WorldObject_Database.cs:146.
+    /// </summary>
+    public abstract class DeployableBase : WorldObject
+    {
+        public DeployableKind Kind { get; protected set; }
+        public PalletSize Pallet { get; protected set; }
+        public uint Wcid => WeenieClassId;
+
+        public MicroGrid Grid { get; set; }
+        public uint ParentVehicleGuid { get; set; }
+        public uint DeployerPlayerGuid { get; set; }
+
+        public byte OnlineFlags { get; set; } = 1;
+        public virtual float PowerWatts { get; set; }
+        public virtual float EnergyStoredJoules { get; set; }
+        public virtual float EnergyCapacityJoules { get; set; }
+        public virtual float FuelRemaining { get; set; }
+        public virtual ushort AmmoRemaining { get; set; }
+
+        public float PitchRad { get; set; }
+        public float YawRad { get; set; }
+        public float RollRad { get; set; }
+        public float ElevationM { get; set; }
+
+        public bool IsPacked { get; set; } = false;
+        public bool IsActive { get; set; } = true;
+
+        public Vector3 Position => Location != null
+            ? new Vector3((float)Location.Pos.X, (float)Location.Pos.Y, (float)Location.Pos.Z)
+            : Vector3.Zero;
+
+        public float Heading => Location != null
+            ? (float)VehicleManager.HeadingOf(Location.Rotation)
+            : 0.0f;
+
+        protected DeployableBase(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid)
+        {
+            ParentVehicleGuid = parentVehicle?.Guid.Full ?? 0;
+            DeployerPlayerGuid = deployer?.Guid.Full ?? 0;
+        }
+
+        public VehicleDeployableStateMsg CreateStateMsg()
+        {
+            return new VehicleDeployableStateMsg
+            {
+                DeployableGuid = Guid.Full,
+                DeployableKind = (uint)Kind,
+                PalletSize = (byte)Pallet,
+                OnlineFlags = (byte)(IsActive && !IsPacked ? OnlineFlags : 0),
+                AmmoRemaining = AmmoRemaining,
+                OwnerGuid = DeployerPlayerGuid,
+                ParentVehicle = ParentVehicleGuid,
+                Cell = Location != null ? Location.Cell : 0,
+                Position = Position,
+                Heading = Heading,
+                PowerWatts = PowerWatts,
+                EnergyStoredJoules = EnergyStoredJoules,
+                EnergyCapacityJoules = EnergyCapacityJoules,
+                FuelRemaining = FuelRemaining,
+                PitchRad = PitchRad,
+                YawRad = YawRad,
+                RollRad = RollRad,
+                ElevationM = ElevationM,
+            };
+        }
+
+        public void BroadcastState(float range = 600.0f)
+        {
+            if (Location == null) return;
+            var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+            VehicleManager.BroadcastNear(Location, range, deployer, () => CreateStateMsg());
+        }
+
+        public static Weenie BuildDeployableWeenie(uint wcid, string className, string name, string useDesc)
+        {
+            return new Weenie
+            {
+                WeenieClassId = wcid,
+                ClassName = className,
+                WeenieType = WeenieType.Generic,
+                PropertiesBool = new Dictionary<PropertyBool, bool>
+                {
+                    [PropertyBool.Stuck] = true,
+                    [PropertyBool.Attackable] = false,
+                    [PropertyBool.Ethereal] = true,
+                    [PropertyBool.IgnoreCollisions] = true,
+                    [PropertyBool.ReportCollisions] = false,
+                    [PropertyBool.GravityStatus] = false,
+                },
+                PropertiesDID = new Dictionary<PropertyDataId, uint>
+                {
+                    [PropertyDataId.Setup] = 0x02000216,
+                    [PropertyDataId.Icon] = 0x06003711,
+                },
+                PropertiesFloat = new Dictionary<PropertyFloat, double>
+                {
+                    [PropertyFloat.DefaultScale] = 1.0,
+                    [PropertyFloat.UseRadius] = 4.0,
+                    [PropertyFloat.TimeToRot] = -1.0,
+                },
+                PropertiesInt = new Dictionary<PropertyInt, int>
+                {
+                    [PropertyInt.ItemType] = (int)ItemType.Misc,
+                    [PropertyInt.ItemUseable] = (int)Usable.Remote,
+                    [PropertyInt.ShowableOnRadar] = (int)ACE.Entity.Enum.RadarBehavior.ShowAlways,
+                    [PropertyInt.RadarBlipColor] = (int)ACE.Entity.Enum.RadarColor.Green,
+                    [PropertyInt.Value] = 0,
+                    [PropertyInt.EncumbranceVal] = 0,
+                },
+                PropertiesString = new Dictionary<PropertyString, string>
+                {
+                    [PropertyString.Name] = name,
+                    [PropertyString.Use] = useDesc,
+                },
+            };
+        }
+
+        public new virtual void Destroy(bool raiseNotifyOfDestructionEvent = true, bool fromLandblockUnload = false)
+        {
+            DeployableManager.Unregister(Guid.Full);
+            if (Grid != null)
+            {
+                Grid.Unregister(this);
+                Grid = null;
+            }
+            base.Destroy(raiseNotifyOfDestructionEvent, fromLandblockUnload);
+        }
+
+        public virtual void Tick(double elapsedSeconds)
+        {
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Deployables/DeployableManager.cs b/Source/ACE.Server/Vehicles/Deployables/DeployableManager.cs
new file mode 100644
index 00000000..5fb71351
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Deployables/DeployableManager.cs
@@ -0,0 +1,220 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Linq;
+using System.Numerics;
+using ACE.Entity;
+using ACE.Server.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Static registry and lifecycle coordinator for all modular deployables and power microgrids in ACE.Server.
+    /// Ticked from VehicleManager.Tick and VehicleManager.TickInner.
+    /// </summary>
+    public static class DeployableManager
+    {
+        private static readonly ConcurrentDictionary<uint, DeployableBase> _deployables = new ConcurrentDictionary<uint, DeployableBase>();
+        private static readonly List<MicroGrid> _grids = new List<MicroGrid>();
+        private static readonly object _gridLock = new object();
+
+        private static double _stateBroadcastTimer = 0.0;
+
+        public static void Register(DeployableBase deployable)
+        {
+            if (deployable != null)
+                _deployables[deployable.Guid.Full] = deployable;
+        }
+
+        public static void Unregister(uint guid)
+        {
+            _deployables.TryRemove(guid, out _);
+        }
+
+        public static void RegisterGrid(MicroGrid grid)
+        {
+            if (grid == null) return;
+            lock (_gridLock)
+            {
+                if (!_grids.Contains(grid))
+                    _grids.Add(grid);
+            }
+        }
+
+        public static void UnregisterGrid(MicroGrid grid)
+        {
+            if (grid == null) return;
+            lock (_gridLock)
+            {
+                _grids.Remove(grid);
+            }
+        }
+
+        public static DeployableBase GetDeployable(uint guid)
+        {
+            _deployables.TryGetValue(guid, out var d);
+            return d;
+        }
+
+        public static IEnumerable<DeployableBase> GetAll() => _deployables.Values;
+
+        public static IReadOnlyList<MicroGrid> GetAllGrids()
+        {
+            lock (_gridLock)
+            {
+                return _grids.ToList();
+            }
+        }
+
+        public static T FindNearby<T>(Vector3 pos, float maxRange) where T : DeployableBase
+        {
+            float maxDistSq = maxRange * maxRange;
+            T best = null;
+            float bestDistSq = maxDistSq;
+
+            foreach (var d in _deployables.Values.OfType<T>())
+            {
+                if (d.IsPacked || !d.IsActive) continue;
+                float distSq = Vector3.DistanceSquared(pos, d.Position);
+                if (distSq < bestDistSq)
+                {
+                    bestDistSq = distSq;
+                    best = d;
+                }
+            }
+            return best;
+        }
+
+        public static void Clear()
+        {
+            _deployables.Clear();
+            lock (_gridLock)
+            {
+                _grids.Clear();
+            }
+        }
+
+        public static DeployableBase SpawnDeployable(uint wcid, Position location, Player deployer = null, Vehicle parentVehicle = null)
+        {
+            ObjectGuid guid;
+            try
+            {
+                guid = GuidManager.NewDynamicGuid();
+            }
+            catch (NullReferenceException)
+            {
+                guid = new ObjectGuid(0x75000000u | ((uint)new Random().Next(0x00010000, 0x000FFFFF)));
+            }
+
+            DeployableBase deployable = null;
+            switch (wcid)
+            {
+                case FluxPodDeployable.FluxPodWeenieClassId:
+                    deployable = new FluxPodDeployable(FluxPodDeployable.BuildWeenie(parentVehicle, deployer), guid, parentVehicle, deployer);
+                    break;
+                case SolarPanelsDeployable.SolarPanelsWeenieClassId:
+                    deployable = new SolarPanelsDeployable(SolarPanelsDeployable.BuildWeenie(parentVehicle, deployer), guid, parentVehicle, deployer);
+                    break;
+                case PowerGeneratorDeployable.PowerGeneratorWeenieClassId:
+                    deployable = new PowerGeneratorDeployable(PowerGeneratorDeployable.BuildWeenie(parentVehicle, deployer), guid, parentVehicle, deployer);
+                    break;
+                case BatteryDeployable.BatteryWeenieClassId:
+                    deployable = new BatteryDeployable(BatteryDeployable.BuildWeenie(parentVehicle, deployer), guid, parentVehicle, deployer);
+                    break;
+                case MissileTurretDeployable.MissileTurretWeenieClassId:
+                    deployable = new MissileTurretDeployable(MissileTurretDeployable.BuildWeenie(parentVehicle, deployer), guid, parentVehicle, deployer);
+                    break;
+                case GroundRadarDeployable.GroundRadarWeenieClassId:
+                    deployable = new GroundRadarDeployable(GroundRadarDeployable.BuildWeenie(parentVehicle, deployer), guid, parentVehicle, deployer);
+                    break;
+                case MortarTurretDeployable.MortarTurretWeenieClassId:
+                    deployable = new MortarTurretDeployable(MortarTurretDeployable.BuildWeenie(parentVehicle, deployer), guid, parentVehicle, deployer);
+                    break;
+                case LaserTurretDeployable.LaserTurretWeenieClassId:
+                    deployable = new LaserTurretDeployable(LaserTurretDeployable.BuildWeenie(parentVehicle, deployer), guid, parentVehicle, deployer);
+                    break;
+                default:
+                    return null;
+            }
+
+            deployable.Location = location;
+            deployable.EnterWorld();
+            Register(deployable);
+
+            // If not a flux pod, bind to enclosing microgrid if one exists
+            if (deployable.Kind != DeployableKind.FluxPod)
+            {
+                lock (_gridLock)
+                {
+                    foreach (var g in _grids)
+                    {
+                        if (g.Contains(deployable.Position))
+                        {
+                            g.Register(deployable);
+                            break;
+                        }
+                    }
+                }
+            }
+
+            deployable.BroadcastState();
+            return deployable;
+        }
+
+        public static void Tick(double elapsedSeconds)
+        {
+            // 1. Tick all MicroGrids
+            List<MicroGrid> activeGrids;
+            lock (_gridLock)
+            {
+                activeGrids = _grids.ToList();
+            }
+
+            foreach (var grid in activeGrids)
+            {
+                grid.Tick((float)elapsedSeconds);
+            }
+
+            // 2. Spatial grid association & ticking for all deployables
+            _stateBroadcastTimer += elapsedSeconds;
+            bool broadcastState = _stateBroadcastTimer >= 1.0; // 1 Hz state sync
+            if (broadcastState) _stateBroadcastTimer = 0.0;
+
+            foreach (var deployable in _deployables.Values)
+            {
+                if (deployable.IsDestroyed)
+                {
+                    Unregister(deployable.Guid.Full);
+                    continue;
+                }
+
+                // Grid connection evaluation
+                if (deployable.Kind != DeployableKind.FluxPod)
+                {
+                    if (deployable.Grid == null || !deployable.Grid.Contains(deployable.Position))
+                    {
+                        if (deployable.Grid != null)
+                            deployable.Grid.Unregister(deployable);
+
+                        foreach (var g in activeGrids)
+                        {
+                            if (g.Contains(deployable.Position))
+                            {
+                                g.Register(deployable);
+                                break;
+                            }
+                        }
+                    }
+                }
+
+                deployable.Tick(elapsedSeconds);
+
+                if (broadcastState && !deployable.IsPacked && deployable.IsActive)
+                {
+                    deployable.BroadcastState();
+                }
+            }
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Deployables/DerethSolarModel.cs b/Source/ACE.Server/Vehicles/Deployables/DerethSolarModel.cs
new file mode 100644
index 00000000..0364bc3e
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/Deployables/DerethSolarModel.cs
@@ -0,0 +1,42 @@
+using System;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Computes diurnal solar irradiance based on Dereth time (7620 ticks/seconds per day)
+    /// and atmospheric/weather attenuation.
+    /// </summary>
+    public static class DerethSolarModel
+    {
+        public const float PeakNoonWatts = 50000.0f; // 50 kW nominal peak
+        public const double DayLengthSeconds = 7620.0; // Dereth day length
+
+        public static float GetDerethHour(double portalYearTicks)
+        {
+            var dayTicks = portalYearTicks % DayLengthSeconds;
+            if (dayTicks < 0) dayTicks += DayLengthSeconds;
+            return (float)((dayTicks / DayLengthSeconds) * 24.0);
+        }
+
+        public static float CalculatePower(float derethHour, float weatherMultiplier = 1.0f)
+        {
+            // hour: 0.0 to 24.0. Noon is 12.0. Night is 18.0 to 6.0.
+            if (derethHour < 6.0f || derethHour > 18.0f)
+                return 0.0f; // Night time
+
+            // Normalized solar pitch curve: sin((hour - 6) / 12 * PI)
+            float sunPitch = (float)Math.Sin((derethHour - 6.0f) / 12.0f * Math.PI);
+            if (sunPitch < 0.0f) sunPitch = 0.0f;
+
+            return PeakNoonWatts * sunPitch * Math.Clamp(weatherMultiplier, 0.0f, 1.0f);
+        }
+
+        public static float GetSunPitchRad(float derethHour)
+        {
+            if (derethHour < 6.0f || derethHour > 18.0f)
+                return 0.0f;
+
+            return (float)((derethHour - 6.0f) / 12.0f * Math.PI);
+        }
+    }
+}
