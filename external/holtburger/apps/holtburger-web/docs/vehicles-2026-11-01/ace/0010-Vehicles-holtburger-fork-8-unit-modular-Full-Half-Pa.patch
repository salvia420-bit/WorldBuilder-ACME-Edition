+            "list                              - list active deployables\n" +
+            "despawn <guid|all>                - despawn deployable(s)")]
+        public static void HandleDeployable(Session session, params string[] parameters)
+        {
+            var player = session.Player;
+            if (parameters.Length == 0)
+            {
+                CommandHandlerHelper.WriteOutputInfo(session, "usage: @deployable spawn <wcid> [x y z] | load <vGuid> <slot> <wcid> | preset base | fuel <guid> <amount> | monsters <guid> <on|off> | list | despawn <guid|all>");
