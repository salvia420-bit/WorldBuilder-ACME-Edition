+                        float fz = !double.IsNaN(groundZ) ? (float)groundZ : (float)pz;
+                        spawnPos = Vehicle.ToPosition(fx, fy, fz, player.Location?.Rotation ?? System.Numerics.Quaternion.Identity);
+                    }
+
+                    var d = Deployables.DeployableManager.SpawnDeployable(wcid, spawnPos, player);
+                    if (d != null)
