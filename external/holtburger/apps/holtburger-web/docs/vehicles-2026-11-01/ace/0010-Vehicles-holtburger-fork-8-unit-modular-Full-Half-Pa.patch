@@ -0,0 +1,64 @@
+using System;
+using ACE.Entity;
+using ACE.Entity.Models;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Flux Pod (WCID 4000010, Full Pallet).
+    /// Anchors and manages a wireless MicroGrid distributing power across a ±75m (150m cube) volume.
+    /// </summary>
+    public class FluxPodDeployable : DeployableBase
+    {
+        public const uint FluxPodWeenieClassId = 4_000_010;
+
+        public FluxPodDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.FluxPod;
+            Pallet = PalletSize.Full;
+            Grid = new MicroGrid(this);
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                FluxPodWeenieClassId,
+                "hbdeployable_fluxpod",
+                "Flux Pod Wireless Power Hub",
+                "Anchors a ±75m wireless power microgrid for forward operating base deployables."
+            );
+        }
+
+        public override bool EnterWorld()
+        {
+            var result = base.EnterWorld();
+            if (result && Grid != null)
+            {
+                Grid.Center = Position;
+                DeployableManager.RegisterGrid(Grid);
+            }
+            return result;
+        }
+
+        public override void Destroy(bool raiseNotifyOfDestructionEvent = true, bool fromLandblockUnload = false)
+        {
+            if (Grid != null)
+            {
+                DeployableManager.UnregisterGrid(Grid);
+            }
+            base.Destroy(raiseNotifyOfDestructionEvent, fromLandblockUnload);
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+            if (Grid != null)
+            {
+                Grid.Center = Position;
+                PowerWatts = Grid.NetPowerBalanceWatts();
+            }
+        }
+    }
+}
diff --git a/Source/ACE.Server/Vehicles/Deployables/GroundRadarDeployable.cs b/Source/ACE.Server/Vehicles/Deployables/GroundRadarDeployable.cs
new file mode 100644
index 00000000..c8eb8679
