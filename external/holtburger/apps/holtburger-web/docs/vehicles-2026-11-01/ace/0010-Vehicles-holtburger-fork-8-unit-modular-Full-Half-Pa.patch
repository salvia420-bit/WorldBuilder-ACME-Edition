+        public class MockMicroGrid
+        {
+            public Vector3 Center { get; set; }
+            public const float HalfVolumeM = 75.0f; // ±75m (150m cube)
+            public List<MockDeployable> Units { get; } = new List<MockDeployable>();
+
+            public MockMicroGrid(Vector3 center)
+            {
+                Center = center;
+            }
+
+            public bool Contains(Vector3 point)
+            {
+                return Math.Abs(point.X - Center.X) <= HalfVolumeM &&
+                       Math.Abs(point.Y - Center.Y) <= HalfVolumeM &&
+                       Math.Abs(point.Z - Center.Z) <= HalfVolumeM;
+            }
+
+            public float TotalGenerationWatts()
+            {
+                float total = 0f;
+                foreach (var u in Units)
+                {
+                    if (u.IsPacked) continue;
+                    if (u.Kind == DeployableKind.SolarPanels || u.Kind == DeployableKind.PowerGenerator)
+                        total += u.PowerWatts;
+                }
+                return total;
+            }
+
+            public float TotalConsumptionWatts()
+            {
+                float total = 0f;
+                foreach (var u in Units)
+                {
+                    if (u.IsPacked) continue;
+                    if (u.Kind == DeployableKind.GroundRadar) total += 500f;
+                    if (u.Kind == DeployableKind.MissileTurret) total += 1500f;
+                    if (u.Kind == DeployableKind.MortarTurret) total += 800f;
+                    if (u.Kind == DeployableKind.HeavyLaserTurret) total += 2000f; // standby
+                }
+                return total;
+            }
+
+            public float NetPowerBalanceWatts() => TotalGenerationWatts() - TotalConsumptionWatts();
+
+            public void Tick(float deltaSeconds)
+            {
+                float netWatts = NetPowerBalanceWatts();
+                float netJoules = netWatts * deltaSeconds;
+
+                // Battery charging / discharging
+                foreach (var u in Units)
+                {
+                    if (u.Kind == DeployableKind.BatteryUnit && !u.IsPacked)
+                    {
+                        if (netJoules > 0)
+                        {
+                            u.CapacitorJoules = Math.Min(600000.0f, u.CapacitorJoules + netJoules);
+                        }
+                        else if (netJoules < 0)
+                        {
+                            u.CapacitorJoules = Math.Max(0.0f, u.CapacitorJoules + netJoules);
+                        }
+                    }
+                }
+            }
+        }
