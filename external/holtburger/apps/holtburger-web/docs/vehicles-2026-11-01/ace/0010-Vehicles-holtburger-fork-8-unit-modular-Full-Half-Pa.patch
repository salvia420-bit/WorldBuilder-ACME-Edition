+
+                    bool isFull = wcid is 4000010 or 4000011 or 4000012 or 4000014 or 4000002;
+                    bool loaded;
+                    if (isFull)
+                        loaded = v.LoadFullPallet(wcid);
+                    else
+                        loaded = v.LoadHalfPallet(slot, wcid);
+
+                    if (loaded)
+                        CommandHandlerHelper.WriteOutputInfo(session, $"loaded wcid {wcid} onto vehicle 0x{vGuid:X8} (slot {slot}, mask 0x{v.CargoMask:X2})");
+                    else
+                        CommandHandlerHelper.WriteOutputInfo(session, $"failed to load wcid {wcid} onto vehicle 0x{vGuid:X8} (bed occupied or incompatible)");
+                    return;
+                }
+                case "preset":
+                {
+                    if (parameters.Length > 1 && parameters[1].Equals("base", StringComparison.OrdinalIgnoreCase))
+                    {
+                        var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                        var rot = player.Location?.Rotation ?? System.Numerics.Quaternion.Identity;
+
+                        var fpPos = Vehicle.ToPosition(px, py, pz, rot);
+                        var spPos = Vehicle.ToPosition(px + 8.0, py, pz, rot);
+                        var pgPos = Vehicle.ToPosition(px - 8.0, py, pz, rot);
+                        var buPos = Vehicle.ToPosition(px, py + 6.0, pz, rot);
+                        var grPos = Vehicle.ToPosition(px, py - 6.0, pz, rot);
+                        var mtPos = Vehicle.ToPosition(px + 6.0, py + 6.0, pz, rot);
+                        var moPos = Vehicle.ToPosition(px - 6.0, py - 6.0, pz, rot);
+                        var ltPos = Vehicle.ToPosition(px + 6.0, py - 6.0, pz, rot);
+
+                        Deployables.DeployableManager.SpawnDeployable(4000010, fpPos, player); // Flux Pod
+                        Deployables.DeployableManager.SpawnDeployable(4000011, spPos, player); // Solar Panels
+                        var gen = Deployables.DeployableManager.SpawnDeployable(4000012, pgPos, player) as Deployables.PowerGeneratorDeployable; // Generator
