+
+                    uint vGuid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out vGuid);
+                    else
+                        uint.TryParse(parameters[1], out vGuid);
+
+                    if (!int.TryParse(parameters[2], out var slot) || (slot != 0 && slot != 1))
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "slot must be 0 or 1");
+                        return;
+                    }
+
+                    if (!uint.TryParse(parameters[3], out var wcid))
