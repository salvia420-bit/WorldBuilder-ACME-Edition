+        public static class SolarIrradianceModel
+        {
+            public const float PeakNoonWatts = 50000.0f; // 50 kW nominal peak
+
+            public static float CalculatePower(float derethHour, float weatherMultiplier = 1.0f)
+            {
+                // hour: 0.0 to 24.0. Noon is 12.0. Night is 20.0 to 4.0.
+                if (derethHour < 6.0f || derethHour > 18.0f)
+                    return 0.0f; // Night time
+
+                // Normalized solar pitch curve: sin((hour - 6) / 12 * PI)
+                float sunPitch = (float)Math.Sin((derethHour - 6.0f) / 12.0f * Math.PI);
+                if (sunPitch < 0.0f) sunPitch = 0.0f;
+
+                return PeakNoonWatts * sunPitch * Math.Clamp(weatherMultiplier, 0.0f, 1.0f);
+            }
+        }
+
+        public class ScarabGeneratorModel
+        {
+            public const float BurnRateSecondsPerScarab = 120.0f;
+            public const float OutputPowerWatts = 45000.0f; // 45 kW steady output
+
+            public float FuelSecondsRemaining { get; private set; }
+            public float PowerWatts => FuelSecondsRemaining > 0.0f ? OutputPowerWatts : 0.0f;
+
+            public void AddFuel(int scarabCount)
+            {
+                if (scarabCount > 0)
+                    FuelSecondsRemaining += scarabCount * BurnRateSecondsPerScarab;
+            }
+
+            public void Tick(float deltaSeconds)
+            {
+                if (FuelSecondsRemaining > 0.0f)
+                {
+                    FuelSecondsRemaining = Math.Max(0.0f, FuelSecondsRemaining - deltaSeconds);
+                }
+            }
+        }
+
+        public class BatteryCapacitorModel
+        {
+            public const float MaxCapacityJoules = 600000.0f; // 600 kJ
+            public float CurrentJoules { get; set; }
+
+            public int StateOfChargeBars
+            {
+                get
+                {
+                    if (CurrentJoules <= 0.0f) return 0;
+                    if (CurrentJoules >= MaxCapacityJoules) return 5;
+                    return (int)Math.Floor(CurrentJoules / (MaxCapacityJoules / 5.0f));
+                }
+            }
+
+            public void Charge(float joules)
+            {
+                CurrentJoules = Math.Clamp(CurrentJoules + joules, 0.0f, MaxCapacityJoules);
+            }
+
+            public bool TryDischarge(float joules)
+            {
+                if (CurrentJoules >= joules)
+                {
+                    CurrentJoules -= joules;
+                    return true;
+                }
+                return false;
+            }
+        }
+
+        public class MissileTurretModel
+        {
+            public float ElevationM { get; private set; } = 0.0f;
+            public const float TargetElevationM = 0.85f;
+            public const float RiseDurationS = 0.35f;
+            public uint AmmoCount { get; private set; } = 4;
+            public float ReloadTimerS { get; private set; } = 0.0f;
+            public bool IsReloading => ReloadTimerS > 0.0f;
+
+            public void CueTarget()
+            {
+                // Triggers pneumatic rise
+            }
+
+            public void AdvanceRise(float dt)
+            {
+                ElevationM = Math.Min(TargetElevationM, ElevationM + (TargetElevationM / RiseDurationS) * dt);
+            }
+
+            public bool FireSalvo()
+            {
+                if (ElevationM < TargetElevationM || AmmoCount == 0 || IsReloading)
+                    return false;
+
+                AmmoCount = 0;
+                ReloadTimerS = 12.0f; // 12s reload cycle
+                return true;
+            }
+
+            public void Tick(float dt)
+            {
+                if (ReloadTimerS > 0.0f)
+                {
+                    ReloadTimerS = Math.Max(0.0f, ReloadTimerS - dt);
+                    if (ReloadTimerS == 0.0f)
+                        AmmoCount = 4;
+                }
+            }
+        }
+
+        public class GroundRadarModel
+        {
+            public const float RPM = 30.0f;
+            public const float DegreesPerSecond = RPM * 360.0f / 60.0f; // 180 deg/s
+            public const float MaxRangeM = 600.0f;
+            public float SweepAngleDeg { get; private set; } = 0.0f;
+
+            public void Tick(float dt)
+            {
+                SweepAngleDeg = (SweepAngleDeg + DegreesPerSecond * dt) % 360.0f;
+            }
+
+            public bool Detect(Vector3 radarPos, Vector3 targetPos, out float range)
+            {
+                range = Vector3.Distance(radarPos, targetPos);
+                return range <= MaxRangeM;
+            }
+        }
+
+        public class MortarTurretModel
+        {
+            public Vector3 ComputeAimPoint(Vector3 currentPos, Vector3 velocity, float timeOfFlight)
+            {
+                // 50% current / 50% linear-lead trajectory: P0 + 0.5 * V * tof
+                return currentPos + 0.5f * velocity * timeOfFlight;
+            }
+
+            public int BounceCount => 2; // dual bounce invariant
+        }
