+        [TestMethod]
+        public void T2_8_WIRE_01_ZeroBytePayloadRejected()
+        {
+            using var ms = new MemoryStream(Array.Empty<byte>());
+            using var r = new BinaryReader(ms);
+            Assert.ThrowsExactly<EndOfStreamException>(() => VehicleWire.ReadHeader(r));
+            ms.Position = 0;
+            Assert.IsNull(VehicleWire.ReadS2C(VehicleWire.OpDeployableState, r));
+            ms.Position = 0;
+            Assert.IsNull(VehicleWire.ReadC2S(VehicleWire.OpCargo, r));
+        }
+
+        [TestMethod]
+        public void T2_8_WIRE_02_TruncatedHeaderRejected()
+        {
+            // Truncated 7-byte stream (tag 4 bytes + version 2 bytes + only 1 byte of reserved)
+            byte[] truncated = new byte[] { 0x48, 0x42, 0x56, 0x31, 0x04, 0x00, 0x00 };
+            using var ms = new MemoryStream(truncated);
+            using var r = new BinaryReader(ms);
+            Assert.ThrowsExactly<EndOfStreamException>(() => VehicleWire.ReadHeader(r));
+            ms.Position = 0;
+            Assert.IsNull(VehicleWire.ReadS2C(VehicleWire.OpDeployableState, r));
+            ms.Position = 0;
+            Assert.IsNull(VehicleWire.ReadC2S(VehicleWire.OpCargo, r));
+        }
+
+        [TestMethod]
+        public void T2_8_WIRE_03_CorruptedTagRejected()
+        {
+            byte[] badTag = new byte[] { 0x41, 0x42, 0x43, 0x44, 0x04, 0x00, 0x00, 0x00 };
+            using var ms = new MemoryStream(badTag);
+            using var r = new BinaryReader(ms);
+            ushort version = VehicleWire.ReadHeader(r);
+            Assert.AreEqual(0, version);
+            ms.Position = 0;
+            Assert.IsNull(VehicleWire.ReadS2C(VehicleWire.OpDeployableState, r));
+            ms.Position = 0;
+            Assert.IsNull(VehicleWire.ReadC2S(VehicleWire.OpCargo, r));
+        }
+
+        [TestMethod]
+        public void T2_8_WIRE_04_ValidHeaderAccepted()
+        {
+            // HBV1 Tag (0x31564248) + Version 4 (0x0004) + Reserved (0x0000)
+            byte[] validHeader = new byte[] { 0x48, 0x42, 0x56, 0x31, 0x04, 0x00, 0x00, 0x00 };
+            using var ms = new MemoryStream(validHeader);
+            using var r = new BinaryReader(ms);
+            ushort version = VehicleWire.ReadHeader(r);
+            Assert.AreEqual(VehicleWire.V4, version, "Header must validate as HBV1 Version 4");
+        }
+
+        [TestMethod]
+        public void T2_8_WIRE_05_FutureVersionTrailingBytesSkipped()
+        {
+            // Future payload with 16 extra bytes
+            byte[] buf = new byte[24];
+            using var ms = new MemoryStream(buf);
+            using var w = new BinaryWriter(ms);
+            w.Write(VehicleWire.Tag);
+            w.Write((ushort)5); // Version 5
+            w.Write((ushort)0);
+            w.Write(0x12345678); // 16 trailing bytes
+            w.Write(0x12345678);
+            w.Write(0x12345678);
+            w.Write(0x12345678);
+
+            ms.Position = 0;
+            using var r = new BinaryReader(ms);
+            ushort v = VehicleWire.ReadHeader(r);
+            Assert.AreEqual(5, v);
+            Assert.AreEqual(16, ms.Length - ms.Position);
+        }
