+                        Deployables.DeployableManager.SpawnDeployable(4000013, buPos, player); // Battery
+                        Deployables.DeployableManager.SpawnDeployable(4000015, grPos, player); // Ground Radar
+                        Deployables.DeployableManager.SpawnDeployable(4000014, mtPos, player); // Missile Turret
+                        Deployables.DeployableManager.SpawnDeployable(4000016, moPos, player); // Mortar Turret
+                        Deployables.DeployableManager.SpawnDeployable(4000017, ltPos, player); // Laser Turret
+
+                        CommandHandlerHelper.WriteOutputInfo(session, "deployed Forward Operating Base (8 modular units + 10 scarabs fuel) within wireless microgrid volume.");
+                        return;
+                    }
+                    CommandHandlerHelper.WriteOutputInfo(session, "usage: @deployable preset base");
+                    return;
+                }
+                case "fuel":
+                {
+                    if (parameters.Length < 3)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @deployable fuel <guid> <amount>");
+                        return;
+                    }
+
+                    uint dGuid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out dGuid);
+                    else
+                        uint.TryParse(parameters[1], out dGuid);
+
+                    if (!int.TryParse(parameters[2], out var amount))
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "invalid amount");
+                        return;
+                    }
+
+                    var d = Deployables.DeployableManager.GetDeployable(dGuid);
+                    if (d is Deployables.PowerGeneratorDeployable gen)
+                    {
+                        gen.AddFuel(amount);
+                        CommandHandlerHelper.WriteOutputInfo(session, $"refueled generator 0x{dGuid:X8} with {amount} scarab(s) ({gen.FuelRemaining:0.0}s fuel remaining, {gen.PowerWatts / 1000f:0} kW output)");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"deployable 0x{dGuid:X8} not found or is not a Power Generator");
+                    }
+                    return;
+                }
+                case "monsters":
+                {
+                    if (parameters.Length < 3)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @deployable monsters <radarGuid> <on|off>");
+                        return;
+                    }
+
+                    uint rGuid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out rGuid);
+                    else
+                        uint.TryParse(parameters[1], out rGuid);
+
+                    var on = parameters[2].ToLowerInvariant() is "on" or "1" or "true" or "yes";
+                    var d = Deployables.DeployableManager.GetDeployable(rGuid);
+                    if (d is Deployables.GroundRadarDeployable radar)
+                    {
+                        radar.TargetMonsters = on;
+                        CommandHandlerHelper.WriteOutputInfo(session, $"ground radar 0x{rGuid:X8} monster targeting set to {(on ? "ON" : "OFF")}");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"deployable 0x{rGuid:X8} not found or is not a Ground Radar");
+                    }
+                    return;
+                }
+                case "list":
+                {
+                    var all = Deployables.DeployableManager.GetAll().ToList();
+                    var grids = Deployables.DeployableManager.GetAllGrids();
+                    var sb = new System.Text.StringBuilder();
+                    sb.AppendLine($"Deployables: {all.Count} active, MicroGrids: {grids.Count}");
+                    foreach (var d in all)
+                    {
+                        sb.AppendLine($"  0x{d.Guid.Full:X8} | {d.Kind} (WCID {d.Wcid}) | Pallet: {d.Pallet} | Power: {d.PowerWatts:0}W | Stored: {d.EnergyStoredJoules:0}J | Fuel: {d.FuelRemaining:0}s | Ammo: {d.AmmoRemaining} | Grid: {(d.Grid != null ? "connected" : "none")}");
+                    }
+                    CommandHandlerHelper.WriteOutputInfo(session, sb.ToString().TrimEnd());
+                    return;
+                }
+                case "despawn":
+                {
+                    if (parameters.Length > 1 && parameters[1].Equals("all", StringComparison.OrdinalIgnoreCase))
+                    {
+                        var all = Deployables.DeployableManager.GetAll().ToList();
+                        foreach (var d in all)
+                            d.Destroy();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"despawned {all.Count} deployable(s)");
+                        return;
+                    }
+
+                    if (parameters.Length < 2)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @deployable despawn <guid|all>");
+                        return;
+                    }
+
+                    uint dGuid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out dGuid);
+                    else
+                        uint.TryParse(parameters[1], out dGuid);
+
+                    var target = Deployables.DeployableManager.GetDeployable(dGuid);
+                    if (target != null)
+                    {
+                        target.Destroy();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"despawned deployable 0x{dGuid:X8}");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"deployable 0x{dGuid:X8} not found");
+                    }
+                    return;
+                }
+                default:
+                    CommandHandlerHelper.WriteOutputInfo(session, "usage: @deployable spawn <wcid> [x y z] | load <vGuid> <slot> <wcid> | preset base | fuel <guid> <amount> | monsters <guid> <on|off> | list | despawn <guid|all>");
+                    return;
+            }
+        }
     }
 }
