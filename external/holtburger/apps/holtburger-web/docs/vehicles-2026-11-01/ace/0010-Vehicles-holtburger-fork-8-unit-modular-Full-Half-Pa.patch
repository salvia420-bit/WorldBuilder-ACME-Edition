+        public class JeepCargoBedModel
+        {
+            public byte CargoMask { get; private set; } = 0; // bit 0: slot 0, bit 1: slot 1, bit 2: full
+            public PalletSize Slot0Size { get; private set; } = PalletSize.None;
+            public PalletSize Slot1Size { get; private set; } = PalletSize.None;
+            public uint Slot0Wcid { get; private set; } = 0;
+            public uint Slot1Wcid { get; private set; } = 0;
+
+            public bool CargoLoaded => CargoMask != 0 || Slot0Wcid != 0;
+
+            public static readonly Vector3 FullPalletOffset = new Vector3(0.00f, -1.15f, 0.72f);
+            public static readonly Vector3 Slot0HalfOffset = new Vector3(-0.60f, -1.15f, 0.72f);
+            public static readonly Vector3 Slot1HalfOffset = new Vector3(+0.60f, -1.15f, 0.72f);
+
+            public bool LoadFullPallet(uint wcid)
+            {
+                if (CargoMask != 0) return false; // Must be empty
+                CargoMask = 0x07; // occupies both slots + full flag
+                Slot0Size = PalletSize.Full;
+                Slot1Size = PalletSize.Full;
+                Slot0Wcid = wcid;
+                Slot1Wcid = wcid;
+                return true;
+            }
+
+            public bool LoadHalfPallet(int slot, uint wcid)
+            {
+                if (slot == 0)
+                {
+                    if ((CargoMask & 0x01) != 0 || (CargoMask & 0x04) != 0) return false;
+                    CargoMask |= 0x01;
+                    Slot0Size = PalletSize.Half;
+                    Slot0Wcid = wcid;
+                    return true;
+                }
+                else if (slot == 1)
+                {
+                    if ((CargoMask & 0x02) != 0 || (CargoMask & 0x04) != 0) return false;
+                    CargoMask |= 0x02;
+                    Slot1Size = PalletSize.Half;
+                    Slot1Wcid = wcid;
+                    return true;
+                }
+                return false;
+            }
+
+            public bool UnloadSlot(int slot, out uint wcid)
+            {
+                wcid = 0;
+                if ((CargoMask & 0x04) != 0) // Full pallet
+                {
+                    wcid = Slot0Wcid;
+                    CargoMask = 0;
+                    Slot0Size = PalletSize.None;
+                    Slot1Size = PalletSize.None;
+                    Slot0Wcid = 0;
+                    Slot1Wcid = 0;
+                    return true;
+                }
+
+                if (slot == 0 && (CargoMask & 0x01) != 0)
+                {
+                    wcid = Slot0Wcid;
+                    CargoMask &= 0xFE;
+                    Slot0Size = PalletSize.None;
+                    Slot0Wcid = 0;
+                    return true;
+                }
+                if (slot == 1 && (CargoMask & 0x02) != 0)
+                {
+                    wcid = Slot1Wcid;
+                    CargoMask &= 0xFD;
+                    Slot1Size = PalletSize.None;
+                    Slot1Wcid = 0;
+                    return true;
+                }
+                return false;
+            }
+        }
