+                    wcid = CargoSlot0Wcid;
+                    CargoMask = 0;
+                    PalletSize0 = PalletSize.None;
+                    PalletSize1 = PalletSize.None;
+                    CargoSlot0Wcid = 0;
+                    CargoSlot1Wcid = 0;
+                    _legacyCargoLoaded = false;
+                    return true;
+                }
+                if (slot == 0 && (CargoMask & 0x01) != 0)
+                {
+                    wcid = CargoSlot0Wcid;
+                    CargoMask &= 0xFE;
