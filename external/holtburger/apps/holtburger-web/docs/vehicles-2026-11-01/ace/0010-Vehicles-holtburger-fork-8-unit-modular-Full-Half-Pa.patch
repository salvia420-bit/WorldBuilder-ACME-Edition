+using System;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Models;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles.Deployables
+{
+    /// <summary>
+    /// Arcane Turbine Power Generator (WCID 4000012, Full Pallet).
+    /// Burns Platinum Scarabs (WCID 8897) at a rate of 1 scarab per 120 seconds to generate steady 45 kW.
+    /// Loaded on foot via Use or Use-With-Target.
+    /// </summary>
+    public class PowerGeneratorDeployable : DeployableBase
+    {
+        public const uint PowerGeneratorWeenieClassId = 4_000_012;
+        public const uint ScarabWcid = 8897; // Platinum Scarab
+        public const float BurnRateSecondsPerScarab = 120.0f;
+        public const float OutputPowerWatts = 45000.0f; // 45 kW steady output
+
+        public double FuelSecondsRemaining { get; set; }
+        public override float FuelRemaining => (float)FuelSecondsRemaining;
+        public override float PowerWatts => (FuelSecondsRemaining > 0.0 && !IsPacked && IsActive) ? OutputPowerWatts : 0.0f;
+
+        public PowerGeneratorDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Kind = DeployableKind.PowerGenerator;
+            Pallet = PalletSize.Full;
+        }
+
+        public static Weenie BuildWeenie(Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return BuildDeployableWeenie(
+                PowerGeneratorWeenieClassId,
+                "hbdeployable_powergenerator",
+                "Arcane Turbine Power Generator",
+                "Burns Platinum Scarabs (WCID 8897) to generate 45 kW steady wireless microgrid power."
+            );
+        }
+
+        public void AddFuel(int scarabs)
+        {
+            if (scarabs > 0)
+                FuelSecondsRemaining += scarabs * (double)BurnRateSecondsPerScarab;
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+            if (FuelSecondsRemaining > 0.0 && !IsPacked && IsActive)
+            {
+                FuelSecondsRemaining = Math.Max(0.0, FuelSecondsRemaining - elapsedSeconds);
+            }
+        }
+
+        public override void ActOnUse(WorldObject activator)
+        {
+            if (activator is Player player)
+            {
+                // Attempt to consume 1 Platinum Scarab from inventory
+                if (player.TryConsumeFromInventoryWithNetworking(ScarabWcid, 1))
+                {
+                    AddFuel(1);
+                    player.SendMessage($"Loaded 1 Platinum Scarab into Arcane Turbine. Fuel remaining: {FuelSecondsRemaining:0}s ({PowerWatts / 1000f:0} kW output).", ChatMessageType.Broadcast);
+                    BroadcastState();
+                }
+                else
+                {
+                    player.SendMessage("You need Platinum Scarabs (WCID 8897) in your inventory to refuel this Arcane Turbine.", ChatMessageType.Broadcast);
+                }
+            }
+        }
+
+        public override void HandleActionUseOnTarget(Player player, WorldObject target)
+        {
+            if (player == null || target == null) return;
+
+            if (target.WeenieClassId == ScarabWcid)
+            {
+                int count = target.StackSize ?? 1;
+                if (player.TryConsumeFromInventoryWithNetworking(target, count))
+                {
+                    AddFuel(count);
+                    player.SendMessage($"Loaded {count} Platinum Scarab(s) into Arcane Turbine. Fuel remaining: {FuelSecondsRemaining:0}s.", ChatMessageType.Broadcast);
+                    BroadcastState();
+                }
+            }
+        }
+    }
+}
