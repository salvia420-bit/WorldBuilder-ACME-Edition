+        [TestMethod]
+        public void Hbv1TruncatedV5TailAndHostileV5CountsRejected()
+        {
+            foreach (var (name, op) in new[] {
+                ("vehicle_container_action", VehicleWire.OpContainerAction),
+                ("vehicle_container_state", VehicleWire.OpContainerState) })
+            {
+                var bytes = Hex(Fixture(name).GetProperty("hex").GetString());
+                foreach (var cut in new[] { bytes.Length - 1, bytes.Length - 4, 12, 8, 4 })
+                {
+                    var dir = name == "vehicle_container_action" ? "C2S" : "S2C";
+                    Assert.IsNull(Read(dir, op, bytes.Take(cut).ToArray()), $"{name} cut {cut}");
+                }
+            }
+
+            var fx = Fixture("vehicle_container_state");
+            var csBytes = Hex(fx.GetProperty("hex").GetString());
+            var slotCountAt = 8 + 4 + 4 + 1 + 1 + 1 + 1 + 4 + 4 + 12 + 4 + 4 + 4;
+            var evil = (byte[])csBytes.Clone();
+            BitConverter.GetBytes(uint.MaxValue).CopyTo(evil, slotCountAt);
+            Assert.IsNull(Read("S2C", VehicleWire.OpContainerState, evil), "hostile container slot count");
+        }
