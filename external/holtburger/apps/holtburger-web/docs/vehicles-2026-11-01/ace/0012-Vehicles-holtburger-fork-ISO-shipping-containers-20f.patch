+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("\t\n\r"));
+
+            // Too short lengths (< 10)
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("A"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("ABC"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("ABCD"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQ123"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU12345"));
+
+            // Too long lengths (> 11)
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU12345678"));
