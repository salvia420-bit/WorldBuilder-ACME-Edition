+                return;
+
+            if (double.IsNaN(elapsedSeconds) || elapsedSeconds <= 0.0)
+                return;
+
+            float delta = (float)(elapsedSeconds / (double)IsoContainerSpecifications.DoorAnimationDurationSec);
+
+            if (DoorState == ContainerDoorState.Opening)
+            {
+                DoorProgress = Math.Clamp(DoorProgress + delta, 0.0f, 1.0f);
+                if (DoorProgress >= 0.9999f)
+                {
+                    DoorProgress = 1.0f;
+                    DoorState = ContainerDoorState.Open;
+                }
+            }
+            else if (DoorState == ContainerDoorState.Closing)
+            {
+                DoorProgress = Math.Clamp(DoorProgress - delta, 0.0f, 1.0f);
+                if (DoorProgress <= 0.0001f)
+                {
+                    DoorProgress = 0.0f;
+                    DoorState = ContainerDoorState.Closed;
+                }
+            }
+        }
+
+        public bool TryLoadWcid(int slotIndex, uint wcid, PalletSize palletSize, byte subSlot = 0, bool ignoreDoorState = false)
+        {
+            // Doors must be sufficiently open to load
+            if (!ignoreDoorState && DoorProgress < 0.8f)
+                return false;
+
+            if (slotIndex < 0 || slotIndex >= Slots.Count)
+                return false;
+
+            var slot = Slots[slotIndex];
+
+            if (palletSize == PalletSize.Full)
+            {
+                // Full pallet requires entire slot free
+                if (slot.Occupied || slot.OccupiedSubSlots != 0)
+                    return false;
+
+                slot.Occupied = true;
+                slot.OccupiedWcids[0] = wcid;
+                slot.OccupiedWcids[1] = 0;
+                slot.OccupiedPalletSize = PalletSize.Full;
+                slot.OccupiedSubSlots = 0x03; // both subslots
+                return true;
+            }
+            else if (palletSize == PalletSize.Half)
+            {
+                // Half pallet occupies subslot 0 or 1
+                int sub = subSlot & 1;
+                byte mask = (byte)(1 << sub);
+                if ((slot.OccupiedSubSlots & mask) != 0 || (slot.OccupiedPalletSize == PalletSize.Full))
+                    return false;
+
+                slot.OccupiedSubSlots |= mask;
+                slot.OccupiedWcids[sub] = wcid;
+                slot.OccupiedPalletSize = PalletSize.Half;
+                if (slot.OccupiedSubSlots == 0x03)
+                    slot.Occupied = true;
+                return true;
+            }
+
+            return false;
+        }
+
+        public bool TryUnpackSlot(int slotIndex, out uint wcid, sbyte subSlot = -1)
+        {
+            wcid = 0;
+            if (DoorProgress < 0.8f)
+                return false;
+
+            if (slotIndex < 0 || slotIndex >= Slots.Count)
+                return false;
+
+            var slot = Slots[slotIndex];
+            if (!slot.Occupied && slot.OccupiedSubSlots == 0)
+                return false;
+
+            if (slot.OccupiedPalletSize == PalletSize.Full)
+            {
+                wcid = slot.OccupiedWcids[0];
+                slot.Occupied = false;
+                slot.OccupiedWcids[0] = 0;
+                slot.OccupiedWcids[1] = 0;
+                slot.OccupiedPalletSize = PalletSize.None;
+                slot.OccupiedSubSlots = 0;
+                return true;
+            }
+            else if (slot.OccupiedPalletSize == PalletSize.Half)
+            {
+                int targetSub;
+                if (subSlot == 0 || subSlot == 1)
+                {
+                    targetSub = subSlot;
+                    if ((slot.OccupiedSubSlots & (1 << targetSub)) == 0)
+                        return false;
+                }
+                else
+                {
+                    targetSub = (slot.OccupiedSubSlots & 0x01) != 0 ? 0 : 1;
+                    if ((slot.OccupiedSubSlots & (1 << targetSub)) == 0)
+                        return false;
+                }
+
+                wcid = slot.OccupiedWcids[targetSub];
+                slot.OccupiedWcids[targetSub] = 0;
+                slot.OccupiedSubSlots &= (byte)~(1 << targetSub);
+                slot.Occupied = false;
+                if (slot.OccupiedSubSlots == 0)
+                {
+                    slot.OccupiedPalletSize = PalletSize.None;
+                }
+                return true;
+            }
+
+            return false;
+        }
+
+        public int UnpackAll(out List<uint> unpackedWcids)
+        {
+            unpackedWcids = new List<uint>();
+            if (DoorProgress < 0.8f)
+                return 0;
+
+            foreach (var slot in Slots)
+            {
+                if (slot.Occupied || slot.OccupiedSubSlots != 0)
+                {
+                    if (slot.OccupiedPalletSize == PalletSize.Full)
+                    {
+                        if (slot.OccupiedWcids[0] != 0)
+                            unpackedWcids.Add(slot.OccupiedWcids[0]);
+
+                        slot.Occupied = false;
+                        slot.OccupiedWcids[0] = 0;
+                        slot.OccupiedWcids[1] = 0;
+                        slot.OccupiedPalletSize = PalletSize.None;
+                        slot.OccupiedSubSlots = 0;
+                    }
+                    else if (slot.OccupiedPalletSize == PalletSize.Half)
+                    {
+                        for (int i = 0; i < 2; i++)
+                        {
+                            if ((slot.OccupiedSubSlots & (1 << i)) != 0 && slot.OccupiedWcids[i] != 0)
+                            {
+                                unpackedWcids.Add(slot.OccupiedWcids[i]);
+                                slot.OccupiedWcids[i] = 0;
+                            }
+                        }
+
+                        slot.Occupied = false;
+                        slot.OccupiedPalletSize = PalletSize.None;
+                        slot.OccupiedSubSlots = 0;
+                    }
+                }
+            }
+
+            return unpackedWcids.Count;
+        }
+
+        public BridgeSupport ProbeWalkableSupport(float worldX, float worldY, float worldZ)
+        {
+            // Transform world coordinate into container local frame
+            float dx = worldX - Position.X;
+            float dy = worldY - Position.Y;
+            float cosH = (float)Math.Cos(-HeadingRad);
+            float sinH = (float)Math.Sin(-HeadingRad);
+
+            float localX = dx * cosH - dy * sinH;
+            float localY = dx * sinH + dy * cosH;
+
+            float halfExtW = ExternalDimensions.X / 2f;
+            float halfExtL = ExternalDimensions.Y / 2f;
+            float halfIntW = InternalDimensions.X / 2f;
+            float halfIntL = InternalDimensions.Y / 2f;
+
+            // 1. Roof Support
+            if (Math.Abs(localX) <= halfExtW && Math.Abs(localY) <= halfExtL)
+            {
+                float deckZ = Position.Z + RoofZ;
+                if (Math.Abs(worldZ - deckZ) <= 0.5f)
+                {
+                    return new BridgeSupport
+                    {
+                        Found = true,
+                        DeckZ = deckZ,
+                        Nx = 0,
+                        Ny = 0,
+                        Nz = 1.0,
+                    };
+                }
+            }
+
+            // 2. Interior Floor Support
+            if (DoorProgress > 0.05f) // Doors open
+            {
+                if (Math.Abs(localX) <= halfIntW && Math.Abs(localY) <= halfIntL)
+                {
+                    float deckZ = Position.Z + FloorZ;
+                    if (Math.Abs(worldZ - deckZ) <= 0.5f)
+                    {
+                        return new BridgeSupport
+                        {
+                            Found = true,
+                            DeckZ = deckZ,
+                            Nx = 0,
+                            Ny = 0,
+                            Nz = 1.0,
+                        };
+                    }
+                }
+            }
+
+            // 3. Fold-Down Ramp Support
+            if (DoorProgress > 0.05f)
+            {
+                float rampStartY = -halfExtL;
+                float rampEndY = rampStartY - IsoContainerSpecifications.RampLength;
+                float halfDoorW = DoorOpeningDimensions.X / 2f;
+
+                if (Math.Abs(localX) <= halfDoorW && localY <= rampStartY && localY >= rampEndY)
+                {
+                    float t = (rampStartY - localY) / IsoContainerSpecifications.RampLength; // 0.0 at container threshold, 1.0 at ground tip
+                    float localDeckZ = FloorZ * (1.0f - t);
+                    float deckZ = Position.Z + localDeckZ;
+
+                    if (Math.Abs(worldZ - deckZ) <= 0.5f)
+                    {
+                        // Ramp slopes down along local -Y: local normal = (0, -sin(theta), cos(theta))
+                        float sinTheta = FloorZ / IsoContainerSpecifications.RampLength;
+                        float theta = (float)Math.Asin(sinTheta);
+                        float cosTheta = (float)Math.Cos(theta);
+
+                        // Rotate local normal by container HeadingRad
+                        float nx = sinTheta * (float)Math.Sin(HeadingRad);
+                        float ny = -sinTheta * (float)Math.Cos(HeadingRad);
+                        float nz = cosTheta;
+
+                        return new BridgeSupport
+                        {
+                            Found = true,
+                            DeckZ = deckZ,
+                            Nx = nx,
+                            Ny = ny,
+                            Nz = nz,
+                        };
+                    }
+                }
+            }
+
+            return default;
+        }
+    }
