+
+        public static Weenie BuildWeenie(uint wcid, Vehicle parentVehicle = null, Player deployer = null)
+        {
+            return wcid switch
+            {
+                Wcid20ft => BuildDeployableWeenie(Wcid20ft, "hbcontainer_20ft", "20-ft Standard ISO Container (1CC / 22G1)", "20-ft standard shipping container with rear cargo doors and fold-down ramp."),
+                Wcid40ft => BuildDeployableWeenie(Wcid40ft, "hbcontainer_40ft", "40-ft Standard ISO Container (1AA / 42G1)", "40-ft standard shipping container with rear cargo doors and fold-down ramp."),
+                Wcid40ftHC => BuildDeployableWeenie(Wcid40ftHC, "hbcontainer_40fthc", "40-ft High-Cube ISO Container (1AAA / 45G1)", "40-ft high-cube shipping container with rear cargo doors and fold-down ramp."),
+                _ => BuildDeployableWeenie(wcid, "hbcontainer", "ISO Container", "Shipping container.")
