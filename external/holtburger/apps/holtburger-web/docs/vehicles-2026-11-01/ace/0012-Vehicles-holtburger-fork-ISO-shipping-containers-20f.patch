+
+            // Numeric or non-letter characters in owner prefix
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("1234123456"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("C2QU123456"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CS3U123456"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQ4123456"));
+
+            // Non-digits in serial number
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU12345A"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQUABCDEF"));
+
+            // Non-digit in 11th character check digit position
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU123456A"));
+
+            // Hostile characters, embedded null bytes, and symbols
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU123456\0"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU12345@6"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQ@123456"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU12345$"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU-123456!"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("CSQU#123456"));
+
+            // Non-ASCII Unicode characters
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("ÉLTU100002"));
+            Assert.ThrowsExactly<ArgumentException>(() => IsoContainerSpecifications.ComputeIso6346CheckDigit("🚢LTU100002"));
+        }
