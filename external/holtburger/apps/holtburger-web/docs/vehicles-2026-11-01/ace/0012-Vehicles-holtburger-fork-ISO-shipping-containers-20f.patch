@@ -1241,6 +1241,52 @@ public static void HandleCargo(Session session, VehicleCargo msg)
             HandleCargo(player, msg);
         }
 
+        public static void HandleContainerAction(Session session, VehicleContainerAction msg)
+        {
+            var player = session?.Player;
+            if (player == null) return;
+            HandleContainerAction(player, msg);
+        }
+
+        public static bool HandleContainerAction(Player player, VehicleContainerAction msg)
+        {
+            if (!Enabled || player == null || msg == null) return false;
+            var container = Deployables.DeployableManager.GetDeployable(msg.Container) as Deployables.IsoContainerDeployable;
+            if (container == null || !container.IsActive || container.IsPacked) return false;
+
+            // Player proximity check (<= 15.0m to container threshold/origin)
+            var pPos = player.Location != null ? new Vector3((float)player.Location.Pos.X, (float)player.Location.Pos.Y, (float)player.Location.Pos.Z) : Vector3.Zero;
+            if (Vector3.Distance(pPos, container.Position) > 15.0f)
+                return false;
+
+            switch (msg.Action)
+            {
+                case 1: // OpenDoors
+                    container.OpenDoors();
+                    break;
+                case 2: // CloseDoors
+                    container.CloseDoors();
+                    break;
+                case 3: // Load
+                    container.TryLoadWcid((int)msg.SlotIndex, msg.CargoWcid, msg.SubSlot);
+                    break;
+                case 4: // Pack
+                    container.TryPackDeployable(msg.CargoWcid);
+                    break;
+                case 5: // Unpack
+                    container.TryUnpackSlot((int)msg.SlotIndex, out WorldObject _);
+                    break;
+                case 6: // UnpackAll
+                    container.UnpackAll(out List<WorldObject> _);
+                    break;
+                default:
+                    return false;
+            }
+
+            container.BroadcastState();
+            return true;
+        }
+
