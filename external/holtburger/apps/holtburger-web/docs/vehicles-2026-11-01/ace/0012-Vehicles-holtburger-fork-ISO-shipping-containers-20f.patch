+
+        [CommandHandler("container", AccessLevel.Developer, CommandHandlerFlag.RequiresWorld, 1,
+            "ISO Shipping Container ecosystem administration.",
+            "spawn <20|40|40hc|wcid> [x y z]   - spawn container (default 6m in front)\n" +
+            "preset fob20                      - 20ft container with FOB-in-a-Box loadout (9 units)\n" +
+            "preset fob40                      - 40ft container with FOB loadout\n" +
+            "doors <guid> [open|close|toggle]  - control cargo doors and ramp\n" +
+            "load <guid> <slot> <wcid> [sub]   - load unit into bay slot\n" +
+            "pack <guid> <deployableGuid>      - stow nearby deployable into container\n" +
+            "unpack <guid> [slot|all]          - deploy stowed unit(s) onto terrain\n" +
+            "stack <lowerGuid> <upperGuid>     - double-stack container atop lower container\n" +
+            "list                              - list active ISO containers\n" +
+            "despawn <guid|all>                - despawn container(s)")]
+        public static void HandleContainer(Session session, params string[] parameters)
+        {
+            var player = session.Player;
+            if (parameters.Length == 0)
+            {
+                CommandHandlerHelper.WriteOutputInfo(session, "usage: @container spawn | preset | doors | load | pack | unpack | stack | list | despawn");
+                return;
+            }
+
+            switch (parameters[0].ToLowerInvariant())
+            {
+                case "spawn":
+                {
+                    if (parameters.Length < 2)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @container spawn <20|40|40hc|wcid> [x y z]");
+                        return;
+                    }
+
+                    uint wcid = 0;
+                    var typeArg = parameters[1].ToLowerInvariant();
+                    if (typeArg is "20" or "4000020") wcid = 4000020;
+                    else if (typeArg is "40" or "4000021") wcid = 4000021;
+                    else if (typeArg is "40hc" or "hc" or "4000022") wcid = 4000022;
+                    else uint.TryParse(parameters[1], out wcid);
+
+                    if (wcid == 0)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "invalid container type (must be 20, 40, 40hc, or valid WCID)");
+                        return;
+                    }
+
+                    Position spawnPos;
+                    if (parameters.Length >= 5 &&
+                        float.TryParse(parameters[2], out var sx) &&
+                        float.TryParse(parameters[3], out var sy) &&
+                        float.TryParse(parameters[4], out var sz))
+                    {
+                        spawnPos = Vehicle.ToPosition(sx, sy, sz, player.Location?.Rotation ?? Quaternion.Identity);
+                    }
+                    else
+                    {
+                        var heading = player.Location != null ? (float)VehicleManager.HeadingOf(player.Location.Rotation) : 0f;
+                        var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                        float fx = (float)px + (float)Math.Sin(heading) * 6.0f;
+                        float fy = (float)py + (float)Math.Cos(heading) * 6.0f;
+                        var groundZ = VehicleTerrain.Ground(fx, fy);
+                        float fz = !double.IsNaN(groundZ) ? (float)groundZ : (float)pz;
+                        spawnPos = Vehicle.ToPosition(fx, fy, fz, player.Location?.Rotation ?? Quaternion.Identity);
+                    }
+
+                    var c = Deployables.DeployableManager.SpawnDeployable(wcid, spawnPos, player) as Deployables.IsoContainerDeployable;
+                    if (c != null)
+                        CommandHandlerHelper.WriteOutputInfo(session, $"spawned ISO container {c.Name} (0x{c.Guid.Full:X8}) at {spawnPos.ToLOCString()}");
+                    else
+                        CommandHandlerHelper.WriteOutputInfo(session, $"failed to spawn container wcid {wcid}");
+                    return;
+                }
+
+                case "preset":
+                {
+                    if (parameters.Length > 1 && parameters[1].Equals("fob20", StringComparison.OrdinalIgnoreCase))
+                    {
+                        var heading = player.Location != null ? (float)VehicleManager.HeadingOf(player.Location.Rotation) : 0f;
+                        var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                        float fx = (float)px + (float)Math.Sin(heading) * 6.0f;
+                        float fy = (float)py + (float)Math.Cos(heading) * 6.0f;
+                        var groundZ = VehicleTerrain.Ground(fx, fy);
+                        float fz = !double.IsNaN(groundZ) ? (float)groundZ : (float)pz;
+                        var spawnPos = Vehicle.ToPosition(fx, fy, fz, player.Location?.Rotation ?? Quaternion.Identity);
+
+                        var c = Deployables.DeployableManager.SpawnDeployable(4000020, spawnPos, player) as Deployables.IsoContainerDeployable;
+                        if (c == null)
+                        {
+                            CommandHandlerHelper.WriteOutputInfo(session, "failed to spawn 20ft container for fob20 preset");
+                            return;
+                        }
+
+                        c.TryLoadWcid(0, 4000010, subSlot: 0, ignoreDoorState: true); // Flux Pod
+                        c.TryLoadWcid(1, 4000011, subSlot: 0, ignoreDoorState: true); // Solar Panels
+                        c.TryLoadWcid(2, 4000012, subSlot: 0, ignoreDoorState: true); // Power Generator
+                        c.TryLoadWcid(3, 4000013, subSlot: 0, ignoreDoorState: true); // Battery Unit (subslot 0)
+                        c.TryLoadWcid(3, 4000015, subSlot: 1, ignoreDoorState: true); // Ground Radar (subslot 1)
+                        c.TryLoadWcid(4, 4000014, subSlot: 0, ignoreDoorState: true); // Missile Turret
+                        c.TryLoadWcid(5, 4000016, subSlot: 0, ignoreDoorState: true); // Mortar Turret (subslot 0)
+                        c.TryLoadWcid(5, 4000017, subSlot: 1, ignoreDoorState: true); // Laser Turret (subslot 1)
+                        c.TryLoadWcid(6, 4000002, subSlot: 0, ignoreDoorState: true); // AN/TPS-1 Radar Station
+                        c.BroadcastState();
+
+                        CommandHandlerHelper.WriteOutputInfo(session, $"spawned 20ft ISO container 0x{c.Guid.Full:X8} with FOB-in-a-Box preset (9 units stowed across 7/10 bays).");
+                        return;
+                    }
+                    if (parameters.Length > 1 && parameters[1].Equals("fob40", StringComparison.OrdinalIgnoreCase))
+                    {
+                        var heading = player.Location != null ? (float)VehicleManager.HeadingOf(player.Location.Rotation) : 0f;
+                        var (px, py, pz) = Vehicle.ToGlobal(player.Location);
+                        float fx = (float)px + (float)Math.Sin(heading) * 9.0f;
+                        float fy = (float)py + (float)Math.Cos(heading) * 9.0f;
+                        var groundZ = VehicleTerrain.Ground(fx, fy);
+                        float fz = !double.IsNaN(groundZ) ? (float)groundZ : (float)pz;
+                        var spawnPos = Vehicle.ToPosition(fx, fy, fz, player.Location?.Rotation ?? Quaternion.Identity);
+
+                        var c = Deployables.DeployableManager.SpawnDeployable(4000021, spawnPos, player) as Deployables.IsoContainerDeployable;
+                        if (c == null)
+                        {
+                            CommandHandlerHelper.WriteOutputInfo(session, "failed to spawn 40ft container for fob40 preset");
+                            return;
+                        }
+
+                        c.TryLoadWcid(0, 4000010, subSlot: 0, ignoreDoorState: true);
+                        c.TryLoadWcid(1, 4000011, subSlot: 0, ignoreDoorState: true);
+                        c.TryLoadWcid(2, 4000012, subSlot: 0, ignoreDoorState: true);
+                        c.TryLoadWcid(3, 4000013, subSlot: 0, ignoreDoorState: true);
+                        c.TryLoadWcid(3, 4000015, subSlot: 1, ignoreDoorState: true);
+                        c.TryLoadWcid(4, 4000014, subSlot: 0, ignoreDoorState: true);
+                        c.TryLoadWcid(5, 4000016, subSlot: 0, ignoreDoorState: true);
+                        c.TryLoadWcid(5, 4000017, subSlot: 1, ignoreDoorState: true);
+                        c.TryLoadWcid(6, 4000002, subSlot: 0, ignoreDoorState: true);
+                        c.BroadcastState();
+
+                        CommandHandlerHelper.WriteOutputInfo(session, $"spawned 40ft ISO container 0x{c.Guid.Full:X8} with FOB loadout (9 units stowed across 7/21 bays).");
+                        return;
+                    }
+
+                    CommandHandlerHelper.WriteOutputInfo(session, "usage: @container preset <fob20|fob40>");
+                    return;
+                }
+
+                case "doors":
+                {
+                    if (parameters.Length < 2)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @container doors <guid> [open|close|toggle]");
+                        return;
+                    }
+
+                    uint guid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out guid);
+                    else
+                        uint.TryParse(parameters[1], out guid);
+
+                    var c = Deployables.DeployableManager.GetDeployable(guid) as Deployables.IsoContainerDeployable;
+                    if (c == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"container 0x{guid:X8} not found");
+                        return;
+                    }
+
+                    var sub = parameters.Length > 2 ? parameters[2].ToLowerInvariant() : "toggle";
+                    if (sub == "open") c.OpenDoors();
+                    else if (sub == "close") c.CloseDoors();
+                    else c.ToggleDoors();
+
+                    c.BroadcastState();
+                    CommandHandlerHelper.WriteOutputInfo(session, $"container 0x{guid:X8} doors transition -> {c.DoorState}");
+                    return;
+                }
+
+                case "load":
+                {
+                    if (parameters.Length < 4)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @container load <guid> <slot> <wcid> [subslot]");
+                        return;
+                    }
+
+                    uint guid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out guid);
+                    else
+                        uint.TryParse(parameters[1], out guid);
+
+                    if (!int.TryParse(parameters[2], out var slot) || !uint.TryParse(parameters[3], out var wcid))
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "invalid slot or wcid");
+                        return;
+                    }
+
+                    byte subSlot = 0;
+                    if (parameters.Length > 4) byte.TryParse(parameters[4], out subSlot);
+
+                    var c = Deployables.DeployableManager.GetDeployable(guid) as Deployables.IsoContainerDeployable;
+                    if (c == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"container 0x{guid:X8} not found");
+                        return;
+                    }
+
+                    if (c.TryLoadWcid(slot, wcid, subSlot))
+                    {
+                        c.BroadcastState();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"loaded WCID {wcid} into container 0x{guid:X8} bay {slot} (subslot {subSlot})");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"failed to load WCID {wcid} into container 0x{guid:X8} bay {slot}");
+                    }
+                    return;
+                }
+
+                case "pack":
+                {
+                    if (parameters.Length < 3)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @container pack <containerGuid> <deployableGuid>");
+                        return;
+                    }
+
+                    uint cGuid, dGuid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out cGuid);
+                    else
+                        uint.TryParse(parameters[1], out cGuid);
+
+                    if (parameters[2].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[2].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out dGuid);
+                    else
+                        uint.TryParse(parameters[2], out dGuid);
+
+                    var c = Deployables.DeployableManager.GetDeployable(cGuid) as Deployables.IsoContainerDeployable;
+                    if (c == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"container 0x{cGuid:X8} not found");
+                        return;
+                    }
+
+                    if (c.TryPackDeployable(dGuid))
+                    {
+                        c.BroadcastState();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"packed deployable 0x{dGuid:X8} into container 0x{cGuid:X8}");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"failed to pack deployable 0x{dGuid:X8} into container 0x{cGuid:X8}");
+                    }
+                    return;
+                }
+
+                case "unpack":
+                {
+                    if (parameters.Length < 2)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @container unpack <containerGuid> [slot|all]");
+                        return;
+                    }
+
+                    uint cGuid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out cGuid);
+                    else
+                        uint.TryParse(parameters[1], out cGuid);
+
+                    var c = Deployables.DeployableManager.GetDeployable(cGuid) as Deployables.IsoContainerDeployable;
+                    if (c == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"container 0x{cGuid:X8} not found");
+                        return;
+                    }
+
+                    if (parameters.Length > 2 && int.TryParse(parameters[2], out var slot))
+                    {
+                        sbyte subSlot = -1;
+                        if (parameters.Length > 3 && sbyte.TryParse(parameters[3], out var parsedSub))
+                            subSlot = parsedSub;
+
+                        if (c.TryUnpackSlot(slot, out WorldObject spawned, subSlot))
+                        {
+                            c.BroadcastState();
+                            CommandHandlerHelper.WriteOutputInfo(session, $"unpacked deployable (0x{spawned.Guid.Full:X8}) from slot {slot}{(subSlot >= 0 ? $" subslot {subSlot}" : "")}");
+                        }
+                        else
+                        {
+                            CommandHandlerHelper.WriteOutputInfo(session, $"failed to unpack slot {slot} from container 0x{cGuid:X8}");
+                        }
+                    }
+                    else
+                    {
+                        var count = c.UnpackAll(out List<WorldObject> _);
+                        c.BroadcastState();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"unpacked {count} deployables from container 0x{cGuid:X8}");
+                    }
+                    return;
+                }
+
+                case "stack":
+                {
+                    if (parameters.Length < 3)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @container stack <lowerGuid> <upperGuid>");
+                        return;
+                    }
+
+                    uint lowerGuid, upperGuid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out lowerGuid);
+                    else
+                        uint.TryParse(parameters[1], out lowerGuid);
+
+                    if (parameters[2].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[2].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out upperGuid);
+                    else
+                        uint.TryParse(parameters[2], out upperGuid);
+
+                    var lower = Deployables.DeployableManager.GetDeployable(lowerGuid) as Deployables.IsoContainerDeployable;
+                    var upper = Deployables.DeployableManager.GetDeployable(upperGuid) as Deployables.IsoContainerDeployable;
+                    if (lower == null || upper == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "one or both containers not found");
+                        return;
+                    }
+
+                    var stackZ = lower.Position.Z + lower.RoofZ;
+                    upper.Location = Vehicle.ToPosition(lower.Position.X, lower.Position.Y, stackZ, lower.Location?.Rotation ?? Quaternion.Identity);
+                    upper.BroadcastState();
+                    CommandHandlerHelper.WriteOutputInfo(session, $"stacked container 0x{upperGuid:X8} atop 0x{lowerGuid:X8} (elevation +{lower.RoofZ:0.000}m)");
+                    return;
+                }
+
+                case "list":
+                {
+                    var containers = Deployables.DeployableManager.GetAll().OfType<Deployables.IsoContainerDeployable>().ToList();
+                    var sb = new System.Text.StringBuilder();
+                    sb.AppendLine($"ISO Containers: {containers.Count} active");
+                    foreach (var c in containers)
+                    {
+                        sb.AppendLine($"  0x{c.Guid.Full:X8} | {c.IsoType}/{c.IsoGroup} (WCID {c.Wcid}) | {c.IsoCode} | Doors: {c.DoorState} ({c.DoorProgress:P0}) | Bays: {c.OccupiedFullBayCount}/{c.MaxFullSlots} Full");
+                    }
+                    CommandHandlerHelper.WriteOutputInfo(session, sb.ToString().TrimEnd());
+                    return;
+                }
+
+                case "despawn":
+                {
+                    if (parameters.Length > 1 && parameters[1].Equals("all", StringComparison.OrdinalIgnoreCase))
+                    {
+                        var all = Deployables.DeployableManager.GetAll().OfType<Deployables.IsoContainerDeployable>().ToList();
+                        foreach (var container in all)
+                            container.Destroy();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"despawned {all.Count} container(s)");
+                        return;
+                    }
+
+                    if (parameters.Length < 2)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @container despawn <guid|all>");
+                        return;
+                    }
+
+                    uint guid;
+                    if (parameters[1].StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                        uint.TryParse(parameters[1].Substring(2), System.Globalization.NumberStyles.HexNumber, null, out guid);
+                    else
+                        uint.TryParse(parameters[1], out guid);
+
+                    var c = Deployables.DeployableManager.GetDeployable(guid) as Deployables.IsoContainerDeployable;
+                    if (c != null)
+                    {
+                        c.Destroy();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"despawned container 0x{guid:X8}");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"container 0x{guid:X8} not found");
+                    }
+                    return;
+                }
+
+                default:
+                    CommandHandlerHelper.WriteOutputInfo(session, "usage: @container spawn | preset | doors | load | pack | unpack | stack | list | despawn");
+                    return;
+            }
+        }
     }
 }
