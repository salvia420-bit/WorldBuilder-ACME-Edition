+        public void SetDoorProgress(float progress)
+        {
+            if (float.IsNaN(progress))
+            {
+                DoorProgress = 0.0f;
+                DoorState = ContainerDoorState.Closed;
+                return;
+            }
+
+            DoorProgress = Math.Clamp(progress, 0.0f, 1.0f);
+            if (DoorProgress <= 0.0f)
+                DoorState = ContainerDoorState.Closed;
+            else if (DoorProgress >= 1.0f)
+                DoorState = ContainerDoorState.Open;
+            else if (DoorState == ContainerDoorState.Closed)
+                DoorState = ContainerDoorState.Opening;
+            else if (DoorState == ContainerDoorState.Open)
+                DoorState = ContainerDoorState.Closing;
+        }
+
+        public void ToggleDoors()
+        {
+            switch (DoorState)
+            {
+                case ContainerDoorState.Closed:
+                    DoorState = ContainerDoorState.Opening;
+                    break;
+                case ContainerDoorState.Open:
+                    DoorState = ContainerDoorState.Closing;
+                    break;
+                case ContainerDoorState.Opening:
+                    DoorState = ContainerDoorState.Closing;
+                    break;
+                case ContainerDoorState.Closing:
+                    DoorState = ContainerDoorState.Opening;
+                    break;
+            }
+        }
+
+        public void Tick(double elapsedSeconds)
+        {
