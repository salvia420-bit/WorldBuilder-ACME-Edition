+
+        public void SetDoorProgress(float progress)
+        {
+            if (float.IsNaN(progress))
+            {
+                DoorProgress = 0.0f;
+                DoorState = ContainerDoorState.Closed;
+                return;
+            }
+
+            DoorProgress = Math.Clamp(progress, 0.0f, 1.0f);
+            if (DoorProgress <= 0.0f)
+                DoorState = ContainerDoorState.Closed;
+            else if (DoorProgress >= 1.0f)
+                DoorState = ContainerDoorState.Open;
+            else if (DoorState == ContainerDoorState.Closed)
+                DoorState = ContainerDoorState.Opening;
+            else if (DoorState == ContainerDoorState.Open)
+                DoorState = ContainerDoorState.Closing;
+        }
+
+        public void OpenDoors()
+        {
+            if (DoorState == ContainerDoorState.Open) return;
+            DoorState = ContainerDoorState.Opening;
+        }
+
+        public void CloseDoors()
+        {
+            if (DoorState == ContainerDoorState.Closed) return;
+            DoorState = ContainerDoorState.Closing;
+        }
+
+        public void ToggleDoors()
+        {
+            switch (DoorState)
+            {
+                case ContainerDoorState.Closed:
+                    DoorState = ContainerDoorState.Opening;
+                    break;
+                case ContainerDoorState.Open:
+                    DoorState = ContainerDoorState.Closing;
+                    break;
+                case ContainerDoorState.Opening:
+                    DoorState = ContainerDoorState.Closing;
+                    break;
+                case ContainerDoorState.Closing:
+                    DoorState = ContainerDoorState.Opening;
+                    break;
+            }
+        }
+
+        public override void Tick(double elapsedSeconds)
+        {
+            base.Tick(elapsedSeconds);
+
+            if (DoorState == ContainerDoorState.Closed || DoorState == ContainerDoorState.Open)
+                return;
+
+            if (double.IsNaN(elapsedSeconds) || elapsedSeconds <= 0.0)
+                return;
+
+            float delta = (float)(elapsedSeconds / (double)DoorAnimationDurationSec);
+
+            if (DoorState == ContainerDoorState.Opening)
+            {
+                DoorProgress = Math.Clamp(DoorProgress + delta, 0.0f, 1.0f);
+                if (DoorProgress >= 0.9999f)
+                {
+                    DoorProgress = 1.0f;
+                    DoorState = ContainerDoorState.Open;
+                    BroadcastState();
+                }
+            }
+            else if (DoorState == ContainerDoorState.Closing)
+            {
+                DoorProgress = Math.Clamp(DoorProgress - delta, 0.0f, 1.0f);
+                if (DoorProgress <= 0.0001f)
+                {
+                    DoorProgress = 0.0f;
+                    DoorState = ContainerDoorState.Closed;
+                    BroadcastState();
+                }
+            }
+        }
+
+        public override void ActOnUse(WorldObject activator)
+        {
+            ToggleDoors();
+            if (activator is Player player)
+            {
+                var doorStr = DoorState == ContainerDoorState.Opening ? "OPENING" :
+                              DoorState == ContainerDoorState.Closing ? "CLOSING" :
+                              DoorState == ContainerDoorState.Open ? "OPEN" : "CLOSED";
+                var typeStr = IsoGroup;
+                var checkDigit = ComputeIso6346CheckDigit("HLTB", 'U', SerialNumber);
+                var label = OccupiedFullBayCount >= 7 ? " (FOB-in-a-Box)" : "";
+                var msg = $"[ISO 6346] HLTB U {SerialNumber:D6}-{checkDigit} [{typeStr}] | Doors: {doorStr} | Cargo: {OccupiedFullBayCount}/{MaxFullSlots} Full Slots{label}";
+                player.SendMessage(msg, ChatMessageType.Broadcast);
+            }
+            BroadcastState();
+        }
+
+        public static int ComputeIso6346CheckDigit(string owner, char category, uint serial)
+        {
+            if (serial > 999999)
+                throw new ArgumentException($"Invalid ISO 6346 serial number (must be 0-999999): {serial}");
+
+            var cleanedOwner = owner?.Trim().ToUpperInvariant() ?? "";
+            string code;
+            if (cleanedOwner.Length >= 4)
+                code = $"{cleanedOwner}{serial:D6}";
+            else
+                code = $"{cleanedOwner}{char.ToUpperInvariant(category)}{serial:D6}";
+            return ComputeIso6346CheckDigit(code);
+        }
+
+        public static int ComputeIso6346CheckDigit(string prefix, uint serial)
+        {
+            if (serial > 999999)
+                throw new ArgumentException($"Invalid ISO 6346 serial number (must be 0-999999): {serial}");
+
+            var cleaned = prefix?.Trim().ToUpperInvariant() ?? "";
+            return ComputeIso6346CheckDigit($"{cleaned}{serial:D6}");
+        }
+
+        public static int ComputeIso6346CheckDigit(string raw)
+        {
+            if (string.IsNullOrWhiteSpace(raw))
+                throw new ArgumentException("ISO 6346 container string cannot be null or empty.");
+
+            var sb = new StringBuilder(raw.Length);
+            for (int i = 0; i < raw.Length; i++)
+            {
+                char ch = raw[i];
+
+                if (char.IsWhiteSpace(ch) || ch == '-')
+                    continue;
+
+                if ((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9'))
+                {
+                    sb.Append(char.ToUpperInvariant(ch));
+                }
+                else
+                {
+                    throw new ArgumentException($"Invalid character in ISO 6346 string: '{(ch == '\0' ? "\\0" : ch.ToString())}'");
+                }
+            }
+
+            var cleaned = sb.ToString();
+
+            if (cleaned.Length != 10 && cleaned.Length != 11)
+                throw new ArgumentException($"Invalid ISO 6346 input length ({cleaned.Length}): '{raw}'");
+
+            var prefix = cleaned.Substring(0, 4);
+            var serial = cleaned.Substring(4, 6);
+
+            if (!prefix.All(ch => ch >= 'A' && ch <= 'Z'))
+                throw new ArgumentException($"Invalid ISO 6346 prefix: '{prefix}'");
+
+            if (!serial.All(ch => ch >= '0' && ch <= '9'))
+                throw new ArgumentException($"Invalid ISO 6346 serial: '{serial}'");
+
+            if (cleaned.Length == 11 && (cleaned[10] < '0' || cleaned[10] > '9'))
+                throw new ArgumentException($"Invalid ISO 6346 check digit: '{cleaned[10]}'");
+
+            int sum = 0;
+            for (int i = 0; i < 10; i++)
+            {
+                char ch = cleaned[i];
+                int val;
+                if (ch >= '0' && ch <= '9')
+                {
+                    val = ch - '0';
+                }
+                else
+                {
+                    if (!LetterWeights.TryGetValue(ch, out val))
+                        throw new ArgumentException($"Invalid letter in ISO 6346: '{ch}'");
+                }
+
+                sum += val * (1 << i);
+            }
+
+            int remainder = sum % 11;
+            return remainder % 10;
+        }
+
+        public static PalletSize DeterminePalletSize(uint wcid) => wcid switch
+        {
+            4000002 => PalletSize.Full, // RadarStation
+            4000010 => PalletSize.Full, // FluxPod
+            4000011 => PalletSize.Full, // SolarPanels
+            4000012 => PalletSize.Full, // PowerGenerator
+            4000014 => PalletSize.Full, // MissileTurret
+            4000013 => PalletSize.Half, // BatteryUnit
+            4000015 => PalletSize.Half, // GroundRadar
+            4000016 => PalletSize.Half, // MortarTurret
+            4000017 => PalletSize.Half, // LaserTurret
+            _ => PalletSize.None
+        };
+
+        public bool TryLoadWcid(int slotIndex, uint wcid, PalletSize palletSize, byte subSlot = 0, bool ignoreDoorState = false)
+        {
+            if (!ignoreDoorState && DoorProgress < 0.8f)
+                return false;
+
+            if (slotIndex < 0 || slotIndex >= Slots.Count)
+                return false;
+
+            var slot = Slots[slotIndex];
+
+            if (palletSize == PalletSize.Full)
+            {
+                if (slot.Occupied || slot.OccupiedSubSlots != 0)
+                    return false;
+
+                slot.Occupied = true;
+                slot.OccupiedWcids[0] = wcid;
+                slot.OccupiedWcids[1] = 0;
+                slot.OccupiedPalletSize = PalletSize.Full;
+                slot.OccupiedSubSlots = 0x03;
+                return true;
+            }
+            else if (palletSize == PalletSize.Half)
+            {
+                int sub = subSlot & 1;
+                byte mask = (byte)(1 << sub);
+                if ((slot.OccupiedSubSlots & mask) != 0 || (slot.OccupiedPalletSize == PalletSize.Full))
+                    return false;
+
+                slot.OccupiedSubSlots |= mask;
+                slot.OccupiedWcids[sub] = wcid;
+                slot.OccupiedPalletSize = PalletSize.Half;
+                if (slot.OccupiedSubSlots == 0x03)
+                    slot.Occupied = true;
+                return true;
+            }
+
+            return false;
+        }
+
+        public bool TryLoadWcid(int slotIndex, uint wcid, byte subSlot = 0, bool ignoreDoorState = false)
+        {
+            var pallet = DeterminePalletSize(wcid);
+            if (pallet == PalletSize.None) return false;
+            return TryLoadWcid(slotIndex, wcid, pallet, subSlot, ignoreDoorState);
+        }
+
+        public bool TryPackDeployable(uint deployableGuid)
+        {
+            if (DoorProgress < 0.8f)
+                return false;
+
+            var radar = AirDefenseManager.Stations.FirstOrDefault(s => s.Guid.Full == deployableGuid);
+            if (radar != null)
+            {
+                var (rx, ry, rz) = radar.Location != null ? Vehicle.ToGlobal(radar.Location) : (0.0, 0.0, 0.0);
+                var rPos = new Vector3((float)rx, (float)ry, (float)rz);
+                if (Vector3.Distance(Position, rPos) > 15.0f)
+                    return false;
+
+                for (int i = 0; i < Slots.Count; i++)
+                {
+                    var slot = Slots[i];
+                    if (!slot.Occupied && slot.OccupiedSubSlots == 0)
+                    {
+                        slot.Occupied = true;
+                        slot.OccupiedWcids[0] = 4000002;
+                        slot.OccupiedWcids[1] = 0;
+                        slot.OccupiedPalletSize = PalletSize.Full;
+                        slot.OccupiedSubSlots = 0x03;
+
+                        AirDefenseManager.UnregisterStation(deployableGuid);
+                        radar.Destroy();
+                        return true;
+                    }
+                }
+                return false;
+            }
+
+            var dep = DeployableManager.GetDeployable(deployableGuid);
+            if (dep != null)
+            {
+                var (dx, dy, dz) = dep.Location != null ? Vehicle.ToGlobal(dep.Location) : (0.0, 0.0, 0.0);
+                var dPos = new Vector3((float)dx, (float)dy, (float)dz);
+                if (Vector3.Distance(Position, dPos) > 15.0f)
+                    return false;
+
+                var pallet = dep.Pallet;
+                if (pallet == PalletSize.Full)
+                {
+                    for (int i = 0; i < Slots.Count; i++)
+                    {
+                        var slot = Slots[i];
+                        if (!slot.Occupied && slot.OccupiedSubSlots == 0)
+                        {
+                            slot.Occupied = true;
+                            slot.OccupiedWcids[0] = dep.Wcid;
+                            slot.OccupiedWcids[1] = 0;
+                            slot.OccupiedPalletSize = PalletSize.Full;
+                            slot.OccupiedSubSlots = 0x03;
+
+                            dep.Destroy();
+                            return true;
+                        }
+                    }
+                }
+                else if (pallet == PalletSize.Half)
+                {
+                    for (int i = 0; i < Slots.Count; i++)
+                    {
+                        var slot = Slots[i];
+                        if (slot.OccupiedPalletSize == PalletSize.Half && slot.OccupiedSubSlots != 0x03)
+                        {
+                            byte sub = (byte)((slot.OccupiedSubSlots & 0x01) == 0 ? 0 : 1);
+                            slot.OccupiedSubSlots |= (byte)(1 << sub);
+                            slot.OccupiedWcids[sub] = dep.Wcid;
+                            if (slot.OccupiedSubSlots == 0x03)
+                                slot.Occupied = true;
+
+                            dep.Destroy();
+                            return true;
+                        }
+                    }
+
+                    for (int i = 0; i < Slots.Count; i++)
+                    {
+                        var slot = Slots[i];
+                        if (!slot.Occupied && slot.OccupiedSubSlots == 0)
+                        {
+                            slot.OccupiedPalletSize = PalletSize.Half;
+                            slot.OccupiedSubSlots = 0x01;
+                            slot.OccupiedWcids[0] = dep.Wcid;
+                            slot.OccupiedWcids[1] = 0;
+
+                            dep.Destroy();
+                            return true;
+                        }
+                    }
+                }
+            }
+
+            return false;
+        }
+
+        public bool TryUnpackSlot(int slotIndex, out uint wcid, sbyte subSlot = -1)
+        {
+            wcid = 0;
+            if (DoorProgress < 0.8f)
+                return false;
+
+            if (slotIndex < 0 || slotIndex >= Slots.Count)
+                return false;
+
+            var slot = Slots[slotIndex];
+            if (!slot.Occupied && slot.OccupiedSubSlots == 0)
+                return false;
+
+            if (slot.OccupiedPalletSize == PalletSize.Full)
+            {
+                wcid = slot.OccupiedWcids[0];
+                slot.Occupied = false;
+                slot.OccupiedWcids[0] = 0;
+                slot.OccupiedWcids[1] = 0;
+                slot.OccupiedPalletSize = PalletSize.None;
+                slot.OccupiedSubSlots = 0;
+                return true;
+            }
+            else if (slot.OccupiedPalletSize == PalletSize.Half)
+            {
+                int targetSub;
+                if (subSlot == 0 || subSlot == 1)
+                {
+                    targetSub = subSlot;
+                    if ((slot.OccupiedSubSlots & (1 << targetSub)) == 0)
+                        return false;
+                }
+                else
+                {
+                    targetSub = (slot.OccupiedSubSlots & 0x01) != 0 ? 0 : 1;
+                    if ((slot.OccupiedSubSlots & (1 << targetSub)) == 0)
+                        return false;
+                }
+
+                wcid = slot.OccupiedWcids[targetSub];
+                slot.OccupiedWcids[targetSub] = 0;
+                slot.OccupiedSubSlots &= (byte)~(1 << targetSub);
+                slot.Occupied = false;
+                if (slot.OccupiedSubSlots == 0)
+                {
+                    slot.OccupiedPalletSize = PalletSize.None;
+                }
+                return true;
+            }
+
+            return false;
+        }
+
+        public bool TryUnpackSlot(int slotIndex, out WorldObject spawned, sbyte subSlot = -1)
+        {
+            spawned = null;
+            if (!TryUnpackSlot(slotIndex, out uint wcid, subSlot))
+                return false;
+
+            var (spawnPos, _) = ComputeUnpackSpawnLocation();
+            var player = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+
+            if (wcid == 4000002) // RadarStation
+            {
+                var weenie = RadarStation.BuildWeenie(null, player);
+                ObjectGuid guid;
+                try { guid = GuidManager.NewDynamicGuid(); }
+                catch (NullReferenceException) { guid = new ObjectGuid(0x75000000u | ((uint)new Random().Next(0x00010000, 0x000FFFFF))); }
+
+                var station = new RadarStation(weenie, guid, null, player)
+                {
+                    Location = spawnPos
+                };
+                station.EnterWorld();
+                AirDefenseManager.RegisterStation(station);
+                spawned = station;
+                return true;
+            }
+            else
+            {
+                var dep = DeployableManager.SpawnDeployable(wcid, spawnPos, player);
+                spawned = dep;
+                return dep != null;
+            }
+        }
+
+        public int UnpackAll(out List<uint> unpackedWcids)
+        {
+            unpackedWcids = new List<uint>();
+            if (DoorProgress < 0.8f)
+                return 0;
+
+            foreach (var slot in Slots)
+            {
+                if (slot.Occupied || slot.OccupiedSubSlots != 0)
+                {
+                    if (slot.OccupiedPalletSize == PalletSize.Full)
+                    {
+                        if (slot.OccupiedWcids[0] != 0)
+                            unpackedWcids.Add(slot.OccupiedWcids[0]);
+
+                        slot.Occupied = false;
+                        slot.OccupiedWcids[0] = 0;
+                        slot.OccupiedWcids[1] = 0;
+                        slot.OccupiedPalletSize = PalletSize.None;
+                        slot.OccupiedSubSlots = 0;
+                    }
+                    else if (slot.OccupiedPalletSize == PalletSize.Half)
+                    {
+                        for (int i = 0; i < 2; i++)
+                        {
+                            if ((slot.OccupiedSubSlots & (1 << i)) != 0 && slot.OccupiedWcids[i] != 0)
+                            {
+                                unpackedWcids.Add(slot.OccupiedWcids[i]);
+                                slot.OccupiedWcids[i] = 0;
+                            }
+                        }
+
+                        slot.Occupied = false;
+                        slot.OccupiedPalletSize = PalletSize.None;
+                        slot.OccupiedSubSlots = 0;
+                    }
+                }
+            }
+
+            return unpackedWcids.Count;
+        }
+
+        public int UnpackAll(out List<WorldObject> spawnedList)
+        {
+            spawnedList = new List<WorldObject>();
+            if (DoorProgress < 0.8f)
+                return 0;
+
+            for (int i = 0; i < Slots.Count; i++)
+            {
+                while (Slots[i].Occupied || Slots[i].OccupiedSubSlots != 0)
+                {
+                    if (TryUnpackSlot(i, out WorldObject obj) && obj != null)
+                        spawnedList.Add(obj);
+                    else
+                        break;
+                }
+            }
+
+            return spawnedList.Count;
+        }
+
+        private (Position pos, float heading) ComputeUnpackSpawnLocation()
+        {
+            float halfExtL = ExternalDimensions.Y / 2f;
+            float localX = 0f;
+            float localY = -halfExtL - RampLength - 1.5f;
+
+            float heading = HeadingRad;
+            float spawnX = Position.X + localX * (float)Math.Cos(heading) - localY * (float)Math.Sin(heading);
+            float spawnY = Position.Y + localX * (float)Math.Sin(heading) + localY * (float)Math.Cos(heading);
+
+            var gz = VehicleTerrain.Ground(spawnX, spawnY);
+            float spawnZ = !double.IsNaN(gz) ? (float)gz : Position.Z;
+
+            var pos = Vehicle.ToPosition(spawnX, spawnY, spawnZ, Location?.Rotation ?? Quaternion.Identity);
+            return (pos, heading);
+        }
+
+        public BridgeSupport ProbeWalkableSupport(float worldX, float worldY, float worldZ)
+        {
+            float dx = worldX - Position.X;
+            float dy = worldY - Position.Y;
+            float cosH = (float)Math.Cos(-HeadingRad);
+            float sinH = (float)Math.Sin(-HeadingRad);
+
+            float localX = dx * cosH - dy * sinH;
+            float localY = dx * sinH + dy * cosH;
+
+            float halfExtW = ExternalDimensions.X / 2f;
+            float halfExtL = ExternalDimensions.Y / 2f;
+            float halfIntW = InternalDimensions.X / 2f;
+            float halfIntL = InternalDimensions.Y / 2f;
+
+            // 1. Roof Support
+            if (Math.Abs(localX) <= halfExtW && Math.Abs(localY) <= halfExtL)
+            {
+                float deckZ = Position.Z + RoofZ;
+                if (Math.Abs(worldZ - deckZ) <= 0.5f)
+                {
+                    return new BridgeSupport
+                    {
+                        Found = true,
+                        DeckZ = deckZ,
+                        Nx = 0,
+                        Ny = 0,
+                        Nz = 1.0,
+                    };
+                }
+            }
+
+            // 2. Interior Floor Support
+            if (DoorProgress > 0.05f)
+            {
+                if (Math.Abs(localX) <= halfIntW && Math.Abs(localY) <= halfIntL)
+                {
+                    float deckZ = Position.Z + FloorZ;
+                    if (Math.Abs(worldZ - deckZ) <= 0.5f)
+                    {
+                        return new BridgeSupport
+                        {
+                            Found = true,
+                            DeckZ = deckZ,
+                            Nx = 0,
+                            Ny = 0,
+                            Nz = 1.0,
+                        };
+                    }
+                }
+            }
+
+            // 3. Fold-Down Ramp Support
+            if (DoorProgress > 0.05f)
+            {
+                float rampStartY = -halfExtL;
+                float rampEndY = rampStartY - RampLength;
+                float halfDoorW = DoorOpeningDimensions.X / 2f;
+
+                if (Math.Abs(localX) <= halfDoorW && localY <= rampStartY && localY >= rampEndY)
+                {
+                    float t = (rampStartY - localY) / RampLength;
+                    float localDeckZ = FloorZ * (1.0f - t);
+                    float deckZ = Position.Z + localDeckZ;
+
+                    if (Math.Abs(worldZ - deckZ) <= 0.5f)
+                    {
+                        float sinTheta = FloorZ / RampLength;
+                        float theta = (float)Math.Asin(sinTheta);
+                        float cosTheta = (float)Math.Cos(theta);
+
+                        float nx = sinTheta * (float)Math.Sin(HeadingRad);
+                        float ny = -sinTheta * (float)Math.Cos(HeadingRad);
+                        float nz = cosTheta;
+
+                        return new BridgeSupport
+                        {
+                            Found = true,
+                            DeckZ = deckZ,
+                            Nx = nx,
+                            Ny = ny,
+                            Nz = nz,
+                        };
+                    }
+                }
+            }
+
+            return default;
+        }
+
+        public VehicleContainerStateMsg CreateContainerStateMsg()
+        {
+            var msg = new VehicleContainerStateMsg
+            {
+                ContainerGuid = Guid.Full,
+                ContainerKind = (uint)Kind,
+                DoorState = (byte)DoorState,
+                LiveryId = LiveryId,
+                MaxFullSlots = (byte)MaxFullSlots,
+                Flags = 1,
+                OwnerGuid = DeployerPlayerGuid,
+                Cell = Location?.Cell ?? 0,
+                Position = Position,
+                Heading = HeadingRad,
+                DoorProgress = DoorProgress,
+                SerialNumber = SerialNumber,
+            };
+
+            foreach (var s in Slots)
+            {
+                if (s.Occupied || s.OccupiedSubSlots != 0)
+                {
+                    if (s.OccupiedPalletSize == PalletSize.Full)
+                    {
+                        msg.Slots.Add(new ContainerSlotWire
+                        {
+                            SlotIndex = (byte)s.SlotIndex,
+                            PalletSize = (byte)PalletSize.Full,
+                            SubSlot = 0,
+                            Reserved = 0,
+                            CargoWcid = s.OccupiedWcids[0],
+                        });
+                    }
+                    else if (s.OccupiedPalletSize == PalletSize.Half)
+                    {
+                        for (int i = 0; i < 2; i++)
+                        {
+                            if ((s.OccupiedSubSlots & (1 << i)) != 0)
+                            {
+                                msg.Slots.Add(new ContainerSlotWire
+                                {
+                                    SlotIndex = (byte)s.SlotIndex,
+                                    PalletSize = (byte)PalletSize.Half,
+                                    SubSlot = (byte)i,
+                                    Reserved = 0,
+                                    CargoWcid = s.OccupiedWcids[i],
+                                });
+                            }
+                        }
+                    }
+                }
+            }
+
+            return msg;
+        }
+
+        public override void BroadcastState(float range = 600.0f)
+        {
+            if (Location == null) return;
+            var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+            VehicleManager.BroadcastNear(Location, range, deployer, () => CreateContainerStateMsg());
+        }
+    }
+}
