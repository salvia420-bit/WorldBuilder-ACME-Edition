+        private void Initialize20ftSlots()
+        {
+            Slots.Clear();
+            (float x, float y, char orient, float dx, float dy)[] rawSlots = new[]
+            {
+                (-0.5080f, +2.3889f, 'X', 1.2192f, 1.0160f),
+                (+0.6096f, +2.2873f, 'Y', 1.0160f, 1.2192f),
+                (+0.5080f, +1.1697f, 'X', 1.2192f, 1.0160f),
+                (-0.6096f, +1.2713f, 'Y', 1.0160f, 1.2192f),
+                (-0.5080f, +0.1016f, 'X', 1.2192f, 1.0160f),
+                (+0.6096f, -0.0000f, 'Y', 1.0160f, 1.2192f),
+                (+0.5080f, -1.1176f, 'X', 1.2192f, 1.0160f),
+                (-0.6096f, -1.0160f, 'Y', 1.0160f, 1.2192f),
+                (-0.5080f, -2.2873f, 'Y', 1.0160f, 1.2192f),
+                (+0.5080f, -2.2873f, 'Y', 1.0160f, 1.2192f),
+            };
+
+            for (int i = 0; i < rawSlots.Length; i++)
+            {
+                var r = rawSlots[i];
+                Slots.Add(new PinwheelBaySlot { SlotIndex = i, X = r.x, Y = r.y, Orient = r.orient, Dx = r.dx, Dy = r.dy });
+            }
+        }
