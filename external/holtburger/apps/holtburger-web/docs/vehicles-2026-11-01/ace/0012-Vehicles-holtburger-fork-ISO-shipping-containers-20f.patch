+                Slots.Add(new PinwheelBaySlot { SlotIndex = idx++, X = +0.6096f, Y = yc + 0.5080f, Orient = 'Y', Dx = 1.0160f, Dy = 1.2192f });
+                Slots.Add(new PinwheelBaySlot { SlotIndex = idx++, X = +0.5080f, Y = yc - 0.6096f, Orient = 'X', Dx = 1.2192f, Dy = 1.0160f });
+                Slots.Add(new PinwheelBaySlot { SlotIndex = idx++, X = -0.6096f, Y = yc - 0.5080f, Orient = 'Y', Dx = 1.0160f, Dy = 1.2192f });
+            }
+
+            // Asymmetric rear tier (5 slots)
+            Slots.Add(new PinwheelBaySlot { SlotIndex = idx++, X = -0.5368f, Y = -3.4544f, Orient = 'X', Dx = 1.2192f, Dy = 1.0160f });
+            Slots.Add(new PinwheelBaySlot { SlotIndex = idx++, X = -0.5368f, Y = -4.4704f, Orient = 'X', Dx = 1.2192f, Dy = 1.0160f });
+            Slots.Add(new PinwheelBaySlot { SlotIndex = idx++, X = -0.5368f, Y = -5.4864f, Orient = 'X', Dx = 1.2192f, Dy = 1.0160f });
+            Slots.Add(new PinwheelBaySlot { SlotIndex = idx++, X = +0.6384f, Y = -3.5560f, Orient = 'Y', Dx = 1.0160f, Dy = 1.2192f });
