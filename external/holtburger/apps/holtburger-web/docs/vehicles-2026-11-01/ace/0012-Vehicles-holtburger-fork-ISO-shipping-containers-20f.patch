+        public static int ComputeIso6346CheckDigit(string owner, char category, uint serial)
+        {
+            if (serial > 999999)
+                throw new ArgumentException($"Invalid ISO 6346 serial number (must be 0-999999): {serial}");
+
+            var cleanedOwner = owner?.Trim().ToUpperInvariant() ?? "";
+            string code;
+            if (cleanedOwner.Length >= 4)
+                code = $"{cleanedOwner}{serial:D6}";
+            else
+                code = $"{cleanedOwner}{char.ToUpperInvariant(category)}{serial:D6}";
+            return ComputeIso6346CheckDigit(code);
+        }
+
+        public static int ComputeIso6346CheckDigit(string prefix, uint serial)
+        {
+            if (serial > 999999)
+                throw new ArgumentException($"Invalid ISO 6346 serial number (must be 0-999999): {serial}");
+
+            var cleaned = prefix?.Trim().ToUpperInvariant() ?? "";
+            return ComputeIso6346CheckDigit($"{cleaned}{serial:D6}");
+        }
+
+        public static int ComputeIso6346CheckDigit(string raw)
+        {
+            if (string.IsNullOrWhiteSpace(raw))
+                throw new ArgumentException("ISO 6346 container string cannot be null or empty.");
+
+            var sb = new StringBuilder(raw.Length);
+            for (int i = 0; i < raw.Length; i++)
+            {
+                char ch = raw[i];
+
+                // Only trim/ignore standard whitespace and hyphens
+                if (char.IsWhiteSpace(ch) || ch == '-')
+                    continue;
+
+                // If any invalid characters, symbols, or embedded null bytes are present, throw ArgumentException
+                if ((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9'))
+                {
+                    sb.Append(char.ToUpperInvariant(ch));
+                }
+                else
+                {
+                    throw new ArgumentException($"Invalid character in ISO 6346 string: '{(ch == '\0' ? "\\0" : ch.ToString())}'");
+                }
+            }
+
+            var cleaned = sb.ToString();
+
+            // Verify that the string contains exactly 4 letters followed by 6 digits (or 4 letters + 6 digits + 1 check digit)
+            if (cleaned.Length != 10 && cleaned.Length != 11)
+                throw new ArgumentException($"Invalid ISO 6346 input length ({cleaned.Length}): '{raw}'");
+
+            var prefix = cleaned.Substring(0, 4);
+            var serial = cleaned.Substring(4, 6);
+
+            if (!prefix.All(ch => ch >= 'A' && ch <= 'Z'))
+                throw new ArgumentException($"Invalid ISO 6346 prefix: '{prefix}'");
+
+            if (!serial.All(ch => ch >= '0' && ch <= '9'))
+                throw new ArgumentException($"Invalid ISO 6346 serial: '{serial}'");
+
+            if (cleaned.Length == 11 && (cleaned[10] < '0' || cleaned[10] > '9'))
+                throw new ArgumentException($"Invalid ISO 6346 check digit: '{cleaned[10]}'");
+
+            int sum = 0;
+            for (int i = 0; i < 10; i++)
+            {
+                char ch = cleaned[i];
+                int val;
+                if (ch >= '0' && ch <= '9')
+                {
+                    val = ch - '0';
+                }
+                else
+                {
+                    if (!LetterWeights.TryGetValue(ch, out val))
+                        throw new ArgumentException($"Invalid letter in ISO 6346: '{ch}'");
+                }
+
+                sum += val * (1 << i); // 2^i
+            }
+
+            int remainder = sum % 11;
+            return remainder % 10; // Remainder 10 wraps to 0
+        }
+    }
