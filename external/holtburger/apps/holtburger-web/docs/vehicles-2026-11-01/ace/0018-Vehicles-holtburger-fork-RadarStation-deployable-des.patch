                         CommandHandlerHelper.WriteOutputInfo(session, $"despawned deployable 0x{dGuid:X8}");
                     }
                     else
@@ -383,6 +384,34 @@ public static void HandleDeployable(Session session, params string[] parameters)
             }
         }
 
+        public static int DespawnAllDeployablesAndRadars()
+        {
+            var all = Deployables.DeployableManager.GetAll().ToList();
+            foreach (var d in all)
+                d.Destroy();
+            var stations = AirDefense.AirDefenseManager.Stations.ToList();
+            foreach (var s in stations)
+                s.Destroy();
+            return all.Count + stations.Count;
+        }
+
+        public static bool DespawnDeployableOrRadarByGuid(uint guid)
+        {
+            var target = Deployables.DeployableManager.GetDeployable(guid);
+            if (target != null)
+            {
+                target.Destroy();
+                return true;
+            }
+            var station = AirDefense.AirDefenseManager.Stations.FirstOrDefault(s => s.Guid.Full == guid);
+            if (station != null)
+            {
+                station.Destroy();
+                return true;
+            }
+            return false;
+        }
+
