Date: Fri, 20 Nov 2026 06:28:33 +0000
Subject: [PATCH 18/29] Vehicles (holtburger fork): RadarStation deployable
 despawn/list and Headlights/Horn events

Include AirDefenseManager.Stations (RadarStation 4000002) in [USER_0] list and despawn all/<guid>, and emit VehicleEventKind.Headlights (0x10 toggle) and VehicleEventKind.Horn (0x20 rising edge) from StepVehicle. Adds T5_ADV_07..09; verified 339/339 ACE.Server.Tests (Vehicles|Landblock).
---
 .../Vehicles/DeployableEcosystemTests.cs      | 51 +++++++++++++++++++
 Source/ACE.Server/Vehicles/VehicleCommands.cs | 45 +++++++++++++---
 Source/ACE.Server/Vehicles/VehicleManager.cs  |  7 +++
 3 files changed, 95 insertions(+), 8 deletions(-)

diff --git a/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs b/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
index 4f8e82a0..37cde49f 100644
--- a/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
+++ b/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
@@ -2207,6 +2207,57 @@ public void T5_ADV_06_Vehicle_LoadHalfPallet_RejectsWcidZero()
             Assert.AreEqual(0, v.CargoMask, "CargoMask must remain 0 when loading invalid WCID");
         }
 
+        [TestMethod]
+        public void T5_ADV_07_DespawnAllDeployablesAndRadars_ClearsRadarStation()
+        {
+            DeployableManager.Clear();
+            AirDefenseManager.ClearStations();
+            var stationGuid = new ObjectGuid(0x7500A101);
+            var station = new RadarStation(RadarStation.BuildWeenie(null, null), stationGuid, null, null);
+            AirDefenseManager.RegisterStation(station);
+            Assert.AreEqual(1, AirDefenseManager.Stations.Count, "RadarStation should be registered before cleanup");
+
+            int removed = VehicleCommands.DespawnAllDeployablesAndRadars();
+            Assert.AreEqual(1, removed, "DespawnAllDeployablesAndRadars must count and destroy registered RadarStations");
+            Assert.AreEqual(0, AirDefenseManager.Stations.Count, "AirDefenseManager.Stations must be empty after @deployable despawn all");
+        }
+
+        [TestMethod]
+        public void T5_ADV_08_DespawnDeployableOrRadarByGuid_ClearsSingleRadarStation()
+        {
+            DeployableManager.Clear();
+            AirDefenseManager.ClearStations();
+            var stationGuid = new ObjectGuid(0x7500A102);
+            var station = new RadarStation(RadarStation.BuildWeenie(null, null), stationGuid, null, null);
+            AirDefenseManager.RegisterStation(station);
+
+            Assert.IsTrue(VehicleCommands.DespawnDeployableOrRadarByGuid(stationGuid.Full), "Must locate and destroy RadarStation by GUID");
+            Assert.AreEqual(0, AirDefenseManager.Stations.Count, "RadarStation must be unregistered after targeted despawn");
+            Assert.IsFalse(VehicleCommands.DespawnDeployableOrRadarByGuid(stationGuid.Full), "Second despawn of same GUID must return false");
+        }
+
+        [TestMethod]
+        public void T5_ADV_09_GroundModel_HeadlightsAndHornFlags_TransitionCleanly()
+        {
+            var profile = VehicleProfile.Semi379(0);
+            var gp = GroundParams.FromProfile(profile);
+            var state = new GroundState { X = 100, Y = 100, Z = 10, Heading = 0, Mode = VehicleMode.Parked };
+            TerrainSample flat(double x, double y, double z) => new TerrainSample
+            {
+                Z = 10, Nz = 1, Surface = new SurfaceFamily { Id = 1, Mu = 1.0, MuLat = 1.0 }
+            };
+
+            byte prev = state.GroundFlags;
+            GroundModel.Step(ref state, new GroundInput { Headlights = true, Horn = true }, gp, flat, 1.0 / 30.0);
+            Assert.AreNotEqual(prev & 0x10, state.GroundFlags & 0x10, "Headlights flag bit 0x10 must flip on toggle");
+            Assert.IsTrue((prev & 0x20) == 0 && (state.GroundFlags & 0x20) != 0, "Horn flag bit 0x20 must rise on Horn input");
+
+            prev = state.GroundFlags;
+            GroundModel.Step(ref state, new GroundInput { Headlights = false, Horn = false }, gp, flat, 1.0 / 30.0);
+            Assert.AreNotEqual(prev & 0x10, state.GroundFlags & 0x10, "Headlights flag bit 0x10 must flip off");
+            Assert.IsTrue((state.GroundFlags & 0x20) == 0, "Horn flag bit 0x20 must clear when released");
+        }
+
         #endregion
     }
 }
