+            var datLandblockID = (blockCellID & 0xFFFF0000u) | (uint)LandDefs.BlockCellID;
+            var landblockID = (blockCellID & 0xFFFFu) == (uint)LandDefs.BlockCellID
+                ? datLandblockID
+                : (blockCellID & 0xFFFF0000u) | (isDericost ? (uint)LandDefs.BlockCellID : 0x7FFFu);
 
             // client implementation
             /*if (Landblocks == null || Landblocks.Count == 0)
@@ -92,7 +96,7 @@ public static Landblock get_landblock(uint blockCellID)
                     return landblock;
 
                 // if not, load into cache
-                landblock = new Landblock(DBObj.GetCellLandblock(landblockID));
+                landblock = new Landblock(DBObj.GetCellLandblock(datLandblockID));
                 if (Landblocks.TryAdd(landblockID, landblock))
                     landblock.PostInit();
                 else
diff --git a/Source/ACE.Server/Physics/Common/LandDefs.cs b/Source/ACE.Server/Physics/Common/LandDefs.cs
index 18dd3dfa..518fc806 100644
--- a/Source/ACE.Server/Physics/Common/LandDefs.cs
+++ b/Source/ACE.Server/Physics/Common/LandDefs.cs
@@ -117,6 +117,13 @@ static LandDefs()
                 LandHeightTable = DatManager.PortalDat.RegionDesc.LandDefs.LandHeightTable;
         }
 
+        public static bool IsDericostCell(uint blockCellID)
+        {
+            return (blockCellID & 0xFFFFu) != BlockCellID
+                && (blockCellID & 0x7FFFu) < FirstEnvCellID
+                && (blockCellID & 0x8000u) != 0;
+        }
+
         public static bool AdjustToOutside(Position pos)
         {
             return AdjustToOutside(ref pos.ObjCellID, ref pos.Frame.Origin);
@@ -124,7 +131,7 @@ public static bool AdjustToOutside(Position pos)
 
         public static bool AdjustToOutside(ref uint blockCellID, ref Vector3 loc)
         {
-            var continentBit = blockCellID & 0x8000u;
+            var continentBit = IsDericostCell(blockCellID) ? 0x8000u : 0u;
             var cellID = (uint)((blockCellID & 0xFFFF) == BlockCellID ? BlockCellID : (blockCellID & 0x7FFF));
 
             if (cell_in_range(cellID))
