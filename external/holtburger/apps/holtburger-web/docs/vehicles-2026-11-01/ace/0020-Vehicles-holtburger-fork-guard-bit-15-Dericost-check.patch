From 7ab1eb3a34e6c23eab57b0eca1d3a4c19891a4d2 Mon Sep 17 00:00:00 2001
From: salvia420-bit <salvia420@gmail.com>
Date: Fri, 20 Nov 2026 09:00:28 +0000
Subject: [PATCH 20/29] Vehicles (holtburger fork): guard bit-15 Dericost check
 against BlockCellID 0xFFFF and indoor EnvCells

---
 .../DericostContinentInvariantsTests.cs       | 48 +++++++++++++++++++
 Source/ACE.Server/Physics/Common/LScape.cs    | 10 ++--
 Source/ACE.Server/Physics/Common/LandDefs.cs  |  9 +++-
 Source/ACE.Server/Physics/PhysicsObj.cs       |  2 +-
 4 files changed, 64 insertions(+), 5 deletions(-)

diff --git a/Source/ACE.Server.Tests/Vehicles/DericostContinentInvariantsTests.cs b/Source/ACE.Server.Tests/Vehicles/DericostContinentInvariantsTests.cs
index 51b2b820..cd55fd6b 100644
--- a/Source/ACE.Server.Tests/Vehicles/DericostContinentInvariantsTests.cs
+++ b/Source/ACE.Server.Tests/Vehicles/DericostContinentInvariantsTests.cs
@@ -144,5 +144,53 @@ public void VehicleTerrain_And_PhysicsLandblock_DericostGridSetsBit15AndHeight()
                 LandDefs.LandHeightTable = prevLandHeight;
             }
         }
+
+        [TestMethod]
+        public void LandDefs_And_GetBlockDist_ExcludeBlockCellSentinelAndIndoorEnvCells()
+        {
+            uint derethSentinel = 0x1020_FFFFu;
+            var loc = new Vector3(50.0f, 50.0f, 10.0f);
+            Assert.IsTrue(LandDefs.AdjustToOutside(ref derethSentinel, ref loc));
+            Assert.AreEqual(0x1020_0013u, derethSentinel, "0xFFFF BlockCellID sentinel must stay on Dereth (no bit 15)");
+            Assert.AreEqual(0, ACE.Server.Physics.PhysicsObj.GetBlockDist(0x1020_FFFFu, 0x1020_0001u));
+
+            uint dericostBorder = 0xA690_8025u;
+            var crossLoc = new Vector3(195.0f, 50.0f, 10.0f);
+            Assert.IsTrue(LandDefs.AdjustToOutside(ref dericostBorder, ref crossLoc));
+            Assert.AreEqual(0xA790_8003u, dericostBorder, "Dericost border transition must preserve bit 15");
+            Assert.AreEqual(1000, ACE.Server.Physics.PhysicsObj.GetBlockDist(0xA690_8025u, 0xA690_0025u));
+
+            // High-bit indoor EnvCell (>= 0x100 with bit 15 set) must also stay Dereth.
+            uint highEnvCell = 0x1020_8100u;
+            var envLoc = new Vector3(50.0f, 50.0f, 10.0f);
+            Assert.IsTrue(LandDefs.AdjustToOutside(ref highEnvCell, ref envLoc));
+            Assert.AreEqual(0x1020_0013u, highEnvCell, "Indoor EnvCell >= 0x100 must not be treated as Dericost");
+            Assert.AreEqual(0, ACE.Server.Physics.PhysicsObj.GetBlockDist(0x1020_8100u, 0x1020_0001u));
+        }
+
+        [TestMethod]
+        public void LScape_GetLandblock_NonServerFallback_UsesFFFFNot7FFF()
+        {
+            var prevEng = ACE.Server.Physics.PhysicsEngine.Instance;
+            const uint derethKey = 0x1020_FFFFu;
+            const uint bad7FffKey = 0x1020_7FFFu;
+            bool hadKey = LScape.Landblocks.TryGetValue(derethKey, out var prevLb);
+            try
+            {
+                ACE.Server.Physics.PhysicsEngine.Instance = null;
+                var physLb = new ACE.Server.Physics.Common.Landblock();
+                LScape.Landblocks[derethKey] = physLb;
+                LScape.Landblocks.TryRemove(bad7FffKey, out _);
+
+                var resolved = LScape.get_landblock(0x1020_FFFFu);
+                Assert.AreSame(physLb, resolved, "Non-server LScape.get_landblock must preserve 0xXXYY_FFFF without rewriting to 0xXXYY_7FFF");
+            }
+            finally
+            {
+                if (hadKey) LScape.Landblocks[derethKey] = prevLb;
+                else LScape.Landblocks.TryRemove(derethKey, out _);
+                ACE.Server.Physics.PhysicsEngine.Instance = prevEng;
+            }
+        }
     }
 }
