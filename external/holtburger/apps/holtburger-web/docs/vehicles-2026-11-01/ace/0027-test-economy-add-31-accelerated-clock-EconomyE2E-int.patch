+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using ACE.Database.Models.Shard;
+using ACE.Entity.Enum;
+using ACE.Entity.Models;
+using ACE.Server.Managers;
+using ACE.Server.Vehicles.Deployables;
+using ACE.Server.WorldObjects;
+using static ACE.Server.Tests.EconomyE2E.EconomyE2EReflectionHelpers;
+
+namespace ACE.Server.Tests.EconomyE2E
+{
+    [TestClass]
+    public class PhaseAEconomyE2ETests
+    {
+        private static void ResetEconomyIfPresent(Type econType)
+        {
+            var reset = FindMethod(econType, "ResetForTesting", 0)
+                ?? FindMethod(econType, "ApplyColdStartCutover", 0)
+                ?? FindMethod(econType, "InitializeColdStart", 0)
+                ?? FindMethod(econType, "ResetForColdStart", 0);
+            reset?.Invoke(null, null);
+        }
+
+        private static long ReadTreasuryBalance(object state)
+        {
+            var direct = GetPropOrField(state, "TillPyreals") ?? GetPropOrField(state, "TreasuryPyreals");
+            if (direct != null) return Convert.ToInt64(direct);
+            var control = GetPropOrField(state, "Control");
+            if (control != null)
+            {
+                var nested = GetPropOrField(control, "TreasuryPyreals") ?? GetPropOrField(control, "TillPyreals");
+                if (nested != null) return Convert.ToInt64(nested);
+            }
+            return -1L;
+        }
+
+        private static void SeedTownTillHelper(Type econType, uint townId, long amount)
+        {
+            var setTill = FindMethod(econType, "SeedTownTill", 2) ?? FindMethod(econType, "SetTownTillForTesting", 2);
+            RequireOrInconclusive(setTill, "TownEconomyManager.SeedTownTill / SetTownTillForTesting");
+            setTill.Invoke(null, new object[] { townId, amount });
+        }
+
+        private static void SeedVendorStockHelper(Type econType, uint townId, uint vendorGuid, uint wcid, int qty)
+        {
+            var seed5 = FindMethod(econType, "SeedVendorStock", 5);
+            if (seed5 != null)
+            {
+                seed5.Invoke(null, new object[] { townId, vendorGuid, wcid, qty, (int?)null });
+                return;
+            }
+            var seed3 = FindMethod(econType, "SetVendorStockForTesting", 3) ?? FindMethod(econType, "AddVendorStock", 3);
+            RequireOrInconclusive(seed3, "TownEconomyManager.SeedVendorStock / SetVendorStockForTesting");
+            seed3.Invoke(null, new object[] { townId, wcid, qty });
+        }
+
+        [TestMethod]
+        public void Baseline_PropertyManager_PhysicalEconomyEnabledSwitch()
+        {
+            var defaults = DefaultPropertyManager.DefaultBooleanProperties;
+            RequireTrueOrInconclusive(
+                defaults.TryGetValue("physical_economy_enabled", out var defaultProp),
+                "DefaultPropertyManager.DefaultBooleanProperties missing 'physical_economy_enabled'");
+
+            bool original = defaultProp.Item;
+            // Populate CachedBooleanSettings via ModifyBool BEFORE calling GetBool so standalone
+            // tests never fall through to DatabaseManager.ShardConfig -> ShardDbContext.OnConfiguring.
+            Assert.IsTrue(PropertyManager.ModifyBool("physical_economy_enabled", original));
+            try
+            {
+                Assert.AreEqual(original, PropertyManager.GetBool("physical_economy_enabled").Item);
+                Assert.IsTrue(PropertyManager.ModifyBool("physical_economy_enabled", false));
+                Assert.IsFalse(PropertyManager.GetBool("physical_economy_enabled").Item);
+                Assert.IsTrue(PropertyManager.ModifyBool("physical_economy_enabled", true));
+                Assert.IsTrue(PropertyManager.GetBool("physical_economy_enabled").Item);
+
+                // Negative boundary check: unknown boolean key must be rejected cleanly
+                Assert.IsFalse(PropertyManager.ModifyBool("__nonexistent_economy_e2e_key__", true),
+                    "PropertyManager.ModifyBool must return false for unknown keys");
+            }
+            finally
+            {
+                PropertyManager.ModifyBool("physical_economy_enabled", original);
+                var econType = FindType("ACE.Server.Economy.TownEconomyManager", "ACE.Server.Managers.TownEconomyManager");
+                SetStaticPropOrField(econType, "EnabledOverride", null);
+            }
+        }
+
+        [TestMethod]
+        public void Baseline_DeployableBase_ExcludedFromShardBiotaPersistence()
+        {
+            Assert.IsTrue(typeof(DeployableBase).IsSubclassOf(typeof(WorldObject)));
+            var method = typeof(WorldObject).GetMethod("IsDynamicThatShouldPersistToShard",
+                BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
+            Assert.IsNotNull(method, "WorldObject.IsDynamicThatShouldPersistToShard must exist");
+        }
+
+        [TestMethod]
+        public void F1_ColdStartCutover_ZeroStockAndZeroTill_Across101Towns()
+        {
+            var regType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.TownRegistry", "ACE.Server.Managers.TownRegistry"),
+                "ACE.Server.Economy.TownRegistry");
+            var econType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.TownEconomyManager", "ACE.Server.Managers.TownEconomyManager"),
+                "ACE.Server.Economy.TownEconomyManager");
+
+            var townsMember = FindStaticPropOrField(regType, "Towns", "AllTowns");
+            RequireOrInconclusive(townsMember, "TownRegistry.Towns / AllTowns");
+
+            var towns = ((System.Collections.IEnumerable)ReadMemberValue(townsMember)).Cast<object>().ToList();
+            Assert.AreEqual(101, towns.Count, "Expected exactly 101 towns (60 Dereth + 41 Dericost)");
+
+            var defaults = DefaultPropertyManager.DefaultBooleanProperties;
+            bool origProp = defaults.TryGetValue("physical_economy_enabled", out var dp) && dp.Item;
+            SetStaticPropOrField(econType, "EnabledOverride", true);
+            try
+            {
+                var resetMethod = FindMethod(econType, "ApplyColdStartCutover", 0)
+                    ?? FindMethod(econType, "InitializeColdStart", 0)
+                    ?? FindMethod(econType, "ResetForColdStart", 0)
+                    ?? FindMethod(econType, "ResetForTesting", 0);
+                RequireOrInconclusive(resetMethod, "TownEconomyManager cold-start reset method");
+                resetMethod.Invoke(null, null);
+
+                var getState = FindMethod(econType, "GetTownState", 1) ?? FindMethod(econType, "GetTown", 1);
+                RequireOrInconclusive(getState, "TownEconomyManager.GetTownState(townId)");
+                var getStock = FindMethod(econType, "GetVendorStock", 3);
+
+                foreach (var town in towns)
+                {
+                    var townId = Convert.ToUInt32(GetPropOrField(town, "TownId") ?? GetPropOrField(town, "Id"));
+                    var state = getState.Invoke(null, new object[] { townId });
+                    Assert.IsNotNull(state, $"Missing town state for town {townId}");
+                    Assert.AreEqual(0L, ReadTreasuryBalance(state), $"Day-1 cold start town {townId} till must be 0");
+                    if (getStock != null)
+                    {
+                        var stock = Convert.ToInt32(getStock.Invoke(null, new object[] { townId, 0x80001234u, 273u }));
+                        Assert.AreEqual(0, stock, $"Day-1 cold start town {townId} vendor stock must be 0");
+                    }
+                }
+            }
+            finally
+            {
+                SetStaticPropOrField(econType, "EnabledOverride", null);
+                if (defaults.ContainsKey("physical_economy_enabled"))
+                    PropertyManager.ModifyBool("physical_economy_enabled", origProp);
+            }
+        }
+
+        [TestMethod]
+        public void F2_TownRegistry_ClusteredDereth60_AndDericost41_AndSOI()
+        {
+            var regType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.TownRegistry"),
+                "ACE.Server.Economy.TownRegistry");
+            var townsMember = FindStaticPropOrField(regType, "Towns", "AllTowns");
+            RequireOrInconclusive(townsMember, "TownRegistry.Towns / AllTowns");
+
+            var towns = ((System.Collections.IEnumerable)ReadMemberValue(townsMember)).Cast<object>().ToList();
+            Assert.AreEqual(101, towns.Count, "Expected 101 primary towns");
+
+            int dereth = towns.Count(t => string.Equals(Convert.ToString(GetPropOrField(t, "Continent")), "Dereth", StringComparison.OrdinalIgnoreCase)
+                || Equals(GetPropOrField(t, "ContinentId"), (byte)0));
+            int dericost = towns.Count(t => string.Equals(Convert.ToString(GetPropOrField(t, "Continent")), "Dericost", StringComparison.OrdinalIgnoreCase)
+                || Equals(GetPropOrField(t, "ContinentId"), (byte)1));
+
+            Assert.AreEqual(60, dereth, "Expected 60 Dereth towns");
+            Assert.AreEqual(41, dericost, "Expected 41 Dericost towns");
+
