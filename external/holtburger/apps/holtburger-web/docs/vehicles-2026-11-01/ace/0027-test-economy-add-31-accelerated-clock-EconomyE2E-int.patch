+using System;
+using System.IO;
+using System.Linq;
+using System.Numerics;
+using System.Reflection;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using ACE.Server.Vehicles;
+using ACE.Server.Vehicles.Deployables;
+using static ACE.Server.Tests.EconomyE2E.EconomyE2EReflectionHelpers;
+
+namespace ACE.Server.Tests.EconomyE2E
+{
+    [TestClass]
+    public class PhaseCGeologyColdChainWireE2ETests
+    {
+        [TestMethod]
+        public void F9_VehicleWire_HBV1_V8_AndBaselineHeader()
+        {
+            // Baseline check: HBV1 tag & v7+ header bytes
+            using (var ms = new MemoryStream())
+            using (var bw = new BinaryWriter(ms))
+            {
+                VehicleWire.WriteHeader(bw);
+                ms.Position = 0;
+                using var br = new BinaryReader(ms);
+                var rawTag = br.ReadUInt32();
+                Assert.AreEqual(VehicleWire.Tag, rawTag);
+                ms.Position = 0;
+                var ver = VehicleWire.ReadHeader(br);
+                Assert.IsTrue(ver >= 7, $"Expected HBV1 header version >= 7, got {ver}");
+            }
+
+            // Phase C v8 requirement
+            RequireTrueOrInconclusive(VehicleWire.Version >= 8, "VehicleWire.Version must be bumped to 8 for Phase C");
+            RequireTrueOrInconclusive(
+                typeof(VehicleWire.VehicleLocomotion).GetField("Marine", BindingFlags.Static | BindingFlags.Public) != null,
+                "VehicleLocomotion.Marine = 3 missing");
+        }
+
+        [TestMethod]
+        public void F10_Geology_14Basins_TerrainMapping_AndDepletion()
+        {
+            var geoType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.GeologyService"),
+                "ACE.Server.Economy.GeologyService");
+            var basinsMember = FindStaticPropOrField(geoType, "Basins", "AllBasins");
+            RequireOrInconclusive(basinsMember, "GeologyService.Basins");
+
+            var basins = ((System.Collections.IEnumerable)ReadMemberValue(basinsMember)).Cast<object>().ToList();
+            Assert.AreEqual(14, basins.Count, "Expected exactly 14 subsurface basins (8 Dereth + 6 Dericost)");
+
+            // Verify VehicleTerrain mapping exists (either per-basin or via helper method)
+            var terrainResolver = FindMethod(geoType, "GetBasinForTerrain", 2)
+                ?? FindMethod(geoType, "ResolveTerrainBasin", 2);
+            bool hasPerBasinTerrain = basins.All(b =>
+                GetPropOrField(b, "TerrainCodes") != null ||
+                GetPropOrField(b, "TerrainMask") != null ||
+                GetPropOrField(b, "AllowedTerrains") != null);
+            RequireTrueOrInconclusive(terrainResolver != null || hasPerBasinTerrain,
+                "GeologyService must expose VehicleTerrain mapping per basin");
+
+            // Verify depletion at remaining_tonnes == 0 refuses further extraction
