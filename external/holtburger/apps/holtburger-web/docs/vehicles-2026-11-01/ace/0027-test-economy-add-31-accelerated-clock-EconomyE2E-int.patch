+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Threading;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Enum.Properties;
+using ACE.Entity.Models;
+using ACE.Server.Managers;
+using ACE.Server.Network.Sequence;
+using ACE.Server.WorldObjects;
+using ACE.Server.WorldObjects.Managers;
+
+namespace ACE.Server.Tests.EconomyE2E
+{
+    internal static class EconomyE2EReflectionHelpers
+    {
+        private static uint _nextGuid = 0x79000001u;
+
+        public static bool IsStrictMode =>
+            string.Equals(Environment.GetEnvironmentVariable("ECONOMY_E2E_STRICT"), "1", StringComparison.Ordinal);
+
+        public static T RequireOrInconclusive<T>(T value, string missingDetail) where T : class
+        {
+            if (value != null)
+                return value;
+
+            var msg = $"[EconomyE2E] Target not yet implemented: {missingDetail}";
+            if (IsStrictMode)
+                Assert.Fail(msg);
+            else
+                Assert.Inconclusive(msg);
+
+            return null;
+        }
+
+        public static void RequireTrueOrInconclusive(bool condition, string missingDetail)
+        {
+            if (condition)
+                return;
+
+            var msg = $"[EconomyE2E] Target not yet implemented: {missingDetail}";
+            if (IsStrictMode)
+                Assert.Fail(msg);
+            else
+                Assert.Inconclusive(msg);
+        }
+
+        /// <summary>
+        /// Strict bool invocation helper: refuses void or non-bool return types so
+        /// Convert.ToBoolean(null) can never silently return false and produce a false pass.
+        /// </summary>
+        public static bool InvokeBool(MethodInfo m, object instance, params object[] args)
+        {
+            Assert.IsNotNull(m, "[EconomyE2E] InvokeBool received null MethodInfo");
+            Assert.AreEqual(
+                typeof(bool),
+                m.ReturnType,
+                $"[EconomyE2E] Expected bool return type on {m.DeclaringType?.Name}.{m.Name}, got {m.ReturnType.Name}");
+            var res = m.Invoke(instance, args);
+            Assert.IsTrue(
+                res is bool,
+                $"[EconomyE2E] Expected bool return value from {m.DeclaringType?.Name}.{m.Name}, got {res?.GetType().Name ?? "null"}");
+            return (bool)res;
+        }
+
+        public static bool GetBoolPropOrField(object instance, string name)
+        {
+            var val = GetPropOrField(instance, name);
+            Assert.IsTrue(
+                val is bool,
+                $"[EconomyE2E] Expected bool property/field '{name}' on {instance?.GetType().Name ?? "null"}, got {val?.GetType().Name ?? "null"}");
+            return (bool)val;
+        }
+
+        public static Type FindType(params string[] candidateFullNames)
+        {
+            var assemblies = new List<Assembly>
+            {
+                typeof(PropertyManager).Assembly,
+                typeof(ACE.Database.Models.Shard.ShardDbContext).Assembly,
+                typeof(ObjectGuid).Assembly,
+                typeof(ACE.Common.ConfigManager).Assembly,
+            };
+            foreach (var asm in AppDomain.CurrentDomain.GetAssemblies())
+            {
+                if (!assemblies.Contains(asm))
+                    assemblies.Add(asm);
+            }
+
+            foreach (var name in candidateFullNames)
+            {
+                if (string.IsNullOrWhiteSpace(name)) continue;
+                var direct = Type.GetType(name, throwOnError: false);
+                if (direct != null) return direct;
+
+                foreach (var asm in assemblies)
+                {
+                    var t = asm.GetType(name, throwOnError: false);
+                    if (t != null) return t;
+                }
+            }
+            return null;
+        }
+
+        public static object GetPropOrField(object instance, string name)
+        {
+            if (instance == null) return null;
+            var t = instance.GetType();
+            const BindingFlags flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+            var prop = t.GetProperty(name, flags);
+            if (prop != null) return prop.GetValue(instance);
+            var field = t.GetField(name, flags);
+            if (field != null) return field.GetValue(instance);
+            return null;
+        }
+
+        public static bool SetPropOrField(object instance, string name, object value)
+        {
+            if (instance == null) return false;
+            var t = instance.GetType();
+            const BindingFlags flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+            var prop = t.GetProperty(name, flags);
+            if (prop != null && prop.CanWrite)
+            {
+                prop.SetValue(instance, value);
+                return true;
+            }
+            var field = t.GetField(name, flags);
+            if (field != null)
+            {
+                field.SetValue(instance, value);
+                return true;
+            }
+            return false;
+        }
+
+        public static MemberInfo FindStaticPropOrField(Type type, params string[] names)
+        {
+            if (type == null) return null;
+            const BindingFlags flags = BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
+            foreach (var name in names)
+            {
+                var prop = type.GetProperty(name, flags);
+                if (prop != null) return prop;
+                var field = type.GetField(name, flags);
+                if (field != null) return field;
+            }
+            return null;
+        }
+
+        public static object ReadMemberValue(MemberInfo member, object instance = null) => member switch
+        {
+            PropertyInfo p => p.GetValue(instance),
+            FieldInfo f => f.GetValue(instance),
+            _ => null,
+        };
+
+        public static object GetStaticPropOrField(Type type, string name)
+        {
+            if (type == null) return null;
+            const BindingFlags flags = BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
+            var prop = type.GetProperty(name, flags);
+            if (prop != null) return prop.GetValue(null);
+            var field = type.GetField(name, flags);
+            if (field != null) return field.GetValue(null);
+            return null;
+        }
+
+        public static bool SetStaticPropOrField(Type type, string name, object value)
+        {
+            if (type == null) return false;
+            const BindingFlags flags = BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
+            var prop = type.GetProperty(name, flags);
+            if (prop != null && prop.CanWrite)
+            {
+                prop.SetValue(null, value);
+                return true;
+            }
+            var field = type.GetField(name, flags);
+            if (field != null)
+            {
+                field.SetValue(null, value);
+                return true;
+            }
+            return false;
+        }
+
+        public static MethodInfo FindMethod(Type type, string name, int? argCount = null)
+        {
+            if (type == null) return null;
+            const BindingFlags flags = BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
+            return type.GetMethods(flags)
+                .FirstOrDefault(m => m.Name == name && (!argCount.HasValue || m.GetParameters().Length == argCount.Value));
+        }
+
+        public static uint AllocTestGuid() => Interlocked.Increment(ref _nextGuid);
+
+        public static void InitWorldObjectFields(WorldObject wo, uint guid, uint wcid, Biota biota, uint cellId, float x = 20f, float y = 20f, float z = 10f)
+        {
+            typeof(WorldObject).GetField("<Guid>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(wo, new ObjectGuid(guid));
+            typeof(WorldObject).GetField("<WeenieClassId>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(wo, wcid);
+            typeof(WorldObject).GetField("<Biota>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(wo, biota);
+            typeof(WorldObject).GetField("ephemeralPositions", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(wo, new Dictionary<PositionType, Position>());
+            typeof(WorldObject).GetField("positionCache", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(wo, new Dictionary<PositionType, Position>());
+            typeof(WorldObject).GetField("BiotaDatabaseLock", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.SetValue(wo, new ReaderWriterLockSlim());
+            typeof(WorldObject).GetField("<Sequences>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(wo, new SequenceManager());
+            wo.EnchantmentManager = new EnchantmentManagerWithCaching(wo);
+            wo.Location = new Position(cellId, x, y, z, 0, 0, 0, 1);
+        }
+
+        public static Player CreateTestPlayer(uint guid, uint landblockCellId, float x, float y, float z, uint monarchId = 0)
+        {
+            var player = (Player)RuntimeHelpers.GetUninitializedObject(typeof(Player));
+            var biota = new Biota
+            {
+                Id = guid,
+                WeenieClassId = 1,
+                WeenieType = WeenieType.Creature,
+                PropertiesPosition = new Dictionary<PositionType, PropertiesPosition>(),
+                PropertiesInt = new Dictionary<PropertyInt, int>(),
+                PropertiesInt64 = new Dictionary<PropertyInt64, long>(),
+                PropertiesFloat = new Dictionary<PropertyFloat, double>(),
+                PropertiesBool = new Dictionary<PropertyBool, bool>(),
+                PropertiesDID = new Dictionary<PropertyDataId, uint>(),
+                PropertiesString = new Dictionary<PropertyString, string> { [PropertyString.Name] = $"E2EPlayer_{guid:X}" },
+                PropertiesAttribute = new Dictionary<PropertyAttribute, PropertiesAttribute>(),
+                PropertiesEnchantmentRegistry = new List<PropertiesEnchantmentRegistry>(),
+                PropertiesCreateList = new List<PropertiesCreateList>(),
+                PropertiesEmote = new List<PropertiesEmote>(),
+            };
+
+            InitWorldObjectFields(player, guid, 1, biota, landblockCellId, x, y, z);
+            if (monarchId != 0)
+                player.MonarchId = monarchId;
+
+            return player;
+        }
+
+        public static Vendor CreateTestVendor(uint wcid, uint cellId, string name = "E2E Vendor", uint? altCurrency = null)
+        {
+            var guid = AllocTestGuid();
+            var vendor = (Vendor)RuntimeHelpers.GetUninitializedObject(typeof(Vendor));
+            var biota = new Biota
+            {
+                Id = guid,
+                WeenieClassId = wcid,
+                WeenieType = WeenieType.Vendor,
+                PropertiesInt = new Dictionary<PropertyInt, int>
+                {
+                    [PropertyInt.MerchandiseItemTypes] = (int)(ItemType.MeleeWeapon | ItemType.PromissoryNote | ItemType.Armor | ItemType.Gem | ItemType.Food | ItemType.Misc),
+                    [PropertyInt.MerchandiseMinValue] = 0,
+                    [PropertyInt.MerchandiseMaxValue] = 1_000_000,
+                },
+                PropertiesInt64 = new Dictionary<PropertyInt64, long>(),
+                PropertiesFloat = new Dictionary<PropertyFloat, double>
+                {
+                    [PropertyFloat.BuyPrice] = 0.5,
+                    [PropertyFloat.SellPrice] = 1.0,
+                },
+                PropertiesBool = new Dictionary<PropertyBool, bool>(),
+                PropertiesDID = new Dictionary<PropertyDataId, uint>(),
+                PropertiesString = new Dictionary<PropertyString, string> { [PropertyString.Name] = name },
+                PropertiesPosition = new Dictionary<PositionType, PropertiesPosition>(),
+            };
+            if (altCurrency.HasValue)
+                biota.PropertiesDID[PropertyDataId.AlternateCurrency] = altCurrency.Value;
+
+            InitWorldObjectFields(vendor, guid, wcid, biota, cellId);
+            typeof(Vendor).GetField("DefaultItemsForSale", BindingFlags.Instance | BindingFlags.Public)?.SetValue(vendor, new Dictionary<ObjectGuid, WorldObject>());
+            typeof(Vendor).GetField("UniqueItemsForSale", BindingFlags.Instance | BindingFlags.Public)?.SetValue(vendor, new Dictionary<ObjectGuid, WorldObject>());
+            return vendor;
+        }
+
+        public static SlumLord CreateTestSlumlord(uint cellId, string name = "E2E Slumlord")
+        {
+            var guid = AllocTestGuid();
+            var slumlord = (SlumLord)RuntimeHelpers.GetUninitializedObject(typeof(SlumLord));
+            var biota = new Biota
+            {
+                Id = guid,
+                WeenieClassId = 9550,
+                WeenieType = WeenieType.SlumLord,
+                PropertiesInt = new Dictionary<PropertyInt, int>(),
+                PropertiesInt64 = new Dictionary<PropertyInt64, long>(),
+                PropertiesFloat = new Dictionary<PropertyFloat, double>(),
+                PropertiesBool = new Dictionary<PropertyBool, bool>(),
+                PropertiesDID = new Dictionary<PropertyDataId, uint>(),
+                PropertiesString = new Dictionary<PropertyString, string> { [PropertyString.Name] = name },
+                PropertiesPosition = new Dictionary<PositionType, PropertiesPosition>(),
+            };
+            InitWorldObjectFields(slumlord, guid, 9550, biota, cellId);
+            return slumlord;
+        }
+
+        public static WorldObject CreateTestItem(
+            uint wcid,
+            WeenieType weenieType,
+            ItemType itemType,
+            int value,
+            int stackSize = 1,
+            int? maxStack = null,
+            string name = "E2EItem",
+            uint? spellDid = null,
+            bool vendorService = false,
+            uint cellId = 0xA9B40001u)
+        {
+            var guid = AllocTestGuid();
+            var concreteType = maxStack.HasValue ? typeof(Stackable) : typeof(GenericObject);
+            var wo = (WorldObject)RuntimeHelpers.GetUninitializedObject(concreteType);
+            var biota = new Biota
+            {
+                Id = guid,
+                WeenieClassId = wcid,
+                WeenieType = weenieType,
+                PropertiesInt = new Dictionary<PropertyInt, int>
+                {
+                    [PropertyInt.ItemType] = (int)itemType,
+                    [PropertyInt.Value] = value * stackSize,
+                },
+                PropertiesInt64 = new Dictionary<PropertyInt64, long>(),
+                PropertiesFloat = new Dictionary<PropertyFloat, double>(),
+                PropertiesBool = new Dictionary<PropertyBool, bool>(),
+                PropertiesDID = new Dictionary<PropertyDataId, uint>(),
+                PropertiesString = new Dictionary<PropertyString, string>
+                {
+                    [PropertyString.Name] = name,
+                    [PropertyString.PluralName] = name + "s",
+                },
+                PropertiesPosition = new Dictionary<PositionType, PropertiesPosition>(),
+            };
+
+            if (maxStack.HasValue)
+            {
+                biota.PropertiesInt[PropertyInt.MaxStackSize] = maxStack.Value;
+                biota.PropertiesInt[PropertyInt.StackSize] = stackSize;
+                biota.PropertiesInt[PropertyInt.StackUnitValue] = value;
+            }
+            if (spellDid.HasValue)
+                biota.PropertiesDID[PropertyDataId.Spell] = spellDid.Value;
+            if (vendorService)
+                biota.PropertiesBool[PropertyBool.VendorService] = true;
+
+            InitWorldObjectFields(wo, guid, wcid, biota, cellId);
+            return wo;
+        }
+    }
+}
