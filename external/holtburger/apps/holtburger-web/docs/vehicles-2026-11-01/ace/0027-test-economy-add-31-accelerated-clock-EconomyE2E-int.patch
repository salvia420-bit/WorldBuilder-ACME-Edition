+                    Assert.AreEqual(50_000L, ReadTreasuryBalance(getState.Invoke(null, new object[] { 1u })),
+                        "100% of overworld Slumlord rent must route into controlling Town Treasury");
+
+                    var aptSlum = CreateTestSlumlord(0x53600100u, "Sanctum Apartment Slumlord");
+                    var aptPayments = new List<(uint, ItemType?, long, int)>
+                    {
+                        (273u, ItemType.Money, 1L, 10_000),
+                    };
+                    recordSlumlord.Invoke(null, new object[] { aptSlum, aptPayments, "house_rent" });
+                    Assert.AreEqual(10_000L, ReadTreasuryBalance(getState.Invoke(null, new object[] { 6u })),
+                        "100% of Sanctum apartment Slumlord rent must route into Cragstone Treasury");
+                }
+                else
+                {
+                    var routeRent = FindMethod(econType, "RouteSlumlordPyreals", 2);
+                    RequireOrInconclusive(routeRent, "TownEconomyManager.RecordSlumlordPayment / RouteSlumlordPyreals");
+                    SeedTownTillHelper(econType, 1u, 0L);
+                    routeRent.Invoke(null, new object[] { 0xA9B4u, 50_000L });
+                    Assert.AreEqual(50_000L, ReadTreasuryBalance(getState.Invoke(null, new object[] { 1u })),
+                        "100% of Slumlord rent must route into controlling Town Treasury");
+                }
+
+                // 2. Trophy Collector procurement conversion & infinite coin minting block
+                var isRepeatable = FindMethod(econType, "IsRepeatableCoinEmote", 3);
+                var setBounty = FindMethod(econType, "SetProcurementBounty", 5);
+                var tryTrophy5 = FindMethod(econType, "TryHandleTrophyTurnIn", 5);
+                var tryTrophy = tryTrophy5 ?? FindMethod(econType, "TryHandleTrophyTurnIn", 4);
+                RequireOrInconclusive(isRepeatable, "TownEconomyManager.IsRepeatableCoinEmote");
+                RequireOrInconclusive(setBounty, "TownEconomyManager.SetProcurementBounty");
+                RequireOrInconclusive(tryTrophy, "TownEconomyManager.TryHandleTrophyTurnIn");
+
+                object[] MakeTrophyArgs(WorldObject c, WorldObject t) => tryTrophy5 != null
+                    ? new object[] { c, t, 0L, null, 1 }
+                    : new object[] { c, t, 0L, null };
+
+                var repeatableSet = new PropertiesEmote
+                {
+                    Category = EmoteCategory.Give,
+                    Quest = null,
+                    PropertiesEmoteAction = new List<PropertiesEmoteAction>
+                    {
+                        new() { Type = (uint)EmoteType.Give, WeenieClassId = 273, StackSize = 500 },
+                    },
+                };
+                Assert.IsTrue(InvokeBool(isRepeatable, null, new object[] { repeatableSet, 0u, 0 }),
+                    "Repeatable Quest==null coin emote must be detected");
+
+                var collector = CreateTestItem(3917u, WeenieType.Creature, ItemType.None, 0, name: "Trophy Collector", cellId: 0xA9B40001u);
+                var trophy = CreateTestItem(4500u, WeenieType.Generic, ItemType.Misc, 50, name: "Gromnie Hide", cellId: 0xA9B40001u);
+
+                // Without active Monarch bounty -> must fail (no coin minting)
+                Assert.IsFalse(InvokeBool(tryTrophy, null, MakeTrophyArgs(collector, trophy)),
+                    "Un-bountied repeatable Trophy turn-in must be blocked");
+
+                // With active bounty > Town Till -> must refuse payout
+                SeedTownTillHelper(econType, 1u, 100L);
+                setBounty.Invoke(null, new object[] { 1u, trophy.WeenieClassId, "raw_hide", 250L, 2 });
+                Assert.IsFalse(InvokeBool(tryTrophy, null, MakeTrophyArgs(collector, trophy)),
+                    "Trophy Collector bounty MUST refuse payout when Town Till < RewardPyreals");
+
+                // With sufficient Town Till -> pays from till and deposits into warehouse
+                SeedTownTillHelper(econType, 1u, 1_000L);
+                var turnInArgs = MakeTrophyArgs(collector, trophy);
+                Assert.IsTrue(InvokeBool(tryTrophy, null, turnInArgs),
+                    "Trophy Collector bounty with funded Town Till must succeed");
+                Assert.AreEqual(250L, Convert.ToInt64(turnInArgs[2]));
+                Assert.AreEqual(750L, ReadTreasuryBalance(getState.Invoke(null, new object[] { 1u })));
+            }
+            finally
+            {
+                SetStaticPropOrField(econType, "EnabledOverride", null);
+                ResetEconomyIfPresent(econType);
+            }
+        }
+    }
+}
diff --git a/Source/ACE.Server.Tests/EconomyE2E/PhaseBSiegeE2ETests.cs b/Source/ACE.Server.Tests/EconomyE2E/PhaseBSiegeE2ETests.cs
