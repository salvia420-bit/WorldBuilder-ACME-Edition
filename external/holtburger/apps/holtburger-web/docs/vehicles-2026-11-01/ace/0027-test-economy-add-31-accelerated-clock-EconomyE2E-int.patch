+using System;
+using System.Reflection;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using ACE.Server.Vehicles;
+using ACE.Server.Vehicles.AirDefense;
+using ACE.Server.Vehicles.Deployables;
+using static ACE.Server.Tests.EconomyE2E.EconomyE2EReflectionHelpers;
+
+namespace ACE.Server.Tests.EconomyE2E
+{
+    [TestClass]
+    public class PhaseBSiegeE2ETests
+    {
+        [TestMethod]
+        public void F6_TownControl_SiegeEntities_WcidsAndKinds()
+        {
+            var kindType = typeof(DeployableKind);
+            RequireTrueOrInconclusive(Enum.IsDefined(kindType, 56u), "DeployableKind 56 (TownControlNode) not yet defined");
+            RequireTrueOrInconclusive(Enum.IsDefined(kindType, 57u), "DeployableKind 57 (TownDepotApron) not yet defined");
+            RequireTrueOrInconclusive(Enum.IsDefined(kindType, 58u), "DeployableKind 58 (ForwardSiegeBeacon) not yet defined");
+
+            var siegeType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.SiegeManager"),
+                "ACE.Server.Economy.SiegeManager");
+            var ringCheck = FindMethod(siegeType, "IsWithinControlRing", 1)
+                ?? FindMethod(siegeType, "IsInsideControlRadius", 1);
+            RequireOrInconclusive(ringCheck, "SiegeManager.IsWithinControlRing(distanceM)");
+
+            Assert.IsTrue(InvokeBool(ringCheck, null, 30.0f), "30.0m must be inside control ring");
+            Assert.IsFalse(InvokeBool(ringCheck, null, 30.1f), "30.1m must be outside control ring");
+        }
+
+        [TestMethod]
+        public void F7_SiegeEngine_ZeroNotice_And300sBreachGate()
+        {
+            var siegeType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.SiegeManager"),
+                "ACE.Server.Economy.SiegeManager");
+            var startAssault = FindMethod(siegeType, "BeginZeroNoticeBreachForTesting", 3);
+            var tick = FindMethod(siegeType, "TickForTesting", 1);
+            var getSiege = FindMethod(siegeType, "GetSiegeState", 1);
+            RequireOrInconclusive(startAssault, "SiegeManager.BeginZeroNoticeBreachForTesting(townId, attackerMonarchId, treasuryPyreals)");
+            RequireOrInconclusive(tick, "SiegeManager.TickForTesting(deltaSeconds)");
+            RequireOrInconclusive(getSiege, "SiegeManager.GetSiegeState(townId)");
+
+            startAssault.Invoke(null, new object[] { 10u, 200u, 100000L });
+            tick.Invoke(null, new object[] { 299.0 });
+            var s299 = getSiege.Invoke(null, new object[] { 10u });
+            Assert.AreNotEqual("CONTESTED_HOLD", Convert.ToString(GetPropOrField(s299, "State")),
+                "At 299s breach gate must NOT yet enter CONTESTED_HOLD");
+
+            tick.Invoke(null, new object[] { 1.0 });
+            var s300 = getSiege.Invoke(null, new object[] { 10u });
+            Assert.AreEqual("CONTESTED_HOLD", Convert.ToString(GetPropOrField(s300, "State")),
+                "At 300s breach gate MUST enter CONTESTED_HOLD");
+            Assert.AreEqual(100000L, Convert.ToInt64(GetPropOrField(s300, "EscrowPyreals")),
+                "Entering CONTESTED_HOLD must freeze Defender Treasury into escrow_pyreals");
+        }
+
+        [TestMethod]
+        public void F7_SiegeEngine_AcceleratedClock_28800sHold_AndRolling5400sSupplyMeter()
+        {
+            var siegeType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.SiegeManager"),
+                "ACE.Server.Economy.SiegeManager");
+            var setupHold = FindMethod(siegeType, "BeginContestedHoldForTesting", 4);
+            var deliver = FindMethod(siegeType, "DeliverSiegeSupplyForTesting", 4);
+            var tick = FindMethod(siegeType, "TickForTesting", 1);
+            var getSiege = FindMethod(siegeType, "GetSiegeState", 1);
+            RequireOrInconclusive(setupHold, "SiegeManager.BeginContestedHoldForTesting(townId, defenderMonarch, attackerMonarch, treasuryPyreals)");
+            RequireOrInconclusive(deliver, "SiegeManager.DeliverSiegeSupplyForTesting(townId, originLandblockId, distanceM, supplyPoints)");
+            RequireOrInconclusive(tick, "SiegeManager.TickForTesting(deltaSeconds)");
+            RequireOrInconclusive(getSiege, "SiegeManager.GetSiegeState(townId)");
+
+            // Verify TownTier Supply Meter drain rates (40 Village / 100 RegionalHub / 200 CapitalPort SP/hr)
+            var regType = RequireOrInconclusive(FindType("ACE.Server.Economy.TownRegistry"), "TownRegistry");
+            var drainMethod = FindMethod(siegeType, "GetSupplyDrainPerHour", 1) ?? FindMethod(regType, "GetSupplyDrainPerHour", 1);
+            RequireOrInconclusive(drainMethod, "GetSupplyDrainPerHour(TownTier)");
+            var tierEnum = FindType("ACE.Server.Economy.TownTier");
+            RequireOrInconclusive(tierEnum, "ACE.Server.Economy.TownTier");
+            Assert.AreEqual(40, Convert.ToInt32(drainMethod.Invoke(null, new[] { Enum.Parse(tierEnum, "Village") })), "Village drain must be 40 SP/hr");
+            Assert.AreEqual(100, Convert.ToInt32(drainMethod.Invoke(null, new[] { Enum.Parse(tierEnum, "RegionalHub") })), "RegionalHub drain must be 100 SP/hr");
+            Assert.AreEqual(200, Convert.ToInt32(drainMethod.Invoke(null, new[] { Enum.Parse(tierEnum, "CapitalPort") })), "CapitalPort drain must be 200 SP/hr");
+
+            uint townId = 11u; // Qalaba'r (RegionalHub) or Capital/Village
+            setupHold.Invoke(null, new object[] { townId, 100u, 200u, 50000L });
+
+            // Verify rolling 5,400 s (90-min) Supply Meter cap even with huge delivery
+            Assert.IsTrue(InvokeBool(deliver, null, townId, 0xB000u, 1500.0, 10000.0));
+            var cappedState = getSiege.Invoke(null, new object[] { townId });
+            double meterSec = Convert.ToDouble(GetPropOrField(cappedState, "SupplyMeterSec"));
+            Assert.IsTrue(meterSec > 0.0 && meterSec <= 5400.0,
+                $"Rolling Supply Meter MUST cap at 5,400s (90m), got {meterSec}");
+
+            // Reset & advance 28,800s across 8 rolling 1-hour supply deliveries (>= 1,500m provenance)
+            setupHold.Invoke(null, new object[] { townId, 100u, 200u, 50000L });
+            for (int hr = 0; hr < 7; hr++)
+            {
+                Assert.IsTrue(InvokeBool(deliver, null, townId, 0xB000u, 1500.0, 200.0));
+                tick.Invoke(null, new object[] { 3600.0 });
+            }
+            Assert.IsTrue(InvokeBool(deliver, null, townId, 0xB000u, 1500.0, 200.0));
+            tick.Invoke(null, new object[] { 3599.0 });
+
+            var preFlip = getSiege.Invoke(null, new object[] { townId });
+            Assert.AreEqual(100u, Convert.ToUInt32(GetPropOrField(preFlip, "OwnerMonarchId")),
+                "At 28,799s town must still belong to defender");
+
+            tick.Invoke(null, new object[] { 1.0 });
+            var flipped = getSiege.Invoke(null, new object[] { townId });
+            Assert.AreEqual(200u, Convert.ToUInt32(GetPropOrField(flipped, "OwnerMonarchId")),
+                "At 28,800s town must flip to attacker");
+            Assert.AreEqual(25000L, Convert.ToInt64(GetPropOrField(flipped, "AttackerSpoilsPyreals")),
+                "Attacker must receive 50/50 vault spoils");
+        }
+
+        [TestMethod]
+        public void F7_SiegeEngine_OriginProvenance_1499mRejected_1500mAccepted()
+        {
+            var siegeType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.SiegeManager"),
+                "ACE.Server.Economy.SiegeManager");
+            var deliver = FindMethod(siegeType, "DeliverSiegeSupplyForTesting", 4);
+            RequireOrInconclusive(deliver, "SiegeManager.DeliverSiegeSupplyForTesting");
+
+            Assert.IsFalse(InvokeBool(deliver, null, 12u, 0xA9B4u, 1499.0, 100.0),
+                "Origin provenance < 1,500m (1,499m) MUST be rejected");
+            Assert.IsTrue(InvokeBool(deliver, null, 12u, 0xB000u, 1500.0, 100.0),
+                "Origin provenance == 1,500m MUST be accepted");
+        }
+
+        [TestMethod]
+        public void F7_SiegeEngine_StarvationCollapse_1800s_And3600sCooldown()
+        {
+            var siegeType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.SiegeManager"),
+                "ACE.Server.Economy.SiegeManager");
+            var setupHold = FindMethod(siegeType, "BeginContestedHoldForTesting", 4);
+            var setMeter = FindMethod(siegeType, "SetSupplyMeterForTesting", 2);
+            var tick = FindMethod(siegeType, "TickForTesting", 1);
+            var getSiege = FindMethod(siegeType, "GetSiegeState", 1);
+            RequireOrInconclusive(setupHold, "SiegeManager.BeginContestedHoldForTesting");
+            RequireOrInconclusive(setMeter, "SiegeManager.SetSupplyMeterForTesting(townId, seconds)");
+            RequireOrInconclusive(tick, "SiegeManager.TickForTesting");
+            RequireOrInconclusive(getSiege, "SiegeManager.GetSiegeState");
+
+            uint townId = 13u;
+            setupHold.Invoke(null, new object[] { townId, 100u, 200u, 20000L });
+            setMeter.Invoke(null, new object[] { townId, 0.0 });
+            tick.Invoke(null, new object[] { 1799.0 });
+            var s1799 = getSiege.Invoke(null, new object[] { townId });
+            Assert.AreEqual("STARVING", Convert.ToString(GetPropOrField(s1799, "State")));
+
+            tick.Invoke(null, new object[] { 1.0 });
+            var s1800 = getSiege.Invoke(null, new object[] { townId });
+            Assert.AreEqual("CONTROLLED", Convert.ToString(GetPropOrField(s1800, "State")),
+                "1,800s starvation must collapse siege back to CONTROLLED");
+            Assert.IsTrue(Convert.ToDouble(GetPropOrField(s1800, "AttackerCooldownRemainingSec")) >= 3599.0,
+                "Starvation collapse must impose 3,600s attacker cooldown");
+        }
+
+        [TestMethod]
+        public void F7_SiegeEngine_ThreeWayReset_And72hInsolvencyReceivership()
+        {
+            var siegeType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.SiegeManager"),
+                "ACE.Server.Economy.SiegeManager");
+            var setupHold = FindMethod(siegeType, "BeginContestedHoldForTesting", 4);
+            var deliver = FindMethod(siegeType, "DeliverSiegeSupplyForTesting", 4);
+            var tick = FindMethod(siegeType, "TickForTesting", 1);
+            var threeWay = FindMethod(siegeType, "TriggerThreeWayResetForTesting", 2)
+                ?? FindMethod(siegeType, "ContestThreeWayForTesting", 2);
+            var tickInsolvency = FindMethod(siegeType, "AdvanceInsolvencyForTesting", 2);
+            var getSiege = FindMethod(siegeType, "GetSiegeState", 1);
+            RequireOrInconclusive(setupHold, "SiegeManager.BeginContestedHoldForTesting");
+            RequireOrInconclusive(tick, "SiegeManager.TickForTesting");
+            RequireOrInconclusive(threeWay, "SiegeManager.TriggerThreeWayResetForTesting(townId, newAttackerMonarchId)");
+            RequireOrInconclusive(tickInsolvency, "SiegeManager.AdvanceInsolvencyForTesting(townId, elapsedSeconds)");
+            RequireOrInconclusive(getSiege, "SiegeManager.GetSiegeState");
+
+            // 1. Three-way siege reset must zero the 28,800s hold clock
+            uint townId = 14u;
+            setupHold.Invoke(null, new object[] { townId, 100u, 200u, 40000L });
+            if (deliver != null)
+                deliver.Invoke(null, new object[] { townId, 0xB000u, 1500.0, 200.0 });
+            tick.Invoke(null, new object[] { 3600.0 });
+            var beforeReset = getSiege.Invoke(null, new object[] { townId });
+            Assert.IsTrue(Convert.ToDouble(GetPropOrField(beforeReset, "HoldElapsedSec")) >= 3600.0);
+
+            threeWay.Invoke(null, new object[] { townId, 300u });
+            var afterReset = getSiege.Invoke(null, new object[] { townId });
+            Assert.AreEqual(0.0, Convert.ToDouble(GetPropOrField(afterReset, "HoldElapsedSec")), 0.001,
+                "Three-way siege contention MUST reset HoldElapsedSec clock to 0");
+            Assert.AreEqual(300u, Convert.ToUInt32(GetPropOrField(afterReset, "AttackerMonarchId")));
+
+            // 2. Insolvency boundary: 259,199s (<72h) vs 259,200s (72h) and 86,399s (<24h) vs 86,400s (+24h)
+            uint insolvTown = 15u;
+            tickInsolvency.Invoke(null, new object[] { insolvTown, 259199.0 }); // 72h - 1s
+            var s72Minus1 = getSiege.Invoke(null, new object[] { insolvTown });
+            Assert.AreNotEqual("INSOLVENT_RECEIVERSHIP", Convert.ToString(GetPropOrField(s72Minus1, "State")),
+                "At 259,199s (<72h) town must NOT yet enter INSOLVENT_RECEIVERSHIP");
+
+            tickInsolvency.Invoke(null, new object[] { insolvTown, 1.0 }); // exactly 72h (259,200s)
+            var s72 = getSiege.Invoke(null, new object[] { insolvTown });
+            Assert.AreEqual("INSOLVENT_RECEIVERSHIP", Convert.ToString(GetPropOrField(s72, "State")));
+
+            tickInsolvency.Invoke(null, new object[] { insolvTown, 86399.0 }); // +24h - 1s
+            var s96Minus1 = getSiege.Invoke(null, new object[] { insolvTown });
+            Assert.AreEqual("INSOLVENT_RECEIVERSHIP", Convert.ToString(GetPropOrField(s96Minus1, "State")),
+                "At 86,399s (<24h grace) town must stay in INSOLVENT_RECEIVERSHIP");
+
+            tickInsolvency.Invoke(null, new object[] { insolvTown, 1.0 }); // +24h grace complete
+            var s96 = getSiege.Invoke(null, new object[] { insolvTown });
+            Assert.AreEqual("UNCLAIMED_COLD", Convert.ToString(GetPropOrField(s96, "State")));
+        }
+
+        [TestMethod]
+        public void F8_Governance_MonarchOnlyPolicies_FlatMemberExecution_AndRadarIff()
+        {
+            // Baseline verified right now: GuildRadarPolicy & RadarIff
+            RadarIff.ResetPolicies();
+            var policy = RadarIff.GetOrCreateMonarchPolicy(100u);
+            policy.SetStanding(200u, IffStanding.Hostile);
+            Assert.AreEqual(IffStanding.Hostile, policy.GetStanding(200u));
+
+            var cmdType = RequireOrInconclusive(
+                FindType("ACE.Server.Command.Handlers.TownCommands", "ACE.Server.Economy.TownGovernance"),
+                "ACE.Server.Command.Handlers.TownCommands");
+            var canPolicy = FindMethod(cmdType, "CanModifyTownPolicy", 2);
+            RequireOrInconclusive(canPolicy, "TownCommands.CanModifyTownPolicy(player, townId)");
+
+            var econType = RequireOrInconclusive(FindType("ACE.Server.Economy.TownEconomyManager"), "TownEconomyManager");
+            var setOwner = FindMethod(econType, "SetTownOwner", 3);
+            RequireOrInconclusive(setOwner, "TownEconomyManager.SetTownOwner");
+            setOwner.Invoke(null, new object[] { 1u, 100u, "CONTROLLED" });
+
+            var monarch = CreateTestPlayer(100u, 0xA9B40001u, 20f, 20f, 10f, monarchId: 100u);
+            var vassal = CreateTestPlayer(101u, 0xA9B40001u, 25f, 20f, 10f, monarchId: 100u);
+            var outsider = CreateTestPlayer(200u, 0xA9B40001u, 30f, 20f, 10f, monarchId: 200u);
+
+            Assert.IsTrue(InvokeBool(canPolicy, null, monarch, 1u),
+                "Owning Monarch MUST be permitted to modify @town policies");
+            Assert.IsFalse(InvokeBool(canPolicy, null, vassal, 1u),
+                "Non-Monarch sworn vassal MUST be rejected from @town policy mutations");
+            Assert.IsFalse(InvokeBool(canPolicy, null, outsider, 1u),
+                "Foreign Monarch MUST be rejected from @town policy mutations");
+
+            var canExec = FindMethod(cmdType, "CanExecuteTownLogistics", 2)
+                ?? FindMethod(cmdType, "CanExecuteSwornOperations", 2);
+            if (canExec != null)
+            {
+                Assert.IsTrue(InvokeBool(canExec, null, vassal, 1u),
+                    "Sworn Allegiance vassal MUST retain flat logistics/siege execution rights");
+                Assert.IsFalse(InvokeBool(canExec, null, outsider, 1u),
+                    "Foreign non-allegiance player MUST NOT execute owning guild ops");
+            }
+        }
+
+        [TestMethod]
+        public void Baseline_RadarIff_PolicyResolution_Works()
+        {
+            RadarIff.ResetPolicies();
+            var policy = RadarIff.GetOrCreateMonarchPolicy(100u);
+            policy.SetStanding(200u, IffStanding.Hostile);
+            policy.SetStanding(300u, IffStanding.Friendly);
+            Assert.AreEqual(IffStanding.Hostile, policy.GetStanding(200u));
+            Assert.AreEqual(IffStanding.Friendly, policy.GetStanding(300u));
+            RadarIff.ResetPolicies();
+        }
+    }
+}
