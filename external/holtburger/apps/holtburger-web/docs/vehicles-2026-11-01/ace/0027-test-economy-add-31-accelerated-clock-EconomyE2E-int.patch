+        [TestMethod]
+        public void F4_Vendor_MonarchTariffBounds()
+        {
+            var econType = RequireOrInconclusive(
+                FindType("ACE.Server.Economy.TownEconomyManager"),
+                "ACE.Server.Economy.TownEconomyManager");
+            var setTariff = FindMethod(econType, "SetTownTariffs", 3) ?? FindMethod(econType, "SetTariffMultipliers", 3);
+            RequireOrInconclusive(setTariff, "TownEconomyManager.SetTownTariffs(townId, buyMul, sellMul)");
+
+            ResetEconomyIfPresent(econType);
+            try
+            {
+                if (setTariff.ReturnType == typeof(bool))
+                {
+                    Assert.IsFalse(InvokeBool(setTariff, null, 1u, -0.5f, 1.0f),
+                        "Negative buy tariff multiplier must be rejected");
+                    Assert.IsFalse(InvokeBool(setTariff, null, 1u, float.NaN, 1.0f),
+                        "NaN buy tariff multiplier must be rejected");
+                    return;
+                }
+
+                Assert.AreEqual(typeof(void), setTariff.ReturnType,
+                    $"SetTownTariffs must return bool or void, got {setTariff.ReturnType.Name}");
+
+                var getState = FindMethod(econType, "GetTownState", 1);
+                var getEffectiveSell = FindMethod(econType, "GetEffectiveSellCost64", 7);
+                var getEffectiveBuy = FindMethod(econType, "GetEffectiveBuyCost", 6);
+                RequireOrInconclusive(getState, "TownEconomyManager.GetTownState");
+
+                // 1. Negative multipliers must be clamped positive/non-negative (never <= 0 sell multiplier)
+                setTariff.Invoke(null, new object[] { 1u, -0.5f, -0.25f });
+                var stateNeg = getState.Invoke(null, new object[] { 1u });
+                var ctrlNeg = GetPropOrField(stateNeg, "Control") ?? stateNeg;
+                float buyMulNeg = Convert.ToSingle(GetPropOrField(ctrlNeg, "TariffBuyMul"));
+                float sellMulNeg = Convert.ToSingle(GetPropOrField(ctrlNeg, "TariffSellMul"));
+                Assert.IsTrue(float.IsFinite(buyMulNeg) && buyMulNeg >= 0.01f, $"Negative buyMul must clamp >= 0.01f, got {buyMulNeg}");
+                Assert.IsTrue(float.IsFinite(sellMulNeg) && sellMulNeg >= 0.0f, $"Negative sellMul must clamp >= 0.0f, got {sellMulNeg}");
+
+                if (getEffectiveSell != null)
+                {
+                    long effSell = Convert.ToInt64(getEffectiveSell.Invoke(null, new object[] { 1u, 1u, 320u, 1000, 1, (ItemType?)ItemType.MeleeWeapon, (double?)1.0 }));
+                    Assert.IsTrue(effSell > 0L, $"Effective sell cost must remain > 0 after negative tariff clamp, got {effSell}");
+                }
+                if (getEffectiveBuy != null)
+                {
+                    int effBuy = Convert.ToInt32(getEffectiveBuy.Invoke(null, new object[] { 1u, 1u, 320u, 1000, (ItemType?)ItemType.MeleeWeapon, (double?)0.5 }));
+                    Assert.IsTrue(effBuy >= 0, $"Effective buy cost must remain >= 0 after negative tariff clamp, got {effBuy}");
+                }
+
+                // 2. Zero multipliers must clamp buyMul >= 0.01f and keep effective prices > 0
+                setTariff.Invoke(null, new object[] { 1u, 0.0f, 0.0f });
+                var stateZero = getState.Invoke(null, new object[] { 1u });
+                var ctrlZero = GetPropOrField(stateZero, "Control") ?? stateZero;
+                float buyMulZero = Convert.ToSingle(GetPropOrField(ctrlZero, "TariffBuyMul"));
+                Assert.IsTrue(float.IsFinite(buyMulZero) && buyMulZero >= 0.01f, $"Zero buyMul must clamp >= 0.01f, got {buyMulZero}");
+
+                // 3. NaN multipliers must NOT poison town tariff state with float.NaN
+                setTariff.Invoke(null, new object[] { 1u, float.NaN, float.NaN });
+                var stateNan = getState.Invoke(null, new object[] { 1u });
+                var ctrlNan = GetPropOrField(stateNan, "Control") ?? stateNan;
+                float buyMulNan = Convert.ToSingle(GetPropOrField(ctrlNan, "TariffBuyMul"));
+                float sellMulNan = Convert.ToSingle(GetPropOrField(ctrlNan, "TariffSellMul"));
+                Assert.IsTrue(float.IsFinite(buyMulNan) && buyMulNan >= 0.01f, $"NaN buyMul must be rejected or sanitized, got {buyMulNan}");
+                Assert.IsTrue(float.IsFinite(sellMulNan) && sellMulNan >= 0.0f, $"NaN sellMul must be rejected or sanitized, got {sellMulNan}");
+            }
+            finally
+            {
+                ResetEconomyIfPresent(econType);
+            }
+        }
