+        [TestMethod]
+        public void TrailerSpawnAlignmentAcrossHeadingsAndHitchedExclusion()
+        {
+            double x = 3500.0, y = 4500.0, z = 40.0;
+            VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = z, Nz = 1.0 };
+
+            // 1) Kingpin alignment across headings 0..330 deg
+            var tractor = CreateTestSemi(0x75005301u, x, y, z, heading: 0.0);
+            var player = CreateTestPlayer(0x50005301u, x + 3.0, y + 3.0, z);
+            uint trGuidSeq = 0x75005310u;
+
+            for (int deg = 0; deg < 360; deg += 30)
+            {
+                var h = Deg(deg);
+                tractor.Location = Vehicle.ToPosition(x, y, z, Vehicle.YawOnly(h));
+                tractor.GroundState = new GroundState { X = x, Y = y, Z = z, Heading = GroundModel.WrapHeading(h), Mode = VehicleMode.Parked };
+                tractor.State = tractor.GroundState.ToFlightState();
+
+                var spawnPos = VehicleCommands.ComputeTrailerSpawnPosition(player, SemiTrailerDeployable.WcidChassis40);
+                var (sx, sy, sz) = Vehicle.ToGlobal(spawnPos);
+                var trHeading = VehicleManager.HeadingOf(spawnPos.Rotation);
+
+                var tr = RegisterTestTrailer(trGuidSeq++, SemiTrailerDeployable.WcidChassis40, sx, sy, sz, trHeading);
+                Assert.IsTrue(VehicleManager.TryHitchTrailer(tractor, tr, null, out var hitchErr),
+                    $"@trailer spawn pose at heading {deg} deg must hitch cleanly: {hitchErr}");
+                VehicleManager.UnhitchTrailer(tractor, tr, null, broadcastEvents: false);
+            }
+
+            // 2) Hitched tractor exclusion: hitched near-tractor is ignored in favor of unhitched tractor (or player fallback)
+            var tractorA = tractor;
+            tractorA.Location = Vehicle.ToPosition(x, y, z, Vehicle.YawOnly(0.0));
+            tractorA.GroundState = new GroundState { X = x, Y = y, Z = z, Heading = 0.0, Mode = VehicleMode.Parked };
+            tractorA.State = tractorA.GroundState.ToFlightState();
+            tractorA.HitchedTrailerGuid = 0x75009999u; // already hitched!
+
+            var tractorB = CreateTestSemi(0x75005302u, x + 10.0, y, z, heading: Deg(90.0));
+            player.Location = Vehicle.ToPosition(x + 2.0, y, z, Vehicle.YawOnly(0.0)); // closer to hitched tractorA (2 m) than unhitched tractorB (8 m)
+
+            var posPickB = VehicleCommands.ComputeTrailerSpawnPosition(player, SemiTrailerDeployable.WcidChassis40);
+            Assert.AreEqual(Deg(90.0), VehicleManager.HeadingOf(posPickB.Rotation), 1e-3,
+                "hitched tractorA must be excluded so unhitched tractorB (90 deg) is selected");
+
+            // If both are hitched, falls back to player heading (0 deg) and +6m forward
+            tractorB.HitchedTrailerGuid = 0x75009998u;
+            var posFallback = VehicleCommands.ComputeTrailerSpawnPosition(player, SemiTrailerDeployable.WcidChassis40);
+            var (fx, fy, fz) = Vehicle.ToGlobal(posFallback);
+            Assert.AreEqual(0.0, VehicleManager.HeadingOf(posFallback.Rotation), 1e-3);
+            Assert.AreEqual(x + 2.0, fx, 1e-3);
+            Assert.AreEqual(y + 6.0, fy, 1e-3);
+            Assert.AreEqual(z, fz, 1e-3);
+        }
