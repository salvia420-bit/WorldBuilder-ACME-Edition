+        [TestMethod]
+        public void MoveAuxWorldObjectDetectsCrossLandblockRelocationAfterSetWorldPose()
+        {
+            // 1. Pre-move Location overwritten by SetWorldPose across 192 m boundary (CurrentLandblock == null)
+            var tractor = CreateTestSemi(0x75000201u, 190.0, 190.0, 40.0, heading: 0.0);
+            var trailer = RegisterTestTrailer(0x75004001u, SemiTrailerDeployable.WcidChassis40, 190.0, 190.0, 40.0, heading: 0.0);
+            var container = RegisterTestContainer(0x75004002u, IsoContainerDeployable.Wcid40ftHC, 190.0, 190.0, 40.0, heading: 0.0);
+            Assert.IsTrue(trailer.TryMountContainer(container, 0, out _));
+
+            var transitions = new List<(uint guid, ushort prevLb, ushort nextLb)>();
+            VehicleManager.AuxLandblockChangedObserverForTesting = (wo, prevId, nextId) =>
+                transitions.Add((wo.Guid.Full, prevId.Landblock, nextId.Landblock));
+
+            // Simulate SetWorldPose crossing x = 192 m (0x0000 -> 0x0100) BEFORE MoveAuxWorldObject runs
+            trailer.SetWorldPose(195.0, 190.0, 40.0, 0.0);
+            trailer.SyncMountedContainerPose(container);
+
+            Assert.AreEqual(0x0100u, trailer.Location.Landblock);
+            Assert.AreEqual(0x0100u, container.Location.Landblock);
+
+            VehicleManager.MoveAuxWorldObject(trailer, trailer.Location, tractor);
+            VehicleManager.MoveAuxWorldObject(container, container.Location, tractor);
+
+            Assert.AreEqual(2, transitions.Count, "both trailer and container must trigger relocation after SetWorldPose");
+            Assert.AreEqual((trailer.Guid.Full, (ushort)0x0000, (ushort)0x0100), transitions[0]);
+            Assert.AreEqual((container.Guid.Full, (ushort)0x0000, (ushort)0x0100), transitions[1]);
+
+            // Calling MoveAuxWorldObject again on the same landblock must NOT fire a duplicate relocation
+            transitions.Clear();
+            trailer.SetWorldPose(196.0, 190.0, 40.0, 0.0);
+            trailer.SyncMountedContainerPose(container);
+            VehicleManager.MoveAuxWorldObject(trailer, trailer.Location, tractor);
+            VehicleManager.MoveAuxWorldObject(container, container.Location, tractor);
+            Assert.AreEqual(0, transitions.Count, "same-landblock step must not trigger relocation");
+
+            // 2. When CurrentLandblock is populated on origin landblock 0x0000 even if Location already jumped to 0x0200
+            var fakeLb = (ACE.Server.Entity.Landblock)System.Runtime.CompilerServices.RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Entity.Landblock));
+            typeof(ACE.Server.Entity.Landblock).GetField("<Id>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(fakeLb, new LandblockId(0, 0));
+            var currLbProp = typeof(WorldObject).GetProperty(nameof(WorldObject.CurrentLandblock), BindingFlags.Instance | BindingFlags.Public);
+            currLbProp?.SetValue(trailer, fakeLb);
+            trailer.SetWorldPose(390.0, 190.0, 40.0, 0.0); // lbX = 2 -> 0x0200
+            VehicleManager.MoveAuxWorldObject(trailer, trailer.Location, tractor);
+            Assert.AreEqual(1, transitions.Count);
+            Assert.AreEqual((trailer.Guid.Full, (ushort)0x0000, (ushort)0x0200), transitions[0]);
+            currLbProp?.SetValue(trailer, null);
+        }
