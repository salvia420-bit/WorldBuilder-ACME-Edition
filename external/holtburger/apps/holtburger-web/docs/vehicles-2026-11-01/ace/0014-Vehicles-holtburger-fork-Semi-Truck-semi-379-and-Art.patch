+        public static bool TryHitchTrailer(Vehicle tractor, Deployables.SemiTrailerDeployable trailer, Player actor, out string error)
+        {
+            error = null;
+            if (tractor == null || tractor.IsDestroyed) { error = "Tractor unavailable."; return false; }
+            if (tractor.Profile.Locomotion != VehicleLocomotion.Ground || tractor.Profile.FifthWheelOffsetY == 0f)
+            {
+                error = "Vehicle has no fifth-wheel hitch.";
+                return false;
+            }
+            if (tractor.HitchedTrailerGuid != 0)
+            {
+                error = "Tractor is already hitched.";
+                return false;
+            }
+            if (trailer == null || trailer.IsDestroyed || trailer.IsPacked || !trailer.IsActive)
+            {
+                error = "Trailer unavailable.";
+                return false;
+            }
+            if (trailer.CoupledTractorGuid != 0)
+            {
+                error = "Trailer is already coupled to another tractor.";
+                return false;
+            }
+
+            var fw = TrailerKinematics.ComputeFifthWheelPose(tractor.GroundState, tractor.Profile.FifthWheelOffsetY, tractor.Profile.FifthWheelOffsetZ);
+            var kp = trailer.GetKingpinGlobalPose();
+            var dx = fw.x - kp.x;
+            var dy = fw.y - kp.y;
+            var dz = fw.z - kp.z;
+            var dist = Math.Sqrt(dx * dx + dy * dy + dz * dz);
+            if (dist > 3.5)
+            {
+                error = $"Trailer kingpin is {dist:0.00} m from fifth wheel (must be <= 3.50 m).";
+                return false;
+            }
+
+            var angleDiff = Math.Abs(TrailerKinematics.WrapPi(tractor.GroundState.Heading - trailer.HeadingRad));
+            if (angleDiff > (60.0 * Math.PI / 180.0) + 1e-6)
+            {
+                error = $"Trailer alignment offset {angleDiff * 180.0 / Math.PI:0.0} deg exceeds 60 deg limit.";
+                return false;
+            }
+
+            tractor.HitchedTrailerGuid = trailer.Guid.Full;
+            trailer.CoupledTractorGuid = tractor.Guid.Full;
+            trailer.LandingGearRetracted = true;
+            trailer.BrakeLights = (tractor.GroundState.GroundFlags & 0x02) != 0;
+
+            var spec = trailer.Spec;
+            var muLat = tractor.GroundState.LastMuLat > 0.0 ? tractor.GroundState.LastMuLat : 1.0;
+            tractor.TrailerState = new TrailerKinematicState { Heading = trailer.HeadingRad };
+            TrailerKinematics.StepCoupled(
+                in tractor.GroundState,
+                ref tractor.TrailerState,
+                tractor.Profile.FifthWheelOffsetY,
+                tractor.Profile.FifthWheelOffsetZ,
+                tractor.GroundParams.Wheelbase,
+                muLat,
+                in spec,
+                SampleTrailerTerrainZ,
+                0.0,
+                explicitYawRate: 0.0);
+
+            trailer.SetWorldPose(tractor.TrailerState.X, tractor.TrailerState.Y, tractor.TrailerState.Z,
+                tractor.TrailerState.Heading, tractor.TrailerState.Pitch, tractor.TrailerState.Bank);
+            MoveAuxWorldObject(trailer, trailer.Location, tractor);
+
+            if (trailer.MountedContainerGuid != 0)
+            {
+                var container = Deployables.DeployableManager.GetDeployable(trailer.MountedContainerGuid) as Deployables.IsoContainerDeployable;
+                if (container != null && !container.IsDestroyed)
+                {
+                    trailer.SyncMountedContainerPose(container);
+                    MoveAuxWorldObject(container, container.Location, tractor);
+                }
+            }
+
+            tractor.TrailerHeading = (float)tractor.TrailerState.Heading;
+            tractor.TrailerPitch = (float)tractor.TrailerState.Pitch;
+            tractor.TrailerFlags = trailer.ComputeTrailerFlags();
+            tractor.GroundState.TowMassMul = trailer.MountedContainerGuid != 0
+                ? TrailerKinematics.TowMassLoaded
+                : TrailerKinematics.TowMassEmptyChassis;
+            tractor.PlacedIdle = false;
+            tractor.PilotStateAcc = 1.0;
+            tractor.ObserverStateAcc = 1.0;
+
+            trailer.BroadcastState();
+            BroadcastEvent(tractor, VehicleEventKind.TrailerHitched, actor?.Guid.Full ?? tractor.Pilot,
+                (float)tractor.TrailerState.ArticulationRad, alsoTo: actor, aux: trailer.Guid.Full);
+            return true;
+        }
+
+        public static void UnhitchTrailer(Vehicle tractor, Deployables.SemiTrailerDeployable trailer, Player actor = null, bool broadcastEvents = true)
+        {
+            if (tractor == null) return;
+
+            var trailerGuid = tractor.HitchedTrailerGuid;
+            trailer ??= trailerGuid != 0
+                ? Deployables.DeployableManager.GetDeployable(trailerGuid) as Deployables.SemiTrailerDeployable
+                : null;
+
+            tractor.HitchedTrailerGuid = 0;
+            tractor.TrailerHeading = 0f;
+            tractor.TrailerPitch = 0f;
+            tractor.TrailerFlags = 0;
+            tractor.TrailerState = default;
+            tractor.GroundState.TowMassMul = TrailerKinematics.TowMassBobtail;
+            tractor.PlacedIdle = false;
+
+            if (trailer != null && !trailer.IsDestroyed)
+            {
+                trailer.CoupledTractorGuid = 0;
+                trailer.LandingGearRetracted = false;
+                trailer.BrakeLights = false;
+
+                var (tx, ty, tz) = trailer.GetGlobalPose();
+                var gz = SampleTrailerTerrainZ(tx, ty, tz);
+                var targetZ = !double.IsNaN(gz) ? gz : Math.Max(0.0, tz);
+                trailer.SetWorldPose(tx, ty, targetZ, trailer.HeadingRad, trailer.PitchRadD, trailer.BankRad);
+                MoveAuxWorldObject(trailer, trailer.Location, tractor);
+
+                if (trailer.MountedContainerGuid != 0)
+                {
+                    var container = Deployables.DeployableManager.GetDeployable(trailer.MountedContainerGuid) as Deployables.IsoContainerDeployable;
+                    if (container != null && !container.IsDestroyed)
+                    {
+                        trailer.SyncMountedContainerPose(container);
+                        MoveAuxWorldObject(container, container.Location, tractor);
+                        if (broadcastEvents) container.BroadcastState();
+                    }
+                }
+
+                if (broadcastEvents)
+                    trailer.BroadcastState();
+            }
+
+            if (broadcastEvents)
+            {
+                tractor.PilotStateAcc = 1.0;
+                tractor.ObserverStateAcc = 1.0;
+                BroadcastEvent(tractor, VehicleEventKind.TrailerUnhitched, actor?.Guid.Full ?? tractor.Pilot, 0f,
+                    alsoTo: actor, aux: trailer?.Guid.Full ?? trailerGuid);
+            }
+        }
