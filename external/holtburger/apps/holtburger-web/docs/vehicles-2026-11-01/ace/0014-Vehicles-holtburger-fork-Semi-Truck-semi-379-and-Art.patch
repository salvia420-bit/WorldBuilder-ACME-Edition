diff --git a/Source/ACE.Server/Vehicles/TrailerKinematics.cs b/Source/ACE.Server/Vehicles/TrailerKinematics.cs
new file mode 100644
index 00000000..83d873eb
--- /dev/null
+++ b/Source/ACE.Server/Vehicles/TrailerKinematics.cs
@@ -0,0 +1,310 @@
+using System;
+using System.Numerics;
+
+namespace ACE.Server.Vehicles
+{
+    public readonly struct TrailerSpec
+    {
+        public readonly string Kind;
+        public readonly double KpY;
+        public readonly double BogieY;
+        public readonly double Wheelbase;
+        public readonly double DeckZ;
+        public readonly double KingpinZ;
+
+        public TrailerSpec(string kind, double kpY, double bogieY, double wheelbase, double deckZ, double kingpinZ)
+        {
+            Kind = kind;
+            KpY = kpY;
+            BogieY = bogieY;
+            Wheelbase = wheelbase;
+            DeckZ = deckZ;
+            KingpinZ = kingpinZ;
+        }
+    }
+
+    public struct TrailerKinematicState
+    {
+        public double X, Y, Z;
+        public double Heading, Pitch, Bank;
+        public double ArticulationRad;
+        public double HitchX, HitchY, HitchZ;
+        public double BogieX, BogieY, BogieZ;
+    }
+
+    public struct MountedContainerPose
+    {
+        public double X, Y, Z;
+        public double Heading, Pitch, Bank;
+        public double LocalY, LocalZ;
+    }
+
+    /// <summary>
+    /// Deterministic 30 Hz Articulated Fifth-Wheel Trailer Kinematics.
+    /// SPECIFIED ONCE, IMPLEMENTED TWICE: Mirrors holtburger-web scene3d/vehicle/trailer_kinematics.js.
+    ///
+    /// AC World / Local Frame Convention:
+    ///   +X = East / Right, +Y = North / Forward, +Z = Up
+    ///   heading = compass radians (0 = +Y North, clockwise positive)
+    ///   Orientation(heading, pitch, bank) = Rz(-heading) * Rx(pitch) * Ry(bank)
+    /// </summary>
+    public static class TrailerKinematics
+    {
+        public const int SimHz = 30;
+        public const double Dt = 1.0 / SimHz;
+        const double TwoPi = 2.0 * Math.PI;
+
+        public const double MaxJackknifeRad = (72.0 * Math.PI) / 180.0;
+        public const double MaxTrailerPitchRad = Math.PI / 4.0;
+        public const double MaxTrailerBankRad = Math.PI / 4.0;
+        public const double BogieHalfTrack = 0.955;
+
+        public const double TowMassBobtail = 1.0;
+        public const double TowMassEmptyChassis = 0.72;
+        public const double TowMassLoaded = 0.58;
+
+        public const uint WcidChassis20 = 4000030;
+        public const uint WcidChassis40 = 4000031;
+
+        public static readonly TrailerSpec Chassis20 = new TrailerSpec("20ft", 2.80, -1.895, 4.695, 1.32, 0.96);
+        public static readonly TrailerSpec Chassis40 = new TrailerSpec("40ft", 5.35, -4.445, 9.795, 1.32, 0.96);
+
+        public static TrailerSpec ResolveSpec(DeployableKind kind) =>
+            kind == DeployableKind.TrailerChassis40 ? Chassis40 : Chassis20;
+
+        public static TrailerSpec ResolveSpec(uint wcidOrKind) =>
+            (wcidOrKind == WcidChassis40 || wcidOrKind == (uint)DeployableKind.TrailerChassis40 || wcidOrKind == 40)
+                ? Chassis40
+                : Chassis20;
+
+        public static TrailerSpec ResolveSpec(string kind)
+        {
+            if (string.Equals(kind, "40ft", StringComparison.OrdinalIgnoreCase) ||
+                string.Equals(kind, "40", StringComparison.OrdinalIgnoreCase) ||
+                string.Equals(kind, "Chassis40ft", StringComparison.OrdinalIgnoreCase) ||
+                string.Equals(kind, "TrailerChassis40", StringComparison.OrdinalIgnoreCase))
+            {
+                return Chassis40;
+            }
+            return Chassis20;
+        }
+
+        /// <summary>Signed shortest angular difference wrapped to [-pi, pi].</summary>
+        public static double WrapPi(double a)
+        {
+            var d = a - TwoPi * Math.Floor((a + Math.PI) / TwoPi);
+            if (d > Math.PI) d -= TwoPi;
+            if (d < -Math.PI) d += TwoPi;
+            return d;
+        }
+
+        /// <summary>
+        /// Exact IEEE-754 double-precision equivalent of Vehicle.Orientation(heading, pitch, bank) = Rz(-heading) * Rx(pitch) * Ry(bank)
+        /// and Vector3.Transform, matching flight_model.js orientation() + rotate() bit-for-bit.
+        /// </summary>
+        public static (double x, double y, double z) RotateByOrientation(double heading, double pitch, double bank, double vx, double vy, double vz)
+        {
+            var ch = Math.Cos(-heading * 0.5);
+            var sh = Math.Sin(-heading * 0.5);
+            var cp = Math.Cos(pitch * 0.5);
+            var sp = Math.Sin(pitch * 0.5);
+            var cr = Math.Cos(bank * 0.5);
+            var sr = Math.Sin(bank * 0.5);
+
+            // qz(-h) * qx(p)
+            var aw = ch * cp;
+            var ax = ch * sp;
+            var ay = sh * sp;
+            var az = sh * cp;
+
+            // (qz * qx) * qy(b)
+            var qw = aw * cr - ay * sr;
+            var qx = ax * cr - az * sr;
+            var qy = aw * sr + ay * cr;
+            var qz = az * cr + ax * sr;
+
+            var tx = 2.0 * (qy * vz - qz * vy);
+            var ty = 2.0 * (qz * vx - qx * vz);
+            var tz = 2.0 * (qx * vy - qy * vx);
+
+            return (
+                vx + qw * tx + (qy * tz - qz * ty),
+                vy + qw * ty + (qz * tx - qx * tz),
+                vz + qw * tz + (qx * ty - qy * tx)
+            );
+        }
+
+        public static (double x, double y, double z) ComputeFifthWheelPose(in GroundState ts, double hitchOffsetY = -2.01, double fifthWheelOffsetZ = 0.96)
+        {
+            var h = double.IsFinite(ts.Heading) ? ts.Heading : 0.0;
+            var p = double.IsFinite(ts.Pitch) ? ts.Pitch : 0.0;
+            var tx = double.IsFinite(ts.X) ? ts.X : 0.0;
+            var ty = double.IsFinite(ts.Y) ? ts.Y : 0.0;
+            var tz = double.IsFinite(ts.Z) ? ts.Z : 0.0;
+            return (
+                tx + Math.Sin(h) * hitchOffsetY,
+                ty + Math.Cos(h) * hitchOffsetY,
+                tz + hitchOffsetY * Math.Sin(p) + fifthWheelOffsetZ * Math.Cos(p)
+            );
+        }
+
+        static double SampleTerrainZ(Func<double, double, double, double> oracle, double x, double y, double refZ)
+        {
+            if (oracle == null) return double.NaN;
+            var z = oracle(x, y, refZ);
+            return double.IsFinite(z) ? z : double.NaN;
+        }
+
+        /// <summary>
+        /// Advance coupled trailer kinematics for one deterministic step, matching trailer_kinematics.js stepCoupledTrailer().
+        /// </summary>
+        public static void StepCoupled(
+            in GroundState tractor,
+            ref TrailerKinematicState trailer,
+            double hitchOffsetY,
+            double fifthWheelOffsetZ,
+            double tractorWheelbase,
+            double muLat,
+            in TrailerSpec spec,
+            Func<double, double, double, double> terrainOracle = null,
+            double dt = Dt,
+            double? explicitYawRate = null)
+        {
+            var effSpec = spec.Wheelbase > 0 ? spec : Chassis20;
+            var ht = double.IsFinite(tractor.Heading) ? tractor.Heading : 0.0;
+            var vt = double.IsFinite(tractor.Speed) ? tractor.Speed : 0.0;
+            var trPitch = double.IsFinite(tractor.Pitch) ? tractor.Pitch : 0.0;
+            var tx = double.IsFinite(tractor.X) ? tractor.X : 0.0;
+            var ty = double.IsFinite(tractor.Y) ? tractor.Y : 0.0;
+            var tz = double.IsFinite(tractor.Z) ? tractor.Z : 0.0;
+            var fwZ = double.IsFinite(fifthWheelOffsetZ) ? fifthWheelOffsetZ : effSpec.KingpinZ;
+
+            double omegaT = 0.0;
+            if (explicitYawRate.HasValue && double.IsFinite(explicitYawRate.Value))
+            {
+                omegaT = explicitYawRate.Value;
+            }
+            else if (double.IsFinite(tractorWheelbase) && tractorWheelbase > 0.0 && double.IsFinite(tractor.SteerAngle))
+            {
+                var effMuLat = double.IsFinite(muLat) && muLat > 0.0 ? muLat : 1.0;
+                omegaT = (vt * Math.Tan(tractor.SteerAngle) / tractorWheelbase) * effMuLat;
+            }
+
+            var sinHt = Math.Sin(ht);
+            var cosHt = Math.Cos(ht);
+
+            // World fifth-wheel hitch point & velocity (including lever arm from tractor yaw rate)
+            var hx = tx + sinHt * hitchOffsetY;
+            var hy = ty + cosHt * hitchOffsetY;
+            var vxH = vt * sinHt + omegaT * hitchOffsetY * cosHt;
+            var vyH = vt * cosHt - omegaT * hitchOffsetY * sinHt;
+
+            var safeDt = (double.IsFinite(dt) && dt >= 0.0) ? dt : 0.0;
+
+            // No-lateral-slip at trailer bogie: v_h . r(h_tr) = omega_tr * wheelbase
+            var hTrPrev = double.IsFinite(trailer.Heading) ? trailer.Heading : ht;
+            var omegaTr = (vxH * Math.Cos(hTrPrev) - vyH * Math.Sin(hTrPrev)) / effSpec.Wheelbase;
+
+            var relPrev = WrapPi(ht - hTrPrev);
+            var rel = Math.Clamp(relPrev - omegaTr * safeDt, -MaxJackknifeRad, MaxJackknifeRad);
+            var hTr = GroundModel.WrapHeading(ht - rel);
+
+            var sinTr = Math.Sin(hTr);
+            var cosTr = Math.Cos(hTr);
+
+            // Sample bogie terrain height & lateral slope around the horizontal bogie projection (wheelbase behind hitch)
+            var bxSample = hx - sinTr * effSpec.Wheelbase;
+            var bySample = hy - cosTr * effSpec.Wheelbase;
+
+            // Vertical pitch & bank from hitch Z vs bogie terrain samples
+            var hitchWorldZ = tz + hitchOffsetY * Math.Sin(trPitch) + fwZ * Math.Cos(trPitch);
+            var kpGroundZ = hitchWorldZ - effSpec.KingpinZ;
+            var rawBogieZ = SampleTerrainZ(terrainOracle, bxSample, bySample, kpGroundZ);
+            var bogieZSample = double.IsFinite(rawBogieZ) ? rawBogieZ : kpGroundZ;
+
+            var pitchTr = Math.Clamp(Math.Atan2(kpGroundZ - bogieZSample, effSpec.Wheelbase), -MaxTrailerPitchRad, MaxTrailerPitchRad);
+
+            // Lateral bank from left/right dual-tire bogie terrain samples
+            var rx = cosTr;
+            var ry = -sinTr;
+            var zL = SampleTerrainZ(terrainOracle, bxSample - rx * BogieHalfTrack, bySample - ry * BogieHalfTrack, bogieZSample);
+            var zR = SampleTerrainZ(terrainOracle, bxSample + rx * BogieHalfTrack, bySample + ry * BogieHalfTrack, bogieZSample);
+            var bankTr = (double.IsFinite(zL) && double.IsFinite(zR))
+                ? Math.Clamp(Math.Atan2(zL - zR, 2.0 * BogieHalfTrack), -MaxTrailerBankRad, MaxTrailerBankRad)
+                : 0.0;
+
+            // Place trailer origin so rotated 3D kingpin [0, kpY, kingpinZ] coincides exactly with world hitch (hx, hy, hitchWorldZ)
+            var (kpOffX, kpOffY, kpOffZ) = RotateByOrientation(hTr, pitchTr, bankTr, 0.0, effSpec.KpY, effSpec.KingpinZ);
+            var xTr = hx - kpOffX;
+            var yTr = hy - kpOffY;
+            var zTr = hitchWorldZ - kpOffZ;
+
+            // Derive 3D bogie axle XYZ from (xTr, yTr, zTr) + rotated [0, bogieY, 0]
+            var (bgOffX, bgOffY, bgOffZ) = RotateByOrientation(hTr, pitchTr, bankTr, 0.0, effSpec.BogieY, 0.0);
+            var bx = xTr + bgOffX;
+            var by = yTr + bgOffY;
+            var bz = zTr + bgOffZ;
+
+            trailer.X = xTr;
+            trailer.Y = yTr;
+            trailer.Z = zTr;
+            trailer.Heading = hTr;
+            trailer.Pitch = pitchTr;
+            trailer.Bank = bankTr;
+            trailer.ArticulationRad = rel;
+            trailer.HitchX = hx;
+            trailer.HitchY = hy;
+            trailer.HitchZ = hitchWorldZ;
+            trailer.BogieX = bx;
+            trailer.BogieY = by;
+            trailer.BogieZ = bz;
+        }
+
+        public static MountedContainerPose ComputeMountedContainerPose(
+            double trailerX, double trailerY, double trailerZ,
+            double trailerHeading, double trailerPitch, double trailerBank,
+            in TrailerSpec spec,
+            double containerLength = 6.058,
+            byte slot = 0,
+            bool explicitCenter = false)
+        {
+            var effLen = double.IsFinite(containerLength) && containerLength > 0.0 ? containerLength : 6.058;
+            double localY = 0.0;
+            if (spec.Kind == "40ft" && effLen < 7.0)
+            {
+                if (slot == 1)
+                    localY = 2.9295;
+                else if (explicitCenter)
+                    localY = 0.0;
+                else
+                    localY = -2.9295;
+            }
+            var localZ = spec.DeckZ;
+
+            var h = double.IsFinite(trailerHeading) ? trailerHeading : 0.0;
+            var p = double.IsFinite(trailerPitch) ? trailerPitch : 0.0;
+            var b = double.IsFinite(trailerBank) ? trailerBank : 0.0;
+
+            var (dx, dy, dz) = RotateByOrientation(h, p, b, 0.0, localY, localZ);
+            return new MountedContainerPose
+            {
+                X = (double.IsFinite(trailerX) ? trailerX : 0.0) + dx,
+                Y = (double.IsFinite(trailerY) ? trailerY : 0.0) + dy,
+                Z = (double.IsFinite(trailerZ) ? trailerZ : 0.0) + dz,
+                Heading = h,
+                Pitch = p,
+                Bank = b,
+                LocalY = localY,
+                LocalZ = localZ,
+            };
+        }
+
+        public static MountedContainerPose ComputeMountedContainerPose(
+            in TrailerKinematicState trailer,
+            in TrailerSpec spec,
+            double containerLength = 6.058,
+            byte slot = 0,
+            bool explicitCenter = false) =>
+            ComputeMountedContainerPose(trailer.X, trailer.Y, trailer.Z, trailer.Heading, trailer.Pitch, trailer.Bank, in spec, containerLength, slot, explicitCenter);
+    }
+}
