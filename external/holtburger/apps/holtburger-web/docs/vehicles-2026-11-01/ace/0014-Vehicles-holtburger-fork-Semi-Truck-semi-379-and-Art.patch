+        [TestMethod]
+        public void GroundModelScalingAndTowMassMulParity()
+        {
+            var semiParams = GroundParams.FromProfile(VehicleProfile.Semi379());
+            Assert.AreEqual(27.0, semiParams.VMaxRoad, 1e-6);
+            Assert.AreEqual(-7.0, semiParams.VReverseMax, 1e-6);
+            Assert.AreEqual(4.8, semiParams.LaunchAccel, 1e-6);
+            Assert.AreEqual(4.0, semiParams.SteerSlewRateLow, 1e-6);
+
+            GroundOracle roadOracle = (x, y, z) => new TerrainSample { Z = 0, Nz = 1, Surface = GroundModel.Surfaces[0] };
+            GroundOracle dirtOracle = (x, y, z) => new TerrainSample { Z = 0, Nz = 1, Surface = GroundModel.Surfaces[1] };
+
+            var stRoad = new GroundState();
+            for (int i = 0; i < 900; i++)
+                GroundModel.Step(ref stRoad, new GroundInput { Throttle = 1.0 }, semiParams, roadOracle, GroundModel.Dt);
+            Assert.AreEqual(27.0, stRoad.Speed, 1e-3, "semi road vMax");
+
+            var stDirt = new GroundState();
+            for (int i = 0; i < 900; i++)
+                GroundModel.Step(ref stDirt, new GroundInput { Throttle = 1.0 }, semiParams, dirtOracle, GroundModel.Dt);
+            Assert.AreEqual(24.4 * (27.0 / 29.0), stDirt.Speed, 1e-3, "semi dirt scaled vMax");
+
+            // Reverse speed unscaled by TowMassMul
+            var stRev = new GroundState { TowMassMul = TrailerKinematics.TowMassLoaded };
+            for (int i = 0; i < 600; i++)
+                GroundModel.Step(ref stRev, new GroundInput { Throttle = -1.0 }, semiParams, roadOracle, GroundModel.Dt);
+            Assert.AreEqual(-7.0, stRev.Speed, 1e-3, "reverse top speed unscaled");
+
+            // TowMassMul 1.0 / 0.72 / 0.58 launch accel and terminal speed + precedence (State -> Input -> Params -> 1.0)
+            foreach (var (mul, source) in new[] { (1.0, "state"), (0.72, "state"), (0.58, "state"), (0.72, "input"), (0.58, "params") })
+            {
+                var p = source == "params"
+                    ? new GroundParams
+                    {
+                        Wheelbase = semiParams.Wheelbase, TrackWidth = semiParams.TrackWidth, WheelRadius = semiParams.WheelRadius,
+                        MaxSteerRad = semiParams.MaxSteerRad, MinSteerRad = semiParams.MinSteerRad,
+                        SteerSlewRateLow = semiParams.SteerSlewRateLow, SteerSlewRateHigh = semiParams.SteerSlewRateHigh,
+                        SteerSpeedLow = semiParams.SteerSpeedLow, SteerSpeedHigh = semiParams.SteerSpeedHigh,
+                        TurnRadiusMin = semiParams.TurnRadiusMin, VMaxRoad = semiParams.VMaxRoad, VReverseMax = semiParams.VReverseMax,
+                        LaunchAccel = semiParams.LaunchAccel, NormalBrake = semiParams.NormalBrake, HandbrakeDecel = semiParams.HandbrakeDecel,
+                        LowRangeTorqueMul = semiParams.LowRangeTorqueMul, LowRangeSpeedCap = semiParams.LowRangeSpeedCap,
+                        ClimbLimitCos = semiParams.ClimbLimitCos, FloorZ = semiParams.FloorZ, FordDepthMax = semiParams.FordDepthMax,
+                        CoastLinear = semiParams.CoastLinear, CoastQuad = semiParams.CoastQuad,
+                        TreeGlanceThreshold = semiParams.TreeGlanceThreshold, TreeGlanceScrub = semiParams.TreeGlanceScrub, TreeYawNudge = semiParams.TreeYawNudge,
+                        TowMassMul = mul
+                    }
+                    : semiParams;
+
+                var st = new GroundState();
+                if (source == "state") st.TowMassMul = mul;
+                var inp = source == "input" ? new GroundInput { Throttle = 1.0, TowMassMul = mul } : new GroundInput { Throttle = 1.0 };
+
+                GroundModel.Step(ref st, in inp, p, roadOracle, GroundModel.Dt);
+                var a0 = st.Speed / GroundModel.Dt;
+                Assert.AreEqual(4.8 * mul, a0, 0.05, $"launch accel for mul={mul} ({source})");
+
+                for (int i = 0; i < 1200; i++)
+                    GroundModel.Step(ref st, in inp, p, roadOracle, GroundModel.Dt);
+                Assert.AreEqual(27.0 * mul, st.Speed, 1e-2, $"terminal speed for mul={mul} ({source})");
+            }
+        }
