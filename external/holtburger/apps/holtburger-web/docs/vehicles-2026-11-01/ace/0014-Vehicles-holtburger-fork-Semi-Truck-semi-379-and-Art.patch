+                heading = nearbyTractor.GroundState.Heading;
+                var spec = TrailerKinematics.ResolveSpec(wcid);
+                var fw = TrailerKinematics.ComputeFifthWheelPose(nearbyTractor.GroundState, nearbyTractor.Profile.FifthWheelOffsetY, nearbyTractor.Profile.FifthWheelOffsetZ);
+                fx = fw.x - Math.Sin(heading) * (spec.KpY + 0.5);
+                fy = fw.y - Math.Cos(heading) * (spec.KpY + 0.5);
+            }
+            else
+            {
+                fx = px + Math.Sin(heading) * 6.0;
+                fy = py + Math.Cos(heading) * 6.0;
+            }
+            var refZ = nearbyTractor != null ? nearbyTractor.GroundState.Z : pz;
+            var groundZ = VehicleManager.SampleTrailerTerrainZ(fx, fy, refZ);
+            double fz = double.IsFinite(groundZ) ? groundZ : refZ;
+            return Vehicle.ToPosition(fx, fy, fz, Vehicle.YawOnly(heading));
+        }
+
+        [CommandHandler("trailer", AccessLevel.Developer, CommandHandlerFlag.RequiresWorld, 1,
+            "Articulated semi-trailer chassis & container hauling commands.",
+            "spawn <20|40> [x y z]                        - spawn 20ft (4000030) or 40ft (4000031) chassis\n" +
+            "hitch [trailerGuid] [vehicleGuid]            - hitch trailer to semi-tractor fifth wheel\n" +
+            "unhitch [vehicleGuid]                        - unhitch trailer and lower landing gear\n" +
+            "mount <containerGuid> [front|rear|center] [trailerGuid] - mount ISO container onto trailer deck\n" +
+            "unmount [trailerGuid]                        - unmount container onto ground\n" +
+            "twistlock [trailerGuid]                      - toggle trailer twistlocks\n" +
+            "preset <rig20|rig40|rig40hc>                 - spawn complete coupled tractor + trailer + container rig\n" +
+            "list                                         - list active trailers\n" +
+            "despawn [guid|all]                           - despawn trailer(s)")]
+        public static void HandleTrailer(Session session, params string[] parameters)
+        {
+            var player = session.Player;
+            if (parameters.Length == 0)
+            {
+                CommandHandlerHelper.WriteOutputInfo(session, "usage: @trailer spawn | hitch | unhitch | mount | unmount | twistlock | preset | list | despawn");
+                return;
+            }
+
+            switch (parameters[0].ToLowerInvariant())
+            {
+                case "spawn":
+                {
+                    if (parameters.Length < 2)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @trailer spawn <20|40> [x y z]");
+                        return;
+                    }
+
+                    uint wcid = 0;
+                    var typeArg = parameters[1].ToLowerInvariant();
+                    if (typeArg is "20" or "20ft" or "4000030") wcid = Deployables.SemiTrailerDeployable.WcidChassis20;
+                    else if (typeArg is "40" or "40ft" or "4000031") wcid = Deployables.SemiTrailerDeployable.WcidChassis40;
+                    else uint.TryParse(parameters[1], out wcid);
+
+                    if (wcid != Deployables.SemiTrailerDeployable.WcidChassis20 && wcid != Deployables.SemiTrailerDeployable.WcidChassis40)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "invalid trailer type (must be 20, 40, 4000030, or 4000031)");
+                        return;
+                    }
+
+                    Position spawnPos;
+                    if (parameters.Length >= 5 &&
+                        float.TryParse(parameters[2], out var sx) &&
+                        float.TryParse(parameters[3], out var sy) &&
+                        float.TryParse(parameters[4], out var sz))
+                    {
+                        double heading = player.Location != null ? VehicleManager.HeadingOf(player.Location.Rotation) : 0.0;
+                        spawnPos = Vehicle.ToPosition(sx, sy, sz, Vehicle.YawOnly(heading));
+                    }
+                    else
+                    {
+                        spawnPos = ComputeTrailerSpawnPosition(player, wcid);
+                    }
+
+                    var t = Deployables.DeployableManager.SpawnDeployable(wcid, spawnPos, player) as Deployables.SemiTrailerDeployable;
+                    if (t != null)
+                        CommandHandlerHelper.WriteOutputInfo(session, $"spawned trailer {t.Name} (0x{t.Guid.Full:X8}) at {spawnPos.ToLOCString()}");
+                    else
+                        CommandHandlerHelper.WriteOutputInfo(session, $"failed to spawn trailer wcid {wcid}");
+                    return;
+                }
+
+                case "hitch":
+                {
+                    Deployables.SemiTrailerDeployable trailer = null;
+                    Vehicle tractor = null;
+
+                    if (parameters.Length > 1 && TryParseGuid(parameters[1], out var tGuid))
+                        trailer = Deployables.DeployableManager.GetDeployable(tGuid) as Deployables.SemiTrailerDeployable;
+                    if (parameters.Length > 2 && TryParseGuid(parameters[2], out var vGuid))
+                        tractor = VehicleManager.Get(vGuid);
+
+                    tractor ??= VehicleManager.VehicleOf(player) ?? VehicleManager.All
+                        .Where(v => !v.IsDestroyed && v.Profile.Locomotion == VehicleLocomotion.Ground && v.Profile.FifthWheelOffsetY != 0f && v.HitchedTrailerGuid == 0)
+                        .OrderBy(v => GlobalDistSq(player, v.State.X, v.State.Y, v.State.Z))
+                        .FirstOrDefault();
+
+                    if (trailer == null && tractor != null)
+                    {
+                        var fw = TrailerKinematics.ComputeFifthWheelPose(tractor.GroundState, tractor.Profile.FifthWheelOffsetY, tractor.Profile.FifthWheelOffsetZ);
+                        trailer = Deployables.DeployableManager.GetAll().OfType<Deployables.SemiTrailerDeployable>()
+                            .Where(t => !t.IsDestroyed && t.IsActive && !t.IsPacked && t.CoupledTractorGuid == 0)
+                            .OrderBy(t =>
+                            {
+                                var kp = t.GetKingpinGlobalPose();
+                                return (fw.x - kp.x) * (fw.x - kp.x) + (fw.y - kp.y) * (fw.y - kp.y) + (fw.z - kp.z) * (fw.z - kp.z);
+                            })
+                            .FirstOrDefault();
+                    }
+
+                    if (tractor == null || trailer == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "no eligible semi-tractor or unhitched trailer found");
+                        return;
+                    }
+
+                    if (VehicleManager.TryHitchTrailer(tractor, trailer, player, out var err))
+                        CommandHandlerHelper.WriteOutputInfo(session, $"hitched trailer 0x{trailer.Guid.Full:X8} to tractor 0x{tractor.Guid.Full:X8}");
+                    else
+                        CommandHandlerHelper.WriteOutputInfo(session, $"hitch failed: {err}");
+                    return;
+                }
+
+                case "unhitch":
+                {
+                    Vehicle tractor = null;
+                    if (parameters.Length > 1 && TryParseGuid(parameters[1], out var vGuid))
+                        tractor = VehicleManager.Get(vGuid);
+
+                    tractor ??= VehicleManager.VehicleOf(player) ?? VehicleManager.All
+                        .Where(v => !v.IsDestroyed && v.HitchedTrailerGuid != 0)
+                        .OrderBy(v => GlobalDistSq(player, v.State.X, v.State.Y, v.State.Z))
+                        .FirstOrDefault();
+
+                    if (tractor == null || tractor.HitchedTrailerGuid == 0)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "no coupled tractor found");
+                        return;
+                    }
+
+                    var tGuid = tractor.HitchedTrailerGuid;
+                    var trailer = Deployables.DeployableManager.GetDeployable(tGuid) as Deployables.SemiTrailerDeployable;
+                    VehicleManager.UnhitchTrailer(tractor, trailer, player, broadcastEvents: true);
+                    CommandHandlerHelper.WriteOutputInfo(session, $"unhitched trailer 0x{tGuid:X8} from tractor 0x{tractor.Guid.Full:X8}");
+                    return;
+                }
+
+                case "mount":
+                {
+                    if (parameters.Length < 2 || !TryParseGuid(parameters[1], out var cGuid))
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @trailer mount <containerGuid> [front|rear|center] [trailerGuid]");
+                        return;
+                    }
+
+                    var container = Deployables.DeployableManager.GetDeployable(cGuid) as Deployables.IsoContainerDeployable;
+                    if (container == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"container 0x{cGuid:X8} not found");
+                        return;
+                    }
+
+                    byte slot = 0;
+                    bool explicitCenter = false;
+                    int trailerArgIdx = 2;
+                    if (parameters.Length > 2)
+                    {
+                        var slotArg = parameters[2].ToLowerInvariant();
+                        if (slotArg is "front" or "1") { slot = 1; trailerArgIdx = 3; }
+                        else if (slotArg is "rear" or "2") { slot = 2; trailerArgIdx = 3; }
+                        else if (slotArg is "center" or "0") { slot = 0; explicitCenter = true; trailerArgIdx = 3; }
+                    }
+
+                    Deployables.SemiTrailerDeployable trailer = null;
+                    if (parameters.Length > trailerArgIdx && TryParseGuid(parameters[trailerArgIdx], out var tGuid))
+                        trailer = Deployables.DeployableManager.GetDeployable(tGuid) as Deployables.SemiTrailerDeployable;
+
+                    trailer ??= Deployables.DeployableManager.GetAll().OfType<Deployables.SemiTrailerDeployable>()
+                        .Where(t => !t.IsDestroyed && t.IsActive && !t.IsPacked)
+                        .OrderBy(t =>
+                        {
+                            var (tx, ty, tz) = t.GetGlobalPose();
+                            return GlobalDistSq(player, tx, ty, tz);
+                        })
+                        .FirstOrDefault();
+
+                    if (trailer == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "no trailer found");
+                        return;
+                    }
+
+                    if (trailer.TryMountContainer(container, slot, out var err, explicitCenter))
+                    {
+                        var tractor = trailer.CoupledTractorGuid != 0 ? VehicleManager.Get(trailer.CoupledTractorGuid) : null;
+                        VehicleManager.MoveAuxWorldObject(container, container.Location, tractor);
+                        if (tractor != null)
+                        {
+                            tractor.TrailerFlags = trailer.ComputeTrailerFlags();
+                            tractor.GroundState.TowMassMul = TrailerKinematics.TowMassLoaded;
+                            tractor.PilotStateAcc = 1.0;
+                            tractor.ObserverStateAcc = 1.0;
+                        }
+                        CommandHandlerHelper.WriteOutputInfo(session, $"mounted container 0x{cGuid:X8} onto trailer 0x{trailer.Guid.Full:X8} (slot {slot})");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"mount failed: {err}");
+                    }
+                    return;
+                }
+
+                case "unmount":
+                {
+                    Deployables.SemiTrailerDeployable trailer = null;
+                    if (parameters.Length > 1 && TryParseGuid(parameters[1], out var tGuid))
+                        trailer = Deployables.DeployableManager.GetDeployable(tGuid) as Deployables.SemiTrailerDeployable;
+
+                    trailer ??= Deployables.DeployableManager.GetAll().OfType<Deployables.SemiTrailerDeployable>()
+                        .Where(t => !t.IsDestroyed && t.MountedContainerGuid != 0)
+                        .OrderBy(t =>
+                        {
+                            var (tx, ty, tz) = t.GetGlobalPose();
+                            return GlobalDistSq(player, tx, ty, tz);
+                        })
+                        .FirstOrDefault();
+
+                    if (trailer == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "no trailer with mounted container found");
+                        return;
+                    }
+
+                    var cGuid = trailer.MountedContainerGuid;
+                    var container = Deployables.DeployableManager.GetDeployable(cGuid) as Deployables.IsoContainerDeployable;
+                    if (trailer.UnmountContainer(out var err, snapToGround: true))
+                    {
+                        var tractor = trailer.CoupledTractorGuid != 0 ? VehicleManager.Get(trailer.CoupledTractorGuid) : null;
+                        if (container != null && !container.IsDestroyed)
+                            VehicleManager.MoveAuxWorldObject(container, container.Location, tractor);
+                        if (tractor != null)
+                        {
+                            tractor.TrailerFlags = trailer.ComputeTrailerFlags();
+                            tractor.GroundState.TowMassMul = TrailerKinematics.TowMassEmptyChassis;
+                            tractor.PilotStateAcc = 1.0;
+                            tractor.ObserverStateAcc = 1.0;
+                        }
+                        CommandHandlerHelper.WriteOutputInfo(session, $"unmounted container 0x{cGuid:X8} from trailer 0x{trailer.Guid.Full:X8}");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"unmount failed: {err}");
+                    }
+                    return;
+                }
+
+                case "twistlock":
+                {
+                    Deployables.SemiTrailerDeployable trailer = null;
+                    if (parameters.Length > 1 && TryParseGuid(parameters[1], out var tGuid))
+                        trailer = Deployables.DeployableManager.GetDeployable(tGuid) as Deployables.SemiTrailerDeployable;
+
+                    trailer ??= Deployables.DeployableManager.GetAll().OfType<Deployables.SemiTrailerDeployable>()
+                        .Where(t => !t.IsDestroyed && t.IsActive && !t.IsPacked)
+                        .OrderBy(t =>
+                        {
+                            var (tx, ty, tz) = t.GetGlobalPose();
+                            return GlobalDistSq(player, tx, ty, tz);
+                        })
+                        .FirstOrDefault();
+
+                    if (trailer == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "no trailer found");
+                        return;
+                    }
+
+                    var act = new VehicleTrailerAction
+                    {
+                        TrailerGuid = trailer.Guid.Full,
+                        VehicleGuid = trailer.CoupledTractorGuid,
+                        Action = (byte)TrailerActionKind.ToggleTwistlock,
+                    };
+                    if (VehicleManager.HandleTrailerAction(player, act, out var err))
+                        CommandHandlerHelper.WriteOutputInfo(session, $"trailer 0x{trailer.Guid.Full:X8} twistlocks -> {(trailer.TwistlockLocked ? "LOCKED" : "UNLOCKED")}");
+                    else
+                        CommandHandlerHelper.WriteOutputInfo(session, $"twistlock failed: {err}");
+                    return;
+                }
+
+                case "preset":
+                {
+                    var presetName = parameters.Length > 1 ? parameters[1].ToLowerInvariant() : "rig40hc";
+                    if (presetName is not ("rig20" or "rig40" or "rig40hc"))
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @trailer preset <rig20|rig40|rig40hc>");
+                        return;
+                    }
+
+                    byte liveryId = presetName == "rig20" ? (byte)1 : (byte)0;
+                    uint trailerWcid = presetName == "rig20"
+                        ? Deployables.SemiTrailerDeployable.WcidChassis20
+                        : Deployables.SemiTrailerDeployable.WcidChassis40;
+                    uint containerWcid = presetName switch
+                    {
+                        "rig20" => Deployables.IsoContainerDeployable.Wcid20ft,
+                        "rig40" => Deployables.IsoContainerDeployable.Wcid40ft,
+                        _ => Deployables.IsoContainerDeployable.Wcid40ftHC,
+                    };
+
+                    var profile = VehicleProfile.Semi379(liveryId);
+                    var tractor = VehicleManager.Spawn(player, profile, out var spawnErr, spawnDist: 14.0);
+                    if (tractor == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"preset spawn failed: {spawnErr}");
+                        return;
+                    }
+
+                    var h = tractor.GroundState.Heading;
+                    var spec = TrailerKinematics.ResolveSpec(trailerWcid);
+                    var fw = TrailerKinematics.ComputeFifthWheelPose(tractor.GroundState, profile.FifthWheelOffsetY, profile.FifthWheelOffsetZ);
+                    var trX = fw.x - Math.Sin(h) * spec.KpY;
+                    var trY = fw.y - Math.Cos(h) * spec.KpY;
+                    var trZ = fw.z - spec.KingpinZ;
+                    var trPos = Vehicle.ToPosition(trX, trY, trZ, Vehicle.YawOnly(h));
+
+                    var trailer = Deployables.DeployableManager.SpawnDeployable(trailerWcid, trPos, player, tractor) as Deployables.SemiTrailerDeployable;
+                    if (trailer == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "preset failed to spawn trailer chassis");
+                        return;
+                    }
+                    trailer.SetWorldPose(trX, trY, trZ, h, 0.0, 0.0);
+
+                    var cPos = Vehicle.ToPosition(trX, trY, trZ + spec.DeckZ, Vehicle.YawOnly(h));
+                    var container = Deployables.DeployableManager.SpawnDeployable(containerWcid, cPos, player, tractor) as Deployables.IsoContainerDeployable;
+                    if (container == null)
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "preset failed to spawn ISO container");
+                        return;
+                    }
+                    if (presetName == "rig40hc")
+                        container.LiveryId = 1; // Maritime Blue
+
+                    trailer.TryMountContainer(container, 0, out _);
+                    VehicleManager.TryHitchTrailer(tractor, trailer, player, out _);
+
+                    CommandHandlerHelper.WriteOutputInfo(session,
+                        $"spawned {presetName}: tractor 0x{tractor.Guid.Full:X8} + trailer 0x{trailer.Guid.Full:X8} + container 0x{container.Guid.Full:X8}");
+                    return;
+                }
+
+                case "list":
+                {
+                    var trailers = Deployables.DeployableManager.GetAll().OfType<Deployables.SemiTrailerDeployable>().ToList();
+                    var sb = new System.Text.StringBuilder();
+                    sb.AppendLine($"Semi-Trailers: {trailers.Count} active");
+                    foreach (var t in trailers)
+                    {
+                        sb.AppendLine($"  0x{t.Guid.Full:X8} | {t.Kind} (WCID {t.Wcid}) | Tractor: 0x{t.CoupledTractorGuid:X8} | Container: 0x{t.MountedContainerGuid:X8} | Twistlock: {(t.TwistlockLocked ? "LOCKED" : "OPEN")} | Gear: {(t.LandingGearRetracted ? "UP" : "DOWN")}");
+                    }
+                    CommandHandlerHelper.WriteOutputInfo(session, sb.ToString().TrimEnd());
+                    return;
+                }
+
+                case "despawn":
+                {
+                    if (parameters.Length > 1 && parameters[1].Equals("all", StringComparison.OrdinalIgnoreCase))
+                    {
+                        var all = Deployables.DeployableManager.GetAll().OfType<Deployables.SemiTrailerDeployable>().ToList();
+                        foreach (var tr in all)
+                            tr.Destroy();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"despawned {all.Count} trailer(s)");
+                        return;
+                    }
+
+                    if (parameters.Length < 2 || !TryParseGuid(parameters[1], out var guid))
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, "usage: @trailer despawn <guid|all>");
+                        return;
+                    }
+
+                    var target = Deployables.DeployableManager.GetDeployable(guid) as Deployables.SemiTrailerDeployable;
+                    if (target != null)
+                    {
+                        target.Destroy();
+                        CommandHandlerHelper.WriteOutputInfo(session, $"despawned trailer 0x{guid:X8}");
+                    }
+                    else
+                    {
+                        CommandHandlerHelper.WriteOutputInfo(session, $"trailer 0x{guid:X8} not found");
+                    }
+                    return;
+                }
+
+                default:
+                    CommandHandlerHelper.WriteOutputInfo(session, "usage: @trailer spawn | hitch | unhitch | mount | unmount | twistlock | preset | list | despawn");
+                    return;
+            }
+        }
     }
 }
