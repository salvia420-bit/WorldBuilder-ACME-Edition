+        [TestMethod]
+        public void Hbv1TruncatedV6AndTrailerRejected()
+        {
+            foreach (var (name, dir, op) in new[] {
+                ("vehicle_profile_semi", "S2C", VehicleWire.OpProfile),
+                ("vehicle_state_coupled", "S2C", VehicleWire.OpState),
+                ("vehicle_trailer_action", "C2S", VehicleWire.OpTrailerAction),
+                ("vehicle_trailer_state", "S2C", VehicleWire.OpTrailerState) })
+            {
+                var bytes = Hex(Fixture(name).GetProperty("hex").GetString());
+                foreach (var cut in new[] { bytes.Length - 1, bytes.Length - 4, 12, 8, 4 })
+                    Assert.IsNull(Read(dir, op, bytes.Take(cut).ToArray()), $"{name} cut {cut}");
+            }
+
+            // Bad tag and version 0 rejected for 0x090F
+            var good = Hex(Fixture("vehicle_trailer_state").GetProperty("hex").GetString());
+            var badTag = (byte[])good.Clone();
+            badTag[0] = 0x00;
+            Assert.IsNull(Read("S2C", VehicleWire.OpTrailerState, badTag));
+
+            var verZero = (byte[])good.Clone();
+            verZero[4] = 0x00;
+            verZero[5] = 0x00;
+            Assert.IsNull(Read("S2C", VehicleWire.OpTrailerState, verZero));
+        }
