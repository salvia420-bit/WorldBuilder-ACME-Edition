+    /// Semi-trailer chassis deployable (20-ft skeletal WCID 4000030, 40-ft gooseneck WCID 4000031).
+    /// Subclasses DeployableBase; excluded from shard DB persistence.
+    /// Uses stand-in Setup 0x0200026B; capable clients render the procedural chassis and mounted container.
+    /// </summary>
+    public class SemiTrailerDeployable : DeployableBase
+    {
+        public const uint WcidChassis20 = TrailerKinematics.WcidChassis20;
+        public const uint WcidChassis40 = TrailerKinematics.WcidChassis40;
+        public const uint StandInSetup = 0x0200026B;
+
+        public TrailerSpec Spec { get; private set; }
+        public uint CoupledTractorGuid { get; set; }
+        public uint MountedContainerGuid { get; set; }
+        public byte ContainerSlot { get; set; }
+        public bool ContainerExplicitCenter { get; set; }
+        public bool TwistlockLocked { get; set; }
+        public bool LandingGearRetracted { get; set; }
+        public bool BrakeLights { get; set; }
+
+        private double _headingRad;
+        private bool _hasPose;
+
+        public double HeadingRad
+        {
+            get => _hasPose || Location == null ? _headingRad : VehicleManager.HeadingOf(Location.Rotation);
+            private set { _headingRad = value; _hasPose = true; }
+        }
+        public double PitchRadD { get; private set; }
+        public double BankRad { get; private set; }
+
+        private Vector3? _customGlobalPos;
+
+        public override string Name => Wcid == WcidChassis40
+            ? "40-ft Gooseneck Container Chassis"
+            : "20-ft Skeletal Container Chassis";
+
+        public SemiTrailerDeployable(Weenie weenie, ObjectGuid guid, Vehicle parentVehicle = null, Player deployer = null)
+            : base(weenie, guid, parentVehicle, deployer)
+        {
+            Pallet = PalletSize.None;
+            InitializeTrailer(weenie.WeenieClassId);
+        }
+
+        public SemiTrailerDeployable(uint wcid, Vector3? globalPos = null, float heading = 0f)
+            : base(BuildWeenie(wcid), new ObjectGuid(0x75000000u | ((uint)new Random().Next(0x00010000, 0x000FFFFF))), null, null)
+        {
+            Pallet = PalletSize.None;
+            InitializeTrailer(wcid);
+            if (globalPos.HasValue)
+                SetWorldPose(globalPos.Value.X, globalPos.Value.Y, globalPos.Value.Z, heading, 0.0, 0.0);
+            else
+                HeadingRad = GroundModel.WrapHeading(heading);
+        }
+
+        public void SyncFromLocation()
+        {
+            if (Location == null) return;
+            _headingRad = VehicleManager.HeadingOf(Location.Rotation);
+            _hasPose = true;
+            YawRad = (float)_headingRad;
+        }
+
+        private void InitializeTrailer(uint wcid)
+        {
+            if (wcid == WcidChassis40)
+            {
+                Kind = DeployableKind.TrailerChassis40;
+                Spec = TrailerKinematics.Chassis40;
+            }
+            else
+            {
+                Kind = DeployableKind.TrailerChassis20;
+                Spec = TrailerKinematics.Chassis20;
+            }
+        }
+
+        public static Weenie BuildWeenie(uint wcid, Vehicle parentVehicle = null, Player deployer = null)
+        {
+            if (wcid == WcidChassis40)
+            {
+                return BuildDeployableWeenie(
+                    WcidChassis40,
+                    "hbtrailer_40ft",
+                    "40-ft Gooseneck Container Chassis",
+                    "40-ft gooseneck intermodal container chassis. Hitch to a semi-tractor with G or @trailer hitch.");
+            }
+            return BuildDeployableWeenie(
+                WcidChassis20,
+                "hbtrailer_20ft",
+                "20-ft Skeletal Container Chassis",
+                "20-ft skeletal intermodal container chassis. Hitch to a semi-tractor with G or @trailer hitch.");
+        }
+
+        public (double x, double y, double z) GetGlobalPose()
+        {
+            if (Location != null)
+                return Vehicle.ToGlobal(Location);
+            if (_customGlobalPos.HasValue)
+                return (_customGlobalPos.Value.X, _customGlobalPos.Value.Y, _customGlobalPos.Value.Z);
+            return (0.0, 0.0, 0.0);
+        }
+
+        public (double x, double y, double z) GetKingpinGlobalPose()
+        {
+            var (tx, ty, tz) = GetGlobalPose();
+            var (kx, ky, kz) = TrailerKinematics.RotateByOrientation(HeadingRad, PitchRadD, BankRad, 0.0, Spec.KpY, Spec.KingpinZ);
+            return (tx + kx, ty + ky, tz + kz);
+        }
+
+        public void SetWorldPose(double gx, double gy, double gz, double heading, double pitch = 0.0, double bank = 0.0)
+        {
+            var wrappedH = GroundModel.WrapHeading(heading);
+            HeadingRad = wrappedH;
+            PitchRadD = pitch;
+            BankRad = bank;
+            YawRad = (float)wrappedH;
+            PitchRad = (float)pitch;
+            RollRad = (float)bank;
+            _customGlobalPos = null;
+            if (Location != null && !PendingRelocateFromLandblock.HasValue)
+                PendingRelocateFromLandblock = Location.LandblockId;
+            Location = Vehicle.ToPosition(gx, gy, gz, Vehicle.Orientation(wrappedH, pitch, bank));
+        }
+
+        public void SetCustomGlobalPoseForTest(double gx, double gy, double gz, double heading, double pitch = 0.0, double bank = 0.0)
+        {
+            var wrappedH = GroundModel.WrapHeading(heading);
+            HeadingRad = wrappedH;
+            PitchRadD = pitch;
+            BankRad = bank;
+            YawRad = (float)wrappedH;
+            PitchRad = (float)pitch;
+            RollRad = (float)bank;
+            _customGlobalPos = new Vector3((float)gx, (float)gy, (float)gz);
+        }
+
+        public byte ComputeTrailerFlags()
+        {
+            byte flags = 0;
+            if (CoupledTractorGuid != 0) flags |= TrailerFlags.Coupled;
+            if (TwistlockLocked) flags |= TrailerFlags.TwistlocksLocked;
+            if (LandingGearRetracted) flags |= TrailerFlags.GearRetracted;
+            if (BrakeLights) flags |= TrailerFlags.BrakeLights;
+            return flags;
+        }
+
+        public bool CanFitContainer(IsoContainerDeployable container)
+        {
+            if (container == null) return false;
+            if (Wcid == WcidChassis20)
+                return container.Wcid == IsoContainerDeployable.Wcid20ft;
+            if (Wcid == WcidChassis40)
+            {
+                return container.Wcid == IsoContainerDeployable.Wcid20ft
+                    || container.Wcid == IsoContainerDeployable.Wcid40ft
+                    || container.Wcid == IsoContainerDeployable.Wcid40ftHC;
+            }
+            return false;
+        }
+
+        public bool TryMountContainer(IsoContainerDeployable container, byte slot, out string error, bool explicitCenter = false)
+        {
+            if (container == null || container.IsDestroyed || !container.IsActive || container.IsPacked)
+            {
+                error = "Target container is unavailable.";
+                return false;
+            }
+            if (MountedContainerGuid != 0)
+            {
+                error = "Trailer already carries a mounted container.";
+                return false;
+            }
+            if (container.MountedOnTrailerGuid != 0 && container.MountedOnTrailerGuid != Guid.Full)
+            {
+                error = "Container is already mounted on another trailer.";
+                return false;
+            }
+            if (!CanFitContainer(container))
+            {
+                error = Wcid == WcidChassis20
+                    ? "20-ft skeletal chassis can only mount a 20-ft ISO container."
+                    : "Incompatible container for this trailer chassis.";
+                return false;
+            }
+
+            MountedContainerGuid = container.Guid.Full;
+            ContainerSlot = slot;
+            ContainerExplicitCenter = explicitCenter;
+            TwistlockLocked = true;
+            container.MountedOnTrailerGuid = Guid.Full;
+
+            SyncMountedContainerPose(container);
+            BroadcastState();
+            container.BroadcastState();
+
+            error = null;
+            return true;
+        }
+
+        public void SyncMountedContainerPose(IsoContainerDeployable container)
+        {
+            if (container == null) return;
+            var (tx, ty, tz) = GetGlobalPose();
+            var spec = Spec;
+            var pose = TrailerKinematics.ComputeMountedContainerPose(
+                tx, ty, tz,
+                HeadingRad, PitchRadD, BankRad,
+                in spec,
+                container.ExternalDimensions.Y,
+                ContainerSlot,
+                ContainerExplicitCenter);
+            container.SetWorldPose(pose.X, pose.Y, pose.Z, pose.Heading, pose.Pitch, pose.Bank);
+        }
+
+        public bool UnmountContainer(out string error, bool snapToGround = true, Func<double, double, double> groundZLookup = null)
+        {
+            if (MountedContainerGuid == 0)
+            {
+                error = "No container mounted on this trailer.";
+                return false;
+            }
+
+            var container = DeployableManager.GetDeployable(MountedContainerGuid) as IsoContainerDeployable;
+            MountedContainerGuid = 0;
+            ContainerSlot = 0;
+            ContainerExplicitCenter = false;
+            TwistlockLocked = false;
+
+            if (container != null && !container.IsDestroyed)
+            {
+                container.MountedOnTrailerGuid = 0;
+                if (snapToGround)
+                {
+                    var (cx, cy, cz) = container.Location != null
+                        ? Vehicle.ToGlobal(container.Location)
+                        : (container.Position.X, container.Position.Y, container.Position.Z);
+                    var gz = groundZLookup != null ? groundZLookup(cx, cy) : VehicleManager.SampleTrailerTerrainZ(cx, cy, cz - Spec.DeckZ);
+                    var targetZ = double.IsFinite(gz) ? gz : Math.Max(0.0, cz - Spec.DeckZ);
+                    container.SetWorldPose(cx, cy, targetZ, container.HeadingRad, 0.0, 0.0);
+                }
+                container.BroadcastState();
+            }
+
+            BroadcastState();
+            error = null;
+            return true;
+        }
+
+        public VehicleTrailerStateMsg CreateTrailerStateMsg()
+        {
+            return new VehicleTrailerStateMsg
+            {
+                TrailerGuid = Guid.Full,
+                Kind = (uint)Kind,
+                Cell = Location?.Cell ?? 0,
+                Position = Location != null ? Location.Pos : Vector3.Zero, // wire contract: landblock-local Location.Pos
+                Heading = (float)HeadingRad,
+                Pitch = (float)PitchRadD,
+                Bank = (float)BankRad,
+                CoupledTractorGuid = CoupledTractorGuid,
+                MountedContainerGuid = MountedContainerGuid,
+                ContainerSlot = ContainerSlot,
+                TrailerFlags = ComputeTrailerFlags(),
+                Reserved = 0,
+                OwnerGuid = DeployerPlayerGuid,
+            };
+        }
+
+        public override void BroadcastState(float range = 600.0f)
+        {
+            if (Location == null) return;
+            var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+            VehicleManager.BroadcastNear(Location, range, deployer, () => CreateTrailerStateMsg());
+        }
+
+        public override void Destroy(bool raiseNotifyOfDestructionEvent = true, bool fromLandblockUnload = false)
+        {
+            if (IsDestroyed) return;
+
+            if (CoupledTractorGuid != 0)
+            {
+                var tractor = VehicleManager.Get(CoupledTractorGuid);
+                if (tractor != null && tractor.HitchedTrailerGuid == Guid.Full)
+                {
+                    tractor.HitchedTrailerGuid = 0;
+                    tractor.TrailerHeading = 0f;
+                    tractor.TrailerPitch = 0f;
+                    tractor.TrailerFlags = 0;
+                    tractor.TrailerState = default;
+                    tractor.GroundState.TowMassMul = TrailerKinematics.TowMassBobtail;
+                    tractor.PilotStateAcc = 1.0;
+                    tractor.ObserverStateAcc = 1.0;
+                }
+                CoupledTractorGuid = 0;
+            }
+
+            if (!fromLandblockUnload && Location != null && PhysicsObj != null)
+            {
+                var deployer = DeployerPlayerGuid != 0 ? PlayerManager.GetOnlinePlayer(DeployerPlayerGuid) : null;
+                var at = new Position(Location);
+                var guid = Guid.Full;
+                VehicleManager.BroadcastNear(at, 600.0f, deployer, () => new VehicleEventMsg
+                {
+                    Vehicle = guid,
+                    Kind = (uint)VehicleEventKind.Despawn,
+                    Step = 0,
+                    Subject = guid,
+                    Cell = at.Cell,
+                    Position = at.Pos,
+                    Value = 0f,
+                });
+            }
+
+            if (MountedContainerGuid != 0)
+            {
+                var container = DeployableManager.GetDeployable(MountedContainerGuid) as IsoContainerDeployable;
+                MountedContainerGuid = 0;
+                ContainerSlot = 0;
+                ContainerExplicitCenter = false;
+                TwistlockLocked = false;
+                if (container != null && !container.IsDestroyed)
+                {
+                    container.MountedOnTrailerGuid = 0;
+                    if (!fromLandblockUnload)
+                    {
+                        var (cx, cy, cz) = container.Location != null
+                            ? Vehicle.ToGlobal(container.Location)
+                            : (container.Position.X, container.Position.Y, container.Position.Z);
+                        var gz = VehicleManager.SampleTrailerTerrainZ(cx, cy, cz - Spec.DeckZ);
+                        var targetZ = double.IsFinite(gz) ? gz : Math.Max(0.0, cz - Spec.DeckZ);
+                        container.SetWorldPose(cx, cy, targetZ, container.HeadingRad, 0.0, 0.0);
+                        VehicleManager.MoveAuxWorldObject(container, container.Location, null);
+                        container.BroadcastState();
+                    }
+                }
+            }
+
+            base.Destroy(raiseNotifyOfDestructionEvent, fromLandblockUnload);
+        }
+    }
+}
