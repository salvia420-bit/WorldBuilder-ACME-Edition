+            uint gridKey = ((uint)lbX << 24) | ((uint)lbY << 16);
+            var gridsField = typeof(VehicleTerrain).GetField("grids", BindingFlags.Static | BindingFlags.NonPublic);
+            var grids = (ConcurrentDictionary<uint, LandblockGrid>)gridsField?.GetValue(null);
+            Assert.IsNotNull(grids);
+            bool hadPrev = grids.TryGetValue(gridKey, out var prevGrid);
+
+            try
+            {
+                var flatMinus5 = new float[81];
+                Array.Fill(flatMinus5, -5.0f);
+                grids[gridKey] = new LandblockGrid { Heights = flatMinus5 };
+                VehicleColliderCache.BridgeSupportOverride = (_, _, _) => new BridgeSupport { Found = true, DeckZ = 55.0, Nz = 1.0 };
+
+                double gx = lbX * 192.0 + 50.0;
+                double gy = lbY * 192.0 + 50.0;
+                Assert.AreEqual(-5.0, VehicleTerrain.Ground(gx, gy), 1e-3, "underlying terrain grid is -5.0m");
+
+                // 1) UnmountContainer on 55.0m bridge over -5.0m terrain keeps container at 55.0m
+                var tr1 = RegisterTestTrailer(0x75005001u, SemiTrailerDeployable.WcidChassis40, gx, gy, 55.0);
+                var c1 = RegisterTestContainer(0x75005002u, IsoContainerDeployable.Wcid40ftHC, gx, gy, 55.0);
+                Assert.IsTrue(tr1.TryMountContainer(c1, 0, out _));
+                Assert.AreEqual(56.32, c1.Position.Z, 1e-3);
+                Assert.IsTrue(tr1.UnmountContainer(out _, snapToGround: true));
+                Assert.AreEqual(55.0, c1.Position.Z, 1e-3, "UnmountContainer must snap to bridge DeckZ 55.0m, not terrain -5.0m");
+
+                // 2) SemiTrailerDeployable.Destroy on 55.0m bridge over -5.0m terrain keeps container at 55.0m
+                var tr2 = RegisterTestTrailer(0x75005003u, SemiTrailerDeployable.WcidChassis40, gx + 20.0, gy, 55.0);
+                var c2 = RegisterTestContainer(0x75005004u, IsoContainerDeployable.Wcid40ftHC, gx + 20.0, gy, 55.0);
+                Assert.IsTrue(tr2.TryMountContainer(c2, 0, out _));
+                tr2.Destroy(true, false);
+                Assert.AreEqual(55.0, c2.Position.Z, 1e-3, "SemiTrailerDeployable.Destroy must snap container to bridge DeckZ 55.0m, not terrain -5.0m");
+            }
+            finally
+            {
+                if (hadPrev) grids[gridKey] = prevGrid;
+                else grids.TryRemove(gridKey, out _);
