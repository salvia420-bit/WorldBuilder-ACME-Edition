+        [TestMethod]
+        public void TrailerKinematicsForwardReverseJackknifeAndSlopedKingpin()
+        {
+            Assert.AreEqual(2.80, TrailerKinematics.Chassis20.KpY, 1e-9);
+            Assert.AreEqual(-1.895, TrailerKinematics.Chassis20.BogieY, 1e-9);
+            Assert.AreEqual(4.695, TrailerKinematics.Chassis20.Wheelbase, 1e-9);
+            Assert.AreEqual(5.35, TrailerKinematics.Chassis40.KpY, 1e-9);
+            Assert.AreEqual(-4.445, TrailerKinematics.Chassis40.BogieY, 1e-9);
+            Assert.AreEqual(9.795, TrailerKinematics.Chassis40.Wheelbase, 1e-9);
+            Assert.AreEqual(TrailerKinematics.MaxJackknifeRad, Deg(72.0), 1e-12);
+
+            var semiParams = GroundParams.FromProfile(VehicleProfile.Semi379());
+            GroundOracle flat40 = (x, y, z) => new TerrainSample { Z = 40.0, Nz = 1, Surface = GroundModel.Surfaces[0] };
+
+            // 1. Forward alignment convergence (20ft and 40ft from +-35 deg)
+            foreach (var kind in new[] { "20ft", "40ft" })
+            {
+                var spec = TrailerKinematics.ResolveSpec(kind);
+                foreach (var initDeg in new[] { 35.0, -35.0 })
+                {
+                    var tractor = new GroundState { X = 1000, Y = 1000, Z = 40, Speed = 12.0, Mode = VehicleMode.Driving };
+                    var tr = new TrailerKinematicState { Heading = Deg(initDeg) };
+                    double prevErr = Math.Abs(TrailerKinematics.WrapPi(tractor.Heading - tr.Heading));
+
+                    for (int step = 0; step < 120; step++)
+                    {
+                        GroundModel.Step(ref tractor, new GroundInput { Throttle = 0.7 }, semiParams, flat40, TrailerKinematics.Dt);
+                        TrailerKinematics.StepCoupled(in tractor, ref tr, -2.01, 0.96, semiParams.Wheelbase, tractor.LastMuLat, in spec, (x, y, z) => 40.0, TrailerKinematics.Dt);
+                        var err = Math.Abs(TrailerKinematics.WrapPi(tractor.Heading - tr.Heading));
+                        Assert.IsTrue(err <= prevErr + 1e-9, $"{kind} step {step} monotonic convergence");
+                        prevErr = err;
+                    }
+                    double limit = kind == "20ft" ? 0.02 : 0.12;
+                    Assert.IsTrue(prevErr < limit, $"{kind} final alignment error {prevErr} >= {limit}");
+                }
+            }
+
+            // 2. Reverse steering articulation from straight
+            var trRight = new TrailerKinematicState { Heading = 0 };
+            var tractorR = new GroundState { Speed = -4.0, SteerAngle = 0.5 };
+            TrailerKinematics.StepCoupled(in tractorR, ref trRight, -2.01, 0.96, 4.66, 1.0, in TrailerKinematics.Chassis20, (x, y, z) => 0.0, TrailerKinematics.Dt);
+            Assert.IsTrue(trRight.Heading > 0 && trRight.Heading < Math.PI, "right steer reverse yields positive heading");
+
+            var trLeft = new TrailerKinematicState { Heading = 0 };
+            var tractorL = new GroundState { Speed = -4.0, SteerAngle = -0.5 };
+            TrailerKinematics.StepCoupled(in tractorL, ref trLeft, -2.01, 0.96, 4.66, 1.0, in TrailerKinematics.Chassis20, (x, y, z) => 0.0, TrailerKinematics.Dt);
+            Assert.IsTrue(trLeft.Heading > Math.PI, "left steer reverse wraps below 2pi");
+
+            // 3. +-72 deg jackknife clamp under sustained reverse hard steer
+            foreach (var steerDir in new[] { 1.0, -1.0 })
+            {
+                var tractor = new GroundState { Speed = -4.0, SteerAngle = steerDir * semiParams.MaxSteerRad, Mode = VehicleMode.Driving };
+                var tr = new TrailerKinematicState { Heading = 0 };
+                for (int i = 0; i < 200; i++)
+                {
+                    GroundModel.Step(ref tractor, new GroundInput { Throttle = -1.0, Steer = steerDir }, semiParams, (x, y, z) => new TerrainSample { Z = 0, Nz = 1, Surface = GroundModel.Surfaces[0] }, TrailerKinematics.Dt);
+                    TrailerKinematics.StepCoupled(in tractor, ref tr, -2.01, 0.96, semiParams.Wheelbase, tractor.LastMuLat, in TrailerKinematics.Chassis20, (x, y, z) => 0.0, TrailerKinematics.Dt);
+                    Assert.IsTrue(Math.Abs(TrailerKinematics.WrapPi(tractor.Heading - tr.Heading)) <= TrailerKinematics.MaxJackknifeRad + 1e-12);
+                }
+                Assert.AreEqual(TrailerKinematics.MaxJackknifeRad, Math.Abs(TrailerKinematics.WrapPi(tractor.Heading - tr.Heading)), 1e-6);
+            }
+
+            // 4. Steep slope 3D kingpin coincidence (< 1e-12 m on 15 and +-35 deg grades) + bank
+            foreach (var spec in new[] { TrailerKinematics.Chassis20, TrailerKinematics.Chassis40 })
+            {
+                foreach (var slopeDeg in new[] { 15.0, 35.0, -35.0 })
+                {
+                    var slope = Deg(slopeDeg);
+                    var tractor = new GroundState { Z = 40.0, Pitch = slope };
+                    var tr = new TrailerKinematicState { Heading = 0.2 };
+                    TrailerKinematics.StepCoupled(in tractor, ref tr, -2.01, 0.96, 4.66, 1.0, in spec, (x, y, z) => 40.0 + y * Math.Tan(slope), TrailerKinematics.Dt);
+                    var (kx, ky, kz) = TrailerKinematics.RotateByOrientation(tr.Heading, tr.Pitch, tr.Bank, 0.0, spec.KpY, spec.KingpinZ);
+                    var err3D = Math.Sqrt(Math.Pow((tr.X + kx) - tr.HitchX, 2) + Math.Pow((tr.Y + ky) - tr.HitchY, 2) + Math.Pow((tr.Z + kz) - tr.HitchZ, 2));
+                    Assert.IsTrue(err3D < 1e-12, $"{spec.Kind} slope {slopeDeg} deg 3D kingpin error {err3D}");
+
+                    // 3D rotated bogie Z matches zTr + bgOffZ
+                    var (_, _, bgZ) = TrailerKinematics.RotateByOrientation(tr.Heading, tr.Pitch, tr.Bank, 0.0, spec.BogieY, 0.0);
+                    Assert.AreEqual(tr.Z + bgZ, tr.BogieZ, 1e-12, $"{spec.Kind} slope {slopeDeg} deg BogieZ");
+                }
+            }
+
+            // Negative / NaN dt guard & pre-wrap clamping when |rawRel| > pi
+            var trNegDt = new TrailerKinematicState { Heading = 0.2 };
+            TrailerKinematics.StepCoupled(new GroundState { Speed = 10.0 }, ref trNegDt, -2.01, 0.96, 4.66, 1.0, in TrailerKinematics.Chassis20, (x, y, z) => 0.0, double.NaN);
+            Assert.AreEqual(0.2, trNegDt.Heading, 1e-12, "NaN dt acts as dt=0");
+
+            var trNegDt2 = new TrailerKinematicState { Heading = 0.2 };
+            TrailerKinematics.StepCoupled(new GroundState { Speed = 10.0 }, ref trNegDt2, -2.01, 0.96, 4.66, 1.0, in TrailerKinematics.Chassis20, (x, y, z) => 0.0, -0.5);
+            Assert.AreEqual(0.2, trNegDt2.Heading, 1e-12, "negative dt acts as dt=0");
+
+            var trWrapClamp = new TrailerKinematicState { Heading = Deg(190.0) };
