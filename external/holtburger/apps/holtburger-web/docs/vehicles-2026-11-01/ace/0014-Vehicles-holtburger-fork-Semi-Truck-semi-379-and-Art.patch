+        [TestMethod]
+        public void Semi379ProfileAliasesDimensionsAndToMsg()
+        {
+            foreach (var key in new[] { "semi", "semi-379", "truck", "tractor", "379", "SEMI-379" })
+            {
+                var p = VehicleProfile.ByKey(key);
+                Assert.IsNotNull(p, $"ByKey('{key}') must resolve");
+                Assert.AreEqual("semi-379", p.Key);
+                Assert.AreEqual("Ironhorse 379", p.DisplayName);
+                Assert.AreEqual(VehicleLocomotion.Ground, p.Locomotion);
+                Assert.AreEqual(0x0200026Bu, p.StandInSetup);
+                Assert.AreEqual(22.0f, p.VCruise, 1e-4f);
+                Assert.AreEqual(27.0f, p.VMax, 1e-4f);
+                Assert.AreEqual(4.8f, p.Accel, 1e-4f);
+                Assert.AreEqual(9.5f, p.Decel, 1e-4f);
+                Assert.AreEqual(4.0f, p.YawRate, 1e-4f);
+                Assert.AreEqual(4.66f, p.Wheelbase, 1e-4f);
+                Assert.AreEqual(2.12f, p.TrackWidth, 1e-4f);
+                Assert.AreEqual(0.505f, p.WheelRadius, 1e-4f);
+                Assert.AreEqual((float)Deg(38.0), p.MaxSteerRad, 1e-5f);
+                Assert.AreEqual(-7.0f, p.ReverseMax, 1e-4f);
+                Assert.AreEqual(0.788f, p.ClimbLimitCos, 1e-4f);
+                Assert.AreEqual(1.05f, p.FordDepthMax, 1e-4f);
+                Assert.AreEqual(-2.01f, p.FifthWheelOffsetY, 1e-4f);
+                Assert.AreEqual(0.96f, p.FifthWheelOffsetZ, 1e-4f);
+                Assert.AreEqual((byte)3, p.VehicleClass);
+                Assert.AreEqual(2, p.Seats.Count);
+                Assert.AreEqual(new Vector3(-0.52f, 0.28f, 1.72f), p.Seats[0].Offset);
+                Assert.AreEqual(new Vector3(0.52f, 0.28f, 1.72f), p.Seats[1].Offset);
+            }
+
+            // Livery clamping (0..5 valid, out of range clamps to 0)
+            Assert.AreEqual((byte)3, VehicleProfile.ByKey("semi", 3).LiveryId);
+            Assert.AreEqual((byte)0, VehicleProfile.ByKey("semi", 99).LiveryId);
+
+            var msg = VehicleProfile.Semi379(4).ToMsg(0x80000100u, 27.0f, 30);
