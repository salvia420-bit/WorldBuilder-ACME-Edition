+                ?.SetValue(player, new ACE.Database.Models.Shard.Character { IsPlussed = true });
+            typeof(Creature).GetProperty("CombatMode", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+                ?.SetValue(player, CombatMode.NonCombat);
+
+            return session;
+        }
