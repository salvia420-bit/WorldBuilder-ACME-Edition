@@ -848,6 +848,39 @@ public void AirDefenseManager_Tick_InactiveStation_IsNotSwept()
             Assert.AreEqual(DateTime.MinValue, station.LastScanUtc, "Inactive station must not perform sweep");
         }
 
+        [TestMethod]
+        public void RadarStation_StowOrDeactivate_ClearsStaleTracksAndPreventsTurretCueing()
+        {
+            var jeep = CreateTestJeep(0x70000090, 1000.0, 2000.0, 100.0);
+            var player = CreateTestPlayer(0x10000003, 1000.0, 1998.5, 100.75);
+            var weenie = RadarStation.BuildWeenie(jeep, player);
+            var station = new RadarStation(weenie, new ObjectGuid(0x70000091), jeep, player)
+            {
+                Location = Vehicle.ToPosition(1000.0, 1998.45, 100.0, Quaternion.Identity),
+            };
+            station.UpdateSensorPosition();
+            AirDefenseManager.RegisterStation(station);
+
+            var targetPlane = CreateTestAircraft(0x70000092, 1000.0, 2500.0, 250.0);
+            var tracks = AirDefenseManager.PerformSweep(
+                station,
+                new[] { targetPlane },
+                terrainLookup: (x, y) => 100.0f,
+                nowUtc: DateTime.UtcNow);
+            Assert.AreEqual(1, tracks.Count);
+            Assert.IsNotNull(AirDefenseRegistry.FindNearestHostile(new Vector3(1000f, 2000f, 100f)));
+
+            // Stowing / deactivating RadarStation must clear stale tracks immediately and prevent AirDefenseRegistry acquisition
+            station.IsActive = false;
+            Assert.AreEqual(0, station.Sensor.ActiveTrackCount, "Deactivating RadarStation must clear Sensor tracks");
+            Assert.IsFalse(station.Sensor.IsActive, "Sensor.IsActive must mirror stowed RadarStation");
+            Assert.IsNull(AirDefenseRegistry.FindNearestHostile(new Vector3(1000f, 2000f, 100f)), "Stowed RadarStation must not cue turrets");
+
+            // Even after ticking past TrackTimeout, no stale track remains
+            AirDefenseManager.Tick(5.0);
+            Assert.IsNull(AirDefenseRegistry.FindNearestHostile(new Vector3(1000f, 2000f, 100f)));
+        }
+
         #endregion
     }
 }
