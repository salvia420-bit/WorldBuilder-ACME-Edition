diff --git a/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs b/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
index f9aa50e3..f778b5a5 100644
--- a/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
+++ b/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
@@ -2369,6 +2369,190 @@ public void MicroGrid_PreservesBatteryChargeWhenInsufficientForConsumers()
             Assert.AreEqual(400.0f, bat.CapacitorJoules, 1e-4f, "MicroGrid must NOT drain battery when insufficient to power consumers");
         }
 
+        [TestMethod]
+        public void MicroGrid_Tick_IgnoresZeroNegativeAndNonFiniteDeltaSeconds()
+        {
+            double x = 3410.0, y = 4410.0, z = 40.0;
+            var grid = new MicroGrid(new Vector3((float)x, (float)y, (float)z));
+
+            var bat = new BatteryDeployable(BatteryDeployable.BuildWeenie(), new ObjectGuid(0x7500E211u))
+            {
+                Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity),
+                CapacitorJoules = 5000.0f,
+            };
+            var laser = new LaserTurretDeployable(LaserTurretDeployable.BuildWeenie(), new ObjectGuid(0x7500E212u))
+            {
+                Location = Vehicle.ToPosition(x + 2.0, y, z, Quaternion.Identity),
+            };
+            grid.Register(bat);
+            grid.Register(laser);
+
+            grid.Tick(0.0f);
+            Assert.AreEqual(5000.0f, bat.CapacitorJoules, 1e-4f, "Zero dt must not change battery charge");
+
+            grid.Tick(-5.0f);
+            Assert.AreEqual(5000.0f, bat.CapacitorJoules, 1e-4f, "Negative dt must not charge battery from a power deficit");
+
+            grid.Tick(float.NaN);
+            Assert.AreEqual(5000.0f, bat.CapacitorJoules, 1e-4f, "NaN dt must be ignored");
+
+            grid.Tick(float.NegativeInfinity);
+            grid.Tick(float.PositiveInfinity);
+            Assert.AreEqual(5000.0f, bat.CapacitorJoules, 1e-4f, "Infinite dt must be ignored");
+        }
+
+        private static T CreateTestCreature<T>(uint guid, double x, double y, double z, bool attackable = true, bool alive = true, bool indoors = false) where T : Creature
+        {
+            var c = (T)System.Runtime.CompilerServices.RuntimeHelpers.GetUninitializedObject(typeof(T));
+            typeof(WorldObject).GetField("<Guid>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(c, new ObjectGuid(guid));
+            var biota = new ACE.Entity.Models.Biota
+            {
+                Id = guid,
+                WeenieType = typeof(T) == typeof(Vendor) ? WeenieType.Vendor
+                    : typeof(T) == typeof(Pet) ? WeenieType.Pet
+                    : WeenieType.Creature,
+                PropertiesPosition = new Dictionary<PositionType, PropertiesPosition>(),
+                PropertiesBool = new Dictionary<PropertyBool, bool>(),
+                PropertiesAttribute2nd = new Dictionary<PropertyAttribute2nd, PropertiesAttribute2nd>
+                {
+                    [PropertyAttribute2nd.MaxHealth] = new PropertiesAttribute2nd { InitLevel = 100, CurrentLevel = 100 },
+                },
+            };
+            typeof(WorldObject).GetField("<Biota>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(c, biota);
+            typeof(WorldObject).GetField("ephemeralPositions", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(c, new Dictionary<PositionType, Position>());
+            typeof(WorldObject).GetField("positionCache", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(c, new Dictionary<PositionType, Position>());
+            typeof(WorldObject).GetField("BiotaDatabaseLock", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+                ?.SetValue(c, new System.Threading.ReaderWriterLockSlim());
+
+            var vitals = new Dictionary<PropertyAttribute2nd, ACE.Server.WorldObjects.Entity.CreatureVital>
+            {
+                [PropertyAttribute2nd.MaxHealth] = new ACE.Server.WorldObjects.Entity.CreatureVital(c, PropertyAttribute2nd.MaxHealth) { Current = alive ? 100u : 0u },
+            };
+            typeof(Creature).GetField("Vitals", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.SetValue(c, vitals);
+            c.Attackable = attackable;
+            c.Location = indoors
+                ? new Position(0x1010_0100u, new Vector3(10f, 10f, 0f), Quaternion.Identity)
+                : Vehicle.ToPosition(x, y, z, Quaternion.Identity);
+            return c;
+        }
+
+        [TestMethod]
+        public void GroundRadar_TargetMonsters_IgnoresPlayersVendorsPetsAndNonAttackables_TargetsOnlyOutdoorHostileMonsters()
+        {
+            double x = 3500.0, y = 4500.0, z = 40.0;
+            var prevOverride = DeployableManager.EnterWorldOverrideForTesting;
+            DeployableManager.Clear();
+            DeployableManager.EnterWorldOverrideForTesting = _ => true;
+
+            var deployer = CreateTestPlayer(0x5000E301u, x + 5.0, y, z, monarchId: 100u);
+            var foreignPlayer = CreateTestPlayer(0x5000E302u, x + 40.0, y, z, monarchId: 200u);
+            var vendor = CreateTestCreature<Vendor>(0x7000E303u, x + 8.0, y, z, attackable: true);
+            var pet = CreateTestCreature<Pet>(0x7000E304u, x + 9.0, y, z, attackable: true);
+            var friendlyNpc = CreateTestCreature<Creature>(0x7000E305u, x + 10.0, y, z, attackable: false);
+            var indoorMonster = CreateTestCreature<Creature>(0x7000E306u, x + 11.0, y, z, attackable: true, indoors: true);
+            var deadMonster = CreateTestCreature<Creature>(0x7000E307u, x + 12.0, y, z, attackable: true, alive: false);
+            var monster = CreateTestCreature<Creature>(0x7000E308u, x + 15.0, y, z, attackable: true, alive: true);
+
+            // In-memory Landblock populated with deployer, vendor, pet, NPC, indoor/dead monsters, and 1 outdoor monster
+            var lb = (ACE.Server.Entity.Landblock)System.Runtime.CompilerServices.RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Entity.Landblock));
+            var worldObjs = new Dictionary<ObjectGuid, WorldObject>
+            {
+                [deployer.Guid] = deployer,
+                [vendor.Guid] = vendor,
+                [pet.Guid] = pet,
+                [friendlyNpc.Guid] = friendlyNpc,
+                [indoorMonster.Guid] = indoorMonster,
+                [deadMonster.Guid] = deadMonster,
+                [monster.Guid] = monster,
+            };
+            typeof(ACE.Server.Entity.Landblock).GetField("worldObjects", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(lb, worldObjs);
+            typeof(ACE.Server.Entity.Landblock).GetField("pendingAdditions", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(lb, new Dictionary<ObjectGuid, WorldObject>());
+            typeof(ACE.Server.Entity.Landblock).GetField("pendingRemovals", BindingFlags.Instance | BindingFlags.NonPublic)?.SetValue(lb, new List<ObjectGuid>());
+
+            var lockField = typeof(ACE.Server.Managers.PlayerManager).GetField("playersLock", BindingFlags.Static | BindingFlags.NonPublic);
+            var dictField = typeof(ACE.Server.Managers.PlayerManager).GetField("onlinePlayers", BindingFlags.Static | BindingFlags.NonPublic);
+            var rwLock = (System.Threading.ReaderWriterLockSlim)lockField?.GetValue(null);
+            var onlineDict = (Dictionary<uint, Player>)dictField?.GetValue(null);
+            void RegPlayer(Player p) { rwLock.EnterWriteLock(); try { onlineDict[p.Guid.Full] = p; } finally { rwLock.ExitWriteLock(); } }
+            void UnregPlayer(uint g) { rwLock.EnterWriteLock(); try { onlineDict.Remove(g); } finally { rwLock.ExitWriteLock(); } }
+
+            RegPlayer(deployer);
+            RegPlayer(foreignPlayer);
+
+            try
+            {
+                var flux = new FluxPodDeployable(FluxPodDeployable.BuildWeenie(), new ObjectGuid(0x7500E310u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x, y, z, Quaternion.Identity),
+                };
+                flux.Grid.Center = flux.GlobalPosition;
+                DeployableManager.RegisterGrid(flux.Grid);
+                DeployableManager.Register(flux);
+
+                var gen = new PowerGeneratorDeployable(PowerGeneratorDeployable.BuildWeenie(), new ObjectGuid(0x7500E311u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 1.0, y, z, Quaternion.Identity),
+                    FuelSecondsRemaining = 120.0,
+                };
+                flux.Grid.Register(gen);
+                DeployableManager.Register(gen);
+
+                var bat = new BatteryDeployable(BatteryDeployable.BuildWeenie(), new ObjectGuid(0x7500E312u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 1.5, y, z, Quaternion.Identity),
+                    CapacitorJoules = 300000.0f,
+                };
+                flux.Grid.Register(bat);
+                DeployableManager.Register(bat);
+
+                var radar = new GroundRadarDeployable(GroundRadarDeployable.BuildWeenie(), new ObjectGuid(0x7500E313u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 2.0, y, z, Quaternion.Identity),
+                    TargetMonsters = true,
+                };
+                typeof(WorldObject).GetProperty("CurrentLandblock", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+                    ?.SetValue(radar, lb);
+                flux.Grid.Register(radar);
+                DeployableManager.Register(radar);
+
+                var laser = new LaserTurretDeployable(LaserTurretDeployable.BuildWeenie(), new ObjectGuid(0x7500E314u), null, deployer)
+                {
+                    Location = Vehicle.ToPosition(x + 2.5, y, z, Quaternion.Identity),
+                };
+                flux.Grid.Register(laser);
+                DeployableManager.Register(laser);
+
+                // 1. With monster present + foreignPlayer online: only monster + foreignPlayer are contacts (deployer, vendor, pet, NPC, indoor/dead monsters excluded)
+                DeployableManager.Tick(0.6);
+                Assert.AreEqual(2, radar.ContactCount, "Only the outdoor attackable monster and online foreign player should appear as contacts");
+                Assert.IsTrue(radar.FindNearestGroundContact(out var acquiredGuid, out _, out _));
+                Assert.AreEqual(monster.Guid.Full, acquiredGuid, "Nearest hostile must be the outdoor monster, never the deployer or vendor");
+
+                // 2. Remove both monster and foreignPlayer, shut off generator, and tick past 2s laser cooldown:
+                //    deployer, vendor, pet, friendlyNpc remain in landblock -> 0 contacts and laser must NOT discharge 120 kJ!
+                worldObjs.Remove(monster.Guid);
+                UnregPlayer(foreignPlayer.Guid.Full);
+                gen.FuelSecondsRemaining = 0.0;
+                DeployableManager.Tick(2.1); // expire laser cooldown + rescan
+                float joulesBefore = bat.CapacitorJoules;
+                DeployableManager.Tick(0.6);
+                Assert.AreEqual(0, radar.ContactCount, "Deployer, Vendor, Pet, non-attackable NPC, indoor/dead monsters must yield 0 contacts");
+                Assert.IsFalse(radar.FindNearestGroundContact(out _, out _, out _));
+                Assert.IsTrue(bat.CapacitorJoules >= joulesBefore - 2000.0f, "LaserTurret must not discharge 120 kJ on deployer/vendor/pet/NPC");
+            }
+            finally
+            {
+                UnregPlayer(deployer.Guid.Full);
+                UnregPlayer(foreignPlayer.Guid.Full);
+                DeployableManager.Clear();
+                DeployableManager.EnterWorldOverrideForTesting = prevOverride;
+            }
+        }
+
         #endregion
     }
 }
