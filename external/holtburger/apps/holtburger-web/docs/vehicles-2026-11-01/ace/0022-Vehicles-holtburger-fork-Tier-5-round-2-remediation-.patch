diff --git a/Source/ACE.Entity/LandblockId.cs b/Source/ACE.Entity/LandblockId.cs
index b40c8b5d..19345944 100644
--- a/Source/ACE.Entity/LandblockId.cs
+++ b/Source/ACE.Entity/LandblockId.cs
@@ -44,7 +44,7 @@ public LandblockId(byte x, byte y, byte continent)
 
         public byte LandblockY => (byte)((Raw >> 16) & 0xFF);
 
-        public byte Continent => (byte)((Raw >> 15) & 1);
+        public byte Continent => (Raw & 0xFFFFu) != 0xFFFFu && (Raw & 0x7FFFu) < 0x100u && (Raw & 0x8000u) != 0 ? (byte)1 : (byte)0;
 
         /// <summary>
         /// This is only used to calculate LandcellX and LandcellY - it has no other function.
@@ -125,7 +125,7 @@ public override bool Equals(object obj)
 
         public override int GetHashCode()
         {
-            return (int)(Raw & 0xFFFF8000);
+            return (int)((Raw & 0xFFFF0000u) | ((uint)Continent << 15));
         }
 
         public override string ToString()
diff --git a/Source/ACE.Server.Tests/Vehicles/AirDefenseRadarTests.cs b/Source/ACE.Server.Tests/Vehicles/AirDefenseRadarTests.cs
