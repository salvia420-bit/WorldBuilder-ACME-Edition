+
+        [TestMethod]
+        public void VehicleToGlobal_IsDericostCell_And_LandblockIdContinent_ExcludeIndoorEnvCell8100AndFFFF()
+        {
+            // Dereth indoor EnvCell 0x10208100 and BlockCellID sentinel 0x1020FFFF must stay on Dereth (no +68928m Y offset)
+            var derethOutdoor = new ACE.Entity.Position(0x1020_0001u, new Vector3(10f, 10f, 10f), Quaternion.Identity);
+            var derethIndoorHi = new ACE.Entity.Position(0x1020_8100u, new Vector3(10f, 10f, 10f), Quaternion.Identity);
+            var derethSentinel = new ACE.Entity.Position(0x1020_FFFFu, new Vector3(10f, 10f, 10f), Quaternion.Identity);
+            var dericostOutdoor = new ACE.Entity.Position(0x1020_8001u, new Vector3(10f, 10f, 10f), Quaternion.Identity);
+
+            Assert.IsFalse(VehicleManager.IsDericostCell(0x1020_8100u));
+            Assert.IsFalse(VehicleManager.IsDericostCell(0x1020_FFFFu));
+            Assert.IsTrue(VehicleManager.IsDericostCell(0x1020_8001u));
+
+            var (_, yOut, _) = Vehicle.ToGlobal(derethOutdoor);
+            var (_, yEnv, _) = Vehicle.ToGlobal(derethIndoorHi);
+            var (_, yFf, _) = Vehicle.ToGlobal(derethSentinel);
+            var (_, yDeri, _) = Vehicle.ToGlobal(dericostOutdoor);
+
+            Assert.AreEqual(yOut, yEnv, 0.001, "Vehicle.ToGlobal(0x10208100) must not add DericostYOffset");
+            Assert.AreEqual(yOut, yFf, 0.001, "Vehicle.ToGlobal(0x1020FFFF) must not add DericostYOffset");
+            Assert.AreEqual(yOut + Vehicle.DericostYOffset, yDeri, 0.001);
+
+            var lbEnv = new LandblockId(0x1020_8100u);
+            var lbFf = new LandblockId(0x1020_FFFFu);
+            var lbOut = new LandblockId(0x1020_0001u);
+            Assert.AreEqual((byte)0, lbEnv.Continent);
+            Assert.AreEqual((byte)0, lbFf.Continent);
+            Assert.AreEqual(0x1120_0000u, lbEnv.East.Raw);
+            Assert.AreEqual(0x1120_0000u, lbFf.East.Raw);
+            Assert.AreEqual(lbOut.GetHashCode(), lbEnv.GetHashCode(), "Equal LandblockIds must produce identical hash codes");
+            Assert.AreEqual(lbOut.GetHashCode(), lbFf.GetHashCode(), "Equal LandblockIds must produce identical hash codes");
+        }
     }
 }
