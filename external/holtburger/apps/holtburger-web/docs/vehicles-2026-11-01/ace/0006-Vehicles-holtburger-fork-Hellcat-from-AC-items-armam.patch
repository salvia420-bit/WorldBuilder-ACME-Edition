+        /// <summary>Within this cone of the boresight a rail's bolt is aimed at a tracked creature (ACE bolts track: they lead).</summary>
+        const float MissileAssistCos = 0.9962f; // 5°
+        const float MissileAssistRange = 400f;
+
+        static void FireMissile(Vehicle v, Player pilot)
+        {
+            var ordinal = -1;
+            foreach (var o in v.RailOrder)
+                if ((v.MissileMask & (1 << o)) != 0) { ordinal = o; break; }
+            if (ordinal < 0)
+                return;
+            var gi = v.RailIdx[ordinal];
+            var w = v.Profile.Weapons[gi];
+            var ext = v.Profile.ExtOf(gi);
+            v.MissileCooldownSteps = MissileIntervalSteps;
+            v.MissileMask &= (byte)~(1 << ordinal);
+            v.Costs.MissilesFired++;
+
+            var spell = new Spell(ext.SpellId);
+            if (spell.NotFound || spell.Wcid == 0)
+            {
+                log.Warn($"[VEHICLE] {v.Name}: rail spell {ext.SpellId} not found");
+                return;
+            }
+            var q = v.CurrentOrientation;
+            var fwd = Vector3.Normalize(Vector3.Transform(Vector3.UnitY, q));
+            var (mx, my, mz) = v.LocalToWorld(w.Muzzle);
+            var muzzle = new Vector3((float)mx, (float)my, (float)mz);
+            var vVel = v.WorldVelocity();
+            var launch = Math.Max(1f, ext.MuzzleVelocity);
+
+            // aim: the tracked creature nearest the boresight within 5°, else straight ahead
+            Creature target = null;
+            var bestCos = MissileAssistCos;
+            Vector3 aimPoint = default;
+            foreach (var c in Candidates(v, pilot, MissileAssistRange + 10f))
+            {
+                var centre = c.Base + new Vector3(0, 0, c.Height * 0.5f);
+                var to = centre - muzzle;
+                var dist = to.Length();
+                if (dist < 5f || dist > MissileAssistRange)
+                    continue;
+                var cos = Vector3.Dot(to / dist, fwd);
+                if (cos <= bestCos)
