diff --git a/run-ace-live.sh b/run-ace-live.sh
new file mode 100755
index 0000000..1f1dcc0
--- /dev/null
+++ b/run-ace-live.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# run-ace-live.sh — launch the live ACE (holtburger vehicles fork) on this laptop with the GC settings chosen 2026-11-02
+# (docs/vehicles-2026-11-01 decision 71 / HANDOFF session 3). Stop first: echo stop-now > ~/ace_stdin.fifo
+# Revert to ACE's defaults: launch without these variables (the runbook's plain line).
+# NB the names are case-sensitive on Linux: GCGen0MaxBudget (capital G; "GCgen0MaxBudget" is silently ignored by .NET 10).
+#   GCGen0MaxBudget 0x1000000  — gen0 budget capped at 16 MB per heap: an ephemeral GC promotes at most that much
+#                                (DATAS had grown gen0 to ~157 MB: 22 MB promoted in one pause)
+#   GCGen1MaxBudget 0x1000000  — gen1 budget capped at 16 MB per heap too: a gen1 GC had grown to ~71 MB of gen1 and
+#                                promoted 72 MB in one 107 ms pause (bench gc-sea-d)
+#   GCDynamicAdaptationMode 0  — DATAS off (it sizes gen0 itself; the cap needs fixed heaps)
+#   GCHeapCount 2              — two GC threads on this 4-core box shared with Chrome / mysqld
+#   GCNoAffinitize 1           — GC threads not pinned to cores (a pinned thread waits for its busy core)
+#   GCHighMemPercent 0x61      — 97 %: the box's own memory load (a headless tab) no longer drives blocking gen2 GCs
+#                                (bench armament-a: a 705 ms blocking gen2 at ~90 % memory load)
+ACERT=/home/wbterminal/ace-server/Source/ACE.Server/bin/Release/net10.0
+cd "$ACERT" || exit 1
+export DOTNET_GCGen0MaxBudget=0x1000000 DOTNET_GCGen1MaxBudget=0x1000000 DOTNET_GCDynamicAdaptationMode=0 DOTNET_GCHeapCount=2 DOTNET_GCNoAffinitize=1 DOTNET_GCHighMemPercent=0x61
+exec setsid nohup /home/wbterminal/.local/bin/dotnet ACE.Server.dll < /home/wbterminal/ace_stdin.fifo > /dev/null 2>> /home/wbterminal/ace_stderr.log
-- 
