diff --git a/Source/ACE.Server/Physics/Entity/CellStructCache.cs b/Source/ACE.Server/Physics/Entity/CellStructCache.cs
new file mode 100644
index 0000000..e9277f4
--- /dev/null
+++ b/Source/ACE.Server/Physics/Entity/CellStructCache.cs
@@ -0,0 +1,34 @@
+using System.Collections.Concurrent;
+
+using ACE.Server.Physics.Common;
+
+namespace ACE.Server.Physics.Entity
+{
+    /// <summary>
+    /// holtburger vehicles fork (vehicle_shared_cellstructs): one physics CellStruct per (environment, cell structure),
+    /// shared by every EnvCell that uses it — as GfxObjCache shares a model's physics. The polygons and BSP trees are never
+    /// written after construction (BSPTree.RemoveNonPortalNodes, the only mutator, has no caller; CellStruct.DrawingBSP has
+    /// no reader), so sharing is safe. Vanilla builds a private copy per cell: an aircraft over the deep sea built 5
+    /// dungeons' 5,293 cells from 328 distinct cell structures (~93 MB -> ~6 MB). Process lifetime; bounded by the
+    /// distinct cell structures in client_portal.dat. A race may build one entry twice (harmless: one wins).
+    /// </summary>
+    public static class CellStructCache
+    {
+        static readonly ConcurrentDictionary<ulong, CellStruct> cache = new ConcurrentDictionary<ulong, CellStruct>();
+
+        public static int Count => cache.Count;
+        public static long Hits, Misses;
+
+        public static CellStruct Get(uint environmentId, uint cellStructId, DatLoader.Entity.CellStruct dat)
+        {
+            var key = (ulong)environmentId << 32 | cellStructId;
+            if (cache.TryGetValue(key, out var cs))
+            {
+                System.Threading.Interlocked.Increment(ref Hits);
+                return cs;
+            }
+            System.Threading.Interlocked.Increment(ref Misses);
+            return cache.GetOrAdd(key, _ => new CellStruct(dat, serverOnly: true));
+        }
+    }
+}
