diff --git a/Source/ACE.Server/Entity/Landblock.cs b/Source/ACE.Server/Entity/Landblock.cs
index 2067ea4..0a2a388 100644
--- a/Source/ACE.Server/Entity/Landblock.cs
+++ b/Source/ACE.Server/Entity/Landblock.cs
@@ -210,16 +210,65 @@ public void Init(bool reload = false)
 
             Task.Run(() =>
             {
-                CreateWorldObjects();
-
-                SpawnDynamicShardObjects();
+                // holtburger vehicles fork (vehicle_defer_dungeons): a dungeon only an aircraft passed over brings up nothing
+                if (!reload && TryDeferDungeonBringUp())
+                    return;
 
-                SpawnEncounters();
+                BringUp();
             });
 
             //LoadMeshes(objects);
         }
 
+        private void BringUp()
+        {
+            CreateWorldObjects();
+
+            SpawnDynamicShardObjects();
+
+            SpawnEncounters();
+        }
+
+        /// <summary>holtburger vehicles fork: 0 = normal, 1 = deferred (nothing created), 2 = resumed.</summary>
+        private int dungeonDeferState;
+
+        public bool DungeonDeferred => Volatile.Read(ref dungeonDeferState) == 1;
+
+        /// <summary>
+        /// holtburger vehicles fork (vehicle_defer_dungeons): a VehicleOnly dungeon landblock (the deep sea under a flight path:
+        /// all heights 0, cells, no buildings) creates no objects — vanilla builds every cell of the dungeon for the first
+        /// object placed in it (AdjustCell.BuildEnv), 20-30 MB of polygons / BSP trees that survive into gen1 / gen2 in one
+        /// burst, and spawns its monsters for nobody. Apartments (houses in dungeon landblocks) are never held: HouseManager
+        /// waits on CreateWorldObjectsCompleted. A player on foot arriving resumes the normal bring-up (ResumeDeferredDungeon);
+        /// a teleporter waits in portal space until CreateWorldObjectsCompleted, as for any slow load.
+        /// </summary>
+        private bool TryDeferDungeonBringUp()
+        {
+            if (!VehicleOnly || !Vehicles.VehicleStreaming.DeferDungeons || !IsDungeon)
+                return false;
+            foreach (var i in DatabaseManager.World.GetCachedInstancesByLandblock(Id.Landblock))
+                if (DatabaseManager.World.GetCachedWeenie(i.WeenieClassId)?.WeenieType == WeenieType.House)
+                    return false;
+            if (Interlocked.CompareExchange(ref dungeonDeferState, 1, 0) != 0)
+                return false;
+            Interlocked.Increment(ref Vehicles.VehicleStreaming.DungeonsDeferred);
+            return true;
+        }
+
+        /// <summary>holtburger vehicles fork: a player on foot (not seated, not in a server-owned fall) resumes a deferred dungeon.</summary>
+        private void ResumeDeferredDungeon()
+        {
+            if (Volatile.Read(ref dungeonDeferState) != 1)
+                return;
+            if (Vehicles.VehicleStreaming.DeferDungeons && !players.Exists(p => !Vehicles.VehicleManager.IsSeated(p) && !Vehicles.VehicleBailout.IsFalling(p)))
+                return;
+            if (Interlocked.CompareExchange(ref dungeonDeferState, 2, 1) != 1)
+                return;
+            VehicleOnly = false; // ordinary from here: ACE's own single bring-up pass, 5-min retention
+            Interlocked.Increment(ref Vehicles.VehicleStreaming.DungeonsResumed);
+            Task.Run(BringUp);
+        }
+
         /// <summary>
         /// Monster Locations, Generators<para />
         /// This will be called from a separate task from our constructor. Use thread safety when interacting with this landblock.
@@ -545,6 +594,7 @@ public void TickMultiThreadedWork(double currentUnixTime)
             var vtT1 = System.Diagnostics.Stopwatch.GetTimestamp();
 
             ProcessPendingWorldObjectAdditionsAndRemovals();
+            ResumeDeferredDungeon(); // holtburger vehicles fork (vehicle_defer_dungeons)
             var vtT2 = System.Diagnostics.Stopwatch.GetTimestamp();
 
             // When a WorldObject Ticks, it can end up adding additional WorldObjects to this landblock
