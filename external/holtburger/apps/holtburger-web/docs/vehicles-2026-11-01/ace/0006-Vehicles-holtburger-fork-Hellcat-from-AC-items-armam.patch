+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Numerics;
+
+using log4net;
+
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Server.Entity;
+using ACE.Server.Factories;
+using ACE.Server.Managers;
+using ACE.Server.Network.GameEvent.Events;
+using ACE.Server.Network.GameMessages.Messages;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Vehicles
+{
+    /// <summary>
+    /// Free-fall bombs (weapon kind 3; DESIGN decisions 62-): released from a vehicle's station with the aircraft's velocity,
+    /// stepped on the server at the vehicle rate under gravity and quadratic drag (terminal velocity from the profile:
+    /// 2,000 lb ~300 m/s, 1,000 lb ~270 m/s), and detonated where they meet the terrain:
+    /// <list type="bullet">
+    /// <item>blast damage to every outdoor creature within the profile's radius (full within a quarter of it, then falling
+    /// to 15 % at the edge), through ACE's normal damage path with the pilot as the source (players only with
+    /// vehicle_gun_players; never a seated or falling player);</item>
+    /// <item>a fireball every client sees, retail included: Flame Bolt projectiles detonated in a ring at the impact (their
+    /// own retail PlayScript.Explode);</item>
+    /// <item>an Explosion event to the capable clients within 3 km (they draw the blast; they already draw the bomb's fall
+    /// from the BombRelease event with the same model — fall_model.js stepBomb mirrors Step operation for operation).</item>
+    /// </list>
+    /// World thread only (VehicleManager.Tick). Bombs outlive their vehicle (a despawn does not disarm them).
+    /// </summary>
+    public static class VehicleOrdnance
+    {
+        static readonly ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
+
+        public const double Gravity = 9.8;
+        public const double Dt = FlightModel.Dt;
+        /// <summary>A bomb still falling after this long is dropped (a guard: 5 km at terminal velocity is ~40 s).</summary>
+        const double MaxFallSeconds = 180.0;
+        const int MaxBombsInFlight = 64;
+        /// <summary>Capable clients within this horizontal distance of an impact get its Explosion event.</summary>
+        const double ExplosionEventRange = 3000.0;
+        /// <summary>The fireball's projectile spell (Flame Bolt VI: a level-6 bolt, its Explode script at full intensity).</summary>
+        const uint BurstSpellId = 85;
+
+        public sealed class Bomb
+        {
+            public uint Vehicle, PilotGuid, StartStep;
+            public int Station;
+            public double X, Y, Z, VX, VY, VZ;
+            public double Terminal, Radius, Damage, MassLb;
+            public double Acc;
+            public int Steps;
+        }
+
+        static readonly List<Bomb> bombs = new List<Bomb>();
+        static readonly Stopwatch clock = Stopwatch.StartNew();
+        static double last = -1;
+
+        public static int InFlight => bombs.Count;
+        public static long Released, Detonated, Kills;
+
+        public static float MassLb(float kg) => (float)(Math.Round(kg * 2.20462 / 100.0) * 100.0);
+
+        /// <summary>One step of a bomb (mirrored by the client: scene3d/vehicle/fall_model.js stepBomb).</summary>
+        public static void Step(ref double x, ref double y, ref double z, ref double vx, ref double vy, ref double vz, double terminal, double dt)
+        {
+            var sp = Math.Sqrt(vx * vx + vy * vy + vz * vz);
+            var k = terminal > 0 ? Gravity / (terminal * terminal) : 0.0;
+            vx += -k * sp * vx * dt;
+            vy += -k * sp * vy * dt;
+            vz += (-Gravity - k * sp * vz) * dt;
+            x += vx * dt;
+            y += vy * dt;
+            z += vz * dt;
+        }
+
+        public static void Release(Vehicle v, Player pilot, int station, double x, double y, double z, Vector3 vel, VehicleWeaponExt ext, VehicleWeaponDef w)
+        {
+            if (bombs.Count >= MaxBombsInFlight)
+                return;
+            bombs.Add(new Bomb
+            {
+                Vehicle = v.Guid.Full, PilotGuid = pilot.Guid.Full, StartStep = v.SimStep, Station = station,
+                X = x, Y = y, Z = z, VX = vel.X, VY = vel.Y, VZ = vel.Z,
+                Terminal = ext.DragTerminal, Radius = Math.Max(1f, w.Range), Damage = w.Damage, MassLb = MassLb(ext.MassKg),
+            });
+            Released++;
+        }
+
+        public static void Tick()
+        {
+            var now = clock.Elapsed.TotalSeconds;
+            if (last < 0) last = now;
+            var elapsed = Math.Min(1.0, now - last);
+            last = now;
+            if (bombs.Count == 0)
+                return;
+            for (var i = bombs.Count - 1; i >= 0; i--)
+            {
+                var b = bombs[i];
+                b.Acc += elapsed;
+                var done = false;
+                while (b.Acc >= Dt && !done)
+                {
+                    b.Acc -= Dt;
+                    double px = b.X, py = b.Y, pz = b.Z;
+                    Step(ref b.X, ref b.Y, ref b.Z, ref b.VX, ref b.VY, ref b.VZ, b.Terminal, Dt);
+                    b.Steps++;
+                    if (b.X < FlightModel.WorldMin || b.Y < FlightModel.WorldMin || b.X > FlightModel.WorldMax || b.Y > FlightModel.WorldMax
+                        || b.Steps * Dt > MaxFallSeconds)
+                    {
+                        done = true; // off the map / lost: a dud
+                        break;
+                    }
+                    var g = VehicleTerrain.Ground(b.X, b.Y);
+                    if (double.IsNaN(g) || b.Z > g)
+                        continue;
+                    // the impact: where the step's segment met the ground (the ground under both ends, linearly)
+                    var g0 = VehicleTerrain.Ground(px, py);
+                    var h0 = double.IsNaN(g0) ? 0.0 : pz - g0;
+                    var h1 = b.Z - g;
+                    var f = h0 > 0 && h0 - h1 > 1e-9 ? h0 / (h0 - h1) : 1.0;
+                    var ix = px + (b.X - px) * f;
+                    var iy = py + (b.Y - py) * f;
+                    var ig = VehicleTerrain.Ground(ix, iy);
+                    var iz = double.IsNaN(ig) ? g : ig;
+                    try
+                    {
+                        Detonate(b, ix, iy, iz);
+                    }
+                    catch (Exception e)
+                    {
+                        log.Error($"[VEHICLE] bomb detonation failed: {e}");
+                    }
+                    done = true;
+                }
+                if (done)
+                    bombs.RemoveAt(i);
+            }
+        }
+
+        static float Falloff(double d, double radius)
+        {
+            if (d >= radius) return 0f;
+            var inner = radius * 0.25;
+            if (d <= inner) return 1f;
+            return (float)(1.0 - 0.85 * (d - inner) / (radius - inner));
+        }
+
+        static readonly List<Creature> victims = new List<Creature>();
+
+        static void Detonate(Bomb b, double x, double y, double z)
+        {
+            Detonated++;
+            var pilot = PlayerManager.GetOnlinePlayer(b.PilotGuid);
+            var at = Vehicle.ToPosition(x, y, z + 0.1, Quaternion.Identity);
+            var lbx = (int)Math.Floor(x / 192.0);
+            var lby = (int)Math.Floor(y / 192.0);
+            var loaded = LandblockManager.GetLoadedLandblock(lbx, lby) != null;
+            var hits = 0;
+            var kills = 0;
+            if (loaded)
+            {
+                SpawnFireball(at, b, pilot);
+                if (pilot != null && !pilot.IsDead && pilot.Session != null)
+                    (hits, kills) = Blast(pilot, x, y, z, b);
+            }
+            Kills += kills;
+
+            var v = VehicleManager.Get(b.Vehicle);
+            VehicleManager.BroadcastNear(at, ExplosionEventRange, pilot, () => new VehicleEventMsg
+            {
+                Vehicle = b.Vehicle, Kind = (uint)VehicleEventKind.Explosion, Step = v?.SimStep ?? 0, Subject = b.PilotGuid,
+                Cell = at.Cell, Position = at.Pos, Value = (float)b.MassLb, Aux = (uint)b.Station, Velocity = new Vector3((float)b.VX, (float)b.VY, (float)b.VZ),
+            });
+            if (v != null)
+            {
+                v.Costs.BombHits += hits;
+                v.Costs.BombKills += kills;
+            }
+            log.Info($"[VEHICLE] a {b.MassLb:0} lb bomb exploded at {at.ToLOCString()} after {b.Steps * Dt:0.0} s ({Math.Sqrt(b.VX * b.VX + b.VY * b.VY + b.VZ * b.VZ):0} m/s): {hits} hit, {kills} killed{(loaded ? "" : " (landblock not loaded)")}");
+        }
+
+        /// <summary>Blast damage to the outdoor creatures in reach. Returns (hit, killed).</summary>
+        static (int hits, int kills) Blast(Player pilot, double x, double y, double z, Bomb b)
+        {
+            var r = b.Radius;
+            var x0 = (int)Math.Floor((x - r) / 192.0);
+            var x1 = (int)Math.Floor((x + r) / 192.0);
+            var y0 = (int)Math.Floor((y - r) / 192.0);
+            var y1 = (int)Math.Floor((y + r) / 192.0);
+            var gunPlayers = VehicleWeapons.GunHitsPlayers;
+            victims.Clear();
+            for (var lx = x0; lx <= x1; lx++)
+                for (var ly = y0; ly <= y1; ly++)
+                {
+                    var lb = LandblockManager.GetLoadedLandblock(lx, ly);
+                    if (lb == null) continue;
+                    foreach (var wo in lb.GetAllWorldObjectsForDiagnostics())
+                    {
+                        if (wo is not Creature c || c.IsDead || c.IsDestroyed || c.PhysicsObj == null || c.Location == null || c.Location.Indoors)
+                            continue;
+                        if (c is Player p)
+                        {
+                            if (!gunPlayers || p == pilot || VehicleManager.IsSeated(p) || VehicleBailout.IsFalling(p))
+                                continue;
+                        }
+                        else if (!c.Attackable)
+                            continue;
+                        victims.Add(c);
+                    }
+                }
+            var hits = 0;
+            var kills = 0;
+            foreach (var c in victims)
+            {
+                var (cx, cy, cz) = Vehicle.ToGlobal(c.Location);
+                var h = Math.Max(0.5f, c.PhysicsObj.GetHeight());
+                var cr = Math.Max(0.3f, c.PhysicsObj.GetRadius());
+                var dz = z - (cz + h * 0.5);
+                var d = Math.Max(0.0, Math.Sqrt((cx - x) * (cx - x) + (cy - y) * (cy - y) + dz * dz) - cr);
+                var k = Falloff(d, r);
+                if (k <= 0f) continue;
+                var amount = (float)(b.Damage * k * (0.9 + 0.2 * VehicleWeapons.VehicleRng.NextDouble()));
+                hits++;
+                if (c is Player victim)
+                {
+                    victim.TakeDamage(pilot, DamageType.Fire, amount, BodyPart.Chest, false);
+                    if (victim.IsDead) kills++;
+                    continue;
+                }
+                var dealt = c.TakeDamage(pilot, DamageType.Fire, amount, false);
+                if (c.IsAlive && dealt > 0)
+                {
+                    pilot.Session?.Network.EnqueueSend(new GameEventAttackerNotification(pilot.Session, c.Name, DamageType.Fire,
+                        (float)dealt / Math.Max(1u, c.Health.MaxValue), dealt, false, AttackConditions.None));
+                    c.EmoteManager.OnDamage(pilot);
+                }
+                else if (!c.IsAlive)
+                    kills++;
+                pilot.OnAttackMonster(c);
+            }
+            victims.Clear();
+            return (hits, kills);
+        }
+
+        /// <summary>
+        /// The fireball: Flame Bolt projectiles placed on the ground at the impact (a centre burst and a ring) and detonated at
+        /// once — each plays the retail fire explosion (PlayScript.Explode at full intensity) for every client in sight.
+        /// </summary>
+        static void SpawnFireball(Position at, Bomb b, Player pilot)
+        {
+            var spell = new Spell(BurstSpellId);
+            if (spell.NotFound || spell.Wcid == 0)
+                return;
+            var ring = b.MassLb >= 1500 ? 4 : 2;
+            var ringR = b.Radius * 0.35;
+            var (cx, cy, _) = Vehicle.ToGlobal(at);
+            for (var i = 0; i <= ring; i++)
+            {
+                double x = cx, y = cy;
+                if (i > 0)
+                {
+                    var a = 2.0 * Math.PI * (i - 1) / ring + b.Station;
+                    x += ringR * Math.Cos(a);
+                    y += ringR * Math.Sin(a);
+                }
+                var g = VehicleTerrain.Ground(x, y);
+                if (double.IsNaN(g)) continue;
+                var sp = WorldObjectFactory.CreateNewWorldObject(spell.Wcid) as SpellProjectile;
+                if (sp == null) return;
+                sp.Setup(spell, ProjectileSpellType.Bolt);
+                // a visual only: never collides (Setup made it solid), never damages
+                sp.Ethereal = true;
+                sp.IgnoreCollisions = true;
+                sp.ReportCollisions = false;
+                sp.ProjectileSource = pilot;
+                sp.Location = Vehicle.ToPosition(x, y, g + (i == 0 ? 1.0 : 0.6), Quaternion.Identity);
+                if (!LandblockManager.AddObject(sp))
+                {
+                    sp.Destroy();
+                    continue;
+                }
+                sp.ProjectileImpact();
+            }
+        }
+
+        public static string Report() => $"bombs: {bombs.Count} falling, {Released} released, {Detonated} exploded, {Kills} killed";
+    }
+}
