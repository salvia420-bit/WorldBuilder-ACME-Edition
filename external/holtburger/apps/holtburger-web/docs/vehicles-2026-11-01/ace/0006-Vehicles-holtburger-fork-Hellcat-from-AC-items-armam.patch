+                var tFlight = Vector3.Distance(aimPoint, muzzle) / speed;
+                var lead = target.PhysicsObj?.CachedVelocity ?? Vector3.Zero;
+                velocity = Vector3.Normalize(aimPoint + lead * tFlight - muzzle) * speed;
+            }
+            else
+                velocity = vVel + fwd * launch;
+
+            var sp = WorldObjectFactory.CreateNewWorldObject(spell.Wcid) as SpellProjectile;
+            if (sp == null)
+            {
+                log.Warn($"[VEHICLE] {v.Name}: could not create the rail projectile (wcid {spell.Wcid})");
+                return;
+            }
+            sp.Setup(spell, ProjectileSpellType.Bolt);
+            sp.Location = Vehicle.ToPosition(mx, my, mz, q);
+            sp.PhysicsObj.Velocity = velocity;
+            var dir = Vector3.Normalize(velocity);
+            sp.PhysicsObj.Position.Frame.set_vector_heading(dir);
+            sp.Location.Rotation = sp.PhysicsObj.Position.Frame.Orientation;
+            sp.ProjectileSource = pilot;
+            sp.ProjectileTarget = target;
+            sp.ProjectileLauncher = v;   // resisted by the vehicle's ItemSpellcraft (VehicleProfile.RailSpellcraft)
+            sp.IsWeaponSpell = true;
+            sp.FromProc = false;
+            sp.SetProjectilePhysicsState(target, false);
+            sp.SpawnPos = new Position(sp.Location);
+            if (!LandblockManager.AddObject(sp))
+            {
+                sp.Destroy();
+                return;
+            }
+            sp.EnqueueBroadcast(new GameMessageScript(sp.Guid, PlayScript.Launch, sp.GetProjectileScriptIntensity(ProjectileSpellType.Bolt)));
+
+            // a bolt that hits nothing within the rail's range bursts there (ACE bolts otherwise fly until they hit something)
+            var life = Math.Clamp(w.Range / Math.Max(1f, velocity.Length()), 0.5f, 20f);
+            var chain = new ActionChain();
+            chain.AddDelaySeconds(life);
+            chain.AddAction(sp, () =>
+            {
+                if (!sp.IsDestroyed && sp.PhysicsObj != null && sp.PhysicsObj.is_active())
+                    sp.ProjectileImpact();
+            });
+            chain.EnqueueChain();
+
+            // the launch for capable clients (the rail's wand empties; a flash at the muzzle)
+            var pos = Vehicle.ToPosition(mx, my, mz, q);
+            VehicleManager.BroadcastFire(v, new VehicleFireMsg
+            {
+                Vehicle = v.Guid.Full, Step = v.SimStep, Mount = (ushort)gi, Count = 1, MountCount = 1, Cell = pos.Cell, Muzzle = pos.Pos,
+                DirX = (short)Math.Round(dir.X * 32767f), DirY = (short)Math.Round(dir.Y * 32767f), DirZ = (short)Math.Round(dir.Z * 32767f),
