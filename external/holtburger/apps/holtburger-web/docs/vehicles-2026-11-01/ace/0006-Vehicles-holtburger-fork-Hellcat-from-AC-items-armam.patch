+            VehicleManager.BroadcastEvent(v, VehicleEventKind.BombRelease, pilot.Guid.Full, lb, pos, pilot, (uint)gi, vel);
+            log.Info($"[VEHICLE] {pilot.Name} released a {lb:0} lb bomb from {v.Name} 0x{v.Guid.Full:X8} at {VehicleManager.AglOf(v):0} m AGL, {v.State.Speed * 3.6:0} km/h");
