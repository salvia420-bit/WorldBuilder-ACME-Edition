                             // generators wait for the spawn-cache warm-up (the corridor's, still running, or one started now)
                             if (IsVehicleLoaderThread)
                                 Vehicles.VehicleStreaming.MarkSpawnWarmup(landblock);
-                            else if (Vehicles.VehicleStreaming.LandblockBudget)
+                            else if (Vehicles.VehicleStreaming.LandblockBudget && !(Vehicles.VehicleStreaming.DeferDungeons && landblock.IsDungeon))
                                 Vehicles.VehicleStreaming.WarmSpawnsAsync(landblock);
                         }
                         LastLoadConstructMs = swLoad.Elapsed.TotalMilliseconds;
