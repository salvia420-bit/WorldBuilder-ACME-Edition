+        [TestMethod]
+        public void Hbv1TruncatedV2TailAndHostileV2CountsRejected()
+        {
+            // a v2 payload cut inside its v2 tail is truncated, not a v1 payload
+            foreach (var (name, op) in new[] {
+                ("vehicle_state_pilot", VehicleWire.OpState), ("vehicle_fire", VehicleWire.OpFire),
+                ("vehicle_event_bomb_release", VehicleWire.OpEvent), ("vehicle_profile_hellcat", VehicleWire.OpProfile) })
+            {
+                var bytes = Hex(Fixture(name).GetProperty("hex").GetString());
+                foreach (var cut in new[] { bytes.Length - 1, bytes.Length - 4 })
+                    Assert.IsNull(Read("S2C", op, bytes.Take(cut).ToArray()), $"{name} cut {cut}");
+            }
+            // hostile PartRoleCount / WeaponExtCount cannot allocate past the payload
+            var fx = Fixture("vehicle_profile_hellcat");
+            var roles = (int)U(fx.GetProperty("fields"), "PartRoleCount");
+            var exts = (int)U(fx.GetProperty("fields"), "WeaponExtCount");
+            var profile = Hex(fx.GetProperty("hex").GetString());
+            var extCountAt = profile.Length - (4 + VehicleWeaponExt.WireSize * exts);
+            var roleCountAt = extCountAt - (4 + 4 * roles);
+            foreach (var at in new[] { roleCountAt, extCountAt })
