Date: Fri, 20 Nov 2026 14:00:45 +0000
Subject: [PATCH 23/30] Vehicles (holtburger fork): Tier 5 final
 LandblockManager continent and PowerGenerator dt fixes

Fixes 2 remaining findings from Tier 5 Challenger 5 audit:
- LandblockManager (IsLoaded, GetLandblock, GetAdjacents, GetAdjacentID, UnloadLandblocks): replace raw bit-15 ((Raw >> 15) & 1) continent indexing with LandblockId.Continent so 0xXXYYFFFF sentinels (including apartmentLandblocks) and indoor EnvCells (>= 0x100) stay on Dereth [0, x, y] instead of misrouting into Dericost [1, x, y].
- PowerGeneratorDeployable.Tick: add !double.IsFinite(elapsedSeconds) || elapsedSeconds <= 0.0 early return so negative, NaN, or infinite dt cannot add free fuel or permanently NaN-poison FuelSecondsRemaining.
- Added targeted regression tests in DericostContinentInvariantsTests and DeployableEcosystemTests.

Verified with dotnet test ACE.Server.Tests (Vehicles|Landblock): 356/356 passed.
---
 .../Vehicles/DeployableEcosystemTests.cs      | 36 ++++++++
 .../DericostContinentInvariantsTests.cs       | 88 +++++++++++++++++++
 .../ACE.Server/Managers/LandblockManager.cs   | 10 +--
 .../Deployables/PowerGeneratorDeployable.cs   |  3 +
 4 files changed, 132 insertions(+), 5 deletions(-)

diff --git a/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs b/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
index f778b5a5..493b6bf7 100644
--- a/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
+++ b/Source/ACE.Server.Tests/Vehicles/DeployableEcosystemTests.cs
@@ -2553,6 +2553,42 @@ public void GroundRadar_TargetMonsters_IgnoresPlayersVendorsPetsAndNonAttackable
             }
         }
 
+        [TestMethod]
+        public void PowerGenerator_Tick_IgnoresNonPositiveAndNonFiniteElapsedSeconds()
+        {
+            var pg = new PowerGeneratorDeployable(PowerGeneratorDeployable.BuildWeenie(), new ObjectGuid(0x7500E401u))
+            {
+                FuelSecondsRemaining = 100.0,
+                IsPacked = false,
+                IsActive = true,
+                IsStowed = false,
+            };
+
+            pg.Tick(0.0);
+            Assert.AreEqual(100.0, pg.FuelSecondsRemaining, 1e-9, "Zero dt must leave fuel unchanged");
+
+            pg.Tick(-5.0);
+            Assert.AreEqual(100.0, pg.FuelSecondsRemaining, 1e-9, "Negative dt must not add free fuel");
+
+            pg.Tick(double.NaN);
+            Assert.IsFalse(double.IsNaN(pg.FuelSecondsRemaining), "NaN dt must not poison FuelSecondsRemaining");
+            Assert.AreEqual(100.0, pg.FuelSecondsRemaining, 1e-9);
+
+            pg.Tick(double.PositiveInfinity);
+            Assert.AreEqual(100.0, pg.FuelSecondsRemaining, 1e-9, "PositiveInfinity dt must be ignored");
+
+            pg.Tick(double.NegativeInfinity);
+            Assert.AreEqual(100.0, pg.FuelSecondsRemaining, 1e-9, "NegativeInfinity dt must be ignored");
+            Assert.AreEqual(PowerGeneratorDeployable.OutputPowerWatts, pg.PowerWatts);
+
+            pg.AddFuel(1);
+            Assert.AreEqual(220.0, pg.FuelSecondsRemaining, 1e-9);
+
+            pg.Tick(20.0);
+            Assert.AreEqual(200.0, pg.FuelSecondsRemaining, 1e-9);
+            Assert.AreEqual(PowerGeneratorDeployable.OutputPowerWatts, pg.PowerWatts);
+        }
+
         #endregion
     }
 }
