 using ACE.Server.Physics.Common;
 using ACE.Server.Vehicles;
 
@@ -330,5 +335,88 @@ public void VehicleToGlobal_IsDericostCell_And_LandblockIdContinent_ExcludeIndoo
             Assert.AreEqual(lbOut.GetHashCode(), lbEnv.GetHashCode(), "Equal LandblockIds must produce identical hash codes");
             Assert.AreEqual(lbOut.GetHashCode(), lbFf.GetHashCode(), "Equal LandblockIds must produce identical hash codes");
         }
+
+        [TestMethod]
+        public void LandblockManager_UsesLandblockIdContinent_For0xFFFFSentinelAndIndoorEnvCell8100()
+        {
+            var landblocksField = typeof(LandblockManager).GetField("landblocks", BindingFlags.Static | BindingFlags.NonPublic);
+            Assert.IsNotNull(landblocksField);
+            var grid = (ACE.Server.Entity.Landblock[,,])landblocksField.GetValue(null);
+            Assert.IsNotNull(grid);
+
+            var getAdjacentIdMethod = typeof(LandblockManager).GetMethod("GetAdjacentID", BindingFlags.Static | BindingFlags.NonPublic);
+            Assert.IsNotNull(getAdjacentIdMethod);
+
+            var getAdjacentsMethod = typeof(LandblockManager).GetMethod("GetAdjacents", BindingFlags.Static | BindingFlags.NonPublic);
+            Assert.IsNotNull(getAdjacentsMethod);
+
+            var prevDereth7200 = grid[0, 0x72, 0x00];
+            var prevDericost7200 = grid[1, 0x72, 0x00];
+            var prevDereth7300 = grid[0, 0x73, 0x00];
+            var prevDericost7300 = grid[1, 0x73, 0x00];
+
+            var dereth7200 = (ACE.Server.Entity.Landblock)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Entity.Landblock));
+            typeof(ACE.Server.Entity.Landblock).GetField("<Id>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(dereth7200, new LandblockId(0x7200_FFFFu));
+            typeof(ACE.Server.Entity.Landblock).GetField("isDungeon", BindingFlags.Instance | BindingFlags.NonPublic)
+                ?.SetValue(dereth7200, false);
+
+            var dericost7200 = (ACE.Server.Entity.Landblock)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Entity.Landblock));
+            var eastDereth7300 = (ACE.Server.Entity.Landblock)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Entity.Landblock));
+            var eastDericost7300 = (ACE.Server.Entity.Landblock)RuntimeHelpers.GetUninitializedObject(typeof(ACE.Server.Entity.Landblock));
+
+            var idSentinel = new LandblockId(0x7200_FFFFu);
+            var idIndoor8100 = new LandblockId(0x7200_8100u);
+            var idDericost = new LandblockId(0x7200_8001u);
+
+            try
+            {
+                // 1. Only Dereth [0, 0x72, 0x00] populated
+                grid[0, 0x72, 0x00] = dereth7200;
+                grid[1, 0x72, 0x00] = null;
+
+                Assert.IsTrue(LandblockManager.IsLoaded(idSentinel), "0x7200FFFF must resolve to Dereth slot [0, 0x72, 0x00]");
+                Assert.IsTrue(LandblockManager.IsLoaded(idIndoor8100), "0x72008100 must resolve to Dereth slot [0, 0x72, 0x00]");
+                Assert.IsFalse(LandblockManager.IsLoaded(idDericost), "0x72008001 must resolve to Dericost slot [1, 0x72, 0x00]");
+
+                Assert.AreSame(dereth7200, LandblockManager.GetLandblock(idSentinel, false));
+                Assert.AreSame(dereth7200, LandblockManager.GetLandblock(idIndoor8100, false));
+
+                // 2. Only Dericost [1, 0x72, 0x00] populated
+                grid[0, 0x72, 0x00] = null;
+                grid[1, 0x72, 0x00] = dericost7200;
+
+                Assert.IsFalse(LandblockManager.IsLoaded(idSentinel), "0x7200FFFF must not match Dericost slot [1, 0x72, 0x00]");
+                Assert.IsFalse(LandblockManager.IsLoaded(idIndoor8100), "0x72008100 must not match Dericost slot [1, 0x72, 0x00]");
+                Assert.IsTrue(LandblockManager.IsLoaded(idDericost), "0x72008001 must match Dericost slot [1, 0x72, 0x00]");
+                Assert.AreSame(dericost7200, LandblockManager.GetLandblock(idDericost, false));
+
+                // 3. GetAdjacentID must route 0x7200FFFF / 0x72008100 East to Dereth 0x73000000, and 0x72008001 East to Dericost 0x73008000
+                var adjSentinel = (LandblockId?)getAdjacentIdMethod.Invoke(null, new object[] { idSentinel, Adjacency.East });
+                var adjIndoor8100 = (LandblockId?)getAdjacentIdMethod.Invoke(null, new object[] { idIndoor8100, Adjacency.East });
+                var adjDericost = (LandblockId?)getAdjacentIdMethod.Invoke(null, new object[] { idDericost, Adjacency.East });
+
+                Assert.IsTrue(adjSentinel.HasValue);
+                Assert.IsTrue(adjIndoor8100.HasValue);
+                Assert.IsTrue(adjDericost.HasValue);
+                Assert.AreEqual(0x7300_0000u, adjSentinel.Value.Raw, "East neighbor of 0x7200FFFF must be Dereth 0x73000000");
+                Assert.AreEqual(0x7300_0000u, adjIndoor8100.Value.Raw, "East neighbor of 0x72008100 must be Dereth 0x73000000");
+                Assert.AreEqual(0x7300_8000u, adjDericost.Value.Raw, "East neighbor of 0x72008001 must be Dericost 0x73008000");
+
+                // 4. GetAdjacents for a 0x7200FFFF Landblock must pick Dereth [0, 0x73, 0x00] and not Dericost [1, 0x73, 0x00]
+                grid[0, 0x73, 0x00] = eastDereth7300;
+                grid[1, 0x73, 0x00] = eastDericost7300;
+                var adjacents = (List<ACE.Server.Entity.Landblock>)getAdjacentsMethod.Invoke(null, new object[] { dereth7200 });
+                Assert.IsTrue(adjacents.Contains(eastDereth7300), "GetAdjacents for 0x7200FFFF must return Dereth east neighbor");
+                Assert.IsFalse(adjacents.Contains(eastDericost7300), "GetAdjacents for 0x7200FFFF must not return Dericost east neighbor");
+            }
+            finally
+            {
+                grid[0, 0x72, 0x00] = prevDereth7200;
+                grid[1, 0x72, 0x00] = prevDericost7200;
+                grid[0, 0x73, 0x00] = prevDereth7300;
+                grid[1, 0x73, 0x00] = prevDericost7300;
+            }
+        }
     }
 }
