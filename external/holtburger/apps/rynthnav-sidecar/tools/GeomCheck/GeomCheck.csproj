<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RynthNav.GeomCheck</RootNamespace>
    <AssemblyName>GeomCheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same pin as GeomExtract — the point is to audit the exact parse behavior
         the extractor ships with. -->
    <PackageReference Include="Chorizite.DatReaderWriter" Version="2.1.2" />
  </ItemGroup>

</Project>
