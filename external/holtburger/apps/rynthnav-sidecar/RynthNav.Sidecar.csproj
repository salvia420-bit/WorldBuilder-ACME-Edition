<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RynthNav.Sidecar</RootNamespace>
    <AssemblyName>RynthNav.Sidecar</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Vendored upstream files (DatDatabase.cs) predate nullable annotations. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same pins as upstream RynthNav.Baker.csproj / RynthCore.Plugin.RynthNav.csproj -->
    <PackageReference Include="DotRecast.Core" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Recast" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Recast.Toolset" Version="2026.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/GeomExtract is its own project (the ONLY place with a DAT-parsing dep). -->
    <Compile Remove="tools\**\*.cs" />
    <None Include="data\portals.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
