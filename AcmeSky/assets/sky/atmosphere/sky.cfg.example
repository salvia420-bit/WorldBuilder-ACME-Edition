# AcmeSky live sky tuning -- COPY THIS TO  C:\Temp\acdt\sky.cfg  on the client box.
# Edited live: the plugin re-reads it once per second, so changes take effect in-game
# WITHOUT a restart and WITHOUT environment variables (the acclient does not inherit the
# launcher .bat's env). Lines are `key = value`; '#' or ';' starts a comment.

# --- world swizzle (THE 2026-08-21 fix; leave ON) ---------------------------------------
# The client's D3D render world is the AC world with y and z SWAPPED (Y-up). Decomp proof:
# PrimD3DRender::ScreenToViewTransform assigns its unprojected components to dir->x, dir->z,
# dir->y. Without this swizzle the sky is rolled ~90deg (up points north) AND the horizon
# slices the screen vertically (the "seam"). CPU-replica-verified (scratch skysim).
worldswizzle = 1

# --- ray reconstruction variant (diagnostics only; 0 is CORRECT) ------------------------
#   0 = row-vector both (baseline, verified) 1 = transpose invProj  2 = transpose invView
#   3 = transpose both                  4 = swap NDC x<->y       5 = negate NDC y
#   6 = negate NDC x                    7 = swap + negate-x      8 = swap + negate-y
#   9 = build NDC from SV_Position/resolution instead of uv
raymode = 0

# --- AC(E,N,U) -> shader(y-up) axis map. Each of the 3 output comps = +/-{x,y,z} of the
#     AC vector (AC: x=east, y=north, z=up). With worldswizzle=1 the ray/camera reach this
#     map already in AC (E,N,U), same as the sun/moon, so the default is correct for all.
axis = x,z,-y

# --- output / debug ---------------------------------------------------------------------
#   0 = AgX + sRGB (final look)      1 = AgX linear
#   2 = raw exposure (no AgX)        3 = exposure + sRGB, no AgX
#   4 = RAY DIRECTION debug (AC space)  -> R=east G=north B=up. A CORRECT basis shows
#       BLUE increasing toward the TOP of the screen (level camera: top-center sample
#       ~ (0.5, 0.92, 0.77) when facing north).
#   5 = ray direction debug (shader space) -> GREEN(+Y) should increase toward the top.
output = 0

# --- look / model -----------------------------------------------------------------------
exposure = 5        # AgX exposure (holtburger uses 5)
time     = -1       # 0..1 forced time-of-day; -1 = game clock (GameTime.present_time_of_day)
timeofs  = 0        # phase shift added to the CLOCK time (mod 1) if fraction 0 != midnight
sunang   = 0.03     # sun disc angular radius
moonang  = 0.025    # moon disc angular radius
lunar    = 1        # moon disc brightness scale (0 = off)
lutflipv = 0        # 0/1 flip LUT V sampling (verified correct at 0)
stars    = 1        # star-field base intensity (0 = off). Night fade applies on top:
                    # stars appear as the sun drops below ~ -6deg (sun-alt band +-0.10),
                    # full at the -14deg night floor. Field = takram stars.bin (9,096 stars),
                    # sidereal rotation on the AC 11.34x game clock.

# --- M2 volumetric clouds (takram three-clouds port; the owner's holtburger rig:
#     ?quality=ultra&clouds=on&wxMap=nasa with cloudWeather on) ---------------------------
clouds     = 1      # 0 = off
wxmap      = nasa   # weather map (INIT-TIME): default | nasa (Blue Marble, A = real storm
                    # cores) | dereth (biome-anchored). nasa gets the ~25 km/h linear drift.
cloudcover = 0.5    # takram coverage under the FAIR look
cloudcoverstorm = 0.55  # coverage under the STORM look
storm      = -1     # -1 = AUTO (client weather flag = the retail is_storm signal switches
                    # FAIR <-> STORM: 600 m deck + cumulonimbus tower + 10x haze), 0/1 force
clouditers = 500    # primary raymarch cap (takram high preset; 200 = low)
cloudres   = 1      # cloud RT resolution fraction (1 = full; ~75 fps on the 1070 at 1080p)
cloudminstep = 50   # primary march min step, metres (50 = takram high, 10 = ultra)
cloudsunsteps = 2   # secondary sun march iterations
cloudgroundsteps = 3 # ground-bounce march iterations (0 = off)
cloudaccurate = 1   # 1 = ACCURATE_SUN_SKY_LIGHT (per-sample Bruneton irradiance)
cloudturb  = 1      # 1 = TURBULENCE displacement (350 m, repeat 20)
cloudhaze  = 1      # 1 = takram haze (3e-5 fair / 3e-4 storm)
# NOT ported (the one remaining takram gap): Beer Shadow Map + light shafts.
# debug outputs (see `output` above): 6 = clouds-only (tonemapped over black),
# 7 = aerial-perspective inscatter raw, 8 = AP transmittance raw, 9 = cloud front depth.

# --- capture aids ------------------------------------------------------------------------
dump     = 0        # 1 = write the composited backdrop as C:\Temp\acdt\skydump-N.bmp once
                    # per second (rotating 8) — ground-truth frames, immune to stale GDI.
campitch = 0        # deg: pitch the SKY camera up for captures (game camera ignores
                    # injected keys); affects the in-game backdrop while set — reset after.
