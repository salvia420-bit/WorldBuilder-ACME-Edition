<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<Version>1.2.0</Version>
		<AssemblyTitle>WorldBuilder.Terminal</AssemblyTitle>
		<Description>Headless DAT export and world-editing terminal for ACME WorldBuilder</Description>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<BuildInParallel>false</BuildInParallel>
		<UseLocalReferenceBuild Condition="'$(UseLocalReferenceBuild)'==''">false</UseLocalReferenceBuild>
		<RestoreBuildInParallel>false</RestoreBuildInParallel>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseLocalReferenceBuild)'!='true'">
		<PackageReference Include="Chorizite.DatReaderWriter" Version="2.1.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- Required to use Encoding.GetEncoding(1252) in chorizite-hash-string. -->
		<PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
		<PackageReference Include="MemoryPack" Version="1.21.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.9" />
		<PackageReference Include="MySqlConnector" Version="2.5.0" />
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalReferenceBuild)'!='true'">
		<ProjectReference Include="..\WorldBuilder.Shared\WorldBuilder.Shared.csproj" />
		<ProjectReference Include="..\DatReaderWriter.Extensions\DatReaderWriter.Extensions\DatReaderWriter.Extensions.csproj" />
		<!-- Chorizite.Common: enums + EventArgs. Lean deps (MS.Logging.Abstractions, System.Text.Json). -->
		<!-- Vendored at external/chorizite/Chorizite.Common/ per external/chorizite/VENDORED.md. -->
		<ProjectReference Include="..\external\chorizite\Chorizite.Common\Chorizite.Common.csproj" />
		<!-- W1.A0 SPIKE: Chorizite.ACProtocol ProjectReference. Pulls in 368 message types
		     via source generator. Track dep-graph carefully — if RmlUi/Lua/Autofac/Silk
		     deps surface, revert and use regex-parse fallback. -->
		<ProjectReference Include="..\external\chorizite\Chorizite.ACProtocol\Chorizite.ACProtocol\Chorizite.ACProtocol.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalReferenceBuild)'=='true'">
		<_LocalBuildReference Include="$(MSBuildThisFileDirectory)bin\Debug\net8.0\*.dll"
			Exclude="$(MSBuildThisFileDirectory)bin\Debug\net8.0\WorldBuilder.Terminal.dll" />
		<Reference Include="@(_LocalBuildReference->'%(Filename)')">
			<HintPath>%(_LocalBuildReference.FullPath)</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- Static site assets shipped with the binary so emit-static-site can
		     copy them into dist/ regardless of CWD. -->
		<Content Include="StaticSite\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<!-- Render gallery template, used by emit-render-gallery. -->
		<Content Include="RenderGallery\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<!-- Visual-Behavior Suite archetype-rule registry (single source of
		     truth for `vfx classify` / `vfx emit-allowlist`). Shipped next to the
		     binary so the round-trip works regardless of CWD / loaded project. -->
		<Content Include="VfxData\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WorldBuilder.Tests" />
	</ItemGroup>

	<!-- AcClient.UIElementId: 1,776-line retail-shipped enum mapping element IDs
	     (e.g. 0x10000036) to symbolic names (e.g. RootRadar_Field). Lives in
	     Chorizite's NativeClientBootstrapper, but the file has no dependencies
	     beyond System — we pull just this one file via <Compile Include> so
	     chorizite-dump-layout-tree's opt-in resolveSymbols path can name element
	     IDs the way ac.yotes.fan does, without dragging in the plugin host's
	     Autofac/Silk/Lua deps. Unknown IDs fall back to hex (preserves the
	     "could be a custom layout post-classic-era" case). -->
	<ItemGroup>
		<Compile Include="..\external\chorizite\Chorizite\Chorizite.NativeClientBootstrapper\AcClient\UIElementId.cs"
		         Link="Vendored\AcClient\UIElementId.cs" />
	</ItemGroup>

</Project>
