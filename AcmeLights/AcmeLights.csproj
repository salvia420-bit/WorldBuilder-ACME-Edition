<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AcmeLights - Chorizite plugin: runtime physics ragdoll deaths for retail AC.

    Build conventions are COPIED verbatim from the shipped sibling plugin
    ../AcmeRedline/AcmeRedline.csproj (which was in turn validated against the two
    in-tree plugins external/chorizite/ACPlugin and external/chorizite/RmlUiPlugin):
      * EnableDynamicLoading + flattened OutputPath;
      * vendored framework projects referenced with Private=false ExcludeAssets=runtime
        (compile against them, never ship a second copy - the Chorizite host owns them);
      * host-provided NuGet packages pinned to the versions the *vendored* Chorizite.Core
        pulls (Autofac 8.4.0, Logging.Abstractions 9.0.9) to avoid an NU1605 downgrade.

    THE ONE NEW DEPENDENCY vs AcmeRedline:  Reloaded.Hooks 4.3.3.
    AcmeRedline deliberately avoided Reloaded.Hooks and hand-rolled a D3D9 vtable swap,
    because for its job (a device-vtable overlay) a second hooking engine would have been
    a footgun.  AcmeLights's job is the OPPOSITE: it must place INLINE TRAMPOLINE DETOURS
    on client C++ functions (CPartArray::UpdateParts, CPhysicsObj::MotionDone), which have
    no vtable to swap - exactly what Reloaded.Hooks does, and exactly how Chorizite's own
    bootstrapper hooks client functions
    (external/chorizite/.../Hooks/ACClientHooks.cs, DirectXHooks.cs, HookBase.cs).

    Reloaded.Hooks is referenced ExcludeAssets="runtime" so we compile against it but bind
    at runtime to the SINGLE copy the Chorizite bootstrapper already loaded
    (external/chorizite/Chorizite/Chorizite.NativeClientBootstrapper.csproj
     -> <PackageReference Include="Reloaded.Hooks" Version="4.3.3" />).  Sharing that one
    assembly identity is what keeps ReloadedHooks.Instance a single process-wide hooking
    engine rather than a competing second one.  See README.md "Reloaded.Hooks sharing".
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(TargetFramework)\</OutputPath>
    <IntermediateOutputPath>obj\$(TargetFramework)\</IntermediateOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <AssemblyName>AcmeLights</AssemblyName>
    <RootNamespace>AcmeLights</RootNamespace>
    <!-- ACBindings is a raw memory-layout binding surface; its docs are sparse. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\external\chorizite\Chorizite\Chorizite.Core\Chorizite.Core.csproj"
                      Private="false" ExcludeAssets="runtime" />
    <!-- ACBindings is NOT host-owned (unlike Core/Reloaded/Autofac): the Chorizite host never
         loads Chorizite.ACBindings, so it must ship WITH the plugin and be listed in the plugin's
         .deps.json, or the plugin ALC's AssemblyDependencyResolver refuses to load it at runtime
         (FileNotFoundException in the native detour thread even though the dll sits in the folder).
         Ship it (Private=true, runtime assets included). Core stays host-owned below. -->
    <ProjectReference Include="..\external\chorizite\ACBindings\Chorizite.ACBindings.csproj"
                      Private="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inline-detour hooking engine. Host-provided; must not be copied into the plugin. -->
    <PackageReference Include="Reloaded.Hooks" Version="4.3.3" ExcludeAssets="runtime" />
    <!-- Match what the vendored Chorizite.Core pulls (see AcmeRedline.csproj rationale). -->
    <PackageReference Include="Autofac" Version="8.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.9" ExcludeAssets="runtime" />
    <!-- P5 bloom compiles ps_2_0 HLSL at runtime for the client's own D3D9 device. Vortice.D3DCompiler
         is the managed D3DCompile binding; ship it + its native d3dcompiler (Private=true), same as
         AcmeSky. We do NOT touch D3D11/DXGI here (bloom is on the client D3D9 device). -->
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="lights.cfg.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
