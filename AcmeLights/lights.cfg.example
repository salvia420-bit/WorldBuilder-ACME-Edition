# AcmeLights tuning -- EXAMPLE FILE. The live file the plugin reads is
#   C:\Temp\acdt\lights.cfg
# (first-existing of: the plugin's env override, C:\Temp\acdt\lights.cfg, ~\.acdt\lights.cfg).
# Copy this there (or use zzpatcher's Tune tab / --tune lights.<knob>=<value>).
# The plugin re-reads it once per second -- edits land in-game without a restart.
# Lines are `key = value`; '#' starts a comment line. Values below are the
# shipped defaults. Help lives on the comment line ABOVE each key.
#
# GENERATED by tools/plugin-pack/gen_cfg_examples.py from Knobs.Generated.cs
# (itself generated from the plugin's own config class). Do not hand-maintain.

# --- Torches & ambient ---
# [0..60] 40..60 (hard array bound 60; retail default 40)
maxstatic = 60
# [0..10] 7..10 (hard array bound 10; retail default 7)
maxdynamic = 10
# [0..10] light reach multiplier (retail 1.5; 0 = leave)
rangeadjust = 0
# [0..10] global ambient multiplier (retail 1.0; 0 = leave)
ambientboost = 0

# --- Headlamp ---
# [0..100] intensity (holtburger parity 2.25; 0 = off)
headlamp = 0
# [0..100] metres (retail source constant 10.0)
headlampfalloff = 10
# hex RGB
headlampcolor = FFFFFF

# --- Torches & ambient ---
# [0..1] 0/1
flicker = 1
# [0..0.6] 0..0.6
flickeramp = 0.16
# [0..1] 1 = fix the retail red-bias bug (only .r scaled)
ambientfix = 1
# [-1..1] -1 = retail (0.2), else 0..1 level
dungeonambient = -1
# hex RGB (retail white)
dungeonambientcolor = FFFFFF
# [0..2] 0 off | 1 light unlit setup-light objects
torchlights = 1

# --- Bloom ---
# [0..1] 0/1 master
bloom = 1
# [0..2] luminance knee center (0..2)  ** NIGHT **
bloomthreshold = 0.55
# [0.001..1] soft-knee half-width (shared day+night)
bloomknee = 0.30
# [0..4] additive scale (0..4)          ** NIGHT **
bloomintensity = 2.0
# [1..4] separable blur H/V passes (1..4)  ** NIGHT **
bloomradius = 3
# [0..1] 0/1 master for day/night bloom scaling
bloomday = 1
# [0..2] luminance knee center by day
bloomdaythreshold = 0.38
# [0..4] additive scale by day (0..4)
bloomdayintensity = 3.2
# [1..4] blur passes by day (1..4)
bloomdayradius = 4
# [0..4] ambient intensity mapping to day=0
bloomnightamb = 0.20
# [0..4] ambient intensity mapping to day=1
bloomdayamb = 0.62

# --- Misc ---
# [0..2] 0 off | 1 the pool/selection heartbeat every 5 s
loglights = 1
# [0..1] 1 = write framedump-N.bmp (backbuffer) 1/sec (EndScene readback)
dump = 0
# [0..2] 0 none | >=1 endscene (capture)
extrahooks = 0

# --- Light selection ---
# [0..1] 0 retail first-8-overlap | 1 importance-ranked
selection = 1
# [1..8] HW lights per draw, 1..8 (8 is structural:
selbudget = 8
# [1..2] incumbent score margin, 1.0..2.0
selhysteresis = 1.15
# [0.5..4] scoring range = falloff * this. 1.5 = retail
selrange = 1.5
# [0..1] 1 = clear the curLightUsage carryOver byte on
selflicker = 1
# [0..1] 1 = read D3DCAPS9.MaxActiveLights once and clamp
selcaps = 1

# --- Glow lights ---
# [0..1] 0 off | 1 on (master)
glowlights = 1
# [0..1] 0/1 - ITEM_TYPE TYPE_PORTAL objects
glowportals = 1
# [0..1] 0/1 - PhysicsState MISSILE_PS 0x40
glowprojectiles = 1
# [0..2] 0 off | 1 luminous creatures
glowcreatures = 1
# [0..1] 0/1 - ITEM_TYPE TYPE_LIFESTONE (0x10000000).
glowlifestones = 1
# [0..1] 0/1 - also re-donate STATIC_PS world props
glowstatics = 0
# [0..20] MULTIPLIER on the emitted intensity
glowintensity = 1
# [0.05..10] MULTIPLIER on the emitted falloff
glowfalloffscale = 1
# [0..20] GLOBAL intensity multiplier over every glow
glowgain = 1.6
# [0.05..10] GLOBAL falloff multiplier (on top of
glowrangegain = 1.6
# [0..20] lifestone intensity trim.
glowlifestoneboost = 1.25
# [0.05..10] lifestone falloff trim. With the
glowlifestonerange = 1.4
# [0.05..10] portal falloff trim (authored f6
glowportalrange = 1.25
# [0.05..10] wisp/glowing-creature falloff trim
glowcreaturerange = 1.2
# [0..20] ditto intensity trim
glowcreatureboost = 1
# [0.05..10] war-spell projectile falloff trim
glowprojectilerange = 1.15
# [0..1000] absolute intensity for a luminous
glowsynthintensity = 100
# [0..60] ditto falloff (D3D Range = this*1.5)
glowsynthfalloff = 4
# [-4..8] local +Z offset for a SYNTHESISED light only
glowlift = 0.6
# [0..0.8] portal/creature breathing amplitude (0 = steady)
glowpulse = 0.10
# [0..4] peak surface luminosity required with no authored
glowlum = 0.90
# [0..1] min luminous fraction of the object's surfaces
glowlumfrac = 0.25
# [1..24] max glow lights injected per frame (pool is 10)
glowmax = 6
# [0..300] metres from the player worth tracking.
glowrange = 0
# [0.25..30] classify/track scan rate
glowscanhz = 4
# [0..1] 1 = NO THROUGH-WALL BLEED (retail's own PVS
glowcontain = 1
# [0..1] 0 off | 1 enable glow dynamics outdoors
glowoutdoor = 1
# [1..7] hardware slots the outdoor pass may
glowoutdoorbudget = 6

# --- Memory & stability ---
# [0..1] 0/1 master
memgov = 1
# [256..3072] committed-private MB -> flush every freelist
memlowmb = 1100
# [256..3072] hysteresis re-arm level (priv below this = calm)
memhighmb = 950
# [2..512] largest-free-low-2GB MB -> same flush
memfragmb = 16
# [256..3584] priv emergency -> freelisting OFF + cells unloaded
memcritmb = 1350
# [1..256] largest-free emergency, same response
memcritfragmb = 6
# [1..300] min seconds between un-rearmed trims
memtrimcooldown = 15
# [0..1] 1 = 5 s telemetry line (avail + per-cache free/total)
memlog = 0
# [0..1] 1 = 5 s frame-time stats line (avg/p99/max dt,
framelog = 1
# [0..3] default OFF until the 1070 gauntlet + eye pass
diet = 0
# [0..400] SURFACETEXTURE + RENDERSURFACE (retail 400 each)
memcaptex = 64
# [0..200] GFXOBJ (retail 200)
memcapgfx = 80
# [0..200] SURFACE (retail 200)
memcapsurf = 64
# [0..144] LAND_BLOCK + LBI + CELL (retail 144 each)
memcapland = 48
# [0..100] SCENE (retail 100)
memcapscene = 40

# --- Glow lights ---
# [0..20] intensity multiplier for portals
glowportalboost = 1
# hex RGB override (0 = the DAT's authored
glowportalcolor = 0
# [0..20] glowprojectileboost
glowprojectileboost = 1
# [0..1] 0/1 - recolour war-spell projectiles whose
glowschool = 1
# [0..5000] impact-flash duration (0 = no impact flashes)
glowimpactms = 400
# [0..20] peak multiplier of the projectile's intensity
glowimpactboost = 2
# [0..60] glowimpactfalloff
glowimpactfalloff = 10
# [0..1] 0 = the 30 s breadcrumb only (DEFAULT since
glowlog = 0
